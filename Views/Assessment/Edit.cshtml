@model PropertyAssessmentApp.Models.TaxDeclaration
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = $"Edit Assessment {Model.TaxDeclarationNumber}";
    var owners = ViewBag.Owners as IEnumerable<Owner> ?? new List<Owner>();
}

<div class="space-y-8">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="edit-3" class="w-4 h-4"></i>
                <span>Field Appraisal & Assessment Sheet (FAAS) Re-Assessment</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Edit Tax Declaration: @Model.TaxDeclarationNumber</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Update property specs, valuation appraisal, owner info, land/building references, or signatories.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm transition-all">
            Cancel & Exit
        </a>
    </div>

    <!-- Stepper Header -->
    <div class="p-3 sm:p-4 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 text-center font-mono text-xs">
            <div class="step-btn cursor-pointer py-2.5 sm:py-3 rounded-xl sm:rounded-2xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700 font-bold flex items-center justify-center gap-2 transition-all" id="stepBtn1" onclick="goToStep(1)">
                <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-[10px] sm:text-xs">1</span>
                <span class="truncate">1. Info & Kind</span>
            </div>
            <div class="step-btn cursor-pointer py-2.5 sm:py-3 rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-stone-950 text-slate-500 dark:text-stone-400 border border-slate-200 dark:border-stone-800 font-bold flex items-center justify-center gap-2 transition-all" id="stepBtn2" onclick="goToStep(2)">
                <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold flex items-center justify-center text-[10px] sm:text-xs">2</span>
                <span class="truncate">2. Owner & Location</span>
            </div>
            <div class="step-btn cursor-pointer py-2.5 sm:py-3 rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-stone-950 text-slate-500 dark:text-stone-400 border border-slate-200 dark:border-stone-800 font-bold flex items-center justify-center gap-2 transition-all" id="stepBtn3" onclick="goToStep(3)">
                <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold flex items-center justify-center text-[10px] sm:text-xs">3</span>
                <span class="truncate">3. Property Specs</span>
            </div>
            <div class="step-btn cursor-pointer py-2.5 sm:py-3 rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-stone-950 text-slate-500 dark:text-stone-400 border border-slate-200 dark:border-stone-800 font-bold flex items-center justify-center gap-2 transition-all" id="stepBtn4" onclick="goToStep(4)">
                <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold flex items-center justify-center text-[10px] sm:text-xs">4</span>
                <span class="truncate">4. Valuation & Tax</span>
            </div>
            <div class="col-span-2 sm:col-span-1 step-btn cursor-pointer py-2.5 sm:py-3 rounded-xl sm:rounded-2xl bg-slate-50 dark:bg-stone-950 text-slate-500 dark:text-stone-400 border border-slate-200 dark:border-stone-800 font-bold flex items-center justify-center gap-2 transition-all" id="stepBtn5" onclick="goToStep(5)">
                <span class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold flex items-center justify-center text-[10px] sm:text-xs">5</span>
                <span class="truncate">5. Review & Sign</span>
            </div>
        </div>
    </div>

    <!-- Main Wizard Card -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Edit" method="post" id="wizardForm" class="space-y-6 text-xs font-mono">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300"></div>

            <!-- STEP 1: TRANSACTION INFO & PROPERTY KIND SELECTION -->
            <div id="stepPanel1" class="space-y-5">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-3">
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i data-lucide="layers" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                        Step 1: Transaction Information & Property Kind Selection
                    </h3>
                </div>

                <!-- Property Kind Selector -->
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-3">
                    <label asp-for="Kind" class="block text-slate-800 dark:text-stone-200 font-extrabold uppercase text-xs">Select Property Kind / Category</label>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <label class="kind-option p-4 rounded-xl border border-slate-300 dark:border-stone-700 bg-white dark:bg-stone-900 cursor-pointer flex items-center gap-3 transition-all hover:border-emerald-600">
                            <input type="radio" name="Kind" value="Machinery" class="kind-radio text-emerald-600 focus:ring-emerald-500" @(Model.Kind == PropertyKind.Machinery ? "checked" : "") onclick="onKindChanged('Machinery')">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-white block">Machinery & Equipment</span>
                                <span class="text-[10px] text-slate-500 dark:text-stone-400">Industrial / Factory Plants & Commercial Tools</span>
                            </div>
                        </label>
                        <label class="kind-option p-4 rounded-xl border border-slate-300 dark:border-stone-700 bg-white dark:bg-stone-900 cursor-pointer flex items-center gap-3 transition-all hover:border-emerald-600">
                            <input type="radio" name="Kind" value="Land" class="kind-radio text-emerald-600 focus:ring-emerald-500" @(Model.Kind == PropertyKind.Land ? "checked" : "") onclick="onKindChanged('Land')">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-white block">Land Property</span>
                                <span class="text-[10px] text-slate-500 dark:text-stone-400">Lots, Cadastral Lands & Parcels</span>
                            </div>
                        </label>
                        <label class="kind-option p-4 rounded-xl border border-slate-300 dark:border-stone-700 bg-white dark:bg-stone-900 cursor-pointer flex items-center gap-3 transition-all hover:border-emerald-600">
                            <input type="radio" name="Kind" value="Building" class="kind-radio text-emerald-600 focus:ring-emerald-500" @(Model.Kind == PropertyKind.Building ? "checked" : "") onclick="onKindChanged('Building')">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-white block">Building & Structure</span>
                                <span class="text-[10px] text-slate-500 dark:text-stone-400">Residential, Commercial, Condominium & Houses</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Transaction Information Inputs -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="TaxDeclarationNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TAX DECLARATION NO. (TD)</label>
                        <input asp-for="TaxDeclarationNumber" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" />
                        <span asp-validation-for="TaxDeclarationNumber" class="text-rose-600 text-[10px]"></span>
                    </div>
                    <div>
                        <label asp-for="TransactionCode" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TRANSACTION CODE</label>
                        <select asp-for="TransactionCode" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600 cursor-pointer">
                            @if (!string.IsNullOrWhiteSpace(Model.TransactionCode) && !PropertyAssessmentApp.Models.TaxDeclaration.StandardTransactionCodes.ContainsKey(Model.TransactionCode.Trim().ToUpperInvariant()))
                            {
                                <option value="@Model.TransactionCode" selected>@Model.TransactionCode</option>
                            }
                            <option value="SD">Subdivision - SD</option>
                            <option value="CS">Consolidation - CS</option>
                            <option value="DC">Discovery/New Declaration - DC</option>
                            <option value="PC">Reassessment Due to Physical Change - PC</option>
                            <option value="RA">Reassessment - RA</option>
                            <option value="DT">Reassessment Due to partial Destruction of the property - DT</option>
                            <option value="TR">Transfer - TR</option>
                            <option value="RC">Reclassification - RC</option>
                            <option value="GR">General Revision - GR</option>
                            <option value="SP">Special Project - SP</option>
                            <option value="DEP">Reassessment Due to depreciation - DEP</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="PropertyIndexNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY IDENTIFICATION NO. (PIN)</label>
                        <input asp-for="PropertyIndexNumber" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" />
                        <span asp-validation-for="PropertyIndexNumber" class="text-rose-600 text-[10px]"></span>
                    </div>
                </div>
            </div>

            <!-- STEP 2: OWNER INFORMATION & PROPERTY LOCATION -->
            <div id="stepPanel2" class="space-y-6 hidden">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-3">
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i data-lucide="user-check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                        Step 2: Owner Information & Property Location
                    </h3>
                </div>

                <!-- Searchable Registered Owner Dropdown (Auto-fill) -->
                <div class="p-5 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 space-y-2">
                    <label class="block text-emerald-800 dark:text-emerald-300 font-bold uppercase text-xs flex items-center gap-2">
                        <i data-lucide="user-search" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        Find & Select Registered Owner (Auto-fill Owner Information)
                    </label>
                    <select id="registeredOwnerSelect" class="w-full">
                        <option value="">-- Search registered owner by name, TIN, or RPTIN --</option>
                        @foreach (var owner in owners)
                        {
                            <option value="@owner.Id">@owner.DisplayName (TIN: @owner.TaxIdentNo | @owner.BarangayName)</option>
                        }
                    </select>
                    <p class="text-[10px] text-slate-500 dark:text-stone-400">Selecting a registered owner will automatically fill in the owner name, TIN, phone, email, address, and barangay fields below.</p>
                </div>

                <!-- Primary Owner Information -->
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <h4 class="text-xs font-bold uppercase text-slate-800 dark:text-stone-200">Owner Information</h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="md:col-span-2">
                            <label asp-for="OwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER/S NAME (AS REFLECTED IN TITLE/CCT)</label>
                            <input type="hidden" asp-for="OwnerId" id="ownerIdInput" />
                            <input asp-for="OwnerName" id="ownerNameInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" placeholder="e.g. Juan De La Cruz" />
                            <span asp-validation-for="OwnerName" class="text-rose-600 text-[10px]"></span>
                        </div>
                        <div>
                            <label asp-for="OwnerTin" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TAX IDENTIFICATION NO. (TIN)</label>
                            <input asp-for="OwnerTin" id="ownerTinInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="123-456-789-000" />
                        </div>
                        <div>
                            <label asp-for="OwnerPhone" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PHONE / MOBILE NO.</label>
                            <input asp-for="OwnerPhone" id="ownerPhoneInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="0917-123-4567" />
                        </div>
                        <div>
                            <label asp-for="OwnerEmail" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EMAIL ADDRESS</label>
                            <input asp-for="OwnerEmail" id="ownerEmailInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="owner@email.com" />
                        </div>
                        <div>
                            <label asp-for="OwnerSex" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SEX</label>
                            <select asp-for="OwnerSex" id="ownerSexInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Others">Others / Corporation</option>
                            </select>
                        </div>
                        <div class="md:col-span-3">
                            <label asp-for="OwnerAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MAILING ADDRESS</label>
                            <input asp-for="OwnerAddress" id="ownerAddressInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Complete Street, City/Municipality, Province" />
                        </div>
                    </div>
                </div>

                <!-- Administrator / Beneficial User / Possessor Info -->
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <div class="border-b border-slate-200 dark:border-stone-800 pb-3 flex flex-wrap items-center justify-between gap-3">
                        <h4 class="text-xs font-bold uppercase text-slate-800 dark:text-stone-200">Administrator / Beneficial User / Possessor</h4>
                        <div class="flex flex-wrap items-center gap-2">
                            <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300 bg-white dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm hover:border-emerald-500 transition-colors">
                                <input type="checkbox" asp-for="IsAdministrator" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                                <span>ADMINISTRATOR</span>
                            </label>
                            <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300 bg-white dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm hover:border-emerald-500 transition-colors">
                                <input type="checkbox" asp-for="IsBeneficialUser" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                                <span>BENEFICIAL USER</span>
                            </label>
                            <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300 bg-white dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm hover:border-emerald-500 transition-colors">
                                <input type="checkbox" asp-for="IsPossessor" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                                <span>POSSESSOR</span>
                            </label>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="md:col-span-2">
                            <label asp-for="AdminPossessorName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">NAMES (ADMINISTRATOR / BENEFICIAL USER / POSSESSOR)</label>
                            <input asp-for="AdminPossessorName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Full name of administrator / beneficial user / possessor" />
                        </div>
                        <div>
                            <label asp-for="AdminPossessorSex" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">SEX</label>
                            <select asp-for="AdminPossessorSex" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Corporate">Corporate / Entity</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="AdminPossessorTin" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">TIN</label>
                            <input asp-for="AdminPossessorTin" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="000-000-000-000" />
                        </div>
                        <div class="md:col-span-2">
                            <label asp-for="AdminPossessorAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">MAILING ADDRESS</label>
                            <input asp-for="AdminPossessorAddress" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Complete mailing address" />
                        </div>
                        <div>
                            <label asp-for="AdminPossessorPhone" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">PHONE NO.</label>
                            <input asp-for="AdminPossessorPhone" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="09XX-XXX-XXXX" />
                        </div>
                        <div>
                            <label asp-for="AdminPossessorEmail" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">EMAIL</label>
                            <input asp-for="AdminPossessorEmail" type="email" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="admin@email.com" />
                        </div>
                    </div>
                </div>

                <!-- Property Location -->
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <h4 class="text-xs font-bold uppercase text-slate-800 dark:text-stone-200">Property Location</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="StreetNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">NO. / STREET</label>
                            <input asp-for="StreetNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="No. 45 Pioneer Avenue" />
                        </div>
                        <div>
                            <label asp-for="DistrictOrBarangay" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BARANGAY / DISTRICT</label>
                            <input asp-for="DistrictOrBarangay" id="barangayInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" placeholder="Brgy. Central" />
                        </div>
                        <div>
                            <label asp-for="Municipality" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MUNICIPALITY / CITY</label>
                            <input asp-for="Municipality" id="municipalityInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                        </div>
                        <div>
                            <label asp-for="ProvinceCity" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROVINCE / CITY</label>
                            <input asp-for="ProvinceCity" id="provinceInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 3: DYNAMIC PROPERTY SPECIFICATIONS (MACHINERY / LAND / BUILDING) -->
            <div id="stepPanel3" class="space-y-6 hidden">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-3">
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i data-lucide="sliders" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                        Step 3: <span id="specTitleKind">Land</span> Specific Registration & References
                    </h3>
                </div>

                <!-- MACHINERY SPECIFIC FORM -->
                <partial name="_machinery" model="Model" />

                <!-- LAND SPECIFIC FORM -->
                <partial name="_landform" model="Model" />

                <!-- BUILDING SPECIFIC FORM (SHARED BETWEEN CREATE AND EDIT) -->
                <partial name="_buildingform" model="Model" />

                <!-- SHARED LAND REFERENCE PANEL FOR MACHINERY & BUILDING -->
                <div id="landReferencePanel" class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <h4 class="text-xs font-bold uppercase text-slate-800 dark:text-stone-200">Land Reference (Where Property is Erected/Situated)</h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="LandOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LANDOWNER NAME</label>
                            <input asp-for="LandOwnerName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                        </div>
                        <div>
                            <label asp-for="LandTdNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LAND TD NO.</label>
                            <input asp-for="LandTdNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                        </div>
                        <div>
                            <label asp-for="LandPin" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LAND PIN</label>
                            <input asp-for="LandPin" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                        </div>
                        <div>
                            <label asp-for="LandOwnerTin" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LANDOWNER TIN</label>
                            <input asp-for="LandOwnerTin" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                        </div>
                        <div>
                            <label asp-for="LandTitleNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LAND TITLE NO.</label>
                            <input asp-for="LandTitleNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                        </div>
                        <div>
                            <label asp-for="LandAreaSqm" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TOTAL LAND AREA (SQ.M.)</label>
                            <input asp-for="LandAreaSqm" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 4: APPRAISAL & ASSESSMENT COMPUTATIONS -->
            <div id="stepPanel4" class="space-y-6 hidden">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-3">
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i data-lucide="calculator" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                        Step 4: Property Assessment & Valuation Computations
                    </h3>
                </div>

                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <h4 class="text-xs font-bold uppercase text-slate-800 dark:text-stone-200">Appraisal & Assessment Inputs</h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="Classification" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CLASSIFICATION</label>
                            <select asp-for="Classification" id="classificationSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" asp-items="Html.GetEnumSelectList<PropertyClassification>()"></select>
                        </div>
                        <div>
                            <label asp-for="ActualUse" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ACTUAL USE</label>
                            <input asp-for="ActualUse" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" placeholder="Residential Use" />
                        </div>
                        <div>
                            <label asp-for="AreaSqMeters" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">AREA / BASE UNIT (SQ.M.)</label>
                            <input asp-for="AreaSqMeters" id="areaInput" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right font-bold" placeholder="0.00" />
                        </div>
                        <div>
                            <label asp-for="UnitValue" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BASE UNIT VALUE (PHP/SQ.M.)</label>
                            <input asp-for="UnitValue" id="unitValueInput" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right font-bold" placeholder="0.00" />
                        </div>
                        <div>
                            <label asp-for="MarketValue" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BASE MARKET VALUE (PHP)</label>
                            <input asp-for="MarketValue" id="marketValueInput" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right font-bold" />
                        </div>
                        <div>
                            <label asp-for="AssessmentLevelPercent" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ASSESSMENT LEVEL (%)</label>
                            <input asp-for="AssessmentLevelPercent" id="assessmentLevelInput" type="number" step="0.1" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right font-bold" />
                        </div>
                        <div>
                            <label asp-for="BasicTaxRate" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BASIC RPT RATE (%)</label>
                            <input asp-for="BasicTaxRate" id="basicTaxRateInput" type="number" step="0.1" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right" />
                        </div>
                        <div>
                            <label asp-for="SefTaxRate" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SEF RATE (%)</label>
                            <input asp-for="SefTaxRate" id="sefTaxRateInput" type="number" step="0.1" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right" />
                        </div>
                        <div>
                            <label asp-for="EffectivityYear" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EFFECTIVITY YEAR</label>
                            <input asp-for="EffectivityYear" type="number" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                        </div>
                    </div>
                </div>

                <!-- Computed Summary Card -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-5 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 text-center">
                    <div>
                        <span class="text-slate-500 dark:text-stone-400 text-[10px] uppercase font-bold block mb-1">Total Market Value (FMV)</span>
                        <span id="computedFmvDisplay" class="text-xl font-black text-slate-900 dark:text-white font-mono">₱0.00</span>
                    </div>
                    <div>
                        <span class="text-emerald-700 dark:text-emerald-400 text-[10px] uppercase font-bold block mb-1">Computed Assessed Value</span>
                        <span id="computedAssessedDisplay" class="text-xl font-black text-emerald-700 dark:text-emerald-400 font-mono">₱0.00</span>
                    </div>
                    <div>
                        <span class="text-amber-700 dark:text-gold-400 text-[10px] uppercase font-bold block mb-1">Est. Total Annual Tax Due</span>
                        <span id="computedTaxDueDisplay" class="text-xl font-black text-amber-700 dark:text-gold-400 font-mono">₱0.00</span>
                    </div>
                </div>
            </div>

            <!-- STEP 5: REVIEW, SUPERSEDED ASSESSMENT & SIGNATORIES -->
            <div id="stepPanel5" class="space-y-6 hidden">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-3">
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                        Step 5: Record of Superseded Assessment & Official Signatories
                    </h3>
                </div>

                <!-- Record of Superseded Assessment -->
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <h4 class="text-xs font-bold uppercase text-slate-800 dark:text-stone-200">Record of Superseded Assessment (Prior TD)</h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="PreviousTdNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS TD NO.</label>
                            <input asp-for="PreviousTdNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="TD-2022-000840" />
                        </div>
                        <div>
                            <label asp-for="PreviousOwner" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS OWNER</label>
                            <input asp-for="PreviousOwner" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                        </div>
                        <div>
                            <label asp-for="PreviousAssessedValue" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS ASSESSED VALUE (PHP)</label>
                            <input asp-for="PreviousAssessedValue" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right" />
                        </div>
                    </div>
                </div>

                <!-- Signatories -->
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <h4 class="text-xs font-bold uppercase text-slate-800 dark:text-stone-200">Signatories & Approval Audit</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="AppraisedByName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">APPRAISED BY (APPRAISER)</label>
                            <input asp-for="AppraisedByName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                        </div>
                        <div>
                            <label asp-for="AssessedByName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ASSESSED BY (ASSESSMENT OFFICER)</label>
                            <input asp-for="AssessedByName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                        </div>
                        <div>
                            <label asp-for="ApprovedByName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">APPROVED BY (CITY ASSESSOR)</label>
                            <input asp-for="ApprovedByName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold text-emerald-700 dark:text-emerald-400" />
                        </div>
                        <div>
                            <label asp-for="EncodedByName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ENCODED BY</label>
                            <input asp-for="EncodedByName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                        </div>
                        <div>
                            <label asp-for="Status" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ASSESSMENT STATUS</label>
                            <select asp-for="Status" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" asp-items="Html.GetEnumSelectList<AssessmentStatus>()"></select>
                        </div>
                        <div class="md:col-span-2">
                            <label asp-for="Memoranda" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MEMORANDA / SPECIAL NOTES</label>
                            <textarea asp-for="Memoranda" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Final Verification Preview Banner -->
                <div class="p-6 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 space-y-3">
                    <h4 class="text-xs font-bold uppercase text-emerald-800 dark:text-emerald-300 flex items-center gap-2">
                        <i data-lucide="file-check" class="w-4 h-4"></i>
                        Summary Registration Preview
                    </h4>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-slate-800 dark:text-stone-200">
                        <div><strong>TD No:</strong> <span id="summaryTd" class="font-mono font-bold block text-slate-900 dark:text-white">--</span></div>
                        <div><strong>PIN:</strong> <span id="summaryPin" class="font-mono font-bold block text-slate-900 dark:text-white">--</span></div>
                        <div><strong>Owner:</strong> <span id="summaryOwner" class="font-bold block text-slate-900 dark:text-white">--</span></div>
                        <div><strong>Barangay:</strong> <span id="summaryBarangay" class="font-semibold block text-slate-900 dark:text-white">--</span></div>
                    </div>
                </div>
            </div>

            <!-- Wizard Navigation Controls -->
            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-3 pt-6 border-t border-slate-200 dark:border-stone-800">
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto">
                    <button type="button" id="prevBtn" onclick="nextStep(-1)" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-all text-center" disabled>
                        Previous Step
                    </button>
                    <button type="button" onclick="openDeleteModal()" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 hover:bg-rose-100 border border-rose-200 dark:border-rose-800 font-bold transition-all text-center">
                        Delete Record
                    </button>
                </div>

                <span id="stepCounter" class="text-slate-500 dark:text-stone-400 font-mono text-xs text-center py-1 sm:py-0">Step 1 of 5</span>

                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <button type="button" id="nextBtn" onclick="nextStep(1)" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold uppercase tracking-wider shadow-md transition-all text-center">
                        Next Step
                    </button>
                    <button type="submit" id="submitBtn" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold uppercase tracking-wider hidden shadow-md transition-all text-center">
                        Save Assessment Changes
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-3xl p-6 w-full max-w-md shadow-2xl space-y-4 font-mono text-xs">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-3">
            <div class="flex items-center gap-2 text-rose-600 dark:text-rose-400 font-bold text-sm">
                <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                <h3 class="text-slate-900 dark:text-white font-extrabold">Confirm Record Deletion</h3>
            </div>
            <button type="button" onclick="closeDeleteModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-stone-200">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="text-slate-600 dark:text-stone-300 leading-relaxed">
            Are you sure you want to delete Tax Declaration <strong class="text-slate-900 dark:text-white">@Model.TaxDeclarationNumber</strong> for owner <strong class="text-slate-900 dark:text-white">@Model.OwnerName</strong>?
            <div class="mt-2 text-rose-600 dark:text-rose-400 font-bold text-[11px]">This action cannot be undone.</div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200 dark:border-stone-800">
            <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold transition-all">
                Cancel
            </button>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="inline">
                <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold transition-all shadow-sm flex items-center gap-1.5">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                    <span>Confirm Delete</span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var currentStep = 1;
        var selectedKind = "@Model.Kind.ToString()";
        var ownerTomSelect;

        function getSelectedKind() {
            var checkedVal = $('input[name="Kind"]:checked').val();
            return checkedVal || selectedKind || "Land";
        }

        function onKindChanged(kind) {
            selectedKind = kind;
            $('#specTitleKind').text(kind);

            // Toggle kind specific forms / panels
            if (kind === 'Machinery') {
                $('#machinery, #machineryPanels').removeClass('hidden');
                $('#landform, #landPanels').addClass('hidden');
                $('#buildingform, #buildingPanels').addClass('hidden');
                $('#landReferencePanel').removeClass('hidden');
            } else if (kind === 'Building') {
                $('#machinery, #machineryPanels').addClass('hidden');
                $('#landform, #landPanels').addClass('hidden');
                $('#buildingform, #buildingPanels').removeClass('hidden');
                $('#landReferencePanel').removeClass('hidden');
            } else { // Land
                $('#machinery, #machineryPanels').addClass('hidden');
                $('#landform, #landPanels').removeClass('hidden');
                $('#buildingform, #buildingPanels').addClass('hidden');
                $('#landReferencePanel').addClass('hidden');
            }
        }

        function validateCurrentStep() {
            var isValid = true;
            $('.border-rose-500').removeClass('border-rose-500 ring-2 ring-rose-500/30');

            if (currentStep === 1) {
                var $td = $('input[name="TaxDeclarationNumber"]');
                var $pin = $('input[name="PropertyIndexNumber"]');
                if (!$td.val() || !$td.val().trim()) {
                    $td.addClass('border-rose-500 ring-2 ring-rose-500/30');
                    toastr.warning('Please enter Tax Declaration (TD) No.', 'Validation Notice');
                    $td.focus();
                    return false;
                }
                if (!$pin.val() || !$pin.val().trim()) {
                    $pin.addClass('border-rose-500 ring-2 ring-rose-500/30');
                    toastr.warning('Please enter Property Identification No. (PIN)', 'Validation Notice');
                    $pin.focus();
                    return false;
                }
            } else if (currentStep === 2) {
                var $owner = $('#ownerNameInput');
                if (!$owner.val() || !$owner.val().trim()) {
                    $owner.addClass('border-rose-500 ring-2 ring-rose-500/30');
                    toastr.warning('Please enter Owner/s Name', 'Validation Notice');
                    $owner.focus();
                    return false;
                }
            }
            return true;
        }

        function goToStep(step) {
            if (step < 1 || step > 5) return;
            if (step > currentStep && !validateCurrentStep()) return;
            currentStep = step;
            updateWizardUI();
        }

        function nextStep(n) {
            goToStep(currentStep + n);
        }

        function updateWizardUI() {
            var currentKind = getSelectedKind();
            onKindChanged(currentKind);

            for (var i = 1; i <= 5; i++) {
                var panel = $('#stepPanel' + i);
                var btn = $('#stepBtn' + i);
                if (i === currentStep) {
                    panel.removeClass('hidden');
                    btn.addClass('bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-700').removeClass('bg-slate-50 dark:bg-stone-950 text-slate-500 dark:text-stone-400 border-slate-200 dark:border-stone-800');
                    btn.find('span:first').addClass('bg-emerald-600 text-white').removeClass('bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300');
                } else {
                    panel.addClass('hidden');
                    btn.removeClass('bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-700').addClass('bg-slate-50 dark:bg-stone-950 text-slate-500 dark:text-stone-400 border-slate-200 dark:border-stone-800');
                    btn.find('span:first').removeClass('bg-emerald-600 text-white').addClass('bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300');
                }
            }

            $('#prevBtn').prop('disabled', currentStep === 1);
            if (currentStep === 5) {
                $('#nextBtn').addClass('hidden');
                $('#submitBtn').removeClass('hidden');
                populateSummary();
            } else {
                $('#nextBtn').removeClass('hidden');
                $('#submitBtn').addClass('hidden');
            }

            $('#stepCounter').text('Step ' + currentStep + ' of 5');
        }

        function calculateValues() {
            var area = parseFloat($('#areaInput').val()) || 0;
            var unitVal = parseFloat($('#unitValueInput').val()) || 0;
            var level = parseFloat($('#assessmentLevelInput').val()) || 20;
            var basicRate = parseFloat($('#basicTaxRateInput').val()) || 2.0;
            var sefRate = parseFloat($('#sefTaxRateInput').val()) || 1.0;

            var fmv = parseFloat($('#marketValueInput').val());
            if (isNaN(fmv) || fmv <= 0) {
                fmv = area * unitVal;
                $('#marketValueInput').val(fmv > 0 ? fmv.toFixed(2) : '');
            }

            var assessed = fmv * (level / 100.0);
            var taxDue = assessed * ((basicRate + sefRate) / 100.0);

            $('#computedFmvDisplay').text('₱' + fmv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#computedAssessedDisplay').text('₱' + assessed.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#computedTaxDueDisplay').text('₱' + taxDue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            
            return { fmv: fmv, assessed: assessed, taxDue: taxDue };
        }

        function populateSummary() {
            var vals = calculateValues();
            $('#summaryTd').text($('#TaxDeclarationNumber').val() || '--');
            $('#summaryPin').text($('#PropertyIndexNumber').val() || '--');
            $('#summaryOwner').text($('#ownerNameInput').val() || '--');
            $('#summaryBarangay').text($('#barangayInput').val() || '--');
        }

        function initRegisteredOwnerLookup() {
            ownerTomSelect = new TomSelect('#registeredOwnerSelect', {
                create: false,
                placeholder: 'Search registered owner by name, TIN, or RPTIN...',
                onChange: function (ownerId) {
                    $('#ownerIdInput').val(ownerId || '');
                    if (!ownerId) return;
                    $.get('/Assessment/GetOwnerDetails', { id: ownerId }, function (data) {
                        if (data) {
                            $('#ownerIdInput').val(data.id || ownerId);
                            $('#ownerNameInput').val(data.name);
                            $('#ownerTinInput').val(data.tin);
                            $('#ownerPhoneInput').val(data.phone);
                            $('#ownerEmailInput').val(data.email);
                            $('#ownerAddressInput').val(data.address);
                            if (data.barangay) {
                                $('#barangayInput').val(data.barangay);
                            }
                            if (data.city) {
                                $('#municipalityInput').val(data.city);
                            }
                            if (data.province) {
                                $('#provinceInput').val(data.province);
                            }
                            toastr.success('Owner info auto-filled for ' + data.name + '!', 'Registered Owner Selected');
                        }
                    });
                }
            });
        }

        function openDeleteModal() {
            $('#deleteModal').removeClass('hidden');
            if (window.lucide) {
                lucide.createIcons();
            }
        }

        function closeDeleteModal() {
            $('#deleteModal').addClass('hidden');
        }

        // -------------------------------------------------------------
        // BUILDING ADVANCED SUB-MODULES (CAST REFERENCE)
        // -------------------------------------------------------------
        var buildingFloors = [];
        var buildingAdditions = [];

        function initBuildingSwitches() {
            $('#isCctSwitch').on('change', function () {
                if ($(this).is(':checked')) {
                    $('#cctDetailsRow').removeClass('hidden');
                } else {
                    $('#cctDetailsRow').addClass('hidden');
                }
            }).trigger('change');

            $('#isAdminSwitch').on('change', function () {
                if ($(this).is(':checked')) {
                    $('#adminDetailsRow').removeClass('hidden');
                } else {
                    $('#adminDetailsRow').addClass('hidden');
                }
            }).trigger('change');
        }

        function openAddFloorModal() {
            $('#modalFloorArea').val('');
            $('#addFloorModal').removeClass('hidden');
        }

        function closeAddFloorModal() {
            $('#addFloorModal').addClass('hidden');
        }

        function saveFloorLevel() {
            var level = $('#modalFloorLevel').val();
            var desc = $('#modalFloorDesc').val() || level;
            var area = parseFloat($('#modalFloorArea').val()) || 0;
            var unitCost = parseFloat($('#modalFloorUnitCost').val()) || 0;

            if (area <= 0) {
                toastr.warning('Please enter valid floor area.', 'Floor Area Required');
                return;
            }

            var marketVal = area * unitCost;
            buildingFloors.push({
                floorNumber: level,
                description: desc,
                floorAreaSqm: area,
                baseUnitCost: unitCost,
                marketValue: marketVal
            });

            closeAddFloorModal();
            renderBuildingFloors();
            recalculateBuildingValuation();
            toastr.success(level + ' added to schedule.', 'Floor Added');
        }

        function removeFloorLevel(index) {
            buildingFloors.splice(index, 1);
            renderBuildingFloors();
            recalculateBuildingValuation();
        }

        function renderBuildingFloors() {
            var tbody = $('#tableBuildingFloorsBody');
            tbody.empty();

            if (buildingFloors.length === 0) {
                tbody.append('<tr><td colspan="6" class="p-4 text-center text-slate-400 italic">No floor levels added yet. Click "+ Add Floor Level" above.</td></tr>');
                $('#displayTotalBldgArea').text('0.00 sq.m.');
                $('#displayTotalBaseRcn').text('₱0.00');
                $('#buildingFloorBreakdownJson').val('');
                return;
            }

            var totalArea = 0;
            var totalRcn = 0;

            buildingFloors.forEach(function (f, idx) {
                totalArea += f.floorAreaSqm;
                totalRcn += f.marketValue;
                var row = `
                    <tr class="hover:bg-slate-50 dark:hover:bg-stone-950">
                        <td class="p-3 font-bold text-slate-900 dark:text-white">${f.floorNumber}</td>
                        <td class="p-3 text-slate-600 dark:text-stone-300">${f.description}</td>
                        <td class="p-3 text-right font-mono">${f.floorAreaSqm.toFixed(2)}</td>
                        <td class="p-3 text-right font-mono">₱${f.baseUnitCost.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                        <td class="p-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">₱${f.marketValue.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                        <td class="p-3 text-center">
                            <button type="button" onclick="removeFloorLevel(${idx})" class="text-rose-500 hover:text-rose-700 p-1 rounded hover:bg-rose-50 dark:hover:bg-rose-950/40">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });

            $('#displayTotalBldgArea').text(totalArea.toFixed(2) + ' sq.m.');
            $('#displayTotalBaseRcn').text('₱' + totalRcn.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#totalBuildingAreaInput').val(totalArea.toFixed(2));
            $('#noOfStoreysInput').val(buildingFloors.length);
            $('#baseRcnValue').val(totalRcn.toFixed(2));
            $('#buildingFloorBreakdownJson').val(JSON.stringify(buildingFloors));

            if (window.lucide) lucide.createIcons();
        }

        // Additional Items Handlers
        function openAddAdditionModal() {
            $('#modalAdditionPreset').val('custom').trigger('change');
            $('#modalAdditionDesc').val('');
            $('#modalAdditionQty').val('1');
            $('#modalAdditionRate').val('');
            $('#addAdditionModal').removeClass('hidden');
        }

        function closeAddAdditionModal() {
            $('#addAdditionModal').addClass('hidden');
        }

        $('#modalAdditionPreset').on('change', function () {
            var selected = $(this).find('option:selected');
            var val = $(this).val();
            if (val === 'custom') {
                $('#modalAdditionDesc').val('');
                $('#modalAdditionRateLabel').text('UNIT RATE / COST (PHP)');
                $('#modalMultiplierRow').addClass('hidden');
                $('#modalAdditionRate').val('');
            } else {
                var desc = selected.text();
                var rate = selected.data('rate');
                var type = selected.data('type');
                $('#modalAdditionDesc').val(desc);
                if (type === 'Percent') {
                    $('#modalMultiplierRow').removeClass('hidden');
                    $('#modalAdditionMultiplier').val(rate);
                    $('#modalAdditionRateLabel').text('BUCC BASE RATE (PHP)');
                    var baseRcn = parseFloat($('#baseRcnValue').val()) || 8500;
                    $('#modalAdditionRate').val(baseRcn);
                } else {
                    $('#modalMultiplierRow').addClass('hidden');
                    $('#modalAdditionRateLabel').text('UNIT RATE / COST (PHP)');
                    $('#modalAdditionRate').val(rate);
                }
            }
        });

        function saveAdditionItem() {
            var desc = $('#modalAdditionDesc').val();
            var qty = parseFloat($('#modalAdditionQty').val()) || 1;
            var rate = parseFloat($('#modalAdditionRate').val()) || 0;
            var preset = $('#modalAdditionPreset').val();
            var isCustom = (preset === 'custom');

            if (!desc || !desc.trim()) {
                toastr.warning('Please enter an item description.', 'Description Required');
                return;
            }

            var total = 0;
            var multiplier = 0;
            var rateType = "FixedCost";

            if ($('#modalAdditionPreset').find('option:selected').data('type') === 'Percent') {
                multiplier = parseFloat($('#modalAdditionMultiplier').val()) || 0;
                rateType = "Percent";
                total = qty * rate * (multiplier / 100.0);
            } else {
                total = qty * rate;
            }

            buildingAdditions.push({
                itemDescription: desc,
                quantity: qty,
                unitRate: rate,
                multiplierPercent: multiplier,
                rateType: rateType,
                totalValue: total,
                isCustom: isCustom
            });

            closeAddAdditionModal();
            renderBuildingAdditions();
            recalculateBuildingValuation();
            toastr.success(desc + ' added to improvements schedule.', 'Improvement Added');
        }

        function removeAdditionItem(index) {
            buildingAdditions.splice(index, 1);
            renderBuildingAdditions();
            recalculateBuildingValuation();
        }

        function renderBuildingAdditions() {
            var tbody = $('#tableBuildingAdditionsBody');
            tbody.empty();

            if (buildingAdditions.length === 0) {
                tbody.append('<tr><td colspan="6" class="p-4 text-center text-slate-400 italic">No additional items added. Click "+ Add Improvement Item" above.</td></tr>');
                $('#displayTotalAdditions').text('₱0.00');
                $('#buildingAdditionalItemsJson').val('');
                $('#buildingTotalAdditionsValue').val('0');
                return;
            }

            var totalAdditions = 0;
            buildingAdditions.forEach(function (item, idx) {
                totalAdditions += item.totalValue;
                var rateText = item.rateType === 'Percent' ? `${item.multiplierPercent}%` : `₱${item.unitRate.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
                var row = `
                    <tr class="hover:bg-slate-50 dark:hover:bg-stone-950">
                        <td class="p-3 font-bold text-slate-900 dark:text-white">${item.itemDescription}</td>
                        <td class="p-3 text-right font-mono">${item.quantity.toFixed(2)}</td>
                        <td class="p-3 text-right font-mono">₱${item.unitRate.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                        <td class="p-3 text-right font-mono">${rateText}</td>
                        <td class="p-3 text-right font-mono font-bold text-sky-600 dark:text-sky-400">₱${item.totalValue.toLocaleString('en-US', { minimumFractionDigits: 2 })}</td>
                        <td class="p-3 text-center">
                            <button type="button" onclick="removeAdditionItem(${idx})" class="text-rose-500 hover:text-rose-700 p-1 rounded hover:bg-rose-50 dark:hover:bg-rose-950/40">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });

            $('#displayTotalAdditions').text('₱' + totalAdditions.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#buildingTotalAdditionsValue').val(totalAdditions.toFixed(2));
            $('#buildingAdditionalItemsJson').val(JSON.stringify(buildingAdditions));

            if (window.lucide) lucide.createIcons();
        }

        function recalculateBuildingValuation() {
            var baseRcn = parseFloat($('#baseRcnValue').val()) || 0;
            if (baseRcn <= 0) {
                var area = parseFloat($('#totalBuildingAreaInput').val()) || 0;
                var uVal = parseFloat($('#unitValueInput').val()) || 8500;
                baseRcn = area * uVal;
            }

            var deprRate = parseFloat($('#buildingDeprPercentInput').val()) || 0;
            var accDepr = baseRcn * (deprRate / 100.0);
            var depreciatedCore = Math.max(0, baseRcn - accDepr);
            var totalAdditions = parseFloat($('#buildingTotalAdditionsValue').val()) || 0;
            var finalMarketVal = depreciatedCore + totalAdditions;

            $('#buildingDepreciationAccumulated').val(accDepr.toFixed(2));
            $('#buildingDepreciatedMarketValue').val(depreciatedCore.toFixed(2));

            $('#kpiBaseRcn').text('₱' + baseRcn.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#kpiDepreciation').text('-₱' + accDepr.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (' + deprRate.toFixed(1) + '%)');
            $('#kpiDepreciatedCore').text('₱' + depreciatedCore.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#kpiAdditions').text('+₱' + totalAdditions.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

            $('#displayDepreciationAcc').val('₱' + accDepr.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#displayFinalBldgMarketValue').val('₱' + finalMarketVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

            if (getSelectedKind() === 'Building' && finalMarketVal > 0) {
                $('#marketValueInput').val(finalMarketVal.toFixed(2));
                var tfa = parseFloat($('#totalBuildingAreaInput').val()) || 0;
                if (tfa > 0) {
                    $('#areaInput').val(tfa.toFixed(2));
                }
                calculateValues();
            }
        }

        $(document).ready(function () {
            onKindChanged(getSelectedKind());
            initRegisteredOwnerLookup();
            initBuildingSwitches();

            // Load any existing JSON data
            try {
                var existingFloors = $('#buildingFloorBreakdownJson').val();
                if (existingFloors) {
                    buildingFloors = JSON.parse(existingFloors);
                    renderBuildingFloors();
                }
                var existingAdditions = $('#buildingAdditionalItemsJson').val();
                if (existingAdditions) {
                    buildingAdditions = JSON.parse(existingAdditions);
                    renderBuildingAdditions();
                }
            } catch (err) {
                console.error('Error parsing building JSON:', err);
            }

            $('#buildingDeprPercentInput, #totalBuildingAreaInput').on('input', recalculateBuildingValuation);
            recalculateBuildingValuation();
            calculateValues();

            $('#areaInput, #unitValueInput, #marketValueInput, #assessmentLevelInput, #basicTaxRateInput, #sefTaxRateInput').on('input', calculateValues);
            
            $('#classificationSelect').on('change', function () {
                var classificationVal = $(this).val();
                $.get('/Assessment/GetDefaultAssessmentLevel', { classification: classificationVal }, function (data) {
                    if (data && data.assessmentLevel) {
                        $('#assessmentLevelInput').val(data.assessmentLevel);
                        calculateValues();
                    }
                });
            });

            $('#wizardForm').on('submit', function (e) {
                var $td = $('input[name="TaxDeclarationNumber"]');
                var $pin = $('input[name="PropertyIndexNumber"]');
                var $owner = $('#ownerNameInput');

                if (!$td.val() || !$td.val().trim() || !$pin.val() || !$pin.val().trim()) {
                    e.preventDefault();
                    goToStep(1);
                    validateCurrentStep();
                    return false;
                }

                if (!$owner.val() || !$owner.val().trim()) {
                    e.preventDefault();
                    goToStep(2);
                    validateCurrentStep();
                    return false;
                }
            });

            $(document).on('input keyup change', 'input[name="TaxDeclarationNumber"], input[name="PropertyIndexNumber"], #ownerNameInput', function() {
                $(this).removeClass('border-rose-500 ring-2 ring-rose-500/30');
            });

            // CAST Combination #1 (ARPNo: 187-00-BBBB-SSS-LLL) & Combination #2 (TDN: YY-BBBB-NNNNN) live sync
            function resolveCastBrgyCode(brgyVal, defaultCode) {
                if (!brgyVal) return defaultCode || '0001';
                var raw = String(brgyVal).trim();
                if (/^\d+$/.test(raw)) return raw.slice(-4).padStart(4, '0');
                var u = raw.toUpperCase();
                var map = [
                    ['DADIANGAS EAST', '0001'], ['CENTRAL', '0001'], ['POBLACION', '0001'], ['ZONE 1', '0001'],
                    ['LAGAO', '0002'], ['MORALES', '0002'], ['CALUMPANG', '0003'], ['SAN ISIDRO', '0004'],
                    ['CITY HEIGHTS', '0005'], ['DADIANGAS NORTH', '0006'], ['DADIANGAS SOUTH', '0007'],
                    ['DADIANGAS WEST', '0008'], ['LABANGAL', '0009'], ['APOPONG', '0010'], ['BALUAN', '0011'],
                    ['BATOMELONG', '0012'], ['BUAYAN', '0013'], ['BULA', '0014'], ['CONEL', '0015'],
                    ['FATIMA', '0016'], ['KATANGAWAN', '0017'], ['LIGAYA', '0018'], ['MABUHAY', '0019'],
                    ['OLYMPOG', '0020'], ['SAN JOSE', '0021'], ['SIGUEL', '0022'], ['SINAWAL', '0023'],
                    ['TAMBLER', '0024'], ['TINAGACAN', '0025'], ['UPPER LABAY', '0026'], ['SALITRAN', '0027']
                ];
                for (var i = 0; i < map.length; i++) {
                    if (u.indexOf(map[i][0]) !== -1) return map[i][1];
                }
                var digits = raw.replace(/\D/g, '');
                if (digits) return digits.slice(-4).padStart(4, '0');
                return defaultCode || '0001';
            }

            function formatThreeDigitPart(val) {
                if (!val) return '000';
                var m = String(val).match(/\d+/);
                if (m) return m[0].slice(-3).padStart(3, '0');
                return String(val).replace(/[^a-zA-Z0-9]/g, '').slice(0, 3).toUpperCase().padStart(3, '0') || '000';
            }

            function syncWizardCastArpAndTd() {
                var brgyVal = $('#landform select[name="DistrictOrBarangay"]').val() || $('#barangayInput').val() || '';
                var secVal = $('input[name="SectionNo"]').val() || '';
                var lotVal = $('input[name="LotNo"]').val() || '';
                var effYear = parseInt($('input[name="EffectivityYear"]').val(), 10) || new Date().getFullYear();

                // Combination #1: {LGUCode}-{DistrictMunicipalityCode}-{BarangayCode:D4}-{SectionNo:D3}-{LotOrParcelNo:D3}
                var brgy4Arp = resolveCastBrgyCode(brgyVal, '0000');
                var sec3 = formatThreeDigitPart(secVal);
                var lot3 = formatThreeDigitPart(lotVal);
                var arpCombined = '187-00-' + brgy4Arp + '-' + sec3 + '-' + lot3;
                $('input[name="ARPNo"]').val(arpCombined);

                // Combination #2: {RevisionYearLastTwoDigits:D2}-{BarangayCode:D4}-{DeclarationNo:D5}
                var $tdInput = $('input[name="TaxDeclarationNumber"]');
                var currentTd = ($tdInput.val() || '').trim();
                var parts = currentTd.split('-');
                if (parts.length === 3 && /^\d{5}$/.test(parts[2])) {
                    var revYear2 = String(effYear % 100).padStart(2, '0');
                    var brgy4Td = resolveCastBrgyCode(brgyVal, '0001');
                    $tdInput.val(revYear2 + '-' + brgy4Td + '-' + parts[2]);
                }
            }

            $(document).on('input change', '#barangayInput, #landform select[name="DistrictOrBarangay"], input[name="SectionNo"], input[name="LotNo"], input[name="EffectivityYear"]', function() {
                if ($(this).is('#landform select[name="DistrictOrBarangay"]')) {
                    $('#barangayInput').val($(this).val());
                } else if ($(this).is('#barangayInput')) {
                    $('#landform select[name="DistrictOrBarangay"]').val($(this).val());
                }
                syncWizardCastArpAndTd();
            });
        });
    </script>
}
