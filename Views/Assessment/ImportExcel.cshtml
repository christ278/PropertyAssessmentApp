@{
    ViewData["Title"] = "Import Assessment Roll (Excel)";
    var barangays = ViewBag.KoronadalBarangays as List<string> ?? new List<string>();
}

<div class="space-y-6 font-sans pb-12">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                <span>Assessment Roll Excel Importer</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Import Assessment Roll (.xlsx)</h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-stone-400 mt-0.5">
                Retains <code class="font-mono">has.</code> units, auto-registers owners, flags missing-owner TDNs, and bridges Mother ↔ Child lineage.
            </p>
        </div>

        <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-300 dark:border-stone-700 bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-xs font-bold text-slate-700 dark:text-stone-200 shadow-xs transition">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Assessment Records
        </a>
    </div>

    <!-- Upload & Options Card -->
    <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-5">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400 mb-1.5">Excel File (.xlsx)</label>
                <input type="file" id="excelFileInput" accept=".xlsx" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 bg-slate-50 dark:bg-stone-950 text-xs font-semibold text-slate-800 dark:text-stone-100" />
            </div>
            <div class="md:col-span-3">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400 mb-1.5">Default Barangay (Koronadal City)</label>
                <select id="optBarangay" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 bg-slate-50 dark:bg-stone-950 text-xs font-semibold text-slate-800 dark:text-stone-100 cursor-pointer">
                    @foreach (var b in barangays)
                    {
                        bool isDefaultZone1 = b.Contains("Zone 1", StringComparison.OrdinalIgnoreCase) || (b.Contains("Zone I", StringComparison.OrdinalIgnoreCase) && !b.Contains("Zone II", StringComparison.OrdinalIgnoreCase) && !b.Contains("Zone III", StringComparison.OrdinalIgnoreCase) && !b.Contains("Zone IV", StringComparison.OrdinalIgnoreCase));
                        <option value="@b" selected="@(isDefaultZone1 ? "selected" : null)">@b</option>
                    }
                </select>
            </div>
            <div class="md:col-span-2">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400 mb-1.5">Municipality / City</label>
                <input type="text" id="optMunicipality" value="Koronadal City" readonly class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 bg-slate-100 dark:bg-stone-800 text-xs font-bold text-slate-500 dark:text-stone-400 cursor-not-allowed" />
            </div>
            <div class="md:col-span-2">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400 mb-1.5">Province</label>
                <input type="text" id="optProvince" value="South Cotabato" readonly class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 bg-slate-100 dark:bg-stone-800 text-xs font-bold text-slate-500 dark:text-stone-400 cursor-not-allowed" />
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-6 pt-2 border-t border-slate-100 dark:border-stone-800">
            <label class="inline-flex items-center gap-2 text-xs font-bold text-slate-700 dark:text-stone-200 cursor-pointer">
                <input type="checkbox" id="optRegisterOwners" checked class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                <span>Auto-Register Owners (Deduplicated)</span>
            </label>
            <label class="inline-flex items-center gap-2 text-xs font-bold text-slate-700 dark:text-stone-200 cursor-pointer">
                <input type="checkbox" id="optBridgeLineage" checked class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                <span>Bridge Mother ↔ Child Lineage</span>
            </label>
            <label class="inline-flex items-center gap-2 text-xs font-bold text-slate-700 dark:text-stone-200 cursor-pointer">
                <input type="checkbox" id="optUpdateExisting" class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
                <span>Overwrite Existing TDNs in Database</span>
            </label>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="button" id="btnPreviewImport" onclick="runPreview()" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-stone-800 dark:hover:bg-stone-700 text-white text-xs font-bold flex items-center gap-2 cursor-pointer">
                <i data-lucide="search" class="w-4 h-4"></i>
                Preview &amp; Validate File
            </button>
            <button type="button" id="btnExecuteImport" onclick="runImport()" disabled class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-bold flex items-center gap-2 shadow-sm cursor-pointer">
                <i data-lucide="upload-cloud" class="w-4 h-4"></i>
                Confirm &amp; Import to Roll
            </button>
        </div>
    </div>

    <!-- Status / Result Banner -->
    <div id="importStatusBanner" class="hidden p-4 rounded-2xl border text-xs font-bold"></div>

    <!-- Preview Summary -->
    <div id="previewPanel" class="hidden space-y-5">
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
            <div class="p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800">
                <div class="text-[10px] font-bold uppercase text-slate-400">Data Rows</div>
                <div id="prevTotal" class="text-xl font-extrabold text-slate-900 dark:text-white mt-1">0</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800">
                <div class="text-[10px] font-bold uppercase text-emerald-600">New TDNs</div>
                <div id="prevNew" class="text-xl font-extrabold text-emerald-600 mt-1">0</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800">
                <div class="text-[10px] font-bold uppercase text-sky-600">Already in DB</div>
                <div id="prevExisting" class="text-xl font-extrabold text-sky-600 mt-1">0</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800">
                <div class="text-[10px] font-bold uppercase text-rose-600">Dup in File</div>
                <div id="prevDup" class="text-xl font-extrabold text-rose-600 mt-1">0</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800">
                <div class="text-[10px] font-bold uppercase text-amber-600">No Owner Flag</div>
                <div id="prevNoOwner" class="text-xl font-extrabold text-amber-600 mt-1">0</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800">
                <div class="text-[10px] font-bold uppercase text-slate-500">Cancelled</div>
                <div id="prevCancelled" class="text-xl font-extrabold text-slate-700 dark:text-stone-200 mt-1">0</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800">
                <div class="text-[10px] font-bold uppercase text-violet-600">New Owners</div>
                <div id="prevNewOwners" class="text-xl font-extrabold text-violet-600 mt-1">0</div>
            </div>
        </div>

        <div id="prevWarnings" class="hidden p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-xs text-amber-900 dark:text-amber-200 space-y-1"></div>

        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
            <h2 class="text-sm font-extrabold text-slate-800 dark:text-white mb-3">Sample Rows (First 25)</h2>
            <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-stone-800">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="bg-slate-50 dark:bg-stone-950 border-b border-slate-200 dark:border-stone-800 text-[10px] uppercase text-slate-500">
                            <th class="px-3 py-2">Row</th>
                            <th class="px-3 py-2">TD No.</th>
                            <th class="px-3 py-2">Prev TD No.</th>
                            <th class="px-3 py-2">Owner</th>
                            <th class="px-3 py-2">Kind / Class</th>
                            <th class="px-3 py-2 text-right">Area (Retained)</th>
                            <th class="px-3 py-2 text-right">Market Value</th>
                            <th class="px-3 py-2">Superseded By</th>
                            <th class="px-3 py-2">Status</th>
                        </tr>
                    </thead>
                    <tbody id="sampleRowsBody" class="divide-y divide-slate-100 dark:divide-stone-800"></tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script>
    function buildFormData() {
        const fileInput = document.getElementById('excelFileInput');
        if (!fileInput.files || fileInput.files.length === 0) {
            alert('Please choose an .xlsx file first.');
            return null;
        }
        const fd = new FormData();
        fd.append('file', fileInput.files[0]);
        fd.append('defaultBarangay', document.getElementById('optBarangay').value.trim());
        fd.append('defaultMunicipality', document.getElementById('optMunicipality').value.trim());
        fd.append('defaultProvince', document.getElementById('optProvince').value.trim());
        fd.append('registerOwners', document.getElementById('optRegisterOwners').checked);
        fd.append('bridgeMotherChild', document.getElementById('optBridgeLineage').checked);
        fd.append('updateExisting', document.getElementById('optUpdateExisting').checked);
        return fd;
    }

    async function runPreview() {
        const fd = buildFormData();
        if (!fd) return;

        const banner = document.getElementById('importStatusBanner');
        banner.className = 'p-4 rounded-2xl border text-xs font-bold bg-slate-50 dark:bg-stone-900 border-slate-200 dark:border-stone-700 text-slate-700 dark:text-stone-200';
        banner.textContent = 'Parsing Excel file and validating records...';
        banner.classList.remove('hidden');

        const resp = await fetch('@Url.Action("PreviewExcelImport", "Assessment")', { method: 'POST', body: fd });
        const res = await resp.json();
        if (!res.success) {
            banner.className = 'p-4 rounded-2xl border text-xs font-bold bg-rose-50 border-rose-200 text-rose-800';
            banner.textContent = res.message;
            return;
        }

        const p = res.preview;
        banner.className = 'p-4 rounded-2xl border text-xs font-bold bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300';
        banner.textContent = `Preview ready for sheet "${p.sheetName}". Review the summary below, then click "Confirm & Import to Roll".`;

        document.getElementById('prevTotal').textContent = p.totalDataRows.toLocaleString();
        document.getElementById('prevNew').textContent = p.newTdnCount.toLocaleString();
        document.getElementById('prevExisting').textContent = p.existingInDbCount.toLocaleString();
        document.getElementById('prevDup').textContent = p.duplicateInFileCount.toLocaleString();
        document.getElementById('prevNoOwner').textContent = p.noOwnerCount.toLocaleString();
        document.getElementById('prevCancelled').textContent = p.cancelledCount.toLocaleString();
        document.getElementById('prevNewOwners').textContent = p.newOwnersToRegisterCount.toLocaleString();

        const warnEl = document.getElementById('prevWarnings');
        if (p.warnings && p.warnings.length > 0) {
            warnEl.innerHTML = p.warnings.map(w => `<div>• ${escHtml(w)}</div>`).join('');
            warnEl.classList.remove('hidden');
        } else {
            warnEl.classList.add('hidden');
        }

        const tbody = document.getElementById('sampleRowsBody');
        tbody.innerHTML = (p.sampleRows || []).map(r => `
            <tr>
                <td class="px-3 py-2 font-mono text-slate-400">${r.rowNumber}</td>
                <td class="px-3 py-2 font-mono font-bold">${escHtml(r.tdNo)}</td>
                <td class="px-3 py-2 font-mono text-slate-500">${escHtml(r.previousTdNo || '—')}</td>
                <td class="px-3 py-2 font-bold">${escHtml(r.ownerName)}</td>
                <td class="px-3 py-2">${escHtml(r.kind)} / ${escHtml(r.classification)}</td>
                <td class="px-3 py-2 text-right font-mono">${escHtml(r.areaRaw)}</td>
                <td class="px-3 py-2 text-right font-mono">₱${Number(r.marketValue || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
                <td class="px-3 py-2 font-mono text-rose-600">${escHtml(r.supersededBy || '—')}</td>
                <td class="px-3 py-2"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-stone-800">${escHtml(r.statusNote)}</span></td>
            </tr>
        `).join('');

        document.getElementById('previewPanel').classList.remove('hidden');
        document.getElementById('btnExecuteImport').disabled = false;
    }

    async function runImport() {
        const fd = buildFormData();
        if (!fd) return;

        const btn = document.getElementById('btnExecuteImport');
        btn.disabled = true;
        const banner = document.getElementById('importStatusBanner');
        banner.className = 'p-4 rounded-2xl border text-xs font-bold bg-sky-50 border-sky-200 text-sky-800';
        banner.textContent = 'Importing records, registering owners, and bridging Mother ↔ Child lineage... Please wait.';
        banner.classList.remove('hidden');

        const resp = await fetch('@Url.Action("ExecuteExcelImport", "Assessment")', { method: 'POST', body: fd });
        const res = await resp.json();
        btn.disabled = false;

        if (!res.success) {
            banner.className = 'p-4 rounded-2xl border text-xs font-bold bg-rose-50 border-rose-200 text-rose-800';
            banner.textContent = res.message;
            return;
        }

        const r = res.result;
        banner.className = 'p-4 rounded-2xl border text-xs font-bold bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300';
        banner.textContent = `Import complete! Imported: ${r.importedCount}, Updated: ${r.updatedCount}, Skipped: ${r.skippedCount}, Owners Registered: ${r.ownersRegisteredCount}, Lineage Links Bridged: ${r.lineageBridgedCount}, Flagged No Owner: ${r.noOwnerFlaggedCount}.`;
    }

    function escHtml(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
</script>
