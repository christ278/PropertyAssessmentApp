@model PropertyAssessmentApp.Models.TaxDeclaration
@using PropertyAssessmentApp.Models
@{
    var latestTagging = ViewBag.LatestTagging as PropertyTagging;
    bool isCancelled = Model.IsCancelledAndSuperseded || Model.Status == AssessmentStatus.Cancelled || latestTagging?.TagType == PropertyTagType.Cancellation;
    bool isMortgage = !isCancelled && latestTagging?.TagType == PropertyTagType.Mortgage;
    bool isBailbond = !isCancelled && latestTagging?.TagType == PropertyTagType.Bailbond;
    bool isRelease = !isCancelled && latestTagging?.TagType == PropertyTagType.Release;
    bool hasStamp = isCancelled || isMortgage || isBailbond || isRelease;

    string stampColor = isCancelled
        ? "text-rose-700/25 dark:text-rose-400/25 border-rose-600/30 dark:border-rose-400/30"
        : isMortgage
            ? "text-amber-700/30 dark:text-amber-400/25 border-amber-600/35 dark:border-amber-400/30"
            : isBailbond
                ? "text-indigo-700/25 dark:text-indigo-400/25 border-indigo-600/30 dark:border-indigo-400/30"
                : "text-teal-700/25 dark:text-teal-400/25 border-teal-600/30 dark:border-teal-400/30";

    string tdDisplay = string.IsNullOrWhiteSpace(Model.TaxDeclarationNumber) ? "____________" : Model.TaxDeclarationNumber;
    string amtDisplay = latestTagging?.Amount.HasValue == true ? $"₱ {latestTagging.Amount.Value:N2}" : "____________";
    string dateDisplay = latestTagging?.TagDate.HasValue == true ? latestTagging.TagDate.Value.ToString("MMM dd, yyyy") : "____________";
}

@if (hasStamp)
{
    <div class="pointer-events-none select-none absolute inset-0 z-10 flex items-center justify-center p-4 overflow-hidden">
        <div class="-rotate-12 border-[5px] rounded-2xl p-1.5 min-w-[330px] sm:min-w-[540px] md:min-w-[640px] max-w-[92%] @stampColor">
            <div class="border-2 rounded-xl px-6 sm:px-10 py-4 @stampColor">
                @if (isCancelled)
                {
                    var dtCancel = Model.DateCancelled ?? latestTagging?.DateCancelled;
                    var reason = !string.IsNullOrWhiteSpace(Model.CancellationReason) ? Model.CancellationReason : (latestTagging?.ReasonForCancellation ?? "Cancelled & Superseded");
                    <div class="text-center space-y-1.5 uppercase">
                        <div class="text-3xl sm:text-5xl font-black tracking-[0.24em] leading-none">CANCELLED</div>
                        <div class="text-[11px] sm:text-xs font-extrabold tracking-wider">(T.D.) @tdDisplay</div>
                        <div class="text-[10px] sm:text-xs font-bold tracking-wide">REASON: @reason</div>
                        <div class="text-[10px] sm:text-xs font-bold tracking-wider">DATE CANCELLED: @(dtCancel.HasValue ? dtCancel.Value.ToString("MMM dd, yyyy") : "____________")</div>
                    </div>
                }
                else if (isMortgage || isBailbond)
                {
                    var actionPhrase = isMortgage ? "IS MORTGAGED TO:" : "IS BAILBOND TO:";
                    var party = !string.IsNullOrWhiteSpace(latestTagging?.PartyName) ? latestTagging.PartyName.ToUpperInvariant() : "PNB, DBP, LBP";
                    <div class="space-y-1.5 uppercase text-left">
                        <div class="text-xs sm:text-sm font-black tracking-[0.14em] text-center border-b border-current pb-1">
                            PROPERTY DESCRIBED UNDER THIS ASSESSMENT
                        </div>
                        <div class="text-[11px] sm:text-xs font-extrabold tracking-wide">(T.D.) <span class="underline decoration-1 underline-offset-2">@tdDisplay</span></div>
                        <div class="text-[11px] sm:text-xs font-black tracking-wide">@actionPhrase <span class="underline decoration-1 underline-offset-2">@party</span></div>
                        <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] sm:text-xs font-extrabold tracking-wide">
                            <span>AMOUNT: <span class="underline decoration-1 underline-offset-2">@amtDisplay PESOS</span></span>
                            <span>DATE: <span class="underline decoration-1 underline-offset-2">@dateDisplay</span></span>
                        </div>
                    </div>
                }
                else if (isRelease)
                {
                    <div class="space-y-1.5 uppercase text-left">
                        <div class="text-sm sm:text-lg font-black tracking-[0.18em] text-center border-b border-current pb-1">
                            RELEASED OF MORTGAGE
                        </div>
                        <div class="grid grid-cols-2 gap-x-6 gap-y-1 text-[10px] sm:text-xs font-extrabold tracking-wide">
                            <div>DATE: <span class="underline decoration-1 underline-offset-2">@dateDisplay</span></div>
                            <div>PER DOC NO.: <span class="underline decoration-1 underline-offset-2">@(latestTagging?.PerDocNo ?? "________")</span></div>
                            <div>PAGE NO.: <span class="underline decoration-1 underline-offset-2">@(latestTagging?.PageNo ?? "________")</span></div>
                            <div>BOOK NO.: <span class="underline decoration-1 underline-offset-2">@(latestTagging?.BookNo ?? "________")</span></div>
                            <div>SERIES OF: <span class="underline decoration-1 underline-offset-2">@(latestTagging?.SeriesOf ?? "________")</span></div>
                            <div>AMOUNT: <span class="underline decoration-1 underline-offset-2">@amtDisplay</span></div>
                        </div>
                        <div class="text-[10px] sm:text-xs font-extrabold tracking-wide pt-0.5">
                            POSTED BY: <span class="underline decoration-1 underline-offset-2">@(latestTagging?.PostedByName ?? "____________________")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
