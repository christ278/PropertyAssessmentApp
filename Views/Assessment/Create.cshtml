@model PropertyAssessmentApp.Models.TaxDeclaration
@{
    ViewData["Title"] = "Encode Real Property Tax Declaration";
    var partitionItem = ViewBag.PartitionItem as PropertyAssessmentApp.Models.AssessmentPartitionItem ?? new PropertyAssessmentApp.Models.AssessmentPartitionItem
    {
        Kind = Model.Kind.ToString(),
        SystemGeneratedTDN = Model.TaxDeclarationNumber,
        PIN = Model.PropertyIndexNumber,
        ARPNo = Model.ARPNo,
        EffectivityYear = Model.EffectivityYear > 0 ? Model.EffectivityYear : DateTime.Now.Year,
        AssessmentLevelPercent = Model.AssessmentLevelPercent
    };
    var displayTdn = !string.IsNullOrWhiteSpace(partitionItem.SystemGeneratedTDN) ? partitionItem.SystemGeneratedTDN : "TDN System Pending";
    var showKindModalOnLoad = (ViewBag.KindExplicitlySelected as bool?) != true;
}

<partial name="_Select2Style" />

<div class="space-y-8 font-mono text-xs">

    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="file-plus-2" class="w-4 h-4"></i>
                <span>Encode Real Property Tax Declaration &bull; Full CAST Appraisal Specification</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
                <i data-lucide="building-2" class="w-7 h-7 text-emerald-600 dark:text-emerald-400"></i>
                <span>Encode Real Property Tax Declaration</span>
            </h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">
                Select Property Kind (<strong class="text-slate-700 dark:text-stone-200">Land</strong>, <strong class="text-slate-700 dark:text-stone-200">Building</strong>, or <strong class="text-slate-700 dark:text-stone-200">Machinery</strong>) and encode using the standard CAST Partition Appraisal schedule.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" onclick="openSelectPropertyKindModal()" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 hover:bg-amber-100 dark:hover:bg-amber-900/50 text-amber-800 dark:text-amber-300 font-bold text-xs font-mono border border-amber-300 dark:border-amber-800 shadow-sm flex items-center justify-center gap-2 transition-all">
                <i data-lucide="layers" class="w-4 h-4"></i>
                Select Property Kind
            </button>
            <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm transition-all">
                Cancel &amp; Return
            </a>
            <button type="button" onclick="submitPartitionForm()" class="w-full sm:w-auto text-center px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs font-mono flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                <i data-lucide="save" class="w-4 h-4"></i>
                Save Tax Declaration (FAAS)
            </button>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800/40 text-rose-700 dark:text-rose-300 text-xs font-mono">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form id="partitionForm" asp-controller="Assessment" asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" name="partitionJsonPayload" id="partitionJsonPayload" />
            <input type="hidden" name="BasePropertyId" value="@partitionItem.BasePropertyId" />
            <input type="hidden" name="OwnerId" id="inputPartitionOwnerId" value="@partitionItem.OwnerId" />
            <input type="hidden" name="BaseTDN" value="@partitionItem.BaseTDN" />
            <input type="hidden" name="PartitionIndex" value="A" />
            <input type="hidden" name="PropertyLocation" id="inputPropertyLocation" value="@partitionItem.PropertyLocation" />
            <input type="hidden" name="TotalBuildingAreaSqm" id="inputTotalBuildingAreaSqm" value="@partitionItem.TotalBuildingAreaSqm" />
            <input type="hidden" name="AdministratorAddress" id="inputAdminAddress" value="@partitionItem.AdministratorAddress" />
            <input type="hidden" name="AdministratorContactNo" id="inputAdminContact" value="@partitionItem.AdministratorContactNo" />
            <input type="hidden" name="AdministratorTin" id="inputAdminTin" value="@partitionItem.AdministratorTin" />
            <input type="hidden" name="AdministratorGender" id="inputAdminGender" value="@partitionItem.AdministratorGender" />
            <input type="hidden" name="AdministratorCivilStatus" id="inputAdminCivilStatus" value="@partitionItem.AdministratorCivilStatus" />
            <input type="hidden" name="AdministratorEmail" id="inputAdminEmail" value="@partitionItem.AdministratorEmail" />

            <!-- Hidden JSON storage for Floor Breakdown & Additions -->
            <input type="hidden" name="BuildingFloorBreakdownJson" id="buildingFloorBreakdownJson" value="@partitionItem.BuildingFloorBreakdownJson" />
            <input type="hidden" name="BaseRcnValue" id="baseRcnValue" value="@partitionItem.BaseRcnValue" />
            <input type="hidden" name="BuildingAdditionalItemsJson" id="buildingAdditionalItemsJson" value="@partitionItem.BuildingAdditionalItemsJson" />
            <input type="hidden" name="BuildingTotalAdditionsValue" id="buildingTotalAdditionsValue" value="@partitionItem.BuildingTotalAdditionsValue" />
            <input type="hidden" name="BuildingDepreciationAccumulated" id="buildingDepreciationAccumulated" value="@partitionItem.BuildingDepreciationAccumulated" />
            <input type="hidden" name="BuildingDepreciatedMarketValue" id="buildingDepreciatedMarketValue" value="@partitionItem.BuildingDepreciatedMarketValue" />

            <!-- Tracking, Kind Switcher & Transaction Code Header -->
            <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3 flex-wrap">
                    <span class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-extrabold text-xs font-mono" id="displayKindBadge">
                        @(partitionItem.Kind == "Building" ? "Building / Structure Appraisal (CAST)" : (partitionItem.Kind == "Machinery" ? "Machinery & Equipment Appraisal (CAST)" : "Land Appraisal / FAAS TDN (CAST)"))
                    </span>
                    <div class="inline-flex items-center gap-1.5 text-slate-700 dark:text-stone-300 text-xs font-mono font-bold">
                        <span>TDN:</span>
                        <input type="text" name="SystemGeneratedTDN" id="inputTdn" value="@displayTdn" class="px-2.5 py-1 rounded-lg bg-white dark:bg-stone-900 border border-emerald-300 dark:border-emerald-700 text-emerald-700 dark:text-emerald-400 font-mono font-bold text-xs w-40 focus:outline-none focus:border-emerald-600" />
                        <span class="hidden" id="displayHeaderTdn">@displayTdn</span>
                        <span class="hidden" id="bannerDisplayTdn">@displayTdn</span>
                    </div>
                    <span class="text-slate-700 dark:text-stone-300 text-xs font-mono font-bold">
                        &bull; ARP NO: <span class="text-emerald-700 dark:text-emerald-400 font-mono font-bold" id="bannerDisplayArpNo">@(string.IsNullOrWhiteSpace(partitionItem.ARPNo) ? "187-00-0000-000-000" : partitionItem.ARPNo)</span>
                    </span>
                    <div class="inline-flex items-center gap-1.5">
                        <span class="text-slate-600 dark:text-stone-400 text-[11px] font-bold">TX CODE:</span>
                        <select asp-for="TransactionCode" class="px-2.5 py-1 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono font-bold text-xs text-slate-800 dark:text-stone-200">
                            <option value="DC">DC - Discovery / New Declaration</option>
                            <option value="TR">TR - Transfer of Ownership</option>
                            <option value="SD">SD - Subdivision</option>
                            <option value="CS">CS - Consolidation</option>
                            <option value="PC">PC - Physical Change / Reassessment</option>
                            <option value="RC">RC - Reclassification</option>
                            <option value="GR">GR - General Revision</option>
                        </select>
                    </div>
                </div>

                <!-- Property Kind Label (Selected Before Opening Form) -->
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-bold uppercase text-slate-500 dark:text-stone-400">Property Kind:</span>
                    <span id="displayPropertyKindLabel" class="px-3.5 py-1.5 text-xs font-extrabold font-mono rounded-xl bg-emerald-600 text-white shadow-xs inline-flex items-center gap-1.5">
                        <i data-lucide="@(partitionItem.Kind == "Building" ? "building-2" : (partitionItem.Kind == "Machinery" ? "cog" : "map"))" class="w-3.5 h-3.5"></i>
                        <span id="displayPropertyKindText">@(string.IsNullOrWhiteSpace(partitionItem.Kind) ? "Land" : partitionItem.Kind)</span>
                    </span>
                </div>
            </div>

            <input type="hidden" name="Kind" id="inputKindHidden" value="@(partitionItem.Kind ?? "Land")" />

            <!-- CONTAINER 1: LAND APPRAISAL FORM (REUSED FROM PARTITION APPRAISAL) -->
            <div id="container-land-appraisal" class="space-y-6 @(partitionItem.Kind == "Building" || partitionItem.Kind == "Machinery" ? "hidden" : "")">
                <partial name="~/Views/PropertyAssessmentRequest/_LandPartitionForm.cshtml" model="partitionItem" />
            </div>

            <!-- CONTAINER 2: BUILDING APPRAISAL FORM (REUSED FROM PARTITION APPRAISAL) -->
            <div id="container-building-appraisal" class="space-y-6 @(partitionItem.Kind == "Building" ? "" : "hidden")">
                <partial name="~/Views/PropertyAssessmentRequest/_BuildingPartitionForm.cshtml" model="partitionItem" />
            </div>

            <!-- CONTAINER 3: MACHINERY APPRAISAL FORM (REUSED FROM PARTITION APPRAISAL) -->
            <div id="container-machinery-appraisal" class="space-y-6 @(partitionItem.Kind == "Machinery" ? "" : "hidden")">
                <partial name="~/Views/PropertyAssessmentRequest/_MachineryPartitionForm.cshtml" model="partitionItem" />
            </div>

            <!-- Hidden input for Inspection Photos & FairTrack mobile sync -->
            <input type="hidden" name="AttachmentsJson" id="AttachmentsJson" value="@Model.PropertyImagesJson" />
            <input type="hidden" name="PropertyImagesJson" id="PropertyImagesJson" value="@Model.PropertyImagesJson" />
            <input type="file" id="fileUploadInspectionPhotos" multiple accept="image/*" class="hidden" onchange="handleWebInspectionPhotos(event)" />

            <!-- Submit Button Footer -->
            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <a asp-action="Index" class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold font-mono transition-all">
                    Cancel &amp; Return
                </a>
                <button type="button" onclick="submitPartitionForm()" class="w-full sm:w-auto text-center px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold font-mono flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Save Real Property Tax Declaration
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: SELECT PROPERTY KIND (LAND / BUILDING / MACHINERY) -->
<div id="selectPropertyKindModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm @(showKindModalOnLoad ? "" : "hidden") font-mono text-xs">
    <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-3xl w-full max-w-3xl p-6 sm:p-8 shadow-2xl space-y-6">
        <div class="flex items-start justify-between border-b border-slate-200 dark:border-stone-800 pb-4">
            <div>
                <div class="inline-flex items-center gap-2 text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase mb-1">
                    <i data-lucide="Sparkles" class="w-3.5 h-3.5"></i> Step 1 &bull; Property Kind Selection
                </div>
                <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 dark:text-white">
                    Select Property Kind to Encode
                </h2>
                <p class="text-xs text-slate-500 dark:text-stone-400 mt-1">
                    Choose the kind of real property declaration to load the corresponding CAST Partition Appraisal form fields.
                </p>
            </div>
            <button type="button" onclick="closeSelectPropertyKindModal()" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 dark:hover:bg-stone-800 transition-colors" title="Close">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Option 1: LAND -->
            <button type="button" onclick="selectKindFromModal('Land')" class="group text-left p-5 rounded-2xl border-2 border-slate-200 dark:border-stone-800 hover:border-emerald-600 dark:hover:border-emerald-500 bg-slate-50/70 dark:bg-stone-950 hover:bg-emerald-50/40 dark:hover:bg-emerald-950/20 transition-all flex flex-col justify-between space-y-4 shadow-xs hover:shadow-md cursor-pointer">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                        <i data-lucide="map" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block">Real Property Kind</span>
                        <h3 class="text-base font-extrabold text-slate-900 dark:text-white mt-0.5">1. Land</h3>
                    </div>
                    <p class="text-[11px] text-slate-500 dark:text-stone-400 leading-relaxed">
                        Cadastral &amp; Title Registration, Location &amp; N/E/S/W Boundaries, Owner Demographics, and 4 CAST Valuation Schedules.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-200/80 dark:border-stone-800 flex items-center justify-between text-emerald-700 dark:text-emerald-400 font-bold text-xs">
                    <span>Load Land Form</span>
                    <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                </div>
            </button>

            <!-- Option 2: BUILDING -->
            <button type="button" onclick="selectKindFromModal('Building')" class="group text-left p-5 rounded-2xl border-2 border-slate-200 dark:border-stone-800 hover:border-emerald-600 dark:hover:border-emerald-500 bg-slate-50/70 dark:bg-stone-950 hover:bg-emerald-50/40 dark:hover:bg-emerald-950/20 transition-all flex flex-col justify-between space-y-4 shadow-xs hover:shadow-md cursor-pointer">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-sky-100 dark:bg-sky-950/70 text-sky-700 dark:text-sky-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                        <i data-lucide="building-2" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 block">Real Property Kind</span>
                        <h3 class="text-base font-extrabold text-slate-900 dark:text-white mt-0.5">2. Building</h3>
                    </div>
                    <p class="text-[11px] text-slate-500 dark:text-stone-400 leading-relaxed">
                        Property Info &amp; CCT, Floor Plan Sketch, Structural Specs &amp; 17 Materials Checklist, Floor Levels (BUCC), Additions &amp; Depreciation.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-200/80 dark:border-stone-800 flex items-center justify-between text-sky-700 dark:text-sky-400 font-bold text-xs">
                    <span>Load Building Form</span>
                    <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                </div>
            </button>

            <!-- Option 3: MACHINERY -->
            <button type="button" onclick="selectKindFromModal('Machinery')" class="group text-left p-5 rounded-2xl border-2 border-slate-200 dark:border-stone-800 hover:border-emerald-600 dark:hover:border-emerald-500 bg-slate-50/70 dark:bg-stone-950 hover:bg-emerald-50/40 dark:hover:bg-emerald-950/20 transition-all flex flex-col justify-between space-y-4 shadow-xs hover:shadow-md cursor-pointer">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-2xl bg-amber-100 dark:bg-amber-950/70 text-amber-700 dark:text-amber-400 flex items-center justify-center group-hover:scale-105 transition-transform">
                        <i data-lucide="cog" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 block">Real Property Kind</span>
                        <h3 class="text-base font-extrabold text-slate-900 dark:text-white mt-0.5">3. Machinery</h3>
                    </div>
                    <p class="text-[11px] text-slate-500 dark:text-stone-400 leading-relaxed">
                        Land &amp; Building Reference, Imported/Local Registration, 16-Column Machinery Appraisal Schedule (RCN &amp; Depreciation) &amp; Roll.
                    </p>
                </div>
                <div class="pt-3 border-t border-slate-200/80 dark:border-stone-800 flex items-center justify-between text-amber-700 dark:text-amber-400 font-bold text-xs">
                    <span>Load Machinery Form</span>
                    <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                </div>
            </button>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-slate-200 dark:border-stone-800 text-[11px] text-slate-400">
            <span>Tip: Select the property kind to load the appropriate FAAS encoding schedule.</span>
            <button type="button" onclick="closeSelectPropertyKindModal()" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-stone-700 text-slate-600 dark:text-stone-300 font-bold hover:bg-slate-100 dark:hover:bg-stone-800">
                Continue with Current Selection
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/select2/select2.min.js"></script>
    <partial name="~/Views/PropertyAssessmentRequest/_PartitionAppraisalScripts.cshtml" model="partitionItem" />
}
