    <!-- 7. BACK TAXES PERIOD & ASSESSMENT BASIS (CAST REFERENCE) -->
    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <h4 class="text-xs font-bold uppercase text-slate-800 dark:text-stone-200 flex items-center gap-2">
            <i data-lucide="history" class="w-4 h-4 text-emerald-600"></i>
            Back Taxes Period & Assessment Basis
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label asp-for="AssessmentBasis" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BASIS OF ASSESSMENT</label>
                <input asp-for="AssessmentBasis" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" placeholder="e.g. Sec. 217 RA 7160 / Ordinance No. X" />
            </div>
            <div>
                <label asp-for="BackTaxesYearFrom" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BACK TAXES FROM YEAR</label>
                <input asp-for="BackTaxesYearFrom" type="number" min="1950" max="2099" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="e.g. 2021" />
            </div>
            <div>
                <label asp-for="BackTaxesYearTo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BACK TAXES TO YEAR</label>
                <input asp-for="BackTaxesYearTo" type="number" min="1950" max="2099" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="e.g. 2025" />
            </div>
        </div>
    </div>

    <!-- MODAL: ADD FLOOR LEVEL (CAST) -->
    <div id="addFloorModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
        <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-3">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="layers" class="w-4 h-4 text-emerald-600"></i> Add Floor Level / Component
                </h3>
                <button type="button" onclick="closeAddFloorModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-stone-300">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">STOREY / LEVEL</label>
                    <select id="modalFloorLevel" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs font-bold">
                        <option value="1st Floor">1st Floor (Ground Level)</option>
                        <option value="2nd Floor">2nd Floor</option>
                        <option value="3rd Floor">3rd Floor</option>
                        <option value="4th Floor">4th Floor</option>
                        <option value="Mezzanine">Mezzanine Level</option>
                        <option value="Basement">Basement Level</option>
                        <option value="Roof Deck">Roof Deck / Penthouse</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">DESCRIPTION / USE</label>
                    <input type="text" id="modalFloorDesc" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs" placeholder="e.g. Main Living & Dining, Bedrooms" value="Living & Dining Area" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">AREA (SQ.M.)</label>
                        <input type="number" id="modalFloorArea" step="0.01" min="0" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold" placeholder="0.00" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">BUCC RATE (PHP/SQ.M.)</label>
                        <input type="number" id="modalFloorUnitCost" step="0.01" min="0" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold" placeholder="0.00" value="8500" />
                    </div>
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-stone-800">
                <button type="button" onclick="closeAddFloorModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-stone-700 text-xs font-bold text-slate-700 dark:text-stone-300 hover:bg-slate-100">Cancel</button>
                <button type="button" onclick="saveFloorLevel()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm">Save Floor</button>
            </div>
        </div>
    </div>

    <!-- MODAL: ADD ADDITIONAL IMPROVEMENT ITEM (CAST) -->
    <div id="addAdditionModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
        <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-3">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="plus-circle" class="w-4 h-4 text-sky-600"></i> Add Additional Improvement Item
                </h3>
                <button type="button" onclick="closeAddAdditionModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-stone-300">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">STANDARD PRESET</label>
                    <select id="modalAdditionPreset" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs font-bold">
                        <option value="custom">-- Custom Item / Improvement --</option>
                        <option value="CARPORT" data-rate="30" data-type="Percent">Carport (30% of BUCC)</option>
                        <option value="MEZZANINE" data-rate="60" data-type="Percent">Mezzanine (60% of BUCC)</option>
                        <option value="PORCH" data-rate="40" data-type="Percent">Porch (40% of BUCC)</option>
                        <option value="BALCONY" data-rate="45" data-type="Percent">Balcony (45% of BUCC)</option>
                        <option value="GARAGE" data-rate="45" data-type="Percent">Garage (45% of BUCC)</option>
                        <option value="TERRACE : COVERED" data-rate="40" data-type="Percent">Terrace : Covered (40% of BUCC)</option>
                        <option value="TERRACE : OPEN" data-rate="20" data-type="Percent">Terrace : Open (20% of BUCC)</option>
                        <option value="DECK ROOF : COVERED" data-rate="40" data-type="Percent">Deck Roof : Covered (40% of BUCC)</option>
                        <option value="DECK ROOF : OPEN" data-rate="20" data-type="Percent">Deck Roof : Open (20% of BUCC)</option>
                        <option value="BASEMENT : RESIDENTIAL" data-rate="70" data-type="Percent">Basement : Residential (70% of BUCC)</option>
                        <option value="PAVEMENT : CONCRETE 10 CM" data-rate="150" data-type="FixedCost">Concrete Pavement 10cm (₱150/sq.m.)</option>
                        <option value="PAVEMENT : CONCRETE 15 CM" data-rate="225" data-type="FixedCost">Concrete Pavement 15cm (₱225/sq.m.)</option>
                        <option value="FLOOR FINISH : GRANITE TILES" data-rate="1000" data-type="FixedCost">Granite Tiles Finish (₱1,000/sq.m.)</option>
                        <option value="FLOOR FINISH : CERAMIC TILES" data-rate="600" data-type="FixedCost">Ceramic Tiles Finish (₱600/sq.m.)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">ITEM DESCRIPTION</label>
                    <input type="text" id="modalAdditionDesc" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs" placeholder="e.g. Carport, Open Terrace, Fence" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">QUANTITY / AREA</label>
                        <input type="number" id="modalAdditionQty" step="0.01" min="0" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold" placeholder="1.00" value="1" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1" id="modalAdditionRateLabel">UNIT RATE / COST (PHP)</label>
                        <input type="number" id="modalAdditionRate" step="0.01" min="0" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold" placeholder="0.00" />
                    </div>
                </div>
                <div id="modalMultiplierRow" class="hidden">
                    <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">PERCENT MULTIPLIER (%)</label>
                    <input type="number" id="modalAdditionMultiplier" step="0.1" min="0" max="100" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold" placeholder="0" />
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-stone-800">
                <button type="button" onclick="closeAddAdditionModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-stone-700 text-xs font-bold text-slate-700 dark:text-stone-300 hover:bg-slate-100">Cancel</button>
                <button type="button" onclick="saveAdditionItem()" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-sm">Save Improvement</button>
            </div>
        </div>
    </div>
</div>
