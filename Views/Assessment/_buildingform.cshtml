                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">QUANTITY / AREA</label>
                        <input type="number" id="modalAdditionQty" step="0.01" min="0" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold" placeholder="1.00" value="1" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1" id="modalAdditionRateLabel">UNIT RATE / COST (PHP)</label>
                        <input type="number" id="modalAdditionRate" step="0.01" min="0" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold" placeholder="0.00" />
                    </div>
                </div>
                <div id="modalMultiplierRow" class="hidden">
                    <label class="block text-xs font-bold text-slate-600 dark:text-stone-400 mb-1">PERCENT MULTIPLIER (%)</label>
                    <input type="number" id="modalAdditionMultiplier" step="0.1" min="0" max="100" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold" placeholder="0" />
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200 dark:border-stone-800">
                <button type="button" onclick="closeAddAdditionModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-stone-700 text-xs font-bold text-slate-700 dark:text-stone-300 hover:bg-slate-100">Cancel</button>
                <button type="button" onclick="saveAdditionItem()" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-sm">Save Improvement</button>
            </div>
        </div>
    </div>

    <!-- MODAL: OFFICIAL SCHEDULE OF BUILDING DEPRECIATION (BLGF / MRPAAO I - V-B) -->
    <div id="depreciationScheduleModal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-900/70 backdrop-blur-sm hidden">
        <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-2xl w-full max-w-5xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-2 px-5 py-3.5 bg-teal-900 text-white border-b border-teal-800">
                <div>
                    <h3 class="text-sm font-extrabold uppercase tracking-wide flex items-center gap-2">
                        <i data-lucide="table-2" class="w-4 h-4 text-teal-300"></i>
                        Schedule of Building Physical Depreciation (% Depreciation)
                    </h3>
                    <p class="text-[11px] text-teal-200">Click any cell in the schedule below to apply that Building Classification, Age, and Depreciation Rate (%).</p>
                </div>
                <button type="button" onclick="closeDepreciationScheduleModal()" class="p-1.5 rounded-lg bg-teal-800/80 hover:bg-teal-700 text-teal-100 transition-colors">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="p-4 overflow-auto flex-1">
                <table class="w-full border-collapse text-center font-mono text-xs border border-slate-300 dark:border-stone-700" id="officialDeprScheduleTable">
                    <thead>
                        <tr class="bg-teal-900 text-white font-bold uppercase text-[11px]">
                            <th rowspan="2" class="border border-teal-700 px-3 py-2 w-36">General Revision<br />Cycle</th>
                            <th rowspan="2" class="border border-teal-700 px-2.5 py-2 w-20">Bldg.<br />Age</th>
                            <th colspan="9" class="border border-teal-700 px-3 py-1.5 tracking-wider">Building Classification (% Depreciation)</th>
                        </tr>
                        <tr class="bg-teal-600 text-white font-extrabold text-xs">
                            @foreach (var cls in PropertyAssessmentApp.Services.BuildingDepreciationSchedule.Classifications)
                            {
                                <th class="border border-teal-700 px-2.5 py-1.5 sched-col-header" data-col-class="@cls.Code">@cls.Code</th>
                            }
                        </tr>
                        <tr class="bg-teal-100 dark:bg-teal-950/70 text-teal-950 dark:text-teal-200 font-bold text-[11px]">
                            <td colspan="2" class="border border-slate-300 dark:border-stone-700 px-3 py-1.5 text-right font-extrabold">Estimated Economic Life:</td>
                            @foreach (var cls in PropertyAssessmentApp.Services.BuildingDepreciationSchedule.Classifications)
                            {
                                <td class="border border-slate-300 dark:border-stone-700 px-2 py-1.5 sched-col-meta" data-col-class="@cls.Code">@(cls.EconomicLifeYears)y</td>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-stone-800">
                        @{
                            var rows = PropertyAssessmentApp.Services.BuildingDepreciationSchedule.Rows;
                            for (int rIdx = 0; rIdx < rows.Count; rIdx++)
                            {
                                var r = rows[rIdx];
                                bool isFirstInCycle = (rIdx == 0) || !string.Equals(rows[rIdx - 1].GeneralRevisionCycle, r.GeneralRevisionCycle, StringComparison.Ordinal);
                                int cycleRowSpan = 1;
                                if (isFirstInCycle)
                                {
                                    cycleRowSpan = rows.Count(x => string.Equals(x.GeneralRevisionCycle, r.GeneralRevisionCycle, StringComparison.Ordinal));
                                }
                                <tr class="sched-age-row hover:bg-slate-50 dark:hover:bg-stone-800/50 transition-colors" data-min-age="@r.MinAge" data-max-age="@r.MaxAge" data-age-label="@r.AgeLabel">
                                    @if (isFirstInCycle)
                                    {
                                        <td rowspan="@cycleRowSpan" class="border border-slate-300 dark:border-stone-700 px-3 py-2 text-left font-bold bg-slate-100 dark:bg-stone-800 text-slate-800 dark:text-stone-200 align-middle">
                                            @r.GeneralRevisionCycle
                                        </td>
                                    }
                                    <td class="border border-slate-300 dark:border-stone-700 px-2 py-1.5 font-bold bg-slate-50 dark:bg-stone-900 text-slate-800 dark:text-stone-200">
                                        @r.AgeLabel
                                    </td>
                                    @foreach (var cls in PropertyAssessmentApp.Services.BuildingDepreciationSchedule.Classifications)
                                    {
                                        var explicitRate = r.RatesByClass.TryGetValue(cls.Code, out var rVal) ? rVal : null;
                                        var effectiveRate = explicitRate ?? cls.MaxDepreciationFromResidualPercent;
                                        var isCapped = !explicitRate.HasValue;
                                        <td class="border border-slate-300 dark:border-stone-700 px-2 py-1.5 cursor-pointer transition-all hover:bg-emerald-100 dark:hover:bg-emerald-900/50 sched-rate-cell @(isCapped ? "text-slate-400 dark:text-stone-500" : "text-slate-800 dark:text-stone-200 font-semibold")"
                                            data-class="@cls.Code"
                                            data-min-age="@r.MinAge"
                                            data-max-age="@r.MaxAge"
                                            data-rate="@effectiveRate.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-capped="@(isCapped ? "true" : "false")"
                                            title="Click to apply Class @cls.Code (Age @r.AgeLabel): @(explicitRate.HasValue ? $"{explicitRate.Value:0.0}% Depreciation" : $"Residual Cap {effectiveRate:0.0}% ({cls.ResidualValuePercent}% Residual Value)")"
                                            onclick="selectScheduleCell('@cls.Code', @r.MinAge, @r.MaxAge, @effectiveRate.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture), @(isCapped ? "true" : "false"))">
                                            @(explicitRate.HasValue ? explicitRate.Value.ToString("0.0") : "—")
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-teal-100 dark:bg-teal-950/70 text-teal-950 dark:text-teal-200 font-extrabold text-xs">
                            <td colspan="2" class="border border-slate-300 dark:border-stone-700 px-3 py-2 text-right">Estimated Residual Value (%):</td>
                            @foreach (var cls in PropertyAssessmentApp.Services.BuildingDepreciationSchedule.Classifications)
                            {
                                <td class="border border-slate-300 dark:border-stone-700 px-2 py-2 sched-col-residual" data-col-class="@cls.Code">@(cls.ResidualValuePercent)%</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="px-5 py-3 bg-slate-50 dark:bg-stone-950 border-t border-slate-200 dark:border-stone-800 flex flex-wrap items-center justify-between gap-2 text-xs">
                <div class="text-slate-500 dark:text-stone-400">
                    <span class="font-bold text-slate-700 dark:text-stone-200">Note:</span> Cells marked <span class="font-mono font-bold">—</span> indicate that the building has reached its <span class="font-bold text-teal-700 dark:text-teal-400">Estimated Residual Value (%)</span> floor (Max Depreciation = 100% − Residual Value %).
                </div>
                <button type="button" onclick="closeDepreciationScheduleModal()" class="px-4 py-1.5 rounded-xl bg-slate-200 dark:bg-stone-800 hover:bg-slate-300 dark:hover:bg-stone-700 text-slate-800 dark:text-stone-200 font-bold">
                    Close Schedule
                </button>
            </div>
        </div>
    </div>

    <script>
        var BUILDING_DEPR_SCHEDULE = {
            classes: {
                "I":     { struct: "Type I",   life: 15, residual: 10 },
                "II-A":  { struct: "Type II",  life: 20, residual: 15 },
                "II-B":  { struct: "Type II",  life: 18, residual: 12 },
                "III-A": { struct: "Type III", life: 30, residual: 25 },
                "III-B": { struct: "Type III", life: 25, residual: 20 },
                "IV-A":  { struct: "Type IV",  life: 40, residual: 35 },
                "IV-B":  { struct: "Type IV",  life: 38, residual: 33 },
                "V-A":   { struct: "Type V",   life: 50, residual: 40 },
                "V-B":   { struct: "Type V",   life: 45, residual: 37 }
            },
            rows: [
                { cycle: "1st 3 yrs of GR", label: "1",     min: 1,  max: 1,  rates: { "I": 6.7,  "II-A": 5.0,  "II-B": 5.0,  "III-A": 3.3,  "III-B": 4.0,  "IV-A": 2.5,  "IV-B": 2.6,  "V-A": 2.0,  "V-B": 2.2 } },
                { cycle: "1st 3 yrs of GR", label: "2",     min: 2,  max: 2,  rates: { "I": 13.3, "II-A": 10.0, "II-B": 11.1, "III-A": 6.7,  "III-B": 8.0,  "IV-A": 5.0,  "IV-B": 5.3,  "V-A": 4.0,  "V-B": 4.4 } },
                { cycle: "1st 3 yrs of GR", label: "3",     min: 3,  max: 3,  rates: { "I": 20.0, "II-A": 15.0, "II-B": 16.7, "III-A": 10.0, "III-B": 12.0, "IV-A": 7.5,  "IV-B": 7.9,  "V-A": 6.0,  "V-B": 6.7 } },
                { cycle: "2nd 3 yrs of GR", label: "4",     min: 4,  max: 4,  rates: { "I": 26.7, "II-A": 20.0, "II-B": 22.2, "III-A": 13.3, "III-B": 16.0, "IV-A": 10.0, "IV-B": 10.5, "V-A": 8.0,  "V-B": 8.9 } },
                { cycle: "2nd 3 yrs of GR", label: "5",     min: 5,  max: 5,  rates: { "I": 33.3, "II-A": 25.0, "II-B": 27.8, "III-A": 16.7, "III-B": 20.0, "IV-A": 12.5, "IV-B": 13.2, "V-A": 10.0, "V-B": 11.1 } },
                { cycle: "2nd 3 yrs of GR", label: "6",     min: 6,  max: 6,  rates: { "I": 40.0, "II-A": 30.0, "II-B": 33.3, "III-A": 20.0, "III-B": 24.0, "IV-A": 15.0, "IV-B": 15.8, "V-A": 12.0, "V-B": 13.3 } },
                { cycle: "3rd 3 yrs of GR", label: "7",     min: 7,  max: 7,  rates: { "I": 46.7, "II-A": 35.0, "II-B": 38.9, "III-A": 23.3, "III-B": 28.0, "IV-A": 17.5, "IV-B": 18.4, "V-A": 14.0, "V-B": 15.6 } },
                { cycle: "3rd 3 yrs of GR", label: "8",     min: 8,  max: 8,  rates: { "I": 53.3, "II-A": 40.0, "II-B": 44.4, "III-A": 26.7, "III-B": 32.0, "IV-A": 20.0, "IV-B": 21.1, "V-A": 16.0, "V-B": 17.8 } },
                { cycle: "3rd 3 yrs of GR", label: "9",     min: 9,  max: 9,  rates: { "I": 60.0, "II-A": 45.0, "II-B": 50.0, "III-A": 30.0, "III-B": 36.0, "IV-A": 22.5, "IV-B": 23.7, "V-A": 18.0, "V-B": 20.0 } },
                { cycle: "4th 3 yrs of GR", label: "10",    min: 10, max: 10, rates: { "I": 66.7, "II-A": 50.0, "II-B": 55.6, "III-A": 33.3, "III-B": 40.0, "IV-A": 25.0, "IV-B": 26.3, "V-A": 20.0, "V-B": 22.2 } },
                { cycle: "4th 3 yrs of GR", label: "11",    min: 11, max: 11, rates: { "I": 73.3, "II-A": 55.0, "II-B": 61.1, "III-A": 36.7, "III-B": 44.0, "IV-A": 27.5, "IV-B": 28.9, "V-A": 22.0, "V-B": 24.4 } },
                { cycle: "4th 3 yrs of GR", label: "12",    min: 12, max: 12, rates: { "I": 80.0, "II-A": 60.0, "II-B": 66.7, "III-A": 40.0, "III-B": 48.0, "IV-A": 30.0, "IV-B": 31.6, "V-A": 24.0, "V-B": 26.7 } },
                { cycle: "5th 3 yrs of GR", label: "13",    min: 13, max: 13, rates: { "I": 86.7, "II-A": 65.0, "II-B": 72.2, "III-A": 43.3, "III-B": 52.0, "IV-A": 32.5, "IV-B": 34.2, "V-A": 26.0, "V-B": 28.9 } },
                { cycle: "5th 3 yrs of GR", label: "14",    min: 14, max: 14, rates: { "I": 93.3, "II-A": 70.0, "II-B": 77.8, "III-A": 46.7, "III-B": 56.0, "IV-A": 35.0, "IV-B": 36.8, "V-A": 28.0, "V-B": 31.1 } },
                { cycle: "5th 3 yrs of GR", label: "15",    min: 15, max: 15, rates: { "I": null, "II-A": 75.0, "II-B": 83.3, "III-A": 50.0, "III-B": 60.0, "IV-A": 37.5, "IV-B": 39.5, "V-A": 30.0, "V-B": 33.3 } },
                { cycle: "6th 3 yrs of GR", label: "16",    min: 16, max: 16, rates: { "I": null, "II-A": 80.0, "II-B": 88.9, "III-A": 53.3, "III-B": 64.0, "IV-A": 40.0, "IV-B": 42.1, "V-A": 32.0, "V-B": 35.6 } },
                { cycle: "6th 3 yrs of GR", label: "17",    min: 17, max: 17, rates: { "I": null, "II-A": 85.0, "II-B": null, "III-A": 56.7, "III-B": 68.0, "IV-A": 42.5, "IV-B": 44.7, "V-A": 34.0, "V-B": 37.8 } },
                { cycle: "6th 3 yrs of GR", label: "18–20", min: 18, max: 20, rates: { "I": null, "II-A": null, "II-B": null, "III-A": 66.7, "III-B": 80.0, "IV-A": 50.0, "IV-B": 52.6, "V-A": 40.0, "V-B": 44.4 } },
                { cycle: "After 20 yrs GR", label: "21–23", min: 21, max: 23, rates: { "I": null, "II-A": null, "II-B": null, "III-A": 76.7, "III-B": 76.5, "IV-A": 57.5, "IV-B": 60.5, "V-A": 46.0, "V-B": 51.1 } },
                { cycle: "After 20 yrs GR", label: "24–26", min: 24, max: 26, rates: { "I": null, "II-A": null, "II-B": null, "III-A": null, "III-B": 80.0, "IV-A": 65.0, "IV-B": 68.4, "V-A": 52.0, "V-B": 57.8 } },
                { cycle: "After 20 yrs GR", label: "27–30", min: 27, max: 30, rates: { "I": null, "II-A": null, "II-B": null, "III-A": null, "III-B": null, "IV-A": null, "IV-B": null, "V-A": 60.0, "V-B": 64.4 } }
            ]
        };

        function lookupBuildingDepreciationSchedule(classCode, ageYears) {
            var code = (classCode && BUILDING_DEPR_SCHEDULE.classes[classCode]) ? classCode : "III-A";
            var meta = BUILDING_DEPR_SCHEDULE.classes[code];
            var maxDepr = 100 - meta.residual;
            var age = parseInt(ageYears, 10) || 0;
            var classOrder = ["I", "II-A", "II-B", "III-A", "III-B", "IV-A", "IV-B", "V-A", "V-B"];
            var classIndex = Math.max(0, classOrder.indexOf(code));

            if (age <= 0) {
                return {
                    scheduleId: "",
                    classCode: code,
                    cycle: "New / < 1 yr",
                    ageLabel: "0",
                    life: meta.life,
                    residual: meta.residual,
                    maxDepr: maxDepr,
                    rate: 0.0,
                    isResidualCap: false
                };
            }

            for (var i = 0; i < BUILDING_DEPR_SCHEDULE.rows.length; i++) {
                var r = BUILDING_DEPR_SCHEDULE.rows[i];
                if (age >= r.min && age <= r.max) {
                    var scheduleId = (i * classOrder.length) + classIndex + 1;
                    var cellRate = r.rates[code];
                    if (cellRate !== null && cellRate !== undefined) {
                        return {
                            scheduleId: scheduleId,
                            classCode: code,
                            cycle: r.cycle,
                            ageLabel: r.label,
                            life: meta.life,
                            residual: meta.residual,
                            maxDepr: maxDepr,
                            rate: cellRate,
                            isResidualCap: false
                        };
                    } else {
                        return {
                            scheduleId: scheduleId,
                            classCode: code,
                            cycle: r.cycle,
                            ageLabel: r.label,
                            life: meta.life,
                            residual: meta.residual,
                            maxDepr: maxDepr,
                            rate: maxDepr,
                            isResidualCap: true
                        };
                    }
                }
            }

            // Age > 30
            var fallbackScheduleId = ((BUILDING_DEPR_SCHEDULE.rows.length - 1) * classOrder.length) + classIndex + 1;
            return {
                scheduleId: fallbackScheduleId,
                classCode: code,
                cycle: "After 20 yrs GR",
                ageLabel: "> 30",
                life: meta.life,
                residual: meta.residual,
                maxDepr: maxDepr,
                rate: maxDepr,
                isResidualCap: true
            };
        }

        function highlightScheduleTableSelection(classCode, ageYears) {
            var age = parseInt(ageYears, 10) || 0;
            var table = document.getElementById('officialDeprScheduleTable');
            if (!table) return;

            table.querySelectorAll('.sched-col-header').forEach(function (el) {
                if (el.getAttribute('data-col-class') === classCode) {
                    el.classList.add('ring-2', 'ring-amber-300', 'bg-emerald-700');
                } else {
                    el.classList.remove('ring-2', 'ring-amber-300', 'bg-emerald-700');
                }
            });

            table.querySelectorAll('.sched-rate-cell').forEach(function (td) {
                var tdClass = td.getAttribute('data-class');
                var minA = parseInt(td.getAttribute('data-min-age'), 10);
                var maxA = parseInt(td.getAttribute('data-max-age'), 10);
                td.classList.remove('bg-emerald-500', 'text-white', 'font-black', 'ring-2', 'ring-emerald-600', 'bg-emerald-50/70', 'dark:bg-emerald-950/30');

                if (tdClass === classCode && age >= minA && age <= maxA) {
                    td.classList.add('bg-emerald-500', 'text-white', 'font-black', 'ring-2', 'ring-emerald-600');
                } else if (tdClass === classCode || (age >= minA && age <= maxA)) {
                    td.classList.add('bg-emerald-50/70', 'dark:bg-emerald-950/30');
                }
            });
        }

        function applyDepreciationFromSchedule(forceApplyRate) {
            var clsEl = document.getElementById('buildingClassificationSelect');
            var ageEl = document.getElementById('buildingAgeYearsInput');
            var deprEl = document.getElementById('buildingDeprPercentInput');
            var autoEl = document.getElementById('autoApplyScheduleDeprSwitch');
            if (!clsEl || !ageEl || !deprEl) return;

            var classCode = clsEl.value || 'III-A';
            var ageYears = parseInt(ageEl.value, 10) || 0;
            var res = lookupBuildingDepreciationSchedule(classCode, ageYears);

            var grEl = document.getElementById('schedGrCycleDisplay');
            var caEl = document.getElementById('schedClassAgeDisplay');
            var lifeEl = document.getElementById('schedEconLifeDisplay');
            var resEl = document.getElementById('schedResidualDisplay');
            var capBadge = document.getElementById('schedResidualCapBadge');

            if (grEl) grEl.textContent = res.cycle;
            if (caEl) caEl.textContent = 'Class ' + res.classCode + ' • ' + ageYears + 'y (Row ' + res.ageLabel + ')';
            if (lifeEl) lifeEl.textContent = res.life + ' Years';
            if (resEl) resEl.textContent = res.residual + '% (Max Depr: ' + res.maxDepr + '%)';

            var schedIdInput = document.getElementById('buildingDeprScheduleIdInput');
            var grCycleInput = document.getElementById('generalRevisionCycleInput');
            var econLifeInput = document.getElementById('estimatedEconLifeYearsInput');
            var residualInput = document.getElementById('estimatedResidualValuePercentInput');
            if (schedIdInput) schedIdInput.value = res.scheduleId || '';
            if (grCycleInput) grCycleInput.value = res.cycle;
            if (econLifeInput) econLifeInput.value = res.life;
            if (residualInput) residualInput.value = res.residual;
            if (capBadge) {
                if (res.isResidualCap) {
                    capBadge.classList.remove('hidden');
                } else {
                    capBadge.classList.add('hidden');
                }
            }

            highlightScheduleTableSelection(classCode, ageYears);

            var shouldUpdateInput = forceApplyRate || (autoEl && autoEl.checked);
            if (shouldUpdateInput) {
                deprEl.value = res.rate.toFixed(1);
                if (typeof recalculateBuildingValuation === 'function') {
                    recalculateBuildingValuation();
                }
            }
        }

        function openDepreciationScheduleModal() {
            var modal = document.getElementById('depreciationScheduleModal');
            if (modal) {
                modal.classList.remove('hidden');
                var clsEl = document.getElementById('buildingClassificationSelect');
                var ageEl = document.getElementById('buildingAgeYearsInput');
                highlightScheduleTableSelection(clsEl ? clsEl.value : 'III-A', ageEl ? ageEl.value : 0);
            }
        }

        function closeDepreciationScheduleModal() {
            var modal = document.getElementById('depreciationScheduleModal');
            if (modal) modal.classList.add('hidden');
        }

        function selectScheduleCell(classCode, minAge, maxAge, rateVal, isCapped) {
            var clsEl = document.getElementById('buildingClassificationSelect');
            var structEl = document.getElementById('structuralTypeSelect');
            var ageEl = document.getElementById('buildingAgeYearsInput');
            var deprEl = document.getElementById('buildingDeprPercentInput');

            if (clsEl) clsEl.value = classCode;
            if (structEl && BUILDING_DEPR_SCHEDULE.classes[classCode]) {
                structEl.value = BUILDING_DEPR_SCHEDULE.classes[classCode].struct;
            }
            if (ageEl) {
                var curAge = parseInt(ageEl.value, 10) || 0;
                if (curAge < minAge || curAge > maxAge) {
                    ageEl.value = minAge;
                }
            }
            if (deprEl) {
                deprEl.value = parseFloat(rateVal).toFixed(1);
            }

            applyDepreciationFromSchedule(false);
            if (typeof recalculateBuildingValuation === 'function') {
                recalculateBuildingValuation();
            }
            closeDepreciationScheduleModal();

            if (window.toastr) {
                var msg = isCapped
                    ? 'Applied Class ' + classCode + ' Residual Floor Cap (' + rateVal.toFixed(1) + '% Max Depreciation).'
                    : 'Applied Class ' + classCode + ' (Age ' + (ageEl ? ageEl.value : minAge) + 'y) -> ' + rateVal.toFixed(1) + '% Depreciation.';
                toastr.success(msg, 'Schedule Rate Applied');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var structEl = document.getElementById('structuralTypeSelect');
            var clsEl = document.getElementById('buildingClassificationSelect');
            var ageEl = document.getElementById('buildingAgeYearsInput');
            var dateConstEl = document.getElementById('dateConstructedInput');
            var dateCompEl = document.getElementById('dateCompletedInput');
            var dateOccEl = document.getElementById('dateOccupiedInput');

            if (structEl && clsEl) {
                structEl.addEventListener('change', function () {
                    var st = structEl.value;
                    var defaultMap = {
                        "Type I": "I",
                        "Type II": "II-A",
                        "Type III": "III-A",
                        "Type IV": "IV-A",
                        "Type V": "V-A"
                    };
                    var currentClass = clsEl.value;
                    var currentMeta = BUILDING_DEPR_SCHEDULE.classes[currentClass];
                    if (!currentMeta || currentMeta.struct !== st) {
                        if (defaultMap[st]) {
                            clsEl.value = defaultMap[st];
                        }
                    }
                    applyDepreciationFromSchedule(false);
                });

                clsEl.addEventListener('change', function () {
                    var selectedCode = clsEl.value;
                    var meta = BUILDING_DEPR_SCHEDULE.classes[selectedCode];
                    if (meta && structEl.value !== meta.struct) {
                        structEl.value = meta.struct;
                    }
                    applyDepreciationFromSchedule(false);
                });
            }

            if (ageEl) {
                ageEl.addEventListener('input', function () {
                    applyDepreciationFromSchedule(false);
                });
                ageEl.addEventListener('change', function () {
                    applyDepreciationFromSchedule(false);
                });
            }

            function syncAgeFromDates() {
                var refDateStr = (dateCompEl && dateCompEl.value) || (dateOccEl && dateOccEl.value) || (dateConstEl && dateConstEl.value);
                if (!refDateStr || !ageEl) return;
                var builtYear = new Date(refDateStr).getFullYear();
                if (isNaN(builtYear) || builtYear < 1900) return;
                var effYearInput = document.querySelector('input[name="EffectivityYear"]');
                var effYear = effYearInput ? (parseInt(effYearInput.value, 10) || new Date().getFullYear()) : new Date().getFullYear();
                var computedAge = Math.max(0, effYear - builtYear);
                ageEl.value = computedAge;
                applyDepreciationFromSchedule(false);
            }

            if (dateConstEl) dateConstEl.addEventListener('change', syncAgeFromDates);
            if (dateCompEl) dateCompEl.addEventListener('change', syncAgeFromDates);
            if (dateOccEl) dateOccEl.addEventListener('change', syncAgeFromDates);

            // Initial sync on page load (do not overwrite existing non-zero saved rate on Edit unless age > 0 and rate is 0)
            var deprEl = document.getElementById('buildingDeprPercentInput');
            var hasExistingRate = deprEl && parseFloat(deprEl.value) > 0;
            applyDepreciationFromSchedule(!hasExistingRate);
        });
    </script>
</div>
