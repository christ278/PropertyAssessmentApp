@model PropertyAssessmentApp.Models.TaxDeclaration

<!-- BUILDING SPECIFIC FORM (SHARED BETWEEN CREATE AND EDIT) -->
<div id="buildingform" class="space-y-6 hidden">
    <!-- Hidden Storage for Dynamic Tables -->
    <input type="hidden" asp-for="BuildingFloorBreakdownJson" id="buildingFloorBreakdownJson" />
    <input type="hidden" asp-for="BaseRcnValue" id="baseRcnValue" />
    <input type="hidden" asp-for="BuildingAdditionalItemsJson" id="buildingAdditionalItemsJson" />
    <input type="hidden" asp-for="BuildingTotalAdditionsValue" id="buildingTotalAdditionsValue" />
    <input type="hidden" asp-for="BuildingDepreciationAccumulated" id="buildingDepreciationAccumulated" />
    <input type="hidden" asp-for="BuildingDepreciatedMarketValue" id="buildingDepreciatedMarketValue" />

    <!-- 1. CCT (CONDOMINIUM CERTIFICATE OF TITLE) & ADMINISTRATOR (CAST) -->
    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-3">
            <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                <i data-lucide="file-badge" class="w-4 h-4"></i>
                Condominium Title (CCT) & Administration
            </h4>
            <div class="flex items-center gap-6">
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300">
                    <input type="checkbox" asp-for="IsCct" id="isCctSwitch" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                    <span>CONDOMINIUM UNIT (CCT)</span>
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300">
                    <input type="checkbox" asp-for="IsAdministrator" id="isAdminSwitch" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                    <span>HAS ADMINISTRATOR</span>
                </label>
            </div>
        </div>

        <!-- CCT Details Panel -->
        <div id="cctDetailsRow" class="grid grid-cols-1 md:grid-cols-3 gap-4 hidden bg-white dark:bg-stone-900 p-4 rounded-xl border border-emerald-100 dark:border-emerald-900/40">
            <div>
                <label asp-for="CctTitleNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">CCT TITLE NO.</label>
                <input asp-for="CctTitleNo" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="e.g. CCT-12345" />
            </div>
            <div>
                <label asp-for="CctDateRegistered" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">DATE REGISTERED</label>
                <input asp-for="CctDateRegistered" type="date" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
            </div>
            <div>
                <label asp-for="OwnerNameReflectedInCct" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">OWNER REFLECTED IN CCT</label>
                <input asp-for="OwnerNameReflectedInCct" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Name as shown on CCT" />
            </div>
        </div>

        <!-- Administrator Details Panel -->
        <div id="adminDetailsRow" class="grid grid-cols-1 md:grid-cols-4 gap-4 hidden bg-white dark:bg-stone-900 p-4 rounded-xl border border-sky-100 dark:border-sky-900/40">
            <div>
                <label asp-for="AdministratorName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">ADMINISTRATOR NAME</label>
                <input asp-for="AdministratorName" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Full name of administrator" />
            </div>
            <div>
                <label asp-for="AdministratorTin" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">ADMINISTRATOR TIN</label>
                <input asp-for="AdministratorTin" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="000-000-000-000" />
            </div>
            <div>
                <label asp-for="AdministratorContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">CONTACT NO.</label>
                <input asp-for="AdministratorContactNo" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="09XXXXXXXXX" />
            </div>
            <div>
                <label asp-for="AdministratorAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">MAILING ADDRESS</label>
                <input asp-for="AdministratorAddress" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Complete address" />
            </div>
        </div>
    </div>

    <!-- 2. BUILDING USE, STRUCTURAL TYPE & CONSTRUCTION TIMELINE -->
    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-3">
            <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                <i data-lucide="building" class="w-4 h-4"></i>
                Building Classification & Construction Timeline
            </h4>
            <button type="button" onclick="openDepreciationScheduleModal()" class="px-3 py-1.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs inline-flex items-center gap-1.5 shadow-sm transition-all">
                <i data-lucide="table-2" class="w-3.5 h-3.5"></i> View Depreciation Schedule (I – V-B)
            </button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label asp-for="BuildingUseType" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BUILDING USE TYPE</label>
                <select asp-for="BuildingUseType" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold">
                    <option value="Residential Condominium">Residential Condominium</option>
                    <option value="Townhouse">Townhouse</option>
                    <option value="Commercial Condominium">Commercial Condominium</option>
                    <option value="Single Detached House">Single Detached House</option>
                    <option value="Two Family Dwelling">Two Family Dwelling</option>
                    <option value="Apartment / Rowhouse">Apartment / Rowhouse</option>
                    <option value="Boarding / Lodging House">Boarding / Lodging House</option>
                    <option value="Warehouse / Factory">Warehouse / Factory</option>
                    <option value="Commercial Mall / Store">Commercial Mall / Store</option>
                    <option value="Office / Bank Building">Office / Bank Building</option>
                    <option value="School / Institutional">School / Institutional</option>
                    <option value="Hospital / Clinic">Hospital / Clinic</option>
                </select>
            </div>
            <div>
                <label asp-for="StructuralType" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">STRUCTURAL TYPE (BUCC GROUP)</label>
                <select asp-for="StructuralType" id="structuralTypeSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold">
                    <option value="Type I">Type I (Class I — Light / Wood Construction)</option>
                    <option value="Type II">Type II (Class II-A / II-B — Mixed Wood & Concrete)</option>
                    <option value="Type III">Type III (Class III-A / III-B — Masonry & RC Frame)</option>
                    <option value="Type IV">Type IV (Class IV-A / IV-B — Steel & RC Structure)</option>
                    <option value="Type V">Type V (Class V-A / V-B — Fire-Resistive RC / Steel)</option>
                </select>
            </div>
            <div>
                <label asp-for="BuildingClassification" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BUILDING CLASSIFICATION (DEPR. SCHEDULE)</label>
                @{
                    var normalizedBldgClass = PropertyAssessmentApp.Services.BuildingDepreciationSchedule.NormalizeClassificationCode(Model.BuildingClassification, Model.StructuralType);
                }
                <select asp-for="BuildingClassification" id="buildingClassificationSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-emerald-300 dark:border-emerald-700 text-slate-900 dark:text-white font-mono font-bold">
                    @foreach (var cls in PropertyAssessmentApp.Services.BuildingDepreciationSchedule.Classifications)
                    {
                        if (string.Equals(Model.BuildingClassification, cls.Code, StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(normalizedBldgClass, cls.Code, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@cls.Code" selected data-struct="@cls.StructuralGroup" data-life="@cls.EconomicLifeYears" data-residual="@cls.ResidualValuePercent">@cls.Code — Econ. Life: @(cls.EconomicLifeYears)y | Residual: @(cls.ResidualValuePercent)%</option>
                        }
                        else
                        {
                            <option value="@cls.Code" data-struct="@cls.StructuralGroup" data-life="@cls.EconomicLifeYears" data-residual="@cls.ResidualValuePercent">@cls.Code — Econ. Life: @(cls.EconomicLifeYears)y | Residual: @(cls.ResidualValuePercent)%</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label asp-for="BuildingPermitNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BUILDING PERMIT NO.</label>
                <input asp-for="BuildingPermitNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="Permit No." />
            </div>
            <div>
                <label asp-for="OccupancyPermitNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">OCCUPANCY PERMIT NO.</label>
                <input asp-for="OccupancyPermitNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="Occupancy No." />
            </div>
            <div>
                <label asp-for="BuildingAgeYears" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BUILDING AGE (YEARS)</label>
                <input asp-for="BuildingAgeYears" id="buildingAgeYearsInput" type="number" min="0" max="100" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-emerald-300 dark:border-emerald-700 text-slate-900 dark:text-white font-mono text-right font-bold" />
            </div>
            <div>
                <label asp-for="DateConstructed" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">DATE CONSTRUCTED / STARTED</label>
                <input asp-for="DateConstructed" id="dateConstructedInput" type="date" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
            </div>
            <div>
                <label asp-for="DateCompleted" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">DATE COMPLETED</label>
                <input asp-for="DateCompleted" id="dateCompletedInput" type="date" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
            </div>
            <div>
                <label asp-for="DateOccupied" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">DATE OCCUPIED</label>
                <input asp-for="DateOccupied" id="dateOccupiedInput" type="date" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
            </div>
        </div>
    </div>

    <!-- 3. FLOOR-BY-FLOOR BREAKDOWN TABLE (CAST REFERENCE) -->
    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-3">
            <div>
                <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                    <i data-lucide="layers" class="w-4 h-4"></i>
                    Floor Levels & Base Construction Cost (BUCC) Breakdown
                </h4>
                <p class="text-[11px] text-slate-500 dark:text-stone-400">Add individual floor levels to automatically compute Total Floor Area (TFA) and Base Replacement Cost New (RCN).</p>
            </div>
            <button type="button" onclick="openAddFloorModal()" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs inline-flex items-center gap-1.5 shadow-sm transition-all">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Floor Level
            </button>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-stone-800 bg-white dark:bg-stone-900">
            <table class="w-full text-xs text-left" id="tableBuildingFloors">
                <thead class="bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200 dark:border-stone-700">
                    <tr>
                        <th class="p-3">Storey / Level</th>
                        <th class="p-3">Description</th>
                        <th class="p-3 text-right">Floor Area (sq.m.)</th>
                        <th class="p-3 text-right">BUCC Rate (PHP/sq.m.)</th>
                        <th class="p-3 text-right">Market Value (PHP)</th>
                        <th class="p-3 text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="tableBuildingFloorsBody" class="divide-y divide-slate-100 dark:divide-stone-800 font-medium">
                    <!-- Dynamic rows loaded via JS -->
                </tbody>
                <tfoot class="bg-slate-50 dark:bg-stone-950 font-bold text-slate-800 dark:text-stone-200 border-t border-slate-200 dark:border-stone-800">
                    <tr>
                        <td colspan="2" class="p-3 text-right">TOTAL FLOOR AREA (TFA):</td>
                        <td class="p-3 text-right font-mono text-emerald-600 dark:text-emerald-400" id="displayTotalBldgArea">0.00 sq.m.</td>
                        <td class="p-3 text-right">BASE RCN:</td>
                        <td class="p-3 text-right font-mono text-emerald-600 dark:text-emerald-400" id="displayTotalBaseRcn">₱0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Fallback / Overall inputs -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div>
                <label asp-for="NoOfStoreys" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">TOTAL STOREY COUNT</label>
                <input asp-for="NoOfStoreys" id="noOfStoreysInput" type="number" min="1" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
            </div>
            <div>
                <label asp-for="TotalBuildingAreaSqm" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">TOTAL BUILDING AREA (SQ.M.)</label>
                <input asp-for="TotalBuildingAreaSqm" id="totalBuildingAreaInput" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-right font-bold" />
            </div>
        </div>
    </div>

    <!-- 4. ADDITIONAL ITEMS & IMPROVEMENTS (CAST REFERENCE) -->
    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-3">
            <div>
                <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    Additional Items & Custom Improvements
                </h4>
                <p class="text-[11px] text-slate-500 dark:text-stone-400">Carports, Porches, Balconies, Garages, Terraces, Pavements, and Premium Finishes.</p>
            </div>
            <button type="button" onclick="openAddAdditionModal()" class="px-3 py-1.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs inline-flex items-center gap-1.5 shadow-sm transition-all">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Improvement Item
            </button>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-stone-800 bg-white dark:bg-stone-900">
            <table class="w-full text-xs text-left" id="tableBuildingAdditions">
                <thead class="bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200 dark:border-stone-700">
                    <tr>
                        <th class="p-3">Improvement Description</th>
                        <th class="p-3 text-right">Qty / Area</th>
                        <th class="p-3 text-right">Unit Rate / Cost</th>
                        <th class="p-3 text-right">Multiplier / Adj (%)</th>
                        <th class="p-3 text-right">Subtotal Value (PHP)</th>
                        <th class="p-3 text-center">Action</th>
                    </tr>
                </thead>
                <tbody id="tableBuildingAdditionsBody" class="divide-y divide-slate-100 dark:divide-stone-800 font-medium">
                    <!-- Dynamic rows loaded via JS -->
                </tbody>
                <tfoot class="bg-slate-50 dark:bg-stone-950 font-bold text-slate-800 dark:text-stone-200 border-t border-slate-200 dark:border-stone-800">
                    <tr>
                        <td colspan="4" class="p-3 text-right">TOTAL ADDITIONAL IMPROVEMENTS:</td>
                        <td class="p-3 text-right font-mono text-sky-600 dark:text-sky-400" id="displayTotalAdditions">₱0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- 5. DEPRECIATION SCHEDULE & VALUATION SUMMARY (CAST REFERENCE) -->
    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-3">
            <div>
                <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                    <i data-lucide="trending-down" class="w-4 h-4"></i>
                    Building Depreciation & Live Valuation Matrix
                </h4>
                <p class="text-[11px] text-slate-500 dark:text-stone-400">Automatically looks up physical depreciation from the official BLGF Building Classification Schedule (I to V-B).</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <label class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-[11px] font-bold text-slate-700 dark:text-stone-300 cursor-pointer">
                    <input type="checkbox" id="autoApplyScheduleDeprSwitch" checked class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 w-3.5 h-3.5" />
                    <span>Auto-Apply Schedule</span>
                </label>
                <button type="button" onclick="applyDepreciationFromSchedule(true)" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs inline-flex items-center gap-1.5 shadow-sm transition-all">
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Sync Schedule Rate
                </button>
                <button type="button" onclick="openDepreciationScheduleModal()" class="px-3 py-1.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs inline-flex items-center gap-1.5 shadow-sm transition-all">
                    <i data-lucide="table-2" class="w-3.5 h-3.5"></i> Open Schedule Table
                </button>
            </div>
        </div>

        <!-- Schedule of Building Depreciation Live Metadata Strip -->
        <input type="hidden" asp-for="BuildingDepreciationScheduleId" id="buildingDeprScheduleIdInput" />
        <input type="hidden" asp-for="GeneralRevisionCycle" id="generalRevisionCycleInput" />
        <input type="hidden" asp-for="EstimatedEconomicLifeYears" id="estimatedEconLifeYearsInput" />
        <input type="hidden" asp-for="EstimatedResidualValuePercent" id="estimatedResidualValuePercentInput" />
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 p-3.5 rounded-xl bg-teal-50/70 dark:bg-teal-950/30 border border-teal-200 dark:border-teal-800/60">
            <div>
                <span class="text-[10px] font-bold uppercase text-teal-800 dark:text-teal-300 block mb-0.5">General Revision Cycle</span>
                <span class="text-xs font-black font-mono text-slate-900 dark:text-white" id="schedGrCycleDisplay">--</span>
            </div>
            <div>
                <span class="text-[10px] font-bold uppercase text-teal-800 dark:text-teal-300 block mb-0.5">Class &amp; Age Bracket</span>
                <span class="text-xs font-black font-mono text-emerald-700 dark:text-emerald-400" id="schedClassAgeDisplay">Class III-A • 0y</span>
            </div>
            <div>
                <span class="text-[10px] font-bold uppercase text-teal-800 dark:text-teal-300 block mb-0.5">Est. Economic Life</span>
                <span class="text-xs font-black font-mono text-slate-900 dark:text-white" id="schedEconLifeDisplay">30y</span>
            </div>
            <div>
                <span class="text-[10px] font-bold uppercase text-teal-800 dark:text-teal-300 block mb-0.5">Est. Residual Value (%)</span>
                <div class="flex items-center gap-1.5">
                    <span class="text-xs font-black font-mono text-amber-700 dark:text-amber-400" id="schedResidualDisplay">25% (Max Depr: 75%)</span>
                    <span id="schedResidualCapBadge" class="hidden px-1.5 py-0.5 rounded bg-amber-200 dark:bg-amber-900/60 text-amber-900 dark:text-amber-200 text-[9px] font-bold uppercase">Residual Floor</span>
                </div>
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
            <div class="p-3 bg-white dark:bg-stone-900 rounded-xl border border-slate-200 dark:border-stone-800">
                <span class="text-[10px] font-bold uppercase text-slate-400 block mb-1">Base RCN</span>
                <span class="text-sm font-black font-mono text-slate-900 dark:text-white" id="kpiBaseRcn">₱0.00</span>
            </div>
            <div class="p-3 bg-white dark:bg-stone-900 rounded-xl border border-slate-200 dark:border-stone-800">
                <span class="text-[10px] font-bold uppercase text-slate-400 block mb-1">Total Depreciation</span>
                <span class="text-sm font-black font-mono text-rose-600 dark:text-rose-400" id="kpiDepreciation">₱0.00</span>
            </div>
            <div class="p-3 bg-white dark:bg-stone-900 rounded-xl border border-slate-200 dark:border-stone-800">
                <span class="text-[10px] font-bold uppercase text-slate-400 block mb-1">Depreciated Core</span>
                <span class="text-sm font-black font-mono text-emerald-600 dark:text-emerald-400" id="kpiDepreciatedCore">₱0.00</span>
            </div>
