                    <div><span class="text-[10px] text-slate-400 block">STOREYS / FLOOR AREA</span><strong class="text-slate-900 dark:text-white">@Model.NoOfStoreys storey(s) / @Model.TotalBuildingAreaSqm.ToString("N2") sqm</strong></div>
