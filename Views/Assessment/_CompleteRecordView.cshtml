                                </thead>
                                <tbody class="divide-y divide-slate-200 dark:divide-stone-800">
                                    @foreach (var ai in bldg.AdditionalItems)
                                    {
                                        <tr>
                                            <td class="px-3 py-2 font-bold">@Dash(ai.ItemDescription)</td>
                                            <td class="px-3 py-2 text-right">@ai.Quantity.ToString("N2")</td>
                                            <td class="px-3 py-2 text-right">@Money(ai.UnitRate)</td>
                                            <td class="px-3 py-2 text-right font-bold text-emerald-700 dark:text-emerald-400">@Money(ai.TotalValue)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else { <p class="text-slate-400 italic">No additional items recorded.</p> }
                </div>

                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div><span class="text-[10px] text-slate-400 block">BASE RCN</span><strong class="text-slate-900 dark:text-white">@Money(Model.BaseRcnValue)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">TOTAL ADDITIONS</span><strong class="text-slate-900 dark:text-white">@Money(Model.BuildingTotalAdditionsValue)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">TOTAL RCN</span><strong class="text-slate-900 dark:text-white">@Money(totalRcn)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">DEPRECIATION (%)</span><strong class="text-rose-600 dark:text-rose-400">@Model.BuildingDepreciationPercent.ToString("0.##")% (@Money(Model.BuildingDepreciationAccumulated))</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">DEPRECIATED MARKET VALUE</span><strong class="text-slate-900 dark:text-white">@Money(Model.BuildingDepreciatedMarketValue > 0 ? Model.BuildingDepreciatedMarketValue : Model.MarketValue)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">ASSESSMENT LEVEL (%)</span><strong class="text-slate-900 dark:text-white">@Model.AssessmentLevelPercent.ToString("0.##")%</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">ASSESSED VALUE</span><strong class="text-emerald-700 dark:text-emerald-400">@Money(Model.AssessedValue)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">ANNUAL TAX DUE</span><strong class="text-amber-700 dark:text-amber-400">@Money(Model.AnnualTaxDue)</strong></div>
                </div>
            </div>

            <!-- BUILDING TAB 4: Effectivity, Notes & Photos -->
            <div id="view-tab-4" class="view-tab-content space-y-6 hidden">
                @await Html.PartialAsync("_ViewEffectivitySignatoriesPhotos", Model)
            </div>
        }
        else if (Model.Kind == PropertyKind.Machinery)
        {
            var machRows = ParseArray(Model.MachineryAppraisalDetailsJson);
            var machRollRows = ParseArray(Model.MachineryPropertyAssessmentsJson);

            <!-- Machinery Tab Bar (Matches Create/Edit Machinery Form) -->
            <div class="flex items-center gap-2 overflow-x-auto border-b border-slate-200 dark:border-stone-800 pb-3 no-print">
                <button type="button" onclick="switchViewTab('view-tab-1')" id="btn-view-tab-1" class="view-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-emerald-600 text-white shadow-sm flex items-center gap-2 shrink-0 cursor-pointer">
                    <i data-lucide="cpu" class="w-3.5 h-3.5"></i> 1. Property Information, Owner &amp; Location
                </button>
                <button type="button" onclick="switchViewTab('view-tab-2')" id="btn-view-tab-2" class="view-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-700 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0 cursor-pointer">
                    <i data-lucide="calculator" class="w-3.5 h-3.5"></i> 2. Property Appraisal &amp; Assessment Roll
                </button>
                <button type="button" onclick="switchViewTab('view-tab-3')" id="btn-view-tab-3" class="view-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-700 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0 cursor-pointer">
                    <i data-lucide="file-check" class="w-3.5 h-3.5"></i> 3. Memoranda, Effectivity &amp; Photos
                </button>
            </div>

            <!-- MACHINERY TAB 1: Property Info, Owner & Location -->
            <div id="view-tab-1" class="view-tab-content space-y-5">
                <h2 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="cpu" class="w-4 h-4"></i> Machinery Registration, Owner, Location &amp; References
                </h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div><span class="text-[10px] text-slate-400 block">TDN NO.</span><strong class="text-slate-900 dark:text-white">@Dash(Model.TaxDeclarationNumber)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">ARP NO.</span><strong class="text-slate-900 dark:text-white">@Dash(Model.ARPNo)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">PROPERTY INDEX NO. (PIN)</span><strong class="text-slate-900 dark:text-white">@Dash(Model.PropertyIndexNumber)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">TRANSACTION CODE</span><strong class="text-slate-900 dark:text-white">@Dash(Model.TransactionCode)</strong></div>
                    <div class="col-span-2"><span class="text-[10px] text-slate-400 block">REGISTERED OWNER (@roleBadge.ToUpper())</span><strong class="text-slate-900 dark:text-white">@Dash(Model.OwnerName)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">OWNER TIN</span><strong class="text-slate-900 dark:text-white">@Dash(Model.OwnerTin)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">CONTACT / EMAIL</span><strong class="text-slate-900 dark:text-white">@Dash(Model.OwnerPhone) / @Dash(Model.OwnerEmail)</strong></div>
                    <div class="col-span-2"><span class="text-[10px] text-slate-400 block">OWNER ADDRESS</span><strong class="text-slate-900 dark:text-white">@Dash(Model.OwnerAddress)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">BARANGAY / STREET</span><strong class="text-slate-900 dark:text-white">@Dash(Model.DistrictOrBarangay) / @Dash(Model.StreetNo)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">CITY / PROVINCE</span><strong class="text-slate-900 dark:text-white">@Dash(Model.Municipality), @Dash(Model.ProvinceCity)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">MANUFACTURING ORIGIN</span><strong class="text-slate-900 dark:text-white">@(Model.IsLocallyManufactured ? "Local Manufacturer" : "Imported")</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">REG. NO. / DATE</span><strong class="text-slate-900 dark:text-white">@Dash(Model.MachineryRegNo) / @DateFmt(Model.MachineryDateRegistered ?? Model.DateRegistered)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">IMPORT PERMIT / DATE</span><strong class="text-slate-900 dark:text-white">@Dash(Model.ImportationPermitNo) / @DateFmt(Model.ImportationDateIssued)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">COUNTRY OF ORIGIN</span><strong class="text-slate-900 dark:text-white">@Dash(Model.CountryOfOrigin)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">OR NO. / OR DATE</span><strong class="text-slate-900 dark:text-white">@Dash(Model.OrNo) / @DateFmt(Model.OrDate)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">ACQUISITION COST</span><strong class="text-slate-900 dark:text-white">@Money(Model.AcquisitionCost)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">SUPPLIER / SELLER</span><strong class="text-slate-900 dark:text-white">@Dash(Model.SupplierSeller)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">SUPPLIER ADDRESS</span><strong class="text-slate-900 dark:text-white">@Dash(Model.SupplierAddress)</strong></div>
                    <div class="col-span-2"><span class="text-[10px] text-slate-400 block">LAND OWNER / TD NO. / PIN</span><strong class="text-slate-900 dark:text-white">@Dash(Model.LandOwnerName) (@Dash(Model.LandTdNo) / @Dash(Model.LandPin))</strong></div>
                    <div class="col-span-2"><span class="text-[10px] text-slate-400 block">BUILDING OWNER / TD NO. / PIN</span><strong class="text-slate-900 dark:text-white">@Dash(Model.BuildingReferenceName) (@Dash(Model.BuildingTdNo) / @Dash(Model.BuildingPin))</strong></div>
                </div>
            </div>

            <!-- MACHINERY TAB 2: Property Appraisal & Assessment Roll -->
            <div id="view-tab-2" class="view-tab-content space-y-5 hidden">
                <h2 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="calculator" class="w-4 h-4"></i> Machinery Appraisal &amp; Assessment Roll
                </h2>
                @if (machRows.HasValue && machRows.Value.GetArrayLength() > 0)
                {
                    <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-stone-800">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 dark:bg-stone-950 border-b border-slate-200 dark:border-stone-800 text-[10px] uppercase text-slate-500">
                                    <th class="px-3 py-2">Kind / Description &amp; Brand</th>
                                    <th class="px-3 py-2">Condition / Capacity</th>
                                    <th class="px-3 py-2 text-right">Original Cost</th>
                                    <th class="px-3 py-2 text-right">Dep. (%)</th>
                                    <th class="px-3 py-2 text-right">Depreciated Value</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 dark:divide-stone-800">
                                @foreach (var row in machRows.Value.EnumerateArray())
                                {
                                    <tr>
                                        <td class="px-3 py-2 font-bold">@Dash(PropStr(row, "KindOfMachinery", "kindOfMachinery", "kindMachinery", "KindMachinery", "BrandModel", "brandModel", "descriptionBrand", "DescriptionBrand"))</td>
                                        <td class="px-3 py-2">@Dash(PropStr(row, "ConditionWhenAcquired", "conditionWhenAcquired", "condition", "Condition", "RatedCapacity", "ratedCapacity", "capacity", "Capacity"))</td>
                                        <td class="px-3 py-2 text-right">@Money(PropDec(row, "originalCost", "OriginalCost", "totalCost", "TotalCost"))</td>
                                        <td class="px-3 py-2 text-right">@PropDec(row, "DepreciationTotalPercentage", "depreciationTotalPercentage", "depPercentage", "DepPercentage", "depreciationRatePercent").ToString("0.##")%</td>
                                        <td class="px-3 py-2 text-right font-bold text-emerald-700 dark:text-emerald-400">@Money(PropDec(row, "depreciatedValue", "DepreciatedValue", "marketValue", "MarketValue"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (machRollRows.HasValue && machRollRows.Value.GetArrayLength() > 0)
                {
                    <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-stone-800">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 dark:bg-stone-950 border-b border-slate-200 dark:border-stone-800 text-[10px] uppercase text-slate-500">
                                    <th class="px-3 py-2">Actual Use</th>
                                    <th class="px-3 py-2 text-right">Market Value</th>
                                    <th class="px-3 py-2 text-right">Assessment Level</th>
                                    <th class="px-3 py-2 text-right">Assessed Value</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 dark:divide-stone-800">
                                @foreach (var row in machRollRows.Value.EnumerateArray())
                                {
                                    <tr>
                                        <td class="px-3 py-2 font-bold">@Dash(PropStr(row, "ActualUseName", "actualUseName", "actualUse", "ActualUse"))</td>
                                        <td class="px-3 py-2 text-right">@Money(PropDec(row, "MarketValue", "marketValue"))</td>
                                        <td class="px-3 py-2 text-right">@PropDec(row, "AssessmentLevelPercent", "assessmentLevelPercent", "assessmentLevel", "AssessmentLevel").ToString("0.##")%</td>
                                        <td class="px-3 py-2 text-right font-bold text-emerald-700 dark:text-emerald-400">@Money(PropDec(row, "AssessmentValue", "assessmentValue", "assessedValue", "AssessedValue"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div><span class="text-[10px] text-slate-400 block">MARKET VALUE</span><strong class="text-slate-900 dark:text-white">@Money(Model.MarketValue)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">ASSESSMENT LEVEL (%)</span><strong class="text-slate-900 dark:text-white">@Model.AssessmentLevelPercent.ToString("0.##")%</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">ASSESSED VALUE</span><strong class="text-emerald-700 dark:text-emerald-400">@Money(Model.AssessedValue)</strong></div>
                    <div><span class="text-[10px] text-slate-400 block">ANNUAL TAX DUE</span><strong class="text-amber-700 dark:text-amber-400">@Money(Model.AnnualTaxDue)</strong></div>
                </div>
            </div>

            <!-- MACHINERY TAB 3: Memoranda, Effectivity & Photos -->
            <div id="view-tab-3" class="view-tab-content space-y-6 hidden">
                @await Html.PartialAsync("_ViewEffectivitySignatoriesPhotos", Model)
            </div>
        }
    </div>

    <!-- TAB 2: EMBEDDED QUESTPDF DOCUMENT VIEWER -->
    <div id="tabPdfPreview" class="hidden rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm overflow-hidden">
        <div class="px-5 py-3.5 border-b border-slate-200 dark:border-stone-800 flex items-center justify-between bg-slate-50 dark:bg-stone-950 font-mono text-xs">
            <div class="flex items-center gap-2 font-bold text-slate-700 dark:text-stone-200">
                <i data-lucide="file-check-2" class="w-4 h-4 text-emerald-600"></i>
                <span>Official Tax Declaration PDF Preview — @Model.TaxDeclarationNumber</span>
            </div>
            <span class="px-2.5 py-0.5 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-[10px] font-bold">
                Generated via QuestPDF
            </span>
        </div>
        <iframe src="@pdfUrl"
                class="w-full h-[820px] bg-slate-100 dark:bg-stone-950"
                title="Tax Declaration @Model.TaxDeclarationNumber PDF">
        </iframe>
    </div>
</div>

<script>
    function switchDetailsTab(mode) {
        const encoded = document.getElementById('tabEncodedDetails');
        const pdf = document.getElementById('tabPdfPreview');
        const btnEnc = document.getElementById('btnViewEncodedDetails');
        const btnPdf = document.getElementById('btnViewPdfPreview');
        if (!encoded || !pdf || !btnEnc || !btnPdf) return;

        if (mode === 'pdf') {
            encoded.classList.add('hidden');
            pdf.classList.remove('hidden');
            btnPdf.className = 'px-4 py-2.5 rounded-xl bg-emerald-600 text-white font-bold flex items-center gap-2 shadow-sm';
            btnEnc.className = 'px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 font-bold flex items-center gap-2 hover:bg-slate-50 dark:hover:bg-stone-800';
        } else {
            pdf.classList.add('hidden');
            encoded.classList.remove('hidden');
            btnEnc.className = 'px-4 py-2.5 rounded-xl bg-emerald-600 text-white font-bold flex items-center gap-2 shadow-sm';
            btnPdf.className = 'px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 font-bold flex items-center gap-2 hover:bg-slate-50 dark:hover:bg-stone-800';
        }
    }

    function switchViewTab(tabId) {
        document.querySelectorAll('.view-tab-content').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.view-tab-btn').forEach(btn => {
            btn.className = 'view-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-700 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0 cursor-pointer';
        });
        const target = document.getElementById(tabId);
        const btn = document.getElementById('btn-' + tabId);
        if (target) target.classList.remove('hidden');
        if (btn) btn.className = 'view-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-emerald-600 text-white shadow-sm flex items-center gap-2 shrink-0 cursor-pointer';
    }
</script>
