                    <i data-lucide="building-2" class="w-3.5 h-3.5"></i> 1. Property Info, Taxpayer &amp; CCT
                </button>
                <button type="button" onclick="switchViewTab('view-tab-2')" id="btn-view-tab-2" class="view-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-700 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0 cursor-pointer">
                    <i data-lucide="layers" class="w-3.5 h-3.5"></i> 2. Structural &amp; 17 Materials
                </button>
                <button type="button" onclick="switchViewTab('view-tab-3')" id="btn-view-tab-3" class="view-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-700 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0 cursor-pointer">
                    <i data-lucide="calculator" class="w-3.5 h-3.5"></i> 3. Floors, Additions &amp; Valuation
                </button>
                <button type="button" onclick="switchViewTab('view-tab-4')" id="btn-view-tab-4" class="view-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-700 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0 cursor-pointer">
                    <i data-lucide="file-check" class="w-3.5 h-3.5"></i> 4. Effectivity, Notes &amp; Photos
                </button>
