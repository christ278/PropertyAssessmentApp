@model PropertyAssessmentApp.Models.AssessmentCalculatorViewModel
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = "Valuation Simulator";
}

<div class="space-y-8">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-amber-700 font-bold mb-1">
                <i data-lucide="calculator" class="w-4 h-4"></i>
                <span>Interactive Assessment Estimator</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Valuation Simulator</h1>
            <p class="text-slate-500 text-sm">Real Property Tax (RPT) & Fair Market Value (FMV) Calculation Module.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs font-mono border border-slate-200 shadow-sm">
            Back to Roll
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        
        <!-- Left Input Form Card -->
        <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white border border-slate-200 space-y-6 shadow-sm">
            <div class="border-b border-slate-200 pb-3 flex items-center gap-2">
                <i data-lucide="sliders" class="w-5 h-5 text-amber-600"></i>
                <h3 class="text-base font-bold text-slate-900">Valuation Input Parameters</h3>
            </div>

            <div class="space-y-4 text-xs font-mono">
                <div>
                    <label asp-for="Classification" class="block text-slate-600 mb-1 font-bold">PROPERTY CLASSIFICATION</label>
                    <select asp-for="Classification" id="calcClassification" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 font-bold" asp-items="Html.GetEnumSelectList<PropertyClassification>()"></select>
                </div>

                <div>
                    <label asp-for="CustomAssessmentLevel" class="block text-slate-600 mb-1 font-bold">ASSESSMENT LEVEL (%)</label>
                    <input asp-for="CustomAssessmentLevel" id="calcLevel" type="number" step="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-right font-mono font-bold" />
                </div>

                <div>
                    <label asp-for="AreaSqMeters" class="block text-slate-600 mb-1 font-bold">LAND AREA (SQ.M.)</label>
                    <input asp-for="AreaSqMeters" id="calcArea" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-right font-mono font-bold" />
                </div>

                <div>
                    <label asp-for="UnitValue" class="block text-slate-600 mb-1 font-bold">BASE UNIT VALUE PER SQ.M. (₱)</label>
                    <input asp-for="UnitValue" id="calcUnitVal" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-right font-mono font-bold" />
                </div>

                <div>
                    <label asp-for="BuildingValue" class="block text-slate-600 mb-1 font-bold">BUILDING / IMPROVEMENT FMV (₱)</label>
                    <input asp-for="BuildingValue" id="calcBuildingVal" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-right font-mono font-bold" />
                </div>
            </div>
        </div>

        <!-- Right Live Computation Output Card -->
        <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white border border-slate-200 space-y-6 shadow-sm flex flex-col justify-between">
            <div class="space-y-6">
                <div class="border-b border-slate-200 pb-3 flex items-center gap-2">
                    <i data-lucide="pie-chart" class="w-5 h-5 text-emerald-600"></i>
                    <h3 class="text-base font-bold text-slate-900">Live Calculated Assessment</h3>
                </div>

                <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-4">
                    <div class="flex justify-between items-center text-xs font-mono">
                        <span class="text-slate-500 font-bold uppercase">Total Fair Market Value (FMV):</span>
                        <span id="resFmv" class="text-xl font-black text-slate-900">₱@Model.TotalMarketValue.ToString("N2")</span>
                    </div>

                    <div class="flex justify-between items-center text-xs font-mono">
                        <span class="text-slate-500 font-bold uppercase">Assessment Level Applied:</span>
                        <span id="resLevelBadge" class="px-2 py-0.5 rounded bg-slate-200 text-slate-700 font-bold">@Model.CustomAssessmentLevel%</span>
                    </div>

                    <div class="flex justify-between items-center text-xs font-mono pt-3 border-t border-slate-200">
                        <span class="text-emerald-700 font-bold uppercase">Assessed Value (Tax Base):</span>
                        <span id="resAssessed" class="text-2xl font-black text-emerald-700">₱@Model.AssessedValue.ToString("N2")</span>
                    </div>
                </div>

                <!-- Annual RPT Liability Box -->
                <div class="p-6 rounded-2xl bg-emerald-50/60 border border-emerald-200 space-y-3 font-mono text-xs">
                    <div class="text-emerald-800 font-bold uppercase flex items-center gap-2">
                        <i data-lucide="banknote" class="w-4 h-4"></i>
                        Annual Real Property Tax Due
                    </div>

                    <div class="flex justify-between text-slate-600">
                        <span>Basic RPT (2.0%):</span>
                        <span id="resBasicRpt" class="text-slate-900 font-bold">₱@Model.BasicRPT.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-slate-600 pb-2 border-b border-emerald-200">
                        <span>Special Education Fund - SEF (1.0%):</span>
                        <span id="resSef" class="text-slate-900 font-bold">₱@Model.SEFTax.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-amber-700 font-black text-xl pt-1">
                        <span>Total Annual Tax:</span>
                        <span id="resTotalTax">₱@Model.TotalAnnualTax.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-200 text-right">
                <a asp-action="Create" class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs font-mono inline-flex items-center gap-2 uppercase tracking-wider shadow-sm">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Register as Official FAAS
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function recalculate() {
                var area = parseFloat($('#calcArea').val()) || 0;
                var unitVal = parseFloat($('#calcUnitVal').val()) || 0;
                var bldgVal = parseFloat($('#calcBuildingVal').val()) || 0;
                var level = parseFloat($('#calcLevel').val()) || 0;

                var fmv = (area * unitVal) + bldgVal;
                var assessed = fmv * (level / 100.0);
                var basicRpt = assessed * 0.02;
                var sef = assessed * 0.01;
                var totalTax = basicRpt + sef;

                $('#resFmv').text('₱' + fmv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#resLevelBadge').text(level + '%');
                $('#resAssessed').text('₱' + assessed.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#resBasicRpt').text('₱' + basicRpt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#resSef').text('₱' + sef.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#resTotalTax').text('₱' + totalTax.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            }

            $('#calcArea, #calcUnitVal, #calcBuildingVal, #calcLevel').on('input change', recalculate);

            $('#calcClassification').on('change', function () {
                var val = $(this).val();
                $.get('/Assessment/GetDefaultAssessmentLevel', { classification: val }, function (data) {
                    if (data && data.assessmentLevel) {
                        $('#calcLevel').val(data.assessmentLevel);
                        recalculate();
                    }
                });
            });
        });
    </script>
}
