@using PropertyAssessmentApp.Models
@{
    ViewData["Title"] = "Dynamic Role Access & Form Permissions";
    var allRoles = ViewBag.AllRoles as IEnumerable<UserRoleSetting> ?? new List<UserRoleSetting>();
    var roles = ViewBag.Roles as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var selectedRoleId = ViewBag.SelectedRoleId?.ToString() ?? "";
    var selectedDivisionId = ViewBag.SelectedDivisionId?.ToString() ?? "";
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="shield-check" class="w-4 h-4"></i>
                <span>Access Control & Security Policy</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Dynamic Role Access Rights</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Configure form and module access per role. Granting access to a form allows full operational rights (View, Create, Update, and Inactivate).</p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <button id="btnSavePermissionsTop" type="button" onclick="savePermissions()" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center gap-2 shadow-md shadow-emerald-600/20 transition-all">
                <i data-lucide="save" class="w-4 h-4"></i>
                <span>Save Permissions</span>
            </button>

            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
                Back to Roles Directory
            </a>
        </div>
    </div>

    <!-- Role Selector Control Bar -->
    <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
        <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Filter Division -->
            <div>
                <label for="divisionSelector" class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-600 dark:text-stone-400 mb-1.5 flex items-center gap-1.5">
                    <i data-lucide="layers" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                    <span>Filter Division:</span>
                </label>
                <select id="divisionSelector" onchange="onDivisionChange(this.value)" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-extrabold text-sm focus:outline-none focus:border-emerald-600 cursor-pointer shadow-xs">
                    <option value="">All Divisions / System</option>
                    <option value="1" selected="@(selectedDivisionId == "1" ? "selected" : null)">Division 1: Appraisal and Assessment</option>
                    <option value="2" selected="@(selectedDivisionId == "2" ? "selected" : null)">Division 2: Tax Mapping</option>
                    <option value="3" selected="@(selectedDivisionId == "3" ? "selected" : null)">Division 3: Records</option>
                </select>
            </div>

            <!-- Select User Role to Configure -->
            <div>
                <label for="roleSelector" class="block text-[11px] font-extrabold uppercase tracking-wider text-slate-600 dark:text-stone-400 mb-1.5 flex items-center gap-1.5">
                    <i data-lucide="user-cog" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                    <span>Select User Role to Configure:</span>
                </label>
                <select id="roleSelector" onchange="onRoleChange(this.value)" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-extrabold text-sm focus:outline-none focus:border-emerald-600 cursor-pointer shadow-xs">
                    @if (allRoles.Any())
                    {
                        @foreach (var r in allRoles)
                        {
                            var divVal = r.Division.HasValue 
                                ? ((int)r.Division.Value).ToString() 
                                : (r.TransactionStatusId.HasValue && r.TransactionStatusId >= 25 && r.TransactionStatusId <= 30 ? "3" 
                                   : r.TransactionStatusId.HasValue && r.TransactionStatusId >= 15 && r.TransactionStatusId <= 19 ? "2" 
                                   : r.TransactionStatusId.HasValue && r.TransactionStatusId >= 1 && r.TransactionStatusId <= 10 ? "1" : "");
                            var displayText = r.TransactionStatusId.HasValue ? $"Step {r.TransactionStatusId}: {r.RoleName}" : r.RoleName;
                            <option value="@r.Id" data-division="@divVal" selected="@(r.Id.ToString() == selectedRoleId ? "selected" : null)">@displayText</option>
                        }
                    }
                    else
                    {
                        @foreach (var r in roles)
                        {
                            <option value="@r.Value" selected="@(r.Value == selectedRoleId.ToString() ? "selected" : null)">@r.Text</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap justify-end pt-2 lg:pt-0">
            <button type="button" onclick="toggleAllCheckboxes(true)" class="px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold text-xs flex items-center gap-1.5 transition-all">
                <i data-lucide="check-square" class="w-3.5 h-3.5 text-emerald-600"></i>
                Select All
            </button>
            <button type="button" onclick="toggleAllCheckboxes(false)" class="px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold text-xs flex items-center gap-1.5 transition-all">
                <i data-lucide="square" class="w-3.5 h-3.5 text-slate-400"></i>
                Deselect All
            </button>
        </div>
    </div>

    <!-- Loading Indicator -->
    <div id="loadingIndicator" class="text-center py-16 hidden">
        <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-emerald-600 border-t-transparent"></div>
        <p class="mt-3 text-slate-500 font-bold">Loading role permission definitions...</p>
    </div>

    <!-- Permissions Container (Injected dynamically via AJAX) -->
    <div id="permissionsContainer" class="space-y-6">
        <!-- Module category cards will render here -->
    </div>

    <!-- Bottom Save Action Bar -->
    <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex items-center justify-between">
        <div class="text-slate-500 text-xs">
            Changes will take effect immediately upon saving.
        </div>
        <button id="btnSavePermissionsBottom" type="button" onclick="savePermissions()" class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center gap-2 shadow-md shadow-emerald-600/20 transition-all">
            <i data-lucide="save" class="w-4 h-4"></i>
            <span>Save Role Permissions</span>
        </button>
    </div>
</div>

@section Scripts {
<script>
    var currentRoleId = '@selectedRoleId';

    document.addEventListener("DOMContentLoaded", function () {
        var divisionSelector = document.getElementById("divisionSelector");
        if (divisionSelector && divisionSelector.value) {
            filterRolesByDivision(divisionSelector.value, false);
        }

        if (currentRoleId) {
            loadPermissions(currentRoleId);
        }
    });

    function onDivisionChange(divisionId) {
        filterRolesByDivision(divisionId, true);
    }

    function filterRolesByDivision(divisionId, autoSelectFirst) {
        var roleSelect = document.getElementById("roleSelector");
        var options = roleSelect.options;
        var firstVisibleValue = null;
        var currentStillVisible = false;

        for (var i = 0; i < options.length; i++) {
            var opt = options[i];
            var optDiv = opt.getAttribute("data-division") || "";
            var isVisible = false;

            if (!divisionId) {
                // All divisions / system
                isVisible = true;
            } else {
                isVisible = (optDiv === divisionId);
            }

            if (isVisible) {
                opt.style.display = "";
                opt.removeAttribute("disabled");
                if (!firstVisibleValue) {
                    firstVisibleValue = opt.value;
                }
                if (opt.value === currentRoleId) {
                    currentStillVisible = true;
                }
            } else {
                opt.style.display = "none";
                opt.setAttribute("disabled", "disabled");
            }
        }

        if (autoSelectFirst || !currentStillVisible) {
            if (firstVisibleValue) {
                roleSelect.value = firstVisibleValue;
                currentRoleId = firstVisibleValue;
                loadPermissions(firstVisibleValue);
            }
        }
    }

    function onRoleChange(roleId) {
        currentRoleId = roleId;
        loadPermissions(roleId);
    }

    function loadPermissions(roleId) {
        var container = document.getElementById("permissionsContainer");
        var loader = document.getElementById("loadingIndicator");
        
        container.innerHTML = "";
        loader.classList.remove("hidden");

        fetch('/UserRole/GetRolePermissions?roleId=' + encodeURIComponent(roleId))
            .then(function (res) { return res.json(); })
            .then(function (data) {
                loader.classList.add("hidden");
                if (data.success && data.data) {
                    renderPermissions(data.data);
                } else {
                    container.innerHTML = '<div class="p-6 rounded-2xl bg-rose-50 text-rose-800 border border-rose-200 font-bold">' + (data.message || 'Failed to load permissions.') + '</div>';
                }
            })
            .catch(function (err) {
                loader.classList.add("hidden");
                container.innerHTML = '<div class="p-6 rounded-2xl bg-rose-50 text-rose-800 border border-rose-200 font-bold">Error loading permissions: ' + err + '</div>';
            });
    }

    function renderPermissions(categories) {
        var container = document.getElementById("permissionsContainer");
        if (!categories || categories.length === 0) {
            container.innerHTML = '<div class="p-8 text-center text-slate-400">No system modules found.</div>';
            return;
        }

        var html = '';

        categories.forEach(function (cat, catIdx) {
            html += '<div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm space-y-4">';
            html += '  <div class="flex items-center justify-between border-b border-slate-100 dark:border-stone-800 pb-3">';
            html += '    <div class="flex items-center gap-2">';
            html += '      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>';
            html += '      <h3 class="text-sm font-extrabold text-slate-900 dark:text-white uppercase tracking-wider">' + escapeHtml(cat.categoryName) + '</h3>';
            html += '    </div>';
            html += '    <button type="button" onclick="toggleCategoryRows(' + catIdx + ')" class="text-[11px] font-bold text-emerald-600 hover:text-emerald-700 dark:text-emerald-400">Toggle Category All</button>';
            html += '  </div>';

            html += '  <div class="overflow-x-auto">';
            html += '    <table class="w-full text-left text-xs font-mono" id="cat-table-' + catIdx + '">';
            html += '      <thead class="bg-slate-50 dark:bg-stone-950 text-slate-600 dark:text-stone-400 font-bold border-b border-slate-200 dark:border-stone-800">';
            html += '        <tr>';
            html += '          <th class="px-5 py-3.5 w-1/2">FORM / SYSTEM MODULE</th>';
            html += '          <th class="px-4 py-3.5 text-center w-1/4">RIGHTS INCLUDED</th>';
            html += '          <th class="px-4 py-3.5 text-center w-1/4">FORM ACCESS</th>';
            html += '        </tr>';
            html += '      </thead>';
            html += '      <tbody class="divide-y divide-slate-100 dark:divide-stone-800/60">';

            cat.modules.forEach(function (mod) {
                var isChecked = mod.isAllowed || mod.canView;
                html += '        <tr class="hover:bg-slate-50/80 dark:hover:bg-stone-800/50 transition-all module-perm-row" data-moduleid="' + mod.moduleId + '" data-modulecode="' + escapeHtml(mod.moduleCode) + '">';
                html += '          <td class="px-5 py-3.5">';
                html += '            <div class="font-extrabold text-slate-900 dark:text-white text-sm">' + escapeHtml(mod.moduleName) + '</div>';
                html += '            <div class="text-[10px] text-slate-400 dark:text-stone-500 font-bold uppercase tracking-wider mt-0.5">Code: <code>' + escapeHtml(mod.moduleCode) + '</code></div>';
                html += '          </td>';

                html += '          <td class="px-4 py-3.5 text-center">';
                html += '            <div class="perm-status-badge">' + (isChecked 
                                        ? '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i>Full Form Access (View, Create, Update, Inactive)</span>' 
                                        : '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-slate-100 dark:bg-stone-800 text-slate-400 dark:text-stone-500"><i data-lucide="minus-circle" class="w-3.5 h-3.5"></i>No Access</span>') + '</div>';
                html += '          </td>';

                html += '          <td class="px-4 py-3.5 text-center">';
                html += '            <label class="inline-flex items-center gap-2 cursor-pointer select-none">';
                html += '              <input type="checkbox" onchange="onFormAccessChanged(this)" class="chk-form-access w-5 h-5 rounded-lg text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 bg-white dark:bg-stone-950 cursor-pointer" ' + (isChecked ? 'checked' : '') + ' />';
                html += '              <span class="text-xs font-bold ' + (isChecked ? 'text-emerald-700 dark:text-emerald-400' : 'text-slate-500 dark:text-stone-400') + ' status-text">' + (isChecked ? 'Allowed' : 'Disabled') + '</span>';
                html += '            </label>';
                html += '          </td>';
                html += '        </tr>';
            });

            html += '      </tbody>';
            html += '    </table>';
            html += '  </div>';
            html += '</div>';
        });

        container.innerHTML = html;
        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    function onFormAccessChanged(chk) {
        var row = chk.closest(".module-perm-row");
        if (!row) return;

        var badgeCell = row.querySelector(".perm-status-badge");
        var statusText = row.querySelector(".status-text");
        var isChecked = chk.checked;
        var modCode = row.getAttribute("data-modulecode") || "";

        if (isChecked) {
            badgeCell.innerHTML = '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i>Full Form Access (View, Create, Update, Inactive)</span>';
            if (statusText) {
                statusText.textContent = "Allowed";
                statusText.className = "text-xs font-bold text-emerald-700 dark:text-emerald-400 status-text";
            }

            // RULE: "if the user has access in pool transaction it should have access in my transaction"
            if (modCode === "POOL_TRANSACTIONS") {
                var myRow = document.querySelector('.module-perm-row[data-modulecode="MY_TRANSACTIONS"]');
                if (myRow) {
                    var myChk = myRow.querySelector(".chk-form-access");
                    if (myChk && !myChk.checked) {
                        myChk.checked = true;
                        onFormAccessChanged(myChk);
                        if (window.toastr) {
                            toastr.info("Granting Pool Transactions access automatically enables My Transactions workspace.", "Workflow Rule");
                        }
                    }
                }
            }
        } else {
            badgeCell.innerHTML = '<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-slate-100 dark:bg-stone-800 text-slate-400 dark:text-stone-500"><i data-lucide="minus-circle" class="w-3.5 h-3.5"></i>No Access</span>';
            if (statusText) {
                statusText.textContent = "Disabled";
                statusText.className = "text-xs font-bold text-slate-500 dark:text-stone-400 status-text";
            }
        }

        if (window.lucide) {
            window.lucide.createIcons();
        }
    }

    function toggleAllCheckboxes(check) {
        var inputs = document.querySelectorAll("#permissionsContainer .chk-form-access");
        inputs.forEach(function (chk) {
            chk.checked = check;
            onFormAccessChanged(chk);
        });
    }

    function toggleCategoryRows(catIdx) {
        var table = document.getElementById("cat-table-" + catIdx);
        if (!table) return;
        var inputs = table.querySelectorAll(".chk-form-access");
        var anyUnchecked = Array.from(inputs).some(function (c) { return !c.checked; });
        inputs.forEach(function (c) {
            c.checked = anyUnchecked;
            onFormAccessChanged(c);
        });
    }

    function savePermissions() {
        var roleId = document.getElementById("roleSelector").value;
        if (!roleId) return;

        var rows = document.querySelectorAll(".module-perm-row");
        var permissions = [];

        rows.forEach(function (row) {
            var modId = parseInt(row.dataset.moduleid, 10);
            var isAllowed = row.querySelector(".chk-form-access")?.checked || false;

            permissions.push({
                ModuleId: modId,
                IsAllowed: isAllowed,
                CanView: isAllowed,
                CanCreate: isAllowed,
                CanEdit: isAllowed,
                CanDelete: isAllowed,
                CanApprove: isAllowed
            });
        });

        var payload = {
            RoleId: roleId,
            Permissions: permissions
        };

        var btnTop = document.getElementById("btnSavePermissionsTop");
        var btnBottom = document.getElementById("btnSavePermissionsBottom");

        if (btnTop) btnTop.disabled = true;
        if (btnBottom) btnBottom.disabled = true;

        fetch('/UserRole/SaveRolePermissions', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (btnTop) btnTop.disabled = false;
            if (btnBottom) btnBottom.disabled = false;

            if (data.success) {
                if (window.toastr) {
                    toastr.success(data.message || "Permissions updated successfully!");
                } else {
                    alert(data.message || "Permissions updated successfully!");
                }
            } else {
                if (window.toastr) {
                    toastr.error(data.message || "Failed to save permissions.");
                } else {
                    alert(data.message || "Failed to save permissions.");
                }
            }
        })
        .catch(function (err) {
            if (btnTop) btnTop.disabled = false;
            if (btnBottom) btnBottom.disabled = false;
            alert("Network error: " + err);
        });
    }

    function escapeHtml(text) {
        if (!text) return '';
        var map = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };
        return text.toString().replace(/[&<>"']/g, function(m) { return map[m]; });
    }
</script>
}
