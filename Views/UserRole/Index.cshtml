@model IEnumerable<PropertyAssessmentApp.Models.UserRoleSetting>
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = "User Roles Management";
    var search = ViewBag.Search as string ?? "";
    var totalCount = Model.Count();
    var activeCount = Model.Count(r => r.IsActive);
    var inactiveCount = Model.Count(r => !r.IsActive);
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="shield" class="w-4 h-4"></i>
                <span>System Administration & Role Settings</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">User Roles Directory</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Define and manage LGU staff user roles, division permissions, and workflow privileges.</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a asp-action="Permissions" class="px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500 text-white font-bold text-xs font-mono flex items-center gap-2 shadow-md shadow-blue-600/20 transition-all">
                <i data-lucide="shield-check" class="w-4 h-4"></i>
                Dynamic Form Permissions
            </a>
            <a asp-action="Create" class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold text-xs font-mono flex items-center gap-2 shadow-md shadow-emerald-600/20 transition-all">
                <i data-lucide="shield-plus" class="w-4 h-4"></i>
                Add New User Role
            </a>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 space-y-1 shadow-sm sinsilyo-card-light">
            <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-slate-500 dark:text-stone-400 font-bold uppercase">Total User Roles</span>
                <i data-lucide="shield" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
            </div>
            <div class="text-2xl font-black font-mono text-slate-900 dark:text-white">@totalCount</div>
            <span class="text-[10px] font-mono text-emerald-700 dark:text-emerald-400 font-bold">LGU Functional Roles</span>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 space-y-1 shadow-sm sinsilyo-card-light">
            <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-slate-500 dark:text-stone-400 font-bold uppercase">Active Operational Roles</span>
                <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
            </div>
            <div class="text-2xl font-black font-mono text-emerald-700 dark:text-emerald-400">@activeCount</div>
            <span class="text-[10px] font-mono text-slate-400 dark:text-stone-500">Available For Assignment</span>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 space-y-1 shadow-sm sinsilyo-card-light border-l-4 border-l-rose-500">
            <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-rose-700 dark:text-rose-400 font-bold uppercase">Inactive Roles</span>
                <i data-lucide="shield-alert" class="w-4 h-4 text-rose-600 dark:text-rose-400"></i>
            </div>
            <div class="text-2xl font-black font-mono text-rose-700 dark:text-rose-400">@inactiveCount</div>
            <span class="text-[10px] font-mono text-slate-500 dark:text-stone-500">Role Suspended</span>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <form method="get" asp-action="Index" class="flex flex-wrap items-center justify-between gap-4 bg-white dark:bg-stone-900 p-4 rounded-2xl border border-slate-200 dark:border-stone-800 shadow-sm font-mono text-xs">
        <div class="flex items-center gap-2 flex-1 min-w-[240px]">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-stone-400"></i>
            <input type="text" name="search" value="@search" placeholder="Search role name or description..." class="w-full bg-slate-50 dark:bg-stone-950 px-4 py-2 rounded-xl border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600">
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2 bg-slate-50 dark:bg-stone-800 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 shadow-xs shrink-0">
                <span class="limit-label text-[10px] text-slate-500 dark:text-emerald-400 font-extrabold uppercase">Limit:</span>
                <select class="table-limit-select bg-transparent font-extrabold text-slate-900 dark:text-white focus:outline-none cursor-pointer">
                    <option value="5" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">5</option>
                    <option value="10" selected class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">10</option>
                    <option value="25" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">25</option>
                    <option value="50" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">50</option>
                    <option value="100" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">100</option>
                </select>
            </div>

            <select name="divisionId" class="bg-slate-50 dark:bg-stone-950 text-slate-900 dark:text-white px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-800 font-bold">
                <option value="">All Divisions</option>
                <option value="1" selected="@(ViewBag.DivisionId == 1 ? "selected" : null)">Division 1: Appraisal and Assessment</option>
                <option value="2" selected="@(ViewBag.DivisionId == 2 ? "selected" : null)">Division 2: Tax Mapping</option>
                <option value="3" selected="@(ViewBag.DivisionId == 3 ? "selected" : null)">Division 3: Records</option>
            </select>

            <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold">Filter</button>
            <a asp-action="Index" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-300 hover:text-slate-900 dark:hover:text-white"><i data-lucide="rotate-ccw" class="w-4 h-4"></i></a>
        </div>
    </form>

    <!-- User Role Directory Table -->
    <div class="bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-sm paginated-table-card">
        <div class="overflow-x-auto min-h-[260px] pb-4 rounded-3xl">
            <table class="w-full text-left text-xs font-mono">
                <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 font-bold">
                    <tr>
                        <th class="px-3 sm:px-4 py-3.5">WORKFLOW ROLE / STEP</th>
                        <th class="hidden sm:table-cell px-4 py-3.5">DIVISION</th>
                        <th class="hidden lg:table-cell px-4 py-3.5">ALLOWED TARGET STEPS (TRANSFER TO)</th>
                        <th class="hidden xl:table-cell px-4 py-3.5">DESCRIPTION & SCOPE</th>
                        <th class="px-2 sm:px-4 py-3.5 text-center">STATUS</th>
                        <th class="px-2 sm:px-4 py-3.5 text-center">ACTION</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-stone-800/60">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-8 text-slate-400 dark:text-stone-500">
                                <i data-lucide="shield-alert" class="w-8 h-8 mx-auto mb-2 text-slate-300 dark:text-stone-600"></i>
                                No user roles found matching the filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-stone-800/50 transition-all @(!item.IsActive ? "opacity-60 bg-slate-50/50 dark:bg-stone-950/50" : "")">
                                <td class="px-3 sm:px-4 py-3.5">
                                    <div class="flex items-center gap-2">
                                        @if (item.TransactionStatusId.HasValue)
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 border border-slate-200 dark:border-stone-700 shrink-0">
                                                Step @item.TransactionStatusId
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 dark:bg-blue-950 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 shrink-0">
                                                Admin
                                            </span>
                                        }
                                        <span class="font-extrabold text-slate-900 dark:text-white font-mono text-sm block">
                                            @item.RoleName
                                        </span>
                                    </div>
                                    <div class="lg:hidden mt-2 space-y-1">
                                        <div class="text-[10px] text-slate-500 font-bold uppercase">Allowed Target Steps:</div>
                                        <div class="flex flex-wrap gap-1">
                                            @if (item.AllowedTargetSteps != null && item.AllowedTargetSteps.Any())
                                            {
                                                foreach (var target in item.AllowedTargetSteps)
                                                {
                                                    <span class="px-2 py-0.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 text-[10px] font-extrabold border border-emerald-200 dark:border-emerald-800">
                                                        @target
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-slate-400 text-[10px] italic">Final Step / Releasing</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="hidden sm:table-cell px-4 py-3.5">
                                    @if (item.Division == DivisionType.Division1_TaxAssessmentAndLandHolding)
                                    {
                                        <span class="px-2.5 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 text-[10px] font-bold uppercase block w-max">
                                            Division 1: Appraisal
                                        </span>
                                    }
                                    else if (item.Division == DivisionType.Division2_GIS_TaxMapping)
                                    {
                                        <span class="px-2.5 py-1 rounded-xl bg-teal-50 dark:bg-teal-950/40 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800 text-[10px] font-bold uppercase block w-max">
                                            Division 2: Tax Mapping
                                        </span>
                                    }
                                    else if (item.TransactionStatusId.HasValue && item.TransactionStatusId.Value >= 25)
                                    {
                                        <span class="px-2.5 py-1 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 text-[10px] font-bold uppercase block w-max">
                                            Division 3: Records
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 border border-slate-200 dark:border-stone-700 text-[10px] font-bold uppercase block w-max">
                                            All Divisions / Global
                                        </span>
                                    }
                                </td>
                                <td class="hidden lg:table-cell px-4 py-3.5">
                                    @if (item.AllowedTargetSteps != null && item.AllowedTargetSteps.Any())
                                    {
                                        <div class="flex flex-wrap gap-1.5 items-center">
                                            @foreach (var target in item.AllowedTargetSteps)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 font-extrabold text-[11px] shadow-xs">
                                                    <i data-lucide="arrow-right-circle" class="w-3.5 h-3.5 text-emerald-600"></i>
                                                    <span>@target</span>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl bg-slate-50 dark:bg-stone-950 text-slate-400 dark:text-stone-500 text-[11px] font-bold border border-dashed border-slate-200 dark:border-stone-800">
                                            <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-500"></i>
                                            <span>Final Step / Releasing (No Forward Targets)</span>
                                        </span>
                                    }
                                </td>
                                <td class="hidden xl:table-cell px-4 py-3.5 text-slate-700 dark:text-stone-300">
                                    <div class="font-bold text-slate-800 dark:text-stone-200">@(string.IsNullOrEmpty(item.Description) ? "Standard workflow step operations" : item.Description)</div>
                                </td>
                                <td class="px-2 sm:px-4 py-3.5 text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="px-2.5 py-1 rounded-lg bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/40 text-[10px] font-bold uppercase">Active</span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-lg bg-rose-100 dark:bg-rose-500/20 text-rose-800 dark:text-rose-300 border border-rose-300 dark:border-rose-500/40 text-[10px] font-bold uppercase">Inactive</span>
                                    }
                                </td>
                                <td class="px-4 py-3.5 text-center relative">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <a asp-action="Permissions" asp-route-roleId="@item.Id" asp-route-divisionId="@(item.Division.HasValue ? (int)item.Division.Value : null)" class="px-2.5 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 dark:bg-blue-950/40 dark:hover:bg-blue-900/60 dark:text-blue-300 font-bold text-[10px] flex items-center gap-1 border border-blue-200 dark:border-blue-800 shadow-xs" title="Configure dynamic form permissions for this role">
                                            <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                                            <span>Form Access</span>
                                        </a>

                                        <div class="relative inline-block text-left">
                                            <button type="button" onclick="toggleKebabMenu(event, 'kebab-role-@item.Id')" class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 border border-slate-200 dark:border-stone-700 transition-colors focus:outline-none" title="More Actions">
                                                <i data-lucide="more-vertical" class="w-4 h-4"></i>
                                            </button>

                                            <div id="kebab-role-@item.Id" class="kebab-dropdown hidden absolute right-0 mt-2 w-44 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-xl z-50 overflow-hidden divide-y divide-slate-100 dark:divide-stone-800/80 text-xs font-mono text-left">
                                                <div class="py-1">
                                                    <a asp-action="Permissions" asp-route-roleId="@item.Id" asp-route-divisionId="@(item.Division.HasValue ? (int)item.Division.Value : null)" class="flex items-center gap-2.5 px-3.5 py-2 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-stone-800 font-bold">
                                                        <i data-lucide="shield-check" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400"></i>
                                                        Configure Form Access
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="flex items-center gap-2.5 px-3.5 py-2 text-slate-700 dark:text-stone-300 hover:bg-emerald-50 dark:hover:bg-stone-800 font-bold">
                                                        <i data-lucide="edit-3" class="w-3.5 h-3.5 text-teal-600 dark:text-teal-400"></i>
                                                        Edit Role
                                                    </a>
                                                </div>
                                                <div class="py-1">
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="block">
                                                        <button type="submit" onclick="return confirm('Remove user role @item.RoleName?')" class="w-full flex items-center gap-2.5 px-3.5 py-2 text-rose-700 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-stone-800 font-bold text-left">
                                                            <i data-lucide="trash-2" class="w-3.5 h-3.5 text-rose-600"></i>
                                                            Delete Role
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="table-pagination-footer p-4 sm:p-6 pt-4 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-200 dark:border-stone-800 text-xs font-mono">
            <div class="text-slate-500 dark:text-stone-400 text-center sm:text-left">
                Showing <span class="font-bold text-slate-900 dark:text-white table-showing-start">1</span> to 
                <span class="font-bold text-slate-900 dark:text-white table-showing-end">10</span> of 
                <span class="font-bold text-slate-900 dark:text-white table-total-count">@Model.Count()</span> entries
            </div>
            <div class="flex items-center gap-1.5 flex-wrap justify-center table-pagination-buttons">
            </div>
        </div>
    </div>
</div>
