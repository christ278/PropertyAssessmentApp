<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - City Assessor Portal</title>
    
    <!-- Theme & Nav Layout Initialization script to avoid flicker -->
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
        if (localStorage.getItem('nav_layout') === 'horizontal') {
            document.documentElement.classList.add('nav-layout-horizontal');
        }
    </script>

    <!-- Tailwind CSS CDN with Dark Mode enabled -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gold: { 400: '#facc15', 500: '#eab308', 600: '#ca8a04' },
                        copper: { 400: '#fb923c', 500: '#ea580c' },
                        emerald: { 50: '#ecfdf5', 100: '#d1fae5', 400: '#34d399', 500: '#10b981', 600: '#059669', 700: '#047857', 800: '#065f46' },
                        till: { 800: '#1c1917', 900: '#0c0a09', 950: '#030202' }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        mono: ['Poppins', 'sans-serif'],
                        serif: ['Poppins', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts & Lucide Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Tom Select for Searchable Dropdowns -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    <!-- Toastr Notifications CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    
    <style>
        /* Responsive Off-Canvas Drawer on Mobile / Tablets (< lg) */
        @@media (max-width: 1023px) {
            #appSidebar {
                transform: translateX(-100%);
            }
            #appSidebar.mobile-open {
                transform: translateX(0) !important;
            }
            #mainContentWrapper {
                margin-left: 0 !important;
            }
        }
        @@media (min-width: 1024px) {
            #appSidebar {
                transform: translateX(0);
            }
        }

        /* Dynamic Navigation Layout Styles */
        html.nav-layout-horizontal #appSidebar {
            display: none !important;
        }
        html.nav-layout-horizontal #mainContentWrapper {
            margin-left: 0 !important;
        }
        html.nav-layout-horizontal .horizontal-nav-only {
            display: flex !important;
        }
        html:not(.nav-layout-horizontal) .horizontal-nav-only {
            display: none !important;
        }
        html.nav-layout-horizontal .sidebar-nav-only {
            display: none !important;
        }
    </style>
</head>
@inject PropertyAssessmentApp.Services.IPermissionService PermissionService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool isSettingsActive = currentController is "OrderPayment" or "UserAccount" or "UserRole" or "Workflow" or "FileLocation" or "DataTransferUtility";
    bool isRequestsActive = currentController is "PropertyAssessmentRequest" or "RequestForInspection" or "LandHoldingRequest" or "TaxDeclarationRequest" or "TaxMapping";
    var userPerms = PermissionService.GetUserPermissionSummary(User);

    // Dynamic Module Permission Flags
    bool canAssessmentRoll = PermissionService.CanAccess(User, "Assessment");
    bool canOwner = PermissionService.CanAccess(User, "Owner");
    bool canRpa = PermissionService.CanAccess(User, "PropertyAssessmentRequest");
    bool canRfi = PermissionService.CanAccess(User, "RequestForInspection");
    bool canFaasCreate = canAssessmentRoll;
    bool showAssessmentGroup = canAssessmentRoll || canOwner || canRpa || canRfi;

    bool canLandHolding = PermissionService.CanAccess(User, "LandHoldingRequest");
    bool canTaxDeclaration = PermissionService.CanAccess(User, "TaxDeclarationRequest");
    bool canTaxMapping = PermissionService.CanAccess(User, "TaxMapping");
    bool showRequestsGroup = canLandHolding || canTaxDeclaration || canTaxMapping;

    bool canDashStaff = PermissionService.CanAccess(User, "Dashboard", "Staff");
    bool canDashHead = PermissionService.CanAccess(User, "Dashboard", "AssessorHead");
    bool canDashAdmin = PermissionService.CanAccess(User, "Dashboard", "SystemOwner");
    bool showDashboardGroup = canDashStaff || canDashHead || canDashAdmin;

    bool canPool = PermissionService.CanAccess(User, "Workflow", "Pool");
    bool canMyTransactions = PermissionService.CanAccess(User, "Workflow", "MyTransactions") || canPool;
    bool showWorkflowGroup = canPool || canMyTransactions;

    bool canOrderPayment = PermissionService.CanAccess(User, "OrderPayment");
    bool canUserAccount = PermissionService.CanAccess(User, "UserAccount");
    bool canUserRole = PermissionService.CanAccess(User, "UserRole");
    bool canRolePermissions = PermissionService.CanAccess(User, "UserRole", "Permissions");
    bool canWorkflowSettings = PermissionService.CanAccess(User, "Workflow", "Settings");
    bool canFileLocation = PermissionService.CanAccess(User, "FileLocation");
    bool canDataTransfer = PermissionService.CanAccess(User, "DataTransferUtility");
    bool showSettingsGroup = canOrderPayment || canUserAccount || canUserRole || canRolePermissions || canWorkflowSettings || canFileLocation || canDataTransfer;
}
<body class="bg-slate-50 dark:bg-till-950 text-slate-900 dark:text-stone-100 font-sans antialiased flex min-h-screen overflow-x-hidden selection:bg-emerald-500 selection:text-white transition-colors duration-200">

    <!-- Ambient Glow Backgrounds -->
    <div class="fixed top-0 left-1/4 w-[500px] h-[500px] bg-emerald-200/30 dark:bg-emerald-600/10 blur-[140px] pointer-events-none rounded-full"></div>
    <div class="fixed bottom-10 right-10 w-[400px] h-[400px] bg-teal-200/20 dark:bg-teal-600/10 blur-[130px] pointer-events-none rounded-full"></div>

    <!-- LEFT SIDEBAR NAVIGATION (Shown when in Sidebar mode) -->
    <aside id="appSidebar" class="w-64 bg-white/95 dark:bg-till-900/90 backdrop-blur-xl border-r border-slate-200/90 dark:border-stone-800/80 shadow-2xl lg:shadow-sm flex flex-col justify-between fixed top-0 bottom-0 left-0 z-50 transition-transform duration-300">
        
        <!-- Logo & Brand Header -->
        <div class="p-4 sm:p-6 border-b border-slate-200/80 dark:border-stone-800/80 flex items-center justify-between">
            <a asp-controller="Assessment" asp-action="Index" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 dark:from-emerald-400 dark:to-teal-600 flex items-center justify-center shadow-md shadow-emerald-500/20 text-white dark:text-till-950 font-bold text-xl ring-2 ring-emerald-500/20 dark:ring-emerald-400/30">
                    🏛️
                </div>
                <div>
                    <span class="text-lg font-extrabold tracking-tight text-slate-900 dark:bg-gradient-to-r dark:from-emerald-300 dark:via-teal-400 dark:to-emerald-500 dark:bg-clip-text dark:text-transparent">
                        City Assessor
                    </span>
                    <span class="block text-[10px] uppercase font-mono tracking-widest text-emerald-700 dark:text-emerald-400 font-bold">FAIRTRACK</span>
                </div>
            </a>
            <!-- Mobile Close Button -->
            <button type="button" onclick="closeMobileSidebar()" class="lg:hidden p-1.5 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-stone-200 hover:bg-slate-100 dark:hover:bg-stone-800 transition-all" title="Close Menu">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 p-4 space-y-1.5 overflow-y-auto">
            @if (showDashboardGroup)
            {
                <div class="px-3 pb-2 text-[10px] font-mono text-slate-400 dark:text-stone-500 font-bold uppercase tracking-wider">Dashboards</div>
                @if (canDashAdmin)
                {
                <a asp-controller="Dashboard" asp-action="SystemOwner" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Dashboard" && currentAction == "SystemOwner" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300")"><i data-lucide="server-cog" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i><span>System Owner</span></a>
                }
                @if (canDashHead)
                {
                <a asp-controller="Dashboard" asp-action="AssessorHead" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Dashboard" && currentAction == "AssessorHead" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300")"><i data-lucide="gauge" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i><span>Assessor Head</span></a>
                }
                @if (canDashStaff)
                {
                <a asp-controller="Dashboard" asp-action="Staff" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Dashboard" && currentAction == "Staff" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300")"><i data-lucide="layout-dashboard" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i><span>My Dashboard</span></a>
                }
            }

            @if (showWorkflowGroup)
            {
                <div class="px-3 pb-2 text-[10px] font-mono text-slate-400 dark:text-stone-500 font-bold uppercase tracking-wider">Transaction Workflows</div>

                @if (canPool)
                {
                    <a asp-controller="Workflow" asp-action="Pool" class="nav-item flex items-center justify-between px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Workflow" && currentAction == "Pool" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <div class="flex items-center gap-3">
                            <i data-lucide="inbox" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                            <span>Pool Transactions</span>
                        </div>
                        <span class="px-2 py-0.5 rounded-lg text-[9px] bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 font-bold uppercase">Pool</span>
                    </a>
                }

                @if (canMyTransactions)
                {
                    <a asp-controller="Workflow" asp-action="MyTransactions" class="nav-item flex items-center justify-between px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Workflow" && currentAction == "MyTransactions" ? "bg-blue-50 text-blue-700 dark:bg-stone-800 dark:text-blue-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-blue-700 dark:hover:text-blue-400")">
                        <div class="flex items-center gap-3">
                            <i data-lucide="user-check" class="w-4 h-4 text-blue-600 dark:text-blue-400"></i>
                            <span>My Transactions</span>
                        </div>
                        <span class="px-2 py-0.5 rounded-lg text-[9px] bg-blue-100 dark:bg-blue-500/20 text-blue-800 dark:text-blue-300 font-bold uppercase">Active</span>
                    </a>
                }
            }

            @if (showAssessmentGroup)
            {
                <div class="px-3 pt-3 pb-2 text-[10px] font-mono text-slate-400 dark:text-stone-500 font-bold uppercase tracking-wider">Assessment Modules</div>
                
                @if (canAssessmentRoll)
                {
                    <a asp-controller="Assessment" asp-action="Index" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Assessment" && currentAction != "Create" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <i data-lucide="layers" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Assessment Records</span>
                    </a>
                }

                @if (canOwner)
                {
                    <a asp-controller="Owner" asp-action="Index" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Owner" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <i data-lucide="users" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Owner Registration</span>
                    </a>
                }

                @if (canRpa)
                {
                    <a asp-controller="PropertyAssessmentRequest" asp-action="Index" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "PropertyAssessmentRequest" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <i data-lucide="clipboard-list" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Property Assessment (RPA)</span>
                    </a>
                }

                @if (canRfi)
                {
                    <a asp-controller="RequestForInspection" asp-action="Index" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "RequestForInspection" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <i data-lucide="clipboard-check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Inspection Requests (RFI)</span>
                    </a>
                }

                @if (canFaasCreate)
                {
                    <a asp-controller="Assessment" asp-action="Create" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Assessment" && currentAction == "Create" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <i data-lucide="file-plus" class="w-4 h-4 text-teal-600 dark:text-teal-400"></i>
                        <span>FAAS Encoding Wizard</span>
                    </a>
                }
            }

            @if (showRequestsGroup)
            {
                <div class="px-3 pt-4 pb-2 text-[10px] font-mono text-slate-400 dark:text-stone-500 font-bold uppercase tracking-wider">Requests & Services</div>

                @if (canLandHolding)
                {
                    <a asp-controller="LandHoldingRequest" asp-action="Index" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "LandHoldingRequest" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <i data-lucide="award" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Land Holding Requests</span>
                    </a>
                }

                @if (canTaxDeclaration)
                {
                    <a asp-controller="TaxDeclarationRequest" asp-action="Index" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "TaxDeclarationRequest" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <i data-lucide="file-text" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Tax Declaration Requests</span>
                    </a>
                }

                @if (canTaxMapping)
                {
                    <a asp-controller="TaxMapping" asp-action="Index" class="nav-item flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "TaxMapping" ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800 dark:text-emerald-400 font-bold" : "text-slate-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400")">
                        <i data-lucide="map-pin" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Tax Mapping Requests</span>
                    </a>
                }
            }

            @if (showSettingsGroup)
            {
                <!-- Collapsible Settings & Admin Navigation Section in Sidebar -->
                <div class="pt-4">
                    <button type="button" onclick="toggleSidebarSettings()" class="w-full flex items-center justify-between px-3.5 py-2 rounded-xl text-[11px] font-mono uppercase tracking-wider font-bold transition-all @(isSettingsActive ? "bg-emerald-50 text-emerald-700 dark:bg-stone-800/80 dark:text-emerald-400" : "text-slate-500 dark:text-stone-400 hover:bg-slate-100 dark:hover:bg-stone-800/40")">
                        <span class="flex items-center gap-2">
                            <i data-lucide="settings-2" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                            <span>File Maintenance & Admin</span>
                        </span>
                        <i data-lucide="chevron-down" id="sidebarSettingsChevron" class="w-3 h-3 transition-transform duration-200 @(isSettingsActive ? "rotate-180" : "")"></i>
                    </button>

                    <div id="sidebarSettingsMenu" class="@(isSettingsActive ? "" : "hidden") pl-2 space-y-1 mt-1.5 transition-all">
                        @if (canOrderPayment)
                        {
                            <a asp-controller="OrderPayment" asp-action="Index" class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "OrderPayment" ? "bg-emerald-100/70 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 font-bold" : "text-slate-600 dark:text-stone-400 hover:text-emerald-700 dark:hover:text-emerald-400")">
                                <i data-lucide="receipt" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                                <span>Order of Payment Fees</span>
                            </a>
                        }

                        @if (canUserAccount)
                        {
                            <a asp-controller="UserAccount" asp-action="Index" class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "UserAccount" ? "bg-emerald-100/70 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 font-bold" : "text-slate-600 dark:text-stone-400 hover:text-emerald-700 dark:hover:text-emerald-400")">
                                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                                <span>User Accounts</span>
                            </a>
                        }

                        @if (canUserRole)
                        {
                            <a asp-controller="UserRole" asp-action="Index" class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "UserRole" && currentAction != "Permissions" ? "bg-emerald-100/70 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 font-bold" : "text-slate-600 dark:text-stone-400 hover:text-emerald-700 dark:hover:text-emerald-400")">
                                <i data-lucide="user-cog" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                                <span>User Roles</span>
                            </a>
                        }

                        @if (canRolePermissions)
                        {
                            <a asp-controller="UserRole" asp-action="Permissions" class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "UserRole" && currentAction == "Permissions" ? "bg-emerald-100/70 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 font-bold" : "text-slate-600 dark:text-stone-400 hover:text-emerald-700 dark:hover:text-emerald-400")">
                                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400"></i>
                                <span>Role Permissions</span>
                            </a>
                        }

                        @if (canWorkflowSettings)
                        {
                            <a asp-controller="Workflow" asp-action="Settings" class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "Workflow" ? "bg-emerald-100/70 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 font-bold" : "text-slate-600 dark:text-stone-400 hover:text-emerald-700 dark:hover:text-emerald-400")">
                                <i data-lucide="git-pull-request" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                                <span>Workflow Pipeline</span>
                            </a>
                        }

                        @if (canFileLocation)
                        {
                            <a asp-controller="FileLocation" asp-action="Index" class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "FileLocation" ? "bg-emerald-100/70 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 font-bold" : "text-slate-600 dark:text-stone-400 hover:text-emerald-700 dark:hover:text-emerald-400")">
                                <i data-lucide="hard-drive" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                                <span>File Location Setup</span>
                            </a>
                        }

                        @if (canDataTransfer)
                        {
                            <a asp-controller="DataTransferUtility" asp-action="Index" class="nav-item flex items-center gap-2.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all hover:bg-emerald-50 dark:hover:bg-stone-800/80 @(currentController == "DataTransferUtility" ? "bg-emerald-100/70 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300 font-bold" : "text-slate-600 dark:text-stone-400 hover:text-emerald-700 dark:hover:text-emerald-400")">
                                <i data-lucide="arrow-right-left" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                                <span>Data Transfer Utility</span>
                            </a>
                        }
