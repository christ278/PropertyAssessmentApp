    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Toastr Notifications JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <!-- Microsoft SignalR Real-Time Hub Client -->
    <script src="~/lib/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "showDuration": "300",
            "hideDuration": "800",
            "timeOut": "6000",
            "extendedTimeOut": "2000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        // Initialize Global Real-Time SignalR Hub Connection
        if (typeof signalR !== 'undefined') {
            const workflowHubConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/workflow")
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            workflowHubConnection.on("TransactionForwarded", function (data) {
                console.log("⚡ SignalR: Transaction Forwarded in real-time:", data);

                // Play gentle notification chime via Web Audio API
                try {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) {
                        const ctx = new AudioCtx();
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = "sine";
                        osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15);
                        gain.gain.setValueAtTime(0.12, ctx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start();
                        osc.stop(ctx.currentTime + 0.3);
                    }
                } catch (e) { }

                // Display rich Toastr pop-up alert
                if (typeof toastr !== 'undefined') {
                    toastr.info(
                        `<div class="space-y-1 font-mono text-xs">` +
                        `<div class="font-bold text-emerald-400">📄 ${data.trackingNumber} (${data.requestType})</div>` +
                        `<div><strong>Target Station:</strong> ${data.targetStageName}</div>` +
                        `<div><strong>Assigned To:</strong> ${data.targetRole}</div>` +
                        `<div class="text-[10px] text-slate-300">From: ${data.forwardedByName} (${data.forwardedByRole})</div>` +
                        `</div>`,
                        "⚡ Transaction Received in Real-Time!",
                        { timeOut: 7000, extendedTimeOut: 3000, enableHtml: true }
                    );
                }

                // Dispatch global event for page-level handlers (Pool, MyTransactions, Queues)
                window.dispatchEvent(new CustomEvent('workflow:transactionForwarded', { detail: data }));
            });

            workflowHubConnection.on("TransactionClaimed", function (data) {
                window.dispatchEvent(new CustomEvent('workflow:transactionClaimed', { detail: data }));
            });

            workflowHubConnection.on("TransactionReleased", function (data) {
                window.dispatchEvent(new CustomEvent('workflow:transactionReleased', { detail: data }));
            });

            workflowHubConnection.on("TransactionDeferred", function (data) {
                window.dispatchEvent(new CustomEvent('workflow:transactionDeferred', { detail: data }));
            });

            workflowHubConnection.start()
                .then(function () {
                    console.log("⚡ SignalR connected to /hubs/workflow successfully.");
                })
                .catch(function (err) {
                    console.warn("SignalR connection attempt failed:", err.toString());
                });
        }

        window.UserPermissions = {
            isAuthenticated: @(userPerms.IsAuthenticated ? "true" : "false"),
            isRoleSet: @(userPerms.IsRoleSet ? "true" : "false"),
            workflowRoleId: @(userPerms.WorkflowRoleId.HasValue ? userPerms.WorkflowRoleId.Value.ToString() : "null"),
            roleName: '@(userPerms.RoleName ?? "")',
            allowedControllers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userPerms.AllowedControllers.Select(c => c.ToLower()))),
            allowedCreateControllers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userPerms.AllowedCreateControllers.Select(c => c.ToLower()))),
            restrictedControllers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userPerms.RestrictedControllers.Select(c => c.ToLower())))
        };

        // Intercept navigation to prevent redirection to forms if role is not set or access is not assigned
        document.addEventListener("click", function (e) {
            var target = e.target.closest("a, button[data-href]");
            if (!target) return;

            var href = target.getAttribute("href") || target.getAttribute("data-href");
            if (!href || href.startsWith("#") || href.startsWith("javascript:") || href.startsWith("mailto:") || href.startsWith("tel:")) return;

            // Allow logout or login
            if (href.indexOf("/Account/Logout") !== -1 || href.indexOf("/Account/Login") !== -1) return;

            // External URLs
            if (href.startsWith("http://") || href.startsWith("https://")) return;

            if (!window.UserPermissions || !window.UserPermissions.isAuthenticated) {
                return;
            }

            var cleanHref = href.split("?")[0].split("#")[0].trim();
            var segments = cleanHref.split("/").filter(Boolean);
            
            var targetController = "Assessment";
            var targetAction = "Index";

            if (segments.length > 0) {
                targetController = segments[0];
                targetAction = segments.length > 1 ? segments[1] : "Index";
            }

            // Always allow general workflow transaction pool & public pages
            if (targetController.toLowerCase() === "workflow" && targetAction.toLowerCase() !== "settings") {
                return;
            }
            if (targetController.toLowerCase() === "home" || targetController.toLowerCase() === "account" || targetController.toLowerCase() === "location") {
                return;
            }

            // Check if target controller is one of the restricted system modules
            var isRestrictedModule = window.UserPermissions.restrictedControllers.indexOf(targetController.toLowerCase()) !== -1;

            if (isRestrictedModule) {
                // RULE 1: If role access is not set at all (no checks in system for this role)
                if (!window.UserPermissions.isRoleSet) {
                    e.preventDefault();
                    e.stopPropagation();
                    toastr.error("User role access is not being set. Please contact your system administrator.", "Access Notice");
                    return false;
                }

                // RULE 2: If the user role does not have access to this form/module
                var isAllowed = window.UserPermissions.allowedControllers.indexOf(targetController.toLowerCase()) !== -1;

                if (!isAllowed) {
                    e.preventDefault();
                    e.stopPropagation();
                    toastr.warning("Your user role does not have access assigned to this form.", "Access Restricted");
                    return false;
                }
            }
        }, true);
    </script>
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                toastr.success('@TempData["SuccessMessage"]', 'System Notice');
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                toastr.error('@TempData["ErrorMessage"]', 'Access Notice');
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        lucide.createIcons();

        // ---------------------------------------------------------------------
        // NAVIGATION LAYOUT TOGGLE (Sidebar <-> Horizontal Top Navbar)
        // ---------------------------------------------------------------------
        function getNavLayout() {
            return localStorage.getItem('nav_layout') || 'sidebar';
        }

        function setNavLayout(layout) {
            if (layout === 'horizontal') {
                document.documentElement.classList.add('nav-layout-horizontal');
                localStorage.setItem('nav_layout', 'horizontal');
            } else {
                document.documentElement.classList.remove('nav-layout-horizontal');
                localStorage.setItem('nav_layout', 'sidebar');
            }
            updateNavLayoutUI();
            lucide.createIcons();
        }

        function toggleNavLayout() {
            var current = getNavLayout();
            setNavLayout(current === 'horizontal' ? 'sidebar' : 'horizontal');
        }

        function updateNavLayoutUI() {
            var isHorizontal = document.documentElement.classList.contains('nav-layout-horizontal');
            var iconSidebar = document.getElementById('layoutIconSidebar');
            var iconHorizontal = document.getElementById('layoutIconHorizontal');
            var textElem = document.getElementById('layoutToggleText');
            var choiceSidebar = document.getElementById('navChoiceSidebar');
            var choiceHorizontal = document.getElementById('navChoiceHorizontal');

            if (textElem) {
                textElem.innerText = isHorizontal ? 'Top Nav' : 'Sidebar';
            }
            if (iconSidebar && iconHorizontal) {
                if (isHorizontal) {
                    iconSidebar.classList.add('hidden');
                    iconHorizontal.classList.remove('hidden');
                } else {
                    iconSidebar.classList.remove('hidden');
                    iconHorizontal.classList.add('hidden');
                }
            }
            if (choiceSidebar && choiceHorizontal) {
                if (isHorizontal) {
                    choiceHorizontal.className = "px-2.5 py-1 rounded-md text-[10px] font-mono font-bold bg-emerald-600 text-white shadow-xs transition-all";
                    choiceSidebar.className = "px-2.5 py-1 rounded-md text-[10px] font-mono font-bold text-slate-600 dark:text-stone-400 hover:text-slate-900 dark:hover:text-stone-200 transition-all";
                } else {
                    choiceSidebar.className = "px-2.5 py-1 rounded-md text-[10px] font-mono font-bold bg-emerald-600 text-white shadow-xs transition-all";
                    choiceHorizontal.className = "px-2.5 py-1 rounded-md text-[10px] font-mono font-bold text-slate-600 dark:text-stone-400 hover:text-slate-900 dark:hover:text-stone-200 transition-all";
                }
            }
        }

        // Initialize UI State for Layout toggle on page load
        updateNavLayoutUI();

        // ---------------------------------------------------------------------
        // SETTINGS & REQUESTS DROPDOWNS
        // ---------------------------------------------------------------------
        function toggleSettingsDropdown(event) {
            event.stopPropagation();
            var menu = document.getElementById('settingsDropdownMenu');
            var chevron = document.getElementById('settingsChevron');
            if (!menu) return;

            var isHidden = menu.classList.contains('hidden');
            // Close other dropdowns
            closeAllDropdowns(menu);

            if (isHidden) {
                menu.classList.remove('hidden');
                if (chevron) chevron.classList.add('rotate-180');
            } else {
                menu.classList.add('hidden');
                if (chevron) chevron.classList.remove('rotate-180');
            }
        }

        function toggleHorizontalRequestsDropdown(event) {
            event.stopPropagation();
            var menu = document.getElementById('horizontalRequestsDropdownMenu');
            var chevron = document.getElementById('horizontalRequestsChevron');
            if (!menu) return;

            var isHidden = menu.classList.contains('hidden');
            closeAllDropdowns(menu);

            if (isHidden) {
                menu.classList.remove('hidden');
                if (chevron) chevron.classList.add('rotate-180');
            } else {
                menu.classList.add('hidden');
                if (chevron) chevron.classList.remove('rotate-180');
            }
        }

        function closeAllDropdowns(exceptMenu) {
            document.querySelectorAll('.kebab-dropdown').forEach(m => {
                if (m !== exceptMenu) m.classList.add('hidden');
            });
            var sMenu = document.getElementById('settingsDropdownMenu');
            var sChevron = document.getElementById('settingsChevron');
            if (sMenu && sMenu !== exceptMenu) {
                sMenu.classList.add('hidden');
                if (sChevron) sChevron.classList.remove('rotate-180');
            }
            var rMenu = document.getElementById('horizontalRequestsDropdownMenu');
            var rChevron = document.getElementById('horizontalRequestsChevron');
            if (rMenu && rMenu !== exceptMenu) {
                rMenu.classList.add('hidden');
                if (rChevron) rChevron.classList.remove('rotate-180');
            }
        }

        // Sidebar Collapsible Settings Toggle
        function toggleSidebarSettings() {
            var menu = document.getElementById('sidebarSettingsMenu');
            var chevron = document.getElementById('sidebarSettingsChevron');
            if (!menu) return;
            menu.classList.toggle('hidden');
            if (chevron) chevron.classList.toggle('rotate-180');
        }

        function toggleKebabMenu(event, menuId) {
            event.stopPropagation();
            var menu = document.getElementById(menuId);
            if (!menu) return;

            closeAllDropdowns(menu);

            var isOpening = menu.classList.contains('hidden');
            menu.classList.toggle('hidden');

            if (isOpening) {
                var rect = menu.getBoundingClientRect();
                var windowHeight = window.innerHeight || document.documentElement.clientHeight;

                if (rect.bottom > windowHeight - 10) {
                    menu.style.top = 'auto';
                    menu.style.bottom = '100%';
                    menu.style.marginTop = '0';
                    menu.style.marginBottom = '0.5rem';
                } else {
                    menu.style.bottom = 'auto';
                    menu.style.top = '100%';
                    menu.style.marginTop = '0.5rem';
                    menu.style.marginBottom = '0';
                }
            }
        }

        document.addEventListener('click', function (e) {
            // Close kebab dropdowns
            if (!e.target.closest('.kebab-dropdown') && !e.target.closest('button[onclick*="toggleKebabMenu"]')) {
                document.querySelectorAll('.kebab-dropdown').forEach(function (m) {
                    m.classList.add('hidden');
                });
            }

            // Close settings dropdown if clicking outside
            var sContainer = document.getElementById('settingsDropdownContainer');
            if (sContainer && !sContainer.contains(e.target)) {
                var sMenu = document.getElementById('settingsDropdownMenu');
                var sChevron = document.getElementById('settingsChevron');
                if (sMenu && !sMenu.classList.contains('hidden')) {
                    sMenu.classList.add('hidden');
                    if (sChevron) sChevron.classList.remove('rotate-180');
                }
            }

            // Close horizontal requests dropdown if clicking outside
            var rContainer = document.getElementById('horizontalRequestsDropdownContainer');
            if (rContainer && !rContainer.contains(e.target)) {
                var rMenu = document.getElementById('horizontalRequestsDropdownMenu');
                var rChevron = document.getElementById('horizontalRequestsChevron');
                if (rMenu && !rMenu.classList.contains('hidden')) {
                    rMenu.classList.add('hidden');
                    if (rChevron) rChevron.classList.remove('rotate-180');
                }
            }
        });

        // Mobile Sidebar Drawer Navigation
        function toggleMobileSidebar() {
            var sidebar = document.getElementById('appSidebar');
            var backdrop = document.getElementById('mobileSidebarBackdrop');
            if (!sidebar || !backdrop) return;
            
            var isOpen = sidebar.classList.contains('mobile-open');
            if (isOpen) {
                closeMobileSidebar();
            } else {
                sidebar.classList.add('mobile-open');
                backdrop.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeMobileSidebar() {
            var sidebar = document.getElementById('appSidebar');
            var backdrop = document.getElementById('mobileSidebarBackdrop');
            if (sidebar) sidebar.classList.remove('mobile-open');
            if (backdrop) backdrop.classList.add('hidden');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === "Escape") {
                closeAllDropdowns(null);
                closeMobileSidebar();
                closeTimelineModal();
            }
        });

        // ---------------------------------------------------------------------
        // UNIVERSAL TRANSACTION TIMELINE MODAL FUNCTIONS
        // ---------------------------------------------------------------------
        function openTimelineModal(requestId, trackingNumber) {
            var modal = document.getElementById('universalTimelineModal');
            var loading = document.getElementById('modalTimelineLoading');
            var body = document.getElementById('modalTimelineBody');
            var errorEl = document.getElementById('modalTimelineError');
            var trackingEl = document.getElementById('modalTimelineTracking');
            var typeBadge = document.getElementById('modalTimelineTypeBadge');
            var statusBadge = document.getElementById('modalTimelineStatusBadge');
            var fullPageLink = document.getElementById('modalTimelineFullPageLink');
            var elapsedEl = document.getElementById('modalTimelineElapsed');

            if (!modal) return;

            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            loading.classList.remove('hidden');
            body.classList.add('hidden');
            if (errorEl) errorEl.classList.add('hidden');

            trackingEl.innerText = trackingNumber ? trackingNumber : 'Loading Transaction...';
            typeBadge.innerText = 'Searching';
            statusBadge.innerText = '';
            statusBadge.className = 'hidden';

            if (fullPageLink) {
                fullPageLink.href = '/Workflow/Timeline?' + (trackingNumber ? 'trackingNumber=' + encodeURIComponent(trackingNumber) : 'id=' + encodeURIComponent(requestId || ''));
            }

            var params = new URLSearchParams();
            if (requestId) params.append('id', requestId);
            if (trackingNumber) params.append('trackingNumber', trackingNumber);

            fetch('/Workflow/GetTransactionTimeline?' + params.toString())
                .then(function (response) {
                    if (!response.ok) throw new Error('Transaction record could not be found.');
                    return response.json();
                })
                .then(function (res) {
                    loading.classList.add('hidden');

                    // CRUCIAL: Unpack timeline object from response
                    var data = (res && (res.timeline || res.data)) ? (res.timeline || res.data) : res;

                    if (!data || (!data.trackingNumber && !data.TrackingNumber)) {
                        throw new Error('Transaction record details are unavailable.');
                    }

                    body.classList.remove('hidden');

                    var trkNum = data.trackingNumber || data.TrackingNumber || 'Transaction';
                    var reqType = data.displayType || data.DisplayType || data.requestType || data.RequestType || 'Request';
                    var status = data.overallStatus || data.OverallStatus || 'Pending';

                    trackingEl.innerText = trkNum;
                    typeBadge.innerText = reqType;
                    
                    switch (status) {
                        case 'Released':
                            statusBadge.innerText = 'Released';
                            statusBadge.className = 'px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300';
                            break;
                        case 'Deferred':
                            statusBadge.innerText = 'Deferred';
                            statusBadge.className = 'px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-amber-100 dark:bg-amber-500/20 text-amber-800 dark:text-amber-300';
                            break;
                        case 'For Approval':
                            statusBadge.innerText = 'For Approval';
                            statusBadge.className = 'px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-purple-100 dark:bg-purple-500/20 text-purple-800 dark:text-purple-300';
                            break;
                        case 'On Going':
                            statusBadge.innerText = 'On Going';
                            statusBadge.className = 'px-2.5 py-0.5 rounded-lg text-[10px] font-black bg-blue-100 dark:bg-blue-500/20 text-blue-800 dark:text-blue-300';
                            break;
                        default: // 'Pending'
                            statusBadge.innerText = 'Pending';
                            statusBadge.className = 'px-2.5 py-0.5 rounded-lg text-[10px] font-bold bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300';
                            break;
                    }

                    if (fullPageLink) {
                        fullPageLink.href = '/Workflow/Timeline?trackingNumber=' + encodeURIComponent(trkNum);
                    }
                    if (elapsedEl) {
                        var dateVal = data.dateSubmitted || data.DateSubmitted;
                        var dateStr = dateVal ? new Date(dateVal).toLocaleString() : '';
                        var elapsedStr = data.elapsedTimeText || data.ElapsedTimeText || 'N/A';
                        elapsedEl.innerHTML = '<i data-lucide="clock" class="w-3.5 h-3.5 text-indigo-500"></i><span>Elapsed: <strong>' + elapsedStr + '</strong> (Filed ' + dateStr + ')</span>';
                    }

                    renderTimelineModalData(data);
                    if (window.lucide) lucide.createIcons();
                })
                .catch(function (err) {
                    loading.classList.add('hidden');
                    if (errorEl) {
                        errorEl.classList.remove('hidden');
                        var msgSpan = errorEl.querySelector('.err-msg');
                        if (msgSpan) msgSpan.innerText = err.message || 'Unable to locate transaction history.';
                    }
                    if (window.lucide) lucide.createIcons();
                });
        }

        function closeTimelineModal() {
            var modal = document.getElementById('universalTimelineModal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        function handleTimelineModalBackdrop(event) {
            if (event.target && event.target.id === 'universalTimelineModal') {
                closeTimelineModal();
            }
        }

        function printTimelineFromModal() {
            var fullPageLink = document.getElementById('modalTimelineFullPageLink');
            if (fullPageLink && fullPageLink.href && fullPageLink.href !== '#') {
                window.open(fullPageLink.href + '&autoPrint=true', '_blank');
            } else {
                window.print();
            }
        }

        function renderTimelineModalData(data) {
            var body = document.getElementById('modalTimelineBody');
            if (!body) return;

            var html = '';

            var overallStatus = data.overallStatus || data.OverallStatus || 'Pending';
            var isClaimed = data.isClaimed || data.IsClaimed || false;
            var assignedUserName = data.assignedUserName || data.AssignedUserName;
            var assignedRole = data.assignedToRole || data.AssignedToRole || 'Processor';
            var stageName = data.currentStageName || data.CurrentStageName || '';
            var locationDesc = data.currentLocationDescription || data.CurrentLocationDescription || stageName || 'Current Station';
            var divisionName = data.divisionName || data.DivisionName || '';
            var owner = data.ownerOrApplicant || data.OwnerOrApplicant || 'N/A';
            var orNumber = data.orNumber || data.ORNumber;
            var orDateIssued = data.orDateIssued || data.ORDateIssued;
            var dateSubmitted = data.dateSubmitted || data.DateSubmitted;
            var steps = data.workflowSteps || data.WorkflowSteps || [];
            var events = data.timelineEvents || data.TimelineEvents || [];

            // 1. Live Current Location Card
            var handlerStatusHtml = '';
            if (overallStatus === 'Released') {
                handlerStatusHtml = '<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 font-bold text-xs"><i data-lucide="check-check" class="w-4 h-4"></i><span>Released & Officially Issued</span></div>';
            } else if (overallStatus === 'Deferred') {
                handlerStatusHtml = '<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-100 dark:bg-amber-500/20 text-amber-800 dark:text-amber-300 font-bold text-xs"><i data-lucide="rotate-ccw" class="w-4 h-4"></i><span>Deferred &bull; Returned for Revision</span></div>';
            } else if (overallStatus === 'For Approval') {
                handlerStatusHtml = '<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-purple-100 dark:bg-purple-500/20 text-purple-800 dark:text-purple-300 font-bold text-xs"><i data-lucide="shield-alert" class="w-4 h-4"></i><span>For Approval &bull; Signatory Review</span></div>';
            } else if (overallStatus === 'On Going' || (isClaimed && assignedUserName)) {
                handlerStatusHtml = '<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-blue-100 dark:bg-blue-500/20 text-blue-800 dark:text-blue-300 font-bold text-xs"><i data-lucide="user-check" class="w-4 h-4"></i><span>Claimed by <strong>' + escapeHtml(assignedUserName || 'Staff') + '</strong> (' + escapeHtml(assignedRole) + ')</span></div>';
            } else {
                handlerStatusHtml = '<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs"><i data-lucide="clock" class="w-4 h-4"></i><span>Pending &bull; In <strong>' + escapeHtml(stageName) + '</strong> Pool</span></div>';
            }

            html += '<div class="p-5 rounded-2xl bg-gradient-to-r from-indigo-50/70 via-blue-50/50 to-slate-50 dark:from-indigo-950/30 dark:via-blue-950/20 dark:to-stone-900 border border-indigo-200/80 dark:border-indigo-800/60 shadow-xs space-y-3">' +
                '<div class="flex items-center justify-between flex-wrap gap-2">' +
                    '<div class="flex items-center gap-2">' +
                        '<span class="relative flex h-3 w-3">' +
                            '<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>' +
                            '<span class="relative inline-flex rounded-full h-3 w-3 bg-indigo-600"></span>' +
                        '</span>' +
                        '<span class="text-[11px] font-black uppercase tracking-wider text-indigo-700 dark:text-indigo-400">Live Current Location & Station</span>' +
                    '</div>' +
                    '<span class="px-2.5 py-0.5 rounded-lg bg-indigo-100 dark:bg-indigo-500/20 text-indigo-800 dark:text-indigo-300 font-bold text-[10px]">' + escapeHtml(divisionName) + '</span>' +
                '</div>' +
                '<div class="flex flex-col md:flex-row md:items-center justify-between gap-3">' +
                    '<div>' +
                        '<h3 class="text-lg font-black text-slate-900 dark:text-white tracking-tight">' + escapeHtml(stageName) + '</h3>' +
                        '<p class="text-slate-500 dark:text-stone-400 text-xs">Assigned Responsibility: <strong>' + escapeHtml(assignedRole) + '</strong></p>' +
                        '<p class="text-slate-600 dark:text-stone-300 text-[11px] font-medium mt-0.5">' + escapeHtml(locationDesc) + '</p>' +
                    '</div>' +
                    '<div>' + handlerStatusHtml + '</div>' +
                '</div>' +
            '</div>';

            // 2. Stepper Progress Bar
            if (steps && steps.length > 0) {
                html += '<div class="space-y-3">' +
                    '<div class="flex items-center justify-between">' +
                        '<h4 class="font-extrabold text-slate-900 dark:text-white text-xs uppercase tracking-wider flex items-center gap-1.5">' +
                            '<i data-lucide="git-commit" class="w-4 h-4 text-indigo-600"></i>' +
                            '<span>Sequential Processing Stepper</span>' +
                        '</h4>' +
                        '<span class="text-[10px] text-slate-400 dark:text-stone-500 font-bold">' + steps.length + ' Stages</span>' +
                    '</div>' +
                    '<div class="p-4 rounded-2xl bg-slate-50 dark:bg-stone-950/60 border border-slate-200 dark:border-stone-800 overflow-x-auto">' +
                        '<div class="flex items-center min-w-max gap-4 px-2 py-3">';

                for (var i = 0; i < steps.length; i++) {
                    var s = steps[i];
                    var sState = s.state || s.State || 'pending';
                    var isCompleted = sState === 'completed' || sState === 1;
                    var isCurrent = sState === 'current' || sState === 2;
                    var isDef = sState === 'deferred';
                    var isAppr = sState === 'approval' || s.isApproval || s.IsApproval;

                    var circleClass = isCompleted 
                        ? 'bg-emerald-600 text-white shadow-sm'
                        : (isAppr ? 'bg-purple-600 text-white ring-4 ring-purple-500/30'
                        : (isDef ? 'bg-amber-600 text-white ring-4 ring-amber-500/30'
                        : (isCurrent ? 'bg-indigo-600 text-white ring-4 ring-indigo-500/30 animate-pulse' : 'bg-slate-200 dark:bg-stone-800 text-slate-500 dark:text-stone-400')));

                    var labelColor = isCompleted
                        ? 'text-emerald-700 dark:text-emerald-400 font-bold'
                        : (isAppr ? 'text-purple-700 dark:text-purple-400 font-black'
                        : (isDef ? 'text-amber-700 dark:text-amber-400 font-black'
                        : (isCurrent ? 'text-indigo-700 dark:text-indigo-400 font-black' : 'text-slate-400 dark:text-stone-500')));

                    var iconContent = isCompleted
                        ? '<i data-lucide="check" class="w-4 h-4"></i>'
                        : (isAppr && isCurrent ? '<i data-lucide="shield-alert" class="w-4 h-4"></i>'
                        : (isDef ? '<i data-lucide="rotate-ccw" class="w-4 h-4"></i>'
                        : (isCurrent ? '<i data-lucide="map-pin" class="w-4 h-4"></i>' : (s.stepId || s.StepId || (i + 1)))));

                    var sName = s.stepName || s.StepName || '';
                    var sRole = s.assignedRole || s.AssignedRole || '';
                    var isStepApproval = s.isApproval || s.IsApproval || false;

                    html += '<div class="flex items-center gap-3">' +
                        '<div class="flex flex-col items-center text-center w-28 space-y-1.5">' +
                            '<div class="w-8 h-8 rounded-full ' + circleClass + ' flex items-center justify-center font-black text-xs shrink-0">' +
                                iconContent +
                            '</div>' +
                            '<div class="text-[11px] font-bold ' + labelColor + ' line-clamp-2 leading-tight">' + escapeHtml(sName) + '</div>' +
                            '<div class="text-[9px] text-slate-400 dark:text-stone-500 font-medium truncate max-w-[100px]">' + escapeHtml(sRole) + '</div>' +
                            (isStepApproval ? '<span class="px-1.5 py-0.2 rounded text-[8px] font-black bg-purple-100 dark:bg-purple-500/20 text-purple-700 dark:text-purple-300">Approval Gate</span>' : '') +
                        '</div>';

                    if (i < steps.length - 1) {
                        var lineClass = isCompleted ? 'bg-emerald-500' : 'bg-slate-200 dark:bg-stone-800';
                        html += '<div class="w-8 h-0.5 ' + lineClass + ' -mt-6"></div>';
                    }

                    html += '</div>';
                }

                html += '</div></div></div>';
            }

            // 3. Metadata Info Grid (Reference / PIN field removed as requested)
            var orBadge = orNumber 
                ? '<span class="font-extrabold text-emerald-700 dark:text-emerald-400">#' + escapeHtml(orNumber) + '</span>' + (orDateIssued ? ' (' + escapeHtml(String(orDateIssued).substring(0, 10)) + ')' : '')
                : '<span class="text-amber-600 dark:text-amber-400 font-bold">Pending Receipt</span>';

            html += '<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-stone-950/60 border border-slate-200 dark:border-stone-800 text-[11px]">' +
                '<div>' +
                    '<div class="text-slate-400 dark:text-stone-500 font-bold uppercase text-[9px]">Owner / Applicant</div>' +
                    '<div class="font-extrabold text-slate-900 dark:text-white truncate" title="' + escapeHtml(owner) + '">' + escapeHtml(owner) + '</div>' +
                '</div>' +
                '<div>' +
                    '<div class="text-slate-400 dark:text-stone-500 font-bold uppercase text-[9px]">Official Receipt (O.R.)</div>' +
                    '<div>' + orBadge + '</div>' +
                '</div>' +
                '<div>' +
                    '<div class="text-slate-400 dark:text-stone-500 font-bold uppercase text-[9px]">Date Intake / Filed</div>' +
                    '<div class="font-bold text-slate-900 dark:text-white">' + (dateSubmitted ? new Date(dateSubmitted).toLocaleDateString() : 'N/A') + '</div>' +
                '</div>' +
            '</div>';

            // 4. Chronological Routing Activity Log
            html += '<div class="space-y-3">' +
                '<h4 class="font-extrabold text-slate-900 dark:text-white text-xs uppercase tracking-wider flex items-center gap-1.5">' +
                    '<i data-lucide="history" class="w-4 h-4 text-indigo-600"></i>' +
                    '<span>Chronological Routing History</span>' +
                '</h4>';

            if (!events || events.length === 0) {
                html += '<div class="p-6 text-center text-slate-400 dark:text-stone-500 bg-slate-50 dark:bg-stone-950/60 rounded-2xl border border-slate-200 dark:border-stone-800 italic">No routing activity logged yet. Transaction is in initial intake station.</div>';
            } else {
                html += '<div class="relative pl-6 space-y-4 border-l-2 border-indigo-200 dark:border-indigo-900/60 ml-3">';

                for (var j = 0; j < events.length; j++) {
                    var ev = events[j];
                    var evTs = ev.timestamp || ev.Timestamp;
                    var evDate = evTs ? new Date(evTs).toLocaleString() : '';
                    var fromName = ev.fromStageName || ev.FromStageName || 'Start';
                    var toName = ev.toStageName || ev.ToStageName || 'Next';
                    var actTaken = ev.actionTaken || ev.ActionTaken || 'Forwarded';
                    var fwdBy = ev.forwardedByName || ev.ForwardedByName || 'Staff';
                    var targetRole = ev.assignedToRole || ev.AssignedToRole;
                    var handlerUser = ev.assignedUserName || ev.AssignedUserName;
                    var evOr = ev.orNumber || ev.ORNumber;
                    var evOrDate = ev.orDateIssued || ev.ORDateIssued;
                    var evRemarks = ev.remarks || ev.Remarks;

                    html += '<div class="relative group">' +
                        '<div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-white dark:bg-stone-900 border-2 border-indigo-600 flex items-center justify-center">' +
                            '<div class="w-1.5 h-1.5 rounded-full bg-indigo-600"></div>' +
                        '</div>' +
                        '<div class="p-4 rounded-2xl bg-white dark:bg-stone-900/90 border border-slate-200 dark:border-stone-800 shadow-xs space-y-2">' +
                            '<div class="flex items-center justify-between flex-wrap gap-2">' +
                                '<div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5 text-xs">' +
                                    '<span>' + escapeHtml(fromName) + '</span>' +
                                    '<i data-lucide="arrow-right" class="w-3.5 h-3.5 text-indigo-500"></i>' +
                                    '<span class="text-indigo-600 dark:text-indigo-400 font-black">' + escapeHtml(toName) + '</span>' +
                                '</div>' +
                                '<span class="text-[10px] text-slate-400 dark:text-stone-500">' + evDate + '</span>' +
                            '</div>' +
                            '<div class="text-[11px] text-slate-600 dark:text-stone-300 flex items-center gap-2 flex-wrap">' +
                                '<span>Action: <strong>' + escapeHtml(actTaken) + '</strong></span>' +
                                '<span>•</span>' +
                                '<span>By: <strong>' + escapeHtml(fwdBy) + '</strong></span>' +
                                (targetRole ? '<span>•</span><span>Target: <strong>' + escapeHtml(targetRole) + '</strong></span>' : '') +
                                (handlerUser ? '<span>•</span><span class="text-blue-600 dark:text-blue-400 font-bold">Claimed: ' + escapeHtml(handlerUser) + '</span>' : '') +
                            '</div>';

                    if (evOr) {
                        html += '<div class="text-[10px] text-emerald-700 dark:text-emerald-400 font-bold flex items-center gap-1">' +
                            '<i data-lucide="receipt" class="w-3 h-3"></i>' +
                            '<span>O.R. #' + escapeHtml(evOr) + ' (Issued: ' + escapeHtml(evOrDate ? String(evOrDate).substring(0, 10) : 'N/A') + ')</span>' +
                        '</div>';
                    }

                    if (evRemarks) {
                        html += '<div class="p-2.5 rounded-xl bg-slate-50 dark:bg-stone-950/70 border border-slate-200 dark:border-stone-800 text-[11px] text-slate-700 dark:text-stone-300 italic">' +
                            '"' + escapeHtml(evRemarks) + '"' +
                        '</div>';
                    }

                    html += '</div></div>';
                }

                html += '</div>';
            }

            html += '</div>';

            body.innerHTML = html;
        }

        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function updateToggleBtnText() {
            var isDark = document.documentElement.classList.contains('dark');
            var textElem = document.getElementById('themeToggleText');
            if (textElem) {
                textElem.innerText = isDark ? 'Light' : 'Dark';
            }
            var statusElem = document.getElementById('themeStatusText');
            if (statusElem) {
                statusElem.innerText = isDark ? 'Dark Mode (Active)' : 'Light Mode (Active)';
            }
            var badgeElem = document.getElementById('themeBadge');
            if (badgeElem) {
                badgeElem.innerText = isDark ? 'Dark' : 'Light';
            }
            if (window.lucide) {
                lucide.createIcons();
            }
        }

        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
            updateToggleBtnText();
        }

        updateToggleBtnText();
    </script>
</body>
</html>