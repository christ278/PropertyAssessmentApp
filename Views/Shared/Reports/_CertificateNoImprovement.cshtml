@model PropertyAssessmentApp.Models.CertificateNoImprovementModel

<div class="certificate-no-improvement space-y-6 font-serif text-slate-950 text-xs sm:text-sm">
    <!-- 1. Government Letterhead with Official Seal -->
    <div class="text-center space-y-0.5">
        <div class="text-[11px] sm:text-xs text-slate-700">@Model.HeaderCountry</div>
        <div class="text-[11px] sm:text-xs text-slate-700">@Model.HeaderProvince</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 uppercase">@Model.HeaderLguName</div>
    </div>

    <!-- Banner: Transparent Seal on Left, OFFICE OF THE CITY ASSESSOR Dead-Centered -->
    <div class="relative py-2 flex items-center justify-center">
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center">
            <img src="/images/koronadal_seal.png" alt="City of Koronadal Official Seal" class="w-full h-full object-contain" />
        </div>
        <div class="text-center w-full max-w-lg px-16">
            <h1 class="text-lg sm:text-2xl font-black text-rose-700 uppercase tracking-wide">@Model.HeaderOfficeTitle</h1>
            <div class="h-0.5 bg-rose-600 mt-1 mx-auto w-full"></div>
        </div>
    </div>

    <!-- 2. Document Title -->
    <div class="text-center pt-3 pb-1">
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 uppercase tracking-wide inline-block">
            @Model.DocumentTitle
        </h2>
    </div>

    <!-- 3. Salutation -->
    <div class="pt-2">
        <span class="font-extrabold text-sm sm:text-base uppercase tracking-wider block">@Model.Salutation</span>
    </div>

    <!-- 4. Narrative Certification Body -->
    <div class="space-y-4 text-justify leading-relaxed text-xs sm:text-[13px]">
        <p class="indent-10">
            THIS IS TO CERTIFY that as shown by the records of this office <strong class="font-bold">@Model.OwnerName</strong> , is the registered owner of an/a <strong class="font-bold">@Model.PropertyKindOrUse</strong> land identified as Lot <strong class="font-bold">@Model.LotNo</strong> , <strong class="font-bold">@Model.AreaDisplay</strong> situated at <strong class="font-bold">@Model.LocationDisplay</strong>, and said property is declared for taxation purposes under ARP NO. <strong class="font-bold">@Model.ArpNo</strong> of this city.
        </p>
        <p class="indent-10">
            This certifies further that the said Lot <strong class="font-bold">@Model.LotNo</strong> has no structural improvement existing thereon as per tax mapping record.
        </p>
        <p class="text-[11px] text-slate-600 italic">
            Note: Any discrepancy between the actual location Tax Maps and Technical Description is subject to correction.
        </p>
    </div>

    <!-- 5. Requestor Section -->
    <div class="pt-2 space-y-2 text-xs sm:text-[13px]">
        <div class="font-bold">This certification is issued Upon the request of</div>
        <div class="space-y-2 pt-1 font-mono">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <span class="w-20 font-serif">Name</span>
                <span class="flex-1 border-b border-slate-900 pb-0.5 font-bold uppercase">@(string.IsNullOrWhiteSpace(Model.RequestorName) ? "\u00A0" : Model.RequestorName)</span>
                <span class="w-12 font-serif sm:pl-4">TIN</span>
                <span class="w-48 border-b border-slate-900 pb-0.5">@(string.IsNullOrWhiteSpace(Model.RequestorTin) ? "\u00A0" : Model.RequestorTin)</span>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <span class="w-20 font-serif">Address</span>
                <span class="flex-1 border-b border-slate-900 pb-0.5 uppercase">@(string.IsNullOrWhiteSpace(Model.RequestorAddress) ? "\u00A0" : Model.RequestorAddress)</span>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <span class="w-20 font-serif">Purpose</span>
                <span class="flex-1 border-b border-slate-900 pb-0.5 uppercase">@(string.IsNullOrWhiteSpace(Model.Purpose) ? "\u00A0" : Model.Purpose)</span>
            </div>
        </div>
    </div>

    <!-- 6. Date of Issuance -->
    <div class="pt-2 text-xs sm:text-[13px]">
        Done this @Model.IssueDay day of @Model.IssueMonth, '@Model.IssueYear at @Model.IssueLocation.
    </div>

    <!-- 7. Dual / Triple Official Signatories -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-6">
        <!-- Left: Verified as per records -->
        <div class="space-y-1">
            <div class="text-xs text-slate-700">@Model.ClerkSignatory.SectionTitle</div>
            <div class="pt-8">
                <div class="font-bold uppercase underline text-xs sm:text-[13px]">@Model.ClerkSignatory.Name</div>
                <div class="text-[11px] text-slate-600">@Model.ClerkSignatory.Designation</div>
            </div>
        </div>

        <!-- Right: Noted By City Assessor & Acting Records Officer -->
        <div class="space-y-6">
            <div class="space-y-1">
                <div class="text-xs text-slate-700">@Model.AssessorSignatory.SectionTitle</div>
                <div class="pt-8">
                    <div class="font-bold uppercase underline text-xs sm:text-[13px]">@Model.AssessorSignatory.Name</div>
                    <div class="text-[11px] text-slate-600">@Model.AssessorSignatory.Designation</div>
                </div>
            </div>

            <div class="space-y-1 pt-2">
                <div class="text-[11px] text-slate-600 italic">@Model.RecordsOfficerSignatory.SectionTitle</div>
                <div class="pt-4">
                    <div class="font-bold uppercase underline text-xs sm:text-[13px]">@Model.RecordsOfficerSignatory.Name</div>
                    <div class="text-[11px] text-slate-600">@Model.RecordsOfficerSignatory.Designation</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 8. Metadata (Bottom-Right Fee Box) -->
    <div class="flex justify-end pt-4">
        <div class="w-56 text-xs space-y-1 font-mono">
            <div class="flex justify-between border-b border-slate-400 pb-0.5">
                <span class="font-serif">CERT . FEE :</span>
                <span class="font-bold">P@(Model.CertFee.ToString("N2"))</span>
            </div>
            <div class="flex justify-between border-b border-slate-400 pb-0.5">
                <span class="font-serif">O.R NO :</span>
                <span class="font-bold">@Model.ORNumber</span>
            </div>
            <div class="flex justify-between border-b border-slate-400 pb-0.5">
                <span class="font-serif">DATE :</span>
                <span>@Model.ORDate</span>
            </div>
            <div class="text-[10px] text-slate-600 italic pt-1">
                @Model.DocStampFeeDisplay
            </div>
        </div>
    </div>

    <!-- 9. Bottom Control Code & Printed By -->
    <div class="flex items-center justify-between text-xs pt-8 border-t border-slate-200">
        <div class="font-mono font-bold text-sm text-slate-800">
            @Model.ControlNumber
        </div>
        <div class="text-slate-600 text-[11px] font-bold">
            Printed By: @Model.PrintedBy
        </div>
    </div>
</div>
