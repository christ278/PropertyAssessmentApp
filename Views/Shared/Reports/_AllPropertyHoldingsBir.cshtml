@model PropertyAssessmentApp.Models.AllPropertyHoldingsBirModel

<div class="all-property-holdings-bir space-y-5 font-serif text-slate-950 text-xs sm:text-sm">
    <!-- 1. Government Letterhead with Official Seal -->
    <div class="text-center space-y-0.5">
        <div class="text-[11px] sm:text-xs text-slate-700">@Model.HeaderCountry</div>
        <div class="text-[11px] sm:text-xs text-slate-700">@Model.HeaderProvince</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 uppercase">@Model.HeaderLguName</div>
    </div>

    <!-- Banner: Transparent Seal on Left, OFFICE OF THE CITY ASSESSOR Dead-Centered -->
    <div class="relative py-2 flex items-center justify-center">
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center">
            <img src="/images/koronadal_seal.png" alt="City of Koronadal Official Seal" class="w-full h-full object-contain" />
        </div>
        <div class="text-center w-full max-w-lg px-16">
            <h1 class="text-lg sm:text-2xl font-black text-rose-700 uppercase tracking-wide">@Model.HeaderOfficeTitle</h1>
            <div class="h-0.5 bg-rose-600 mt-1 mx-auto w-full"></div>
        </div>
    </div>

    <!-- 2. Document Title -->
    <div class="text-center pt-2 pb-1">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-wide inline-block">
            @Model.DocumentTitle
        </h2>
    </div>

    <!-- 3. Salutation -->
    <div class="pt-1">
        <span class="font-extrabold text-sm sm:text-base uppercase tracking-wider block">@Model.Salutation</span>
    </div>

    <!-- 4. Narrative Certification Body -->
    <div class="pt-1 text-justify leading-relaxed text-xs sm:text-[13px]">
        <p class="indent-10">
            THIS IS TO CERTIFY that according to the records of this office, this/these is/are the total REAL PROPERTIES / LANDHOLDING registered in the name/joint names of <strong class="font-bold uppercase">@Model.OwnerNames</strong> within the City of Koronadal, Province of South Cotabato.
        </p>
    </div>

    <!-- 5. Real Property Holdings Table (9 Columns) -->
    <div class="pt-1 overflow-x-auto">
        <table class="w-full border-collapse border border-slate-700 text-center text-xs">
            <thead>
                <tr class="bg-slate-100 font-bold text-[11px] uppercase tracking-tight">
                    <th class="border border-slate-700 px-2 py-1.5 w-24">TDN</th>
                    <th class="border border-slate-700 px-1.5 py-1.5 w-16">Kind</th>
                    <th class="border border-slate-700 px-2 py-1.5">Location</th>
                    <th class="border border-slate-700 px-2 py-1.5">Lot Number</th>
                    <th class="border border-slate-700 px-2 py-1.5 w-20">Area</th>
                    <th class="border border-slate-700 px-2 py-1.5 w-24">Title<br />Number</th>
                    <th class="border border-slate-700 px-2 py-1.5 w-20">Market<br />Value</th>
                    <th class="border border-slate-700 px-2 py-1.5 w-20">Assessed<br />Value</th>
                    <th class="border border-slate-700 px-1.5 py-1.5 w-14">Year<br />COMM.</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Holdings != null && Model.Holdings.Any())
                {
                    foreach (var item in Model.Holdings)
                    {
                        <tr class="text-[11px]">
                            <td class="border border-slate-700 px-2 py-1 font-mono">@item.Tdn</td>
                            <td class="border border-slate-700 px-1.5 py-1 uppercase font-semibold">@item.Kind</td>
                            <td class="border border-slate-700 px-2 py-1 uppercase font-semibold">@item.Location</td>
                            <td class="border border-slate-700 px-2 py-1">@item.LotNumber</td>
                            <td class="border border-slate-700 px-2 py-1">@item.Area</td>
                            <td class="border border-slate-700 px-2 py-1 font-mono text-[10px]">@item.TitleNumber</td>
                            <td class="border border-slate-700 px-2 py-1 text-right font-mono">@item.MarketValue.ToString("N2")</td>
                            <td class="border border-slate-700 px-2 py-1 text-right font-mono">@item.AssessedValue.ToString("N2")</td>
                            <td class="border border-slate-700 px-1.5 py-1 font-mono">@item.YearComm</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 6. Requestor Section -->
    <div class="pt-3 space-y-2 text-xs sm:text-[13px]">
        <div>This certification is issued upon the request of</div>
        <div class="space-y-2 pt-1 font-mono">
            <div class="flex flex-col sm:flex-row sm:items-center">
                <span class="w-24 font-serif">Name</span>
                <span class="w-6 font-serif text-center">:</span>
                <span class="flex-1 font-bold uppercase">@Model.RequestorName</span>
                <span class="w-16 font-serif sm:pl-4">TIN</span>
                <span class="w-44">@Model.RequestorTin</span>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center">
                <span class="w-24 font-serif">Address</span>
                <span class="w-6 font-serif text-center">:</span>
                <span class="flex-1 uppercase">@Model.RequestorAddress</span>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center">
                <span class="w-24 font-serif">Purpose</span>
                <span class="w-6 font-serif text-center">:</span>
                <span class="flex-1 uppercase">@Model.Purpose</span>
            </div>
        </div>
    </div>

    <!-- 7. Date of Issuance -->
    <div class="pt-3 text-xs sm:text-[13px]">
        <p class="indent-10">
            Done this @Model.IssueDay day of @Model.IssueMonth, '@Model.IssueYear at the @Model.IssueLocation.
        </p>
    </div>

    <!-- 8. Dual / Triple Official Signatories -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-5">
        <!-- Left: Verified as per records -->
        <div class="space-y-1">
            <div class="text-xs text-slate-700">@Model.ClerkSignatory.SectionTitle</div>
            <div class="pt-8">
                <div class="font-bold uppercase underline text-xs sm:text-[13px]">@Model.ClerkSignatory.Name</div>
                <div class="text-[11px] text-slate-600">@Model.ClerkSignatory.Designation</div>
            </div>
        </div>

        <!-- Right: Noted By City Assessor & Acting Records Officer -->
        <div class="space-y-6">
            <div class="space-y-1">
                <div class="text-xs text-slate-700">@Model.AssessorSignatory.SectionTitle</div>
                <div class="pt-8">
                    <div class="font-bold uppercase underline text-xs sm:text-[13px]">@Model.AssessorSignatory.Name</div>
                    <div class="text-[11px] text-slate-600">@Model.AssessorSignatory.Designation</div>
                </div>
            </div>

            <div class="space-y-1 pt-2">
                <div class="text-[11px] text-slate-600 italic">@Model.RecordsOfficerSignatory.SectionTitle</div>
                <div class="pt-4">
                    <div class="font-bold uppercase underline text-xs sm:text-[13px]">@Model.RecordsOfficerSignatory.Name</div>
                    <div class="text-[11px] text-slate-600">@Model.RecordsOfficerSignatory.Designation</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 9. Metadata (Bottom-Right Fee Box) -->
    <div class="flex justify-end pt-4">
        <div class="w-56 text-xs space-y-1 font-mono">
            <div class="flex justify-between border-b border-slate-400 pb-0.5">
                <span class="font-serif">CERT FEE :</span>
                <span class="font-bold">P@(Model.CertFee.ToString("N2"))</span>
            </div>
            <div class="flex justify-between border-b border-slate-400 pb-0.5">
                <span class="font-serif">O.R. NO :</span>
                <span class="font-bold">@Model.ORNumber</span>
            </div>
            <div class="flex justify-between border-b border-slate-400 pb-0.5">
                <span class="font-serif">DATE :</span>
                <span>@Model.ORDate</span>
            </div>
            <div class="text-[10px] text-slate-600 italic pt-1">
                @Model.DocStampFeeDisplay
            </div>
        </div>
    </div>

    <!-- 10. Bottom Control Code & Printed By & Page -->
    <div class="flex items-center justify-between text-xs pt-6 border-t border-slate-200">
        <div class="font-mono font-bold text-sm text-slate-800">
            @Model.ControlNumber
        </div>
        <div class="text-slate-600 text-[11px] font-bold">
            Printed By: @Model.PrintedBy
        </div>
        <div class="text-slate-600 text-[10px]">
            @Model.PageDisplay
        </div>
    </div>
</div>
