@model PropertyAssessmentApp.Models.ReportHeaderModel

<div class="report-header-component space-y-3">
    <!-- Center Letterhead Typography -->
    <div class="text-center space-y-0.5">
        <div class="text-[11px] sm:text-xs font-serif text-slate-700 tracking-wide">@Model.Country</div>
        <div class="text-[11px] sm:text-xs font-serif text-slate-700 tracking-wide">@Model.Province</div>
        <div class="text-xs sm:text-sm font-semibold font-serif text-slate-900 uppercase tracking-wide">@Model.LguName</div>
    </div>

    <!-- Banner: Transparent Seal on Left, OFFICE OF THE CITY ASSESSOR Dead-Centered -->
    <div class="relative py-2 flex items-center justify-center">
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center">
            <img src="/images/koronadal_seal.png" alt="City of Koronadal Official Seal" class="w-full h-full object-contain" />
        </div>
        <div class="text-center w-full max-w-lg px-16">
            <h1 class="text-lg sm:text-2xl font-black text-rose-700 uppercase tracking-wide font-serif">@Model.OfficeTitle</h1>
            <div class="h-0.5 bg-rose-600 mt-1 mx-auto w-full"></div>
        </div>
    </div>

    <!-- Centered Document Title -->
    <div class="text-center pt-2 pb-1">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900 uppercase tracking-wider inline-block">
            @Model.DocumentTitle
        </h2>
    </div>

    <!-- Certification Narrative Intro Statement -->
    <div class="text-slate-900 font-serif text-sm leading-relaxed text-justify pt-1">
        <p>
            @Model.IntroStatement
        </p>
    </div>
</div>
