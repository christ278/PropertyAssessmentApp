@model PropertyAssessmentApp.Models.ReportHeaderModel

<div class="report-header-component space-y-4">
    <!-- Letterhead top row with Circular Seal & Text -->
    <div class="flex items-center justify-center gap-6 relative">
        <!-- Official Seal Emblem on Left -->
        <div class="absolute left-0 top-0">
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full border-2 border-emerald-700 p-0.5 flex items-center justify-center bg-white shadow-xs">
                <div class="w-full h-full rounded-full border border-amber-500 bg-gradient-to-b from-emerald-50 to-white flex flex-col items-center justify-center text-center p-1 relative overflow-hidden">
                    <span class="text-[7px] font-black uppercase tracking-tight text-emerald-900 leading-tight block">City of Koronadal</span>
                    <span class="text-sm my-0.5">🏛️</span>
                    <span class="text-[6px] font-bold uppercase tracking-wider text-amber-700 block">Official Seal</span>
                </div>
            </div>
        </div>

        <!-- Center Letterhead Typography -->
        <div class="text-center space-y-0.5">
            <div class="text-[11px] sm:text-xs font-serif text-slate-700 tracking-wide">@Model.Country</div>
            <div class="text-[11px] sm:text-xs font-serif text-slate-700 tracking-wide">@Model.Province</div>
            <div class="text-xs sm:text-sm font-bold font-serif text-slate-900 uppercase tracking-wide">@Model.LguName</div>
            <div class="text-lg sm:text-xl font-black font-serif text-rose-700 tracking-wide uppercase pt-1">
                @Model.OfficeTitle
            </div>
        </div>
    </div>

    <!-- Centered Document Title -->
    <div class="text-center pt-4 pb-2">
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-900 uppercase tracking-wider inline-block">
            @Model.DocumentTitle
        </h2>
    </div>

    <!-- Certification Narrative Intro Statement -->
    <div class="text-slate-900 font-serif text-sm leading-relaxed text-justify pt-1">
        <p>
            @Model.IntroStatement
        </p>
    </div>
</div>
