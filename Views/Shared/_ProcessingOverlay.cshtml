
    <!-- ========================================================================= -->
    <!-- REAL PROPERTY TAX & ASSESSOR CONCEPT SPINNER & PROCESSING OVERLAY         -->
    <!-- ========================================================================= -->
    <div id="appProcessingOverlay" class="fixed inset-0 z-[99999] hidden opacity-0 flex items-center justify-center bg-slate-950/70 backdrop-blur-md transition-all duration-300">
        <div class="relative w-full max-w-md mx-4 p-8 rounded-3xl bg-white/95 dark:bg-stone-900/95 border border-emerald-500/30 dark:border-emerald-500/30 shadow-2xl rpt-pulse-glow text-center space-y-6">
            
            <!-- Real Property Tax Assessor Themed Animated Emblem -->
            <div class="relative w-28 h-28 mx-auto flex items-center justify-center">
                <!-- Outer Spinning Gauge Ring -->
                <div class="absolute inset-0 rpt-spinner-ring"></div>
                <!-- Inner Dashed Cadastral Perimeter Ring -->
                <div class="absolute inset-2 rpt-spinner-inner"></div>
                <!-- Core Assessor Seal Emblem -->
                <div class="relative z-10 w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 text-white flex items-center justify-center shadow-lg rpt-seal-pulse">
                    <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <!-- Building & Land Real Property Graphic -->
                        <rect x="4" y="3" width="16" height="18" rx="2" />
                        <path d="M8 7h.01M12 7h.01M16 7h.01M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01" stroke-width="2.5" />
                        <path d="M10 21v-3a2 2 0 0 1 4 0v3" />
                    </svg>
                </div>
                <!-- Currency / Tax Cadastral Badge -->
                <div class="absolute -bottom-1 -right-1 z-20 w-8 h-8 rounded-full bg-gold-500 text-slate-950 font-black text-xs flex items-center justify-center border-2 border-white dark:border-stone-900 shadow-md">
                    ₱
                </div>
            </div>

            <!-- Title & Concept Description -->
            <div class="space-y-2">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700/60">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                    <span>City Assessor Processing</span>
                </div>
                <h3 id="appProcessingTitle" class="text-lg font-black text-slate-900 dark:text-white tracking-tight">
                    Processing Real Property Record...
                </h3>
                <p id="appProcessingSubtitle" class="text-xs text-slate-500 dark:text-stone-400">
                    Updating FAAS Appraisal, Assessment Levels, and Local Tax Dues
                </p>
            </div>

            <!-- Real Property Action Stepper Ticker -->
            <div class="p-3 rounded-2xl bg-slate-50 dark:bg-stone-950/80 border border-slate-200 dark:border-stone-800 text-[11px] font-medium text-emerald-700 dark:text-emerald-400 flex items-center justify-center gap-2">
                <svg class="w-4 h-4 animate-spin text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span id="appProcessingStep" class="truncate font-semibold">Verifying Land & Structure Registry...</span>
            </div>

            <!-- Secure Cadastral Audit Footer Note -->
            <div class="text-[10px] text-slate-400 dark:text-stone-500 italic">
                Local Government Code R.A. 7160 &bull; Office of the City Assessor
            </div>

            <!-- Manual dismiss failsafe -->
            <div class="pt-1">
                <button type="button" onclick="if(window.RptSpinner) window.RptSpinner.hide();" class="text-[11px] text-slate-400 hover:text-slate-600 dark:hover:text-stone-300 underline cursor-pointer transition-colors">
                    Click here to dismiss if this takes longer than expected
                </button>
            </div>
        </div>
    </div>
