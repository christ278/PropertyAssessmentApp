@section Scripts {
<script>
    const activeTabKey = '@tab';

    function closeModals() {
        document.querySelectorAll('[id^="modal-"]').forEach(m => m.classList.add('hidden'));
    }

    function openModalForActiveTab() {
        closeModals();
        if (activeTabKey === 'classification') {
            document.getElementById('clsModalTitle').innerText = 'Add Classification';
            document.getElementById('clsId').value = '0';
            document.getElementById('clsCode').value = '';
            document.getElementById('clsName').value = '';
            document.getElementById('clsPrefix').value = '';
            document.getElementById('clsRanking').value = '';
            document.getElementById('clsSort').value = '1';
            document.getElementById('clsActive').checked = true;
        } else if (activeTabKey === 'subclass') {
            document.getElementById('subModalTitle').innerText = 'Add Sub-Classification';
            document.getElementById('subId').value = '0';
            document.getElementById('subName').value = '';
            document.getElementById('subUnitVal').value = '';
            document.getElementById('subYear').value = '2011';
            document.getElementById('subActive').checked = true;
        } else if (activeTabKey === 'actualuse') {
            document.getElementById('auModalTitle').innerText = 'Add Actual Use';
            document.getElementById('auId').value = '0';
            document.getElementById('auCode').value = '';
            document.getElementById('auName').value = '';
            document.getElementById('auRank').value = '';
            document.getElementById('auExempt').checked = false;
            document.getElementById('auActive').checked = true;
        } else if (activeTabKey === 'assessmentlevel') {
            document.getElementById('alModalTitle').innerText = 'Add Assessment Level';
            document.getElementById('alId').value = '0';
            document.getElementById('alActualUseId').value = '';
            document.getElementById('alActualUseName').value = '';
            document.getElementById('alLevel').value = '';
            document.getElementById('alYear').value = '2011';
            document.getElementById('alActive').checked = true;
        } else if (activeTabKey === 'adjustment') {
            document.getElementById('adjModalTitle').innerText = 'Add Adjustment Factor';
            document.getElementById('adjId').value = '0';
            document.getElementById('adjDesc').value = '';
            document.getElementById('adjDist').value = '';
            document.getElementById('adjPct').value = '';
            document.getElementById('adjYear').value = '2011';
            document.getElementById('adjActive').checked = true;
        } else if (activeTabKey === 'improvement') {
            document.getElementById('impModalTitle').innerText = 'Add Improvement Type';
            document.getElementById('impId').value = '0';
            document.getElementById('impCode').value = '';
            document.getElementById('impKind').value = 'FRUIT BEARING';
            document.getElementById('impDesc').value = '';
            document.getElementById('impBaseVal').value = '50.00';
            document.getElementById('impLevel').value = '40.00';
            document.getElementById('impYear').value = '2011';
            document.getElementById('impActive').checked = true;
        }
        const modal = document.getElementById('modal-' + activeTabKey);
        if (modal) modal.classList.remove('hidden');
    }

