@model IEnumerable<PropertyAssessmentApp.Models.TaxMappingRequest>
@using PropertyAssessmentApp.Models
@inject PropertyAssessmentApp.Services.IPermissionService PermissionService

@{
    ViewData["Title"] = "Tax Mapping Requests";
    var search = ViewBag.Search as string ?? "";
    bool canAccess = PermissionService.CanAccess(User, "TaxMapping");
}

<div class="space-y-8">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="map-pin" class="w-4 h-4"></i>
                <span>GIS & Spatial Tax Mapping Section</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Tax Mapping Requests</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Manage parcel subdivisions, lot consolidations, boundary verifications, and map file attachments.</p>
        </div>

        @if (canAccess)
        {
            <a asp-action="Create" class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold text-xs font-mono flex items-center gap-2 shadow-md shadow-emerald-600/20 transition-all">
                <i data-lucide="file-plus" class="w-4 h-4"></i>
                New Tax Mapping Request
            </a>
        }
    </div>

    <!-- Summary Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 space-y-1 shadow-sm sinsilyo-card-light">
            <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-slate-500 dark:text-stone-400 font-bold uppercase">Total Mapping Requests</span>
                <i data-lucide="layers" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
            </div>
            <div class="text-2xl font-black font-mono text-slate-900 dark:text-white">@ViewBag.TotalCount</div>
            <span class="text-[10px] font-mono text-emerald-700 dark:text-emerald-400 font-bold">GIS Spatial Records</span>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 space-y-1 shadow-sm sinsilyo-card-light">
            <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-slate-500 dark:text-stone-400 font-bold uppercase">Pending Verification</span>
                <i data-lucide="clock" class="w-4 h-4 text-amber-600 dark:text-amber-400"></i>
            </div>
            <div class="text-2xl font-black font-mono text-amber-600 dark:text-amber-400">@ViewBag.PendingCount</div>
            <span class="text-[10px] font-mono text-slate-400 dark:text-stone-500">Under Review / Survey</span>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 space-y-1 shadow-sm sinsilyo-card-light border-l-4 border-l-emerald-600">
            <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold uppercase">Approved Tax Maps</span>
                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
            </div>
            <div class="text-2xl font-black font-mono text-emerald-700 dark:text-emerald-400">@ViewBag.ApprovedCount</div>
            <span class="text-[10px] font-mono text-slate-500 dark:text-stone-500">Official Section Maps</span>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <form method="get" asp-action="Index" class="flex flex-wrap items-center justify-between gap-4 bg-white dark:bg-stone-900 p-4 rounded-2xl border border-slate-200 dark:border-stone-800 shadow-sm font-mono text-xs">
        <div class="flex items-center gap-2 flex-1 min-w-[240px]">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-stone-400"></i>
            <input type="text" name="search" value="@search" placeholder="Search request no., applicant name, PIN, TD No., or Barangay..." class="w-full bg-slate-50 dark:bg-stone-950 px-4 py-2 rounded-xl border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600">
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2 bg-slate-50 dark:bg-stone-800 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 shadow-xs shrink-0">
                <span class="limit-label text-[10px] text-slate-500 dark:text-emerald-400 font-extrabold uppercase">Limit:</span>
                <select class="table-limit-select bg-transparent font-extrabold text-slate-900 dark:text-white focus:outline-none cursor-pointer">
                    <option value="5" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">5</option>
                    <option value="10" selected class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">10</option>
                    <option value="25" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">25</option>
                    <option value="50" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">50</option>
                    <option value="100" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">100</option>
                </select>
            </div>

            <select name="status" asp-items="Html.GetEnumSelectList<RequestStatus>()" class="bg-slate-50 dark:bg-stone-950 text-slate-900 dark:text-white px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-800">
                <option value="">All Statuses</option>
            </select>

            <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold">Filter</button>
            <a asp-action="Index" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-300 hover:text-slate-900 dark:hover:text-white"><i data-lucide="rotate-ccw" class="w-4 h-4"></i></a>
        </div>
    </form>

    <!-- Request Directory Table -->
    <div class="bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-sm paginated-table-card">
        <div class="overflow-x-auto min-h-[260px] pb-4 rounded-3xl">
            <table class="w-full text-left text-xs font-mono">
                <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 font-bold">
                    <tr>
                        <th class="px-3 sm:px-4 py-3.5">REQUEST REF NO</th>
                        <th class="px-3 sm:px-4 py-3.5">APPLICANT & PIN NO</th>
                        <th class="hidden md:table-cell px-4 py-3.5">PARCEL AREA (SQM)</th>
                        <th class="hidden lg:table-cell px-4 py-3.5">LOCATION (BARANGAY)</th>
                        <th class="hidden xl:table-cell px-4 py-3.5">ATTACHMENT FILE</th>
                        <th class="px-2 sm:px-4 py-3.5 text-center">STATUS</th>
                        <th class="px-2 sm:px-4 py-3.5 text-center">ACTION</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-stone-800/60">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-8 text-slate-400 dark:text-stone-500">
                                <i data-lucide="map" class="w-8 h-8 mx-auto mb-2 text-slate-300 dark:text-stone-600"></i>
                                No tax mapping requests found matching the search criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-stone-800/50 transition-all">
                                <td class="px-3 sm:px-4 py-3.5">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="font-bold text-slate-900 dark:text-white hover:text-emerald-700 dark:hover:text-emerald-400 font-mono text-sm block">
                                        @item.RequestNumber
                                    </a>
                                    <span class="text-[10px] text-slate-400 dark:text-stone-500 block">Date: @item.RequestDate.ToString("MMM dd, yyyy")</span>
                                    <div class="md:hidden mt-1 text-[10px] text-emerald-700 dark:text-emerald-400 font-bold">
                                        @item.ParcelAreaSqm.ToString("N0") sqm
                                    </div>
                                </td>
                                <td class="px-3 sm:px-4 py-3.5">
                                    <div class="font-bold text-slate-800 dark:text-stone-200">@item.ApplicantName</div>
                                    <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-bold block">PIN: @item.PropertyIndexNumber</span>
                                    <div class="lg:hidden text-[10px] text-slate-500 dark:text-stone-400 mt-0.5">
                                        @item.BarangayName
                                    </div>
                                </td>
                                <td class="hidden md:table-cell px-4 py-3.5">
                                    <div class="text-xs font-bold text-slate-900 dark:text-white font-mono">@item.ParcelAreaSqm.ToString("N2") sqm</div>
                                </td>
                                <td class="hidden lg:table-cell px-4 py-3.5 text-slate-700 dark:text-stone-300">
                                    <div class="font-bold text-slate-800 dark:text-stone-200">@item.BarangayName</div>
                                    <span class="text-[10px] text-slate-500 dark:text-stone-500 block truncate max-w-[150px]">@item.StreetAddress</span>
                                </td>
                                <td class="hidden xl:table-cell px-4 py-3.5">
                                    @if (!string.IsNullOrEmpty(item.AttachmentFileName))
                                    {
                                        <a asp-action="DownloadAttachment" asp-route-id="@item.Id" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-500/20 dark:hover:bg-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-[10px] font-bold border border-emerald-200 dark:border-transparent">
                                            <i data-lucide="paperclip" class="w-3 h-3"></i>
                                            <span class="truncate max-w-[120px]">@item.AttachmentFileName</span>
                                        </a>
                                        <span class="text-[9px] text-slate-400 dark:text-stone-500 block mt-0.5">@item.AttachmentFileSize</span>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-slate-400 dark:text-stone-500 italic">No file attached</span>
                                    }
                                </td>
                                <td class="px-2 sm:px-4 py-3.5 text-center">
                                    @switch (item.Status)
                                    {
                                        case RequestStatus.Approved:
                                            <span class="px-2.5 py-1 rounded-lg bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/40 text-[10px] font-bold uppercase">Approved</span>
                                            break;
                                        case RequestStatus.Pending:
                                            <span class="px-2.5 py-1 rounded-lg bg-amber-100 dark:bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-500/40 text-[10px] font-bold uppercase">Pending</span>
                                            break;
                                        case RequestStatus.UnderReview:
                                            <span class="px-2.5 py-1 rounded-lg bg-blue-100 dark:bg-blue-500/20 text-blue-800 dark:text-blue-300 border border-blue-300 dark:border-blue-500/40 text-[10px] font-bold uppercase">Under Review</span>
                                            break;
                                        default:
                                            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 text-[10px] font-bold uppercase">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="px-4 py-3.5 text-center relative">
                                    @if (canAccess)
                                    {
                                        <div class="flex items-center justify-center gap-1.5">
                                            <button type="button" onclick="openTimelineModal('@item.Id', '@item.RequestNumber')" class="px-2.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-500/10 dark:hover:bg-indigo-500/20 text-indigo-700 dark:text-indigo-300 font-bold text-[10px] flex items-center gap-1 border border-indigo-200 dark:border-indigo-800/60 shadow-2xs transition-all" title="Track Live Status & Timeline">
                                                <i data-lucide="route" class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400"></i>
                                                <span>Track Timeline</span>
                                            </button>

                                            <div class="relative inline-block text-left">
                                                <button type="button" onclick="toggleKebabMenu(event, 'kebab-tm-@item.Id')" class="p-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 border border-slate-200 dark:border-stone-700 transition-colors focus:outline-none" title="More Actions">
                                                    <i data-lucide="more-vertical" class="w-4 h-4"></i>
                                                </button>

                                                <div id="kebab-tm-@item.Id" class="kebab-dropdown hidden absolute right-0 mt-2 w-48 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-xl z-50 overflow-hidden divide-y divide-slate-100 dark:divide-stone-800/80 text-xs font-mono text-left">
                                                    <div class="py-1">
                                                        <a asp-action="Details" asp-route-id="@item.Id" class="flex items-center gap-2.5 px-3.5 py-2 text-slate-700 dark:text-stone-300 hover:bg-emerald-50 dark:hover:bg-stone-800 font-bold">
                                                            <i data-lucide="file-text" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                                                            View Details
                                                        </a>
                                                        <button type="button" onclick="openTimelineModal('@item.Id', '@item.RequestNumber')" class="w-full flex items-center gap-2.5 px-3.5 py-2 text-indigo-700 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-stone-800 font-bold text-left">
                                                            <i data-lucide="route" class="w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400"></i>
                                                            Track Timeline
                                                        </button>
                                                        <a asp-action="Edit" asp-route-id="@item.Id" class="flex items-center gap-2.5 px-3.5 py-2 text-slate-700 dark:text-stone-300 hover:bg-emerald-50 dark:hover:bg-stone-800 font-bold">
                                                            <i data-lucide="edit-3" class="w-3.5 h-3.5 text-teal-600 dark:text-teal-400"></i>
                                                            Edit Request
                                                        </a>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(item.AttachmentFileName))
                                                    {
                                                        <div class="py-1">
                                                            <a asp-action="DownloadAttachment" asp-route-id="@item.Id" class="flex items-center gap-2.5 px-3.5 py-2 text-blue-700 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-stone-800 font-bold">
                                                                <i data-lucide="download" class="w-3.5 h-3.5 text-blue-600"></i>
                                                                Download Attachment
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-mono text-slate-400 italic">No access</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="table-pagination-footer p-4 sm:p-6 pt-4 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-200 dark:border-stone-800 text-xs font-mono">
            <div class="text-slate-500 dark:text-stone-400 text-center sm:text-left">
                Showing <span class="font-bold text-slate-900 dark:text-white table-showing-start">1</span> to 
                <span class="font-bold text-slate-900 dark:text-white table-showing-end">10</span> of 
                <span class="font-bold text-slate-900 dark:text-white table-total-count">@Model.Count()</span> entries
            </div>
            <div class="flex items-center gap-1.5 flex-wrap justify-center table-pagination-buttons">
            </div>
        </div>
    </div>
</div>
