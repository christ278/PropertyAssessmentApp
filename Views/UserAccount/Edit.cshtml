@model PropertyAssessmentApp.Models.UserAccount
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = $"Edit User - {Model.Username}";
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="edit" class="w-4 h-4"></i>
                <span>Edit Access Credentials</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Edit Account: @Model.FullName</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Update username, reset password, employee details, or account access status.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Back
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PasswordHash" />
            <input type="hidden" asp-for="CreatedDate" />
            <input type="hidden" asp-for="LastLoginDate" />
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-800 dark:text-rose-300"></div>

            <!-- Step 1: Login Credentials & Password Security -->
            <div class="space-y-4">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase">1. Login Credentials & Password Security</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Username" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="Username" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" />
                        <span asp-validation-for="Username" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                    </div>
                    <div>
                        <label asp-for="Password" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">RESET PASSWORD (OPTIONAL)</label>
                        <input asp-for="Password" type="password" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono focus:outline-none focus:border-emerald-600" placeholder="Leave blank to keep current hash" />
                        <span class="text-[9px] text-slate-400 dark:text-stone-500 font-bold block mt-1">🔒 Will be re-hashed securely using PBKDF2</span>
                    </div>
                    <div>
                        <label asp-for="EmployeeNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="EmployeeNo" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" />
                        <span asp-validation-for="EmployeeNo" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                    </div>
                </div>
            </div>

            <!-- Step 2: Personal Details -->
            <div class="space-y-4">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase">2. Staff Profile & Contact Info</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="FullName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="FullName" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" />
                        <span asp-validation-for="FullName" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                    </div>
                    <div>
                        <label asp-for="Email" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="Email" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" />
                        <span asp-validation-for="Email" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="ContactNo" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                    <div>
                        <label asp-for="Department" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="Department" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                    </div>
                </div>
            </div>

            <!-- Step 3: Position, Division & Workflow Role Assignment -->
            <div class="space-y-4">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase">3. Position, Division & Workflow Role Assignment</h3>
                    <span class="text-[10px] text-emerald-600 font-bold flex items-center gap-1">
                        <i data-lucide="git-commit" class="w-3.5 h-3.5"></i>
                        Synced with Transaction Workflow Manager
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Field 1: User Position (formerly User Role) -->
                    <div>
                        <label asp-for="Role" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold uppercase tracking-wider">
                            User Position *
                        </label>
                        <select asp-for="Role" id="userPositionSelect" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold text-xs focus:outline-none focus:border-emerald-600" asp-items="Html.GetEnumSelectList<UserRole>()"></select>
                        <span class="text-[10px] text-slate-400 dark:text-stone-500 font-bold block mt-1">Official job title / appointment</span>
                    </div>

                    <!-- Field 2: Division -->
                    <div>
                        <label asp-for="DivisionId" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold uppercase tracking-wider">
                            Division *
                        </label>
                        <select asp-for="DivisionId" id="divisionSelect" onchange="onDivisionChanged()" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold text-xs focus:outline-none focus:border-emerald-600">
                            <option value="">-- Select Office Division --</option>
                            <option value="1">Division 1: Appraisal and Assessment</option>
                            <option value="2">Division 2: Tax Mapping</option>
                            <option value="3">Division 3: Records</option>
                        </select>
                        <span class="text-[10px] text-slate-400 dark:text-stone-500 font-bold block mt-1">Filters allowed workflow steps</span>
                    </div>

                    <!-- Field 3: User Role (Workflow Step) -->
                    <div>
                        <label asp-for="WorkflowRoleId" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold uppercase tracking-wider">
                            User Role *
                        </label>
                        <select asp-for="WorkflowRoleId" id="workflowRoleSelect" onchange="onWorkflowRoleChanged()" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold text-xs focus:outline-none focus:border-emerald-600">
                            <option value="">-- Select Workflow Step --</option>
                        </select>
                        <input type="hidden" asp-for="WorkflowRoleName" id="workflowRoleNameHidden" />
                        <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-bold block mt-1">⚡ Equivalent to step in Transaction Workflow Manager</span>
                    </div>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t border-slate-200 dark:border-stone-800">
                <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsActive" type="checkbox" class="w-5 h-5 rounded border-slate-300 dark:border-stone-700 text-emerald-600 focus:ring-emerald-500">
                    <span class="text-slate-700 dark:text-stone-300 font-bold">Active Account Status (Uncheck to Inactivate / Soft-Delete)</span>
                </label>

                <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
                    <a asp-action="Index" class="w-full sm:w-auto text-center px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold">Cancel</a>
                    <button type="submit" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold uppercase tracking-wider shadow-sm">
                        Update User Account
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const allWorkflowStatuses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AllWorkflowStatuses ?? new List<TransactionStatus>()));
        const initialDivisionId = @Html.Raw(Model.DivisionId.HasValue ? Model.DivisionId.Value.ToString() : "null");
        const initialWorkflowRoleId = @Html.Raw(Model.WorkflowRoleId.HasValue ? Model.WorkflowRoleId.Value.ToString() : "null");

        function formatStatusName(name) {
            if (!name) return "";
            const map = {
                "checkAndReview": "Check and Review",
                "Reploting": "Replotting",
                "RecommendingAndApproved": "Recommending Approval",
                "ValuationAndExamination": "Valuation & Examination",
                "Verify": "Verification",
                "Release": "Releasing"
            };
            if (map[name]) return map[name];
            return name.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/_/g, ' ').trim();
        }

        function populateWorkflowRoles(divisionId, selectedRoleId) {
            const select = document.getElementById('workflowRoleSelect');
            if (!select) return;

            select.innerHTML = '<option value="">-- Select Workflow Step --</option>';

            let filtered = allWorkflowStatuses;
            if (divisionId && parseInt(divisionId, 10) > 0) {
                filtered = allWorkflowStatuses.filter(s => s.DivisionId === parseInt(divisionId, 10));
            }

            filtered.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s.TransactionStatusId;
                opt.text = `Step ${s.TransactionStatusId}: ${formatStatusName(s.Name)}`;
                if (selectedRoleId && parseInt(selectedRoleId, 10) === s.TransactionStatusId) {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });

            onWorkflowRoleChanged();
        }

        function onDivisionChanged() {
            const divSelect = document.getElementById('divisionSelect');
            const divisionId = divSelect ? divSelect.value : null;
            populateWorkflowRoles(divisionId, null);
        }

        function onWorkflowRoleChanged() {
            const roleSelect = document.getElementById('workflowRoleSelect');
            const hidden = document.getElementById('workflowRoleNameHidden');
            if (roleSelect && hidden) {
                if (roleSelect.selectedIndex > 0) {
                    const text = roleSelect.options[roleSelect.selectedIndex].text;
                    hidden.value = text.replace(/^Step\s+\d+:\s*/i, '');
                } else {
                    hidden.value = "";
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (initialDivisionId) {
                document.getElementById('divisionSelect').value = initialDivisionId;
                populateWorkflowRoles(initialDivisionId, initialWorkflowRoleId);
            } else {
                populateWorkflowRoles(null, initialWorkflowRoleId);
            }
        });
    </script>
}
