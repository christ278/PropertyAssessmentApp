@model PropertyAssessmentApp.Models.RequestForInspection
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = "New Request for Inspection (RFI)";
    var properties = ViewBag.Properties as IEnumerable<TaxDeclaration> ?? new List<TaxDeclaration>();
    var orderPayments = ViewBag.OrderPayments as IEnumerable<OrderPayment> ?? new List<OrderPayment>();
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="clipboard-check" class="w-4 h-4"></i>
                <span>Field Appraisal & Property Inspection</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">File Request for Inspection</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Encode site inspection requests for depreciation adjustments, reassessments, or physical changes.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="inspectionForm" class="space-y-8">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RequestedDocumentsJson" id="RequestedDocumentsJson" />
            <input type="hidden" asp-for="TotalFeesAmount" id="TotalFeesAmount" />
            <div asp-validation-summary="All" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-800 dark:text-rose-300 font-sans font-bold"></div>

            <!-- Tracking & Status Badge Header -->
            <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <span class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-extrabold text-xs font-mono">
                        TRACKING NO: @Model.TrackingNumber
                    </span>
                    <span class="text-slate-500 dark:text-stone-400 text-[11px]">Auto-generated system reference</span>
                </div>
                <input type="hidden" asp-for="TrackingNumber" />
                <input type="hidden" asp-for="TransactionCode" />
                <input type="hidden" asp-for="TransactionNo" />
                <input type="hidden" asp-for="Status" />
            </div>

            <!-- Step 1: Real Property Search & Owner Auto-Fill -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-3 flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="search" class="w-4 h-4 text-emerald-600"></i>
                            1. Select Registered Property from Assessment Records
                        </h3>
                        <p class="text-slate-500 dark:text-stone-400 text-[11px] mt-0.5">Select existing property to auto-fill TDN, PIN, Declared Owner, and Location.</p>
                    </div>
                </div>

                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SEARCH & SELECT PROPERTY</label>
                    <select id="propertySelect" asp-for="TaxDeclarationId" class="w-full">
                        <option value="">-- Choose Property from Assessment Records --</option>
                        @foreach (var p in properties)
                        {
                            <option value="@p.Id" data-tdn="@p.TaxDeclarationNumber" data-pin="@p.PropertyIndexNumber" data-owner="@p.OwnerName" data-kind="@p.Kind" data-location="@p.CompleteAddress">
                                @p.TaxDeclarationNumber - @p.OwnerName (@p.PropertyIndexNumber) [@p.Kind]
                            </option>
                        }
                    </select>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                    <div>
                        <label asp-for="TaxDeclarationNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TDN / ARP NO. *</label>
                        <input asp-for="TaxDeclarationNumber" id="tdNoInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" placeholder="TD-2026-GS-0001" required />
                        <span asp-validation-for="TaxDeclarationNumber" class="text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="PropertyIndexNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PIN / PROPERTY INDEX NO. *</label>
                        <input asp-for="PropertyIndexNumber" id="pinInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" placeholder="126-00-0000" required />
                        <span asp-validation-for="PropertyIndexNumber" class="text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="OwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DECLARED OWNER *</label>
                        <input asp-for="OwnerName" id="ownerNameInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" placeholder="Owner / Declarant Name" required />
                        <span asp-validation-for="OwnerName" class="text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Kind" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY KIND</label>
                        <select asp-for="Kind" id="kindInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600">
                            <option value="Land">Land</option>
                            <option value="Building">Building</option>
                            <option value="Machinery">Machinery</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="LotNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT NO. / SURVEY NO.</label>
                        <input asp-for="LotNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Lot 12, Blk 4" />
                    </div>
                    <div>
                        <label asp-for="PropertyLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOCATION ADDRESS</label>
                        <input asp-for="PropertyLocation" id="locationInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Street, Barangay, City" />
                    </div>
                </div>
            </div>

            <!-- Step 2: Inspection Reasons / Purpose (Matching CAST) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="check-square" class="w-4 h-4 text-emerald-600"></i>
                        2. Purpose of Inspection (Select Applicable)
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="IsDepreciation" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">DEPRECIATION</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="IsReassessment" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">REASSESSMENT</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="IsCancelled" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CANCELLATION</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="IsOther" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">OTHER REASONS</span>
                    </label>
                </div>

                <div>
                    <label asp-for="OtherPurposeDetails" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SPECIFIC PURPOSE DETAILS</label>
                    <input asp-for="OtherPurposeDetails" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Provide notes on the requested field inspection or physical change..." />
                </div>
            </div>

            <!-- Step 3: Contact & Representative Information -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="user" class="w-4 h-4 text-emerald-600"></i>
                        3. Contact & Representative Details
                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label asp-for="ContactPerson" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONTACT PERSON</label>
                        <input asp-for="ContactPerson" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Contact Name" />
                    </div>
                    <div>
                        <label asp-for="ContactNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MOBILE / PHONE NO.</label>
                        <input asp-for="ContactNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono focus:outline-none focus:border-emerald-600" placeholder="0917-000-0000" />
                    </div>
                    <div>
                        <label asp-for="EmailAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EMAIL ADDRESS</label>
                        <input asp-for="EmailAddress" type="email" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="email@domain.com" />
                    </div>
                    <div>
                        <label asp-for="Representative" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REPRESENTATIVE NAME</label>
                        <input asp-for="Representative" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Authorized Representative" />
                    </div>
                </div>
            </div>

            <!-- Step 4: Attachment Upload (Routed to Inspection Storage ~/UploadFile/Inspection) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="paperclip" class="w-4 h-4 text-emerald-600"></i>
                        4. Upload Inspection Plan / Site Sketch (PDF, PNG, JPG)
                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                        <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ATTACHMENT FILE</label>
                        <input type="file" name="fileUpload" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-mono file:font-bold file:bg-emerald-600 file:text-white" />
                        <p class="text-[10px] text-slate-400 mt-1">Saved to CAST inspection file location: <code class="text-emerald-600 font-bold">~/UploadFile/Inspection</code></p>
                    </div>
                    <div>
                        <label asp-for="ORNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">O.R. NUMBER</label>
                        <input asp-for="ORNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono focus:outline-none focus:border-emerald-600" placeholder="OR-2026-XXXX" />
                    </div>
                </div>
            </div>

            <!-- Step 5: Document To Be Requested Table (Order of Payment Rates) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="calculator" class="w-4 h-4 text-emerald-600"></i>
                            5. Order of Payment & Fee Computation
                        </h3>
                        <p class="text-slate-500 dark:text-stone-400 text-[11px] mt-0.5">Select inspection fees and particulars to compute total billing amount.</p>
                    </div>

                    <button type="button" id="btnAddRow" class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center gap-1.5 text-xs font-mono shadow-sm">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        Add Fee Particular
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[500px] text-left text-xs font-mono" id="feesTable">
                        <thead class="bg-slate-200/60 dark:bg-stone-900 text-slate-700 dark:text-stone-300 font-bold border-b border-slate-300 dark:border-stone-800">
                            <tr>
                                <th class="px-3 py-2.5 w-12 text-center">ACTION</th>
                                <th class="px-3 py-2.5">PARTICULAR (ORDER OF PAYMENT)</th>
                                <th class="px-3 py-2.5 w-32 text-right">FEES (₱)</th>
                                <th class="px-3 py-2.5 w-32 text-center">QUANTITY</th>
                                <th class="px-3 py-2.5 w-36 text-right">TOTAL (₱)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-stone-800" id="feesTableBody">
                            <!-- Dynamic rows -->
                        </tbody>
                    </table>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-stone-800">
                    <span class="text-sm font-extrabold text-slate-900 dark:text-white uppercase font-mono">Total Inspection Fees:</span>
                    <div class="text-xl font-black font-mono text-emerald-700 dark:text-emerald-400 bg-white dark:bg-stone-900 px-6 py-2 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm">
                        ₱ <span id="lblOverallTotal">0.00</span>
                    </div>
                </div>
            </div>

            <!-- Submit Button Footer -->
            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <a asp-action="Index" class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-all">
                    Cancel
                </a>
                <button type="submit" class="w-full sm:w-auto text-center px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Submit Request for Inspection
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const availableParticulars = [
            @foreach (var op in orderPayments)
            {
                @: { code: "@op.Code", name: "@op.Particular", fee: @op.UnitCost },
            }
        ];

        let TomSelectProperty = null;

        document.addEventListener('DOMContentLoaded', function () {
            if (document.getElementById('propertySelect')) {
                TomSelectProperty = new TomSelect('#propertySelect', {
                    create: false,
                    placeholder: 'Search property by TDN, Owner Name, or PIN...',
                    onChange: function(val) {
                        if (val) {
                            const sel = document.getElementById('propertySelect');
                            const opt = sel.options[sel.selectedIndex];
                            if (opt) {
                                document.getElementById('tdNoInput').value = opt.getAttribute('data-tdn') || '';
                                document.getElementById('pinInput').value = opt.getAttribute('data-pin') || '';
                                document.getElementById('ownerNameInput').value = opt.getAttribute('data-owner') || '';
                                document.getElementById('kindInput').value = opt.getAttribute('data-kind') || 'Land';
                                document.getElementById('locationInput').value = opt.getAttribute('data-location') || '';
                            }
                        }
                    }
                });
            }

            addRow();
            document.getElementById('btnAddRow').addEventListener('click', addRow);

            var form = document.getElementById('inspectionForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var isValid = true;
                    var firstInvalid = null;

                    document.querySelectorAll('.border-rose-500').forEach(function(el) {
                        el.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                    });

                    var reqFields = [
                        { el: document.getElementById('tdNoInput'), name: 'Tax Declaration No. (TDN)' },
                        { el: document.getElementById('pinInput'), name: 'Property Index No. (PIN)' },
                        { el: document.getElementById('ownerNameInput'), name: 'Owner / Taxpayer Name' }
                    ];

                    reqFields.forEach(function (f) {
                        if (f.el && (!f.el.value || !f.el.value.trim())) {
                            isValid = false;
                            f.el.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/30');
                            if (!firstInvalid) firstInvalid = f.el;
                        }
                    });

                    var totalFees = parseFloat(document.getElementById('TotalFeesAmount').value) || 0;
                    var docJson = document.getElementById('RequestedDocumentsJson').value;
                    var hasDocs = false;
                    try {
                        var parsed = JSON.parse(docJson || '[]');
                        hasDocs = parsed && parsed.length > 0;
                    } catch(ex) { hasDocs = false; }

                    var feesTable = document.getElementById('feesTable');
                    if (!hasDocs || totalFees <= 0) {
                        isValid = false;
                        if (feesTable) feesTable.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/30');
                        if (!firstInvalid) firstInvalid = document.getElementById('btnAddRow');
                    } else if (feesTable) {
                        feesTable.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                    }

                    if (!isValid) {
                        e.preventDefault();
                        if (firstInvalid) {
                            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstInvalid.focus();
                        }
                        toastr.warning('Please fill in TDN, PIN, Owner Name and select at least one document fee.', 'Validation Notice');
                        return false;
                    }
                });
            }

            document.addEventListener('input', function(e) {
                if (e.target && e.target.classList.contains('border-rose-500')) {
                    e.target.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                }
            });
        });

        function addRow() {
            const tbody = document.getElementById('feesTableBody');
            const rowCount = tbody.rows.length;
            const tr = document.createElement('tr');
            tr.className = "hover:bg-slate-100/50 dark:hover:bg-stone-900/50 transition-colors";

            let optionsHtml = '<option value="">-- Select Particular --</option>';
            availableParticulars.forEach((p, idx) => {
                optionsHtml += `<option value="${idx}">${p.code} - ${p.name} (₱${p.fee.toFixed(2)})</option>`;
            });

            tr.innerHTML = `
                <td class="px-3 py-2.5 text-center">
                    <button type="button" class="btn-remove p-1 text-rose-600 hover:text-rose-800 transition-colors">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </td>
                <td class="px-3 py-2.5">
                    <select class="particular-select w-full px-3 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-300 dark:border-stone-700 text-slate-800 dark:text-stone-200">
                        ${optionsHtml}
                    </select>
                </td>
                <td class="px-3 py-2.5 text-right font-mono fee-amount">0.00</td>
                <td class="px-3 py-2.5 text-center">
                    <input type="number" min="1" value="1" class="qty-input w-20 px-2 py-1 rounded-lg text-center bg-white dark:bg-stone-900 border border-slate-300 dark:border-stone-700 text-slate-800 dark:text-stone-200 font-mono" />
                </td>
                <td class="px-3 py-2.5 text-right font-mono font-bold text-emerald-700 dark:text-emerald-400 line-total">0.00</td>
            `;

            tbody.appendChild(tr);
            lucide.createIcons();
            attachRowEvents(tr);
            recalculateGrandTotal();
        }

        function attachRowEvents(row) {
            const sel = row.querySelector('.particular-select');
            const qty = row.querySelector('.qty-input');
            const btnRemove = row.querySelector('.btn-remove');

            sel.addEventListener('change', function () {
                const idx = this.value;
                const feeCell = row.querySelector('.fee-amount');
                if (idx !== "") {
                    const fee = availableParticulars[idx].fee;
                    feeCell.textContent = fee.toFixed(2);
                } else {
                    feeCell.textContent = "0.00";
                }
                updateLineTotal(row);
            });

            qty.addEventListener('input', function () {
                updateLineTotal(row);
            });

            btnRemove.addEventListener('click', function () {
                const tbody = document.getElementById('feesTableBody');
                if (tbody.rows.length > 1) {
                    row.remove();
                    recalculateGrandTotal();
                } else {
                    alert("At least one fee row is required.");
                }
            });
        }

        function updateLineTotal(row) {
            const fee = parseFloat(row.querySelector('.fee-amount').textContent) || 0;
            const qty = parseInt(row.querySelector('.qty-input').value) || 0;
            const lineTotal = fee * qty;
            row.querySelector('.line-total').textContent = lineTotal.toFixed(2);
            recalculateGrandTotal();
        }

        function recalculateGrandTotal() {
            let grandTotal = 0;
            const rows = document.querySelectorAll('#feesTableBody tr');
            const items = [];

            rows.forEach(r => {
                const sel = r.querySelector('.particular-select');
                const idx = sel.value;
                const qty = parseInt(r.querySelector('.qty-input').value) || 0;
                const fee = parseFloat(r.querySelector('.fee-amount').textContent) || 0;
                const total = fee * qty;

                if (idx !== "") {
                    grandTotal += total;
                    items.push({
                        ParticularCode: availableParticulars[idx].code,
                        ParticularName: availableParticulars[idx].name,
                        UnitCost: fee,
                        Quantity: qty,
                        TotalCost: total
                    });
                }
            });

            document.getElementById('lblOverallTotal').textContent = grandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('TotalFeesAmount').value = grandTotal.toFixed(2);
            document.getElementById('RequestedDocumentsJson').value = JSON.stringify(items);
        }
    </script>
}
