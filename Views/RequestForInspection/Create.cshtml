        // -------------------------------------------------------------
        // Form Validation (Request for Inspection)
        // -------------------------------------------------------------
        const RFI_LIMITS = {
            tdn: 50,
            pin: 50,
            owner: 150,
            lotNo: 100,
            location: 250,
            purposeDetails: 500,
            contactPerson: 150,
            contactNumber: 20,
            email: 100,
            representative: 150,
            qtyMax: 999
        };
        const RFI_ALLOWED_KINDS = ['Land', 'Building', 'Machinery'];
        const RFI_CODE_PATTERN = /^[A-Za-z0-9\-\/\.\s]+$/;
        const RFI_PERSON_NAME_PATTERN = /^[\p{L}\s.,'\-]+$/u;
        const RFI_PHONE_PATTERN = /^(\+63|0)?\d{7,10}$/;
        const RFI_EMAIL_PATTERN = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
        const RFI_ERROR_CLASSES = ['border-rose-500', 'ring-2', 'ring-rose-500/30'];

        function normalizeTdnForComparison(tdn) {
            if (!tdn) return '';
            return String(tdn)
                .trim()
                .toUpperCase()
                .replace(/[\s\-_]+/g, '-')
                .replace(/-(LAND|BLDG|BUILDING|MACH|MACHINERY|IMP|IMPROVEMENT)-/gi, '-')
                .replace(/-(LAND|BLDG|BUILDING|MACH|MACHINERY|IMP|IMPROVEMENT)$/gi, '')
                .replace(/^(LAND|BLDG|BUILDING|MACH|MACHINERY|IMP|IMPROVEMENT)-/gi, '');
        }

        function extractTdnSequence(tdn) {
            if (!tdn) return '';
            const m = String(tdn).match(/(\d{3,})/g);
            return m && m.length > 0 ? m[m.length - 1] : '';
        }

        function normalizePinForComparison(pin) {
            if (!pin) return '';
            const clean = String(pin).trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (clean === 'NA' || clean === 'NONE' || /^0+$/.test(clean)) return '';
            return clean;
        }

        function normalizeOwnerForComparison(owner) {
            if (!owner) return '';
            return String(owner).trim().toUpperCase().replace(/[\s.,'-]+/g, '');
        }

        function arePropertiesSameTaxDeclaration(a, b) {
            if (!a || !b) return false;
            if (a.id && b.id && String(a.id) === String(b.id)) return true;

            const tdnA = String(a.tdn || '').trim().toUpperCase();
            const tdnB = String(b.tdn || '').trim().toUpperCase();
            if (tdnA && tdnB && tdnA === tdnB) return true;

            const normA = normalizeTdnForComparison(tdnA);
            const normB = normalizeTdnForComparison(tdnB);
            if (normA && normB && normA === normB) return true;

            const pinA = normalizePinForComparison(a.pin);
            const pinB = normalizePinForComparison(b.pin);
            if (pinA && pinB && pinA.length >= 6 && pinA === pinB) return true;

            const seqA = extractTdnSequence(tdnA);
            const seqB = extractTdnSequence(tdnB);
            const ownerA = normalizeOwnerForComparison(a.owner);
            const ownerB = normalizeOwnerForComparison(b.owner);
            if (seqA && seqB && seqA === seqB && ownerA && ownerB && ownerA === ownerB) return true;

            return false;
        }

        function getFieldErrorSpan(el) {
            if (!el) return null;
            const key = el.id || el.name;
            let span = document.querySelector(`.js-field-error[data-for="${key}"]`);
            if (!span) {
                span = document.createElement('span');
                span.className = 'js-field-error text-rose-500 font-bold block mt-1 text-[11px]';
                span.setAttribute('data-for', key);
                el.insertAdjacentElement('afterend', span);
            }
            return span;
        }

        function setFieldError(el, message) {
            if (!el) return;
            el.classList.add(...RFI_ERROR_CLASSES);
            const span = getFieldErrorSpan(el);
            if (span) span.textContent = message;
        }

        function clearFieldError(el) {
            if (!el) return;
            el.classList.remove(...RFI_ERROR_CLASSES);
            const key = el.id || el.name;
            const span = document.querySelector(`.js-field-error[data-for="${key}"]`);
            if (span) span.textContent = '';
        }

        function setGroupError(spanId, message, highlightEl) {
            const span = document.getElementById(spanId);
            if (span) span.textContent = message || '';
            if (highlightEl) {
                if (message) highlightEl.classList.add(...RFI_ERROR_CLASSES, 'rounded-xl');
                else highlightEl.classList.remove(...RFI_ERROR_CLASSES);
            }
        }

        function syncOtherPurposeRequirement() {
            const isOther = document.getElementById('IsOther');
            const mark = document.getElementById('otherPurposeRequiredMark');
            if (mark) mark.classList.toggle('hidden', !(isOther && isOther.checked));
        }

        /**
         * Validates a required text field with max length and optional pattern.
         * Returns an error message or null.
         */
        function checkTextField(el, label, maxLen, opts) {
            opts = opts || {};
            if (!el) return null;
            const val = (el.value || '').trim();
            if (!val) return opts.optional ? null : `${label} is required.`;
            if (/^n\/?a$/i.test(val) && !opts.allowNA) return `${label} is required (N/A is not accepted).`;
            if (val.length > maxLen) return `${label} must not exceed ${maxLen} characters (currently ${val.length}).`;
            if (opts.pattern && !opts.pattern.test(opts.normalize ? opts.normalize(val) : val)) return opts.patternMessage || `${label} has an invalid format.`;
            return null;
        }

        function validateInspectionForm() {
            let errorCount = 0;
            let firstInvalid = null;
            const flag = (el, msg, focusEl) => {
                errorCount++;
                if (el) setFieldError(el, msg);
                if (!firstInvalid) firstInvalid = focusEl || el;
            };

            // Reset previous error states
            document.querySelectorAll('#inspectionForm .border-rose-500').forEach(el => el.classList.remove(...RFI_ERROR_CLASSES));
            document.querySelectorAll('#inspectionForm .js-field-error').forEach(s => s.textContent = '');
            ['refPropertyValidation', 'purposeValidation', 'feesValidation'].forEach(id => setGroupError(id, null));

            // ---- 1. Reference Tax Declaration (at least one, no duplicate / same TD) ----
            const refWrapper = TomSelectRefProperty ? TomSelectRefProperty.wrapper : document.getElementById('refPropertySelect');
            const refIds = (selectedPropertyIds || []).filter(Boolean);
            const currentTxCode = (document.getElementById('txCodeSelect')?.value || '').trim().toUpperCase();
            if (refIds.length === 0) {
                if (currentTxCode !== 'DC') {
                    errorCount++;
                    setGroupError('refPropertyValidation', 'Please search and select at least one Reference Tax Declaration (TD).', refWrapper);
                    if (!firstInvalid) firstInvalid = TomSelectRefProperty ? TomSelectRefProperty.control_input : refWrapper;
                }
            } else {
                let duplicatePair = null;
                for (let i = 0; i < refIds.length; i++) {
                    const p1 = referencePropertiesData[refIds[i]];
                    for (let j = i + 1; j < refIds.length; j++) {
                        const p2 = referencePropertiesData[refIds[j]];
                        if (p1 && p2 && arePropertiesSameTaxDeclaration(p1, p2)) {
                            duplicatePair = { p1, p2 };
                            break;
                        }
                    }
                    if (duplicatePair) break;
                }

                if (duplicatePair) {
                    errorCount++;
                    const msg = `Cannot select same Tax Declaration: "${duplicatePair.p1.tdn}" and "${duplicatePair.p2.tdn}" belong to the same TD / property. Please remove duplicate TD.`;
                    setGroupError('refPropertyValidation', msg, refWrapper);
                    if (!firstInvalid) firstInvalid = refWrapper;
                } else if ((document.getElementById('txCodeSelect')?.value || '').trim().toUpperCase() === 'CS') {
                    if (refIds.length < 2) {
                        errorCount++;
                        setGroupError('refPropertyValidation', 'Consolidation (CS) · Lot Integration requires selecting at least 2 contiguous reference parcels.', refWrapper);
                        if (!firstInvalid) firstInvalid = refWrapper;
                    } else {
                        let firstOwner = null;
                        let diffOwner = false;
                        for (let id of refIds) {
                            const p = referencePropertiesData[id];
                            if (p && p.owner) {
                                const cleanOwner = p.owner.trim().toLowerCase();
                                if (!firstOwner) firstOwner = cleanOwner;
                                else if (firstOwner !== cleanOwner) { diffOwner = true; break; }
                            }
                        }
                        if (diffOwner) {
                            errorCount++;
                            setGroupError('refPropertyValidation', 'Consolidation (CS) requires identical ownership. All selected contiguous parcels must belong to the same registered owner.', refWrapper);
                            if (!firstInvalid) firstInvalid = refWrapper;
                        }
                    }
                }
            }

            // ---- Property Identification fields ----
            const tdEl = document.getElementById('tdNoInput');
            let msg = checkTextField(tdEl, 'TDN / ARP No.', RFI_LIMITS.tdn, { pattern: RFI_CODE_PATTERN, patternMessage: 'TDN / ARP No. may only contain letters, numbers, dashes (-), slashes (/) and periods (.).' });
            if (msg) flag(tdEl, msg);

            const pinEl = document.getElementById('pinInput');
            msg = checkTextField(pinEl, 'PIN / Property Index No.', RFI_LIMITS.pin, { pattern: RFI_CODE_PATTERN, patternMessage: 'PIN may only contain letters, numbers, dashes (-), slashes (/) and periods (.).' });
            if (msg) flag(pinEl, msg);

            const ownerEl = document.getElementById('ownerNameInput');
            msg = checkTextField(ownerEl, 'Declared Owner', RFI_LIMITS.owner);
            if (msg) flag(ownerEl, msg);

            const kindEl = document.getElementById('kindInput');
            if (kindEl && !RFI_ALLOWED_KINDS.includes(kindEl.value)) flag(kindEl, 'Property Kind is required (Land, Building, or Machinery).');

            const lotEl = document.getElementById('lotNoInput');
            msg = checkTextField(lotEl, 'Lot No. / Survey No.', RFI_LIMITS.lotNo);
            if (msg) flag(lotEl, msg);

            const locEl = document.getElementById('locationInput');
            msg = checkTextField(locEl, 'Location Address', RFI_LIMITS.location);
            if (msg) flag(locEl, msg);

            // ---- 2. Purpose of Inspection ----
            const purposeGroup = document.getElementById('purposeCheckboxGroup');
            const purposeChecks = ['IsDepreciation', 'IsReassessment', 'IsCancelled', 'IsOther'].map(id => document.getElementById(id));
            if (!purposeChecks.some(c => c && c.checked)) {
                if (currentTxCode === 'DC') {
                    const isOtherChk = document.getElementById('IsOther');
                    const detailsInput = document.getElementById('OtherPurposeDetails');
                    if (isOtherChk) isOtherChk.checked = true;
                    if (detailsInput && !detailsInput.value.trim()) {
                        detailsInput.value = 'Discovery / New Declaration (DC) · Original Assessment under Sec. 222 RA 7160';
                    }
                } else {
                    errorCount++;
                    setGroupError('purposeValidation', 'Please select at least one Purpose of Inspection.', purposeGroup);
                    if (!firstInvalid) firstInvalid = purposeGroup;
                }
            }
            const isOtherEl = document.getElementById('IsOther');
            const detailsEl = document.getElementById('OtherPurposeDetails');
            msg = checkTextField(detailsEl, 'Specific Purpose Details', RFI_LIMITS.purposeDetails, { optional: !(isOtherEl && isOtherEl.checked) });
            if (msg) flag(detailsEl, isOtherEl && isOtherEl.checked && !(detailsEl.value || '').trim() ? 'Specific Purpose Details is required when "Other Reasons" is selected.' : msg);

            // ---- 3. Contact & Representative Details ----
            const cpEl = document.getElementById('ContactPerson');
            msg = checkTextField(cpEl, 'Contact Person', RFI_LIMITS.contactPerson, { pattern: RFI_PERSON_NAME_PATTERN, patternMessage: 'Contact Person may only contain letters, spaces, periods, commas, apostrophes and dashes.' });
            if (msg) flag(cpEl, msg);

            const phoneEl = document.getElementById('ContactNumber');
            msg = checkTextField(phoneEl, 'Mobile / Phone No.', RFI_LIMITS.contactNumber, {
                pattern: RFI_PHONE_PATTERN,
                normalize: v => v.replace(/[\s\-\(\)]/g, ''),
                patternMessage: 'Enter a valid mobile/phone no. (e.g. 0917-123-4567, +639171234567, or 083-552-1234).'
            });
            if (msg) flag(phoneEl, msg);

            const emailEl = document.getElementById('EmailAddress');
            msg = checkTextField(emailEl, 'Email Address', RFI_LIMITS.email, { pattern: RFI_EMAIL_PATTERN, patternMessage: 'Enter a valid email address (e.g. juan@domain.com).' });
            if (msg) flag(emailEl, msg);

            const repEl = document.getElementById('Representative');
            msg = checkTextField(repEl, 'Representative Name', RFI_LIMITS.representative, { pattern: RFI_PERSON_NAME_PATTERN, patternMessage: 'Representative Name may only contain letters, spaces, periods, commas, apostrophes and dashes.' });
            if (msg) flag(repEl, msg);

            // ---- 5. Order of Payment & Fee Computation (all columns required, no duplicates) ----
            const feeRows = Array.from(document.querySelectorAll('#feesTableBody tr'));
            const feeErrors = [];
            const seenParticulars = {};
            if (feeRows.length === 0) feeErrors.push('At least one fee particular is required.');
            feeRows.forEach((row, i) => {
                const rowNo = i + 1;
                const sel = row.querySelector('.particular-select');
                const qty = row.querySelector('.qty-input');
                const feeVal = parseFloat(row.querySelector('.fee-amount')?.textContent) || 0;

                if (!sel || sel.value === '') {
                    feeErrors.push(`Row ${rowNo}: Particular is required.`);
                    if (sel) { sel.classList.add(...RFI_ERROR_CLASSES); if (!firstInvalid) firstInvalid = sel; }
                } else {
                    const p = availableParticulars[sel.value];
                    const key = p ? String(p.code).trim().toUpperCase() : sel.value;
                    if (seenParticulars[key]) {
                        feeErrors.push(`Row ${rowNo}: Duplicate particular "${p ? p.code + ' - ' + p.name : key}" (already in row ${seenParticulars[key]}).`);
                        sel.classList.add(...RFI_ERROR_CLASSES);
                        if (!firstInvalid) firstInvalid = sel;
                    } else {
                        seenParticulars[key] = rowNo;
                    }
                    if (feeVal <= 0) {
                        feeErrors.push(`Row ${rowNo}: Fee amount must be greater than 0.00.`);
                        sel.classList.add(...RFI_ERROR_CLASSES);
                        if (!firstInvalid) firstInvalid = sel;
                    }
                }

                const qRaw = qty ? String(qty.value).trim() : '';
                const qNum = Number(qRaw);
                if (!qRaw) {
                    feeErrors.push(`Row ${rowNo}: Quantity is required.`);
                } else if (!Number.isInteger(qNum) || qNum < 1 || qNum > RFI_LIMITS.qtyMax) {
                    feeErrors.push(`Row ${rowNo}: Quantity must be a whole number from 1 to ${RFI_LIMITS.qtyMax}.`);
                }
                if (qty && (!qRaw || !Number.isInteger(qNum) || qNum < 1 || qNum > RFI_LIMITS.qtyMax)) {
                    qty.classList.add(...RFI_ERROR_CLASSES);
                    if (!firstInvalid) firstInvalid = qty;
                }
            });
            const totalFees = parseFloat(document.getElementById('TotalFeesAmount').value) || 0;
            if (feeErrors.length === 0 && totalFees <= 0) feeErrors.push('Total inspection fees must be greater than 0.00.');
            if (feeErrors.length > 0) {
                errorCount += feeErrors.length;
                const feesSpan = document.getElementById('feesValidation');
                if (feesSpan) feesSpan.innerHTML = feeErrors.map(m => `<span class="block">&bull; ${m.replace(/</g, '&lt;')}</span>`).join('');
                if (!firstInvalid) firstInvalid = document.getElementById('btnAddRow');
            }

            return { isValid: errorCount === 0, errorCount, firstInvalid };
        }

        // -------------------------------------------------------------
        // Reference Properties Selection Handler
        // -------------------------------------------------------------
        function handleReferencePropertiesChange(values) {
            selectedPropertyIds = Array.isArray(values) ? values : (values ? [values] : []);
            
            const summaryContainer = document.getElementById('selectedPropertiesSummary');
            const summaryList = document.getElementById('selectedPropertiesList');
