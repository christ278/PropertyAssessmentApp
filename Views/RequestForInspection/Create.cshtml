                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label asp-for="ContactPerson" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONTACT PERSON <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="ContactPerson" maxlength="150" required class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Contact Name" />
                        <span asp-validation-for="ContactPerson" data-for="ContactPerson" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="ContactNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MOBILE / PHONE NO. <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="ContactNumber" maxlength="20" required inputmode="tel" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono focus:outline-none focus:border-emerald-600" placeholder="0917-000-0000" />
                        <span asp-validation-for="ContactNumber" data-for="ContactNumber" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="EmailAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EMAIL ADDRESS <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="EmailAddress" type="email" maxlength="100" required class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="email@domain.com" />
                        <span asp-validation-for="EmailAddress" data-for="EmailAddress" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="Representative" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REPRESENTATIVE NAME <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="Representative" maxlength="150" required class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Authorized Representative" />
                        <span asp-validation-for="Representative" data-for="Representative" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                </div>
            </div>

            <!-- Step 4: Attachment Upload (Routed to Inspection Storage ~/UploadFile/Inspection) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="paperclip" class="w-4 h-4 text-emerald-600"></i>
                        4. Upload Inspection Plan / Site Sketch (PDF, PNG, JPG)
                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                        <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ATTACHMENT FILE</label>
                        <input type="file" name="fileUpload" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-mono file:font-bold file:bg-emerald-600 file:text-white" />
                        <p class="text-[10px] text-slate-400 mt-1">Saved to CAST inspection file location: <code class="text-emerald-600 font-bold">~/UploadFile/Inspection</code></p>
                    </div>
                    <div>
                        <label asp-for="ORNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">O.R. NUMBER</label>
                        <input asp-for="ORNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono focus:outline-none focus:border-emerald-600" placeholder="OR-2026-XXXX" />
                    </div>
                </div>
            </div>

            <!-- Step 5: Document To Be Requested Table (Order of Payment Rates) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="calculator" class="w-4 h-4 text-emerald-600"></i>
                            5. Order of Payment & Fee Computation
                        </h3>
                        <p class="text-slate-500 dark:text-stone-400 text-[11px] mt-0.5">Select inspection fees and particulars to compute total billing amount.</p>
                    </div>

                    <button type="button" id="btnAddRow" class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center gap-1.5 text-xs font-mono shadow-sm">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        Add Fee Particular
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[500px] text-left text-xs font-mono" id="feesTable">
                        <thead class="bg-slate-200/60 dark:bg-stone-900 text-slate-700 dark:text-stone-300 font-bold border-b border-slate-300 dark:border-stone-800">
                            <tr>
                                <th class="px-3 py-2.5 w-12 text-center">ACTION</th>
                                <th class="px-3 py-2.5">PARTICULAR (ORDER OF PAYMENT) <span class="text-rose-500 font-bold">*</span></th>
                                <th class="px-3 py-2.5 w-32 text-right">FEES (₱)</th>
                                <th class="px-3 py-2.5 w-32 text-center">QUANTITY <span class="text-rose-500 font-bold">*</span></th>
                                <th class="px-3 py-2.5 w-36 text-right">TOTAL (₱)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-stone-800" id="feesTableBody">
                            <!-- Dynamic rows -->
                        </tbody>
                    </table>
                </div>
                <span id="feesValidation" class="text-rose-500 font-bold block text-[11px]">@foreach (var feeErr in (ViewData.ModelState["RequestedDocumentsJson"]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>()).Concat(ViewData.ModelState["TotalFeesAmount"]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>()))
                {
                    <span class="block">&bull; @feeErr.ErrorMessage</span>
                }</span>

                <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-stone-800">
                    <span class="text-sm font-extrabold text-slate-900 dark:text-white uppercase font-mono">Total Inspection Fees:</span>
                    <div class="text-xl font-black font-mono text-emerald-700 dark:text-emerald-400 bg-white dark:bg-stone-900 px-6 py-2 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm">
                        ₱ <span id="lblOverallTotal">0.00</span>
                    </div>
                </div>
            </div>

            <!-- Submit Button Footer -->
            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <a asp-action="Index" class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-all">
                    Cancel
                </a>
                <button type="submit" class="w-full sm:w-auto text-center px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Submit Request for Inspection
                </button>
            </div>
        <!-- SELECT DISCOVERY TD KIND MODAL -->
<div id="discoveryTdKindModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-2xl max-w-lg w-full p-6 space-y-5 animate-in fade-in zoom-in-95 duration-150">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-stone-800">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center font-bold">
                    <i data-lucide="sparkles" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-sm font-extrabold text-slate-900 dark:text-white uppercase tracking-tight">Select Tax Declaration (TD) Kind</h3>
                    <p class="text-[11px] text-slate-500 dark:text-stone-400">Discovery / New Declaration &bull; Choose property type to generate</p>
