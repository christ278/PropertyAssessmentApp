@model PropertyAssessmentApp.Models.RequestForInspection
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = "New Request for Inspection (RFI)";
    var properties = ViewBag.Properties as IEnumerable<TaxDeclaration> ?? new List<TaxDeclaration>();
    var orderPayments = ViewBag.OrderPayments as IEnumerable<OrderPayment> ?? new List<OrderPayment>();
    var registeredOwners = ViewBag.RegisteredOwners as IEnumerable<Owner> ?? new List<Owner>();
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="clipboard-check" class="w-4 h-4"></i>
                <span>Field Appraisal & Property Inspection</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">File Request for Inspection</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Encode site inspection requests, search reference TDNs, generate partitions, and configure Land, Building, or Machinery appraisals.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="inspectionForm" class="space-y-8" novalidate>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Partitions" id="Partitions" value="1" />
            <input type="hidden" asp-for="RequestedDocumentsJson" id="RequestedDocumentsJson" />
            <input type="hidden" asp-for="TotalFeesAmount" id="TotalFeesAmount" />
            <input type="hidden" asp-for="GeneratedPartitionsJson" id="GeneratedPartitionsJson" />
            <input type="hidden" asp-for="SelectedRefPropertyIdsJson" id="SelectedRefPropertyIdsJson" />
            <input type="hidden" asp-for="TaxDeclarationId" id="primaryRefPropertyId" />
            <input type="hidden" asp-for="OwnerId" id="requestOwnerIdInput" />
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-800 dark:text-rose-300 font-sans font-bold empty:hidden [&.validation-summary-valid]:hidden"></div>

            <!-- Tracking & Status Badge Header -->
            <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <span class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-extrabold text-xs font-mono">
                        TRACKING NO: @Model.TrackingNumber
                    </span>
                    <span class="text-slate-500 dark:text-stone-400 text-[11px]">Auto-generated system reference</span>
                </div>
                <input type="hidden" asp-for="TrackingNumber" />
                <input type="hidden" asp-for="Status" />
            </div>

            <!-- Step 1: Transaction Type, Real Property TD Search, Partition Generation & Owner Auto-Fill -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="tag" class="w-4 h-4 text-emerald-600"></i>
                            1. Transaction Type, Search TD &amp; Partitions
                        </h3>
                        <p class="text-slate-500 dark:text-stone-400 text-[11px] mt-0.5">Specify Transaction Code, search &amp; select reference Tax Declarations, generate partition lots, and click Edit (pencil) to configure Land, Building, or Machinery appraisal.</p>
                    </div>
                </div>

                <!-- Transaction Type Selector -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-2 border-b border-slate-200 dark:border-stone-800">
                    <div>
                        <label asp-for="TransactionCode" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center gap-1.5">
                            <i data-lucide="tag" class="w-3.5 h-3.5 text-emerald-600"></i>
                            TRANSACTION TYPE / CODE <span class="text-rose-500 font-bold">*</span>
                        </label>
                        <select asp-for="TransactionCode" id="txCodeSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600 cursor-pointer">
                            <option value="SD" data-name="Subdivision">Subdivision - SD</option>
                            <option value="CS" data-name="Consolidation">Consolidation - CS</option>
                            <option value="DC" data-name="Discovery/New Declaration" selected>Discovery/New Declaration - DC</option>
                            <option value="PC" data-name="Reassessment Due to Physical Change">Reassessment Due to Physical Change - PC</option>
                            <option value="RA" data-name="Reassessment">Reassessment - RA</option>
                            <option value="DT" data-name="Reassessment Due to partial Destruction of the property">Reassessment Due to partial Destruction of the property - DT</option>
                            <option value="TR" data-name="Transfer">Transfer - TR</option>
                            <option value="RC" data-name="Reclassification">Reclassification - RC</option>
                            <option value="GR" data-name="General Revision">General Revision - GR</option>
                            <option value="SP" data-name="Special Project">Special Project - SP</option>
                            <option value="DEP" data-name="Reassessment Due to depreciation">Reassessment Due to depreciation - DEP</option>
                        </select>
                        <input type="hidden" asp-for="TransactionTypeName" id="txNameInput" value="Discovery/New Declaration" />
                    </div>
                    <div>
                        <label asp-for="TransactionNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TRANSACTION NO. / REFERENCE (OPTIONAL)</label>
                        <input asp-for="TransactionNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="e.g. TX-2026-0001" />
                    </div>
                </div>

                <!-- Subdivision (SD) Workflow & Impact Callout Banner -->
                <div id="sdWorkflowBanner" class="p-4 rounded-2xl bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-sky-900 dark:text-sky-300 font-extrabold text-xs uppercase">
                        <i data-lucide="split" class="w-4 h-4 text-sky-600 dark:text-sky-400"></i>
                        <span>Subdivision (SD) · Segregation of Land Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-sky-600 text-white text-[9px] font-bold">Segregation</span>
                    </div>
                    <p class="text-[11px] text-sky-800 dark:text-sky-300 leading-relaxed">
                        <strong>Workflow:</strong> Initiated when a registered owner divides a mother parcel into multiple lots. The appraiser and tax mapper inspect boundary pins, road alignments, and mandatory open spaces against the Land Registration Authority (LRA) or DENR-approved plan.
                    </p>
                    <p class="text-[11px] text-sky-700 dark:text-sky-400 font-semibold">
                        <strong>Impact on Property:</strong> The mother Tax Declaration will be stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. New unique PINs and individual TDs will be generated for each segregated lot. Tax liabilities and delinquencies are apportioned independently.
                    </p>
                </div>

                <!-- Consolidation (CS) Workflow & Impact Callout Banner -->
                <div id="csWorkflowBanner" class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-amber-900 dark:text-amber-300 font-extrabold text-xs uppercase">
                        <i data-lucide="merge" class="w-4 h-4 text-amber-600 dark:text-amber-400"></i>
                        <span>Consolidation (CS) · Lot Integration Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-amber-600 text-white text-[9px] font-bold">Lot Integration</span>
                    </div>
                    <p class="text-[11px] text-amber-800 dark:text-amber-300 leading-relaxed">
                        <strong>Workflow:</strong> Combines two or more contiguous parcels under identical ownership into a single parcel. Field inspection verifies that parcels physically touch without intervening public access easements, water channels, or third-party encroachments against the Land Registration Authority (LRA) or DENR-approved consolidation plan.
                    </p>
                    <p class="text-[11px] text-amber-700 dark:text-amber-400 font-semibold">
                        <strong>Impact on Property:</strong> All individual parent Tax Declarations are stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. A single consolidated TD and PIN are generated. Real property tax receivables in the Treasury are collapsed from multiple ledgers into a unified bill.
                    </p>
                </div>

                <!-- Discovery / New Declaration (DC) Workflow & Impact Callout Banner -->
                <div id="dcWorkflowBanner" class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-emerald-900 dark:text-emerald-300 font-extrabold text-xs uppercase">
                        <i data-lucide="sparkles" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Discovery / New Declaration (DC) · Original Assessment Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-emerald-600 text-white text-[9px] font-bold">Original Assessment</span>
                    </div>
                    <p class="text-[11px] text-emerald-800 dark:text-emerald-300 leading-relaxed">
                        <strong>Workflow:</strong> Applied when a newly completed building, warehouse, industrial machinery, or previously unmapped land parcel is declared. The appraiser takes tape measurements, establishes structural framing (Types I to V), and verifies operational status.
                    </p>
                    <p class="text-[11px] text-emerald-700 dark:text-emerald-400 font-semibold">
                        <strong>Impact on Property:</strong> Does not supersede any prior TD. Creates an original Field Appraisal and Assessment Sheet (FAAS). Under Sec. 222 of R.A. 7160, back taxes may be assessed for up to ten (10) preceding years if unassessed since completion.
                    </p>
                </div>

                <!-- Reassessment Due to Physical Change (PC) Workflow & Impact Callout Banner -->
                <div id="pcWorkflowBanner" class="p-4 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-indigo-900 dark:text-indigo-300 font-extrabold text-xs uppercase">
                        <i data-lucide="hammer" class="w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                        <span>Reassessment Due to Physical Change (PC) · Renovation / Expansion Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-indigo-600 text-white text-[9px] font-bold">Renovation / Expansion</span>
                    </div>
                    <p class="text-[11px] text-indigo-800 dark:text-indigo-300 leading-relaxed">
                        <strong>Workflow:</strong> Triggered by structural renovations, adding vertical floors, floor plan extensions, or constructing accessory improvements (swimming pools, perimeter fences). Inspection logs new square meters and materials against building permits and physical site appraisal.
                    </p>
                    <p class="text-[11px] text-indigo-700 dark:text-indigo-400 font-semibold">
                        <strong>Impact on Property:</strong> The previous Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. Fair Market Value (FMV) and Assessed Value increase, recalculating structural effective age and leading to an upward tax adjustment.
                    </p>
                </div>

                <!-- Transfer (TR) Workflow & Impact Callout Banner -->
                <div id="trWorkflowBanner" class="p-4 rounded-2xl bg-teal-50 dark:bg-teal-950/40 border border-teal-200 dark:border-teal-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-teal-900 dark:text-teal-300 font-extrabold text-xs uppercase">
                        <i data-lucide="arrow-right-left" class="w-4 h-4 text-teal-600 dark:text-teal-400"></i>
                        <span>Transfer (TR) · Administrative Title Conveyance Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-teal-600 text-white text-[9px] font-bold">Administrative Conveyance</span>
                    </div>
                    <p class="text-[11px] text-teal-800 dark:text-teal-300 leading-relaxed">
                        <strong>Workflow:</strong> Executed upon sale, donation, barter, or extrajudicial settlement. Requires Transfer Certificate of Title (TCT), BIR Certificate Authorizing Registration (CAR/eCAR), and Transfer Tax Receipt. <span class="font-bold underline text-teal-900 dark:text-teal-200">Field inspection is not required</span> (administrative office conveyance).
                    </p>
                    <p class="text-[11px] text-teal-700 dark:text-teal-400 font-semibold">
                        <strong>Impact on Property:</strong> The prior owner's Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. The replacement TD retains identical land area, building classifications, and PIN, while redirecting billing ledgers to the transferee.
                    </p>
                </div>

                <!-- Reclassification (RC) Workflow & Impact Callout Banner -->
                <div id="rcWorkflowBanner" class="p-4 rounded-2xl bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-purple-900 dark:text-purple-300 font-extrabold text-xs uppercase">
                        <i data-lucide="layers" class="w-4 h-4 text-purple-600 dark:text-purple-400"></i>
                        <span>Reclassification (RC) · Actual Ground Use Conversion Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-purple-600 text-white text-[9px] font-bold">Ground Use Conversion</span>
                    </div>
                    <p class="text-[11px] text-purple-800 dark:text-purple-300 leading-relaxed">
                        <strong>Workflow:</strong> Mandated when land or structures convert physical usage (e.g., agricultural land to commercial parking, or residential home to retail grocery). Field inspection confirms actual economic activity pursuant to Sec. 217 of R.A. 7160.
                    </p>
                    <p class="text-[11px] text-purple-700 dark:text-purple-400 font-semibold">
                        <strong>Impact on Property:</strong> The old Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. Replaces the statutory assessment level (e.g., from 20% Residential to 50% Commercial), altering annual property tax dues without needing title re-titling.
                    </p>
                </div>

                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">
                        SEARCH &amp; SELECT REFERENCE TAX DECLARATION (TD) <span class="text-emerald-600 text-xs font-normal">(Multiple Selection Allowed)</span> <span id="refPropertyAsterisk" class="text-rose-500 font-bold">*</span>
                        <span id="refPropertyOptionalNotice" class="hidden text-amber-600 dark:text-amber-400 text-xs font-semibold italic ml-2">(Optional for Discovery / New Declaration)</span>
                    </label>
                    <select id="refPropertySelect" multiple class="w-full">
                        @foreach (var p in properties)
                        {
                            <option value="@p.Id"
                                    data-id="@p.Id"
                                    data-tdn="@p.TaxDeclarationNumber"
                                    data-pin="@p.PropertyIndexNumber"
                                    data-owner="@p.OwnerName"
                                    data-location="@p.CompleteAddress"
                                    data-kind="@p.Kind"
                                    data-classification="@p.Classification"
                                    data-area="@(p.AreaSqMeters.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                    data-unitval="@(p.UnitValue.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                    data-marketval="@(p.MarketValue.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                    data-assesslevel="@(p.AssessmentLevelPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                    data-assessedval="@(p.AssessedValue.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                    data-barangay="@p.DistrictOrBarangay">
                                @p.TaxDeclarationNumber - @p.OwnerName (@p.PropertyIndexNumber) [@p.Kind &bull; @p.Classification &bull; @p.AreaSqMeters.ToString("N0") sqm]
                            </option>
                        }
                    </select>
                    <span id="refPropertyValidation" class="text-rose-500 font-bold block mt-1 text-[11px]">@string.Join(" ", ViewData.ModelState["SelectedRefPropertyIdsJson"]?.Errors.Select(e => e.ErrorMessage) ?? Enumerable.Empty<string>())</span>
                </div>

                <!-- Selected Reference Properties Summary List -->
                <div id="selectedPropertiesSummary" class="hidden space-y-3 pt-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-700 dark:text-stone-300 uppercase flex items-center gap-1.5">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                            Selected Reference Properties (<span id="selectedCountBadge">0</span>)
                        </span>
                        <span class="text-[10px] text-slate-400">Values will be used as baseline for inspection partitions</span>
                    </div>
                    <div id="selectedPropertiesList" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Partition Generator Action Card -->
                <div id="partitionGeneratorCard" class="hidden p-5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-slate-50 dark:from-emerald-950/40 dark:via-teal-950/30 dark:to-stone-900 border border-emerald-200 dark:border-emerald-800/60 shadow-sm space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                        <div class="space-y-1">
                            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-600 text-white font-bold text-[10px] uppercase">
                                <i data-lucide="split" class="w-3 h-3"></i>
                                Generate Partition Action
                            </div>
                            <h4 class="text-sm font-extrabold text-slate-900 dark:text-white">
                                Automated Partition Lot &amp; System TDN Generation
                            </h4>
                            <p class="text-[11px] text-slate-600 dark:text-stone-400 max-w-2xl leading-relaxed">
                                Generate inspection partition lots from your selected reference TD. Each partition can be edited using the dedicated Land, Building, or Machinery appraisal form based on its Property Kind.
                            </p>
                        </div>
                    </div>

                    <!-- Multi-Property Selector -->
                    <div id="duplicateSourceSelector" class="space-y-2 pt-2 border-t border-emerald-200/60 dark:border-emerald-800/40">
                        <label class="block text-xs font-bold text-slate-800 dark:text-stone-200 uppercase">
                            Choose Which Reference Property to Duplicate / Partition From:
                        </label>
                        <div id="propertyRadioGroup" class="grid grid-cols-1 md:grid-cols-2 gap-2">
                            <!-- Populated dynamically -->
                        </div>
                    </div>

                    <!-- Partition Generation Controls -->
                    <div class="flex flex-wrap items-center gap-3 pt-2">
                        <div class="flex items-center gap-2 bg-white dark:bg-stone-900 px-3 py-2 rounded-xl border border-emerald-200 dark:border-emerald-800 shadow-xs">
                            <label class="text-xs font-bold text-slate-700 dark:text-stone-300">Partition Count (Lots):</label>
                            <input type="number" id="genPartitionCountInput" min="1" max="26" value="1" class="w-16 px-2 py-1 rounded bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-center text-sm" />
                        </div>
                        <button type="button" id="btnTriggerGeneratePartitions" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-2 shadow-md shadow-emerald-600/20 transition-all">
                            <i data-lucide="zap" class="w-4 h-4"></i>
                            Generate Partition Lots
                        </button>
                    </div>
                </div>

                <!-- Generated Partitions Table -->
                <div id="generatedPartitionsContainer" class="hidden space-y-3 pt-2">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="layers" class="w-4 h-4 text-emerald-600"></i>
                            Generated Partition/s
                        </h4>
                        <button type="button" id="btnAddManualPartitionRow" class="px-3 py-1.5 rounded-lg bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-emerald-700 dark:text-emerald-400 font-bold text-[11px] border border-slate-200 dark:border-stone-800 flex items-center gap-1 shadow-xs">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                            Add Another Lot
                        </button>
                    </div>

                    <div class="border border-slate-200 dark:border-stone-800 rounded-2xl overflow-x-auto bg-white dark:bg-stone-900 shadow-sm">
                        <table class="w-full text-left text-xs font-mono">
                            <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 font-bold uppercase text-[10px]">
                                <tr>
                                    <th class="px-4 py-3">TDN</th>
                                    <th class="px-4 py-3">Kind</th>
                                    <th class="px-4 py-3">Owner</th>
                                    <th class="px-4 py-3">Property Location</th>
                                    <th class="px-4 py-3 text-center w-24">Action</th>
                                </tr>
                            </thead>
                            <tbody id="generatedPartitionsTbody" class="divide-y divide-slate-100 dark:divide-stone-800/60 font-sans">
                                <!-- Populated by JS -->
                            </tbody>
                            <tfoot class="bg-slate-50 dark:bg-stone-950/80 font-bold text-slate-900 dark:text-white border-t border-slate-200 dark:border-stone-800">
                                <tr>
                                    <td colspan="5" class="px-4 py-2.5 text-xs text-slate-500">
                                        <div class="flex items-center justify-between">
                                            <span id="footPartitionSummary" class="font-bold text-slate-800 dark:text-stone-200">Total Partitions: 0 lot(s)</span>
                                            <span class="text-slate-400 text-[10px]">Click pencil icon to configure detailed Land, Building, or Machinery appraisal specifications</span>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Searchable Registered Owner Dropdown (Auto-fill) -->
                <div class="p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 space-y-2 mt-2">
                    <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase flex items-center gap-2">
                        <i data-lucide="user-search" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        Fetch Registered Owner from Database (Auto-fill)
                    </label>
                    <select id="registeredOwnerSelect" class="w-full">
                        <option value="">-- Search registered owner by Name, TIN, or RPTIN (Optional) --</option>
                        @foreach (var owner in registeredOwners)
                        {
                            <option value="@owner.Id">@owner.DisplayName (TIN: @owner.TaxIdentNo | @owner.BarangayName)</option>
                        }
                    </select>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                    <div>
                        <label asp-for="TaxDeclarationNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TDN / ARP NO. <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="TaxDeclarationNumber" id="tdNoInput" maxlength="50" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" placeholder="TD-2026-GS-0001" required />
                        <span asp-validation-for="TaxDeclarationNumber" data-for="tdNoInput" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="PropertyIndexNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PIN / PROPERTY INDEX NO. <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="PropertyIndexNumber" id="pinInput" maxlength="50" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" placeholder="126-00-0000" required />
                        <span asp-validation-for="PropertyIndexNumber" data-for="pinInput" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="OwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DECLARED OWNER <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="OwnerName" id="ownerNameInput" maxlength="150" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" placeholder="Owner / Declarant Name" required />
                        <span asp-validation-for="OwnerName" data-for="ownerNameInput" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Kind" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY KIND <span class="text-rose-500 font-bold">*</span></label>
                        <select asp-for="Kind" id="kindInput" required class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600">
                            <option value="">-- Select Property Kind --</option>
                            <option value="Land">Land</option>
                            <option value="Building">Building</option>
                            <option value="Machinery">Machinery</option>
                        </select>
                        <span asp-validation-for="Kind" data-for="kindInput" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="LotNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT NO. / SURVEY NO. <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="LotNo" id="lotNoInput" maxlength="100" required class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Lot 12, Blk 4" />
                        <span asp-validation-for="LotNo" data-for="lotNoInput" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="PropertyLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOCATION ADDRESS <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="PropertyLocation" id="locationInput" maxlength="250" required class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Street, Barangay, City" />
                        <span asp-validation-for="PropertyLocation" data-for="locationInput" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                    </div>
                </div>
            </div>

            <!-- Step 2: Inspection Reasons / Purpose (Matching CAST) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="check-square" class="w-4 h-4 text-emerald-600"></i>
                        2. Purpose of Inspection (Select Applicable) <span class="text-rose-500 font-bold">*</span>
                    </h3>
                </div>

                <div id="purposeCheckboxGroup" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="IsDepreciation" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">DEPRECIATION</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="IsReassessment" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">REASSESSMENT</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="IsCancelled" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CANCELLATION</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="IsOther" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">OTHER REASONS</span>
                    </label>
                </div>
                <span id="purposeValidation" class="text-rose-500 font-bold block text-[11px]">@string.Join(" ", ViewData.ModelState["PurposeOfInspection"]?.Errors.Select(e => e.ErrorMessage) ?? Enumerable.Empty<string>())</span>

                <div>
                    <label asp-for="OtherPurposeDetails" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SPECIFIC PURPOSE DETAILS <span id="otherPurposeRequiredMark" class="text-rose-500 font-bold hidden">*</span></label>
                    <input asp-for="OtherPurposeDetails" maxlength="500" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Provide notes on the requested field inspection or physical change..." />
                    <span asp-validation-for="OtherPurposeDetails" data-for="OtherPurposeDetails" class="js-field-error text-rose-500 font-bold block mt-1 text-[11px]"></span>
                </div>
            </div>

            <!-- Step 3: Contact & Representative Information -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="user" class="w-4 h-4 text-emerald-600"></i>
