                tdnList.push(prop.tdn);
                if (prop.pin) pinList.push(prop.pin);
                if (prop.owner) ownerList.push(prop.owner);
                if (!primaryLocation && prop.location) primaryLocation = prop.location;
                if (!primaryKind && prop.kind) primaryKind = prop.kind;

                cardsHtml += `
                    <div class="p-3.5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-xs flex items-start justify-between gap-3 text-xs">
                        <div class="space-y-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="px-2 py-0.5 rounded-md font-bold text-[10px] bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300">
                                    Ref #${idx + 1}
                                </span>
                                <span class="font-bold text-slate-900 dark:text-white font-mono">${prop.tdn}</span>
                                <span class="text-[10px] text-slate-400 font-mono">(${prop.pin || 'No PIN'})</span>
                            </div>
                            <div class="font-bold text-slate-800 dark:text-stone-200 truncate">${prop.owner}</div>
                            <div class="text-[11px] text-slate-500 dark:text-stone-400">
                                ${prop.kind} &bull; ${prop.classification} &bull; <strong class="text-slate-700 dark:text-stone-300">${prop.area.toLocaleString()} sqm</strong> &bull; ₱${prop.marketValue.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                            </div>
                            <div class="text-[10px] text-slate-400 truncate">${prop.location}</div>
                        </div>
                        <button type="button" onclick="removeSelectedProperty('${id}')" class="p-1 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors" title="Remove reference property">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;
            });

            if (summaryList) summaryList.innerHTML = cardsHtml;

            // Auto-fill form inputs from reference property
            if (tdnList.length > 0 && document.getElementById('tdNoInput')) {
                document.getElementById('tdNoInput').value = tdnList[0];
            }
            if (pinList.length > 0 && document.getElementById('pinInput')) {
                document.getElementById('pinInput').value = pinList[0];
            }
            if (ownerList.length > 0 && document.getElementById('ownerNameInput')) {
                document.getElementById('ownerNameInput').value = ownerList[0];
            }
            if (primaryLocation && document.getElementById('locationInput')) {
                document.getElementById('locationInput').value = primaryLocation;
            }
            if (primaryKind && document.getElementById('kindInput')) {
                document.getElementById('kindInput').value = primaryKind;
            }

            renderDuplicateSourceOptions();
            lucide.createIcons();
        }

        // Re-apply posted Reference TD selections when the page is re-rendered after server-side validation
        function restorePostedRefSelections() {
            if (!TomSelectRefProperty || (selectedPropertyIds && selectedPropertyIds.length > 0)) return;
            const hidden = document.getElementById('SelectedRefPropertyIdsJson');
            if (!hidden || !hidden.value) return;
            try {
                const ids = JSON.parse(hidden.value);
                if (Array.isArray(ids)) {
                    ids.forEach(id => {
                        const prop = referencePropertiesData[id];
                        if (!prop) return;
                        if (!TomSelectRefProperty.options[id]) {
                            TomSelectRefProperty.addOption({ id: prop.id, tdn: prop.tdn, pin: prop.pin, owner: prop.owner, kind: prop.kind, classification: prop.classification, area: prop.area, display: `${prop.tdn} - ${prop.owner}` });
                        }
                        TomSelectRefProperty.addItem(id);
                    });
                }
            } catch (e) { }
        }

        function removeSelectedProperty(id) {
            if (TomSelectRefProperty) {
                TomSelectRefProperty.removeItem(id);
            }
        }

