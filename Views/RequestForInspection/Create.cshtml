        // -------------------------------------------------------------
        // Partition Generation Engine
        // -------------------------------------------------------------
        function handleGeneratePartitions() {
            const txCode = (document.getElementById('txCodeSelect') ? document.getElementById('txCodeSelect').value : "SD").trim().toUpperCase();

            if (selectedPropertyIds.length === 0) {
                if (txCode === 'DC') {
                    openDiscoveryTdKindModal();
                    return;
                }
                toastr.warning('Please choose at least one Reference Property first.');
                return;
            }

            const chosenRadio = document.querySelector('input[name="dupSourceChoice"]:checked');
            const chosenValue = chosenRadio ? chosenRadio.value : selectedPropertyIds[0];
            const countInput = document.getElementById('genPartitionCountInput');
            const count = Math.max(1, Math.min(26, parseInt(countInput ? countInput.value : 2) || 2));
            const ownerName = (document.getElementById('ownerNameInput') ? document.getElementById('ownerNameInput').value : '').trim();
            const reqKindEl = document.getElementById('kindInput');
            const reqKind = reqKindEl && reqKindEl.value ? reqKindEl.value : null;

            generatedPartitions = [];

            if (chosenValue === "ALL") {
                let globalIdx = 0;
                selectedPropertyIds.forEach((propId) => {
                    const baseProp = referencePropertiesData[propId];
                    if (!baseProp) return;
                    for (let i = 0; i < count; i++) {
                        const letterSuffix = alphabetLetters[globalIdx % alphabetLetters.length];
                        const dividedArea = Math.round((baseProp.area / count) * 100) / 100;
                        const marketVal = Math.round((dividedArea * baseProp.unitValue) * 100) / 100;
                        const assessedVal = Math.round((marketVal * (baseProp.assessLevel / 100)) * 100) / 100;
                        const lotText = `Lot ${(globalIdx + 1)}-${letterSuffix}`;
                        const arpCombined = formatCastArpNumber(baseProp.barangay, '001', `${globalIdx + 1}`);
                        const effKind = (reqKind === 'Machinery' || reqKind === 'Building') ? reqKind : baseProp.kind;

                        generatedPartitions.push({
                            partitionIndex: letterSuffix,
                            baseTDN: baseProp.tdn,
                            basePropertyId: baseProp.id,
                            systemGeneratedTDN: generateSystemTDN(letterSuffix, baseProp.barangay, globalIdx + 1),
                            arpNo: arpCombined,
                            sectionNo: '001',
                            pin: baseProp.pin ? `${baseProp.pin}-${letterSuffix}` : arpCombined,
                            lotNumber: lotText,
                            kind: effKind,
                            classification: baseProp.classification,
                            areaSqMeters: dividedArea,
                            unitValue: baseProp.unitValue,
                            marketValue: marketVal,
                            assessmentLevelPercent: baseProp.assessLevel,
                            assessedValue: assessedVal,
                            newOwnerName: ownerName || baseProp.owner,
                            districtOrBarangay: baseProp.barangay,
                            propertyLocation: (document.getElementById('locationInput') ? document.getElementById('locationInput').value : '') || baseProp.location || baseProp.barangay || '',
                            customOwner: false,
                            customLocation: false
                        });
                        globalIdx++;
                    }
                });
            } else {
                const baseProp = referencePropertiesData[chosenValue];
                if (!baseProp) return;

                for (let i = 0; i < count; i++) {
                    const letterSuffix = alphabetLetters[i % alphabetLetters.length];
                    const dividedArea = Math.round((baseProp.area / count) * 100) / 100;
                    const marketVal = Math.round((dividedArea * baseProp.unitValue) * 100) / 100;
                    const assessedVal = Math.round((marketVal * (baseProp.assessLevel / 100)) * 100) / 100;
                    const lotText = `Lot ${i + 1}-${letterSuffix}`;
                    const arpCombined = formatCastArpNumber(baseProp.barangay, '001', `${i + 1}`);
                    const effKind = (reqKind === 'Machinery' || reqKind === 'Building') ? reqKind : baseProp.kind;

                    generatedPartitions.push({
                        partitionIndex: letterSuffix,
                        baseTDN: baseProp.tdn,
                        basePropertyId: baseProp.id,
                        systemGeneratedTDN: generateSystemTDN(letterSuffix, baseProp.barangay, i + 1),
                        arpNo: arpCombined,
                        sectionNo: '001',
                        pin: baseProp.pin ? `${baseProp.pin}-${letterSuffix}` : arpCombined,
                        lotNumber: lotText,
                        kind: effKind,
                        classification: baseProp.classification,
                        areaSqMeters: dividedArea,
                        unitValue: baseProp.unitValue,
                        marketValue: marketVal,
                        assessmentLevelPercent: baseProp.assessLevel,
                        assessedValue: assessedVal,
                        newOwnerName: ownerName || baseProp.owner,
                        districtOrBarangay: baseProp.barangay,
                        propertyLocation: (document.getElementById('locationInput') ? document.getElementById('locationInput').value : '') || baseProp.location || baseProp.barangay || '',
                        customOwner: false,
                        customLocation: false
                    });
                }
            }

            renderPartitionsTable();
            toastr.success(`Generated ${generatedPartitions.length} partition lots with CAST TDN & ARP combinations!`);
        }

        function resolveCastBrgyCode(brgyVal, defaultCode = '0001') {
            if (!brgyVal) return defaultCode;
            const raw = String(brgyVal).trim();
            if (/^\d+$/.test(raw)) return raw.slice(-4).padStart(4, '0');
            const u = raw.toUpperCase();
            const map = [
                ['DADIANGAS EAST', '0001'], ['CENTRAL', '0001'], ['POBLACION', '0001'], ['ZONE 1', '0001'],
                ['LAGAO', '0002'], ['MORALES', '0002'], ['CALUMPANG', '0003'], ['SAN ISIDRO', '0004'],
                ['CITY HEIGHTS', '0005'], ['DADIANGAS NORTH', '0006'], ['DADIANGAS SOUTH', '0007'],
                ['DADIANGAS WEST', '0008'], ['LABANGAL', '0009'], ['APOPONG', '0010'], ['BALUAN', '0011'],
                ['BATOMELONG', '0012'], ['BUAYAN', '0013'], ['BULA', '0014'], ['CONEL', '0015'],
                ['FATIMA', '0016'], ['KATANGAWAN', '0017'], ['LIGAYA', '0018'], ['MABUHAY', '0019'],
                ['OLYMPOG', '0020'], ['SAN JOSE', '0021'], ['SIGUEL', '0022'], ['SINAWAL', '0023'],
                ['TAMBLER', '0024'], ['TINAGACAN', '0025'], ['UPPER LABAY', '0026'], ['SALITRAN', '0027']
            ];
            for (const [k, c] of map) {
                if (u.includes(k)) return c;
            }
            const digits = raw.replace(/\D/g, '');
            if (digits) return digits.slice(-4).padStart(4, '0');
            return defaultCode;
        }

        function formatThreeDigitPart(val) {
            if (!val) return '000';
            const m = String(val).match(/\d+/);
            if (m) return m[0].slice(-3).padStart(3, '0');
            return String(val).replace(/[^a-zA-Z0-9]/g, '').slice(0, 3).toUpperCase().padStart(3, '0') || '000';
        }

        function formatCastArpNumber(brgyVal, sectionNo, lotOrParcelNo, lgu = '187', mun = '00') {
            const brgy4 = resolveCastBrgyCode(brgyVal, '0000');
            const sec3 = formatThreeDigitPart(sectionNo);
            const lot3 = formatThreeDigitPart(lotOrParcelNo);
            return `${String(lgu).padStart(3, '0')}-${String(mun).padStart(2, '0')}-${brgy4}-${sec3}-${lot3}`;
        }

        function generateSystemTDN(letterSuffix, brgyVal, seqIndex) {
            const revYearLastTwo = String(new Date().getFullYear() % 100).padStart(2, '0');
            const brgy4 = resolveCastBrgyCode(brgyVal, '0001');
            const baseCount = Object.keys(referencePropertiesData || {}).length;
            const seqNum = typeof seqIndex === 'number' && seqIndex > 0
                ? (baseCount + seqIndex)
                : (baseCount + (generatedPartitions ? generatedPartitions.length + 1 : 1));
            const declNo5 = String(seqNum).padStart(5, '0');
            return `${revYearLastTwo}-${brgy4}-${declNo5}`;
        }

        function renderPartitionsTable() {
            const container = document.getElementById('generatedPartitionsContainer');
            const tbody = document.getElementById('generatedPartitionsTbody');

            if (generatedPartitions.length === 0) {
                if (container) container.classList.add('hidden');
                if (tbody) tbody.innerHTML = '';
                serializePartitions();
                return;
            }

            if (container) container.classList.remove('hidden');

            let rowsHtml = '';
            generatedPartitions.forEach((p, idx) => {
                const hasSketch = !!(p.buildingFloorPlanSketchPath || p.buildingFloorPlanSketchBase64);
                const sketchBadge = hasSketch 
                    ? `<div class="mt-1"><a href="${p.buildingFloorPlanSketchPath || '#'}" target="_blank" class="inline-flex items-center gap-1 text-[9px] font-mono text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 px-1 py-0.5 rounded font-bold hover:underline" title="View attached floor plan sketch / blueprint"><i data-lucide="file-check" class="w-3 h-3 text-emerald-600"></i> Sketch</a></div>` 
                    : '';

                const locText = p.propertyLocation || p.location || [p.streetLocation, p.districtOrBarangay, p.cityMunicipality, p.province].filter(Boolean).join(', ') || 'N/A';

                rowsHtml += `
                    <tr class="hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors" data-partition-idx="${idx}">
                        <td class="px-4 py-3 align-middle">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-bold font-mono text-xs shrink-0" title="Partition Lot ${p.partitionIndex}">
                                    ${p.partitionIndex}
                                </span>
                                <div>
                                    <span class="font-bold font-mono text-slate-900 dark:text-white text-xs block">
                                        ${p.systemGeneratedTDN || 'TDN-PENDING'}
                                    </span>
                                    ${p.arpNo ? `<span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-mono block">ARP: ${p.arpNo}</span>` : ''}
                                    ${p.pin ? `<span class="text-[10px] text-slate-500 dark:text-stone-400 font-mono block">PIN: ${p.pin}</span>` : ''}
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 align-middle">
                            <span class="inline-block px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 font-mono">
                                ${p.kind || 'Land'}
                            </span>
                            ${p.classification ? `<span class="block text-[10px] text-slate-500 dark:text-stone-400 font-sans mt-0.5">${p.classification}</span>` : ''}
                        </td>
                        <td class="px-4 py-3 align-middle">
                            <span class="font-medium text-slate-900 dark:text-white text-xs block">
                                ${p.newOwnerName || 'N/A'}
                            </span>
                        </td>
                        <td class="px-4 py-3 align-middle">
                            <span class="text-slate-600 dark:text-stone-300 text-xs block font-sans">
                                ${locText}
                            </span>
                        </td>
                        <td class="px-4 py-3 align-middle text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button type="button" onclick="handleEditPartition(${idx})" class="p-1.5 text-emerald-600 hover:text-emerald-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 rounded-lg transition-colors" title="${p.kind === 'Building' ? 'Edit Building Appraisal (Structural Type & Materials)' : (p.kind === 'Machinery' ? 'Edit Machinery Appraisal (CAST Machinery Form)' : 'Edit Land Appraisal (CAST TDN Specification)')}">
                                    <i data-lucide="pencil" class="w-4 h-4"></i>
                                </button>
                                <button type="button" onclick="removePartition(${idx})" class="p-1.5 text-rose-500 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition-colors" title="Delete partition row">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                            ${sketchBadge}
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = rowsHtml;
            updatePartitionsFootTotals();
            serializePartitions();
            lucide.createIcons();
        }

        function removePartition(idx) {
            generatedPartitions.splice(idx, 1);
            generatedPartitions.forEach((p, i) => {
                p.partitionIndex = alphabetLetters[i % alphabetLetters.length];
            });
            renderPartitionsTable();
        }

        // -------------------------------------------------------------
        // Discovery / New Declaration TD Kind Selection Modal Helpers
        // -------------------------------------------------------------
        function openDiscoveryTdKindModal() {
            const modal = document.getElementById('discoveryTdKindModal');
            const countInput = document.getElementById('genPartitionCountInput');
            const count = Math.max(1, Math.min(26, parseInt(countInput ? countInput.value : 1) || 1));
            const countLbl = document.getElementById('modalDiscoveryCountLbl');
            if (countLbl) countLbl.textContent = count;

            const reqKindEl = document.getElementById('kindInput');
            const curKind = reqKindEl && reqKindEl.value ? reqKindEl.value : 'Land';
            const targetRadio = document.querySelector(`input[name="discoveryTdKindRadio"][value="${curKind}"]`);
            if (targetRadio) {
                targetRadio.checked = true;
                selectDiscoveryTdKindOption(curKind);
            }

            if (modal) modal.classList.remove('hidden');
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        function closeDiscoveryTdKindModal() {
            const modal = document.getElementById('discoveryTdKindModal');
            if (modal) modal.classList.add('hidden');
        }

        function selectDiscoveryTdKindOption(kind) {
            ['Land', 'Building', 'Machinery'].forEach(k => {
                const opt = document.getElementById(`tdKindOpt_${k}`);
                if (!opt) return;
                if (k.toLowerCase() === kind.toLowerCase()) {
                    opt.classList.add('border-emerald-500', 'bg-emerald-50/50', 'dark:bg-emerald-950/20');
                    opt.classList.remove('border-slate-200', 'dark:border-stone-800', 'bg-white', 'dark:bg-stone-900');
                    const r = opt.querySelector('input[type="radio"]');
                    if (r) r.checked = true;
                } else {
                    opt.classList.remove('border-emerald-500', 'bg-emerald-50/50', 'dark:bg-emerald-950/20');
                    opt.classList.add('border-slate-200', 'dark:border-stone-800', 'bg-white', 'dark:bg-stone-900');
                }
            });
        }

        function confirmGenerateDiscoveryPartitions() {
            const kindRadio = document.querySelector('input[name="discoveryTdKindRadio"]:checked');
            const chosenKind = kindRadio ? kindRadio.value : 'Land';
            const countInput = document.getElementById('genPartitionCountInput');
            const count = Math.max(1, Math.min(26, parseInt(countInput ? countInput.value : 1) || 1));
            const ownerName = (document.getElementById('ownerNameInput') ? document.getElementById('ownerNameInput').value : '').trim();
            const locInput = (document.getElementById('locationInput') ? document.getElementById('locationInput').value : '').trim();
            const brgyEl = document.getElementById('barangaySelect');
            const brgyName = brgyEl && brgyEl.value ? brgyEl.value : 'Brgy. Central';
            const brgyCode = resolveCastBrgyCode(brgyName, '0001');

            const reqKindEl = document.getElementById('kindInput');
            if (reqKindEl) {
                reqKindEl.value = chosenKind;
                reqKindEl.dispatchEvent(new Event('change', { bubbles: true }));
            }

            let defClassification = 'Residential';
            let defArea = 150;
            let defUnitVal = 1500;
            let defAssessLevel = 20;

            if (chosenKind === 'Building') {
                defClassification = 'Residential';
                defArea = 80;
                defUnitVal = 6000;
                defAssessLevel = 30;
            } else if (chosenKind === 'Machinery') {
                defClassification = 'Industrial';
                defArea = 0;
                defUnitVal = 0;
                defAssessLevel = 80;
            }

            generatedPartitions = [];

            for (let i = 0; i < count; i++) {
                const letterSuffix = alphabetLetters[i % alphabetLetters.length];
                const lotText = `Lot ${i + 1}-${letterSuffix}`;
                const arpCombined = formatCastArpNumber(brgyCode, '001', `${i + 1}`);
                const mv = chosenKind === 'Machinery' ? 350000 : Math.round((defArea * defUnitVal) * 100) / 100;
                const av = Math.round((mv * (defAssessLevel / 100)) * 100) / 100;

                generatedPartitions.push({
                    partitionIndex: letterSuffix,
                    baseTDN: 'NEW-DC',
                    basePropertyId: null,
                    systemGeneratedTDN: generateSystemTDN(letterSuffix, brgyCode, i + 1),
                    arpNo: arpCombined,
                    sectionNo: '001',
                    pin: arpCombined,
                    lotNumber: lotText,
                    kind: chosenKind,
                    classification: defClassification,
                    areaSqMeters: defArea,
                    unitValue: defUnitVal,
                    marketValue: mv,
                    assessmentLevelPercent: defAssessLevel,
                    assessedValue: av,
                    newOwnerName: ownerName || 'Applicant / Taxpayer',
                    districtOrBarangay: brgyName,
                    propertyLocation: locInput || brgyName || 'General Santos City',
                    customOwner: false,
                    customLocation: false
                });
            }

            closeDiscoveryTdKindModal();
            renderPartitionsTable();
            toastr.success(`Generated ${generatedPartitions.length} partition lot(s) for ${chosenKind} (Discovery / New Declaration)!`);
        }

        function handleAddManualPartitionLot() {
            const txCode = (document.getElementById('txCodeSelect') ? document.getElementById('txCodeSelect').value : "SD").trim().toUpperCase();

            if (selectedPropertyIds.length === 0 && txCode !== 'DC') {
                toastr.warning('Please select a reference property first.');
                return;
            }

            const baseProp = selectedPropertyIds.length > 0 ? referencePropertiesData[selectedPropertyIds[0]] : null;
            const idx = generatedPartitions.length;
            const letter = alphabetLetters[idx % alphabetLetters.length];
            const ownerName = (document.getElementById('ownerNameInput') ? document.getElementById('ownerNameInput').value : '').trim();
            const reqKindEl = document.getElementById('kindInput');
            const defaultKind = generatedPartitions.length > 0 ? generatedPartitions[0].kind : (reqKindEl && reqKindEl.value ? reqKindEl.value : 'Land');
            const effKind = baseProp ? (baseProp.kind || defaultKind) : defaultKind;
            const brgyName = baseProp ? baseProp.barangay : (document.getElementById('barangaySelect')?.value || 'Brgy. Central');
            const arpCombined = formatCastArpNumber(brgyName, '001', `${idx + 1}`);

            const area = effKind === 'Machinery' ? 0 : (effKind === 'Building' ? 80 : (baseProp ? baseProp.area : 150));
            const unitVal = baseProp ? baseProp.unitValue : (effKind === 'Building' ? 6000 : (effKind === 'Machinery' ? 0 : 1500));
            const mv = effKind === 'Machinery' ? 350000 : Math.round((area * unitVal) * 100) / 100;
            const al = baseProp ? baseProp.assessLevel : (effKind === 'Building' ? 30 : (effKind === 'Machinery' ? 80 : 20));
            const av = Math.round((mv * (al / 100)) * 100) / 100;

            generatedPartitions.push({
                partitionIndex: letter,
                baseTDN: baseProp ? baseProp.tdn : 'NEW-DC',
                basePropertyId: baseProp ? baseProp.id : null,
                systemGeneratedTDN: generateSystemTDN(letter, brgyName, idx + 1),
                arpNo: arpCombined,
                sectionNo: '001',
                pin: baseProp && baseProp.pin ? `${baseProp.pin}-${letter}` : arpCombined,
                lotNumber: `Lot ${idx + 1}-${letter}`,
                kind: effKind,
                classification: baseProp ? baseProp.classification : 'Residential',
                areaSqMeters: area,
                unitValue: unitVal,
                marketValue: mv,
                assessmentLevelPercent: al,
                assessedValue: av,
                newOwnerName: ownerName || (baseProp ? baseProp.owner : 'Applicant / Taxpayer'),
                districtOrBarangay: brgyName,
                propertyLocation: (document.getElementById('locationInput') ? document.getElementById('locationInput').value : '') || (baseProp ? baseProp.location : brgyName) || '',
                customOwner: false,
                customLocation: false
            });

            renderPartitionsTable();
            toastr.info(`Added Lot ${idx + 1}-${letter} to partition register.`);
        }

        function updatePartitionsFootTotals() {
            let totalArea = 0;
            let totalMV = 0;
            let totalAV = 0;

            generatedPartitions.forEach(p => {
                totalArea += parseFloat(p.areaSqMeters) || 0;
                totalMV += parseFloat(p.marketValue) || 0;
                totalAV += parseFloat(p.assessedValue) || 0;
            });

            const footSummary = document.getElementById('footPartitionSummary');
            if (footSummary) {
                footSummary.textContent = `Total Partitions: ${generatedPartitions.length} lot(s)`;
            }

            const footArea = document.getElementById('footTotalArea');
            if (footArea) footArea.textContent = totalArea.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const footMV = document.getElementById('footTotalMarketValue');
            if (footMV) footMV.textContent = `₱${totalMV.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            const footAV = document.getElementById('footTotalAssessedValue');
            if (footAV) footAV.textContent = `₱${totalAV.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function serializePartitions() {
            const json = JSON.stringify(generatedPartitions);
            document.getElementById('GeneratedPartitionsJson').value = json;
            
            const partInput = document.getElementById('Partitions');
            if (partInput) {
                partInput.value = generatedPartitions.length > 0 ? generatedPartitions.length : 1;
            }
        }

        // -------------------------------------------------------------
        // Dedicated Full-Page Partition Appraisal Redirect (CAST Style)
        // -------------------------------------------------------------
        function editPartitionRedirect(idx) {
            saveCurrentDraft(idx);
            const p = generatedPartitions[idx];
            const kindParam = p && p.kind ? `&kind=${encodeURIComponent(p.kind)}` : '';
            const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/PropertyAssessmentRequest/EditPartition?index=${idx}${kindParam}&returnUrl=${returnUrl}`;
        }

        function saveCurrentDraft(editingIdx) {
            const draft = {
                editingIdx: editingIdx,
                requestForInspection: true,
                txCode: document.getElementById('txCodeSelect')?.value,
                txName: document.getElementById('txNameInput')?.value,
                transactionNo: document.querySelector('input[name="TransactionNo"]')?.value,
                ownerId: document.getElementById('requestOwnerIdInput')?.value,
                ownerName: document.getElementById('ownerNameInput')?.value,
                contactNumber: document.getElementById('ContactNumber')?.value,
                emailAddress: document.getElementById('EmailAddress')?.value,
                contactPerson: document.getElementById('ContactPerson')?.value,
                representative: document.getElementById('Representative')?.value,
                orNumber: document.getElementById('ORNumber')?.value,
                kind: document.getElementById('kindInput')?.value,
                taxDeclarationNumber: document.getElementById('tdNoInput')?.value,
                propertyIndexNumber: document.getElementById('pinInput')?.value,
                lotNo: document.getElementById('lotNoInput')?.value,
                propertyLocation: document.getElementById('locationInput')?.value,
                otherPurposeDetails: document.getElementById('OtherPurposeDetails')?.value,
                selectedPropertyIds: selectedPropertyIds,
                partitions: generatedPartitions,
                feesJson: document.getElementById('RequestedDocumentsJson')?.value,
                totalFees: document.getElementById('TotalFeesAmount')?.value
            };
            sessionStorage.setItem('propertyAssessmentRequest_draft', JSON.stringify(draft));
        }

        function handleEditPartition(idx) {
            editPartitionRedirect(idx);
        }

        // -------------------------------------------------------------
        // Order of Payment & Fees Table Functions
        // -------------------------------------------------------------
        function addRow() {
            const tbody = document.getElementById('feesTableBody');
            if (!tbody) return;
            const tr = document.createElement('tr');
            tr.className = "hover:bg-slate-100/50 dark:hover:bg-stone-900/50 transition-colors";

            let optionsHtml = '<option value="">-- Select Particular --</option>';
            availableParticulars.forEach((p, idx) => {
                optionsHtml += `<option value="${idx}">${p.code} - ${p.name} (₱${p.fee.toFixed(2)})</option>`;
            });

            tr.innerHTML = `
                <td class="px-3 py-2.5 text-center">
                    <button type="button" class="btn-remove p-1 text-rose-600 hover:text-rose-800 transition-colors">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </td>
                <td class="px-3 py-2.5">
                    <select class="particular-select w-full px-3 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-300 dark:border-stone-700 text-slate-800 dark:text-stone-200">
                        ${optionsHtml}
                    </select>
                </td>
                <td class="px-3 py-2.5 text-right font-mono fee-amount">0.00</td>
                <td class="px-3 py-2.5 text-center">
                    <input type="number" min="1" max="999" step="1" value="1" required class="qty-input w-20 px-2 py-1 rounded-lg text-center bg-white dark:bg-stone-900 border border-slate-300 dark:border-stone-700 text-slate-800 dark:text-stone-200 font-mono" />
                </td>
                <td class="px-3 py-2.5 text-right font-mono font-bold text-emerald-700 dark:text-emerald-400 line-total">0.00</td>
            `;

            tbody.appendChild(tr);
            lucide.createIcons();
            attachRowEvents(tr);
            recalculateGrandTotal();
        }

        function attachRowEvents(row) {
            const sel = row.querySelector('.particular-select');
            const qty = row.querySelector('.qty-input');
            const btnRemove = row.querySelector('.btn-remove');

            if (sel) {
                sel.addEventListener('change', function () {
                    const idx = this.value;
                    const feeCell = row.querySelector('.fee-amount');

                    // Reject duplicate particulars across fee rows
                    if (idx !== "") {
                        const isDuplicate = Array.from(document.querySelectorAll('#feesTableBody .particular-select'))
                            .some(other => other !== sel && other.value === idx);
                        if (isDuplicate) {
                            const p = availableParticulars[idx];
                            this.value = "";
                            if (feeCell) feeCell.textContent = "0.00";
                            updateLineTotal(row);
                            const feesSpan = document.getElementById('feesValidation');
                            if (feesSpan) feesSpan.textContent = `"${p ? p.code + ' - ' + p.name : 'This particular'}" is already added. Duplicate particulars are not allowed.`;
                            if (typeof toastr !== 'undefined') toastr.warning('This fee particular is already added.', 'Duplicate Particular');
                            return;
                        }
                    }
                    const feesSpanOk = document.getElementById('feesValidation');
                    if (feesSpanOk) feesSpanOk.textContent = '';

                    if (idx !== "") {
                        const fee = availableParticulars[idx].fee;
                        if (feeCell) feeCell.textContent = fee.toFixed(2);
                    } else {
                        if (feeCell) feeCell.textContent = "0.00";
                    }
                    updateLineTotal(row);
                });
            }

            if (qty) {
                qty.addEventListener('input', function () {
                    updateLineTotal(row);
                });
            }

            if (btnRemove) {
                btnRemove.addEventListener('click', function () {
                    const tbody = document.getElementById('feesTableBody');
                    if (tbody && tbody.rows.length > 1) {
                        row.remove();
                        recalculateGrandTotal();
                    } else {
                        alert("At least one fee row is required.");
                    }
                });
            }
        }

        function updateLineTotal(row) {
            const feeCell = row.querySelector('.fee-amount');
            const qtyInput = row.querySelector('.qty-input');
            const lineTotalCell = row.querySelector('.line-total');
            const fee = parseFloat(feeCell ? feeCell.textContent : 0) || 0;
            const qty = parseInt(qtyInput ? qtyInput.value : 0) || 0;
            const lineTotal = fee * qty;
            if (lineTotalCell) lineTotalCell.textContent = lineTotal.toFixed(2);
            recalculateGrandTotal();
        }

        function recalculateGrandTotal() {
            let grandTotal = 0;
            const rows = document.querySelectorAll('#feesTableBody tr');
            const items = [];

            rows.forEach(r => {
                const sel = r.querySelector('.particular-select');
                const idx = sel ? sel.value : "";
                const qtyInput = r.querySelector('.qty-input');
                const qty = parseInt(qtyInput ? qtyInput.value : 0) || 0;
                const feeCell = r.querySelector('.fee-amount');
                const fee = parseFloat(feeCell ? feeCell.textContent : 0) || 0;
                const total = fee * qty;

                if (idx !== "" && availableParticulars[idx]) {
                    grandTotal += total;
                    items.push({
                        ParticularCode: availableParticulars[idx].code,
                        ParticularName: availableParticulars[idx].name,
                        UnitCost: fee,
                        Quantity: qty,
                        TotalCost: total
                    });
                }
            });

            const lblTotal = document.getElementById('lblOverallTotal');
            if (lblTotal) lblTotal.textContent = grandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const totalFeesInput = document.getElementById('TotalFeesAmount');
            if (totalFeesInput) totalFeesInput.value = grandTotal.toFixed(2);
            const reqDocsInput = document.getElementById('RequestedDocumentsJson');
            if (reqDocsInput) reqDocsInput.value = JSON.stringify(items);
        }
    </script>
}
