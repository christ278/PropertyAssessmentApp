@section Scripts {
    @* jQuery unobtrusive validation is intentionally not loaded here: this form uses its own
       client-side validation (validateInspectionForm) that renders messages in the spans below each field. *@
    <script>
        window.serverUpdatedPartition = null;
        window.serverUpdatedIdx = -1;
        @if (TempData["LastUpdatedPartitionJson"] != null)
        {
            <text>
            try {
                window.serverUpdatedPartition = @Html.Raw(TempData["LastUpdatedPartitionJson"]);
                window.serverUpdatedIdx = @(TempData["LastUpdatedPartitionIndex"] ?? -1);
            } catch(e) { }
            </text>
        }

        const availableParticulars = [
            @foreach (var op in orderPayments)
            {
                @: { code: "@op.Code", name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(op.Particular ?? "")), fee: @(op.UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture)) },
            }
        ];

        // Dictionary of properties for fast, reactive client-side cloning & partitioning
        const referencePropertiesData = {
            @foreach (var p in properties)
            {
                @: "@p.Id": {
                @:     id: "@p.Id",
                @:     tdn: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.TaxDeclarationNumber ?? "")),
                @:     pin: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.PropertyIndexNumber ?? "")),
                @:     owner: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.OwnerName ?? "")),
                @:     location: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.CompleteAddress ?? "")),
                @:     kind: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.Kind.ToString())),
                @:     classification: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.Classification.ToString())),
                @:     area: @(p.AreaSqMeters.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                @:     unitValue: @(p.UnitValue.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                @:     marketValue: @(p.MarketValue.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                @:     assessLevel: @(p.AssessmentLevelPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                @:     assessedValue: @(p.AssessedValue.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                @:     barangay: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.DistrictOrBarangay ?? ""))
                @: },
            }
        };

        let TomSelectRefProperty = null;
        let selectedPropertyIds = [];
        let generatedPartitions = [];
        const alphabetLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

        function initPage() {
            // Transaction Code selector sync & SD/CS/DC/PC/TR Workflow Banners
            const txSelect = document.getElementById('txCodeSelect');
            function updateInspectionBanners() {
                const val = txSelect ? txSelect.value : '';
                const sdBanner = document.getElementById('sdWorkflowBanner');
