            </div>
            <button type="button" onclick="closeDiscoveryTdKindModal()" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-stone-300 hover:bg-slate-100 dark:hover:bg-stone-800 transition-colors">
