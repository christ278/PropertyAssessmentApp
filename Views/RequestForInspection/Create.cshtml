        <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-100 dark:border-stone-800">
            <button type="button" onclick="closeDiscoveryTdKindModal()" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-stone-700 font-bold text-xs text-slate-700 dark:text-stone-300 hover:bg-slate-100 dark:hover:bg-stone-800 transition-colors">
