            </button>
        </div>

        <div class="space-y-3">
            <label class="block text-xs font-bold text-slate-700 dark:text-stone-300">Choose TD Type to Record:</label>
            <div class="grid grid-cols-1 gap-2.5">
                <!-- Land Option -->
                <label class="flex items-start gap-3.5 p-3.5 rounded-2xl border-2 border-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/20 cursor-pointer transition-all hover:border-emerald-600" id="tdKindOpt_Land" onclick="selectDiscoveryTdKindOption('Land')">
                    <input type="radio" name="discoveryTdKindRadio" value="Land" checked class="mt-1 text-emerald-600 focus:ring-emerald-500" />
                    <div class="flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-xs text-slate-900 dark:text-white">Land Appraisal & Assessment</span>
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-300">Land (Annex I-E)</span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-stone-400 mt-0.5">Vacant residential, agricultural, commercial, or industrial parcels with boundaries and unit valuation.</p>
                    </div>
                </label>

                <!-- Building Option -->
                <label class="flex items-start gap-3.5 p-3.5 rounded-2xl border border-slate-200 dark:border-stone-800 bg-white dark:bg-stone-900 cursor-pointer transition-all hover:border-emerald-500" id="tdKindOpt_Building" onclick="selectDiscoveryTdKindOption('Building')">
                    <input type="radio" name="discoveryTdKindRadio" value="Building" class="mt-1 text-emerald-600 focus:ring-emerald-500" />
                    <div class="flex-1">
