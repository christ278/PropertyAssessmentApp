@model PropertyAssessmentApp.Models.RequestForInspection
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = $"Edit RFI - {Model.TrackingNumber}";
    var properties = ViewBag.Properties as IEnumerable<TaxDeclaration> ?? new List<TaxDeclaration>();
    var orderPayments = ViewBag.OrderPayments as IEnumerable<OrderPayment> ?? new List<OrderPayment>();
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="edit" class="w-4 h-4"></i>
                <span>Edit Inspection Request</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Update Request @Model.TrackingNumber</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Modify inspection reasons, contact information, billing particulars, or uploaded attachments.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-8">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TrackingNumber" />
            <input type="hidden" asp-for="TransactionCode" />
            <input type="hidden" asp-for="TransactionNo" />
            <input type="hidden" asp-for="TaxDeclarationId" />
            <input type="hidden" asp-for="RequestedDocumentsJson" id="RequestedDocumentsJson" />
            <input type="hidden" asp-for="TotalFeesAmount" id="TotalFeesAmount" />
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-800 dark:text-rose-300"></div>

            <!-- Property Details -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="home" class="w-4 h-4 text-emerald-600"></i>
                    1. Property Reference Details
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="TaxDeclarationNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TDN / ARP NO. *</label>
                        <input asp-for="TaxDeclarationNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold" required />
                    </div>
                    <div>
                        <label asp-for="PropertyIndexNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PIN / PROPERTY INDEX NO. *</label>
                        <input asp-for="PropertyIndexNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold" required />
                    </div>
                    <div>
                        <label asp-for="OwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DECLARED OWNER *</label>
                        <input asp-for="OwnerName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" required />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Kind" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY KIND</label>
                        <select asp-for="Kind" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold">
                            <option value="Land">Land</option>
                            <option value="Building">Building</option>
                            <option value="Machinery">Machinery</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="LotNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT NO. / SURVEY NO.</label>
                        <input asp-for="LotNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                    </div>
                    <div>
                        <label asp-for="PropertyLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOCATION ADDRESS</label>
                        <input asp-for="PropertyLocation" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                    </div>
                </div>
            </div>

            <!-- Inspection Reasons -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="check-square" class="w-4 h-4 text-emerald-600"></i>
                    2. Purpose of Inspection
                </h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="IsDepreciation" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">DEPRECIATION</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="IsReassessment" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">REASSESSMENT</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="IsCancelled" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CANCELLATION</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="IsOther" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">OTHER REASONS</span>
                    </label>
                </div>

                <div>
                    <label asp-for="OtherPurposeDetails" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SPECIFIC PURPOSE DETAILS</label>
                    <input asp-for="OtherPurposeDetails" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                </div>
            </div>

            <!-- Contact Details -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="user" class="w-4 h-4 text-emerald-600"></i>
                    3. Contact Details
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label asp-for="ContactPerson" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONTACT PERSON</label>
                        <input asp-for="ContactPerson" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                    <div>
                        <label asp-for="ContactNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONTACT NUMBER</label>
                        <input asp-for="ContactNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                    <div>
                        <label asp-for="EmailAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EMAIL ADDRESS</label>
                        <input asp-for="EmailAddress" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                    <div>
                        <label asp-for="Representative" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REPRESENTATIVE</label>
                        <input asp-for="Representative" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                </div>
            </div>

            <!-- Workflow Stage & Attachment Upload -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="git-branch" class="w-4 h-4 text-emerald-600"></i>
                    4. Workflow Stage & Attachment
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Status" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">WORKFLOW STAGE</label>
                        <select asp-for="Status" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold">
                            @foreach (RequestForInspectionStatus s in Enum.GetValues(typeof(RequestForInspectionStatus)))
                            {
                                <option value="@s">@((int)s). @s</option>
                            }
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REPLACE ATTACHMENT (LEAVE EMPTY TO KEEP EXISTING)</label>
                        <input type="file" name="fileUpload" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-mono file:font-bold file:bg-emerald-600 file:text-white" />
                        @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
                        {
                            <span class="text-[11px] text-emerald-600 font-bold mt-1 block">Current file: @Model.AttachmentFileName</span>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ORNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">O.R. NUMBER</label>
                        <input asp-for="ORNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                    </div>
                    <div>
                        <label asp-for="AssignedStaff" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ASSIGNED STAFF</label>
                        <input asp-for="AssignedStaff" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                </div>

                <div>
                    <label asp-for="Remarks" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REMARKS</label>
                    <textarea asp-for="Remarks" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white"></textarea>
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <a asp-action="Details" asp-route-id="@Model.Id" class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-all">
                    Cancel
                </a>
                <button type="submit" class="w-full sm:w-auto text-center px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
