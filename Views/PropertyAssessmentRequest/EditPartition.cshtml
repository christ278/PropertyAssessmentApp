@model PropertyAssessmentApp.Models.AssessmentPartitionItem
@{
    ViewData["Title"] = $"Edit Partition Appraisal - {(!string.IsNullOrWhiteSpace(Model.SystemGeneratedTDN) ? Model.SystemGeneratedTDN : "TDN System Pending")}";
    var requestId = ViewBag.RequestId as Guid?;
    var partitionIndex = ViewBag.PartitionIndex as int? ?? 0;
    var returnUrl = ViewBag.ReturnUrl as string ?? (requestId.HasValue ? Url.Action("Edit", new { id = requestId.Value }) : Url.Action("Create"));
    var displayTdn = !string.IsNullOrWhiteSpace(Model.SystemGeneratedTDN) ? Model.SystemGeneratedTDN : "TDN System Pending";
}

<div class="space-y-8 font-mono text-xs">

    <!-- Top Header (Matches File Property Assessment Request standard) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="layers" class="w-4 h-4"></i>
                <span>Real Property Appraisal & FAAS Assessment &bull; Partition Appraisal</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
                <i data-lucide="building-2" class="w-7 h-7 text-emerald-600 dark:text-emerald-400"></i>
                <span id="displayHeaderTdn">@displayTdn</span>
            </h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">
                Full CAST Appraisal Specification &bull; Partition Lot @Model.PartitionIndex &bull; Reference TDN: @(string.IsNullOrWhiteSpace(Model.BaseTDN) ? "New Declaration" : Model.BaseTDN)
            </p>
        </div>
        <div class="flex items-center gap-2.5">
            <button type="button" onclick="cancelAndReturn()" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm transition-all">
                Cancel & Return
            </button>
            <button type="button" onclick="submitPartitionForm()" class="w-full sm:w-auto text-center px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs font-mono flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                <i data-lucide="save" class="w-4 h-4"></i>
                Save & Return to Request
            </button>
        </div>
    </div>

    <!-- Form Container (Wide card matching File Property Assessment Request) -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form id="partitionForm" asp-action="SavePartition" method="post" enctype="multipart/form-data" class="space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" name="index" value="@partitionIndex" id="partitionIndexInput" />
            <input type="hidden" name="requestId" value="@requestId" id="requestIdInput" />
            <input type="hidden" name="returnUrl" value="@returnUrl" id="returnUrlInput" />
            <input type="hidden" asp-for="BasePropertyId" />
            <input type="hidden" asp-for="BaseTDN" />
            <input type="hidden" asp-for="PartitionIndex" />
            <input type="hidden" asp-for="PropertyLocation" id="inputPropertyLocation" />
            <input type="hidden" asp-for="TotalBuildingAreaSqm" id="inputTotalBuildingAreaSqm" />
            <input type="hidden" asp-for="AdministratorAddress" id="inputAdminAddress" />
            <input type="hidden" asp-for="AdministratorContactNo" id="inputAdminContact" />
            <input type="hidden" asp-for="AdministratorTin" id="inputAdminTin" />
            <input type="hidden" asp-for="AdministratorGender" id="inputAdminGender" />
            <input type="hidden" asp-for="AdministratorCivilStatus" id="inputAdminCivilStatus" />
            <input type="hidden" asp-for="AdministratorEmail" id="inputAdminEmail" />
            
            <!-- Hidden JSON storage for Floor Breakdown & Additions -->
            <input type="hidden" asp-for="BuildingFloorBreakdownJson" id="buildingFloorBreakdownJson" />
            <input type="hidden" asp-for="BaseRcnValue" id="baseRcnValue" />
            <input type="hidden" asp-for="BuildingAdditionalItemsJson" id="buildingAdditionalItemsJson" />
            <input type="hidden" asp-for="BuildingTotalAdditionsValue" id="buildingTotalAdditionsValue" />
            <input type="hidden" asp-for="BuildingDepreciationAccumulated" id="buildingDepreciationAccumulated" />
            <input type="hidden" asp-for="BuildingDepreciatedMarketValue" id="buildingDepreciatedMarketValue" />

            <!-- Tracking & Status Badge Header -->
            <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3 flex-wrap">
                    <span class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-extrabold text-xs font-mono">
                        PARTITION LOT @Model.PartitionIndex
                    </span>
                    <span class="text-slate-700 dark:text-stone-300 text-xs font-mono font-bold">
                        TDN: <span class="text-emerald-700 dark:text-emerald-400 font-mono font-bold" id="bannerDisplayTdn">@displayTdn</span>
                    </span>
                    <span class="text-slate-500 dark:text-stone-400 text-[11px] font-mono">
                        &bull; Reference Base TDN: @(string.IsNullOrWhiteSpace(Model.BaseTDN) ? "New Declaration" : Model.BaseTDN)
                    </span>
                </div>
                <div class="text-slate-500 dark:text-stone-400 text-[11px] font-mono">
                    CAST Real Property Appraisal Standard (<span id="displayKindBadge">Land Appraisal / FAAS TDN</span>)
                </div>
                <div class="inline-flex rounded-xl bg-slate-200 dark:bg-stone-800 p-0.5 border border-slate-300 dark:border-stone-700">
                    <button type="button" onclick="switchAppraisalKind('Land')" id="btnKindLand" class="px-3 py-1 text-xs font-bold font-mono rounded-lg transition-all @(Model.Kind == "Building" ? "text-slate-600 dark:text-stone-400" : "bg-emerald-600 text-white shadow-xs")">Land</button>
                    <button type="button" onclick="switchAppraisalKind('Building')" id="btnKindBuilding" class="px-3 py-1 text-xs font-bold font-mono rounded-lg transition-all @(Model.Kind == "Building" ? "bg-emerald-600 text-white shadow-xs" : "text-slate-600 dark:text-stone-400")">Building</button>
                </div>
            </div>

            <input type="hidden" asp-for="Kind" id="inputKindHidden" value="@(Model.Kind ?? "Land")" />
            <input type="hidden" asp-for="SystemGeneratedTDN" id="inputTdn" />

            <!-- CONTAINER 1: LAND APPRAISAL FORM (CAST SPECIFICATION) -->
            <div id="container-land-appraisal" class="space-y-6 @(Model.Kind == "Building" ? "hidden" : "")">
                <partial name="_LandPartitionForm" model="Model" />
            </div>

            <!-- CONTAINER 2: BUILDING APPRAISAL FORM (CAST SPECIFICATION) -->
            <div id="container-building-appraisal" class="space-y-6 @(Model.Kind == "Building" ? "" : "hidden")">

            <!-- Tab Navigation Header (CAST Style) -->
            <div class="flex items-center gap-2 overflow-x-auto border-b border-slate-200 dark:border-stone-800 pb-3">
                <button type="button" onclick="switchTab('tab-general')" id="btn-tab-general" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-emerald-600 text-white shadow-sm flex items-center gap-2 shrink-0">
                    <i data-lucide="info" class="w-4 h-4"></i> 1. Property Info & Taxpayer (CCT)
                </button>
                <button type="button" onclick="switchTab('tab-structural')" id="btn-tab-structural" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
                    <i data-lucide="building" class="w-4 h-4"></i> 2. Structural Specs & 17 Materials
                </button>
                <button type="button" onclick="switchTab('tab-valuation')" id="btn-tab-valuation" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
                    <i data-lucide="calculator" class="w-4 h-4"></i> 3. Floor Levels, Additions & Valuation
                </button>
                <button type="button" onclick="switchTab('tab-memoranda')" id="btn-tab-memoranda" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
                    <i data-lucide="file-text" class="w-4 h-4"></i> 4. Back Taxes, Effectivity & Notes
                </button>
            </div>

            <!-- TAB 1: PROPERTY INFORMATION, TAXPAYER & CCT -->
            <div id="tab-general" class="tab-content space-y-6">
                <!-- Identification & Declarant Card -->
                <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="id-card" class="w-4 h-4 text-emerald-600"></i> Property Identification & Partition TDN
                        </h3>
                        <span class="text-xs text-slate-400 font-mono">Reference TDN: @(string.IsNullOrWhiteSpace(Model.BaseTDN) ? "New Declaration" : Model.BaseTDN)</span>
                    </div>

                    <!-- Hidden fields to preserve partition identity & background values -->
                                        <input type="hidden" asp-for="Classification" />
                    <input type="hidden" asp-for="ActualUse" />
                    <input type="hidden" asp-for="BlockNumber" />

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- 1. Property Type According to Use -->
                        <div id="colPropertyType" class="md:col-span-2">
                            <label asp-for="PropertyTypeAccordUse" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY TYPE ACCORDING TO USE</label>
                            <select asp-for="PropertyTypeAccordUse" id="selectPropertyTypeAccordUse" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                @if (ViewBag.BuildingPropertyTypesAccordUse != null)
                                {
                                    foreach (var pt in (IEnumerable<PropertyAssessmentApp.Models.BuildingPropertyTypeAccordUse>)ViewBag.BuildingPropertyTypesAccordUse)
                                    {
                                        <option value="@pt.PropertyTypeName">@pt.PropertyTypeName</option>
                                    }
                                }
                                else
                                {
                                    <option value="Townhouse">Townhouse</option>
                                    <option value="Industrial Condominium">Industrial Condominium</option>
                                    <option value="Residential Condominium">Residential Condominium</option>
                                    <option value="Commercial Condominium">Commercial Condominium</option>
                                    <option value="Other Type of Building and/or Structure">Other Type of Building and/or Structure</option>
                                }
                            </select>
                        </div>

                        <!-- 1.b Other Type of Building and/or Structure (Input) -->
                        <div id="divOtherPropertyType" class="md:col-span-1 hidden">
                            <label asp-for="OtherPropertyTypeAccordUse" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SPECIFY OTHER TYPE</label>
                            <input asp-for="OtherPropertyTypeAccordUse" id="inputOtherPropertyType" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Specify other building / structure type..." />
                        </div>

                        <!-- 2. PROPERTY INDEX NUMBER (PIN) -->
                        <div>
                            <label asp-for="PIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY INDEX NUMBER (PIN)</label>
                            <input asp-for="PIN" id="inputPin" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="126-00-0000-000" />
                        </div>

                        <!-- 3. SURVEY NO. -->
                        <div>
                            <label asp-for="SurveyNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SURVEY NO.</label>
                            <input asp-for="SurveyNumber" id="inputSurveyNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. Psu-12345" />
                        </div>

                        <!-- 4. LOT NO. -->
                        <div>
                            <label asp-for="LotNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT NO.</label>
                            <input asp-for="LotNumber" id="inputLotNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. Lot 10-A" />
                        </div>

                        <!-- 5. TITLE NO. -->
                        <div>
                            <label asp-for="TitleNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TITLE NO.</label>
                            <input asp-for="TitleNo" id="inputTitleNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. TCT-123456 / CCT-7890" />
                        </div>

                        <!-- 6. AREA IN SQR. (SQ.M.) -->
                        <div>
                            <label asp-for="AreaSqMeters" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">AREA IN SQR. (SQ.M.)</label>
                            <input asp-for="AreaSqMeters" id="inputAssessedArea" type="number" step="0.01" min="0" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono font-bold text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white text-right" placeholder="0.00" />
                        </div>
                    </div>
                </div>

                <!-- Owner & Administrator Normalized Demographics Card (CAST Standard) -->
                <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                    <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex flex-wrap items-center justify-between gap-2">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="users" class="w-4 h-4 text-emerald-600"></i> Owner & Administrator Demographics
                        </h3>
                        <!-- Flagging: Is Administrator / Beneficial User -->
                        <div class="flex items-center gap-2">
                            <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300 bg-white dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm hover:border-emerald-500 transition-colors">
                                <input type="checkbox" asp-for="IsAdministrator" id="isAdminSwitch" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                                <span>IS ADMINISTRATOR / BENEFICIAL USER</span>
                            </label>
                        </div>
                    </div>

                    <!-- Single Normalized Demographics Form -->
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div id="divOwnerName" class="md:col-span-2">
                            <label asp-for="NewOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER / DECLARANT NAME</label>
                            <input asp-for="NewOwnerName" id="inputOwnerName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Full name of owner / declarant" />
                        </div>
                        <div id="divAdminName" class="md:col-span-2 hidden">
                            <label asp-for="AdministratorName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                                <span>ADMINISTRATOR NAME</span>
                                <span id="adminBadge" class="text-[10px] font-mono text-emerald-600 font-bold uppercase">Administrator / Beneficial User</span>
                            </label>
                            <input asp-for="AdministratorName" id="inputAdminName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Administrator name (if flagged as administrator)" />
                        </div>
                        <div>
                            <label asp-for="OwnerGender" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">GENDER / SEX</label>
                            <select asp-for="OwnerGender" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="OwnerCivilStatus" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CIVIL STATUS</label>
                            <select asp-for="OwnerCivilStatus" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Single">Single</option>
                                <option value="Married">Married</option>
                                <option value="Widowed">Widowed</option>
                                <option value="Divorced">Divorced</option>
                                <option value="Legally Separated">Legally Separated</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="OwnerTIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TIN NO.</label>
                            <input asp-for="OwnerTIN" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="000-000-000-000" />
                        </div>
                        <div>
                            <label asp-for="OwnerContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MOBILE / CONTACT NO.</label>
                            <input asp-for="OwnerContactNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="09XXXXXXXXX" />
                        </div>
                        <div class="md:col-span-2">
                            <label asp-for="OwnerEmail" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EMAIL ADDRESS</label>
                            <input asp-for="OwnerEmail" type="email" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="email@example.com" />
                        </div>
                        <div class="md:col-span-4">
                            <label asp-for="OwnerAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MAILING ADDRESS</label>
                            <input asp-for="OwnerAddress" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="House / Unit No., Street, Barangay, City, Province" />
                        </div>
                    </div>
                </div>

                <!-- Two-Column Row: Left (Location & Land Reference & CCT) | Right (Building Floor Plan Sketch) -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Left Column: Location of Property & Land Reference -->
                    <div class="space-y-6">
                        <!-- Location of Property Card (CAST Standard) -->
                        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                                <i data-lucide="map-pin" class="w-4 h-4 text-emerald-600"></i> Location of Property
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="md:col-span-2">
                                    <label asp-for="StreetLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">STREET ADDRESS / NO.</label>
                                    <input asp-for="StreetLocation" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. 123 Pioneer Avenue" />
                                </div>
                                <div>
                                    <label asp-for="DistrictOrBarangay" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BARANGAY</label>
                                    <input asp-for="DistrictOrBarangay" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. Barangay Dadiangas South" />
                                </div>
                                <div>
                                    <label asp-for="CityMunicipality" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CITY / MUNICIPALITY</label>
                                    <input asp-for="CityMunicipality" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. General Santos City" />
                                </div>
                                <div class="md:col-span-2">
                                    <label asp-for="Province" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROVINCE</label>
                                    <input asp-for="Province" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. South Cotabato" />
                                </div>
                            </div>
                        </div>

                        <!-- Reference Land Card -->
                        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                            <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                                <i data-lucide="layers" class="w-4 h-4 text-emerald-600"></i> Land Reference (Where Erected)
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label asp-for="LandOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LAND OWNER NAME</label>
                                    <input asp-for="LandOwnerName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Land owner name" />
                                </div>
                                <div>
                                    <label asp-for="LandTdNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LAND TD NO.</label>
