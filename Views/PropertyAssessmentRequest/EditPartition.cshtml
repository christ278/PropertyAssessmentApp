                syncCastArpAndTdnLive();
            });

            // Load partition model from Server Model first (database ground truth), with draft fallback
            const serverModel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model ?? new PropertyAssessmentApp.Models.AssessmentPartitionItem(), jsonOptions));
            const hasServerData = serverModel && (
                (serverModel.systemGeneratedTDN && serverModel.systemGeneratedTDN !== 'TDN System Pending') ||
                serverModel.pin ||
                serverModel.arpNo ||
                (serverModel.areaSqMeters > 0) ||
                (serverModel.landAppraisalDetailsJson && serverModel.landAppraisalDetailsJson.length > 2) ||
                (serverModel.machineryAppraisalDetailsJson && serverModel.machineryAppraisalDetailsJson.length > 2) ||
                (serverModel.buildingFloorBreakdownJson && serverModel.buildingFloorBreakdownJson.length > 2)
            );

            const urlKind = new URLSearchParams(window.location.search).get('kind');
            let currentKind = urlKind || (serverModel && serverModel.kind) || '@(Model?.Kind ?? "")';
            if (!currentKind) currentKind = 'Land';
            let loadedPartition = serverModel;

            const isEditFromDb = '@(requestId.HasValue ? "true" : "false")' === 'true';
            if (!isEditFromDb) {
                try {
                    const savedDraft = sessionStorage.getItem('propertyAssessmentRequest_draft');
                    if (savedDraft) {
                        const draftObj = JSON.parse(savedDraft);
                        if (draftObj && draftObj.partitions && draftObj.partitions[partitionIndex]) {
                            const dp = draftObj.partitions[partitionIndex];
                            if (dp.kind && !urlKind) currentKind = dp.kind;
                            if (!hasServerData) {
                                loadedPartition = dp;
                            }
                        }
                    }
                } catch (e) { }
            } else if (isEditFromDb) {
                try {
                    sessionStorage.removeItem('propertyAssessmentRequest_draft');
                } catch (e) { }
            }

            switchAppraisalKind(currentKind);

            if (currentKind.toLowerCase() === 'land') {
                const p = loadedPartition;
                if (p) {
                    if (p.systemGeneratedTDN || p.tdn) {
                        const tdnVal = p.systemGeneratedTDN || p.tdn;
