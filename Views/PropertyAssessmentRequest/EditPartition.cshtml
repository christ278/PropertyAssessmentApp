                });
            }

            let totalImpMv = 0;
            document.querySelectorAll('.land-imp-row').forEach(r => {
                totalImpMv += parseFloat(r.getAttribute('data-mv')) || 0;
            });

            const tbody = document.getElementById('landPropertyAssessmentTableBody');
