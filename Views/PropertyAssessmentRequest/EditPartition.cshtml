            $('#landAdjustmentsJson').val(JSON.stringify(adjItems));

            const rollItems = [];
            document.querySelectorAll('.land-roll-row').forEach((r, idx) => {
                const kindSel = r.querySelector('.roll-kind-select');
                const actualSel = r.querySelector('.roll-actual-select');
                const mv = parseFloat(r.querySelector('.roll-mv-input').value) || 0;
                const lvl = parseFloat(r.querySelector('.roll-lvl-input').value) || 0;
                rollItems.push({
                    OrderNo: idx + 1,
                    Kinds: kindSel?.value || 'LAND',
                    ActualUseName: actualSel?.value || 'RESIDENTIAL',
                    MarketValue: mv,
                    AssessmentLevelPercent: lvl,
                    AssessmentValue: Math.round((mv * (lvl / 100)) * 100) / 100
                });
            });
            $('#landPropertyAssessmentsJson').val(JSON.stringify(rollItems));
        }

        function initLandFormDynamicTables(partitionData = null) {
            const classBody = document.getElementById('landClassificationTableBody');
            if (classBody) classBody.innerHTML = '';
            const impBody = document.getElementById('landImprovementTableBody');
            if (impBody) impBody.innerHTML = '';
            const adjBody = document.getElementById('landAdjustmentTableBody');
            if (adjBody) adjBody.innerHTML = '';
            const rollBody = document.getElementById('landPropertyAssessmentTableBody');
            if (rollBody) rollBody.innerHTML = '';

            let classJson = partitionData ? (partitionData.landAppraisalDetailsJson || partitionData.LandAppraisalDetailsJson) : $('#landAppraisalDetailsJson').val();
            let hasClassRows = false;
            if (classJson && classJson.trim() !== '[]' && classJson.trim() !== '') {
                try {
                    const items = typeof classJson === 'string' ? JSON.parse(classJson) : classJson;
                    if (Array.isArray(items) && items.length > 0) {
                        items.forEach(item => addLandClassificationRow(item));
                        hasClassRows = true;
                    }
                } catch (e) { }
            }
            if (!hasClassRows) {
                const area = partitionData ? (partitionData.areaSqMeters || partitionData.area || 150) : (parseFloat($('#inputAssessedArea').val()) || 150);
                const unitVal = partitionData ? (partitionData.unitValue || 520) : (parseFloat($('#inputUnitValue').val()) || 520);
                const actual = partitionData ? (partitionData.actualUse || 'Residential') : 'Residential';
                addLandClassificationRow({
                    ClassificationId: 1,
                    SubClassId: 1,
                    ActualUseName: actual,
                    AreaSQM: area,
                    UnitValue: unitVal,
                    MarketValue: area * unitVal
                });
            }

            let impJson = partitionData ? (partitionData.landImprovementsJson || partitionData.LandImprovementsJson) : $('#landImprovementsJson').val();
            if (impJson && impJson.trim() !== '[]' && impJson.trim() !== '') {
                try {
                    const items = typeof impJson === 'string' ? JSON.parse(impJson) : impJson;
                    if (Array.isArray(items)) {
                        items.forEach(item => addLandImprovementRow(item));
                    }
                } catch (e) { }
            }

            let adjJson = partitionData ? (partitionData.landAdjustmentsJson || partitionData.LandAdjustmentsJson) : $('#landAdjustmentsJson').val();
            let hasAdjRows = false;
            if (adjJson && adjJson.trim() !== '[]' && adjJson.trim() !== '') {
                try {
                    const items = typeof adjJson === 'string' ? JSON.parse(adjJson) : adjJson;
                    if (Array.isArray(items) && items.length > 0) {
                        items.forEach(item => addLandAdjustmentRow(item));
                        hasAdjRows = true;
                    }
                } catch (e) { }
            }
            if (!hasAdjRows) {
                syncAdjustmentsFromClassifications();
            }

            let rollJson = partitionData ? (partitionData.landPropertyAssessmentsJson || partitionData.LandPropertyAssessmentsJson) : $('#landPropertyAssessmentsJson').val();
            let hasRollRows = false;
            if (rollJson && rollJson.trim() !== '[]' && rollJson.trim() !== '') {
                try {
                    const items = typeof rollJson === 'string' ? JSON.parse(rollJson) : rollJson;
                    if (Array.isArray(items) && items.length > 0) {
                        items.forEach(item => addLandPropertyAssessmentRow(item));
                        hasRollRows = true;
                    }
                } catch (e) { }
            }
            if (!hasRollRows) {
                autoGeneratePropertyAssessmentRoll();
            }

            recomputeAllLandValuation();
        }

