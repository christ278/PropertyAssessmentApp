        async function handleWebInspectionPhotos(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            const btnTexts = document.querySelectorAll('.btnUploadPhotosText, #btnUploadPhotosText');
            btnTexts.forEach(b => b.innerText = 'Uploading...');

            const formData = new FormData();
            for (let i = 0; i < files.length; i++) {
                formData.append('files', files[i]);
            }
            formData.append('trackingNo', '@trackingNo');

            try {
                const response = await fetch('/PropertyAssessmentRequest/UploadPartitionInspectionPhotos', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error('Upload failed with status ' + response.status);
                }

                const newPhotos = await response.json();
                if (Array.isArray(newPhotos) && newPhotos.length > 0) {
                    partitionInspectionPhotos.push(...newPhotos);
                    $('#AttachmentsJson').val(JSON.stringify(partitionInspectionPhotos));
                    renderInspectionPhotosGallery();
                    if (window.toastr) toastr.success(`Uploaded ${newPhotos.length} photo(s) successfully!`);
                }
            } catch (err) {
                console.error('Error uploading photos:', err);
                if (window.toastr) toastr.error('Failed to upload inspection photos. Please try again.');
                else alert('Failed to upload inspection photos.');
            } finally {
                btnTexts.forEach(b => b.innerText = 'Add Photos');
                event.target.value = '';
            }
        }

