        function syncCastArpAndTdnLive() {
            const k = ($('#inputKindHidden').val() || 'Land').toLowerCase();
            const isLand = k === 'land';
            const isMachinery = k === 'machinery';
            const brgyVal = isLand
                ? ($('#selectLandBarangay').val() || '')
                : (isMachinery
                    ? ($('#selectMachineryBarangay').val() || '')
                    : ($('#selectBldgBarangay').val() || $('#container-building-appraisal select[name="DistrictOrBarangay"]').val() || $('#container-building-appraisal input[name="DistrictOrBarangay"]').val() || ''));
            const secVal = isLand
                ? ($('#inputLandSectionNo').val() || '')
                : (isMachinery
                    ? ($('#inputMachinerySectionNo').val() || '')
                    : ($('#inputBldgSectionNo').val() || ''));
            const lotOrParcelVal = isLand
                ? ($('#inputLandParcelNo').val() || $('#inputLandLotNo').val() || '')
                : (isMachinery
                    ? ($('#inputMachineryLotNo').val() || $('#inputMachineryParcelNo').val() || '')
                    : ($('#inputLotNumber').val() || ''));
            const effYearVal = isLand
                ? ($('#inputLandEffYear').val() || new Date().getFullYear())
                : (isMachinery
                    ? ($('#inputMachineryEffYear').val() || new Date().getFullYear())
                    : ($('#container-building-appraisal input[name="EffectivityYear"]').val() || new Date().getFullYear()));

            const arp = formatARPNumber('187', '00', brgyVal, secVal, lotOrParcelVal);
            $('#inputLandArpNo').val(arp);
            $('#inputBldgArpNo').val(arp);
            $('#inputMachineryArpNo').val(arp);
            $('#bannerDisplayArpNo').text(arp);

            const officialTdn = formatOfficialTDN(effYearVal, brgyVal, $('#inputTdn').val(), partitionIndex + 1);
            $('#inputTdn').val(officialTdn);
            $('#displayHeaderTdn').text(officialTdn);
            $('#bannerDisplayTdn').text(officialTdn);
        }

