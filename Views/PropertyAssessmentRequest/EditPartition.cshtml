        function SubmitAddAdditionalItemModal() {
            const sel = $('#modalAddItemSelect option:selected');
            const itemId = $('#modalAddItemSelect').val();
            const itemDesc = sel.data('desc') || sel.text().trim() || '';
            const area = parseFloat($('#modalAddItemArea').val()) || 1;
            const rate = parseFloat($('#modalAddItemRate').val()) || 0;
            const percent = parseFloat($('#modalAddItemPercent').val()) || 100;

            if (!itemId) {
                toastr.warning('Please select an additional item.', 'Item Description Required');
                return;
            }

            const total = Math.round((area * rate) * (percent / 100.0) * 100) / 100;

            buildingAdditions.push({
                itemId: itemId,
                description: itemDesc,
                quantity: area,
                unitRate: rate,
                multiplier: percent,
                totalValue: total
            });

            closeAddAdditionModal();
            renderAdditions();
            recalculateValuation();
            toastr.success(`${itemDesc} added to additional items schedule.`);
        }

