                        <td class="p-3 text-right font-mono">₱${f.baseUnitCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                        <td class="p-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">₱${f.marketValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
