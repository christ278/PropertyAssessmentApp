                const qty = parseFloat(r.querySelector('.imp-qty-input').value) || 0;
                const age = parseInt(r.querySelector('.imp-age-input').value) || 0;
                const unitVal = parseFloat(r.querySelector('.imp-unitval-input').value) || 0;
                impItems.push({
                    OrderNo: idx + 1,
                    TypeId: parseInt(typeSel?.value) || 1,
                    TypeDescription: typeSel?.options[typeSel.selectedIndex]?.text || '',
                    IsFruitBearing: isFruit,
                    Quantity: qty,
                    AgeYears: age,
                    UnitValue: unitVal,
                    MarketValue: Math.round((qty * unitVal) * 100) / 100
                });
            });
            $('#landImprovementsJson').val(JSON.stringify(impItems));

            const adjItems = [];
            document.querySelectorAll('.land-adj-row').forEach((r, idx) => {
                const className = r.querySelector('.adj-class-input')?.value || 'Residential';
                const baseMv = parseFloat(r.querySelector('.adj-basemv-input').value) || 0;
                const factorSel = r.querySelector('.adj-factor-dropdown');
                const pct = parseFloat(r.querySelector('.adj-pct-input').value) || 0;
                const valAdj = Math.round((baseMv * (pct / 100)) * 100) / 100;
                adjItems.push({
                    OrderNo: idx + 1,
                    ClassificationName: className,
                    BaseMarketValue: baseMv,
                    AdjustmentFactorId: parseInt(factorSel?.value) || 1,
                    AdjustmentFactorDescription: factorSel?.options[factorSel.selectedIndex]?.text || '',
