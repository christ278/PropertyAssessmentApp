        function resolveCastBrgyCode(brgyVal, defaultCode = '0001') {
            if (!brgyVal) return defaultCode;
            const raw = String(brgyVal).trim();
            if (/^\d+$/.test(raw)) return raw.slice(-4).padStart(4, '0');
            const u = raw.toUpperCase();
            const map = [
                ['ZONE I', '0001'], ['ZONE 1', '0001'],
                ['ZONE II', '0002'], ['ZONE 2', '0002'],
                ['ZONE III', '0003'], ['ZONE 3', '0003'],
                ['ZONE IV', '0004'], ['ZONE 4', '0004'],
                ['ASSUMPTION', '0005'],
                ['AVANCEÑA', '0006'], ['AVANCENA', '0006'],
                ['CACUB', '0007'],
                ['CALOOCAN', '0008'],
                ['CARPENTER HILL', '0009'],
                ['CONCEPCION', '0010'],
                ['ESPERANZA', '0011'],
                ['GEN. P. SANTOS', '0012'], ['GEN. P SANTOS', '0012'], ['GEN P SANTOS', '0012'],
                ['MABINI', '0013'],
                ['MAGSAYSAY', '0014'],
                ['MAMBUCAL', '0015'],
                ['MORALES', '0016'],
                ['NAMNAMA', '0017'],
                ['NEW PANGASINAN', '0018'],
                ['PARAISO', '0019'],
                ['ROTONDA', '0020'],
                ['SAN ISIDRO', '0021'],
                ['SAN JOSE', '0022'],
                ['SAN ROQUE', '0023'],
                ['SARAVIA', '0024'],
                ['STA. CRUZ', '0025'], ['STA CRUZ', '0025'],
                ['STO. NIÑO', '0026'], ['STO. NINO', '0026'], ['STO NINO', '0026'],
                ['TOPLAND', '0027'],
                ['DADIANGAS EAST', '0001'], ['CENTRAL', '0001'], ['POBLACION', '0001'],
                ['LAGAO', '0002'], ['CALUMPANG', '0003'], ['CITY HEIGHTS', '0005']
            ];
            for (const [k, c] of map) {
                if (u.includes(k)) return c;
            }
            const digits = raw.replace(/\D/g, '');
            if (digits) return digits.slice(-4).padStart(4, '0');
            return defaultCode;
        }

        function formatThreeDigitPart(val) {
            if (!val) return '000';
            const m = String(val).match(/\d+/);
            if (m) return m[0].slice(-3).padStart(3, '0');
            return String(val).replace(/[^a-zA-Z0-9]/g, '').slice(0, 3).toUpperCase().padStart(3, '0') || '000';
        }

        // CAST Combination #1 (ARPNo): {LGUCode}-{DistrictMunicipalityCode}-{BarangayCode:D4}-{SectionNo:D3}-{LotOrParcelNo:D3}
        function formatARPNumber(lgu, mun, brgyVal, sectionNo, parcelOrLotNo) {
            const lgu3 = String(lgu || '187').padStart(3, '0');
            const mun2 = String(mun || '00').padStart(2, '0');
            const brgy4 = resolveCastBrgyCode(brgyVal, '0000');
            const sec3 = formatThreeDigitPart(sectionNo);
            const lot3 = formatThreeDigitPart(parcelOrLotNo);
            return `${lgu3}-${mun2}-${brgy4}-${sec3}-${lot3}`;
        }

        // CAST Combination #2: [GR Year]-[Municipality Index]-[Barangay Code]-[Sequential Series]
        // Example: 2020-08-0012-00512 (Approved) or 2020-08-0012-00000 (Unapproved)
        function formatOfficialTDN(effYear, brgyVal, currentTdn, fallbackSeq) {
            const yr = parseInt(effYear, 10) || new Date().getFullYear();
            const grYear4 = yr < 100 ? (2000 + yr) : yr;
            const mun2 = '08';
            const brgy4 = resolveCastBrgyCode(brgyVal, '0001');
            const isApproved = @((ViewBag.IsRequestApproved == true) ? "true" : "false");
            let seq5 = '00000';

            if (currentTdn) {
                const parts = String(currentTdn).trim().split('-');
                if (parts.length === 4 && /^\d{5}$/.test(parts[3])) {
                    if (isApproved || parts[3] !== '00000') {
                        seq5 = parts[3];
                    }
                } else if (parts.length === 3 && /^\d{5}$/.test(parts[2])) {
                    if (isApproved || parts[2] !== '00000') {
                        seq5 = parts[2];
                    }
                }
            }

            if (isApproved && seq5 === '00000') {
                const safeSeq = typeof fallbackSeq === 'number' && fallbackSeq > 0 ? fallbackSeq : (partitionIndex + 1);
                seq5 = String(safeSeq).padStart(5, '0');
            } else if (!isApproved) {
                seq5 = '00000';
            }

            return `${grYear4}-${mun2}-${brgy4}-${seq5}`;
        }

