                                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                                    <i data-lucide="file-badge" class="w-4 h-4 text-emerald-600"></i> Condominium Title (CCT)
                                </h3>
                                <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300">
                                    <input type="checkbox" asp-for="IsCct" id="isCctSwitch" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                                    <span>CONDOMINIUM UNIT (CCT)</span>
                                </label>
                            </div>

                            <!-- CCT Fields -->
                            <div id="cctDetailsRow" class="grid grid-cols-1 md:grid-cols-3 gap-4 hidden bg-amber-50/50 dark:bg-amber-950/20 p-4 rounded-xl border border-amber-200 dark:border-amber-800/40">
                                <div>
                                    <label asp-for="CctTitleNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CCT TITLE NO.</label>
                                    <input asp-for="CctTitleNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. CCT-00123" />
                                </div>
                                <div>
                                    <label asp-for="CctDateRegistered" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DATE REGISTERED</label>
                                    <input asp-for="CctDateRegistered" type="date" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" />
                                </div>
                                <div>
                                    <label asp-for="OwnerNameReflectedInCct" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER REFLECTED IN CCT</label>
                                    <input asp-for="OwnerNameReflectedInCct" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Name as shown on CCT" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Building Floor Plan Sketch Attachment (CAST Standard) -->
                    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4 flex flex-col justify-between">
                        <div>
                            <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
                                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                                    <i data-lucide="image" class="w-4 h-4 text-emerald-600"></i> Building Floor Plan Sketch
                                </h3>
                                <span class="text-xs text-slate-400 font-mono">Blueprint / Plan</span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-stone-400 mt-2 font-mono">
                                Upload a digitized blueprint, sketch, or schematic floor layout for this partition building.
                            </p>

                            <div class="mt-4">
                                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">UPLOAD SKETCH / BLUEPRINT FILE</label>
                                <input type="file" id="fileUploadSketch" name="sketchFile" accept="image/jpeg, image/png, image/webp, application/pdf"
                                       class="w-full px-3 py-2 text-xs font-mono rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-emerald-50 dark:file:bg-emerald-950/60 file:text-emerald-700 dark:file:text-emerald-300 hover:file:bg-emerald-100 cursor-pointer"
                                       onchange="previewSketchImage(event)" />
                            </div>

                            <!-- Preview Container Box -->
                            <div class="mt-4 border-2 border-dashed border-slate-200 dark:border-stone-800 rounded-xl p-3 text-center bg-white dark:bg-stone-900 flex flex-col items-center justify-center min-h-[260px] relative overflow-hidden">
                                <img id="sketchPreviewImg" src="@(!string.IsNullOrEmpty(Model.BuildingFloorPlanSketchBase64) ? Model.BuildingFloorPlanSketchBase64 : (!string.IsNullOrEmpty(Model.BuildingFloorPlanSketchPath) ? Model.BuildingFloorPlanSketchPath : ""))"
                                     class="max-h-60 max-w-full rounded-lg object-contain shadow-sm border border-slate-200 dark:border-stone-800 @(string.IsNullOrEmpty(Model.BuildingFloorPlanSketchBase64) && string.IsNullOrEmpty(Model.BuildingFloorPlanSketchPath) ? "hidden" : "")"
