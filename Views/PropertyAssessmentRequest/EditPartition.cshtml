                                <div id="sketchPlaceholder" class="p-6 text-center text-slate-400 dark:text-stone-500 @(!string.IsNullOrEmpty(Model.BuildingFloorPlanSketchBase64) || !string.IsNullOrEmpty(Model.BuildingFloorPlanSketchPath) ? "hidden" : "")">
