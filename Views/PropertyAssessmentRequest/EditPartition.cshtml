                    buildingFloors = JSON.parse(existingFloors);
                    renderFloors();
                }
                const existingAdditions = $('#buildingAdditionalItemsJson').val();
                if (existingAdditions) {
                    buildingAdditions = JSON.parse(existingAdditions);
                    renderAdditions();
                }
                recalculateValuation(true);
            } catch (err) {
                console.error('JSON load error:', err);
            }

            // Listeners for Storey count, Structural type & Building classification synchronization
            $('#inputNoOfStoreys').on('input change', function () {
                const count = parseInt($(this).val()) || 1;
                $('#labelStoreyCountHint').text(`TOTAL STOREY COUNT: ${count}`);
            });

            $('select[name="StructuralType"]').on('change', function () {
                const newStruct = $(this).val();
                toastr.info(`Structural Type set to ${newStruct}. BUCC schedule rates updated.`, 'BUCC Schedule');
                updateExistingFloorsUnitCost(newStruct);
                if (!$('#addFloorModal').hasClass('hidden')) {
                    fetchModalFloorUnitCost();
                }
            });

            $('#selectBuildingClassification').on('change', function () {
                const bldgVal = $(this).val();
                if (bldgVal && !$('#modalFloorBuildingClass').val()) {
                    $('#modalFloorBuildingClass').val(bldgVal);
                }
            });

            // Wire Building Age & Depreciation auto-computation listeners
            $('input[name="DateConstructed"], input[name="DateCompleted"]').on('change input', calculateBuildingAgeFromDates);
            $('#inputBuildingAge').on('change input', lookupSuggestedDepreciationRate);

            $('#inputDeprPercent, #inputAssessedArea, #inputUnitValue').on('input', function () {
                recalculateValuation(false);
            });

            $('#inputAssessLevel').on('input', function () {
                const fmv = parseFloat($('#inputMarketValue').val()) || 0;
                const lvl = parseFloat($(this).val()) || 0;
                updateAssessedValueAndTaxes(fmv, lvl);
            });

            if (!$('#inputLandArpNo').val() || $('#inputLandArpNo').val() === '187-00-0000-000-000' || !$('#inputTdn').val() || $('#inputTdn').val().startsWith('TD-')) {
                syncCastArpAndTdnLive();
            }

            renderInspectionPhotosGallery();
            recalculateValuation();
        });
    </script>
}
