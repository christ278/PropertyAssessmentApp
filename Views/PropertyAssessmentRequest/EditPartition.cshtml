                        </div>
                        <div>
                            <label asp-for="StructuralStairs" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">11. STAIRS</label>
                            <select asp-for="StructuralStairs" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-xs font-mono focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Reinforced Concrete (RC)">Reinforced Concrete (RC)</option>
                                <option value="Steel (S)">Steel (S)</option>
                                <option value="Wood (W)">Wood (W)</option>
                            </select>
                        </div>
