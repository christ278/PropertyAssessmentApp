@model PropertyAssessmentApp.Models.AssessmentPartitionItem
@{
    ViewData["Title"] = $"Edit Partition Appraisal - {(!string.IsNullOrWhiteSpace(Model.SystemGeneratedTDN) ? Model.SystemGeneratedTDN : "TDN System Pending")}";
    var requestId = ViewBag.RequestId as Guid?;
    var partitionIndex = ViewBag.PartitionIndex as int? ?? 0;
    var returnUrl = ViewBag.ReturnUrl as string ?? (requestId.HasValue ? Url.Action("Edit", new { id = requestId.Value }) : Url.Action("Create"));
    var displayTdn = !string.IsNullOrWhiteSpace(Model.SystemGeneratedTDN) ? Model.SystemGeneratedTDN : "TDN System Pending";
    var registeredOwners = ViewBag.RegisteredOwners as IEnumerable<PropertyAssessmentApp.Models.Owner> ?? Enumerable.Empty<PropertyAssessmentApp.Models.Owner>();
    var trackingNo = ViewBag.TrackingNumber as string ?? "";
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}

<partial name="_Select2Style" />

<div class="space-y-8 font-mono text-xs">

    <!-- Top Header (Matches File Property Assessment Request standard) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="layers" class="w-4 h-4"></i>
                <span>Real Property Appraisal & FAAS Assessment &bull; Partition Appraisal</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
                <i data-lucide="building-2" class="w-7 h-7 text-emerald-600 dark:text-emerald-400"></i>
                <span id="displayHeaderTdn">@displayTdn</span>
            </h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">
                Full CAST Appraisal Specification &bull; Partition Lot @Model.PartitionIndex &bull; Reference TDN: @(string.IsNullOrWhiteSpace(Model.BaseTDN) ? "New Declaration" : Model.BaseTDN)
            </p>
        </div>
        <div class="flex items-center gap-2.5">
            <button type="button" onclick="cancelAndReturn()" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm transition-all">
                Cancel & Return
            </button>
            <button type="button" onclick="submitPartitionForm()" class="w-full sm:w-auto text-center px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs font-mono flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                <i data-lucide="save" class="w-4 h-4"></i>
                Save & Return to Request
            </button>
        </div>
    </div>

    <!-- Form Container (Wide card matching File Property Assessment Request) -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form id="partitionForm" asp-action="SavePartition" method="post" enctype="multipart/form-data" class="space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" name="index" value="@partitionIndex" id="partitionIndexInput" />
            <input type="hidden" name="requestId" value="@requestId" id="requestIdInput" />
            <input type="hidden" name="returnUrl" value="@returnUrl" id="returnUrlInput" />
            <input type="hidden" name="partitionJsonPayload" id="partitionJsonPayload" />
            <input type="hidden" asp-for="BasePropertyId" />
            <input type="hidden" asp-for="OwnerId" id="inputPartitionOwnerId" />
            <input type="hidden" asp-for="BaseTDN" />
            <input type="hidden" asp-for="PartitionIndex" />
            <input type="hidden" asp-for="PropertyLocation" id="inputPropertyLocation" />
            <input type="hidden" asp-for="TotalBuildingAreaSqm" id="inputTotalBuildingAreaSqm" />
            <input type="hidden" asp-for="AdministratorAddress" id="inputAdminAddress" />
            <input type="hidden" asp-for="AdministratorContactNo" id="inputAdminContact" />
            <input type="hidden" asp-for="AdministratorTin" id="inputAdminTin" />
            <input type="hidden" asp-for="AdministratorGender" id="inputAdminGender" />
            <input type="hidden" asp-for="AdministratorCivilStatus" id="inputAdminCivilStatus" />
            <input type="hidden" asp-for="AdministratorEmail" id="inputAdminEmail" />

            <!-- Hidden JSON storage for Floor Breakdown & Additions -->
            <input type="hidden" asp-for="BuildingFloorBreakdownJson" id="buildingFloorBreakdownJson" />
            <input type="hidden" asp-for="BaseRcnValue" id="baseRcnValue" />
            <input type="hidden" asp-for="BuildingAdditionalItemsJson" id="buildingAdditionalItemsJson" />
            <input type="hidden" asp-for="BuildingTotalAdditionsValue" id="buildingTotalAdditionsValue" />
            <input type="hidden" asp-for="BuildingDepreciationAccumulated" id="buildingDepreciationAccumulated" />
            <input type="hidden" asp-for="BuildingDepreciatedMarketValue" id="buildingDepreciatedMarketValue" />
            <input type="hidden" asp-for="AttachmentsJson" id="AttachmentsJson" />

            <!-- Tracking & Status Badge Header -->
            <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3 flex-wrap">
                    <span class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-extrabold text-xs font-mono">
                        PARTITION LOT @Model.PartitionIndex
                    </span>
                    <span class="text-slate-700 dark:text-stone-300 text-xs font-mono font-bold">
                        TDN: <span class="text-emerald-700 dark:text-emerald-400 font-mono font-bold" id="bannerDisplayTdn">@displayTdn</span>
                    </span>
                    <span class="text-slate-700 dark:text-stone-300 text-xs font-mono font-bold">
                        &bull; ARP NO: <span class="text-emerald-700 dark:text-emerald-400 font-mono font-bold" id="bannerDisplayArpNo">@(string.IsNullOrWhiteSpace(Model.ARPNo) ? "187-00-0000-000-000" : Model.ARPNo)</span>
                    </span>
                    <span class="text-slate-500 dark:text-stone-400 text-[11px] font-mono">
                        &bull; Reference Base TDN: @(string.IsNullOrWhiteSpace(Model.BaseTDN) ? "New Declaration" : Model.BaseTDN)
                    </span>
                </div>
            </div>

            <input type="hidden" asp-for="Kind" id="inputKindHidden" value="@(Model.Kind ?? "Land")" />
            <input type="hidden" asp-for="SystemGeneratedTDN" id="inputTdn" />

            <!-- CONTAINER 1: LAND APPRAISAL FORM (CAST SPECIFICATION) -->
            <div id="container-land-appraisal" class="space-y-6 @(Model.Kind == "Building" || Model.Kind == "Machinery" ? "hidden" : "")">
                <partial name="_LandPartitionForm" model="Model" />
            </div>

            <!-- CONTAINER 2: BUILDING APPRAISAL FORM (CAST SPECIFICATION) -->
            <div id="container-building-appraisal" class="space-y-6 @(Model.Kind == "Building" ? "" : "hidden")">
                <partial name="_BuildingPartitionForm" model="Model" />
            </div>

            <!-- CONTAINER 3: MACHINERY APPRAISAL FORM (CAST SPECIFICATION) -->
            <div id="container-machinery-appraisal" class="space-y-6 @(Model.Kind == "Machinery" ? "" : "hidden")">
                <partial name="_MachineryPartitionForm" model="Model" />
            </div> <!-- /#container-machinery-appraisal -->

            <!-- Hidden file input for FairTrack Inspection Photo uploads -->
            <input type="file" id="fileUploadInspectionPhotos" multiple accept="image/*" class="hidden" onchange="handleWebInspectionPhotos(event)" />

            <!-- Submit Button Footer (Matches File Property Assessment Request standard) -->
            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <button type="button" onclick="cancelAndReturn()" class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold font-mono transition-all">
                    Cancel & Return
                </button>
                <button type="button" onclick="submitPartitionForm()" class="w-full sm:w-auto text-center px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold font-mono flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Save Partition Appraisal & Return to Request
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        const returnUrl = "@Html.Raw(returnUrl)";
        const partitionIndex = parseInt("@partitionIndex") || 0;
        const requestId = "@requestId";

        // Land Prerequisites & Dynamic Schedules (CAST Standard)
        window.landClassifications = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandClassifications ?? new List<PropertyAssessmentApp.Models.LandClassification>()));
        window.landSubClassifications = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandSubClassifications ?? new List<PropertyAssessmentApp.Models.LandSubClassification>()));
        window.landActualUses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandActualUses ?? new List<PropertyAssessmentApp.Models.LandActualUse>()));
        window.landAssessmentLevels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandAssessmentLevels ?? new List<PropertyAssessmentApp.Models.LandAssessmentLevel>()));
        window.landAdjustments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandAdjustments ?? new List<PropertyAssessmentApp.Models.LandAdjustmentFactor>()));
        window.landImprovementTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandImprovementTypes ?? new List<PropertyAssessmentApp.Models.LandImprovementType>()));
        window.machineryActualUses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MachineryActualUses ?? new List<PropertyAssessmentApp.Models.MachineryActualUse>()));
        window.machineryAssessmentLevels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MachineryAssessmentLevels ?? new List<PropertyAssessmentApp.Models.MachineryAssessmentLevel>()));
        window.activeAppraisalKind = '@(Model.Kind ?? "Land")';

        function switchAppraisalKind(kind) {
            window.activeAppraisalKind = kind;
            const k = (kind || 'Land').toLowerCase();

            // Reset all 3 buttons
            ['#btnKindLand', '#btnKindBuilding', '#btnKindMachinery'].forEach(sel => {
                $(sel).removeClass('bg-emerald-600 text-white shadow-xs').addClass('text-slate-600 dark:text-stone-400 bg-slate-200 dark:bg-stone-800');
            });

            if (k === 'building') {
                $('#container-building-appraisal').removeClass('hidden');
                $('#container-land-appraisal').addClass('hidden');
                $('#container-machinery-appraisal').addClass('hidden');
                $('#displayKindBadge').text('Building / Structure Appraisal (CAST)');
                $('#inputKindHidden').val('Building');
                $('#btnKindBuilding').removeClass('text-slate-600 dark:text-stone-400 bg-slate-200 dark:bg-stone-800').addClass('bg-emerald-600 text-white shadow-xs');
                $('#container-land-appraisal :input').prop('disabled', true);
                $('#container-machinery-appraisal :input').prop('disabled', true);
                $('#container-building-appraisal :input').prop('disabled', false);
            } else if (k === 'machinery') {
                $('#container-machinery-appraisal').removeClass('hidden');
                $('#container-land-appraisal').addClass('hidden');
                $('#container-building-appraisal').addClass('hidden');
                $('#displayKindBadge').text('Machinery & Equipment Appraisal (CAST)');
                $('#inputKindHidden').val('Machinery');
                $('#btnKindMachinery').removeClass('text-slate-600 dark:text-stone-400 bg-slate-200 dark:bg-stone-800').addClass('bg-emerald-600 text-white shadow-xs');
                $('#container-land-appraisal :input').prop('disabled', true);
                $('#container-building-appraisal :input').prop('disabled', true);
                $('#container-machinery-appraisal :input').prop('disabled', false);
                if (!window.machineryTablesInitialized) {
                    initMachineryFormDynamicTables();
                }
            } else {
                $('#container-land-appraisal').removeClass('hidden');
                $('#container-building-appraisal').addClass('hidden');
                $('#container-machinery-appraisal').addClass('hidden');
                $('#displayKindBadge').text('Land Appraisal / FAAS TDN (CAST)');
                $('#inputKindHidden').val('Land');
                $('#btnKindLand').removeClass('text-slate-600 dark:text-stone-400 bg-slate-200 dark:bg-stone-800').addClass('bg-emerald-600 text-white shadow-xs');
                $('#container-building-appraisal :input').prop('disabled', true);
                $('#container-machinery-appraisal :input').prop('disabled', true);
                $('#container-land-appraisal :input').prop('disabled', false);
            }
            initPartitionBarangayDropdowns();
            if (window.lucide) lucide.createIcons();
        }

        window.switchLandTab = function(tabId) {
            $('.land-tab-content').addClass('hidden');
            $('#' + tabId).removeClass('hidden');
            $('.land-tab-btn').removeClass('bg-emerald-600 text-white shadow-sm').addClass('bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400');
            $('#btn-' + tabId).removeClass('bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400').addClass('bg-emerald-600 text-white shadow-sm');
            setTimeout(function() {
                if (typeof initPartitionBarangayDropdowns === 'function') {
                    initPartitionBarangayDropdowns();
                }
            }, 20);
            if (window.lucide) lucide.createIcons();
        };

        // -------------------------------------------------------------
        // Table 1: Land Appraisal / Classification Rows
        // -------------------------------------------------------------
        function addLandClassificationRow(data = null) {
            const tbody = document.getElementById('landClassificationTableBody');
            if (!tbody) return;

            const row = document.createElement('tr');
            row.className = 'hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors land-class-row';

            const selClassId = data ? (data.ClassificationId || data.classificationId || 1) : 1;
            const selSubClassId = data ? (data.SubClassId || data.subClassId || 1) : 1;
            const selActualUse = data ? (data.ActualUseName || data.actualUseName || 'RESIDENTIAL') : 'RESIDENTIAL';
            const area = data ? (data.AreaSQM || data.areaSQM || data.areaSqMeters || 150) : 150;
            const unitVal = data ? (data.UnitValue || data.unitValue || 520) : 520;
            const marketVal = data ? (data.MarketValue || data.marketValue || (area * unitVal)) : (area * unitVal);

            row.innerHTML = `
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold class-dropdown text-xs cursor-pointer">
                        ${window.landClassifications.map(c => `<option value="${c.Id}" ${c.Id == selClassId ? 'selected' : ''}>${c.ClassificationName}</option>`).join('')}
                    </select>
                </td>
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-medium subclass-dropdown text-xs cursor-pointer">
                    </select>
                </td>
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-medium actualuse-dropdown text-xs cursor-pointer">
                        ${window.landActualUses.map(a => `<option value="${a.ActualUseName}" ${a.ActualUseName == selActualUse ? 'selected' : ''}>${a.ActualUseName}</option>`).join('')}
                    </select>
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-24 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs area-input" value="${area}" />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-24 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs unitval-input font-bold" value="${unitVal}" />
                </td>
                <td class="p-2.5 text-right font-mono font-bold text-slate-900 dark:text-white mv-cell">
                    ₱${marketVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                </td>
                <td class="p-2.5 text-center">
                    <button type="button" onclick="removeLandRow(this)" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Row">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            const classSelect = row.querySelector('.class-dropdown');
            const subClassSelect = row.querySelector('.subclass-dropdown');
            const unitValInput = row.querySelector('.unitval-input');
            const areaInput = row.querySelector('.area-input');

            function updateSubClasses(selectedSubId = null) {
                const classId = classSelect.value;
                const subs = window.landSubClassifications.filter(s => s.ClassificationId == classId);
                if (subs.length > 0) {
                    subClassSelect.innerHTML = subs.map(s => `<option value="${s.Id}" data-unitval="${s.UnitValue}" ${(selectedSubId && s.Id == selectedSubId) ? 'selected' : ''}>${s.SubClass} (₱${s.UnitValue.toLocaleString()})</option>`).join('');
                    if (!selectedSubId) {
                        unitValInput.value = subs[0].UnitValue;
                    }
                } else {
                    subClassSelect.innerHTML = `<option value="">Standard Base</option>`;
                }
            }

            classSelect.addEventListener('change', function () {
                updateSubClasses();
                recomputeLandClassRow(row);
            });

            subClassSelect.addEventListener('change', function () {
                const opt = this.options[this.selectedIndex];
                if (opt && opt.getAttribute('data-unitval')) {
                    unitValInput.value = opt.getAttribute('data-unitval');
                }
                recomputeLandClassRow(row);
            });

            areaInput.addEventListener('input', () => recomputeLandClassRow(row));
            unitValInput.addEventListener('input', () => recomputeLandClassRow(row));

            updateSubClasses(selSubClassId);
            recomputeLandClassRow(row);
            if (window.lucide) lucide.createIcons();
        }

        function recomputeLandClassRow(row) {
            const area = parseFloat(row.querySelector('.area-input').value) || 0;
            const unitVal = parseFloat(row.querySelector('.unitval-input').value) || 0;
            const mv = Math.round((area * unitVal) * 100) / 100;
            row.querySelector('.mv-cell').textContent = `₱${mv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            row.setAttribute('data-mv', mv);
            row.setAttribute('data-area', area);
            recomputeAllLandValuation();
        }

        // -------------------------------------------------------------
        // Table 2: Other Improvements / Plants & Trees
        // -------------------------------------------------------------
        function addLandImprovementRow(data = null) {
            const tbody = document.getElementById('landImprovementTableBody');
            if (!tbody) return;

            const row = document.createElement('tr');
            row.className = 'hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors land-imp-row';

            const selTypeId = data ? (data.TypeId || data.typeId || 1) : 1;
            const isFruit = data ? (data.IsFruitBearing !== false && data.isFruitBearing !== false) : true;
            const qty = data ? (data.Quantity || data.quantity || 10) : 10;
            const age = data ? (data.AgeYears || data.ageYears || 5) : 5;
            const unitVal = data ? (data.UnitValue || data.unitValue || 120) : 120;
            const marketVal = data ? (data.MarketValue || data.marketValue || (qty * unitVal)) : (qty * unitVal);

            row.innerHTML = `
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold imp-type-dropdown text-xs cursor-pointer">
                        ${window.landImprovementTypes.map(i => `<option value="${i.Id}" data-baseval="${i.BaseValue}" data-kind="${i.Kind}" ${i.Id == selTypeId ? 'selected' : ''}>${i.TypeDescription} (${i.Kind})</option>`).join('')}
                    </select>
                </td>
                <td class="p-2.5 text-center">
                    <input type="checkbox" class="rounded border-slate-300 text-teal-600 focus:ring-teal-500 w-4 h-4 imp-fruit-cb" ${isFruit ? 'checked' : ''} />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-20 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs imp-qty-input" value="${qty}" />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" class="w-16 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs imp-age-input" value="${age}" />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-24 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs imp-unitval-input font-bold" value="${unitVal}" />
                </td>
                <td class="p-2.5 text-right font-mono font-bold text-slate-900 dark:text-white imp-mv-cell">
                    ₱${marketVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                </td>
                <td class="p-2.5 text-center">
                    <button type="button" onclick="removeLandRow(this)" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Row">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            const typeSelect = row.querySelector('.imp-type-dropdown');
            const unitValInput = row.querySelector('.imp-unitval-input');
            const qtyInput = row.querySelector('.imp-qty-input');

            typeSelect.addEventListener('change', function () {
                const opt = this.options[this.selectedIndex];
                if (opt && opt.getAttribute('data-baseval')) {
                    unitValInput.value = opt.getAttribute('data-baseval');
                }
                recomputeLandImpRow(row);
            });

            qtyInput.addEventListener('input', () => recomputeLandImpRow(row));
            unitValInput.addEventListener('input', () => recomputeLandImpRow(row));

            recomputeLandImpRow(row);
            if (window.lucide) lucide.createIcons();
        }

        function recomputeLandImpRow(row) {
            const qty = parseFloat(row.querySelector('.imp-qty-input').value) || 0;
            const unitVal = parseFloat(row.querySelector('.imp-unitval-input').value) || 0;
            const mv = Math.round((qty * unitVal) * 100) / 100;
            row.querySelector('.imp-mv-cell').textContent = `₱${mv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            row.setAttribute('data-mv', mv);
            recomputeAllLandValuation();
        }

        // -------------------------------------------------------------
        // Table 3: Base Market Value & Adjustments
        // -------------------------------------------------------------
        function addLandAdjustmentRow(data = null) {
            const tbody = document.getElementById('landAdjustmentTableBody');
            if (!tbody) return;

            const row = document.createElement('tr');
            row.className = 'hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors land-adj-row';

            const selClass = data ? (data.ClassificationName || data.classificationName || 'RESIDENTIAL') : 'RESIDENTIAL';
            const baseMv = data ? (data.BaseMarketValue || data.baseMarketValue || 78000) : 78000;
            const selAdjId = data ? (data.AdjustmentFactorId || data.adjustmentFactorId || 1) : 1;
            const pct = data ? (data.PercentAdjustment || data.percentAdjustment || 0) : 0;
            const valAdj = data ? (data.ValueAdjustment || data.valueAdjustment || (baseMv * (pct / 100))) : (baseMv * (pct / 100));
            const adjMv = data ? (data.AdjustedMarketValue || data.adjustedMarketValue || (baseMv + valAdj)) : (baseMv + valAdj);

            row.innerHTML = `
                <td class="p-2.5">
                    <input type="text" class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold adj-class-input text-xs" value="${selClass}" />
                </td>
                <td class="p-2.5 text-right">
