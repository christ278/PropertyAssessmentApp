                // Percentage based items (e.g. Carport 30%, Mezzanine 60%, Porch 40%, Balcony 45%, Second hand -10%)
                const baseUnitVal = parseFloat($('#inputUnitValue').val()) || parseFloat($('#modalFloorUnitCost').val()) || 10000;
                $('#modalAddItemRate').val(baseUnitVal.toFixed(2));
                $('#modalAddItemPercent').val(pct.toFixed(0));
            } else {
                $('#modalAddItemRate').val('0.00');
                $('#modalAddItemPercent').val('100');
            }
        }

