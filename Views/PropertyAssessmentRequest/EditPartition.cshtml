        function removePartitionPhoto(id, e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            if (!confirm('Are you sure you want to remove this inspection photo?')) return;

            partitionInspectionPhotos = partitionInspectionPhotos.filter((p, idx) => {
                const pid = p.id || p.Id || ('photo_' + idx);
                return pid !== id;
