                                <option value="Reinforced Concrete (RC)">Reinforced Concrete (RC)</option>
                                <option value="Steel (S)">Steel (S)</option>
                                <option value="Wood / Timber (W)">Wood / Timber (W)</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="StructuralBeams" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">3. BEAMS</label>
                            <select asp-for="StructuralBeams" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-xs font-mono focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Reinforced Concrete (RC)">Reinforced Concrete (RC)</option>
                                <option value="Steel (S)">Steel (S)</option>
                                <option value="Wood / Timber (W)">Wood / Timber (W)</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="StructuralTrussRoof" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">4. ROOF FRAMING / TRUSS</label>
                            <select asp-for="StructuralTrussRoof" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-xs font-mono focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Steel Truss (S)">Steel Truss (S)</option>
                                <option value="Reinforced Concrete (RC)">Reinforced Concrete (RC)</option>
                                <option value="Wood / Timber (W)">Wood / Timber (W)</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="StructuralRoof" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">5. ROOFING</label>
                            <select asp-for="StructuralRoof" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-xs font-mono focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Long Span G.I. Sheet (LGI)">Long Span G.I. Sheet (LGI)</option>
                                <option value="Corrugated G.I. Sheet (CGI)">Corrugated G.I. Sheet (CGI)</option>
                                <option value="Concrete Slab (CS)">Concrete Slab (CS)</option>
                                <option value="Ceramic / Clay Tiles (CT)">Ceramic / Clay Tiles (CT)</option>
                                <option value="Solid Polycarbonate (SPC)">Solid Polycarbonate (SPC)</option>
                                <option value="Aluminum (Al)">Aluminum (Al)</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="StructuralExteriorWalls" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">6. EXTERIOR WALLS</label>
                            <select asp-for="StructuralExteriorWalls" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-xs font-mono focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Concrete Hollow Block (CHB)">Concrete Hollow Block (CHB)</option>
                                <option value="Reinforced Concrete (RC)">Reinforced Concrete (RC)</option>
                                <option value="Aluminum Composite (ALP)">Aluminum Composite (ALP)</option>
                                <option value="Plain Concrete (PC)">Plain Concrete (PC)</option>
                                <option value="Wood / Timber (W)">Wood / Timber (W)</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="StructuralFlooring" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">7. FLOORING</label>
                            <select asp-for="StructuralFlooring" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-xs font-mono focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Reinforced Concrete Slab (RC)">Reinforced Concrete Slab (RC)</option>
                                <option value="Plain Cement (PC)">Plain Cement (PC)</option>
                                <option value="Wood Planks / T&G (W)">Wood Planks / T&G (W)</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="DoorMain" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">8. DOORS</label>
                            <select asp-for="DoorMain" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-xs font-mono focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="Wood Panel (WP)">Wood Panel (WP)</option>
                                <option value="Glass / Aluminum (G/Al)">Glass / Aluminum (G/Al)</option>
