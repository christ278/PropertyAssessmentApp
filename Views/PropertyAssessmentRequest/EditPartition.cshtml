        // CAST-Aligned Real-Time Valuation & Reference Table Engine
        function formatIsoDate(d) {
            if (!d) return '';
            if (typeof d === 'string') {
                return d.length >= 10 ? d.substring(0, 10) : d;
            }
            return '';
        }

        function calculateBuildingAgeFromDates() {
            const dateVal = $('input[name="DateConstructed"]').val() || $('input[name="DateCompleted"]').val();
            if (!dateVal) return;
            const yearMatch = dateVal.match(/^(\d{4})/);
            const constructedYear = yearMatch ? parseInt(yearMatch[1], 10) : new Date(dateVal).getFullYear();
            if (isNaN(constructedYear)) return;
            const currentYear = new Date().getFullYear();
            const age = Math.max(0, currentYear - constructedYear);
            $('#inputBuildingAge').val(age);
            lookupSuggestedDepreciationRate();
        }

        function lookupSuggestedDepreciationRate() {
            const age = parseInt($('#inputBuildingAge').val()) || 0;
            const structuralType = $('select[name="StructuralType"]').val() || "I-A";
            const actualUse = $('input[name="ActualUse"]').val() || $('select[name="Classification"]').val() || "RESIDENTIAL";

            $.ajax({
                url: '/PropertyAssessmentRequest/GetDepreciationRate',
                type: 'GET',
                data: { structuralType: structuralType, actualUse: actualUse, age: age, maintenance: "AVERAGE" },
                success: function (res) {
                    if (res && res.success && res.depreciationRate !== undefined) {
                        $('#inputDeprPercent').val(res.depreciationRate);
                        recalculateValuation(true);
                    }
                }
            });
        }

        function autoLookupAssessmentLevel(marketVal) {
            if (!marketVal || marketVal <= 0) return;
            const actualUse = $('input[name="ActualUse"]').val() || $('select[name="Classification"]').val() || "RESIDENTIAL";

            $.ajax({
                url: '/PropertyAssessmentRequest/GetAssessmentLevel',
                type: 'GET',
                data: { actualUse: actualUse, marketValue: marketVal },
                success: function (res) {
                    if (res && res.success && res.assessmentLevel !== undefined) {
                        $('#inputAssessLevel').val(res.assessmentLevel);
                        updateAssessedValueAndTaxes(marketVal, res.assessmentLevel);
                    }
                }
            });
        }

        function updateAssessedValueAndTaxes(marketVal, assessLevel) {
            const assessedVal = Math.round(marketVal * (assessLevel / 100.0) * 100) / 100;
            $('#inputAssessedValue').val(assessedVal.toFixed(2));

            const basicRpt = Math.round(assessedVal * 0.02 * 100) / 100;
            const sefTax = Math.round(assessedVal * 0.01 * 100) / 100;
            const totalTax = basicRpt + sefTax;

            $('#kpiAssessedVal').text('₱' + assessedVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#kpiBasicRpt').text('₱' + basicRpt.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (RPT)');
            $('#kpiSefTax').text('₱' + sefTax.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (SEF)');
            $('#kpiAnnualTax').text('₱' + totalTax.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        }

        function recalculateValuation(skipAssessmentLookup) {
            let baseRcn = parseFloat($('#baseRcnValue').val()) || 0;
            if (baseRcn <= 0) {
                const area = parseFloat($('#inputAssessedArea').val()) || 0;
                const unitVal = parseFloat($('#inputUnitValue').val()) || 0;
                baseRcn = area * unitVal;
            }
            const deprRate = parseFloat($('#inputDeprPercent').val()) || 0;
            const accDepr = Math.round(baseRcn * (deprRate / 100.0) * 100) / 100;
            const depreciatedCore = Math.max(0, Math.round((baseRcn - accDepr) * 100) / 100);
            const totalAdditions = parseFloat($('#buildingTotalAdditionsValue').val()) || 0;
            const finalMarketVal = Math.round((depreciatedCore + totalAdditions) * 100) / 100;

            $('#buildingDepreciationAccumulated').val(accDepr.toFixed(2));
            $('#buildingDepreciatedMarketValue').val(depreciatedCore.toFixed(2));
            $('#inputMarketValue').val(finalMarketVal.toFixed(2));

            const assessLevel = parseFloat($('#inputAssessLevel').val()) || 20;
            updateAssessedValueAndTaxes(finalMarketVal, assessLevel);

            $('#kpiBaseRcn').text('₱' + baseRcn.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#kpiDepreciation').text('-₱' + accDepr.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ` (${deprRate}%)`);
            $('#kpiDepreciatedCore').text('₱' + depreciatedCore.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#kpiAdditions').text('+₱' + totalAdditions.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#kpiMarketValue').text('₱' + finalMarketVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

            if (!skipAssessmentLookup && finalMarketVal > 0) {
                autoLookupAssessmentLevel(finalMarketVal);
            }
        }

