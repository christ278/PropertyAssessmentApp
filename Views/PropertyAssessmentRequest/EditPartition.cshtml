                                @if (ViewBag.BuildingStructuralTypes != null)
                                {
                                    foreach (var st in (IEnumerable<PropertyAssessmentApp.Models.BuildingStructuralType>)ViewBag.BuildingStructuralTypes)
                                    {
                                        <option value="@st.StructuralCode">@st.StructuralCode – @st.StructuralDescription</option>
                                    }
                                }
                                else
                                {
                                    <option value="I-A">I-A – REINFORCED CONCRETE - A</option>
                                    <option value="I-B">I-B – REINFORCED CONCRETE - B</option>
                                    <option value="II-A">II-A – MIXED CONCRETE - A</option>
                                    <option value="II-B">II-B – MIXED CONCRETE - B</option>
                                    <option value="III-A">III-A – WOOD - A</option>
                                    <option value="IV-A">IV-A – LIGHT MATERIALS</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="BuildingClassification" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                                <span>BUILDING CLASSIFICATION</span>
                                <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono font-bold">DATABASE LOOKUP</span>
                            </label>
                            <select asp-for="BuildingClassification" id="selectBuildingClassification" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                                <option value="">-- Select Building Classification --</option>
                                @if (ViewBag.BuildingClassifications != null)
                                {
                                    foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.BuildingClassifications)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                                else
                                {
                                    <option value="Class A - Reinforced Concrete">Class A - Reinforced Concrete</option>
                                    <option value="Class B - Semi-Concrete / Hollow Blocks">Class B - Semi-Concrete / Hollow Blocks</option>
                                    <option value="Class C - Reinforced Concrete & Wood">Class C - Reinforced Concrete & Wood</option>
                                    <option value="Class D - Wood / Timber Frame">Class D - Wood / Timber Frame</option>
                                    <option value="Class E - Light Materials / Mixed">Class E - Light Materials / Mixed</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="NoOfStoreys" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TOTAL STOREY COUNT</label>
                            <input asp-for="NoOfStoreys" id="inputNoOfStoreys" type="number" min="1" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono font-bold text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" />
                        </div>
                        <div>
                            <label asp-for="BuildingPermitNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BUILDING PERMIT NO.</label>
                            <input asp-for="BuildingPermitNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="BP-XXXX-XXXX" />
                        </div>
                        <div>
                            <label asp-for="OccupancyPermitNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OCCUPANCY PERMIT NO.</label>
                            <input asp-for="OccupancyPermitNo" id="inputOccupancyPermitNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="OP-XXXX-XXXX" />
                        </div>
                        <div>
                            <label asp-for="BuildingAgeYears" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BUILDING AGE (YEARS)</label>
                            <input asp-for="BuildingAgeYears" id="inputBuildingAge" type="number" min="0" value="@(Model.BuildingAgeYears > 0 ? Model.BuildingAgeYears.ToString() : (Model.BuildingAge > 0 ? Model.BuildingAge.ToString() : ""))" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right font-bold text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" />
                        </div>
                        <div>
                            <label asp-for="DateConstructed" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DATE CONSTRUCTED / STARTED</label>
                            <input asp-for="DateConstructed" type="date" asp-format="{0:yyyy-MM-dd}" value="@(Model.DateConstructed?.ToString("yyyy-MM-dd"))" id="inputDateConstructed" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" />
                        </div>
                        <div>
                            <label asp-for="DateCompleted" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DATE COMPLETED</label>
                            <input asp-for="DateCompleted" type="date" asp-format="{0:yyyy-MM-dd}" value="@(Model.DateCompleted?.ToString("yyyy-MM-dd"))" id="inputDateCompleted" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" />
                        </div>
