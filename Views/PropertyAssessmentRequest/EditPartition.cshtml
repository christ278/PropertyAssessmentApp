                            <label asp-for="DateOccupied" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DATE OCCUPIED</label>
                            <input asp-for="DateOccupied" type="date" asp-format="{0:yyyy-MM-dd}" value="@(Model.DateOccupied?.ToString("yyyy-MM-dd"))" id="inputDateOccupied" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" />
                        </div>
                    </div>
