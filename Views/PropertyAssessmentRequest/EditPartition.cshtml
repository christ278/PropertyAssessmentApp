        function autoGeneratePropertyAssessmentRoll() {
            let totalAdjLandMv = 0;
            document.querySelectorAll('.land-adj-row').forEach(r => {
                totalAdjLandMv += parseFloat(r.getAttribute('data-adjmv')) || 0;
            });

            if (totalAdjLandMv === 0) {
                document.querySelectorAll('.land-class-row').forEach(r => {
                    totalAdjLandMv += parseFloat(r.getAttribute('data-mv')) || 0;
                });
            }

            let totalImpMv = 0;
            document.querySelectorAll('.land-imp-row').forEach(r => {
                totalImpMv += parseFloat(r.getAttribute('data-mv')) || 0;
            });

            const tbody = document.getElementById('landPropertyAssessmentTableBody');
            if (tbody) tbody.innerHTML = '';

            if (totalAdjLandMv > 0) {
                addLandPropertyAssessmentRow({
                    Kinds: 'LAND',
                    ActualUseName: 'RESIDENTIAL',
                    MarketValue: totalAdjLandMv,
                    AssessmentLevelPercent: 20
                });
            }

            if (totalImpMv > 0) {
                addLandPropertyAssessmentRow({
                    Kinds: 'PLANTS / TREES',
                    ActualUseName: 'AGRICULTURAL',
                    MarketValue: totalImpMv,
                    AssessmentLevelPercent: 40
                });
            }
