            if (totalAdjLandMv > 0) {
                addLandPropertyAssessmentRow({
                    Kinds: 'LAND',
                    ActualUseName: 'RESIDENTIAL',
                    MarketValue: totalAdjLandMv,
                    AssessmentLevelPercent: 20
                });
