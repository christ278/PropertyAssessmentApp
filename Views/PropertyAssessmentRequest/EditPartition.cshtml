                        if (dOcc) $('input[name="DateOccupied"]').val(dOcc);

                        const bAge = (p.buildingAgeYears !== undefined && p.buildingAgeYears !== null && p.buildingAgeYears !== '') ? p.buildingAgeYears
                            : ((p.BuildingAgeYears !== undefined && p.BuildingAgeYears !== null && p.BuildingAgeYears !== '') ? p.BuildingAgeYears
                            : (p.buildingAge ?? p.BuildingAge));
                        if (bAge !== undefined && bAge !== null && bAge !== '') {
                            $('#inputBuildingAge').val(bAge);
                        }

                        // 17 Materials
                        const matKeys = ['StructuralFoundation', 'StructuralColumns', 'StructuralBeams', 'StructuralTrussRoof', 'StructuralRoof', 'StructuralExteriorWalls', 'StructuralFlooring', 'DoorMain', 'Ceiling', 'StructuralWindows', 'StructuralStairs', 'StructuralPartitionWalls', 'StructuralFloorFinish', 'StructuralFinishFront', 'ElectricalSystem', 'ToiletAndBathroom', 'PlumbingSewer'];
                        matKeys.forEach(k => {
                            const val = p[k] || p[k.charAt(0).toLowerCase() + k.slice(1)];
                            if (val) $(`select[name="${k}"]`).val(val);
                        });

                        // Floor breakdowns & additions
                        const floorJson = p.buildingFloorBreakdownJson || p.BuildingFloorBreakdownJson;
                        if (floorJson && !$('#buildingFloorBreakdownJson').val()) {
                            $('#buildingFloorBreakdownJson').val(floorJson);
                        }
                        const addJson = p.buildingAdditionalItemsJson || p.BuildingAdditionalItemsJson;
                        if (addJson && !$('#buildingAdditionalItemsJson').val()) {
                            $('#buildingAdditionalItemsJson').val(addJson);
                        }

                        // Depreciation Rate (handles both BuildingDepreciationPercent and depreciationRate)
                        const loadedDepr = (p.buildingDepreciationPercent !== undefined && p.buildingDepreciationPercent !== null) ? p.buildingDepreciationPercent
                            : ((p.BuildingDepreciationPercent !== undefined && p.BuildingDepreciationPercent !== null) ? p.BuildingDepreciationPercent
                            : (p.depreciationRate ?? p.DepreciationRate));
                        if (loadedDepr !== undefined && loadedDepr !== null && loadedDepr !== '') {
                            $('#inputDeprPercent').val(loadedDepr);
                        }

                        // Effectivity, Taxability & Back Taxes (Tab 4)
                        const taxabilityVal = p.taxability || p.Taxability;
                        if (taxabilityVal) $('select[name="Taxability"]').val(taxabilityVal);

                        const effQuarterVal = p.effectivityQuarter || p.EffectivityQuarter;
                        if (effQuarterVal) $('select[name="EffectivityQuarter"]').val(effQuarterVal);

                        const effYearVal = (p.effectivityYear !== undefined && p.effectivityYear !== null) ? p.effectivityYear : p.EffectivityYear;
                        if (effYearVal) $('input[name="EffectivityYear"]').val(effYearVal);

                        const assessBasisVal = p.assessmentBasis || p.AssessmentBasis;
                        if (assessBasisVal) $('input[name="AssessmentBasis"]').val(assessBasisVal);

                        const btFrom = (p.backTaxesYearFrom !== undefined && p.backTaxesYearFrom !== null) ? p.backTaxesYearFrom : p.BackTaxesYearFrom;
                        if (btFrom !== undefined && btFrom !== null && btFrom !== '') $('input[name="BackTaxesYearFrom"]').val(btFrom);

                        const btTo = (p.backTaxesYearTo !== undefined && p.backTaxesYearTo !== null) ? p.backTaxesYearTo : p.BackTaxesYearTo;
                        if (btTo !== undefined && btTo !== null && btTo !== '') $('input[name="BackTaxesYearTo"]').val(btTo);

                        const memoVal = p.memoranda || p.Memoranda;
                        if (memoVal) $('textarea[name="Memoranda"]').val(memoVal);
                    }
                }

                const existingFloors = $('#buildingFloorBreakdownJson').val();
                if (existingFloors) {
                    buildingFloors = JSON.parse(existingFloors);
                    renderFloors();
                }
                const existingAdditions = $('#buildingAdditionalItemsJson').val();
                if (existingAdditions) {
                    buildingAdditions = JSON.parse(existingAdditions);
                    renderAdditions();
                }
                recalculateValuation(true);
            } catch (err) {
                console.error('JSON load error:', err);
            }

            // Listeners for Storey count, Structural type & Building classification synchronization
            $('#inputNoOfStoreys').on('input change', function () {
                const count = parseInt($(this).val()) || 1;
                $('#labelStoreyCountHint').text(`TOTAL STOREY COUNT: ${count}`);
            });

            $('select[name="StructuralType"]').on('change', function () {
                const newStruct = $(this).val();
                toastr.info(`Structural Type set to ${newStruct}. BUCC schedule rates updated.`, 'BUCC Schedule');
                updateExistingFloorsUnitCost(newStruct);
                if (!$('#addFloorModal').hasClass('hidden')) {
                    fetchModalFloorUnitCost();
                }
            });

            $('#selectBuildingClassification').on('change', function () {
                const bldgVal = $(this).val();
                if (bldgVal && !$('#modalFloorBuildingClass').val()) {
                    $('#modalFloorBuildingClass').val(bldgVal);
                }
            });

            // Wire Building Age & Depreciation auto-computation listeners
            $('input[name="DateConstructed"], input[name="DateCompleted"]').on('change input', calculateBuildingAgeFromDates);
            $('#inputBuildingAge').on('change input', lookupSuggestedDepreciationRate);

            $('#inputDeprPercent, #inputAssessedArea, #inputUnitValue').on('input', function () {
                recalculateValuation(false);
            });

            $('#inputAssessLevel').on('input', function () {
                const fmv = parseFloat($('#inputMarketValue').val()) || 0;
                const lvl = parseFloat($(this).val()) || 0;
                updateAssessedValueAndTaxes(fmv, lvl);
            });

            recalculateValuation();
        });
    </script>
}
