        function saveFloorLevel() {
            const level = $('#modalFloorLevel').val();
            const bldgClass = $('#modalFloorBuildingClass').val();
            const rateMode = $('#modalFloorRateMode').val() || "Min";
            const desc = $('#modalFloorDesc').val() || bldgClass || level;
            const area = parseFloat($('#modalFloorArea').val()) || 0;
            const unitCost = parseFloat($('#modalFloorUnitCost').val()) || 0;

            if (!level) {
                toastr.warning('Please select a Target Floor / Level.', 'Floor Required');
                return;
            }
            if (!bldgClass) {
                toastr.warning('Please select a Building Classification.', 'Classification Required');
                return;
            }
            if (area <= 0) {
                toastr.warning('Please enter valid floor area.', 'Area Required');
                return;
            }
            if (unitCost <= 0) {
                toastr.warning('Please enter or verify BUCC Unit Cost (PHP/sq.m.).', 'Unit Cost Required');
                return;
            }

            const marketVal = Math.round(area * unitCost * 100) / 100;
            buildingFloors.push({
                floorNumber: level,
                buildingClassification: bldgClass,
                rateMode: rateMode,
                description: desc,
                floorAreaSqm: area,
                baseUnitCost: unitCost,
                marketValue: marketVal
            });

            closeAddFloorModal();
            renderFloors();
            recalculateValuation();
            toastr.success(`${level} (${bldgClass}) added to BUCC schedule.`);
