        function resolveMachineryAssessmentLevel(actualUseNameOrId) {
            const levels = window.machineryAssessmentLevels || [];
            if (!actualUseNameOrId) return 75;
            const raw = String(actualUseNameOrId).trim().toUpperCase();

            // Prefer RevisionYear 2011 or latest
            const matches = levels.filter(l =>
                String(l.ActualUseId) === raw ||
                (l.ActualUseName && l.ActualUseName.toUpperCase() === raw) ||
                (l.ActualUseName && raw.includes(l.ActualUseName.toUpperCase()))
            );
            if (matches.length > 0) {
                matches.sort((a, b) => (b.RevisionYear || 0) - (a.RevisionYear || 0));
                return parseFloat(matches[0].AssessmentLevel) || 75;
            }
            if (raw.includes('RES')) return 45;
            if (raw.includes('AGR')) return 35;
            if (raw.includes('SPEC') || raw.includes('CUL') || raw.includes('SCI') || raw.includes('HOS') || raw.includes('WATER')) return 10;
            if (raw.includes('GOV')) return 5;
            return 75; // Default Commercial / Industrial Machinery Level in CAST
        }

        function openMachineryDetailModal(editIndex = -1) {
            $('#machineryModalEditIndex').val(editIndex);
            const todayIso = new Date().toISOString().split('T')[0];
            const currentYear = new Date().getFullYear();

            if (editIndex >= 0 && window.machineryDetailsList[editIndex]) {
                const item = window.machineryDetailsList[editIndex];
                $('#machineryModalTitle span').text('Edit Machinery Appraisal Detail (CAST Specification)');
                const classification = item.Classification || item.classification || item.KindOfMachinery || item.kindOfMachinery || 'INDUSTRIAL';
                const descriptBrand = item.DescriptionBrand || item.descriptionBrand || item.BrandModel || item.brandModel || '';
                const origCost = parseFloat(item.OriginalCost ?? item.originalCost) || 0;
                const installCost = parseFloat(item.InstallationCost ?? item.installationCost) || 0;
                const totalCost = parseFloat(item.TotalCost ?? item.totalCost) || (origCost + installCost);
                const estLife = parseInt(item.EconomicLifeEstimated ?? item.economicLifeEstimated) || 20;
                const yrsUsed = parseInt(item.NoOfYearsUsed ?? item.noOfYearsUsed) || 0;
                const remLife = Math.max(0, estLife - yrsUsed);

                let yrInst = item.YearInstalled ?? item.yearInstalled;
                if (!yrInst && (item.DateOfInstallation || item.dateOfInstallation)) {
                    const parsedInst = new Date(item.DateOfInstallation || item.dateOfInstallation).getFullYear();
                    if (!isNaN(parsedInst)) yrInst = parsedInst;
                }
                let yrOp = item.YearOfOperation ?? item.yearOfOperation;
                if (!yrOp && (item.DateOfOperation || item.dateOfOperation)) {
                    const parsedOp = new Date(item.DateOfOperation || item.dateOfOperation).getFullYear();
                    if (!isNaN(parsedOp)) yrOp = parsedOp;
                }

                $('#m_Classification').val(classification);
                $('#m_BrandModel').val(descriptBrand);
                $('#m_Capacity').val(item.Capacity || item.capacity || '');
                $('#m_Condition').val(item.ConditionWhenAcquired || item.conditionWhenAcquired || 'NEW');
                $('#m_AcquiredDate').val(formatIsoDate(item.AcquiredDate || item.acquiredDate) || todayIso);
                $('#m_EstLife').val(estLife);
                $('#m_YearInstalled').val(yrInst || currentYear);
                $('#m_YearOperation').val(yrOp || currentYear);
                $('#m_OriginalCost').val(origCost.toFixed(2));
                $('#m_InstallationCost').val(installCost.toFixed(2));
                $('#m_TotalCost').val(totalCost.toFixed(2));
                $('#m_YearsUsed').val(yrsUsed);
                $('#m_RemLife').val(remLife);
                $('#m_DepPercentage').val(item.DepreciationTotalPercentage ?? item.depreciationTotalPercentage ?? 0);
                $('#m_DepValue').val((parseFloat(item.DepreciationTotalValue ?? item.depreciationTotalValue) || 0).toFixed(2));
                $('#m_DepreciatedValue').val((parseFloat(item.DepreciatedValue ?? item.depreciatedValue ?? item.MarketValue ?? item.marketValue) || totalCost).toFixed(2));
            } else {
                $('#machineryModalTitle span').text('Add Machinery Appraisal Detail (CAST Specification)');
                $('#m_Classification').val('INDUSTRIAL');
                $('#m_BrandModel').val('');
                $('#m_Capacity').val('');
                $('#m_Condition').val('NEW');
                $('#m_AcquiredDate').val(todayIso);
                $('#m_EstLife').val(20);
                $('#m_YearInstalled').val(currentYear);
                $('#m_YearOperation').val(currentYear);
                $('#m_OriginalCost').val('');
                $('#m_InstallationCost').val('0.00');
                $('#m_TotalCost').val('0.00');
                $('#m_YearsUsed').val(0);
                $('#m_RemLife').val(20);
                $('#m_DepPercentage').val(0);
                $('#m_DepValue').val('0.00');
                $('#m_DepreciatedValue').val('0.00');
            }

            $('#machineryDetailModal').removeClass('hidden');
            if (window.lucide) lucide.createIcons();
        }

        function closeMachineryDetailModal() {
            $('#machineryDetailModal').addClass('hidden');
        }

        function onMachineryOperationYearChange() {
            const opYear = parseInt($('#m_YearOperation').val());
            const currentYear = new Date().getFullYear();
            if (!isNaN(opYear) && opYear >= 1900 && opYear <= currentYear) {
                const yrs = Math.max(0, currentYear - opYear);
                $('#m_YearsUsed').val(yrs);
                recomputeMachineryModalValues(false);
            }
        }

        function onMachineryCostInput() {
            const orig = parseFloat($('#m_OriginalCost').val()) || 0;
            const install = parseFloat($('#m_InstallationCost').val()) || 0;
            const totalCost = Math.round((orig + install) * 100) / 100;
            $('#m_TotalCost').val(totalCost.toFixed(2));
            recomputeMachineryModalValues(true);
        }

        function recomputeMachineryModalValues(manualPercentChange = false) {
            const estLife = parseInt($('#m_EstLife').val()) || 0;
            const yearsUsed = parseInt($('#m_YearsUsed').val()) || 0;
            const remLife = Math.max(0, estLife - yearsUsed);
            $('#m_RemLife').val(remLife);

            const orig = parseFloat($('#m_OriginalCost').val()) || 0;
            const install = parseFloat($('#m_InstallationCost').val()) || 0;
            const totalCost = Math.round((orig + install) * 100) / 100;
            $('#m_TotalCost').val(totalCost.toFixed(2));

            let depPct = parseFloat($('#m_DepPercentage').val()) || 0;
            if (!manualPercentChange && estLife > 0 && yearsUsed > 0) {
                depPct = Math.min(80, Math.round(((yearsUsed / estLife) * 100) * 100) / 100);
                $('#m_DepPercentage').val(depPct);
            }

            const depVal = Math.round((totalCost * (depPct / 100.0)) * 100) / 100;
            const marketValLessDep = Math.max(0, Math.round((totalCost - depVal) * 100) / 100);

            $('#m_DepValue').val(depVal.toFixed(2));
            $('#m_DepreciatedValue').val(marketValLessDep.toFixed(2));
        }

        function saveMachineryDetailModal() {
            const classification = ($('#m_Classification').val() || '').trim().toUpperCase();
            const brand = ($('#m_BrandModel').val() || '').trim().toUpperCase();
            const cap = ($('#m_Capacity').val() || '').trim().toUpperCase();
            const origCost = parseFloat($('#m_OriginalCost').val()) || 0;
            const installCost = parseFloat($('#m_InstallationCost').val()) || 0;
            const totalCost = Math.round((origCost + installCost) * 100) / 100;

            if (!classification) {
                if (window.toastr) toastr.warning('Please enter Classification.');
                $('#m_Classification').focus();
                return;
            }
            if (!brand) {
                if (window.toastr) toastr.warning('Please enter Descript/Brand.');
                $('#m_BrandModel').focus();
                return;
            }

            const estLife = parseInt($('#m_EstLife').val()) || 20;
            const yrsUsed = parseInt($('#m_YearsUsed').val()) || 0;
            const remLife = Math.max(0, estLife - yrsUsed);
            const yrInstalled = parseInt($('#m_YearInstalled').val()) || new Date().getFullYear();
            const yrOperation = parseInt($('#m_YearOperation').val()) || new Date().getFullYear();
            const depPct = parseFloat($('#m_DepPercentage').val()) || 0;
            const depVal = Math.round((totalCost * (depPct / 100.0)) * 100) / 100;
            const marketValLessDep = Math.max(0, Math.round((totalCost - depVal) * 100) / 100);

            const detailItem = {
                Classification: classification,
                DescriptionBrand: brand,
                KindOfMachinery: classification,
                BrandModel: brand,
                Capacity: cap || 'N/A',
                ConditionWhenAcquired: $('#m_Condition').val() || 'NEW',
                AcquiredDate: $('#m_AcquiredDate').val() || null,
                EconomicLifeEstimated: estLife,
                YearInstalled: yrInstalled,
                YearOfOperation: yrOperation,
                DateOfInstallation: `${yrInstalled}-01-01`,
                DateOfOperation: `${yrOperation}-01-01`,
                OriginalCost: origCost,
                InstallationCost: installCost,
                TotalCost: totalCost,
                RCN: totalCost,
                NoOfYearsUsed: yrsUsed,
                RemainingEconomicLife: remLife,
                DepreciationTotalPercentage: depPct,
                DepreciationTotalValue: depVal,
                MarketValue: marketValLessDep,
                DepreciatedValue: marketValLessDep
            };

            const editIdx = parseInt($('#machineryModalEditIndex').val());
            if (!isNaN(editIdx) && editIdx >= 0 && editIdx < window.machineryDetailsList.length) {
                window.machineryDetailsList[editIdx] = detailItem;
            } else {
                window.machineryDetailsList.push(detailItem);
            }

            closeMachineryDetailModal();
            renderMachineryAppraisalTable();
            syncMachineryAssessmentRollFromAppraisal();
        }

        function deleteMachineryDetailRow(idx) {
            if (idx >= 0 && idx < window.machineryDetailsList.length) {
                window.machineryDetailsList.splice(idx, 1);
                renderMachineryAppraisalTable();
                syncMachineryAssessmentRollFromAppraisal();
            }
        }

        function renderMachineryAppraisalTable() {
            const tbody = document.getElementById('machineryAppraisalTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            let totalOrig = 0;
            let totalInstall = 0;
            let totalCostSum = 0;
            let totalDepVal = 0;
            let totalDepreciated = 0;

            if (!window.machineryDetailsList || window.machineryDetailsList.length === 0) {
                const emptyTr = document.createElement('tr');
                emptyTr.innerHTML = `<td colspan="17" class="p-4 text-center text-slate-400 italic">No machinery items encoded yet. Click "+ Add Machinery Detail" to add machinery &amp; equipment.</td>`;
                tbody.appendChild(emptyTr);
            } else {
                window.machineryDetailsList.forEach((item, index) => {
                    const classification = item.Classification || item.classification || item.KindOfMachinery || item.kindOfMachinery || 'INDUSTRIAL';
                    const descriptBrand = item.DescriptionBrand || item.descriptionBrand || item.BrandModel || item.brandModel || '';
                    const orig = parseFloat(item.OriginalCost ?? item.originalCost) || 0;
                    const install = parseFloat(item.InstallationCost ?? item.installationCost) || 0;
                    const totalCost = parseFloat(item.TotalCost ?? item.totalCost) || (orig + install);
                    const estLife = parseInt(item.EconomicLifeEstimated ?? item.economicLifeEstimated) || 0;
                    const yrsUsed = parseInt(item.NoOfYearsUsed ?? item.noOfYearsUsed) || 0;
                    const remLife = item.RemainingEconomicLife ?? item.remainingEconomicLife ?? Math.max(0, estLife - yrsUsed);
                    const depPct = parseFloat(item.DepreciationTotalPercentage ?? item.depreciationTotalPercentage) || 0;
                    const depVal = parseFloat(item.DepreciationTotalValue ?? item.depreciationTotalValue) || Math.round((totalCost * (depPct / 100.0)) * 100) / 100;
                    const depreciated = parseFloat(item.DepreciatedValue ?? item.depreciatedValue) || Math.max(0, totalCost - depVal);

                    let yrInst = item.YearInstalled ?? item.yearInstalled;
                    if (!yrInst && (item.DateOfInstallation || item.dateOfInstallation)) {
                        const d = new Date(item.DateOfInstallation || item.dateOfInstallation).getFullYear();
                        if (!isNaN(d)) yrInst = d;
                    }
                    let yrOp = item.YearOfOperation ?? item.yearOfOperation;
                    if (!yrOp && (item.DateOfOperation || item.dateOfOperation)) {
                        const d = new Date(item.DateOfOperation || item.dateOfOperation).getFullYear();
                        if (!isNaN(d)) yrOp = d;
                    }

                    totalOrig += orig;
                    totalInstall += install;
                    totalCostSum += totalCost;
                    totalDepVal += depVal;
                    totalDepreciated += depreciated;

                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors machinery-detail-row';
                    tr.innerHTML = `
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 font-bold text-slate-900 dark:text-white">${classification}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 font-semibold">${descriptBrand}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center font-mono">${item.Capacity || item.capacity || ''}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center">${item.ConditionWhenAcquired || item.conditionWhenAcquired || 'NEW'}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center font-mono">${formatIsoDate(item.AcquiredDate || item.acquiredDate) || '-'}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center font-mono">${estLife}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center font-mono">${yrInst || '-'}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center font-mono">${yrOp || '-'}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-right font-mono">₱${orig.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-right font-mono">₱${install.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-right font-mono font-bold">₱${totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center font-mono">${yrsUsed}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center font-mono font-bold">${remLife}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-center font-mono text-rose-600 dark:text-rose-400">${depPct.toFixed(2)}%</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-right font-mono text-rose-600 dark:text-rose-400">₱${depVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                        <td class="p-2 border-r border-slate-100 dark:border-stone-800 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">₱${depreciated.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                        <td class="p-2 text-center">
                            <div class="inline-flex items-center gap-1">
                                <button type="button" onclick="openMachineryDetailModal(${index})" class="p-1.5 rounded-lg text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 transition-colors" title="Edit Machinery Item">
                                    <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                                </button>
                                <button type="button" onclick="deleteMachineryDetailRow(${index})" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Machinery Item">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            $('#displayMachineryTotalOrigCost').text(`₱${totalOrig.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
            $('#displayMachineryTotalInstallCost').text(`₱${totalInstall.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
            $('#displayMachineryTotalMarketValue').text(`₱${totalCostSum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
            $('#displayMachineryTotalDepValue').text(`₱${totalDepVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
            $('#displayMachineryTotalDepreciatedValue').text(`₱${totalDepreciated.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
            $('#kpiMachineryOrigCost').text(`₱${totalCostSum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);

            serializeAllMachineryTables();
            if (window.lucide) lucide.createIcons();
        }

        function addMachineryAssessmentRollRow(data = null) {
            const tbody = document.getElementById('machineryPropertyAssessmentTableBody');
            if (!tbody) return;

            const activeUses = (window.machineryActualUses || []).filter(u => u.IsActive !== false);
            const useList = activeUses.length > 0 ? activeUses : [
                { Id: 6, ActualUseName: 'INDUSTRIAL' },
                { Id: 4, ActualUseName: 'COMMERCIAL' },
                { Id: 1, ActualUseName: 'RESIDENTIAL' },
                { Id: 48, ActualUseName: 'AGRICULTURAL' },
                { Id: 10, ActualUseName: 'SPECIAL- CULTURAL' },
                { Id: 11, ActualUseName: 'SPECIAL- HOSPITAL' },
                { Id: 12, ActualUseName: 'SPECIAL- SCIENTIFIC' },
                { Id: 73, ActualUseName: 'SPECIAL-LOCAL WATER DISTRICT' }
            ];

            const selUseName = data ? (data.ActualUseName || data.actualUseName || 'INDUSTRIAL') : 'INDUSTRIAL';
            let totalDepreciated = 0;
            (window.machineryDetailsList || []).forEach(it => {
                totalDepreciated += parseFloat(it.DepreciatedValue ?? it.depreciatedValue) || 0;
            });

            const mv = data ? (parseFloat(data.MarketValue ?? data.marketValue) || totalDepreciated) : totalDepreciated;
            const defaultLvl = resolveMachineryAssessmentLevel(selUseName);
            const lvl = data ? (parseFloat(data.AssessmentLevelPercent ?? data.assessmentLevelPercent) || defaultLvl) : defaultLvl;
            const av = Math.round((mv * (lvl / 100.0)) * 100) / 100;

            const row = document.createElement('tr');
            row.className = 'hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors machinery-roll-row';
            row.innerHTML = `
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold mach-roll-use-dropdown text-xs cursor-pointer">
                        ${useList.map(u => `<option value="${u.ActualUseName}" data-useid="${u.Id}" ${u.ActualUseName.toUpperCase() === selUseName.toUpperCase() ? 'selected' : ''}>${u.ActualUseName}</option>`).join('')}
                    </select>
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-36 px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs mach-roll-mv-input font-bold" value="${mv.toFixed(2)}" />
                </td>
                <td class="p-2.5 text-right">
                    <div class="inline-flex items-center gap-1 justify-end">
                        <input type="number" step="0.01" class="w-20 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs mach-roll-lvl-input font-bold text-emerald-600 dark:text-emerald-400" value="${lvl}" />
                        <span class="text-xs font-bold text-slate-400">%</span>
                    </div>
                </td>
                <td class="p-2.5 text-right font-mono font-black text-emerald-600 dark:text-emerald-400 mach-roll-av-cell">
                    ₱${av.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                </td>
                <td class="p-2.5 text-center">
                    <button type="button" onclick="this.closest('tr').remove(); recomputeAllMachineryValuation();" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Row">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            const useSel = row.querySelector('.mach-roll-use-dropdown');
            const mvInput = row.querySelector('.mach-roll-mv-input');
            const lvlInput = row.querySelector('.mach-roll-lvl-input');

            useSel.addEventListener('change', function () {
                const suggested = resolveMachineryAssessmentLevel(this.value);
                lvlInput.value = suggested;
                recomputeMachineryRollRow(row);
            });
            mvInput.addEventListener('input', () => recomputeMachineryRollRow(row));
            lvlInput.addEventListener('input', () => recomputeMachineryRollRow(row));

            recomputeMachineryRollRow(row);
            if (window.lucide) lucide.createIcons();
        }

        function recomputeMachineryRollRow(row) {
            const mv = parseFloat(row.querySelector('.mach-roll-mv-input')?.value) || 0;
            const lvl = parseFloat(row.querySelector('.mach-roll-lvl-input')?.value) || 0;
            const av = Math.round((mv * (lvl / 100.0)) * 100) / 100;
            row.querySelector('.mach-roll-av-cell').textContent = `₱${av.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            row.setAttribute('data-mv', mv);
            row.setAttribute('data-av', av);
            recomputeAllMachineryValuation();
        }

        function syncMachineryAssessmentRollFromAppraisal() {
            let totalDepreciated = 0;
            (window.machineryDetailsList || []).forEach(it => {
                totalDepreciated += parseFloat(it.DepreciatedValue ?? it.depreciatedValue) || 0;
            });

            const rows = document.querySelectorAll('.machinery-roll-row');
            if (rows.length === 0) {
                addMachineryAssessmentRollRow({
                    ActualUseName: 'INDUSTRIAL',
                    MarketValue: totalDepreciated,
                    AssessmentLevelPercent: resolveMachineryAssessmentLevel('INDUSTRIAL')
                });
            } else {
                const firstRow = rows[0];
                const mvInput = firstRow.querySelector('.mach-roll-mv-input');
                if (mvInput) {
                    mvInput.value = totalDepreciated.toFixed(2);
                    recomputeMachineryRollRow(firstRow);
                }
            }
        }

        function recomputeAllMachineryValuation() {
            let totalRollMv = 0;
            let totalRollAv = 0;
            document.querySelectorAll('.machinery-roll-row').forEach(r => {
                totalRollMv += parseFloat(r.getAttribute('data-mv')) || 0;
                totalRollAv += parseFloat(r.getAttribute('data-av')) || 0;
            });

            $('#displayMachineryRollTotalMv').text(`₱${totalRollMv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
            $('#displayMachineryRollTotalAv').text(`₱${totalRollAv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
            $('#kpiMachineryMarketValue').text(`₱${totalRollMv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
            $('#kpiMachineryAssessedValue').text(`₱${totalRollAv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);

            const annualTax = Math.round((totalRollAv * 0.03) * 100) / 100;
            $('#kpiMachineryAnnualTax').text(`₱${annualTax.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);

            serializeAllMachineryTables();
        }

        function serializeAllMachineryTables() {
            $('#machineryAppraisalDetailsJson').val(JSON.stringify(window.machineryDetailsList || []));

            const rollItems = [];
            document.querySelectorAll('.machinery-roll-row').forEach(row => {
                const useSel = row.querySelector('.mach-roll-use-dropdown');
                const opt = useSel ? useSel.options[useSel.selectedIndex] : null;
                const useId = opt ? (parseInt(opt.getAttribute('data-useid')) || null) : null;
                const mv = parseFloat(row.querySelector('.mach-roll-mv-input')?.value) || 0;
                const lvl = parseFloat(row.querySelector('.mach-roll-lvl-input')?.value) || 75;
                rollItems.push({
                    ActualUseId: useId,
                    ActualUseName: useSel?.value || 'INDUSTRIAL',
                    MarketValue: mv,
                    AssessmentLevelPercent: lvl,
                    AssessmentValue: Math.round((mv * (lvl / 100.0)) * 100) / 100
                });
            });
            $('#machineryPropertyAssessmentsJson').val(JSON.stringify(rollItems));
        }

        function initMachineryFormDynamicTables(partitionData = null) {
            window.machineryTablesInitialized = true;
            window.machineryDetailsList = [];

            let detailsJson = partitionData
                ? (partitionData.machineryAppraisalDetailsJson || partitionData.MachineryAppraisalDetailsJson)
                : $('#machineryAppraisalDetailsJson').val();

            if (detailsJson && detailsJson.trim() !== '' && detailsJson.trim() !== '[]') {
                try {
                    const parsed = typeof detailsJson === 'string' ? JSON.parse(detailsJson) : detailsJson;
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        window.machineryDetailsList = parsed;
                    }
                } catch (e) { }
            }

            if (window.machineryDetailsList.length === 0) {
                const defaultMv = partitionData ? (parseFloat(partitionData.marketValue) || 250000) : 250000;
                const todayIso = new Date().toISOString().split('T')[0];
                const currentYear = new Date().getFullYear();
                window.machineryDetailsList.push({
                    Classification: 'INDUSTRIAL',
                    DescriptionBrand: 'GENERATOR SET - CATERPILLAR / STANDARD',
                    KindOfMachinery: 'INDUSTRIAL',
                    BrandModel: 'GENERATOR SET - CATERPILLAR / STANDARD',
                    Capacity: '150 HP',
                    AcquiredDate: todayIso,
                    ConditionWhenAcquired: 'NEW',
                    EconomicLifeEstimated: 20,
                    YearInstalled: currentYear,
                    YearOfOperation: currentYear,
                    DateOfInstallation: todayIso,
                    DateOfOperation: todayIso,
                    OriginalCost: defaultMv,
                    InstallationCost: 0,
                    TotalCost: defaultMv,
                    RCN: defaultMv,
                    NoOfYearsUsed: 0,
                    RemainingEconomicLife: 20,
                    MarketValue: defaultMv,
                    DepreciationTotalPercentage: 0,
                    DepreciationTotalValue: 0,
                    DepreciatedValue: defaultMv
                });
            }

            renderMachineryAppraisalTable();

            const rollBody = document.getElementById('machineryPropertyAssessmentTableBody');
            if (rollBody) rollBody.innerHTML = '';

            let rollJson = partitionData
                ? (partitionData.machineryPropertyAssessmentsJson || partitionData.MachineryPropertyAssessmentsJson)
                : $('#machineryPropertyAssessmentsJson').val();

            let hasRoll = false;
            if (rollJson && rollJson.trim() !== '' && rollJson.trim() !== '[]') {
                try {
                    const parsedRoll = typeof rollJson === 'string' ? JSON.parse(rollJson) : rollJson;
                    if (Array.isArray(parsedRoll) && parsedRoll.length > 0) {
                        parsedRoll.forEach(item => addMachineryAssessmentRollRow(item));
                        hasRoll = true;
                    }
                } catch (e) { }
            }

            if (!hasRoll) {
                syncMachineryAssessmentRollFromAppraisal();
            }

            recomputeAllMachineryValuation();
        }

        let buildingFloors = [];
        let buildingAdditions = [];

        function switchTab(tabId) {
            $('.tab-content').addClass('hidden');
            $('#' + tabId).removeClass('hidden');

            $('.tab-btn').removeClass('bg-emerald-600 text-white shadow-sm').addClass('bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700');
            $('#btn-' + tabId).addClass('bg-emerald-600 text-white shadow-sm').removeClass('bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700');
            
            setTimeout(function() {
                initPartitionBarangayDropdowns();
            }, 50);

            if (window.lucide) lucide.createIcons();
        }

        function regenerateTdn() {
            const year = new Date().getFullYear();
            const rand4 = Math.floor(1000 + Math.random() * 9000);
            const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            const sfx = letters[partitionIndex] || (partitionIndex + 1);
            const newTdn = `TD-${year}-DC-${rand4}-${sfx}`;
            $('#inputTdn').val(newTdn);
            $('#displayHeaderTdn').text(newTdn);
            $('#bannerDisplayTdn').text(newTdn);
            toastr.info(`New TDN ${newTdn} assigned to partition.`);
        }

        function initSwitches() {
            $('#isCctSwitch').on('change', function () {
                if ($(this).is(':checked')) {
                    $('#cctDetailsRow').removeClass('hidden');
                } else {
                    $('#cctDetailsRow').addClass('hidden');
                }
            }).trigger('change');

            $('#selectPropertyTypeAccordUse').on('change', function () {
                if ($(this).val() === 'Other Type of Building and/or Structure') {
                    $('#divOtherPropertyType').removeClass('hidden');
                    $('#colPropertyType').removeClass('md:col-span-2').addClass('md:col-span-1');
                } else {
                    $('#divOtherPropertyType').addClass('hidden');
                    $('#colPropertyType').removeClass('md:col-span-1').addClass('md:col-span-2');
                }
            }).trigger('change');

            // Mutual exclusivity with uncheck support: only 1 can be checked, but clicking checked one unchecks it
            $('#isBldgAdminSwitch, #isAdminSwitch').on('change', function () {
                if ($(this).is(':checked')) {
                    $('#isBldgPossessorSwitch').prop('checked', false);
                }
                syncBldgAdminVisibility();
            });

            $('#isBldgPossessorSwitch').on('change', function () {
                if ($(this).is(':checked')) {
                    $('#isBldgAdminSwitch, #isAdminSwitch').prop('checked', false);
                }
                syncBldgAdminVisibility();
            });

            function syncBldgAdminVisibility() {
                const anyRoleChecked = $('#isBldgAdminSwitch').is(':checked') ||
                                       $('#isAdminSwitch').is(':checked') ||
                                       $('#isBldgPossessorSwitch').is(':checked');
                if (anyRoleChecked) {
                    $('#divBldgAdminSection').removeClass('hidden');
                } else {
                    $('#divBldgAdminSection').addClass('hidden');
                }
            }
            syncBldgAdminVisibility();

            $('#inputAssessedArea').on('input', function () {
                $('#inputValuationAssessedArea').val($(this).val());
            });

            initPartitionRegisteredOwnerLookup();
        }

        function applyRegisteredOwnerToPartition(data) {
            if (!data) return;
            if (data.id) {
                $('#inputPartitionOwnerId').val(data.id);
            }
            const ownerName = data.name || '';
            const ownerTin = data.tin || '';
            const ownerPhone = data.phone || '';
            const ownerEmail = data.email || '';
            const ownerAddress = data.address || data.street || '';
            const isCorp = (data.ownerType === 'Corporate' || data.ownerType === 'Government');
            const genderVal = isCorp ? 'Corporate' : 'Male';
            const civilStatusVal = isCorp ? 'N/A (Corporate / Entity)' : 'Single';

            // 1. Building Owner & Administrator Demographics
            const anyBldgAdminChecked = $('#isBldgAdminSwitch').is(':checked') ||
                                       $('#isAdminSwitch').is(':checked') ||
                                       $('#isBldgPossessorSwitch').is(':checked');
            if (anyBldgAdminChecked) {
                $('#inputBldgAdminName').val(ownerName);
                $('#inputAdminName').val(ownerName);
                $('#selectBldgAdminGender').val(genderVal);
                $('#selectBldgAdminCivilStatus').val(civilStatusVal);
                $('#inputBldgAdminTin').val(ownerTin);
                $('#inputBldgAdminPhone').val(ownerPhone);
                $('#inputBldgAdminEmail').val(ownerEmail);
                $('#inputBldgAdminAddress').val(ownerAddress);
                if (!$('#inputOwnerName').val()) {
                    $('#inputOwnerName').val(ownerName);
                }
            } else {
                $('#inputOwnerName').val(ownerName);
            }
            $('#selectBldgOwnerGender').val(genderVal);
            $('#selectBldgOwnerCivilStatus').val(civilStatusVal);
            $('#inputBldgOwnerTin').val(ownerTin);
            $('#inputBldgOwnerPhone').val(ownerPhone);
            $('#inputBldgOwnerEmail').val(ownerEmail);
            $('#inputBldgOwnerAddress').val(ownerAddress);

            // Sync hidden Administrator inputs
            $('#inputAdminAddress').val(ownerAddress);
            $('#inputAdminContact').val(ownerPhone);
            $('#inputAdminTin').val(ownerTin);
            $('#inputAdminGender').val(genderVal);
            $('#inputAdminCivilStatus').val(civilStatusVal);
            $('#inputAdminEmail').val(ownerEmail);

            // Also populate CCT owner name if empty
            if (!$('input[name="OwnerNameReflectedInCct"]').val()) {
                $('input[name="OwnerNameReflectedInCct"]').val(ownerName);
            }

            // 2. Land Owner & Declarant Demographics (keep in sync)
            if ($('#isLandAdminSwitch').is(':checked')) {
                $('#inputLandAdminName').val(ownerName);
                $('#inputLandAdminTin').val(ownerTin);
                $('#inputLandAdminPhone').val(ownerPhone);
                $('#inputLandAdminAddress').val(ownerAddress);
                $('#inputLandAdminEmail').val(ownerEmail);
                if (!$('#inputLandOwnerName').val()) {
                    $('#inputLandOwnerName').val(ownerName);
                }
            } else {
                $('#inputLandOwnerName').val(ownerName);
            }
            $('#inputLandOwnerTin').val(ownerTin);
            $('#inputLandOwnerPhone').val(ownerPhone);
            $('#inputLandOwnerAddress').val(ownerAddress);
            $('#inputLandOwnerEmail').val(ownerEmail);
            $('#selectLandOwnerGender').val(genderVal);

            // 3. Machinery Owner & Declarant Demographics (keep in sync)
            if ($('#isMachineryAdminSwitch').is(':checked')) {
                $('#inputMachineryAdminName').val(ownerName);
                $('#inputMachineryAdminTin').val(ownerTin);
                $('#inputMachineryAdminPhone').val(ownerPhone);
                $('#inputMachineryAdminAddress').val(ownerAddress);
                $('#inputMachineryAdminEmail').val(ownerEmail);
                if (!$('#inputMachineryOwnerName').val()) {
                    $('#inputMachineryOwnerName').val(ownerName);
                }
            } else {
                $('#inputMachineryOwnerName').val(ownerName);
            }
            $('#inputMachineryOwnerTin').val(ownerTin);
            $('#inputMachineryOwnerPhone').val(ownerPhone);
            $('#inputMachineryOwnerAddress').val(ownerAddress);
            $('#inputMachineryOwnerEmail').val(ownerEmail);
            $('#selectMachineryOwnerGender').val(genderVal);

            if (typeof toastr !== 'undefined') {
                toastr.success(`All Owner & Administrator Demographics auto-filled for ${ownerName}!`, 'Active Registered Owner Loaded');
            }
