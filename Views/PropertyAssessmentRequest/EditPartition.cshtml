        <div class="space-y-3.5">
            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                    <span>TARGET FLOOR / STOREY LEVEL</span>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-bold" id="labelStoreyCountHint">STOREY COUNT: 1</span>
                </label>
                <select id="modalFloorLevel" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs font-bold font-mono text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600">
                    <!-- Populated dynamically based on TOTAL STOREY COUNT -->
                </select>
            </div>
            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                    <span>BUILDING CLASSIFICATION</span>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-bold">BUCC SCHEDULE</span>
                </label>
                <select id="modalFloorBuildingClass" onchange="fetchModalFloorUnitCost()" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs font-bold font-mono text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600">
                    <option value="">-- Select Building Classification --</option>
                    @if (ViewBag.BuildingClassifications != null)
                    {
                        foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.BuildingClassifications)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">RATE MODE</label>
                    <select id="modalFloorRateMode" onchange="fetchModalFloorUnitCost()" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs font-bold font-mono text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600">
                        <option value="Min" selected>Min (Standard Schedule)</option>
                        <option value="Average">Average (Mean Rate)</option>
                        <option value="Max">Max (Upper Limit)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                        <span>UNIT COST (PHP/SQ.M.)</span>
                        <span id="unitCostAutoBadge" class="text-[9px] text-emerald-600 font-bold uppercase">AUTO-FETCH</span>
                    </label>
                    <input type="number" id="modalFloorUnitCost" step="0.01" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="0.00" value="0.00" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">FLOOR AREA (SQ.M.)</label>
                    <input type="number" id="modalFloorArea" step="0.01" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="0.00" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DESCRIPTION / USAGE</label>
                    <input type="text" id="modalFloorDesc" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs font-mono text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="e.g. Ground Floor, Office, Residential" />
                </div>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200 dark:border-stone-800">
            <button type="button" onclick="closeAddFloorModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-stone-700 text-xs font-bold font-mono hover:bg-slate-100 dark:hover:bg-stone-800">Cancel</button>
            <button type="button" onclick="saveFloorLevel()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold font-mono inline-flex items-center gap-1.5 shadow-sm transition-all">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Component
            </button>
        </div>
    </div>
</div>

<!-- MODAL: ADD STANDARD ADDITIONAL ITEM -->
<div id="addAdditionModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden font-mono text-xs">
    <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-3">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4 text-sky-600"></i> Add Standard Additional Item
            </h3>
            <button type="button" onclick="closeAddAdditionModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <div class="space-y-3.5">
            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                    <span>Item Description</span>
                    <span class="text-[10px] text-sky-600 dark:text-sky-400 font-bold">DATABASE LOOKUP</span>
                </label>
                <select id="modalAddItemSelect" onchange="onAddItemSelectChange()" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs font-bold font-mono text-slate-900 dark:text-white focus:outline-none focus:border-sky-600">
                    <option value="">-- Select Additional Item --</option>
                    @if (ViewBag.BuildingAdditionalItems != null)
                    {
                        foreach (var item in (IEnumerable<PropertyAssessmentApp.Models.BuildingAdditionalItem>)ViewBag.BuildingAdditionalItems)
                        {
                            <option value="@item.Id" data-desc="@item.AdditionalItemDescription" data-rate="@item.CostPerSQM" data-percent="@item.PercentUnitValue">
                                @item.AdditionalItemDescription
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">Quantity / Area</label>
                    <input type="number" id="modalAddItemArea" step="0.01" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold text-slate-900 dark:text-white focus:outline-none focus:border-sky-600" value="1" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">Unit Rate (PHP)</label>
                    <input type="number" id="modalAddItemRate" step="0.01" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold text-slate-900 dark:text-white focus:outline-none focus:border-sky-600" placeholder="0.00" value="0.00" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">Multiplier (%)</label>
                    <input type="number" id="modalAddItemPercent" step="1" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold text-slate-900 dark:text-white focus:outline-none focus:border-sky-600" value="100" />
                </div>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200 dark:border-stone-800">
            <button type="button" onclick="closeAddAdditionModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-stone-700 text-xs font-bold font-mono hover:bg-slate-100 dark:hover:bg-stone-800">Cancel</button>
            <button type="button" onclick="SubmitAddAdditionalItemModal()" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold font-mono inline-flex items-center gap-1.5 shadow-sm transition-all">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Item
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const returnUrl = "@Html.Raw(returnUrl)";
        const partitionIndex = parseInt("@partitionIndex") || 0;
        const requestId = "@requestId";

        // Land Prerequisites & Dynamic Schedules (CAST Standard)
        window.landClassifications = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandClassifications ?? new List<PropertyAssessmentApp.Models.LandClassification>()));
        window.landSubClassifications = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandSubClassifications ?? new List<PropertyAssessmentApp.Models.LandSubClassification>()));
        window.landActualUses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandActualUses ?? new List<PropertyAssessmentApp.Models.LandActualUse>()));
        window.landAssessmentLevels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandAssessmentLevels ?? new List<PropertyAssessmentApp.Models.LandAssessmentLevel>()));
        window.landAdjustments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandAdjustments ?? new List<PropertyAssessmentApp.Models.LandAdjustmentFactor>()));
        window.landImprovementTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LandImprovementTypes ?? new List<PropertyAssessmentApp.Models.LandImprovementType>()));
        window.activeAppraisalKind = '@(Model.Kind ?? "Land")';

        function switchAppraisalKind(kind) {
            window.activeAppraisalKind = kind;
            if (kind.toLowerCase() === 'building') {
                $('#container-building-appraisal').removeClass('hidden');
                $('#container-land-appraisal').addClass('hidden');
                $('#displayKindBadge').text('CAST Real Property Appraisal Standard (Building / Structure)');
                $('#inputKindHidden').val('Building');
                $('#btnKindBuilding').removeClass('text-slate-600 dark:text-stone-400 bg-slate-200 dark:bg-stone-800').addClass('bg-emerald-600 text-white shadow-xs');
                $('#btnKindLand').removeClass('bg-emerald-600 text-white shadow-xs').addClass('text-slate-600 dark:text-stone-400 bg-slate-200 dark:bg-stone-800');
                $('#container-land-appraisal :input').prop('disabled', true);
                $('#container-building-appraisal :input').prop('disabled', false);
            } else {
                $('#container-land-appraisal').removeClass('hidden');
                $('#container-building-appraisal').addClass('hidden');
                $('#displayKindBadge').text('CAST Real Property Appraisal Standard (Land Appraisal / FAAS TDN)');
                $('#inputKindHidden').val('Land');
                $('#btnKindLand').removeClass('text-slate-600 dark:text-stone-400 bg-slate-200 dark:bg-stone-800').addClass('bg-emerald-600 text-white shadow-xs');
                $('#btnKindBuilding').removeClass('bg-emerald-600 text-white shadow-xs').addClass('text-slate-600 dark:text-stone-400 bg-slate-200 dark:bg-stone-800');
                $('#container-building-appraisal :input').prop('disabled', true);
                $('#container-land-appraisal :input').prop('disabled', false);
            }
            if (window.lucide) lucide.createIcons();
        }

        function switchLandTab(tabId) {
            $('.land-tab-content').addClass('hidden');
            $('#' + tabId).removeClass('hidden');
            $('.land-tab-btn').removeClass('bg-emerald-600 text-white shadow-sm').addClass('bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400');
            $('#btn-' + tabId).removeClass('bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400').addClass('bg-emerald-600 text-white shadow-sm');
            if (window.lucide) lucide.createIcons();
        }

        // -------------------------------------------------------------
        // Table 1: Land Appraisal / Classification Rows
        // -------------------------------------------------------------
        function addLandClassificationRow(data = null) {
            const tbody = document.getElementById('landClassificationTableBody');
            if (!tbody) return;

            const row = document.createElement('tr');
            row.className = 'hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors land-class-row';

            const selClassId = data ? (data.ClassificationId || data.classificationId || 1) : 1;
            const selSubClassId = data ? (data.SubClassId || data.subClassId || 1) : 1;
            const selActualUse = data ? (data.ActualUseName || data.actualUseName || 'RESIDENTIAL') : 'RESIDENTIAL';
            const area = data ? (data.AreaSQM || data.areaSQM || data.areaSqMeters || 150) : 150;
            const unitVal = data ? (data.UnitValue || data.unitValue || 520) : 520;
            const marketVal = data ? (data.MarketValue || data.marketValue || (area * unitVal)) : (area * unitVal);

            row.innerHTML = `
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold class-dropdown text-xs cursor-pointer">
                        ${window.landClassifications.map(c => `<option value="${c.Id}" ${c.Id == selClassId ? 'selected' : ''}>${c.ClassificationName}</option>`).join('')}
                    </select>
                </td>
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-medium subclass-dropdown text-xs cursor-pointer">
                    </select>
                </td>
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-medium actualuse-dropdown text-xs cursor-pointer">
                        ${window.landActualUses.map(a => `<option value="${a.ActualUseName}" ${a.ActualUseName == selActualUse ? 'selected' : ''}>${a.ActualUseName}</option>`).join('')}
                    </select>
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-24 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs area-input" value="${area}" />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-24 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs unitval-input font-bold" value="${unitVal}" />
                </td>
                <td class="p-2.5 text-right font-mono font-bold text-slate-900 dark:text-white mv-cell">
                    â‚±${marketVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                </td>
                <td class="p-2.5 text-center">
                    <button type="button" onclick="removeLandRow(this)" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Row">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            const classSelect = row.querySelector('.class-dropdown');
            const subClassSelect = row.querySelector('.subclass-dropdown');
            const unitValInput = row.querySelector('.unitval-input');
            const areaInput = row.querySelector('.area-input');

            function updateSubClasses(selectedSubId = null) {
                const classId = classSelect.value;
                const subs = window.landSubClassifications.filter(s => s.ClassificationId == classId);
                if (subs.length > 0) {
                    subClassSelect.innerHTML = subs.map(s => `<option value="${s.Id}" data-unitval="${s.UnitValue}" ${(selectedSubId && s.Id == selectedSubId) ? 'selected' : ''}>${s.SubClass} (â‚±${s.UnitValue.toLocaleString()})</option>`).join('');
                    if (!selectedSubId) {
                        unitValInput.value = subs[0].UnitValue;
                    }
                } else {
                    subClassSelect.innerHTML = `<option value="">Standard Base</option>`;
                }
            }

            classSelect.addEventListener('change', function () {
                updateSubClasses();
                recomputeLandClassRow(row);
            });

            subClassSelect.addEventListener('change', function () {
                const opt = this.options[this.selectedIndex];
                if (opt && opt.getAttribute('data-unitval')) {
                    unitValInput.value = opt.getAttribute('data-unitval');
                }
                recomputeLandClassRow(row);
            });

            areaInput.addEventListener('input', () => recomputeLandClassRow(row));
            unitValInput.addEventListener('input', () => recomputeLandClassRow(row));

            updateSubClasses(selSubClassId);
            recomputeLandClassRow(row);
            if (window.lucide) lucide.createIcons();
        }

        function recomputeLandClassRow(row) {
            const area = parseFloat(row.querySelector('.area-input').value) || 0;
            const unitVal = parseFloat(row.querySelector('.unitval-input').value) || 0;
            const mv = Math.round((area * unitVal) * 100) / 100;
            row.querySelector('.mv-cell').textContent = `â‚±${mv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            row.setAttribute('data-mv', mv);
            row.setAttribute('data-area', area);
            recomputeAllLandValuation();
        }

        // -------------------------------------------------------------
        // Table 2: Other Improvements / Plants & Trees
        // -------------------------------------------------------------
        function addLandImprovementRow(data = null) {
            const tbody = document.getElementById('landImprovementTableBody');
            if (!tbody) return;

            const row = document.createElement('tr');
            row.className = 'hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors land-imp-row';

            const selTypeId = data ? (data.TypeId || data.typeId || 1) : 1;
            const isFruit = data ? (data.IsFruitBearing !== false && data.isFruitBearing !== false) : true;
            const qty = data ? (data.Quantity || data.quantity || 10) : 10;
            const age = data ? (data.AgeYears || data.ageYears || 5) : 5;
            const unitVal = data ? (data.UnitValue || data.unitValue || 120) : 120;
            const marketVal = data ? (data.MarketValue || data.marketValue || (qty * unitVal)) : (qty * unitVal);

            row.innerHTML = `
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold imp-type-dropdown text-xs cursor-pointer">
                        ${window.landImprovementTypes.map(i => `<option value="${i.Id}" data-baseval="${i.BaseValue}" data-kind="${i.Kind}" ${i.Id == selTypeId ? 'selected' : ''}>${i.TypeDescription} (${i.Kind})</option>`).join('')}
                    </select>
                </td>
                <td class="p-2.5 text-center">
                    <input type="checkbox" class="rounded border-slate-300 text-teal-600 focus:ring-teal-500 w-4 h-4 imp-fruit-cb" ${isFruit ? 'checked' : ''} />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-20 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs imp-qty-input" value="${qty}" />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" class="w-16 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs imp-age-input" value="${age}" />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-24 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs imp-unitval-input font-bold" value="${unitVal}" />
                </td>
                <td class="p-2.5 text-right font-mono font-bold text-slate-900 dark:text-white imp-mv-cell">
                    â‚±${marketVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                </td>
                <td class="p-2.5 text-center">
                    <button type="button" onclick="removeLandRow(this)" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="Delete Row">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            const typeSelect = row.querySelector('.imp-type-dropdown');
            const unitValInput = row.querySelector('.imp-unitval-input');
            const qtyInput = row.querySelector('.imp-qty-input');

            typeSelect.addEventListener('change', function () {
                const opt = this.options[this.selectedIndex];
                if (opt && opt.getAttribute('data-baseval')) {
                    unitValInput.value = opt.getAttribute('data-baseval');
                }
                recomputeLandImpRow(row);
            });

            qtyInput.addEventListener('input', () => recomputeLandImpRow(row));
            unitValInput.addEventListener('input', () => recomputeLandImpRow(row));

            recomputeLandImpRow(row);
            if (window.lucide) lucide.createIcons();
        }

        function recomputeLandImpRow(row) {
            const qty = parseFloat(row.querySelector('.imp-qty-input').value) || 0;
            const unitVal = parseFloat(row.querySelector('.imp-unitval-input').value) || 0;
            const mv = Math.round((qty * unitVal) * 100) / 100;
            row.querySelector('.imp-mv-cell').textContent = `â‚±${mv.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            row.setAttribute('data-mv', mv);
            recomputeAllLandValuation();
        }

        // -------------------------------------------------------------
        // Table 3: Base Market Value & Adjustments
        // -------------------------------------------------------------
        function addLandAdjustmentRow(data = null) {
            const tbody = document.getElementById('landAdjustmentTableBody');
            if (!tbody) return;

            const row = document.createElement('tr');
            row.className = 'hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors land-adj-row';

            const selClass = data ? (data.ClassificationName || data.classificationName || 'RESIDENTIAL') : 'RESIDENTIAL';
            const baseMv = data ? (data.BaseMarketValue || data.baseMarketValue || 78000) : 78000;
            const selAdjId = data ? (data.AdjustmentFactorId || data.adjustmentFactorId || 1) : 1;
            const pct = data ? (data.PercentAdjustment || data.percentAdjustment || 0) : 0;
            const valAdj = data ? (data.ValueAdjustment || data.valueAdjustment || (baseMv * (pct / 100))) : (baseMv * (pct / 100));
            const adjMv = data ? (data.AdjustedMarketValue || data.adjustedMarketValue || (baseMv + valAdj)) : (baseMv + valAdj);

            row.innerHTML = `
                <td class="p-2.5">
                    <input type="text" class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold adj-class-input text-xs" value="${selClass}" />
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-28 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs adj-basemv-input font-bold" value="${baseMv}" />
                </td>
                <td class="p-2.5">
                    <select class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-medium adj-factor-dropdown text-xs cursor-pointer">
                        ${window.landAdjustments.map(j => `<option value="${j.Id}" data-pct="${j.AdjustmentPercent}" ${j.Id == selAdjId ? 'selected' : ''}>${j.Description} (${j.AdjustmentPercent >= 0 ? '+' : ''}${j.AdjustmentPercent}%)</option>`).join('')}
                    </select>
                </td>
                <td class="p-2.5 text-right">
                    <input type="number" step="0.01" class="w-20 px-2 py-1.5 rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right text-xs adj-pct-input font-bold" value="${pct}" />
                </td>
                <td class="p-2.5 text-right font-mono font-bold text-slate-600 dark:text-stone-300 adj-val-cell">
