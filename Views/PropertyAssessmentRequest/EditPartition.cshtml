        function renderAdditions() {
            const tbody = $('#tableBuildingAdditionsBody');
            tbody.empty();
            if (buildingAdditions.length === 0) {
                tbody.append('<tr><td colspan="6" class="p-4 text-center text-slate-400 italic">No additional items or improvements recorded.</td></tr>');
                $('#displayTotalAdditions').text('₱0.00');
                $('#buildingTotalAdditionsValue').val('0');
                $('#buildingAdditionalItemsJson').val('');
                return;
            }
            let totalAdditions = 0;
            buildingAdditions.forEach((item, idx) => {
                const area = item.quantity || item.area || 1;
                const rate = item.unitRate || item.rate || 0;
                const percent = (item.multiplier !== undefined) ? item.multiplier : ((item.multiplierPercent !== undefined) ? item.multiplierPercent : 100);
                const total = (item.totalValue !== undefined) ? item.totalValue : Math.round((area * rate) * (percent / 100.0) * 100) / 100;

                totalAdditions += total;

                tbody.append(`
                    <tr class="hover:bg-slate-50 dark:hover:bg-stone-950">
                        <td class="p-3 font-semibold text-slate-900 dark:text-white">${item.description || item.itemDescription || 'Additional Item'}</td>
                        <td class="p-3 text-right font-mono">${Number(area).toFixed(2)}</td>
                        <td class="p-3 text-right font-mono">₱${Number(rate).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                        <td class="p-3 text-right font-mono">${Number(percent).toFixed(0)}%</td>
                        <td class="p-3 text-right font-mono font-bold text-sky-600 dark:text-sky-400">₱${Number(total).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                        <td class="p-3 text-center">
                            <button type="button" onclick="removeAddition(${idx})" class="text-rose-500 hover:text-rose-700 p-1" title="Delete Additional Item">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });
            $('#displayTotalAdditions').text('₱' + totalAdditions.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#buildingTotalAdditionsValue').val(totalAdditions.toFixed(2));
