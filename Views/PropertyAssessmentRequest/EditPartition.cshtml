                    : '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">Min</span>';

                tbody.append(`
                    <tr class="hover:bg-slate-50 dark:hover:bg-stone-950">
