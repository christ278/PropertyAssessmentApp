            if (p.ownerAddress || p.declarantAddress) $('#inputMachineryOwnerAddress').val(p.ownerAddress || p.declarantAddress);
            if (p.ownerEmail) $('#inputMachineryOwnerEmail').val(p.ownerEmail);
            if (p.ownerGender) $('#selectMachineryOwnerGender').val(p.ownerGender);
            if (p.isAdministrator) $('#isMachineryAdminSwitch').prop('checked', true);
            if (p.isBeneficialUser) $('#isMachineryBeneficialSwitch').prop('checked', true);
            if (p.isPossessor) $('#isMachineryPossessorSwitch').prop('checked', true);
            if (p.isAdministrator || p.isBeneficialUser || p.isPossessor || p.administratorName) {
                $('#divMachineryAdminSection').removeClass('hidden');
            }
            if (p.administratorName) $('#inputMachineryAdminName').val(p.administratorName);
            if (p.administratorGender) $('#selectMachineryAdminGender').val(p.administratorGender);
            if (p.administratorTin) $('#inputMachineryAdminTin').val(p.administratorTin);
            if (p.administratorContactNo) $('#inputMachineryAdminPhone').val(p.administratorContactNo);
            if (p.administratorAddress) $('#inputMachineryAdminAddress').val(p.administratorAddress);
            if (p.administratorEmail) $('#inputMachineryAdminEmail').val(p.administratorEmail);
            if (p.taxability) $('#selectMachineryTaxability').val(p.taxability);
            if (p.effectivityQuarter) $('#selectMachineryEffQuarter').val(p.effectivityQuarter);
            if (p.effectivityYear) $('#inputMachineryEffYear').val(p.effectivityYear);
            if (p.assessmentBasis) $('#inputMachineryAssessmentBasis').val(p.assessmentBasis);
            if (p.backTaxesYearFrom) $('#inputMachineryBackTaxesFrom').val(p.backTaxesYearFrom);
            if (p.backTaxesYearTo) $('#inputMachineryBackTaxesTo').val(p.backTaxesYearTo);
            if (p.memoranda) $('#textareaMachineryMemoranda').val(p.memoranda);

            // Populate Building Administrator & Demographics fields (mirrors Land form)
            if (p.isAdministrator) {
                $('#isBldgAdminSwitch, #isAdminSwitch').prop('checked', true);
                $('#isBldgPossessorSwitch').prop('checked', false);
            } else if (p.isPossessor) {
                $('#isBldgPossessorSwitch').prop('checked', true);
                $('#isBldgAdminSwitch, #isAdminSwitch').prop('checked', false);
            }
            if (p.isAdministrator || p.isPossessor || p.administratorName) {
                $('#divBldgAdminSection').removeClass('hidden');
            }
            if (p.administratorName) {
                $('#inputBldgAdminName').val(p.administratorName);
                $('#inputAdminName').val(p.administratorName);
            }
            if (p.administratorGender) $('#selectBldgAdminGender').val(p.administratorGender);
            if (p.administratorCivilStatus) $('#selectBldgAdminCivilStatus').val(p.administratorCivilStatus);
            if (p.administratorTin) $('#inputBldgAdminTin').val(p.administratorTin);
            if (p.administratorContactNo) $('#inputBldgAdminPhone').val(p.administratorContactNo);
            if (p.administratorEmail) $('#inputBldgAdminEmail').val(p.administratorEmail);
            if (p.administratorAddress) $('#inputBldgAdminAddress').val(p.administratorAddress);

            const rawPropImgs = p.propertyImagesJson || p.PropertyImagesJson || $('.property-images-json-input').first().val() || '';
            if (rawPropImgs && rawPropImgs.trim().startsWith('[')) {
                try {
                    window.propertyImagesList = JSON.parse(rawPropImgs) || [];
                } catch (e) {
                    window.propertyImagesList = [];
                }
            }
            renderPropertyImagesGallery();
        }

        switchAppraisalKind(currentKind);

        // Load any existing client-side draft or server Building data
        try {
            if (!isStandaloneFaas) {
                const savedDraft = sessionStorage.getItem('propertyAssessmentRequest_draft');
                if (savedDraft) {
                    const draftObj = JSON.parse(savedDraft);
                    if (draftObj && draftObj.partitions && draftObj.partitions[partitionIndex]) {
                        const dp = draftObj.partitions[partitionIndex];
                        if (dp.systemGeneratedTDN && !$('#inputTdn').val()) {
                            $('#inputTdn').val(dp.systemGeneratedTDN);
                            $('#displayHeaderTdn').text(dp.systemGeneratedTDN);
                            $('#bannerDisplayTdn').text(dp.systemGeneratedTDN);
                        }
                        if (dp.pin && !$('#inputPin').val()) $('#inputPin').val(dp.pin);
                        if (dp.arpNo) {
                            if (!$('#inputBldgArpNo').val()) $('#inputBldgArpNo').val(dp.arpNo);
                            if (!$('#inputLandArpNo').val()) $('#inputLandArpNo').val(dp.arpNo);
                            $('#bannerDisplayArpNo').text(dp.arpNo);
                        }
                        const floorJson = dp.buildingFloorBreakdownJson || dp.BuildingFloorBreakdownJson;
                        if (floorJson && !$('#buildingFloorBreakdownJson').val()) {
                            $('#buildingFloorBreakdownJson').val(floorJson);
                        }
                        const addJson = dp.buildingAdditionalItemsJson || dp.BuildingAdditionalItemsJson;
                        if (addJson && !$('#buildingAdditionalItemsJson').val()) {
                            $('#buildingAdditionalItemsJson').val(addJson);
                        }
                    }
                }
            }

            const existingFloors = $('#buildingFloorBreakdownJson').val();
            if (existingFloors && existingFloors.trim() !== '') {
                buildingFloors = JSON.parse(existingFloors);
                renderFloors();
            }
            const existingAdditions = $('#buildingAdditionalItemsJson').val();
            if (existingAdditions && existingAdditions.trim() !== '') {
                buildingAdditions = JSON.parse(existingAdditions);
                renderAdditions();
            }
            recalculateValuation(true);
        } catch (err) {
            console.error('JSON load error:', err);
        }

        $('#inputNoOfStoreys').on('input change', function () {
            const count = parseInt($(this).val()) || 1;
            $('#labelStoreyCountHint').text(`TOTAL STOREY COUNT: ${count}`);
        });

        $('select[name="StructuralType"]').on('change', function () {
            const newStruct = $(this).val();
            if (window.toastr) toastr.info(`Structural Type set to ${newStruct}. BUCC schedule rates updated.`, 'BUCC Schedule');
            updateExistingFloorsUnitCost(newStruct);
            if (!$('#addFloorModal').hasClass('hidden')) {
                fetchModalFloorUnitCost();
            }
        });

        $('#selectBuildingClassification').on('change', function () {
            const bldgVal = $(this).val();
            if (bldgVal && !$('#modalFloorBuildingClass').val()) {
                $('#modalFloorBuildingClass').val(bldgVal);
            }
        });

        $('input[name="DateConstructed"], input[name="DateCompleted"]').on('change input', calculateBuildingAgeFromDates);
        $('#inputBuildingAge').on('change input', lookupSuggestedDepreciationRate);

        $('#inputDeprPercent, #inputAssessedArea, #inputUnitValue').on('input', function () {
            recalculateValuation(false);
        });

        $('#inputAssessLevel').on('input', function () {
            const fmv = parseFloat($('#inputMarketValue').val()) || 0;
            const lvl = parseFloat($(this).val()) || 0;
            updateAssessedValueAndTaxes(fmv, lvl);
        });

        if (!$('#inputLandArpNo').val() || $('#inputLandArpNo').val() === '187-00-0000-000-000' || !$('#inputTdn').val() || $('#inputTdn').val().startsWith('TD-')) {
            syncCastArpAndTdnLive();
        }

        recalculateValuation();
    });
</script>
