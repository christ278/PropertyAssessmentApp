        const adjItems = [];
        document.querySelectorAll('.land-adj-row').forEach((r, idx) => {
            const className = r.querySelector('.adj-class-input')?.value || 'Residential';
            const baseMv = parseFloat(r.querySelector('.adj-basemv-input').value) || 0;
            const factorSel = r.querySelector('.adj-factor-dropdown');
