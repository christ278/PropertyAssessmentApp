        if (rollBody) rollBody.innerHTML = '';

        let classJson = partitionData ? (partitionData.landAppraisalDetailsJson || partitionData.LandAppraisalDetailsJson) : $('#landAppraisalDetailsJson').val();
        let hasClassRows = false;
        if (classJson && classJson.trim() !== '[]' && classJson.trim() !== '') {
            try {
                const items = typeof classJson === 'string' ? JSON.parse(classJson) : classJson;
