    function resolveCastBrgyCode(brgyVal, defaultCode = '0001') {
        if (!brgyVal) return defaultCode;
        const raw = String(brgyVal).trim();
        if (/^\d+$/.test(raw)) return raw.slice(-4).padStart(4, '0');
        const u = raw.toUpperCase();
        const map = [
            ['ZONE I', '0001'], ['ZONE 1', '0001'],
            ['ZONE II', '0002'], ['ZONE 2', '0002'],
            ['ZONE III', '0003'], ['ZONE 3', '0003'],
            ['ZONE IV', '0004'], ['ZONE 4', '0004'],
            ['ASSUMPTION', '0005'],
            ['AVANCEÑA', '0006'], ['AVANCENA', '0006'],
            ['CACUB', '0007'],
            ['CALOOCAN', '0008'],
            ['CARPENTER HILL', '0009'],
            ['CONCEPCION', '0010'],
            ['ESPERANZA', '0011'],
            ['GEN. P. SANTOS', '0012'], ['GEN. P SANTOS', '0012'], ['GEN P SANTOS', '0012'],
            ['MABINI', '0013'],
            ['MAGSAYSAY', '0014'],
            ['MAMBUCAL', '0015'],
            ['MORALES', '0016'],
            ['NAMNAMA', '0017'],
            ['NEW PANGASINAN', '0018'],
            ['PARAISO', '0019'],
            ['ROTONDA', '0020'],
            ['SAN ISIDRO', '0021'],
            ['SAN JOSE', '0022'],
            ['SAN ROQUE', '0023'],
            ['SARAVIA', '0024'],
            ['STA. CRUZ', '0025'], ['STA CRUZ', '0025'],
            ['STO. NIÑO', '0026'], ['STO. NINO', '0026'], ['STO NINO', '0026'],
            ['TOPLAND', '0027'],
            ['DADIANGAS EAST', '0001'], ['CENTRAL', '0001'], ['POBLACION', '0001'],
            ['LAGAO', '0002'], ['CALUMPANG', '0003'], ['CITY HEIGHTS', '0005']
        ];
        for (const [k, c] of map) {
            if (u.includes(k)) return c;
        }
        const digits = raw.replace(/\D/g, '');
        if (digits) return digits.slice(-4).padStart(4, '0');
        return defaultCode;
    }

    function formatThreeDigitPart(val) {
        if (!val) return '000';
        const m = String(val).match(/\d+/);
        if (m) return m[0].slice(-3).padStart(3, '0');
        return String(val).replace(/[^a-zA-Z0-9]/g, '').slice(0, 3).toUpperCase().padStart(3, '0') || '000';
    }

    function formatARPNumber(lgu, mun, brgyVal, sectionNo, parcelOrLotNo) {
        const lgu3 = String(lgu || '187').padStart(3, '0');
        const mun2 = String(mun || '00').padStart(2, '0');
        const brgy4 = resolveCastBrgyCode(brgyVal, '0000');
        const sec3 = formatThreeDigitPart(sectionNo);
        const lot3 = formatThreeDigitPart(parcelOrLotNo);
        return `${lgu3}-${mun2}-${brgy4}-${sec3}-${lot3}`;
    }

    function formatOfficialTDN(effYear, brgyVal, currentTdn, fallbackSeq) {
        const yr = parseInt(effYear, 10) || new Date().getFullYear();
        const revYearLastTwo = String(yr % 100).padStart(2, '0');
        const brgy4 = resolveCastBrgyCode(brgyVal, '0001');
        let seq5 = String((typeof fallbackSeq === 'number' && fallbackSeq > 0) ? fallbackSeq : (partitionIndex + 1)).padStart(5, '0');
        if (currentTdn) {
            const parts = String(currentTdn).trim().split('-');
            if (parts.length === 3 && /^\d{5}$/.test(parts[2])) {
                seq5 = parts[2];
            }
        }
        return `${revYearLastTwo}-${brgy4}-${seq5}`;
    }

    function initPartitionBarangayDropdowns() {
        if (typeof $ === 'undefined' || typeof $.fn.select2 === 'undefined') return;
        $('.select2-barangay').each(function () {
            const $el = $(this);
            if ($el.hasClass('select2-hidden-accessible')) {
                $el.next('.select2-container').css('width', '100%');
                return;
            }
            try {
                $el.select2({
                    width: '100%',
                    placeholder: 'Search & select Barangay...',
                    allowClear: false
                }).off('change.syncCastLive').on('change.syncCastLive', function () {
                    syncCastArpAndTdnLive();
                });
            } catch (e) { }
        });
    }
    window.initPartitionBarangayDropdowns = initPartitionBarangayDropdowns;

    function syncCastArpAndTdnLive() {
        const k = ($('#inputKindHidden').val() || 'Land').toLowerCase();
        const isLand = k === 'land';
        const isMachinery = k === 'machinery';
        const brgyVal = isLand
            ? ($('#selectLandBarangay').val() || '')
            : (isMachinery
                ? ($('#selectMachineryBarangay').val() || '')
                : ($('#selectBldgBarangay').val() || $('#container-building-appraisal select[name="DistrictOrBarangay"]').val() || $('#container-building-appraisal input[name="DistrictOrBarangay"]').val() || ''));
        const secVal = isLand
            ? ($('#inputLandSectionNo').val() || '')
            : (isMachinery
                ? ($('#inputMachinerySectionNo').val() || '')
                : ($('#inputBldgSectionNo').val() || ''));
        const lotOrParcelVal = isLand
            ? ($('#inputLandParcelNo').val() || $('#inputLandLotNo').val() || '')
            : (isMachinery
                ? ($('#inputMachineryLotNo').val() || $('#inputMachineryParcelNo').val() || '')
                : ($('#inputLotNumber').val() || ''));
        const effYearVal = isLand
            ? ($('#inputLandEffYear').val() || new Date().getFullYear())
            : (isMachinery
                ? ($('#inputMachineryEffYear').val() || new Date().getFullYear())
                : ($('#container-building-appraisal input[name="EffectivityYear"]').val() || new Date().getFullYear()));

        const arp = formatARPNumber('187', '00', brgyVal, secVal, lotOrParcelVal);
        $('#inputLandArpNo').val(arp);
        $('#inputBldgArpNo').val(arp);
        $('#inputMachineryArpNo').val(arp);
        $('#bannerDisplayArpNo').text(arp);

        const officialTdn = formatOfficialTDN(effYearVal, brgyVal, $('#inputTdn').val(), partitionIndex + 1);
        $('#inputTdn').val(officialTdn);
        $('#displayHeaderTdn').text(officialTdn);
        $('#bannerDisplayTdn').text(officialTdn);
    }

