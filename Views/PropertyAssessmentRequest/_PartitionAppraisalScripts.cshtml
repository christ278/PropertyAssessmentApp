    function initPartitionRegisteredOwnerLookup() {
        if (typeof TomSelect === 'undefined') return;
        ['#bldgRegisteredOwnerSelect', '#landRegisteredOwnerSelect', '#machineryRegisteredOwnerSelect'].forEach(function (selector) {
            const el = document.querySelector(selector);
            if (!el || el.tomselect) return;

            new TomSelect(el, {
                create: false,
                preload: true,
                valueField: 'id',
                labelField: 'display',
                searchField: ['name', 'tin', 'rptin', 'barangay', 'text', 'display'],
                loadThrottle: 300,
                placeholder: 'Search active registered owner by Name, TIN, RPTIN, or Barangay...',
                load: function (query, callback) {
                    const q = (query || '').trim();
                    fetch(`/PropertyAssessmentRequest/SearchRegisteredOwners?term=${encodeURIComponent(q)}`)
                        .then(res => res.json())
                        .then(data => callback(Array.isArray(data) ? data : []))
                        .catch(() => callback());
                },
                render: {
                    option: function (item, escape) {
                        if (item.name) {
                            return `<div class="py-1">
                                <span class="font-bold text-slate-900 dark:text-white">${escape(item.name)}</span>
                                <span class="text-[11px] text-slate-600 dark:text-stone-300 font-medium"> (TIN: ${escape(item.tin || 'N/A')} | ${escape(item.barangay || 'N/A')})</span>
                            </div>`;
                        }
                        return `<div class="py-1">${escape(item.text || item.display || '')}</div>`;
                    },
                    item: function (item, escape) {
                        if (item.name) {
                            return `<div>${escape(item.name)} (TIN: ${escape(item.tin || 'N/A')})</div>`;
                        }
                        return `<div>${escape(item.text || item.display || '')}</div>`;
                    }
                },
                onChange: function (ownerId) {
                    if (!ownerId) return;
                    $('#inputPartitionOwnerId').val(ownerId);
                    fetch(`/PropertyAssessmentRequest/GetOwnerDetails?id=${encodeURIComponent(ownerId)}`)
                        .then(res => res.json())
                        .then(data => {
                            if (data) {
                                applyRegisteredOwnerToPartition(data);
                            }
                        })
                        .catch(err => console.error('Error fetching owner details:', err));
                }
            });
        });
    }

    function getOrdinalFloorName(n) {
        if (n === 1) return "1st Floor (Ground Level)";
        if (n === 2) return "2nd Floor";
        if (n === 3) return "3rd Floor";
        const s = ["th", "st", "nd", "rd"];
        const v = n % 100;
        const suffix = s[(v - 20) % 10] || s[v] || s[0];
        return `${n}${suffix} Floor`;
    }

    function syncModalFloorOptions(selectedFloor = "") {
        let storeyCount = parseInt($('#inputNoOfStoreys').val());
        if (isNaN(storeyCount) || storeyCount < 1) {
            storeyCount = 1;
        }
        $('#labelStoreyCountHint').text(`TOTAL STOREY COUNT: ${storeyCount}`);

        const floorSelect = $('#modalFloorLevel');
        floorSelect.empty();

        const existingFloors = buildingFloors.map(f => f.floorNumber);

        for (let i = 1; i <= storeyCount; i++) {
            const floorName = getOrdinalFloorName(i);
            floorSelect.append($('<option></option>').val(floorName).text(floorName));
        }

        const specialLevels = [
            "Mezzanine Level",
            "Basement Level",
            "Roof Deck / Penthouse"
        ];
        specialLevels.forEach(lvl => {
            floorSelect.append($('<option></option>').val(lvl).text(lvl));
        });

        if (selectedFloor) {
            floorSelect.val(selectedFloor);
        } else {
            let firstAvailable = "";
            for (let i = 1; i <= storeyCount; i++) {
                const fName = getOrdinalFloorName(i);
                if (!existingFloors.includes(fName)) {
                    firstAvailable = fName;
                    break;
                }
            }
            if (firstAvailable) {
                floorSelect.val(firstAvailable);
            }
        }
    }

    function fetchModalFloorUnitCost() {
        const structuralType = $('select[name="StructuralType"]').val() || "Type I";
        const bldgClass = $('#modalFloorBuildingClass').val() || "";
        const rateMode = $('#modalFloorRateMode').val() || "Min";

        if (!bldgClass) return;

        $('#unitCostAutoBadge').text('FETCHING...').removeClass('text-emerald-600').addClass('text-amber-500');

        $.ajax({
            url: '/PropertyAssessmentRequest/GetUnitValue',
            type: 'GET',
            data: {
                structuralType: structuralType,
                classification: bldgClass,
                mode: rateMode
            },
            success: function (res) {
                if (res && res.success && res.unitValue !== undefined) {
                    $('#modalFloorUnitCost').val(Number(res.unitValue).toFixed(2));
                    $('#unitCostAutoBadge').text(`AUTO: ₱${Number(res.unitValue).toLocaleString('en-US', { minimumFractionDigits: 2 })}`)
                        .removeClass('text-amber-500').addClass('text-emerald-600');
                }
            },
            error: function () {
                calculateLocalUnitCostFallback(structuralType, bldgClass, rateMode);
            }
        });
    }

    function calculateLocalUnitCostFallback(structuralType, bldgClass, rateMode) {
        let baseRate = 12500;
        if (bldgClass.includes("Class A") || bldgClass.includes("I-A")) baseRate = 15000;
        else if (bldgClass.includes("Class B") || bldgClass.includes("I-B")) baseRate = 12500;
        else if (bldgClass.includes("Class C") || bldgClass.includes("II-A")) baseRate = 9800;
        else if (bldgClass.includes("Class D") || bldgClass.includes("III-A")) baseRate = 6500;
        else if (bldgClass.includes("Class E") || bldgClass.includes("IV-A")) baseRate = 3500;
        else if (bldgClass.includes("Commercial") || bldgClass.includes("COM")) baseRate = 16500;
        else if (bldgClass.includes("Industrial") || bldgClass.includes("IND")) baseRate = 12000;

        let factor = 1.0;
        const st = (structuralType || "").toUpperCase();
        if (st.includes("TYPE V") || st.includes("CLASS E") || st.startsWith("V")) factor = 0.30;
        else if (st.includes("TYPE IV") || st.includes("CLASS D") || st.startsWith("IV")) factor = 0.50;
        else if (st.includes("TYPE III") || st.includes("CLASS C") || st.startsWith("III")) factor = 0.70;
        else if (st.includes("TYPE II") || st.includes("CLASS B") || st.startsWith("II")) factor = 0.85;

        let finalRate = baseRate * factor;
        if (rateMode === "Max") finalRate *= 1.10;

        finalRate = Math.round(finalRate * 100) / 100;
        $('#modalFloorUnitCost').val(finalRate.toFixed(2));
        $('#unitCostAutoBadge').text(`AUTO: ₱${finalRate.toLocaleString('en-US', { minimumFractionDigits: 2 })}`)
            .removeClass('text-amber-500').addClass('text-emerald-600');
    }

    function openAddFloorModal() {
        const structuralType = $('select[name="StructuralType"]').val();
        if (!structuralType && window.toastr) {
            toastr.warning("Please select Structural Type (BUCC Class) in Tab 2 first.", "Structural Type Required");
        }

        syncModalFloorOptions();

        const tab2Classification = $('#selectBuildingClassification').val();
        if (tab2Classification && !$('#modalFloorBuildingClass').val()) {
            $('#modalFloorBuildingClass').val(tab2Classification);
        } else if (!$('#modalFloorBuildingClass').val()) {
            const firstOptionVal = $('#modalFloorBuildingClass option:eq(1)').val();
            if (firstOptionVal) $('#modalFloorBuildingClass').val(firstOptionVal);
        }

        $('#modalFloorArea').val('');
        $('#modalFloorDesc').val('');

        fetchModalFloorUnitCost();

        $('#addFloorModal').removeClass('hidden');
        if (window.lucide) lucide.createIcons();
