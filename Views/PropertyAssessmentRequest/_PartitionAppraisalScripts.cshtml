    function renderPropertyImagesGallery() {
        const list = window.propertyImagesList || [];
        const grids = document.querySelectorAll('.property-images-gallery-grid');
        const emptyStates = document.querySelectorAll('.property-images-empty-state');
        const badges = document.querySelectorAll('.property-images-status-badge');
        const clearBtns = document.querySelectorAll('.btn-clear-property-images');

        badges.forEach(b => {
            b.textContent = `${list.length} IMAGE${list.length === 1 ? '' : 'S'}`;
        });

        if (list.length === 0) {
            emptyStates.forEach(el => el.classList.remove('hidden'));
            grids.forEach(g => {
                g.classList.add('hidden');
                g.innerHTML = '';
            });
            clearBtns.forEach(btn => btn.classList.add('hidden'));
            syncPropertyImagesHiddenInput();
            if (window.lucide) lucide.createIcons();
            return;
        }

        emptyStates.forEach(el => el.classList.add('hidden'));
        clearBtns.forEach(btn => btn.classList.remove('hidden'));

        const currentTdn = $('#inputTdn').val() || 'TDN Pending';
        const cardsHtml = list.map((img, idx) => {
            const src = typeof img === 'string' ? img : (img.imagePath || img.ImagePath || img.url || '');
            const name = typeof img === 'string' ? src.split('/').pop() : (img.originalFileName || img.OriginalFileName || src.split('/').pop() || `Image #${idx + 1}`);
            return `
                <div class="group relative rounded-xl overflow-hidden border border-slate-200 dark:border-stone-800 bg-white dark:bg-stone-900 shadow-sm flex flex-col">
                    <div class="relative aspect-video bg-slate-100 dark:bg-stone-950 overflow-hidden flex items-center justify-center">
                        <a href="${src}" target="_blank" class="block w-full h-full">
                            <img src="${src}" alt="${name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" />
                        </a>
                        <button type="button" onclick="removePropertyImage(${idx})" class="absolute top-2 right-2 w-7 h-7 rounded-lg bg-rose-600/90 hover:bg-rose-700 text-white flex items-center justify-center shadow-md transition-all" title="Remove Image">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>
                        <span class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-slate-900/75 text-white font-mono text-[10px] font-bold">
                            #${idx + 1} · ${currentTdn}
                        </span>
                    </div>
                    <div class="p-2 text-[11px] font-mono text-slate-600 dark:text-stone-300 truncate" title="${name}">
                        ${name}
                    </div>
                </div>
            `;
        }).join('');

        grids.forEach(g => {
            g.classList.remove('hidden');
            g.innerHTML = cardsHtml;
        });

        syncPropertyImagesHiddenInput();
        if (window.lucide) lucide.createIcons();
    }

    function handlePropertyImagesUpload(event) {
        const files = event.target.files;
        if (!files || files.length === 0) return;

        const formData = new FormData();
        for (let i = 0; i < files.length; i++) {
            formData.append('propertyImages', files[i]);
        }
        const token = $('input[name="__RequestVerificationToken"]').val();
        if (token) formData.append('__RequestVerificationToken', token);

        const badges = document.querySelectorAll('.property-images-status-badge');
        badges.forEach(b => b.textContent = `UPLOADING ${files.length}...`);

        fetch('/PropertyAssessmentRequest/UploadPartitionPropertyImages', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data && data.success && Array.isArray(data.files)) {
                window.propertyImagesList = (window.propertyImagesList || []).concat(data.files);
                renderPropertyImagesGallery();
                if (window.toastr) toastr.success(`${data.files.length} image(s) uploaded and bound to TDN!`);
            } else {
                renderPropertyImagesGallery();
                if (window.toastr) toastr.error((data && data.message) || 'Failed to upload images.');
            }
            event.target.value = '';
        })
        .catch(err => {
            console.error('Error uploading property images:', err);
            renderPropertyImagesGallery();
            if (window.toastr) toastr.error('Error uploading property images.');
            event.target.value = '';
        });
    }

    function removePropertyImage(idx) {
        if (!Array.isArray(window.propertyImagesList)) return;
        window.propertyImagesList.splice(idx, 1);
        renderPropertyImagesGallery();
    }

    function clearAllPropertyImages() {
        window.propertyImagesList = [];
        renderPropertyImagesGallery();
