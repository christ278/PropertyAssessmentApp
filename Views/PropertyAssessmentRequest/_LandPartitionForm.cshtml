            <i data-lucide="calendar" class="w-4 h-4"></i>
            Effectivity, Taxability & Assessment Basis (CAST Standard)
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label asp-for="EffectivityQuarter" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">EFFECTIVITY QUARTER</label>
                <select asp-for="EffectivityQuarter" id="selectLandEffQuarter" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold cursor-pointer text-xs">
