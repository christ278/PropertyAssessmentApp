                <input asp-for="BackTaxesYearFrom" id="inputLandBackTaxesFrom" type="number" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs" placeholder="YYYY (Optional)" />
