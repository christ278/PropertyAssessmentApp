            <div>
                <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                    <i data-lucide="sliders" class="w-4 h-4"></i>
                    Table 3: Base Market Value Adjustments (Corner, Elevation, Topography)
                </h4>
                <p class="text-[11px] text-slate-500 dark:text-stone-400">Apply percentage adjustments based on corner lot influence, topography, or road access.</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="syncAdjustmentsFromClassifications()" class="px-3 py-1.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 hover:bg-slate-100 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-200 font-bold text-xs inline-flex items-center gap-1.5 shadow-xs transition-all">
