                    <option value="Taxable">Taxable (Standard)</option>
                    <option value="Exempt">Exempt from Real Property Tax</option>
                </select>
            </div>
            <div>
                <label asp-for="AssessmentBasis" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BASIS OF ASSESSMENT</label>
                <input asp-for="AssessmentBasis" id="inputLandAssessmentBasis" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold text-xs" value="Sec. 217 RA 7160" />
            </div>
            <div>
