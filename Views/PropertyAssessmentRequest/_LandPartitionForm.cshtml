@model PropertyAssessmentApp.Models.AssessmentPartitionItem
@{
    var classifications = ViewBag.LandClassifications as IEnumerable<PropertyAssessmentApp.Models.LandClassification> ?? Enumerable.Empty<PropertyAssessmentApp.Models.LandClassification>();
    var subClassifications = ViewBag.LandSubClassifications as IEnumerable<PropertyAssessmentApp.Models.LandSubClassification> ?? Enumerable.Empty<PropertyAssessmentApp.Models.LandSubClassification>();
    var actualUses = ViewBag.LandActualUses as IEnumerable<PropertyAssessmentApp.Models.LandActualUse> ?? Enumerable.Empty<PropertyAssessmentApp.Models.LandActualUse>();
    var assessmentLevels = ViewBag.LandAssessmentLevels as IEnumerable<PropertyAssessmentApp.Models.LandAssessmentLevel> ?? Enumerable.Empty<PropertyAssessmentApp.Models.LandAssessmentLevel>();
    var adjustments = ViewBag.LandAdjustments as IEnumerable<PropertyAssessmentApp.Models.LandAdjustmentFactor> ?? Enumerable.Empty<PropertyAssessmentApp.Models.LandAdjustmentFactor>();
    var improvementTypes = ViewBag.LandImprovementTypes as IEnumerable<PropertyAssessmentApp.Models.LandImprovementType> ?? Enumerable.Empty<PropertyAssessmentApp.Models.LandImprovementType>();
    var barangays = ViewBag.Barangays as IEnumerable<PropertyAssessmentApp.Models.Barangay> ?? Enumerable.Empty<PropertyAssessmentApp.Models.Barangay>();
    var registeredOwners = ViewBag.RegisteredOwners as IEnumerable<PropertyAssessmentApp.Models.Owner> ?? Enumerable.Empty<PropertyAssessmentApp.Models.Owner>();
}

<script>
    if (typeof window.switchLandTab !== 'function') {
        window.switchLandTab = function(tabId) {
            document.querySelectorAll('.land-tab-content').forEach(function(el) {
                el.classList.add('hidden');
            });
            document.querySelectorAll('.land-tab-btn').forEach(function(btn) {
                btn.classList.remove('bg-emerald-600', 'text-white', 'shadow-sm');
                btn.classList.add('bg-slate-100', 'dark:bg-stone-800', 'text-slate-600', 'dark:text-stone-400');
            });
            var target = document.getElementById(tabId);
            if (target) {
                target.classList.remove('hidden');
            }
            var activeBtn = document.getElementById('btn-' + tabId);
            if (activeBtn) {
                activeBtn.classList.remove('bg-slate-100', 'dark:bg-stone-800', 'text-slate-600', 'dark:text-stone-400');
                activeBtn.classList.add('bg-emerald-600', 'text-white', 'shadow-sm');
            }
            if (window.lucide) {
                lucide.createIcons();
            }
        };
    }
</script>

<!-- Hidden Storage for Land Dynamic Breakdown Tables -->
<input type="hidden" asp-for="LandAppraisalDetailsJson" id="landAppraisalDetailsJson" />
<input type="hidden" asp-for="LandImprovementsJson" id="landImprovementsJson" />
<input type="hidden" asp-for="LandAdjustmentsJson" id="landAdjustmentsJson" />
<input type="hidden" asp-for="LandPropertyAssessmentsJson" id="landPropertyAssessmentsJson" />

<!-- Land Tab Navigation (CAST Style) -->
<div class="flex items-center gap-2 overflow-x-auto border-b border-slate-200 dark:border-stone-800 pb-3" id="land-tab-bar">
    <button type="button" onclick="switchLandTab('land-tab-cadastral')" id="btn-land-tab-cadastral" class="land-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-emerald-600 text-white shadow-sm flex items-center gap-2 shrink-0">
        <i data-lucide="map" class="w-4 h-4"></i> 1. Cadastral & Title Registration
    </button>
    <button type="button" onclick="switchLandTab('land-tab-location')" id="btn-land-tab-location" class="land-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
        <i data-lucide="compass" class="w-4 h-4"></i> 2. Location & Boundaries
    </button>
    <button type="button" onclick="switchLandTab('land-tab-owner')" id="btn-land-tab-owner" class="land-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
        <i data-lucide="users" class="w-4 h-4"></i> 3. Owner & Demographics
    </button>
    <button type="button" onclick="switchLandTab('land-tab-valuation')" id="btn-land-tab-valuation" class="land-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
        <i data-lucide="calculator" class="w-4 h-4"></i> 4. Valuation & 4 Schedules (CAST)
    </button>
    <button type="button" onclick="switchLandTab('land-tab-effectivity')" id="btn-land-tab-effectivity" class="land-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
        <i data-lucide="file-text" class="w-4 h-4"></i> 5. Effectivity, Back Taxes & Notes
    </button>
</div>

<!-- ========================================== -->
<!-- TAB 1: CADASTRAL & TITLE REGISTRATION      -->
<!-- ========================================== -->
<div id="land-tab-cadastral" class="land-tab-content space-y-6">
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-3">
            <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                <i data-lucide="map" class="w-4 h-4"></i>
                Cadastral Details & Title Registration (CAST Reference)
            </h4>
            <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono font-bold text-slate-500">ARP NO:</span>
                <input asp-for="ARPNo" id="inputLandArpNo" class="px-3 py-1 text-xs rounded-lg bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono font-bold text-emerald-600 dark:text-emerald-400" placeholder="187-00-0000-000-000" />
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label asp-for="RegistrationStatus" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">REGISTRATION STATUS</label>
                <select asp-for="RegistrationStatus" id="selectLandRegStatus" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold cursor-pointer">
                    <option value="Titled">Titled Land</option>
                    <option value="Untitled">Untitled / Tax Declaration Only</option>
                </select>
            </div>
            <div>
                <label asp-for="TitleType" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">TITLE TYPE</label>
                <select asp-for="TitleType" id="selectLandTitleType" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold cursor-pointer">
                    <option value="OCT">OCT (Original Certificate of Title)</option>
                    <option value="TCT">TCT (Transfer Certificate of Title)</option>
                    <option value="CLOA">CLOA (Certificate of Land Ownership Award)</option>
                    <option value="Patent">Free Patent / Homestead Patent</option>
                </select>
            </div>
            <div>
                <label asp-for="TitleNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">OCT / TCT / CLOA NO.</label>
                <input asp-for="TitleNo" id="inputLandTitleNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="T-104928" />
            </div>
            <div>
                <label asp-for="DateRegistered" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">DATE OF TITLE REGISTRATION</label>
                <input asp-for="DateRegistered" id="inputLandDateRegistered" type="date" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
            </div>
            <div>
                <label asp-for="CadastralSurveyNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">CADASTRAL SURVEY NO.</label>
                <input asp-for="CadastralSurveyNo" id="inputLandCadSurveyNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="Cad-12-00412" />
            </div>
            <div>
                <label asp-for="SectionNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">SECTION NO.</label>
                <input asp-for="SectionNo" id="inputLandSectionNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="Section 02" />
            </div>
            <div>
                <label asp-for="LotNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">LOT NO.</label>
                <input asp-for="LotNumber" id="inputLandLotNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="Lot 10-A" />
            </div>
            <div>
                <label asp-for="BlockNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BLOCK NO.</label>
                <input asp-for="BlockNumber" id="inputLandBlockNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="Block 4" />
            </div>
            <div>
                <label asp-for="ParcelNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">PARCEL NO.</label>
                <input asp-for="ParcelNo" id="inputLandParcelNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="Parcel 01" />
            </div>
            <div>
                <label asp-for="SurveyNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">SURVEY NO.</label>
                <input asp-for="SurveyNumber" id="inputLandSurveyNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="Psu-12345" />
            </div>
            <div class="md:col-span-2">
                <label asp-for="PIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">PROPERTY INDEX NUMBER (PIN)</label>
                <input asp-for="PIN" id="inputLandPin" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold" placeholder="126-00-0000-000" />
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- TAB 2: LOCATION & BOUNDARIES (CAST)        -->
<!-- ========================================== -->
<div id="land-tab-location" class="land-tab-content space-y-6 hidden">
    <!-- Property Location -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
            <i data-lucide="map-pin" class="w-4 h-4"></i>
            Property Location Details (General Santos City Standard)
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-2">
                <label asp-for="StreetLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BUILDING NO. / STREET / ROAD</label>
                <input asp-for="StreetLocation" id="inputLandStreet" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="e.g. Pioneer Avenue, Corner Salazar St." />
            </div>
            <div>
                <label asp-for="Purok" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">PUROK / SITIO</label>
                <input asp-for="Purok" id="inputLandPurok" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="e.g. Purok Malakas" />
            </div>
            <div>
                <label asp-for="DistrictOrBarangay" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BARANGAY <span class="text-rose-500">*</span></label>
                <select asp-for="DistrictOrBarangay" id="selectLandBarangay" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold cursor-pointer">
                    @if (barangays.Any())
                    {
                        foreach (var b in barangays)
                        {
                            <option value="@b.Name">@b.Name</option>
                        }
                    }
                    else
                    {
                        <option value="Brgy. Central">Brgy. Central</option>
                        <option value="Brgy. Dadiangas East">Brgy. Dadiangas East</option>
                        <option value="Brgy. Dadiangas North">Brgy. Dadiangas North</option>
                        <option value="Brgy. Dadiangas South">Brgy. Dadiangas South</option>
                        <option value="Brgy. Dadiangas West">Brgy. Dadiangas West</option>
                        <option value="Brgy. Lagao">Brgy. Lagao</option>
                        <option value="Brgy. San Isidro">Brgy. San Isidro</option>
                        <option value="Brgy. Calumpang">Brgy. Calumpang</option>
                        <option value="Brgy. City Heights">Brgy. City Heights</option>
                        <option value="Brgy. Labangal">Brgy. Labangal</option>
                    }
                </select>
            </div>
            <div class="md:col-span-2">
                <label asp-for="CityMunicipality" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">CITY / MUNICIPALITY</label>
                <input asp-for="CityMunicipality" id="inputLandCity" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" readonly value="General Santos City" />
            </div>
            <div class="md:col-span-2">
                <label asp-for="Province" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">PROVINCE</label>
                <input asp-for="Province" id="inputLandProvince" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" readonly value="South Cotabato" />
            </div>
        </div>
    </div>

    <!-- Boundaries & Boundary Remarks (CAST Reference) -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
            <i data-lucide="compass" class="w-4 h-4"></i>
            Property Boundaries & Adjacent Lots (with Boundary Remarks)
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label asp-for="BoundaryNorth" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">NORTH BOUNDARY</label>
                        <input asp-for="BoundaryNorth" id="inputLandBNorth" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs" placeholder="Lot 101" />
                    </div>
                    <div>
                        <label asp-for="Nremarks" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">NORTH REMARKS</label>
                        <input asp-for="Nremarks" id="inputLandNRemarks" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-xs" placeholder="e.g. Juan dela Cruz (Lot 101)" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label asp-for="BoundarySouth" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">SOUTH BOUNDARY</label>
                        <input asp-for="BoundarySouth" id="inputLandBSouth" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs" placeholder="Lot 103" />
                    </div>
                    <div>
                        <label asp-for="Sremarks" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">SOUTH REMARKS</label>
                        <input asp-for="Sremarks" id="inputLandSRemarks" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-xs" placeholder="e.g. Existing Residential Lot" />
                    </div>
                </div>
            </div>
            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label asp-for="BoundaryEast" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">EAST BOUNDARY</label>
                        <input asp-for="BoundaryEast" id="inputLandBEast" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs" placeholder="Road Lot" />
                    </div>
                    <div>
                        <label asp-for="Eremarks" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">EAST REMARKS</label>
                        <input asp-for="Eremarks" id="inputLandERemarks" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-xs" placeholder="e.g. 10m Wide Concrete Road" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label asp-for="BoundaryWest" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">WEST BOUNDARY</label>
                        <input asp-for="BoundaryWest" id="inputLandBWest" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs" placeholder="Creek / Lot 104" />
                    </div>
                    <div>
                        <label asp-for="Wremarks" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">WEST REMARKS</label>
                        <input asp-for="Wremarks" id="inputLandWRemarks" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-xs" placeholder="e.g. Natural Drainage Creek" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- TAB 3: OWNER & DEMOGRAPHICS (CAST)         -->
<!-- ========================================== -->
<div id="land-tab-owner" class="land-tab-content space-y-6 hidden">
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="border-b border-slate-200 dark:border-stone-800 pb-3 flex flex-wrap items-center justify-between gap-3">
            <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                <i data-lucide="users" class="w-4 h-4"></i> Owner & Declarant Demographics
            </h4>
            <!-- Checkboxes: Administrator, Beneficial User, Possessor -->
            <div class="flex flex-wrap items-center gap-2">
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300 bg-white dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm hover:border-emerald-500 transition-colors">
                    <input type="checkbox" asp-for="IsAdministrator" id="isLandAdminSwitch" class="land-role-checkbox rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                    <span>ADMINISTRATOR</span>
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300 bg-white dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm hover:border-emerald-500 transition-colors">
                    <input type="checkbox" asp-for="IsBeneficialUser" id="isLandBeneficialSwitch" class="land-role-checkbox rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                    <span>BENEFICIAL USER</span>
                </label>
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300 bg-white dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm hover:border-emerald-500 transition-colors">
                    <input type="checkbox" asp-for="IsPossessor" id="isLandPossessorSwitch" class="land-role-checkbox rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                    <span>POSSESSOR</span>
                </label>
            </div>
        </div>

        <!-- Searchable Active Registered Owner Lookup (Auto-fill All Demographics Fields) -->
        <div class="p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 space-y-2">
            <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase flex items-center gap-2">
                <i data-lucide="user-search" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                Fetch Active Registered Owner from Database (Auto-fill All Fields)
            </label>
            <select id="landRegisteredOwnerSelect" class="w-full">
                <option value="">-- Search active registered owner by Name, TIN, RPTIN, or Barangay --</option>
                @foreach (var owner in registeredOwners)
                {
                    <option value="@owner.Id">@owner.DisplayName (TIN: @owner.TaxIdentNo | @owner.BarangayName)</option>
                }
            </select>
            <p class="text-[11px] text-slate-600 dark:text-stone-300">
                Selecting an active registered owner will automatically populate Owner / Declarant Name, TIN, Contact Number, Residential Address, Email Address, and Gender/Type below.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-2">
                <label asp-for="NewOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">OWNER / DECLARANT NAME</label>
                <input asp-for="NewOwnerName" id="inputLandOwnerName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Full name of owner / declarant" />
            </div>
            <div>
                <label asp-for="OwnerTIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">TAX IDENTIFICATION NO. (TIN)</label>
