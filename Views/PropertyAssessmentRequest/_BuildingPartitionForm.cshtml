    <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-3">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="plus-circle" class="w-4 h-4 text-sky-600"></i> Add Standard Additional Item
            </h3>
            <button type="button" onclick="closeAddAdditionModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <div class="space-y-3.5">
            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                    <span>Item Description</span>
                    <span class="text-[10px] text-sky-600 dark:text-sky-400 font-bold">DATABASE LOOKUP</span>
                </label>
                <select id="modalAddItemSelect" onchange="onAddItemSelectChange()" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs font-bold font-mono text-slate-900 dark:text-white focus:outline-none focus:border-sky-600">
                    <option value="">-- Select Additional Item --</option>
                    @if (ViewBag.BuildingAdditionalItems != null)
                    {
                        foreach (var item in (IEnumerable<PropertyAssessmentApp.Models.BuildingAdditionalItem>)ViewBag.BuildingAdditionalItems)
                        {
                            <option value="@item.Id" data-desc="@item.AdditionalItemDescription" data-rate="@item.CostPerSQM" data-percent="@item.PercentUnitValue">
                                @item.AdditionalItemDescription
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">Quantity / Area</label>
                    <input type="number" id="modalAddItemArea" step="0.01" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold text-slate-900 dark:text-white focus:outline-none focus:border-sky-600" value="1" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">Unit Rate (PHP)</label>
                    <input type="number" id="modalAddItemRate" step="0.01" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold text-slate-900 dark:text-white focus:outline-none focus:border-sky-600" placeholder="0.00" value="0.00" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">Multiplier (%)</label>
                    <input type="number" id="modalAddItemPercent" step="1" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-right font-mono font-bold text-slate-900 dark:text-white focus:outline-none focus:border-sky-600" value="100" />
                </div>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200 dark:border-stone-800">
            <button type="button" onclick="closeAddAdditionModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-stone-700 text-xs font-bold font-mono hover:bg-slate-100 dark:hover:bg-stone-800">Cancel</button>
            <button type="button" onclick="SubmitAddAdditionalItemModal()" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold font-mono inline-flex items-center gap-1.5 shadow-sm transition-all">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Item
            </button>
        </div>
    </div>
</div>
