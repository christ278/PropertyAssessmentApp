                <label asp-for="EffectivityYear" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EFFECTIVITY YEAR</label>
                <input asp-for="EffectivityYear" id="inputEffectivityYear" type="number" min="1950" max="2099" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono font-bold text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="2026" />
