                <label asp-for="EffectivityQuarter" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EFFECTIVITY QUARTER</label>
                <select asp-for="EffectivityQuarter" id="selectEffectivityQuarter" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                    <option value="1st Quarter">1st Quarter</option>
                    <option value="2nd Quarter">2nd Quarter</option>
                    <option value="3rd Quarter">3rd Quarter</option>
                    <option value="4th Quarter">4th Quarter</option>
                </select>
            </div>
            <div>
                <label asp-for="Taxability" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TAXABILITY STATUS</label>
                <select asp-for="Taxability" id="selectTaxability" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                    <option value="Taxable">Taxable</option>
                    <option value="Exempt">Exempt</option>
                </select>
            </div>
            <div>
                <label asp-for="AssessmentBasis" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BASIS OF ASSESSMENT</label>
                <input asp-for="AssessmentBasis" id="inputAssessmentBasis" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Sec. 217 RA 7160" />
            </div>
            <div>
                <label asp-for="BackTaxesYearFrom" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BACK TAXES FROM YEAR</label>
                <input asp-for="BackTaxesYearFrom" id="inputBackTaxesYearFrom" type="number" min="1950" max="2099" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="YYYY" />
            </div>
            <div>
                <label asp-for="BackTaxesYearTo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BACK TAXES TO YEAR</label>
                <input asp-for="BackTaxesYearTo" id="inputBackTaxesYearTo" type="number" min="1950" max="2099" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="YYYY" />
            </div>
        </div>

        <div class="p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 text-[11px] text-emerald-800 dark:text-emerald-300 flex items-start gap-2">
            <i data-lucide="info" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5"></i>
            <div>
                <strong class="font-bold">Sec. 222, R.A. 7160 (Back Taxes on Newly Declared Property):</strong> Real property declared for the first time shall be assessed for back taxes for up to ten (10) preceding years if unassessed since completion.
            </div>
        </div>

        <div>
            <label asp-for="Memoranda" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MEMORANDA & LEGAL ANNOTATIONS</label>
            <textarea asp-for="Memoranda" id="textareaMemoranda" rows="4" class="w-full px-4 py-3 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-xs font-mono uppercase focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="ENTER LEGAL MEMORANDA, BOUNDARIES, DEPRECIATION BASIS, OR PARTITION RESTRICTIONS..."></textarea>
        </div>
    </div>

    <!-- Field Inspection Photo Attachments (Inside last tab below Memoranda & Notes) -->
