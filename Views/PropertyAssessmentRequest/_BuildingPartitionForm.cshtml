                    @if (ViewBag.BuildingStructuralTypes != null)
                    {
                        foreach (var st in (IEnumerable<PropertyAssessmentApp.Models.BuildingStructuralType>)ViewBag.BuildingStructuralTypes)
                        {
                            <option value="@st.StructuralCode">@st.StructuralCode – @st.StructuralDescription</option>
                        }
                    }
                    else
                    {
                        <option value="I-A">I-A – REINFORCED CONCRETE - A</option>
                        <option value="I-B">I-B – REINFORCED CONCRETE - B</option>
                        <option value="II-A">II-A – MIXED CONCRETE - A</option>
                        <option value="II-B">II-B – MIXED CONCRETE - B</option>
                        <option value="III-A">III-A – WOOD - A</option>
                        <option value="IV-A">IV-A – LIGHT MATERIALS</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="BuildingClassification" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                    <span>BUILDING CLASSIFICATION</span>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono font-bold">DATABASE LOOKUP</span>
                </label>
                <select asp-for="BuildingClassification" id="selectBuildingClassification" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
