@model PropertyAssessmentApp.Models.AssessmentPartitionItem
@{
    var registeredOwners = ViewBag.RegisteredOwners as IEnumerable<PropertyAssessmentApp.Models.Owner> ?? Enumerable.Empty<PropertyAssessmentApp.Models.Owner>();
}

<!-- Tab Navigation Header (CAST Style) -->
<div class="flex items-center gap-2 overflow-x-auto border-b border-slate-200 dark:border-stone-800 pb-3">
    <button type="button" onclick="switchTab('tab-general')" id="btn-tab-general" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-emerald-600 text-white shadow-sm flex items-center gap-2 shrink-0">
        <i data-lucide="info" class="w-4 h-4"></i> 1. Property Info & Taxpayer (CCT)
    </button>
    <button type="button" onclick="switchTab('tab-structural')" id="btn-tab-structural" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
        <i data-lucide="building" class="w-4 h-4"></i> 2. Structural Specs & 17 Materials
    </button>
    <button type="button" onclick="switchTab('tab-valuation')" id="btn-tab-valuation" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
        <i data-lucide="calculator" class="w-4 h-4"></i> 3. Floor Levels, Additions & Valuation
    </button>
    <button type="button" onclick="switchTab('tab-memoranda')" id="btn-tab-memoranda" class="tab-btn px-4 py-2.5 rounded-xl text-xs font-bold font-mono transition-all bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-400 border border-slate-200 dark:border-stone-800 hover:bg-slate-200 dark:hover:bg-stone-700 flex items-center gap-2 shrink-0">
        <i data-lucide="file-text" class="w-4 h-4"></i> 4. Back Taxes, Effectivity & Notes
    </button>
</div>

<!-- TAB 1: PROPERTY INFORMATION, TAXPAYER & CCT -->
<div id="tab-general" class="tab-content space-y-6">
    <!-- Identification & Declarant Card -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                <i data-lucide="id-card" class="w-4 h-4 text-emerald-600"></i> Property Identification & Partition TDN
            </h3>
            <span class="text-xs text-slate-400 font-mono">Reference TDN: @(string.IsNullOrWhiteSpace(Model.BaseTDN) ? "New Declaration" : Model.BaseTDN)</span>
        </div>

        <!-- Hidden fields to preserve partition identity & background values -->
        <input type="hidden" asp-for="Classification" />
        <input type="hidden" asp-for="ActualUse" />
        <input type="hidden" asp-for="BlockNumber" />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- 1. Property Type According to Use -->
            <div id="colPropertyType" class="md:col-span-2">
                <label asp-for="PropertyTypeAccordUse" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY TYPE ACCORDING TO USE</label>
                <select asp-for="PropertyTypeAccordUse" id="selectPropertyTypeAccordUse" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                    @if (ViewBag.BuildingPropertyTypesAccordUse != null)
                    {
                        foreach (var pt in (IEnumerable<PropertyAssessmentApp.Models.BuildingPropertyTypeAccordUse>)ViewBag.BuildingPropertyTypesAccordUse)
                        {
                            <option value="@pt.PropertyTypeName">@pt.PropertyTypeName</option>
                        }
                    }
                    else
                    {
                        <option value="Townhouse">Townhouse</option>
                        <option value="Industrial Condominium">Industrial Condominium</option>
                        <option value="Residential Condominium">Residential Condominium</option>
                        <option value="Commercial Condominium">Commercial Condominium</option>
                        <option value="Other Type of Building and/or Structure">Other Type of Building and/or Structure</option>
                    }
                </select>
            </div>

            <!-- 1.b Other Type of Building and/or Structure (Input) -->
            <div id="divOtherPropertyType" class="md:col-span-1 hidden">
                <label asp-for="OtherPropertyTypeAccordUse" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SPECIFY OTHER TYPE</label>
                <input asp-for="OtherPropertyTypeAccordUse" id="inputOtherPropertyType" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Specify other building / structure type..." />
            </div>

            <!-- 2. PROPERTY INDEX NUMBER (PIN) -->
            <div>
                <label asp-for="PIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY INDEX NUMBER (PIN)</label>
                <input asp-for="PIN" id="inputPin" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="126-00-0000-000" />
            </div>

            <!-- 3. SURVEY NO. -->
            <div>
                <label asp-for="SurveyNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SURVEY NO.</label>
                <input asp-for="SurveyNumber" id="inputSurveyNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. Psu-12345" />
            </div>

            <!-- 4. LOT NO. -->
            <div>
                <label asp-for="LotNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT NO.</label>
                <input asp-for="LotNumber" id="inputLotNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. Lot 10-A" />
            </div>

            <!-- 5. TITLE NO. -->
            <div>
                <label asp-for="TitleNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TITLE NO.</label>
                <input asp-for="TitleNo" id="inputTitleNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. TCT-123456 / CCT-7890" />
            </div>

            <!-- 6. AREA IN SQR. (SQ.M.) -->
            <div>
                <label asp-for="AreaSqMeters" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">AREA IN SQR. (SQ.M.)</label>
                <input asp-for="AreaSqMeters" id="inputAssessedArea" type="number" step="0.01" min="0" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono font-bold text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white text-right" placeholder="0.00" />
            </div>

            <!-- 7. SECTION NO. (CAST ARP Combination #1) -->
            <div>
                <label asp-for="SectionNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SECTION NO.</label>
                <input asp-for="SectionNo" id="inputBldgSectionNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. 001" />
            </div>

            <!-- 8. ARP NO. (CAST Combination #1: 187-00-BBBB-SSS-LLL) -->
            <div class="md:col-span-2">
                <label asp-for="ARPNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ARP NO. (CAST FORMAT: LGU-DIST-BRGY-SEC-LOT)</label>
                <input asp-for="ARPNo" id="inputBldgArpNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono font-bold text-xs focus:outline-none focus:border-emerald-600 text-emerald-700 dark:text-emerald-400" placeholder="187-00-0000-000-000" />
            </div>
        </div>
    </div>

    <!-- Owner & Administrator Normalized Demographics Card (CAST Standard) -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                <i data-lucide="users" class="w-4 h-4 text-emerald-600"></i> Owner & Administrator Demographics
            </h3>
            <!-- Flagging: Is Administrator / Beneficial User -->
            <div class="flex items-center gap-2">
                <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300 bg-white dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm hover:border-emerald-500 transition-colors">
                    <input type="checkbox" asp-for="IsAdministrator" id="isAdminSwitch" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                    <span>IS ADMINISTRATOR / BENEFICIAL USER</span>
                </label>
            </div>
        </div>

        <!-- Searchable Active Registered Owner Lookup (Auto-fill All Demographics Fields) -->
        <div class="p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 space-y-2">
            <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase flex items-center gap-2">
                <i data-lucide="user-search" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                Fetch Active Registered Owner from Database (Auto-fill All Fields)
            </label>
            <select id="bldgRegisteredOwnerSelect" class="w-full">
                <option value="">-- Search active registered owner by Name, TIN, RPTIN, or Barangay --</option>
                @foreach (var owner in registeredOwners)
                {
                    <option value="@owner.Id">@owner.DisplayName (TIN: @owner.TaxIdentNo | @owner.BarangayName)</option>
                }
            </select>
            <p class="text-[11px] text-slate-600 dark:text-stone-300">
                Selecting an active registered owner will automatically populate Owner / Administrator Name, Gender/Type, Civil Status, TIN No., Mobile/Contact No., Email Address, and Mailing Address below.
            </p>
        </div>

        <!-- Single Normalized Demographics Form -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div id="divOwnerName" class="md:col-span-2">
                <label asp-for="NewOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER / DECLARANT NAME</label>
                <input asp-for="NewOwnerName" id="inputOwnerName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Full name of owner / declarant" />
            </div>
            <div id="divAdminName" class="md:col-span-2 hidden">
                <label asp-for="AdministratorName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold flex items-center justify-between">
                    <span>ADMINISTRATOR NAME</span>
                    <span id="adminBadge" class="text-[10px] font-mono text-emerald-600 font-bold uppercase">Administrator / Beneficial User</span>
                </label>
                <input asp-for="AdministratorName" id="inputAdminName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Administrator name (if flagged as administrator)" />
            </div>
            <div>
                <label asp-for="OwnerGender" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">GENDER / SEX</label>
                <select asp-for="OwnerGender" id="selectBldgOwnerGender" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Corporate">Corporate / Entity</option>
                </select>
            </div>
            <div>
                <label asp-for="OwnerCivilStatus" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CIVIL STATUS</label>
                <select asp-for="OwnerCivilStatus" id="selectBldgOwnerCivilStatus" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white">
                    <option value="Single">Single</option>
                    <option value="Married">Married</option>
                    <option value="Widowed">Widowed</option>
                    <option value="Divorced">Divorced</option>
                    <option value="Legally Separated">Legally Separated</option>
                    <option value="N/A (Corporate / Entity)">N/A (Corporate / Entity)</option>
                </select>
            </div>
            <div>
                <label asp-for="OwnerTIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TIN NO.</label>
                <input asp-for="OwnerTIN" id="inputBldgOwnerTin" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="000-000-000-000" />
            </div>
            <div>
                <label asp-for="OwnerContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MOBILE / CONTACT NO.</label>
                <input asp-for="OwnerContactNo" id="inputBldgOwnerPhone" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="09XXXXXXXXX" />
            </div>
            <div class="md:col-span-2">
                <label asp-for="OwnerEmail" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EMAIL ADDRESS</label>
                <input asp-for="OwnerEmail" id="inputBldgOwnerEmail" type="email" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="email@example.com" />
            </div>
            <div class="md:col-span-4">
                <label asp-for="OwnerAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MAILING ADDRESS</label>
                <input asp-for="OwnerAddress" id="inputBldgOwnerAddress" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="House / Unit No., Street, Barangay, City, Province" />
            </div>
        </div>
    </div>

    <!-- Two-Column Row: Left (Location & Land Reference & CCT) | Right (Building Floor Plan Sketch) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Left Column: Location of Property & Land Reference -->
        <div class="space-y-6">
            <!-- Location of Property Card (CAST Standard) -->
            <!-- Location Card -->
            <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="map-pin" class="w-4 h-4 text-emerald-600"></i> Location of Property (City of Koronadal Standard)
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-3">
                        <label asp-for="StreetLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">STREET ADDRESS / NO.</label>
                        <input asp-for="StreetLocation" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. 123 Pioneer Avenue" />
                    </div>
                    <div>
                        <label asp-for="DistrictOrBarangay" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BARANGAY <span class="text-rose-500">*</span></label>
                        <select asp-for="DistrictOrBarangay" id="selectBldgBarangay" class="select2-barangay w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold cursor-pointer">
                            @foreach (var b in PropertyAssessmentApp.Controllers.DashboardController.OfficialKoronadalBarangays.OrderBy(x => x.Name))
                            {
                                var isSel = string.Equals(Model.DistrictOrBarangay, b.Name, StringComparison.OrdinalIgnoreCase)
                                         || string.Equals(Model.DistrictOrBarangay, b.Code, StringComparison.OrdinalIgnoreCase)
                                         || (string.IsNullOrWhiteSpace(Model.DistrictOrBarangay) && b.Code == "0001");
                                <option value="@b.Name" selected="@(isSel ? "selected" : null)">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">CITY / MUNICIPALITY</label>
                        <input id="inputBldgCity" class="w-full px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-stone-800/80 border border-slate-200 dark:border-stone-700 font-mono text-xs text-slate-600 dark:text-stone-300 font-bold cursor-not-allowed select-none opacity-80" disabled value="Koronadal City" />
                        <input type="hidden" name="CityMunicipality" value="Koronadal City" />
                    </div>
                    <div>
                        <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">PROVINCE</label>
                        <input id="inputBldgProvince" class="w-full px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-stone-800/80 border border-slate-200 dark:border-stone-700 font-mono text-xs text-slate-600 dark:text-stone-300 font-bold cursor-not-allowed select-none opacity-80" disabled value="South Cotabato" />
                        <input type="hidden" name="Province" value="South Cotabato" />
                    </div>
                </div>
            </div>

            <!-- Reference Land Card -->
            <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="layers" class="w-4 h-4 text-emerald-600"></i> Land Reference (Where Erected)
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="LandOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LAND OWNER NAME</label>
                        <input asp-for="LandOwnerName" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Land owner name" />
                    </div>
                    <div>
                        <label asp-for="LandTdNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LAND TD NO.</label>
                        <input asp-for="LandTdNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="TD-XXXX-XXXX" />
                    </div>
                    <div>
                        <label asp-for="LandPin" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LAND PIN</label>
                        <input asp-for="LandPin" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="126-00-XXXX" />
                    </div>
                </div>
            </div>

            <!-- Condominium Title (CCT) Card -->
            <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="file-badge" class="w-4 h-4 text-emerald-600"></i> Condominium Title (CCT)
                    </h3>
                    <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 dark:text-stone-300">
                        <input type="checkbox" asp-for="IsCct" id="isCctSwitch" class="rounded border-slate-300 text-emerald-600 shadow-sm focus:ring-emerald-500 w-4 h-4" />
                        <span>CONDOMINIUM UNIT (CCT)</span>
                    </label>
                </div>

                <!-- CCT Fields -->
                <div id="cctDetailsRow" class="grid grid-cols-1 md:grid-cols-3 gap-4 hidden bg-amber-50/50 dark:bg-amber-950/20 p-4 rounded-xl border border-amber-200 dark:border-amber-800/40">
                    <div>
                        <label asp-for="CctTitleNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CCT TITLE NO.</label>
                        <input asp-for="CctTitleNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="e.g. CCT-00123" />
                    </div>
                    <div>
                        <label asp-for="CctDateRegistered" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DATE REGISTERED</label>
                        <input asp-for="CctDateRegistered" type="date" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" />
                    </div>
                    <div>
                        <label asp-for="OwnerNameReflectedInCct" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER REFLECTED IN CCT</label>
                        <input asp-for="OwnerNameReflectedInCct" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="Name as shown on CCT" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Building Floor Plan Sketch Attachment (CAST Standard) -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4 flex flex-col justify-between">
            <div>
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="image" class="w-4 h-4 text-emerald-600"></i> Building Floor Plan Sketch
                    </h3>
                    <span class="text-xs text-slate-400 font-mono">Blueprint / Plan</span>
                </div>
                <p class="text-xs text-slate-500 dark:text-stone-400 mt-2 font-mono">
                    Upload a digitized blueprint, sketch, or schematic floor layout for this partition building.
                </p>

                <div class="mt-4">
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">UPLOAD SKETCH / BLUEPRINT FILE</label>
                    <input type="file" id="fileUploadSketch" name="sketchFile" accept="image/jpeg, image/png, image/webp, application/pdf"
                           class="w-full px-3 py-2 text-xs font-mono rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-emerald-50 dark:file:bg-emerald-950/60 file:text-emerald-700 dark:file:text-emerald-300 hover:file:bg-emerald-100 cursor-pointer"
                           onchange="previewSketchImage(event)" />
                </div>

                <!-- Preview Container Box -->
                <div class="mt-4 border-2 border-dashed border-slate-200 dark:border-stone-800 rounded-xl p-3 text-center bg-white dark:bg-stone-900 flex flex-col items-center justify-center min-h-[260px] relative overflow-hidden">
                    <img id="sketchPreviewImg" src="@(!string.IsNullOrEmpty(Model.BuildingFloorPlanSketchBase64) ? Model.BuildingFloorPlanSketchBase64 : (!string.IsNullOrEmpty(Model.BuildingFloorPlanSketchPath) ? Model.BuildingFloorPlanSketchPath : ""))"
                         class="max-h-60 max-w-full rounded-lg object-contain shadow-sm border border-slate-200 dark:border-stone-800 @(string.IsNullOrEmpty(Model.BuildingFloorPlanSketchBase64) && string.IsNullOrEmpty(Model.BuildingFloorPlanSketchPath) ? "hidden" : "")"
                         alt="Floor Plan Sketch Preview" />

                    <div id="sketchPlaceholder" class="p-6 text-center text-slate-400 dark:text-stone-500 @(!string.IsNullOrEmpty(Model.BuildingFloorPlanSketchBase64) || !string.IsNullOrEmpty(Model.BuildingFloorPlanSketchPath) ? "hidden" : "")">
                        <i data-lucide="image" class="w-12 h-12 mx-auto mb-2 text-slate-300 dark:text-stone-600"></i>
                        <p class="text-xs font-mono font-bold text-slate-600 dark:text-stone-400">No Building Sketch Attached</p>
                        <p class="text-[11px] font-mono text-slate-400 dark:text-stone-500 mt-1">Upload a blueprint, floor plan, or structural sketch</p>
                        <p class="text-[10px] font-mono text-slate-400 dark:text-stone-500">Supports JPG, PNG, WebP</p>
                    </div>
                </div>
            </div>

            <!-- Sketch Footer & Actions -->
            <div class="pt-3 border-t border-slate-200 dark:border-stone-800 flex items-center justify-between">
                <span class="text-[11px] font-mono text-slate-400" id="sketchFilenameDisplay">@(string.IsNullOrEmpty(Model.BuildingFloorPlanSketchPath) ? "No file chosen" : Model.BuildingFloorPlanSketchPath)</span>
                <button type="button" id="btnClearSketch" onclick="clearSketchImage()" class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold text-rose-600 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors flex items-center gap-1.5 @(string.IsNullOrEmpty(Model.BuildingFloorPlanSketchBase64) && string.IsNullOrEmpty(Model.BuildingFloorPlanSketchPath) ? "hidden" : "")">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Clear Sketch
                </button>
            </div>

            <!-- Hidden fields to preserve sketch path / base64 string -->
            <input type="hidden" asp-for="BuildingFloorPlanSketchPath" id="BuildingFloorPlanSketchPath" />
            <input type="hidden" asp-for="BuildingFloorPlanSketchBase64" id="BuildingFloorPlanSketchBase64" />
        </div>
    </div>
</div>

<!-- TAB 2: STRUCTURAL CHARACTERISTICS & 17 MATERIALS -->
<div id="tab-structural" class="tab-content space-y-6 hidden">
    <!-- Timeline & Classification Card -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
