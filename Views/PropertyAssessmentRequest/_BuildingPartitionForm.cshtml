                    {
                        foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.BuildingClassifications)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                    else
                    {
                        <option value="Class A - Reinforced Concrete">Class A - Reinforced Concrete</option>
                        <option value="Class B - Semi-Concrete / Hollow Blocks">Class B - Semi-Concrete / Hollow Blocks</option>
                        <option value="Class C - Reinforced Concrete & Wood">Class C - Reinforced Concrete & Wood</option>
                        <option value="Class D - Wood / Timber Frame">Class D - Wood / Timber Frame</option>
                        <option value="Class E - Light Materials / Mixed">Class E - Light Materials / Mixed</option>
