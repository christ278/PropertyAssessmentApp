            </div>
            <div>
                <label asp-for="BuildingPermitNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BUILDING PERMIT NO.</label>
                <input asp-for="BuildingPermitNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="BP-XXXX-XXXX" />
            </div>
            <div>
                <label asp-for="OccupancyPermitNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OCCUPANCY PERMIT NO.</label>
                <input asp-for="OccupancyPermitNo" id="inputOccupancyPermitNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" placeholder="OP-XXXX-XXXX" />
            </div>
            <div>
                <label asp-for="BuildingAgeYears" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BUILDING AGE (YEARS)</label>
                <input asp-for="BuildingAgeYears" id="inputBuildingAge" type="number" min="0" value="@(Model.BuildingAgeYears > 0 ? Model.BuildingAgeYears.ToString() : (Model.BuildingAge > 0 ? Model.BuildingAge.ToString() : ""))" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-mono text-right font-bold text-xs focus:outline-none focus:border-emerald-600 text-slate-900 dark:text-white" />
            </div>
            <div>
                <label asp-for="DateConstructed" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DATE CONSTRUCTED / STARTED</label>
