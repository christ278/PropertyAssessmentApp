@model IEnumerable<PropertyAssessmentApp.Models.PropertyAssessmentRequest>
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = "Property Assessment Requests (RPA)";
    var currentStatus = ViewBag.Status as PropertyAssessmentStatus?;
    var currentSearch = ViewBag.Search as string;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var pendingCount = ViewBag.PendingCount as int? ?? 0;
    var approvedCount = ViewBag.ApprovedCount as int? ?? 0;
}

<div class="space-y-6 font-mono text-xs">
    
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="layers" class="w-4 h-4"></i>
                <span>Real Property Appraisal & FAAS Partitioning</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Property Assessment Requests</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Encode property appraisals, transfers of ownership, subdividing lots into partitions, and FAAS issuance.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Create" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs font-mono shadow-sm shadow-emerald-600/20 transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>File Assessment Request</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600"></i>
                <span class="font-bold">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-800">&times;</button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Assessment Requests</p>
                <h3 class="text-2xl font-black text-slate-900 dark:text-white mt-1">@totalCount</h3>
            </div>
            <div class="p-3 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-300">
                <i data-lucide="files" class="w-5 h-5"></i>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold text-amber-500 uppercase tracking-wider">In Appraisal / Valuation</p>
                <h3 class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">@pendingCount</h3>
            </div>
            <div class="p-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600">
                <i data-lucide="calculator" class="w-5 h-5"></i>
            </div>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">Approved & TDNs Issued</p>
                <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">@approvedCount</h3>
            </div>
            <div class="p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600">
                <i data-lucide="award" class="w-5 h-5"></i>
            </div>
        </div>
    </div>

    <!-- Filter & Table Card -->
    <div class="p-6 rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm space-y-4">
        
        <!-- Filter Form -->
        <form method="get" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
                <input type="text" name="search" value="@currentSearch" placeholder="Search Tracking No, New Owner, Prev Owner, TDN..." class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs focus:outline-none focus:border-emerald-600" />
            </div>
            <div>
                <select name="status" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs focus:outline-none focus:border-emerald-600">
                    <option value="">-- All Statuses --</option>
                    @foreach (PropertyAssessmentStatus s in Enum.GetValues(typeof(PropertyAssessmentStatus)))
                    {
                        <option value="@s" selected="@(currentStatus == s ? "selected" : null)">@s</option>
                    }
                </select>
            </div>
            <div class="flex items-center gap-2 bg-slate-50 dark:bg-stone-800 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 shadow-xs shrink-0">
                <span class="limit-label text-[10px] text-slate-500 dark:text-emerald-400 font-extrabold uppercase">Limit:</span>
                <select class="table-limit-select bg-transparent font-extrabold text-slate-900 dark:text-white focus:outline-none cursor-pointer">
                    <option value="5" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">5</option>
                    <option value="10" selected class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">10</option>
                    <option value="25" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">25</option>
                    <option value="50" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">50</option>
                    <option value="100" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">100</option>
                </select>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-stone-800 text-white font-bold hover:bg-slate-800 transition-all flex items-center gap-1.5">
                    <i data-lucide="search" class="w-3.5 h-3.5"></i>
                    <span>Filter</span>
                </button>
                <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold hover:bg-slate-200 transition-all">
                    Reset
                </a>
            </div>
        </form>

        <!-- Requests Table -->
        <div class="border border-slate-200 dark:border-stone-800 rounded-2xl overflow-hidden paginated-table-card">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 uppercase tracking-wider">
                        <tr>
                            <th class="px-3 sm:px-4 py-3">Tracking No.</th>
                            <th class="hidden md:table-cell px-4 py-3">Transaction</th>
                            <th class="px-3 sm:px-4 py-3">New Owner / Declarant</th>
                            <th class="hidden lg:table-cell px-4 py-3">Previous Property</th>
                            <th class="hidden xl:table-cell px-4 py-3 text-center">Partitions</th>
                            <th class="hidden sm:table-cell px-4 py-3 text-right">Fee (₱)</th>
                            <th class="px-2 sm:px-4 py-3">Status</th>
                            <th class="hidden xl:table-cell px-4 py-3">Attachment</th>
                            <th class="px-2 sm:px-4 py-3 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-stone-800">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="px-4 py-8 text-center text-slate-400 dark:text-stone-500">
                                    <div class="flex flex-col items-center gap-2">
                                        <i data-lucide="inbox" class="w-8 h-8 stroke-1"></i>
                                        <span>No Property Assessment Requests found. Click "File Assessment Request" to begin.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="hover:bg-slate-50/60 dark:hover:bg-stone-800/40 transition-colors">
                                    <td class="px-3 sm:px-4 py-3 font-bold text-emerald-700 dark:text-emerald-400">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="hover:underline flex items-center gap-1.5">
                                            <i data-lucide="file-check-2" class="w-3.5 h-3.5"></i>
                                            @item.TrackingNumber
                                        </a>
                                        <span class="block text-[10px] text-slate-400 font-normal">@item.RequestDate.ToString("yyyy-MM-dd HH:mm")</span>
                                        <div class="md:hidden mt-1 text-[10px] text-slate-600 dark:text-stone-400 font-bold">
                                            @item.TransactionTypeDisplayName
                                        </div>
                                    </td>
                                    <td class="hidden md:table-cell px-4 py-3">
                                        <span class="inline-block px-2 py-0.5 rounded font-bold text-[10px] bg-slate-100 dark:bg-stone-800 text-slate-800 dark:text-stone-200">
                                            @item.TransactionTypeDisplayName
                                        </span>
                                        <span class="block text-[10px] text-slate-400 mt-0.5">Kind: @item.Kind</span>
                                    </td>
                                    <td class="px-3 sm:px-4 py-3">
                                        <span class="font-bold text-slate-900 dark:text-white">@item.NewOwnerName</span>
                                        <span class="block text-[10px] text-slate-400">@item.Address</span>
                                        <div class="sm:hidden mt-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">
                                            ₱@item.TotalFeesAmount.ToString("N2")
                                        </div>
                                    </td>
                                    <td class="hidden lg:table-cell px-4 py-3">
                                        <span class="font-semibold text-slate-700 dark:text-stone-300">@item.PrevOwner</span>
                                        <span class="block text-[10px] text-slate-400">TD: @item.PrevTDN</span>
                                    </td>
                                    <td class="hidden xl:table-cell px-4 py-3 text-center">
                                        <span class="inline-block px-2 py-0.5 rounded-full font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                            @item.Partitions lot@(item.Partitions > 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td class="hidden sm:table-cell px-4 py-3 text-right font-bold text-slate-900 dark:text-white">
                                        ₱@item.TotalFeesAmount.ToString("N2")
                                    </td>
                                    <td class="px-2 sm:px-4 py-3">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold 
                                            @(item.Status == PropertyAssessmentStatus.Approved ? "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-300" :
                                              item.Status == PropertyAssessmentStatus.Deferred ? "bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-300" :
                                              "bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-300")">
                                            @item.Status
                                        </span>
                                        @if (item.Status == PropertyAssessmentStatus.Receiving || item.Status == PropertyAssessmentStatus.Pending)
                                        {
                                            @if (string.IsNullOrWhiteSpace(item.ORNumber))
                                            {
                                                <div class="mt-1">
                                                    <span class="inline-flex items-center gap-1 text-[10px] font-mono text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 px-1.5 py-0.5 rounded-md" title="Saved without O.R. - Must input O.R. before forwarding to GIS Mapping">
                                                        <i data-lucide="alert-circle" class="w-3 h-3 text-amber-600"></i> O.R. Pending
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mt-1 text-[10px] text-emerald-600 dark:text-emerald-400 font-mono font-bold">
                                                    O.R. @item.ORNumber
                                                </div>
                                            }
                                        }
                                    </td>
                                    <td class="hidden xl:table-cell px-4 py-3">
                                        @if (!string.IsNullOrEmpty(item.AttachmentFileName))
                                        {
                                            <a asp-action="DownloadAttachment" asp-route-id="@item.Id" class="inline-flex items-center gap-1 text-emerald-600 hover:text-emerald-700 font-bold text-[11px]">
                                                <i data-lucide="paperclip" class="w-3.5 h-3.5"></i>
                                                <span class="truncate max-w-[120px]">@item.AttachmentFileName</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">None</span>
                                        }
                                    </td>
                                    <td class="px-2 sm:px-4 py-3 text-center">
                                        <div class="flex items-center justify-center gap-1.5">
                                            @if (item.Status == PropertyAssessmentStatus.Receiving || item.Status == PropertyAssessmentStatus.Pending)
                                            {
                                                <button type="button" onclick="openIndexForwardModal('@item.Id', '@item.TrackingNumber', '@(item.ORNumber ?? "")')" class="p-1.5 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-950/60 dark:text-emerald-300 hover:scale-105 transition-all" title="Forward to GIS Mapping">
                                                    <i data-lucide="arrow-right-circle" class="w-4 h-4"></i>
                                                </button>
                                            }
                                            <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 rounded-lg bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 hover:bg-slate-200" title="Details / Partition">
                                                <i data-lucide="eye" class="w-4 h-4"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 rounded-lg bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 hover:bg-slate-200" title="Edit">
                                                <i data-lucide="edit" class="w-4 h-4"></i>
                                            </a>
                                            <a asp-action="PrintPdf" asp-route-id="@item.Id" target="_blank" class="p-1.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100" title="Print Tax Declaration (PDF)">
                                                <i data-lucide="printer" class="w-4 h-4"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            <div class="table-pagination-footer p-4 sm:p-6 pt-4 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-200 dark:border-stone-800 text-xs font-mono">
                <div class="text-slate-500 dark:text-stone-400 text-center sm:text-left">
                    Showing <span class="font-bold text-slate-900 dark:text-white table-showing-start">1</span> to 
                    <span class="font-bold text-slate-900 dark:text-white table-showing-end">10</span> of 
                    <span class="font-bold text-slate-900 dark:text-white table-total-count">@Model.Count()</span> entries
                </div>
                <div class="flex items-center gap-1.5 flex-wrap justify-center table-pagination-buttons">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- QUICK FORWARD MODAL (With O.R. Validation) -->
<div id="indexForwardModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 font-mono text-xs">
    <div class="w-full max-w-lg bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-2xl p-6 sm:p-8 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center font-bold">
                    <i data-lucide="arrow-right-circle" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900 dark:text-white">Forward to GIS Mapping</h3>
                    <p class="text-xs text-slate-500 dark:text-stone-400">Tracking No: <span id="modalIdxTrackingNo" class="font-bold text-slate-800 dark:text-stone-200 font-mono"></span></p>
                </div>
            </div>
            <button type="button" onclick="closeIndexForwardModal()" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-stone-200 rounded-xl hover:bg-slate-100 dark:hover:bg-stone-800 transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <form asp-action="ForwardRequest" method="post" id="indexForwardForm" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="modalIdxId" />
            <input type="hidden" name="targetStatus" value="@PropertyAssessmentStatus.Replotting" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

            <div id="modalIdxOrRequiredBox" class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 text-amber-900 dark:text-amber-200 text-xs space-y-1">
                <div class="font-bold flex items-center gap-1.5">
                    <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-600 shrink-0"></i>
                    <span>O.R. Number Required Before Forwarding</span>
                </div>
                <p class="text-[11px] text-amber-800 dark:text-amber-300">
                    This request was saved without an Official Receipt. Before it can be forwarded to the GIS Mapping Division, please input the O.R. Number.
                </p>
            </div>

            <div id="modalIdxOrVerifiedBox" class="hidden p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60 text-emerald-900 dark:text-emerald-200 text-xs space-y-1">
                <div class="font-bold flex items-center gap-1.5">
                    <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600 shrink-0"></i>
                    <span>Official Receipt Verified</span>
                </div>
                <p class="text-[11px] text-emerald-800 dark:text-emerald-300">
                    O.R. Number: <span id="modalIdxOrDisplay" class="font-mono font-bold"></span>
                </p>
            </div>

            <div id="modalIdxOrInputGroup">
                <label class="block text-slate-700 dark:text-stone-300 font-bold text-xs mb-1">
                    OFFICIAL RECEIPT (O.R.) NUMBER <span class="text-rose-500">*</span>
                </label>
                <input type="text" name="orNumber" id="modalIdxOrNumber" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono text-xs font-bold text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="e.g. OR-2026-00123" />
            </div>

            <div id="modalIdxOrDateGroup">
                <label class="block text-slate-700 dark:text-stone-300 font-bold text-xs mb-1">
                    O.R. DATE ISSUED
                </label>
                <input type="date" name="orDateIssued" id="modalIdxOrDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono text-xs text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-700 dark:text-stone-300 font-bold text-xs mb-1">
                    REMARKS / ROUTING NOTES (OPTIONAL)
                </label>
                <textarea name="remarks" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-xs text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="e.g. Forwarded for GIS cadastral boundary replotting..."></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <button type="button" onclick="closeIndexForwardModal()" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold text-xs transition-colors">
                    Cancel
                </button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-2 shadow-sm transition-all">
                    <i data-lucide="arrow-right-circle" class="w-4 h-4"></i>
                    <span>Confirm & Forward Request</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openIndexForwardModal(id, trackingNo, currentOr) {
        document.getElementById('modalIdxId').value = id;
        document.getElementById('modalIdxTrackingNo').textContent = trackingNo;
        const orInput = document.getElementById('modalIdxOrNumber');
        const reqBox = document.getElementById('modalIdxOrRequiredBox');
        const verBox = document.getElementById('modalIdxOrVerifiedBox');
        const orDisplay = document.getElementById('modalIdxOrDisplay');

        if (currentOr && currentOr.trim().length > 0) {
            orInput.value = currentOr.trim();
            orInput.required = false;
            if (reqBox) reqBox.classList.add('hidden');
            if (verBox) verBox.classList.remove('hidden');
            if (orDisplay) orDisplay.textContent = currentOr.trim();
        } else {
            orInput.value = '';
            orInput.required = true;
            if (reqBox) reqBox.classList.remove('hidden');
            if (verBox) verBox.classList.add('hidden');
        }

        const modal = document.getElementById('indexForwardModal');
        if (modal) {
            modal.classList.remove('hidden');
            if (!currentOr) orInput.focus();
            if (window.lucide) lucide.createIcons();
        }
    }

    function closeIndexForwardModal() {
        const modal = document.getElementById('indexForwardModal');
        if (modal) modal.classList.add('hidden');
    }
</script>
