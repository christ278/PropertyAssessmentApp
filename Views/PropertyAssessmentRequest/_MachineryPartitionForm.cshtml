<!-- TAB 3: MEMORANDA, EFFECTIVITY & BACK TAXES (CAST)         -->
<!-- ========================================================= -->
<div id="machinery-tab-memoranda" class="machinery-tab-content space-y-6 hidden">
    <!-- Effectivity & Taxability (CAST Standard) -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            Effectivity of Assessment / Re-assessment &amp; Taxability (CAST Standard)
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label asp-for="Taxability" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">TAXABILITY STATUS</label>
                <select asp-for="Taxability" id="selectMachineryTaxability" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold cursor-pointer text-xs">
                    <option value="Taxable">Taxable</option>
                    <option value="Exempt">Exempt</option>
                </select>
            </div>
            <div>
                <label asp-for="EffectivityQuarter" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">EFFECTIVITY QUARTER (QTR.)</label>
                <select asp-for="EffectivityQuarter" id="selectMachineryEffQuarter" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold cursor-pointer text-xs">
                    <option value="1st Quarter">1st Quarter</option>
                    <option value="2nd Quarter">2nd Quarter</option>
                    <option value="3rd Quarter">3rd Quarter</option>
                    <option value="4th Quarter">4th Quarter</option>
                </select>
            </div>
            <div>
                <label asp-for="EffectivityYear" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">EFFECTIVITY YEAR (YR.)</label>
                <input asp-for="EffectivityYear" id="inputMachineryEffYear" type="number" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold text-xs" value="@(Model.EffectivityYear ?? DateTime.Now.Year)" />
            </div>
            <div>
                <label asp-for="AssessmentBasis" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BASIS OF ASSESSMENT</label>
                <input asp-for="AssessmentBasis" id="inputMachineryAssessmentBasis" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold text-xs" value="Sec. 224-225 RA 7160" />
            </div>
            <div>
                <label asp-for="BackTaxesYearFrom" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BACK TAXES FROM YEAR</label>
                <input asp-for="BackTaxesYearFrom" id="inputMachineryBackTaxesFrom" type="number" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs" placeholder="YYYY (Optional)" />
            </div>
            <div>
                <label asp-for="BackTaxesYearTo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-xs">BACK TAXES TO YEAR</label>
                <input asp-for="BackTaxesYearTo" id="inputMachineryBackTaxesTo" type="number" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs" placeholder="YYYY (Optional)" />
            </div>
        </div>
    </div>

    <!-- Memoranda & Notes (CAST Standard) -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-4">
        <h4 class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-400 flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
            <i data-lucide="clipboard-list" class="w-4 h-4"></i>
            Memoranda (CAST Reference)
        </h4>
        <div>
            <textarea asp-for="Memoranda" id="textareaMachineryMemoranda" rows="5" class="w-full px-4 py-3 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs uppercase focus:outline-none focus:border-emerald-600" placeholder="ENTER MEMORANDA, INVOICE REFERENCES, SUPPLIER DETAILS, OR SWORN STATEMENT NOTES..."></textarea>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: ADD / EDIT MACHINERY DETAIL (EXACT CAST #machineryDetailModal)     -->
<!-- ========================================================================= -->
<div id="machineryDetailModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden font-mono text-xs">
    <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-2xl w-full max-w-4xl p-6 shadow-2xl space-y-5 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-3">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2" id="machineryModalTitle">
                <i data-lucide="cpu" class="w-4 h-4 text-emerald-600"></i>
                <span>Add Machinery Appraisal Detail (CAST Specification)</span>
            </h3>
            <button type="button" onclick="closeMachineryDetailModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <input type="hidden" id="machineryModalEditIndex" value="-1" />

        <!-- Group 1: Classification, Description/Brand & Capacity -->
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-3">
            <h4 class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase flex items-center gap-1.5 border-b border-slate-200 dark:border-stone-800 pb-2">
                <span class="w-5 h-5 rounded-full bg-emerald-600 text-white inline-flex items-center justify-center text-[10px]">1</span>
                Machinery Classification &amp; Specification
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CLASSIFICATION <span class="text-rose-500">*</span></label>
                    <input type="text" id="m_Classification" list="machineryClassificationList" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white uppercase" placeholder="e.g. INDUSTRIAL / COMMERCIAL" />
                    <datalist id="machineryClassificationList">
                        <option value="INDUSTRIAL"></option>
                        <option value="COMMERCIAL"></option>
                        <option value="RESIDENTIAL"></option>
                        <option value="AGRICULTURAL"></option>
                        <option value="SPECIAL"></option>
                    </datalist>
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DESCRIPT/BRAND <span class="text-rose-500">*</span></label>
                    <input type="text" id="m_BrandModel" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white uppercase" placeholder="e.g. GENERATOR SET - CATERPILLAR C15" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">RATED CAPACITY <span class="text-rose-500">*</span></label>
                    <input type="text" id="m_Capacity" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white uppercase" placeholder="e.g. 500 KVA / 150 HP" />
                </div>
            </div>
        </div>

        <!-- Group 2: Condition, Dates & Economic Life -->
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-3">
            <h4 class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase flex items-center gap-1.5 border-b border-slate-200 dark:border-stone-800 pb-2">
                <span class="w-5 h-5 rounded-full bg-emerald-600 text-white inline-flex items-center justify-center text-[10px]">2</span>
                Condition, Acquisition &amp; Economic Life
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONDITION WHEN ACQUIRED</label>
                    <select id="m_Condition" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white">
                        <option value="NEW">NEW</option>
                        <option value="SECOND HAND">SECOND HAND</option>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DATE ACQUIRED</label>
                    <input type="date" id="m_AcquiredDate" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ECONOMIC LIFE (YRS)</label>
                    <input type="number" id="m_EstLife" min="0" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-right font-bold text-slate-900 dark:text-white" value="20" oninput="recomputeMachineryModalValues()" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">YEAR INSTALLED</label>
                    <input type="number" id="m_YearInstalled" min="1900" max="2100" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-right font-bold text-slate-900 dark:text-white" placeholder="YYYY" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">YEAR OPERATION</label>
                    <input type="number" id="m_YearOperation" min="1900" max="2100" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-right font-bold text-slate-900 dark:text-white" placeholder="YYYY" oninput="onMachineryOperationYearChange()" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">NO. OF YEARS</label>
                    <input type="number" id="m_YearsUsed" min="0" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-right font-bold text-slate-900 dark:text-white" value="0" oninput="recomputeMachineryModalValues()" />
                </div>
                <div class="md:col-span-2">
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REMAINING ECOLIFE (ECOLIFE - NO. OF YEARS)</label>
                    <input type="number" id="m_RemLife" min="0" readonly class="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-stone-800 border border-slate-200 dark:border-stone-700 text-right font-bold text-slate-900 dark:text-white" value="20" />
                </div>
            </div>
        </div>

        <!-- Group 3: Cost, Depreciation & Market Value -->
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-3">
            <h4 class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase flex items-center gap-1.5 border-b border-slate-200 dark:border-stone-800 pb-2">
                <span class="w-5 h-5 rounded-full bg-emerald-600 text-white inline-flex items-center justify-center text-[10px]">3</span>
                Cost, Depreciation &amp; Market Value Computation
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ACQUISITION / ORIGINAL COST (₱) <span class="text-rose-500">*</span></label>
                    <input type="number" step="0.01" min="0" id="m_OriginalCost" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-right font-bold text-slate-900 dark:text-white" placeholder="0.00" value="0.00" oninput="onMachineryCostInput()" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">INSTALLATION AND OTHER (₱)</label>
                    <input type="number" step="0.01" min="0" id="m_InstallationCost" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-right font-bold text-slate-900 dark:text-white" placeholder="0.00" value="0.00" oninput="onMachineryCostInput()" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TOTAL COST (₱)</label>
                    <input type="number" step="0.01" min="0" id="m_TotalCost" readonly class="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-stone-800 border border-slate-200 dark:border-stone-700 text-right font-bold text-slate-900 dark:text-white" placeholder="0.00" value="0.00" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">RATE DEPRECIATION (%)</label>
                    <input type="number" step="0.01" min="0" max="100" id="m_DepPercentage" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-right font-bold text-rose-600 dark:text-rose-400" placeholder="0.00" value="0" oninput="recomputeMachineryModalValues(true)" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DEPRECIATION VALUE (AUTO COMPUTE) (₱)</label>
                    <input type="number" step="0.01" min="0" id="m_DepValue" class="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-stone-800 border border-slate-200 dark:border-stone-700 text-right font-bold text-rose-600 dark:text-rose-400" readonly value="0.00" />
                </div>
                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">MARKET VALUE (LESS DEPRECIATION) (₱)</label>
                    <input type="number" step="0.01" min="0" id="m_DepreciatedValue" class="w-full px-3 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-right font-black text-emerald-700 dark:text-emerald-400" readonly value="0.00" />
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-200 dark:border-stone-800">
            <button type="button" onclick="closeMachineryDetailModal()" class="px-4 py-2 rounded-xl border border-slate-300 dark:border-stone-700 text-xs font-bold font-mono hover:bg-slate-100 dark:hover:bg-stone-800">Cancel</button>
            <button type="button" onclick="saveMachineryDetailModal()" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold font-mono inline-flex items-center gap-1.5 shadow-sm transition-all">
                <i data-lucide="check" class="w-3.5 h-3.5"></i> Save Machinery Detail
            </button>
        </div>
    </div>
</div>
