        function updatePartitionField(idx, field, val) {
            if (generatedPartitions[idx]) {
                generatedPartitions[idx][field] = val;
                serializePartitions();
            }
        }

        function updatePartitionOwner(idx, val) {
            if (generatedPartitions[idx]) {
                generatedPartitions[idx].newOwnerName = val;
                serializePartitions();
            }
        }

        function updatePartitionArea(idx, val) {
            if (generatedPartitions[idx]) {
                const area = parseFloat(val) || 0;
                generatedPartitions[idx].areaSqMeters = area;
                recalculateRowValuation(idx);
            }
        }

        function updatePartitionUnitValue(idx, val) {
            if (generatedPartitions[idx]) {
                const unitVal = parseFloat(val) || 0;
                generatedPartitions[idx].unitValue = unitVal;
                recalculateRowValuation(idx);
            }
        }

        function updatePartitionAssessLevel(idx, val) {
            if (generatedPartitions[idx]) {
                const lvl = parseFloat(val) || 0;
                generatedPartitions[idx].assessmentLevelPercent = lvl;
                recalculateRowValuation(idx);
            }
        }

        function recalculateRowValuation(idx) {
            const p = generatedPartitions[idx];
            if (!p) return;
            const mv = Math.round((p.areaSqMeters * p.unitValue) * 100) / 100;
            const av = Math.round((mv * (p.assessmentLevelPercent / 100)) * 100) / 100;
            p.marketValue = mv;
            p.assessedValue = av;

            const row = document.querySelector(`tr[data-partition-idx="${idx}"]`);
            if (row) {
                row.querySelector('.partition-marketval').textContent = `₱${mv.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                row.querySelector('.partition-assessedval').textContent = `₱${av.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            }

            updatePartitionsFootTotals();
            serializePartitions();
        }

        function resolveCastBrgyCode(brgyVal, defaultCode = '0001') {
            if (!brgyVal) return defaultCode;
            const raw = String(brgyVal).trim();
            if (/^\d+$/.test(raw)) return raw.slice(-4).padStart(4, '0');
            const u = raw.toUpperCase();
            const map = [
                ['DADIANGAS EAST', '0001'], ['CENTRAL', '0001'], ['POBLACION', '0001'], ['ZONE 1', '0001'],
                ['LAGAO', '0002'], ['MORALES', '0002'], ['CALUMPANG', '0003'], ['SAN ISIDRO', '0004'],
                ['CITY HEIGHTS', '0005'], ['DADIANGAS NORTH', '0006'], ['DADIANGAS SOUTH', '0007'],
                ['DADIANGAS WEST', '0008'], ['LABANGAL', '0009'], ['APOPONG', '0010'], ['BALUAN', '0011'],
                ['BATOMELONG', '0012'], ['BUAYAN', '0013'], ['BULA', '0014'], ['CONEL', '0015'],
                ['FATIMA', '0016'], ['KATANGAWAN', '0017'], ['LIGAYA', '0018'], ['MABUHAY', '0019'],
                ['OLYMPOG', '0020'], ['SAN JOSE', '0021'], ['SIGUEL', '0022'], ['SINAWAL', '0023'],
                ['TAMBLER', '0024'], ['TINAGACAN', '0025'], ['UPPER LABAY', '0026'], ['SALITRAN', '0027']
            ];
            for (const [k, c] of map) {
                if (u.includes(k)) return c;
            }
            const digits = raw.replace(/\D/g, '');
            if (digits) return digits.slice(-4).padStart(4, '0');
            return defaultCode;
        }

        function formatThreeDigitPart(val) {
            if (!val) return '000';
            const m = String(val).match(/\d+/);
            if (m) return m[0].slice(-3).padStart(3, '0');
            return String(val).replace(/[^a-zA-Z0-9]/g, '').slice(0, 3).toUpperCase().padStart(3, '0') || '000';
        }

        // CAST Combination #1: {LGUCode}-{DistrictMunicipalityCode}-{BarangayCode:D4}-{SectionNo:D3}-{LotOrParcelNo:D3}
        function formatCastArpNumber(brgyVal, sectionNo, lotOrParcelNo, lgu = '187', mun = '00') {
            const brgy4 = resolveCastBrgyCode(brgyVal, '0000');
            const sec3 = formatThreeDigitPart(sectionNo);
            const lot3 = formatThreeDigitPart(lotOrParcelNo);
            return `${String(lgu).padStart(3, '0')}-${String(mun).padStart(2, '0')}-${brgy4}-${sec3}-${lot3}`;
        }

        // CAST Combination #2: {RevisionYearLastTwoDigits:D2}-{BarangayCode:D4}-{DeclarationNo:D5}
        function generateSystemTDN(letterSuffix, brgyVal, seqIndex) {
            const revYearLastTwo = String(new Date().getFullYear() % 100).padStart(2, '0');
            const brgy4 = resolveCastBrgyCode(brgyVal, '0001');
            const baseCount = Object.keys(referencePropertiesData || {}).length;
            const seqNum = typeof seqIndex === 'number' && seqIndex > 0
                ? (baseCount + seqIndex)
                : (baseCount + (generatedPartitions ? generatedPartitions.length + 1 : 1));
            const declNo5 = String(seqNum).padStart(5, '0');
            return `${revYearLastTwo}-${brgy4}-${declNo5}`;
        }

        function regeneratePartitionTDN(idx) {
            if (generatedPartitions[idx]) {
                const p = generatedPartitions[idx];
                const letter = p.partitionIndex || alphabetLetters[idx % alphabetLetters.length];
                p.systemGeneratedTDN = generateSystemTDN(letter, p.districtOrBarangay, idx + 1);
                p.arpNo = formatCastArpNumber(p.districtOrBarangay, p.sectionNo || '001', p.parcelNo || p.lotNumber || `${idx + 1}`);
                renderPartitionsTable();
            }
        }

        function removePartition(idx) {
            generatedPartitions.splice(idx, 1);
            generatedPartitions.forEach((p, i) => {
                p.partitionIndex = alphabetLetters[i % alphabetLetters.length];
            });
            renderPartitionsTable();
        }

        function handleAddManualPartitionLot() {
            const idx = generatedPartitions.length;
            const letter = alphabetLetters[idx % alphabetLetters.length];
            const newOwner = (document.querySelector('input[name="NewOwnerName"]').value || '').trim();
            const reqKindEl = document.querySelector('select[name="Kind"]');
            const effKind = reqKindEl && reqKindEl.value ? reqKindEl.value : "Land";
            const brgyName = "Brgy. Central";
            const arpCombined = formatCastArpNumber(brgyName, '001', `${idx + 1}`);

            generatedPartitions.push({
                partitionIndex: letter,
                baseTDN: document.getElementById('PrevTDN') ? document.getElementById('PrevTDN').value : "Manual",
                basePropertyId: null,
                systemGeneratedTDN: generateSystemTDN(letter, brgyName, idx + 1),
                arpNo: arpCombined,
                sectionNo: '001',
                pin: arpCombined,
                lotNumber: `Lot ${idx + 1}-${letter}`,
                kind: effKind,
                classification: "Residential",
                areaSqMeters: 100,
                unitValue: 1500,
                marketValue: 150000,
                assessmentLevelPercent: 20,
                assessedValue: 30000,
                newOwnerName: newOwner || "",
                districtOrBarangay: brgyName
            });

            renderPartitionsTable();
        }

        function updatePartitionsFootTotals() {
            let totalArea = 0;
            let totalMV = 0;
            let totalAV = 0;

            generatedPartitions.forEach(p => {
                totalArea += parseFloat(p.areaSqMeters) || 0;
                totalMV += parseFloat(p.marketValue) || 0;
                totalAV += parseFloat(p.assessedValue) || 0;
            });

            const footSummary = document.getElementById('footPartitionSummary');
            if (footSummary) {
                footSummary.textContent = `Total Partitions: ${generatedPartitions.length} lot(s)`;
            }

            const footArea = document.getElementById('footTotalArea');
            const footMV = document.getElementById('footTotalMarketValue');
            const footAV = document.getElementById('footTotalAssessedValue');

            if (footArea) footArea.textContent = totalArea.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            if (footMV) footMV.textContent = `₱${totalMV.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            if (footAV) footAV.textContent = `₱${totalAV.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function serializePartitions() {
            const json = JSON.stringify(generatedPartitions);
            const input = document.getElementById('GeneratedPartitionsJson');
            if (input) input.value = json;

            const partInput = document.querySelector('input[name="Partitions"]');
            if (partInput) {
                partInput.value = generatedPartitions.length > 0 ? generatedPartitions.length : 1;
            }
        }

        // -------------------------------------------------------------
        // Dedicated Full-Page Partition Appraisal Redirect (CAST Style)
        // -------------------------------------------------------------
        function editPartitionRedirect(idx) {
            const reqId = '@Model.Id';
            const p = generatedPartitions[idx];
            const kindParam = p && p.kind ? `&kind=${encodeURIComponent(p.kind)}` : '';
            const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/PropertyAssessmentRequest/EditPartition?requestId=${reqId}&index=${idx}${kindParam}&returnUrl=${returnUrl}`;
        }

        // -------------------------------------------------------------
        // Edit Partition Handler: For Land, Building, and Machinery kinds, redirect directly to
        // the dedicated CAST Appraisal Form (Building has Structural Type, BUCC
        // breakdown, and 17 Materials; Land has Cadastral, Boundaries, and 4
        // dynamic Appraisal & Assessment schedules; Machinery has 16-column Machinery
        // Appraisal & Property Assessment roll matching CAST).
        // -------------------------------------------------------------
        function handleEditPartition(idx) {
            const p = generatedPartitions[idx];
            const kind = (p && p.kind ? p.kind : '').toLowerCase();
            if (kind === 'building' || kind === 'land' || kind === 'machinery') {
                editPartitionRedirect(idx);
            } else {
                openEditPartitionModal(idx);
            }
        }

        // -------------------------------------------------------------
        // Edit Partition Modal Functions (Quick Modal for Land / Machinery)
        // -------------------------------------------------------------
        function openEditPartitionModal(idx) {
            const p = generatedPartitions[idx];
            if (!p) return;

            document.getElementById('modalPartitionIdx').value = idx;
            document.getElementById('modalPartitionTitle').textContent = `Edit Partition Record: Partition ${p.partitionIndex || alphabetLetters[idx % alphabetLetters.length]}`;
            document.getElementById('modalTDN').value = p.systemGeneratedTDN || '';
            document.getElementById('modalPIN').value = p.pin || '';
            document.getElementById('modalLotNo').value = p.lotNumber || '';
            document.getElementById('modalKind').value = p.kind || 'Land';
            document.getElementById('modalClassification').value = p.classification || 'Residential';
            if (document.getElementById('modalLocation')) {
                document.getElementById('modalLocation').value = p.propertyLocation || p.location || p.districtOrBarangay || '';
            }
            document.getElementById('modalBarangay').value = p.districtOrBarangay || '';
            document.getElementById('modalArea').value = p.areaSqMeters || 0;
            document.getElementById('modalUnitValue').value = p.unitValue || 0;
            document.getElementById('modalAssessLevel').value = p.assessmentLevelPercent || 20;
            document.getElementById('modalOwner').value = p.newOwnerName || '';

            // Toggle building form alert if kind is building
            const isBldg = (p.kind || '').toLowerCase() === 'building';
            const bldgAlert = document.getElementById('modalBuildingAlert');
            if (bldgAlert) {
                if (isBldg) bldgAlert.classList.remove('hidden');
                else bldgAlert.classList.add('hidden');
            }

            recomputeModalValuation();

            const modal = document.getElementById('editPartitionModal');
            if (modal) modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function closeEditPartitionModal() {
            const modal = document.getElementById('editPartitionModal');
            if (modal) modal.classList.add('hidden');
        }

        function reRollModalTDN() {
            const idx = parseInt(document.getElementById('modalPartitionIdx').value) || 0;
            const letter = generatedPartitions[idx] ? (generatedPartitions[idx].partitionIndex || alphabetLetters[idx % alphabetLetters.length]) : 'A';
            const brgy = document.getElementById('modalBarangay') ? document.getElementById('modalBarangay').value : (generatedPartitions[idx] ? generatedPartitions[idx].districtOrBarangay : '');
            document.getElementById('modalTDN').value = generateSystemTDN(letter, brgy, idx + 1);
        }

        function recomputeModalValuation() {
            const area = parseFloat(document.getElementById('modalArea').value) || 0;
            const unitVal = parseFloat(document.getElementById('modalUnitValue').value) || 0;
            const assessLvl = parseFloat(document.getElementById('modalAssessLevel').value) || 0;

            const mv = Math.round((area * unitVal) * 100) / 100;
            const av = Math.round((mv * (assessLvl / 100)) * 100) / 100;

            document.getElementById('modalMarketValueLbl').textContent = `₱${mv.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            document.getElementById('modalAssessedValueLbl').textContent = `₱${av.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function saveEditPartitionModal() {
            const idx = parseInt(document.getElementById('modalPartitionIdx').value);
            if (isNaN(idx) || !generatedPartitions[idx]) return;

            const area = parseFloat(document.getElementById('modalArea').value) || 0;
            const unitVal = parseFloat(document.getElementById('modalUnitValue').value) || 0;
            const assessLvl = parseFloat(document.getElementById('modalAssessLevel').value) || 0;
            const mv = Math.round((area * unitVal) * 100) / 100;
            const av = Math.round((mv * (assessLvl / 100)) * 100) / 100;

            generatedPartitions[idx].systemGeneratedTDN = document.getElementById('modalTDN').value.trim();
            generatedPartitions[idx].pin = document.getElementById('modalPIN').value.trim();
            generatedPartitions[idx].lotNumber = document.getElementById('modalLotNo').value.trim();
            generatedPartitions[idx].kind = document.getElementById('modalKind').value;
            generatedPartitions[idx].classification = document.getElementById('modalClassification').value.trim();
            if (document.getElementById('modalLocation')) {
                generatedPartitions[idx].propertyLocation = document.getElementById('modalLocation').value.trim();
                generatedPartitions[idx].customLocation = true;
            }
            generatedPartitions[idx].districtOrBarangay = document.getElementById('modalBarangay').value.trim();
            generatedPartitions[idx].arpNo = formatCastArpNumber(
                generatedPartitions[idx].districtOrBarangay,
                generatedPartitions[idx].sectionNo || '001',
                generatedPartitions[idx].parcelNo || generatedPartitions[idx].lotNumber || `${idx + 1}`
            );
            generatedPartitions[idx].areaSqMeters = area;
            generatedPartitions[idx].unitValue = unitVal;
            generatedPartitions[idx].assessmentLevelPercent = assessLvl;
            generatedPartitions[idx].marketValue = mv;
            generatedPartitions[idx].assessedValue = av;
            generatedPartitions[idx].newOwnerName = document.getElementById('modalOwner').value.trim();

            closeEditPartitionModal();
            renderPartitionsTable();
            toastr.success(`Partition updated successfully!`);
        }

        // Form validation on submit & O.R. Number validation before forwarding beyond Receiving
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('propertyAssessmentEditForm') || document.querySelector('form');
            const selectStatus = document.getElementById('selectEditStatus');
            const inputOr = document.getElementById('inputEditORNumber');
            const txSelect = document.getElementById('txCodeSelect');

            function updateWorkflowBanners() {
                const val = txSelect ? txSelect.value : '';
                const sdBanner = document.getElementById('sdWorkflowBanner');
                const csBanner = document.getElementById('csWorkflowBanner');
                const dcBanner = document.getElementById('dcWorkflowBanner');
                if (sdBanner) {
                    if (val === 'SD') {
                        sdBanner.classList.remove('hidden');
                    } else {
                        sdBanner.classList.add('hidden');
                    }
                }
                if (csBanner) {
                    if (val === 'CS') {
                        csBanner.classList.remove('hidden');
                    } else {
                        csBanner.classList.add('hidden');
                    }
                }
                if (dcBanner) {
                    if (val === 'DC') {
                        dcBanner.classList.remove('hidden');
                    } else {
                        dcBanner.classList.add('hidden');
                    }
                }
            }

            if (txSelect) {
                txSelect.addEventListener('change', updateWorkflowBanners);
                updateWorkflowBanners();
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    serializePartitions();
                    var isValid = true;
                    var firstInvalid = null;

                    document.querySelectorAll('.border-rose-500').forEach(function(el) {
                        el.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                    });
                    document.querySelectorAll('.js-field-error').forEach(function(el) {
                        el.textContent = '';
                    });

                    function markInvalid(element, spanId, message) {
                        isValid = false;
                        if (element) {
                            element.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/30');
                        }
                        if (spanId) {
                            var span = document.getElementById(spanId);
                            if (span) span.textContent = message;
                        }
                        if (!firstInvalid && element) {
                            firstInvalid = element;
                        }
                    }

                    const personNameRegex = /^[\p{L}\s.,'\-]+$/u;
                    const phoneRegex = /^(\+63|0)?\d{7,10}$/;
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;

                    // 1. Validate Subdivision (SD) · Segregation of Land Partition Count
                    const currentTxCode = (txSelect ? txSelect.value : '').trim().toUpperCase();
                    if (currentTxCode === 'SD') {
                        const partCount = generatedPartitions.length > 0 ? generatedPartitions.length : (parseInt(document.getElementById('Partitions')?.value, 10) || 1);
                        if (partCount < 2) {
                            markInvalid(document.getElementById('btnAddManualPartitionRow'), 'partitionsValidation',
                                'Subdivision (SD) · Segregation of Land requires at least 2 segregated lot partitions. Please add at least 2 partition lots.');
                        }
                    }

                    // 2. Validate New Owner Name
                    var ownerEl = document.getElementById('newOwnerNameInput');
                    var ownerVal = ownerEl ? ownerEl.value.trim() : '';
                    if (!ownerVal) {
                        markInvalid(ownerEl, 'newOwnerNameValidation', 'New Owner / Declarant Name is required.');
                    } else if (ownerVal.replace(/\//g, '').toUpperCase() === 'NA') {
                        markInvalid(ownerEl, 'newOwnerNameValidation', 'New Owner / Declarant Name is required (N/A is not accepted).');
                    } else if (ownerVal.length > 150) {
                        markInvalid(ownerEl, 'newOwnerNameValidation', 'New Owner Name must not exceed 150 characters.');
                    } else if (!personNameRegex.test(ownerVal)) {
                        markInvalid(ownerEl, 'newOwnerNameValidation', 'New Owner Name contains invalid characters.');
                    }

                    // 3. Validate Owner Address
                    var addrEl = document.getElementById('ownerAddressInput');
                    var addrVal = addrEl ? addrEl.value.trim() : '';
                    if (!addrVal) {
                        markInvalid(addrEl, 'ownerAddressValidation', 'Owner Address is required.');
                    } else if (addrVal.length > 250) {
                        markInvalid(addrEl, 'ownerAddressValidation', 'Owner Address must not exceed 250 characters.');
                    }

                    // 4. Validate Property Location
                    var locEl = document.getElementById('locationInput');
                    var locVal = locEl ? locEl.value.trim() : '';
                    if (!locVal) {
                        markInvalid(locEl, 'propertyLocationValidation', 'Property Location is required.');
                    } else if (locVal.length > 250) {
                        markInvalid(locEl, 'propertyLocationValidation', 'Property Location must not exceed 250 characters.');
                    }

                    // 5. Optional Format Checks
                    var tinEl = document.getElementById('ownerTinInput');
                    if (tinEl && tinEl.value.trim().length > 30) {
                        markInvalid(tinEl, 'ownerTinValidation', 'Owner TIN must not exceed 30 characters.');
                    }

                    var phoneEl = document.getElementById('contactNoInput');
                    if (phoneEl && phoneEl.value.trim()) {
                        var phoneVal = phoneEl.value.trim();
                        if (phoneVal.length > 20) {
                            markInvalid(phoneEl, 'contactNoValidation', 'Contact Number must not exceed 20 characters.');
                        } else if (!phoneRegex.test(phoneVal)) {
                            markInvalid(phoneEl, 'contactNoValidation', 'Contact number must be 7-11 digits.');
                        }
                    }

                    var emailEl = document.getElementById('emailAddressInput');
                    if (emailEl && emailEl.value.trim()) {
                        var emailVal = emailEl.value.trim();
                        if (emailVal.length > 100) {
                            markInvalid(emailEl, 'emailAddressValidation', 'Email Address must not exceed 100 characters.');
                        } else if (!emailRegex.test(emailVal)) {
                            markInvalid(emailEl, 'emailAddressValidation', 'Please enter a valid email address.');
                        }
                    }

                    var lotNoEl = document.getElementById('lotNoInput');
                    if (lotNoEl && lotNoEl.value.trim().length > 100) {
                        markInvalid(lotNoEl, 'lotNoValidation', 'Lot / Survey No. must not exceed 100 characters.');
                    }

                    var reqEl = document.getElementById('requestorInput');
                    if (reqEl && reqEl.value.trim()) {
                        var reqVal = reqEl.value.trim();
                        if (reqVal.length > 150) {
                            markInvalid(reqEl, 'requestorValidation', 'Requestor name must not exceed 150 characters.');
                        } else if (!personNameRegex.test(reqVal)) {
                            markInvalid(reqEl, 'requestorValidation', 'Requestor name contains invalid characters.');
                        }
                    }

                    // 6. Check O.R. Number if forwarded beyond Receiving
                    if (selectStatus && inputOr) {
                        const statusVal = selectStatus.value;
                        const orVal = inputOr.value.trim();
                        if (statusVal !== 'Pending' && statusVal !== 'Receiving' && statusVal !== 'Deferred' && !orVal) {
                            markInvalid(inputOr, null, 'An Official Receipt (O.R.) Number is required before forwarding this request.');
                            if (typeof toastr !== 'undefined') {
                                toastr.warning('An Official Receipt (O.R.) Number is required before forwarding this request to ' + statusVal + '.', 'O.R. Number Required');
                            }
                        }
                    }

                    if (!isValid) {
                        e.preventDefault();
                        if (window.RptSpinner) window.RptSpinner.hide();
                        var submitBtns = form.querySelectorAll('.btn-is-processing, button[type="submit"]');
                        submitBtns.forEach(function (btn) {
                            btn.classList.remove('btn-is-processing');
                            if (btn.dataset.originalHtml) btn.innerHTML = btn.dataset.originalHtml;
                        });
                        if (typeof toastr !== 'undefined') {
                            toastr.warning('Please review and complete all required fields highlighted in red.', 'Required Fields Missing');
                        }
                        if (firstInvalid) {
                            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            if (typeof firstInvalid.focus === 'function') firstInvalid.focus();
                        }
                        return false;
                    }
                });

                if (inputOr) {
                    inputOr.addEventListener('input', function () {
                        if (this.value.trim().length > 0) {
                            this.classList.remove('border-rose-500', 'border-amber-500', 'ring-2');
                        }
                    });
                }
            }
        });
    </script>
}
