@model PropertyAssessmentApp.Models.PropertyAssessmentRequest
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = $"Edit RPA - {Model.TrackingNumber}";
    var properties = ViewBag.Properties as IEnumerable<TaxDeclaration> ?? new List<TaxDeclaration>();
    var orderPayments = ViewBag.OrderPayments as IEnumerable<OrderPayment> ?? new List<OrderPayment>();
    var registeredOwners = ViewBag.RegisteredOwners as IEnumerable<Owner> ?? new List<Owner>();
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="edit" class="w-4 h-4"></i>
                <span>Edit Assessment Request</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Update Request @Model.TrackingNumber</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Update property appraisal parameters, new owner information, checklist items, or attached documents.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-8">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TrackingNumber" />
            <input type="hidden" asp-for="Partitions" id="Partitions" />
            <input type="hidden" asp-for="RefTaxDeclarationId" />
            <input type="hidden" asp-for="RequestedDocumentsJson" id="RequestedDocumentsJson" />
            <input type="hidden" asp-for="TotalFeesAmount" id="TotalFeesAmount" />
            <input type="hidden" asp-for="TransactionTypeName" id="txNameInput" />
            <input type="hidden" asp-for="GeneratedPartitionsJson" id="GeneratedPartitionsJson" />
            <input type="hidden" asp-for="SelectedRefPropertyIdsJson" id="SelectedRefPropertyIdsJson" />
            <div asp-validation-summary="ModelOnly" class="hidden"></div>

            <!-- Transaction & Partitioning -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="tag" class="w-4 h-4 text-emerald-600"></i>
                    1. Transaction Type & Partitions
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="TransactionTypeCode" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TRANSACTION CODE</label>
                        <select asp-for="TransactionTypeCode" id="txCodeSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600 cursor-pointer">
                            @if (!string.IsNullOrWhiteSpace(Model.TransactionTypeCode) && !PropertyAssessmentApp.Models.PropertyAssessmentRequest.StandardTransactionCodes.ContainsKey(Model.TransactionTypeCode.Trim().ToUpperInvariant()))
                            {
                                <option value="@Model.TransactionTypeCode" selected>@Model.TransactionTypeCode - @Model.TransactionTypeName</option>
                            }
                            <option value="SD" data-name="Subdivision">Subdivision - SD</option>
                            <option value="CS" data-name="Consolidation">Consolidation - CS</option>
                            <option value="DC" data-name="Discovery/New Declaration">Discovery/New Declaration - DC</option>
                            <option value="PC" data-name="Reassessment Due to Physical Change">Reassessment Due to Physical Change - PC</option>
                            <option value="RA" data-name="Reassessment">Reassessment - RA</option>
                            <option value="DT" data-name="Reassessment Due to partial Destruction of the property">Reassessment Due to partial Destruction of the property - DT</option>
                            <option value="TR" data-name="Transfer">Transfer - TR</option>
                            <option value="RC" data-name="Reclassification">Reclassification - RC</option>
                            <option value="GR" data-name="General Revision">General Revision - GR</option>
                            <option value="SP" data-name="Special Project">Special Project - SP</option>
                            <option value="DEP" data-name="Reassessment Due to depreciation">Reassessment Due to depreciation - DEP</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="Kind" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY KIND</label>
                        <select asp-for="Kind" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold">
                            <option value="Land">Land</option>
                            <option value="Building">Building</option>
                            <option value="Machinery">Machinery</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="LotNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT / SURVEY NO.</label>
                        <input asp-for="LotNo" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                    </div>
                </div>
            </div>

            <!-- Previous Property -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="history" class="w-4 h-4 text-emerald-600"></i>
                    2. Previous Property Information
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="PrevTDN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS TDN</label>
                        <input asp-for="PrevTDN" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                    </div>
                    <div>
                        <label asp-for="PrevPIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS PIN</label>
                        <input asp-for="PrevPIN" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                    </div>
                    <div>
                        <label asp-for="PrevOwner" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS OWNER</label>
                        <input asp-for="PrevOwner" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                </div>

                <div>
                    <label asp-for="PropertyLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOCATION ADDRESS</label>
                    <input asp-for="PropertyLocation" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                </div>
            </div>

            <!-- Generated Partition/s (Editable) -->
            <div id="generatedPartitionsContainer" class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="layers" class="w-4 h-4 text-emerald-600"></i>
                        Generated Partition/s
                    </h3>
                    <button type="button" id="btnAddManualPartitionRow" class="px-3 py-1.5 rounded-lg bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-emerald-700 dark:text-emerald-400 font-bold text-[11px] border border-slate-200 dark:border-stone-800 flex items-center gap-1 shadow-xs">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        Add Another Lot
                    </button>
                </div>

                <div class="border border-slate-200 dark:border-stone-800 rounded-2xl overflow-x-auto bg-white dark:bg-stone-900 shadow-sm">
                    <table class="w-full text-left text-xs font-mono">
                        <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 font-bold uppercase text-[10px]">
                            <tr>
                                <th class="px-4 py-3">TDN</th>
                                <th class="px-4 py-3">Kind</th>
                                <th class="px-4 py-3">Owner</th>
                                <th class="px-4 py-3">Property Location</th>
                                <th class="px-4 py-3 text-center w-24">Action</th>
                            </tr>
                        </thead>
                        <tbody id="generatedPartitionsTbody" class="divide-y divide-slate-100 dark:divide-stone-800/60 font-sans">
                            <!-- Populated by JS -->
                        </tbody>
                        <tfoot class="bg-slate-50 dark:bg-stone-950/80 font-bold text-slate-900 dark:text-white border-t border-slate-200 dark:border-stone-800">
                            <tr>
                                <td colspan="5" class="px-4 py-2.5 text-xs text-slate-500">
                                    <div class="flex items-center justify-between">
                                        <span id="footPartitionSummary" class="font-bold text-slate-800 dark:text-stone-200">Total Partitions: 0 lot(s)</span>
                                        <span class="text-slate-400 text-[10px]">Click pencil icon to configure detailed appraisal specifications</span>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- New Owner Details -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="user-plus" class="w-4 h-4 text-emerald-600"></i>
                        3. New Owner / Declarant
                    </h3>
                    <span class="text-[11px] text-slate-500 dark:text-stone-400">
                        Select an existing registered owner or update declarant details
                    </span>
                </div>

                <!-- Searchable Registered Owner Dropdown (Auto-fill) -->
                <div class="p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 space-y-2">
                    <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase flex items-center gap-2">
                        <i data-lucide="user-search" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        Fetch Registered Owner from Database (Auto-fill)
                    </label>
                    <select id="registeredOwnerSelect" class="w-full">
                        <option value="">-- Search registered owner by Name, TIN, or RPTIN (Optional) --</option>
                        @foreach (var owner in registeredOwners)
                        {
                            <option value="@owner.Id">@owner.DisplayName (TIN: @owner.TaxIdentNo | @owner.BarangayName)</option>
                        }
                    </select>
                    <p class="text-[10px] text-slate-500 dark:text-stone-400">
                        Selecting a registered owner will automatically fill in Owner Name, TIN, Contact Number, and Address below.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="NewOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">NEW OWNER NAME *</label>
                        <input asp-for="NewOwnerName" id="newOwnerNameInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" required />
                    </div>
                    <div>
                        <label asp-for="OwnerTIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER TIN</label>
                        <input asp-for="OwnerTIN" id="ownerTinInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                    </div>
                    <div>
                        <label asp-for="ContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONTACT NO.</label>
                        <input asp-for="ContactNo" id="contactNoInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Address" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ADDRESS</label>
                        <input asp-for="Address" id="ownerAddressInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                    <div>
                        <label asp-for="Requestor" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REQUESTOR</label>
                        <input asp-for="Requestor" id="requestorInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                </div>
            </div>

            <!-- Documents Checklist -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                    4. Documents Submitted Checklist
                </h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocTitleTctCloa" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Title (OCT/TCT/CLOA)</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocDeedOfSaleConveyance" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Deed of Sale / Conveyance</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocCarBir" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">BIR CAR Certificate</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocTaxClearance" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Real Property Tax Clearance</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocApprovedSurveyPlan" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Approved Survey Plan</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocBuildingPermit" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Building Permit</span>
                    </label>
                </div>
            </div>

            <!-- Workflow Status & Attachment -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="git-branch" class="w-4 h-4 text-emerald-600"></i>
                    5. Workflow Status & Attachment
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Status" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">STATUS</label>
                        <select asp-for="Status" id="selectEditStatus" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold">
                            @foreach (PropertyAssessmentStatus s in Enum.GetValues(typeof(PropertyAssessmentStatus)))
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REPLACE ATTACHMENT (LEAVE EMPTY TO KEEP EXISTING)</label>
                        <input type="file" name="fileUpload" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-mono file:font-bold file:bg-emerald-600 file:text-white" />
                        @if (!string.IsNullOrEmpty(Model.AttachmentFileName))
                        {
                            <span class="text-[11px] text-emerald-600 font-bold mt-1 block">Current file: @Model.AttachmentFileName</span>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ORNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">O.R. NUMBER</label>
                        <input asp-for="ORNumber" id="inputEditORNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="OR-2026-XXXX" />
                        <p class="text-[10px] text-slate-400 mt-1">Required before forwarding to GIS Replotting / Mapping or subsequent stages.</p>
                    </div>
                    <div>
                        <label asp-for="AssignedAppraiser" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ASSIGNED APPRAISER</label>
                        <input asp-for="AssignedAppraiser" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                </div>

                <div>
                    <label asp-for="Remarks" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REMARKS</label>
                    <textarea asp-for="Remarks" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white"></textarea>
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <a asp-action="Details" asp-route-id="@Model.Id" class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-all">
                    Cancel
                </a>
                <button type="submit" class="w-full sm:w-auto text-center px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT PARTITION MODAL -->
<div id="editPartitionModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-2xl bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-2xl p-6 sm:p-8 space-y-6 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center font-bold">
                    <i data-lucide="pencil" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900 dark:text-white" id="modalPartitionTitle">Edit Partition Record</h3>
                    <p class="text-xs text-slate-500 dark:text-stone-400">Modify valuation, lot parameters, classification, or declarant</p>
                </div>
            </div>
            <button type="button" onclick="closeEditPartitionModal()" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-stone-200 rounded-xl hover:bg-slate-100 dark:hover:bg-stone-800 transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <input type="hidden" id="modalPartitionIdx" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SYSTEM-GENERATED TDN</label>
                <div class="flex items-center gap-1.5">
                    <input type="text" id="modalTDN" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
                    <button type="button" onclick="reRollModalTDN()" class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300" title="Re-roll TDN">
                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY IDENTIFICATION NO. (PIN)</label>
                <input type="text" id="modalPIN" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT / SURVEY NO.</label>
                <input type="text" id="modalLotNo" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-semibold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" placeholder="e.g. Lot 15-A, Psd-..." />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY KIND</label>
                <select id="modalKind" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600">
                    <option value="Land">Land</option>
                    <option value="Building">Building</option>
                    <option value="Machinery">Machinery</option>
                </select>
            </div>

            <!-- Building Form Prompt Alert (Appears when Building Kind is selected) -->
            <div id="modalBuildingAlert" class="hidden sm:col-span-2 p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                        <i data-lucide="building" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-emerald-900 dark:text-emerald-200 block">Building Appraisal Form</span>
                        <span class="text-[11px] text-slate-500 dark:text-stone-400 block font-sans">Includes Structural Type (BUCC Class), 17 Materials checklist, and Floor breakdown.</span>
                    </div>
                </div>
                <button type="button" onclick="editPartitionRedirect(parseInt(document.getElementById('modalPartitionIdx').value))" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shrink-0 flex items-center gap-1.5 shadow-sm">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Open Building Form
                </button>
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CLASSIFICATION</label>
                <input type="text" id="modalClassification" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" placeholder="Residential, Commercial..." />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY LOCATION</label>
                <input type="text" id="modalLocation" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-semibold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" placeholder="e.g. Pioneer Ave., General Santos City" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BARANGAY / DISTRICT</label>
                <input type="text" id="modalBarangay" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-semibold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" placeholder="e.g. Brgy. Lagao" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">AREA (SQ.M.)</label>
                <input type="number" step="0.01" id="modalArea" oninput="recomputeModalValuation()" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">UNIT VALUE (₱ / SQ.M.)</label>
                <input type="number" step="0.01" id="modalUnitValue" oninput="recomputeModalValuation()" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ASSESSMENT LEVEL (%)</label>
                <input type="number" step="1" min="1" max="100" id="modalAssessLevel" oninput="recomputeModalValuation()" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">NEW DECLARANT / OWNER</label>
                <input type="text" id="modalOwner" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div class="p-3 rounded-2xl bg-slate-100 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <span class="block text-[10px] text-slate-400 uppercase font-bold">Computed Market Value (FMV)</span>
                <span id="modalMarketValueLbl" class="text-sm font-black text-slate-900 dark:text-white font-mono">₱0.00</span>
            </div>

            <div class="p-3 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800">
                <span class="block text-[10px] text-emerald-700 dark:text-emerald-400 uppercase font-bold">Computed Assessed Value (AV)</span>
                <span id="modalAssessedValueLbl" class="text-sm font-black text-emerald-700 dark:text-emerald-400 font-mono">₱0.00</span>
            </div>
        </div>

        <div class="flex items-center justify-between gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
            <a href="javascript:void(0)" onclick="editPartitionRedirect(parseInt(document.getElementById('modalPartitionIdx').value))" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 underline flex items-center gap-1" title="Open comprehensive CAST appraisal with building materials, sketches, and full specs">
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                Full CAST Appraisal Page
            </a>
            <div class="flex items-center gap-2">
                <button type="button" onclick="closeEditPartitionModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold text-xs transition-colors">
                    Cancel
                </button>
                <button type="button" onclick="saveEditPartitionModal()" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md shadow-emerald-600/20 transition-all flex items-center gap-1.5">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let generatedPartitions = [];
        const alphabetLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

        document.addEventListener('DOMContentLoaded', function () {
            const txSelect = document.getElementById('txCodeSelect');
            if (txSelect) {
                txSelect.addEventListener('change', function () {
                    const opt = this.options[this.selectedIndex];
                    const input = document.getElementById('txNameInput');
                    if (input && opt) {
                        input.value = opt.getAttribute('data-name') || opt.text;
                    }
                });
            }

            const modalKindSelect = document.getElementById('modalKind');
            if (modalKindSelect) {
                modalKindSelect.addEventListener('change', function() {
                    const bldgAlert = document.getElementById('modalBuildingAlert');
                    if (bldgAlert) {
                        if (this.value.toLowerCase() === 'building') {
                            bldgAlert.classList.remove('hidden');
                        } else {
                            bldgAlert.classList.add('hidden');
                        }
                    }
                });
            }

            // Searchable Registered Owner TomSelect (Auto-fill with Server-Side Remote Search for Thousands of Active Taxpayers)
            if (document.getElementById('registeredOwnerSelect')) {
                new TomSelect('#registeredOwnerSelect', {
                    create: false,
                    valueField: 'id',
                    labelField: 'display',
                    searchField: ['name', 'tin', 'text', 'display'],
                    loadThrottle: 300,
                    placeholder: 'Search active registered owner by name, TIN, or RPTIN...',
                    load: function(query, callback) {
                        if (!query || !query.trim().length) return callback();
                        fetch(`/PropertyAssessmentRequest/SearchRegisteredOwners?term=${encodeURIComponent(query)}`)
                            .then(res => res.json())
                            .then(data => callback(Array.isArray(data) ? data : []))
                            .catch(() => callback());
                    },
                    render: {
                        option: function(item, escape) {
                            if (item.name) {
                                return `<div class="py-1">
                                    <span class="font-bold text-slate-900 dark:text-white">${escape(item.name)}</span>
                                    <span class="text-[11px] text-slate-500 dark:text-stone-400"> (TIN: ${escape(item.tin || 'N/A')} | ${escape(item.barangay || 'N/A')})</span>
                                </div>`;
                            }
                            return `<div class="py-1">${escape(item.text || item.display || '')}</div>`;
                        },
                        item: function(item, escape) {
                            if (item.name) {
                                return `<div>${escape(item.name)} (TIN: ${escape(item.tin || 'N/A')})</div>`;
                            }
                            return `<div>${escape(item.text || item.display || '')}</div>`;
                        }
                    },
                    onChange: function (ownerId) {
                        if (!ownerId) return;
                        fetch(`/PropertyAssessmentRequest/GetOwnerDetails?id=${encodeURIComponent(ownerId)}`)
                            .then(res => res.json())
                            .then(data => {
                                if (data) {
                                    const nameInput = document.getElementById('newOwnerNameInput');
                                    const tinInput = document.getElementById('ownerTinInput');
                                    const phoneInput = document.getElementById('contactNoInput');
                                    const addressInput = document.getElementById('ownerAddressInput');

                                    if (nameInput) nameInput.value = data.name || '';
                                    if (tinInput) tinInput.value = data.tin || '';
                                    if (phoneInput) phoneInput.value = data.phone || '';
                                    if (addressInput) addressInput.value = data.address || data.street || '';

                                    if (typeof toastr !== 'undefined') {
                                        toastr.success(`Owner details auto-filled for ${data.name}!`, 'Registered Owner Loaded');
                                    }
                                }
                            })
                            .catch(err => console.error('Error fetching owner details:', err));
                    }
                });
            }

            // Load existing partitions
            try {
                const rawJson = document.getElementById('GeneratedPartitionsJson').value;
                if (rawJson) {
                    generatedPartitions = JSON.parse(rawJson);
                }
            } catch (e) {
                generatedPartitions = [];
            }

            renderPartitionsTable();

            const btnAddLot = document.getElementById('btnAddManualPartitionRow');
            if (btnAddLot) {
                btnAddLot.addEventListener('click', handleAddManualPartitionLot);
            }
        });

        function renderPartitionsTable() {
            const container = document.getElementById('generatedPartitionsContainer');
            const tbody = document.getElementById('generatedPartitionsTbody');

            if (!container || !tbody) return;

            let rowsHtml = '';
            if (generatedPartitions.length === 0) {
                rowsHtml = `
                    <tr>
                        <td colspan="11" class="text-center py-6 text-slate-400 dark:text-stone-500">
                            No partition records configured yet. Click "+ Add Another Lot" above to create one.
                        </td>
                    </tr>
                `;
            } else {
                generatedPartitions.forEach((p, idx) => {
                    const hasSketch = !!(p.buildingFloorPlanSketchPath || p.buildingFloorPlanSketchBase64);
                    const sketchBadge = hasSketch 
                        ? `<div class="mt-1"><a href="${p.buildingFloorPlanSketchPath || '#'}" target="_blank" class="inline-flex items-center gap-1 text-[9px] font-mono text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 px-1 py-0.5 rounded font-bold hover:underline" title="View attached floor plan sketch / blueprint"><i data-lucide="file-check" class="w-3 h-3 text-emerald-600"></i> Sketch</a></div>` 
                        : '';

                    const locText = p.propertyLocation || p.location || [p.streetLocation, p.districtOrBarangay, p.cityMunicipality, p.province].filter(Boolean).join(', ') || 'N/A';

                    rowsHtml += `
                        <tr class="hover:bg-slate-50 dark:hover:bg-stone-800/40 transition-colors" data-partition-idx="${idx}">
                            <td class="px-4 py-3 align-middle">
                                <div class="flex items-center gap-2">
                                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-bold font-mono text-xs shrink-0" title="Partition Lot ${p.partitionIndex || alphabetLetters[idx % alphabetLetters.length]}">
                                        ${p.partitionIndex || alphabetLetters[idx % alphabetLetters.length]}
                                    </span>
                                    <div>
                                        <span class="font-bold font-mono text-slate-900 dark:text-white text-xs block">
                                            ${p.systemGeneratedTDN || 'TDN-PENDING'}
                                        </span>
                                        ${p.pin ? `<span class="text-[10px] text-slate-500 dark:text-stone-400 font-mono block">PIN: ${p.pin}</span>` : ''}
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3 align-middle">
                                <span class="inline-block px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60 font-mono">
                                    ${p.kind || 'Land'}
                                </span>
                                ${p.classification ? `<span class="block text-[10px] text-slate-500 dark:text-stone-400 font-sans mt-0.5">${p.classification}</span>` : ''}
                            </td>
                            <td class="px-4 py-3 align-middle">
                                <span class="font-medium text-slate-900 dark:text-white text-xs block">
                                    ${p.newOwnerName || 'N/A'}
                                </span>
                            </td>
                            <td class="px-4 py-3 align-middle">
                                <span class="text-slate-600 dark:text-stone-300 text-xs block font-sans">
                                    ${locText}
                                </span>
                            </td>
                            <td class="px-4 py-3 align-middle text-center">
                                <div class="flex items-center justify-center gap-1.5">
                                    <button type="button" onclick="handleEditPartition(${idx})" class="p-1.5 text-emerald-600 hover:text-emerald-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 rounded-lg transition-colors" title="${p.kind === 'Building' ? 'Edit Building Appraisal (Structural Type & Materials)' : (p.kind === 'Land' ? 'Edit Land Appraisal (CAST TDN Specification)' : 'Edit Partition Details')}">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </button>
                                    <button type="button" onclick="removePartition(${idx})" class="p-1.5 text-rose-500 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition-colors" title="Delete partition row">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                                ${sketchBadge}
                            </td>
                        </tr>
                    `;
                });
            }

            tbody.innerHTML = rowsHtml;
            updatePartitionsFootTotals();
            serializePartitions();
            lucide.createIcons();
        }

        function updatePartitionField(idx, field, val) {
            if (generatedPartitions[idx]) {
                generatedPartitions[idx][field] = val;
                serializePartitions();
            }
        }

        function updatePartitionOwner(idx, val) {
            if (generatedPartitions[idx]) {
                generatedPartitions[idx].newOwnerName = val;
                serializePartitions();
            }
        }

        function updatePartitionArea(idx, val) {
            if (generatedPartitions[idx]) {
                const area = parseFloat(val) || 0;
                generatedPartitions[idx].areaSqMeters = area;
                recalculateRowValuation(idx);
            }
        }

        function updatePartitionUnitValue(idx, val) {
            if (generatedPartitions[idx]) {
                const unitVal = parseFloat(val) || 0;
                generatedPartitions[idx].unitValue = unitVal;
                recalculateRowValuation(idx);
            }
        }

        function updatePartitionAssessLevel(idx, val) {
            if (generatedPartitions[idx]) {
                const lvl = parseFloat(val) || 0;
                generatedPartitions[idx].assessmentLevelPercent = lvl;
                recalculateRowValuation(idx);
            }
        }

        function recalculateRowValuation(idx) {
            const p = generatedPartitions[idx];
            if (!p) return;
            const mv = Math.round((p.areaSqMeters * p.unitValue) * 100) / 100;
            const av = Math.round((mv * (p.assessmentLevelPercent / 100)) * 100) / 100;
            p.marketValue = mv;
            p.assessedValue = av;

            const row = document.querySelector(`tr[data-partition-idx="${idx}"]`);
            if (row) {
                row.querySelector('.partition-marketval').textContent = `₱${mv.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                row.querySelector('.partition-assessedval').textContent = `₱${av.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            }

            updatePartitionsFootTotals();
            serializePartitions();
        }

        function regeneratePartitionTDN(idx) {
            if (generatedPartitions[idx]) {
                const year = new Date().getFullYear();
                const txCode = document.getElementById('txCodeSelect') ? document.getElementById('txCodeSelect').value : "SD";
                const rand4 = Math.floor(1000 + Math.random() * 9000);
                const letter = generatedPartitions[idx].partitionIndex || alphabetLetters[idx % alphabetLetters.length];
                generatedPartitions[idx].systemGeneratedTDN = `TD-${year}-${txCode}-${rand4}-${letter}`;
                renderPartitionsTable();
            }
        }

        function removePartition(idx) {
            generatedPartitions.splice(idx, 1);
            generatedPartitions.forEach((p, i) => {
                p.partitionIndex = alphabetLetters[i % alphabetLetters.length];
            });
            renderPartitionsTable();
        }

        function handleAddManualPartitionLot() {
            const idx = generatedPartitions.length;
            const letter = alphabetLetters[idx % alphabetLetters.length];
            const newOwner = (document.querySelector('input[name="NewOwnerName"]').value || '').trim();
            const year = new Date().getFullYear();
            const txCode = document.getElementById('txCodeSelect') ? document.getElementById('txCodeSelect').value : "SD";
            const rand4 = Math.floor(1000 + Math.random() * 9000);

            generatedPartitions.push({
                partitionIndex: letter,
                baseTDN: document.getElementById('PrevTDN') ? document.getElementById('PrevTDN').value : "Manual",
                basePropertyId: null,
                systemGeneratedTDN: `TD-${year}-${txCode}-${rand4}-${letter}`,
                pin: `126-00-0000-${letter}`,
                lotNumber: `Lot ${idx + 1}-${letter}`,
                kind: "Land",
                classification: "Residential",
                areaSqMeters: 100,
                unitValue: 1500,
                marketValue: 150000,
                assessmentLevelPercent: 20,
                assessedValue: 30000,
                newOwnerName: newOwner || "",
                districtOrBarangay: "Brgy. Central"
            });

            renderPartitionsTable();
        }

        function updatePartitionsFootTotals() {
            let totalArea = 0;
            let totalMV = 0;
            let totalAV = 0;

            generatedPartitions.forEach(p => {
                totalArea += parseFloat(p.areaSqMeters) || 0;
                totalMV += parseFloat(p.marketValue) || 0;
                totalAV += parseFloat(p.assessedValue) || 0;
            });

            const footSummary = document.getElementById('footPartitionSummary');
            if (footSummary) {
                footSummary.textContent = `Total Partitions: ${generatedPartitions.length} lot(s)`;
            }

            const footArea = document.getElementById('footTotalArea');
            const footMV = document.getElementById('footTotalMarketValue');
            const footAV = document.getElementById('footTotalAssessedValue');

            if (footArea) footArea.textContent = totalArea.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            if (footMV) footMV.textContent = `₱${totalMV.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            if (footAV) footAV.textContent = `₱${totalAV.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function serializePartitions() {
            const json = JSON.stringify(generatedPartitions);
            const input = document.getElementById('GeneratedPartitionsJson');
            if (input) input.value = json;

            const partInput = document.querySelector('input[name="Partitions"]');
            if (partInput) {
                partInput.value = generatedPartitions.length > 0 ? generatedPartitions.length : 1;
            }
        }

        // -------------------------------------------------------------
        // Dedicated Full-Page Partition Appraisal Redirect (CAST Style)
        // -------------------------------------------------------------
        function editPartitionRedirect(idx) {
            const reqId = '@Model.Id';
            const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/PropertyAssessmentRequest/EditPartition?requestId=${reqId}&index=${idx}&returnUrl=${returnUrl}`;
        }

        // -------------------------------------------------------------
        // Edit Partition Handler: For Land and Building kinds, redirect directly to
        // the dedicated CAST Appraisal Form (Building has Structural Type, BUCC
        // breakdown, and 17 Materials; Land has Cadastral, Boundaries, and 4
        // dynamic Appraisal & Assessment schedules matching CAST).
        // -------------------------------------------------------------
        function handleEditPartition(idx) {
            const p = generatedPartitions[idx];
            const kind = (p && p.kind ? p.kind : '').toLowerCase();
            if (kind === 'building' || kind === 'land') {
                editPartitionRedirect(idx);
            } else {
                openEditPartitionModal(idx);
            }
        }

        // -------------------------------------------------------------
        // Edit Partition Modal Functions (Quick Modal for Land / Machinery)
        // -------------------------------------------------------------
        function openEditPartitionModal(idx) {
            const p = generatedPartitions[idx];
            if (!p) return;

            document.getElementById('modalPartitionIdx').value = idx;
            document.getElementById('modalPartitionTitle').textContent = `Edit Partition Record: Partition ${p.partitionIndex || alphabetLetters[idx % alphabetLetters.length]}`;
            document.getElementById('modalTDN').value = p.systemGeneratedTDN || '';
            document.getElementById('modalPIN').value = p.pin || '';
            document.getElementById('modalLotNo').value = p.lotNumber || '';
            document.getElementById('modalKind').value = p.kind || 'Land';
            document.getElementById('modalClassification').value = p.classification || 'Residential';
            if (document.getElementById('modalLocation')) {
                document.getElementById('modalLocation').value = p.propertyLocation || p.location || p.districtOrBarangay || '';
            }
            document.getElementById('modalBarangay').value = p.districtOrBarangay || '';
            document.getElementById('modalArea').value = p.areaSqMeters || 0;
            document.getElementById('modalUnitValue').value = p.unitValue || 0;
            document.getElementById('modalAssessLevel').value = p.assessmentLevelPercent || 20;
            document.getElementById('modalOwner').value = p.newOwnerName || '';

            // Toggle building form alert if kind is building
            const isBldg = (p.kind || '').toLowerCase() === 'building';
            const bldgAlert = document.getElementById('modalBuildingAlert');
            if (bldgAlert) {
                if (isBldg) bldgAlert.classList.remove('hidden');
                else bldgAlert.classList.add('hidden');
            }

            recomputeModalValuation();

            const modal = document.getElementById('editPartitionModal');
            if (modal) modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function closeEditPartitionModal() {
            const modal = document.getElementById('editPartitionModal');
            if (modal) modal.classList.add('hidden');
        }

        function reRollModalTDN() {
            const idx = parseInt(document.getElementById('modalPartitionIdx').value) || 0;
            const letter = generatedPartitions[idx] ? (generatedPartitions[idx].partitionIndex || alphabetLetters[idx % alphabetLetters.length]) : 'A';
            const year = new Date().getFullYear();
            const txCode = document.getElementById('txCodeSelect') ? document.getElementById('txCodeSelect').value : "SD";
            const rand4 = Math.floor(1000 + Math.random() * 9000);
            document.getElementById('modalTDN').value = `TD-${year}-${txCode}-${rand4}-${letter}`;
        }

        function recomputeModalValuation() {
            const area = parseFloat(document.getElementById('modalArea').value) || 0;
            const unitVal = parseFloat(document.getElementById('modalUnitValue').value) || 0;
            const assessLvl = parseFloat(document.getElementById('modalAssessLevel').value) || 0;

            const mv = Math.round((area * unitVal) * 100) / 100;
            const av = Math.round((mv * (assessLvl / 100)) * 100) / 100;

            document.getElementById('modalMarketValueLbl').textContent = `₱${mv.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            document.getElementById('modalAssessedValueLbl').textContent = `₱${av.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function saveEditPartitionModal() {
            const idx = parseInt(document.getElementById('modalPartitionIdx').value);
            if (isNaN(idx) || !generatedPartitions[idx]) return;

            const area = parseFloat(document.getElementById('modalArea').value) || 0;
            const unitVal = parseFloat(document.getElementById('modalUnitValue').value) || 0;
            const assessLvl = parseFloat(document.getElementById('modalAssessLevel').value) || 0;
            const mv = Math.round((area * unitVal) * 100) / 100;
            const av = Math.round((mv * (assessLvl / 100)) * 100) / 100;

            generatedPartitions[idx].systemGeneratedTDN = document.getElementById('modalTDN').value.trim();
            generatedPartitions[idx].pin = document.getElementById('modalPIN').value.trim();
            generatedPartitions[idx].lotNumber = document.getElementById('modalLotNo').value.trim();
            generatedPartitions[idx].kind = document.getElementById('modalKind').value;
            generatedPartitions[idx].classification = document.getElementById('modalClassification').value.trim();
            if (document.getElementById('modalLocation')) {
                generatedPartitions[idx].propertyLocation = document.getElementById('modalLocation').value.trim();
                generatedPartitions[idx].customLocation = true;
            }
            generatedPartitions[idx].districtOrBarangay = document.getElementById('modalBarangay').value.trim();
            generatedPartitions[idx].areaSqMeters = area;
            generatedPartitions[idx].unitValue = unitVal;
            generatedPartitions[idx].assessmentLevelPercent = assessLvl;
            generatedPartitions[idx].marketValue = mv;
            generatedPartitions[idx].assessedValue = av;
            generatedPartitions[idx].newOwnerName = document.getElementById('modalOwner').value.trim();

            closeEditPartitionModal();
            renderPartitionsTable();
            toastr.success(`Partition updated successfully!`);
        }

        // Validate O.R. Number before forwarding beyond Receiving
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form[asp-action="Edit"]') || document.querySelector('form');
            const selectStatus = document.getElementById('selectEditStatus');
            const inputOr = document.getElementById('inputEditORNumber');

            if (form && selectStatus && inputOr) {
                form.addEventListener('submit', function (e) {
                    const statusVal = selectStatus.value;
                    const orVal = inputOr.value.trim();

                    // If status is forwarded past Receiving (e.g. Replotting, Valuation, Review, Approval, Approved)
                    if (statusVal !== 'Pending' && statusVal !== 'Receiving' && statusVal !== 'Deferred' && !orVal) {
                        e.preventDefault();
                        if (typeof toastr !== 'undefined') {
                            toastr.warning('An Official Receipt (O.R.) Number is required before forwarding this request to ' + statusVal + '. Please input the O.R. Number, or keep status as "Receiving".', 'O.R. Number Required');
                        } else {
                            alert('An Official Receipt (O.R.) Number is required before forwarding this request to ' + statusVal + '.');
                        }
                        inputOr.focus();
                        inputOr.classList.add('border-amber-500', 'ring-2', 'ring-amber-500/30');
                        inputOr.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        return false;
                    }
                });

                inputOr.addEventListener('input', function () {
                    if (this.value.trim().length > 0) {
                        this.classList.remove('border-amber-500', 'ring-2', 'ring-amber-500/30');
                    }
                });
            }
        });
    </script>
}
