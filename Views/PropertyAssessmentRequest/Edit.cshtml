@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let generatedPartitions = [];
        const alphabetLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

        document.addEventListener('DOMContentLoaded', function () {
            const txSelect = document.getElementById('txCodeSelect');
            function updateWorkflowBanners() {
                const val = txSelect ? txSelect.value : '';
                const sdBanner = document.getElementById('sdWorkflowBanner');
                const csBanner = document.getElementById('csWorkflowBanner');
                const dcBanner = document.getElementById('dcWorkflowBanner');
                const pcBanner = document.getElementById('pcWorkflowBanner');
                const trBanner = document.getElementById('trWorkflowBanner');
                const rcBanner = document.getElementById('rcWorkflowBanner');
                if (sdBanner) {
                    if (val === 'SD') {
                        sdBanner.classList.remove('hidden');
                    } else {
                        sdBanner.classList.add('hidden');
                    }
                }
                if (csBanner) {
                    if (val === 'CS') {
                        csBanner.classList.remove('hidden');
                    } else {
                        csBanner.classList.add('hidden');
                    }
                }
                if (dcBanner) {
                    if (val === 'DC') {
                        dcBanner.classList.remove('hidden');
                    } else {
                        dcBanner.classList.add('hidden');
                    }
                }
                if (pcBanner) {
                    if (val === 'PC') {
                        pcBanner.classList.remove('hidden');
                    } else {
                        pcBanner.classList.add('hidden');
                    }
                }
                if (trBanner) {
                    if (val === 'TR') {
                        trBanner.classList.remove('hidden');
                    } else {
                        trBanner.classList.add('hidden');
                    }
                }
                if (rcBanner) {
                    if (val === 'RC') {
                        rcBanner.classList.remove('hidden');
                    } else {
                        rcBanner.classList.add('hidden');
                    }
                }
            }

            if (txSelect) {
                txSelect.addEventListener('change', function () {
                    const opt = this.options[this.selectedIndex];
                    const input = document.getElementById('txNameInput');
                    if (input && opt) {
                        input.value = opt.getAttribute('data-name') || opt.text;
                    }
                    updateWorkflowBanners();
                });
                updateWorkflowBanners();
            }

            const modalKindSelect = document.getElementById('modalKind');
            if (modalKindSelect) {
                modalKindSelect.addEventListener('change', function() {
                    const bldgAlert = document.getElementById('modalBuildingAlert');
                    if (bldgAlert) {
                        if (this.value.toLowerCase() === 'building') {
                            bldgAlert.classList.remove('hidden');
                        } else {
                            bldgAlert.classList.add('hidden');
                        }
                    }
                });
            }

            // Searchable Registered Owner TomSelect (Auto-fill with Server-Side Remote Search for Thousands of Active Taxpayers)
            if (document.getElementById('registeredOwnerSelect')) {
                new TomSelect('#registeredOwnerSelect', {
                    create: false,
                    valueField: 'value',
                    labelField: 'text',
                    searchField: ['value', 'text', 'name', 'tin', 'display'],
                    loadThrottle: 300,
                    placeholder: 'Search active registered owner by name, TIN, or RPTIN...',
                    load: function(query, callback) {
                        if (!query || !query.trim().length) return callback();
                        fetch(`/PropertyAssessmentRequest/SearchRegisteredOwners?term=${encodeURIComponent(query)}`)
                            .then(res => res.json())
                            .then(data => callback(Array.isArray(data) ? data : []))
                            .catch(() => callback());
                    },
                    render: {
                        option: function(item, escape) {
                            if (item.name) {
                                return `<div class="py-1">
                                    <span class="font-bold text-slate-900 dark:text-white">${escape(item.name)}</span>
                                    <span class="text-[11px] text-slate-600 dark:text-stone-300 font-medium"> (TIN: ${escape(item.tin || 'N/A')} | ${escape(item.barangay || 'N/A')})</span>
                                </div>`;
                            }
                            return `<div class="py-1">${escape(item.text || item.display || '')}</div>`;
                        },
                        item: function(item, escape) {
                            if (item.name) {
                                return `<div>${escape(item.name)} (TIN: ${escape(item.tin || 'N/A')})</div>`;
                            }
                            return `<div>${escape(item.text || item.display || '')}</div>`;
                        }
                    },
                    onChange: function (ownerId) {
                        const ownerIdInput = document.getElementById('requestOwnerIdInput');
                        if (ownerIdInput) ownerIdInput.value = ownerId || '';
                        if (!ownerId) return;
                        fetch(`/PropertyAssessmentRequest/GetOwnerDetails?id=${encodeURIComponent(ownerId)}`)
                            .then(res => res.json())
                            .then(data => {
                                if (data) {
                                    if (ownerIdInput) ownerIdInput.value = data.id || ownerId;
                                    const nameInput = document.getElementById('newOwnerNameInput');
                                    const tinInput = document.getElementById('ownerTinInput');
                                    const phoneInput = document.getElementById('contactNoInput');
                                    const addressInput = document.getElementById('ownerAddressInput');

                                    if (nameInput) nameInput.value = data.name || '';
                                    if (tinInput) tinInput.value = data.tin || '';
                                    if (phoneInput) phoneInput.value = data.phone || '';
                                    if (addressInput) addressInput.value = data.address || data.street || '';

                                    if (typeof toastr !== 'undefined') {
                                        toastr.success(`Owner details auto-filled for ${data.name}!`, 'Registered Owner Loaded');
                                    }
                                }
                            })
                            .catch(err => console.error('Error fetching owner details:', err));
                    }
                });
            }

            // Load existing partitions
            try {
                const rawJson = document.getElementById('GeneratedPartitionsJson').value;
                if (rawJson) {
                    generatedPartitions = JSON.parse(rawJson);
                }
            } catch (e) {
                generatedPartitions = [];
            }

            renderPartitionsTable();

            const btnAddLot = document.getElementById('btnAddManualPartitionRow');
            if (btnAddLot) {
                btnAddLot.addEventListener('click', handleAddManualPartitionLot);
            }

            // Sync Property Kind dropdown into generated partitions
            const reqKindSelect = document.querySelector('select[name="Kind"]');
            if (reqKindSelect) {
                reqKindSelect.addEventListener('change', function() {
                    const selectedKind = this.value;
                    if (selectedKind && generatedPartitions.length > 0) {
                        generatedPartitions.forEach((p) => {
                            p.kind = selectedKind;
                        });
                        serializePartitions();
                        renderPartitionsTable();
                    }
                });
