@model PropertyAssessmentApp.Models.PropertyAssessmentRequest
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = $"Edit RPA - {Model.TrackingNumber}";
    var properties = ViewBag.Properties as IEnumerable<TaxDeclaration> ?? new List<TaxDeclaration>();
    var orderPayments = ViewBag.OrderPayments as IEnumerable<OrderPayment> ?? new List<OrderPayment>();
    var registeredOwners = ViewBag.RegisteredOwners as IEnumerable<Owner> ?? new List<Owner>();
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="edit" class="w-4 h-4"></i>
                <span>Edit Assessment Request</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Update Request @Model.TrackingNumber</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Update property appraisal parameters, new owner information, checklist items, or attached documents.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-8" id="propertyAssessmentEditForm" novalidate>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TrackingNumber" />
            <input type="hidden" asp-for="Partitions" id="Partitions" />
            <input type="hidden" asp-for="RefTaxDeclarationId" />
            <input type="hidden" asp-for="RequestedDocumentsJson" id="RequestedDocumentsJson" />
            <input type="hidden" asp-for="TotalFeesAmount" id="TotalFeesAmount" />
            <input type="hidden" asp-for="TransactionTypeName" id="txNameInput" />
            <input type="hidden" asp-for="GeneratedPartitionsJson" id="GeneratedPartitionsJson" />
            <input type="hidden" asp-for="SelectedRefPropertyIdsJson" id="SelectedRefPropertyIdsJson" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-300 dark:border-rose-800 text-rose-800 dark:text-rose-200 shadow-sm space-y-1">
                    <div class="flex items-center gap-2">
                        <i data-lucide="alert-triangle" class="w-5 h-5 text-rose-600 shrink-0"></i>
                        <h4 class="font-bold text-sm">Please correct the following errors before saving:</h4>
                    </div>
                    <div asp-validation-summary="All" class="text-xs list-disc list-inside text-rose-700 dark:text-rose-300 font-medium ml-7"></div>
                </div>
            }

            <!-- Transaction & Partitioning -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="tag" class="w-4 h-4 text-emerald-600"></i>
                    1. Transaction Type & Partitions
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="TransactionTypeCode" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TRANSACTION CODE <span class="text-rose-500 font-bold">*</span></label>
                        <select asp-for="TransactionTypeCode" id="txCodeSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600 cursor-pointer">
                            @if (!string.IsNullOrWhiteSpace(Model.TransactionTypeCode) && !PropertyAssessmentApp.Models.PropertyAssessmentRequest.StandardTransactionCodes.ContainsKey(Model.TransactionTypeCode.Trim().ToUpperInvariant()))
                            {
                                <option value="@Model.TransactionTypeCode" selected>@Model.TransactionTypeCode - @Model.TransactionTypeName</option>
                            }
                            <option value="SD" data-name="Subdivision">Subdivision - SD</option>
                            <option value="CS" data-name="Consolidation">Consolidation - CS</option>
                            <option value="DC" data-name="Discovery/New Declaration">Discovery/New Declaration - DC</option>
                            <option value="PC" data-name="Reassessment Due to Physical Change">Reassessment Due to Physical Change - PC</option>
                            <option value="RA" data-name="Reassessment">Reassessment - RA</option>
                            <option value="DT" data-name="Reassessment Due to partial Destruction of the property">Reassessment Due to partial Destruction of the property - DT</option>
                            <option value="TR" data-name="Transfer">Transfer - TR</option>
                            <option value="RC" data-name="Reclassification">Reclassification - RC</option>
                            <option value="GR" data-name="General Revision">General Revision - GR</option>
                            <option value="SP" data-name="Special Project">Special Project - SP</option>
                            <option value="DEP" data-name="Reassessment Due to depreciation">Reassessment Due to depreciation - DEP</option>
                        </select>
                        <span id="txCodeValidation" class="text-rose-500 js-field-error block mt-1 text-[11px]"></span>
                    </div>

                    <div>
                        <label asp-for="Kind" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY KIND <span class="text-rose-500 font-bold">*</span></label>
                        <select asp-for="Kind" id="kindSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold">
                            <option value="Land">Land</option>
                            <option value="Building">Building</option>
                            <option value="Machinery">Machinery</option>
                        </select>
                        <span id="kindValidation" class="text-rose-500 js-field-error block mt-1 text-[11px]"></span>
                    </div>

                    <div>
                        <label asp-for="LotNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT / SURVEY NO.</label>
                        <input asp-for="LotNo" id="lotNoInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                        <span id="lotNoValidation" class="text-rose-500 js-field-error block mt-1 text-[11px]"></span>
                    </div>
                </div>

                <!-- Subdivision (SD) Workflow & Impact Callout Banner -->
                <div id="sdWorkflowBanner" class="p-4 rounded-2xl bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-sky-900 dark:text-sky-300 font-extrabold text-xs uppercase">
                        <i data-lucide="split" class="w-4 h-4 text-sky-600 dark:text-sky-400"></i>
                        <span>Subdivision (SD) · Segregation of Land Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-sky-600 text-white text-[9px] font-bold">Segregation</span>
                    </div>
                    <p class="text-[11px] text-sky-800 dark:text-sky-300 leading-relaxed">
                        <strong>Workflow:</strong> Initiated when a registered owner divides a mother parcel into multiple lots. The appraiser and tax mapper inspect boundary pins, road alignments, and mandatory open spaces against the Land Registration Authority (LRA) or DENR-approved plan.
                    </p>
                    <p class="text-[11px] text-sky-700 dark:text-sky-400 font-semibold">
                        <strong>Impact on Property:</strong> The mother Tax Declaration will be stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. New unique PINs and individual TDs will be generated for each segregated lot (minimum 2 lots required). Tax liabilities and delinquencies are apportioned independently.
                    </p>
                </div>

                <!-- Consolidation (CS) Workflow & Impact Callout Banner -->
                <div id="csWorkflowBanner" class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-amber-900 dark:text-amber-300 font-extrabold text-xs uppercase">
                        <i data-lucide="merge" class="w-4 h-4 text-amber-600 dark:text-amber-400"></i>
                        <span>Consolidation (CS) · Lot Integration Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-amber-600 text-white text-[9px] font-bold">Lot Integration</span>
                    </div>
                    <p class="text-[11px] text-amber-800 dark:text-amber-300 leading-relaxed">
                        <strong>Workflow:</strong> Combines two or more contiguous parcels under identical ownership into a single parcel. Field inspection verifies that parcels physically touch without intervening public access easements, water channels, or third-party encroachments against the Land Registration Authority (LRA) or DENR-approved consolidation plan.
                    </p>
                    <p class="text-[11px] text-amber-700 dark:text-amber-400 font-semibold">
                        <strong>Impact on Property:</strong> All individual parent Tax Declarations are stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. A single consolidated TD and PIN are generated. Real property tax receivables in the Treasury are collapsed from multiple ledgers into a unified bill.
                    </p>
                </div>

                <!-- Discovery / New Declaration (DC) Workflow & Impact Callout Banner -->
                <div id="dcWorkflowBanner" class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-emerald-900 dark:text-emerald-300 font-extrabold text-xs uppercase">
                        <i data-lucide="sparkles" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Discovery / New Declaration (DC) · Original Assessment Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-emerald-600 text-white text-[9px] font-bold">Original Assessment</span>
                    </div>
                    <p class="text-[11px] text-emerald-800 dark:text-emerald-300 leading-relaxed">
                        <strong>Workflow:</strong> Applied when a newly completed building, warehouse, industrial machinery, or previously unmapped land parcel is declared. The appraiser takes tape measurements, establishes structural framing (Types I to V), and verifies operational status.
                    </p>
                    <p class="text-[11px] text-emerald-700 dark:text-emerald-400 font-semibold">
                        <strong>Impact on Property:</strong> Does not supersede any prior TD. Creates an original Field Appraisal and Assessment Sheet (FAAS). Under Sec. 222 of R.A. 7160, back taxes may be assessed for up to ten (10) preceding years if unassessed since completion.
                    </p>
                </div>

                <!-- Reassessment Due to Physical Change (PC) Workflow & Impact Callout Banner -->
                <div id="pcWorkflowBanner" class="p-4 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-indigo-900 dark:text-indigo-300 font-extrabold text-xs uppercase">
                        <i data-lucide="hammer" class="w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                        <span>Reassessment Due to Physical Change (PC) · Renovation / Expansion Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-indigo-600 text-white text-[9px] font-bold">Renovation / Expansion</span>
                    </div>
                    <p class="text-[11px] text-indigo-800 dark:text-indigo-300 leading-relaxed">
                        <strong>Workflow:</strong> Triggered by structural renovations, adding vertical floors, floor plan extensions, or constructing accessory improvements (swimming pools, perimeter fences). Inspection logs new square meters and materials against building permits and physical site appraisal.
                    </p>
                    <p class="text-[11px] text-indigo-700 dark:text-indigo-400 font-semibold">
                        <strong>Impact on Property:</strong> The previous Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. Fair Market Value (FMV) and Assessed Value increase, recalculating structural effective age and leading to an upward tax adjustment.
                    </p>
                </div>

                <!-- Transfer (TR) Workflow & Impact Callout Banner -->
                <div id="trWorkflowBanner" class="p-4 rounded-2xl bg-teal-50 dark:bg-teal-950/40 border border-teal-200 dark:border-teal-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-teal-900 dark:text-teal-300 font-extrabold text-xs uppercase">
                        <i data-lucide="arrow-right-left" class="w-4 h-4 text-teal-600 dark:text-teal-400"></i>
                        <span>Transfer (TR) · Administrative Title Conveyance Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-teal-600 text-white text-[9px] font-bold">Administrative Conveyance</span>
                    </div>
                    <p class="text-[11px] text-teal-800 dark:text-teal-300 leading-relaxed">
                        <strong>Workflow:</strong> Executed upon sale, donation, barter, or extrajudicial settlement. Requires Transfer Certificate of Title (TCT), BIR Certificate Authorizing Registration (CAR/eCAR), and Transfer Tax Receipt. Field inspection is not required.
                    </p>
                    <p class="text-[11px] text-teal-700 dark:text-teal-400 font-semibold">
                        <strong>Impact on Property:</strong> The prior owner's Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. The replacement TD retains identical land area, building classifications, and PIN, while redirecting billing ledgers to the transferee.
                    </p>
                </div>

                <!-- Reclassification (RC) Workflow & Impact Callout Banner -->
                <div id="rcWorkflowBanner" class="p-4 rounded-2xl bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-purple-900 dark:text-purple-300 font-extrabold text-xs uppercase">
                        <i data-lucide="layers" class="w-4 h-4 text-purple-600 dark:text-purple-400"></i>
                        <span>Reclassification (RC) · Actual Ground Use Conversion Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-purple-600 text-white text-[9px] font-bold">Ground Use Conversion</span>
                    </div>
                    <p class="text-[11px] text-purple-800 dark:text-purple-300 leading-relaxed">
                        <strong>Workflow:</strong> Mandated when land or structures convert physical usage (e.g., agricultural land to commercial parking, or residential home to retail grocery). Field inspection confirms actual economic activity pursuant to Sec. 217 of R.A. 7160.
                    </p>
                    <p class="text-[11px] text-purple-700 dark:text-purple-400 font-semibold">
                        <strong>Impact on Property:</strong> The old Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. Replaces the statutory assessment level (e.g., from 20% Residential to 50% Commercial), altering annual property tax dues without needing title re-titling.
                    </p>
                </div>
            </div>

            <!-- Previous Property -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="history" class="w-4 h-4 text-emerald-600"></i>
                    2. Previous Property Information
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="PrevTDN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS TDN</label>
                        <input asp-for="PrevTDN" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                    </div>
                    <div>
                        <label asp-for="PrevPIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS PIN</label>
                        <input asp-for="PrevPIN" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                    </div>
                    <div>
                        <label asp-for="PrevOwner" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS OWNER</label>
                        <input asp-for="PrevOwner" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                    </div>
                </div>

                <div>
                    <label asp-for="PropertyLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOCATION ADDRESS <span class="text-rose-500 font-bold">*</span></label>
                    <input asp-for="PropertyLocation" id="locationInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" />
                    <span asp-validation-for="PropertyLocation" id="propertyLocationValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                </div>
            </div>

            <!-- Generated Partition/s (Editable) -->
            <div id="generatedPartitionsContainer" class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="layers" class="w-4 h-4 text-emerald-600"></i>
                        Generated Partition/s
                    </h3>
                    <button type="button" id="btnAddManualPartitionRow" class="px-3 py-1.5 rounded-lg bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-emerald-700 dark:text-emerald-400 font-bold text-[11px] border border-slate-200 dark:border-stone-800 flex items-center gap-1 shadow-xs">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        Add Another Lot
                    </button>
                </div>
                <span id="partitionsValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>

                <div class="border border-slate-200 dark:border-stone-800 rounded-2xl overflow-x-auto bg-white dark:bg-stone-900 shadow-sm">
                    <table class="w-full text-left text-xs font-mono">
                        <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 font-bold uppercase text-[10px]">
                            <tr>
                                <th class="px-4 py-3">TDN</th>
                                <th class="px-4 py-3">Kind</th>
                                <th class="px-4 py-3">Owner</th>
                                <th class="px-4 py-3">Property Location</th>
                                <th class="px-4 py-3 text-center w-24">Action</th>
                            </tr>
                        </thead>
                        <tbody id="generatedPartitionsTbody" class="divide-y divide-slate-100 dark:divide-stone-800/60 font-sans">
                            <!-- Populated by JS -->
                        </tbody>
                        <tfoot class="bg-slate-50 dark:bg-stone-950/80 font-bold text-slate-900 dark:text-white border-t border-slate-200 dark:border-stone-800">
                            <tr>
                                <td colspan="5" class="px-4 py-2.5 text-xs text-slate-500">
                                    <div class="flex items-center justify-between">
                                        <span id="footPartitionSummary" class="font-bold text-slate-800 dark:text-stone-200">Total Partitions: 0 lot(s)</span>
                                        <span class="text-slate-400 text-[10px]">Click pencil icon to configure detailed appraisal specifications</span>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- New Owner Details -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="user-plus" class="w-4 h-4 text-emerald-600"></i>
                        3. New Owner / Declarant
                    </h3>
                    <span class="text-[11px] text-slate-500 dark:text-stone-400">
                        Select an existing registered owner or update declarant details
                    </span>
                </div>

                <!-- Searchable Registered Owner Dropdown (Auto-fill) -->
                <div class="p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 space-y-2">
                    <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase flex items-center gap-2">
                        <i data-lucide="user-search" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        Fetch Registered Owner from Database (Auto-fill)
                    </label>
                    <select id="registeredOwnerSelect" class="w-full">
                        <option value="">-- Search registered owner by Name, TIN, or RPTIN (Optional) --</option>
                        @foreach (var owner in registeredOwners)
                        {
                            <option value="@owner.Id">@owner.DisplayName (TIN: @owner.TaxIdentNo | @owner.BarangayName)</option>
                        }
                    </select>
                    <p class="text-[10px] text-slate-500 dark:text-stone-400">
                        Selecting a registered owner will automatically fill in Owner Name, TIN, Contact Number, and Address below.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="NewOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">NEW OWNER NAME <span class="text-rose-500 font-bold">*</span></label>
                        <input type="hidden" asp-for="OwnerId" id="requestOwnerIdInput" />
                        <input asp-for="NewOwnerName" id="newOwnerNameInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" required />
                        <span asp-validation-for="NewOwnerName" id="newOwnerNameValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="OwnerTIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER TIN</label>
                        <input asp-for="OwnerTIN" id="ownerTinInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                        <span asp-validation-for="OwnerTIN" id="ownerTinValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="ContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONTACT NO.</label>
                        <input asp-for="ContactNo" id="contactNoInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" />
                        <span asp-validation-for="ContactNo" id="contactNoValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Address" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ADDRESS <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="Address" id="ownerAddressInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                        <span asp-validation-for="Address" id="ownerAddressValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="EmailAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EMAIL ADDRESS</label>
                        <input asp-for="EmailAddress" id="emailAddressInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="taxpayer@example.com" />
                        <span asp-validation-for="EmailAddress" id="emailAddressValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="Requestor" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REQUESTOR</label>
                        <input asp-for="Requestor" id="requestorInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" />
                        <span asp-validation-for="Requestor" id="requestorValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                </div>
            </div>

            <!-- Documents Checklist -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                    4. Documents Submitted Checklist
                </h3>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocTitleTctCloa" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Title (OCT/TCT/CLOA)</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocDeedOfSaleConveyance" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Deed of Sale / Conveyance</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocCarBir" class="w-4 h-4 rounded text-emerald-600" />
                        <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">BIR CAR Certificate</span>
                    </label>
                    <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                        <input type="checkbox" asp-for="DocTaxClearance" class="w-4 h-4 rounded text-emerald-600" />
