                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="ORNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">O.R. NUMBER</label>
                        <input asp-for="ORNumber" id="inputEditORNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="OR-2026-XXXX" />
