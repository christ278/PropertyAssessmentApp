@model PropertyAssessmentApp.Models.PropertyAssessmentRequest
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = "New Property Assessment Request (RPA)";
    var properties = ViewBag.Properties as IEnumerable<TaxDeclaration> ?? new List<TaxDeclaration>();
    var orderPayments = ViewBag.OrderPayments as IEnumerable<OrderPayment> ?? new List<OrderPayment>();
    var registeredOwners = ViewBag.RegisteredOwners as IEnumerable<Owner> ?? new List<Owner>();
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="layers" class="w-4 h-4"></i>
                <span>Real Property Appraisal & FAAS Assessment</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">File Property Assessment Request</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Encode new property assessments, lot subdivisions into partitions, transfers of ownership, or new discoveries.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Create" method="post" enctype="multipart/form-data" id="propertyAssessmentForm" class="space-y-8" novalidate autocomplete="off">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Partitions" id="Partitions" value="1" />
            <input type="hidden" asp-for="RequestedDocumentsJson" id="RequestedDocumentsJson" />
            <input type="hidden" asp-for="TotalFeesAmount" id="TotalFeesAmount" />
            <input type="hidden" asp-for="GeneratedPartitionsJson" id="GeneratedPartitionsJson" />
            <input type="hidden" asp-for="SelectedRefPropertyIdsJson" id="SelectedRefPropertyIdsJson" />
            <input type="hidden" asp-for="RefTaxDeclarationId" id="primaryRefPropertyId" />
            <div asp-validation-summary="ModelOnly" class="hidden"></div>

            <!-- Tracking & Status Badge Header -->
            <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <span class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-extrabold text-xs font-mono">
                        TRACKING NO: @Model.TrackingNumber
                    </span>
                    <span class="text-slate-500 dark:text-stone-400 text-[11px]">Auto-generated system reference</span>
                </div>
                <input type="hidden" asp-for="TrackingNumber" />
                <input type="hidden" asp-for="Status" />
            </div>

            <!-- Step 1: Transaction Classification & Partitions -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="tag" class="w-4 h-4 text-emerald-600"></i>
                    1. Transaction Type & Assessment Partitioning
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="TransactionTypeCode" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">TRANSACTION CODE <span class="text-rose-500 font-bold">*</span></label>
                        <select asp-for="TransactionTypeCode" id="txCodeSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600 cursor-pointer">
                            <option value="SD" data-name="Subdivision">Subdivision - SD</option>
                            <option value="CS" data-name="Consolidation">Consolidation - CS</option>
                            <option value="DC" data-name="Discovery/New Declaration" selected>Discovery/New Declaration - DC</option>
                            <option value="PC" data-name="Reassessment Due to Physical Change">Reassessment Due to Physical Change - PC</option>
                            <option value="RA" data-name="Reassessment">Reassessment - RA</option>
                            <option value="DT" data-name="Reassessment Due to partial Destruction of the property">Reassessment Due to partial Destruction of the property - DT</option>
                            <option value="TR" data-name="Transfer">Transfer - TR</option>
                            <option value="RC" data-name="Reclassification">Reclassification - RC</option>
                            <option value="GR" data-name="General Revision">General Revision - GR</option>
                            <option value="SP" data-name="Special Project">Special Project - SP</option>
                            <option value="DEP" data-name="Reassessment Due to depreciation">Reassessment Due to depreciation - DEP</option>
                        </select>
                        <input type="hidden" asp-for="TransactionTypeName" id="txNameInput" value="Discovery/New Declaration" />
                        <span id="txCodeValidation" class="text-rose-500 js-field-error block mt-1 text-[11px]"></span>
                    </div>

                    <div>
                        <label asp-for="Kind" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY KIND <span class="text-rose-500 font-bold">*</span></label>
                        <select asp-for="Kind" id="kindSelect" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600">
                            <option value="Land">Land</option>
                            <option value="Building">Building</option>
                            <option value="Machinery">Machinery</option>
                        </select>
                        <span id="kindValidation" class="text-rose-500 js-field-error block mt-1 text-[11px]"></span>
                    </div>

                    <div>
                        <label asp-for="LotNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT / SURVEY NO.</label>
                        <input asp-for="LotNo" id="lotNoInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Lot 15-A, Psd-..." />
                        <span id="lotNoValidation" class="text-rose-500 js-field-error block mt-1 text-[11px]"></span>
                    </div>
                </div>

                <!-- Subdivision (SD) Workflow & Impact Callout Banner -->
                <div id="sdWorkflowBanner" class="p-4 rounded-2xl bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-sky-900 dark:text-sky-300 font-extrabold text-xs uppercase">
                        <i data-lucide="split" class="w-4 h-4 text-sky-600 dark:text-sky-400"></i>
                        <span>Subdivision (SD) · Segregation of Land Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-sky-600 text-white text-[9px] font-bold">Segregation</span>
                    </div>
                    <p class="text-[11px] text-sky-800 dark:text-sky-300 leading-relaxed">
                        <strong>Workflow:</strong> Initiated when a registered owner divides a mother parcel into multiple lots. The appraiser and tax mapper inspect boundary pins, road alignments, and mandatory open spaces against the Land Registration Authority (LRA) or DENR-approved plan.
                    </p>
                    <p class="text-[11px] text-sky-700 dark:text-sky-400 font-semibold">
                        <strong>Impact on Property:</strong> The mother Tax Declaration will be stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. New unique PINs and individual TDs will be generated for each segregated lot (minimum 2 lots required). Tax liabilities and delinquencies are apportioned independently.
                    </p>
                </div>

                <!-- Consolidation (CS) Workflow & Impact Callout Banner -->
                <div id="csWorkflowBanner" class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-amber-900 dark:text-amber-300 font-extrabold text-xs uppercase">
                        <i data-lucide="merge" class="w-4 h-4 text-amber-600 dark:text-amber-400"></i>
                        <span>Consolidation (CS) · Lot Integration Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-amber-600 text-white text-[9px] font-bold">Lot Integration</span>
                    </div>
                    <p class="text-[11px] text-amber-800 dark:text-amber-300 leading-relaxed">
                        <strong>Workflow:</strong> Combines two or more contiguous parcels under identical ownership into a single parcel. Field inspection verifies that parcels physically touch without intervening public access easements, water channels, or third-party encroachments against the Land Registration Authority (LRA) or DENR-approved consolidation plan.
                    </p>
                    <p class="text-[11px] text-amber-700 dark:text-amber-400 font-semibold">
                        <strong>Impact on Property:</strong> All individual parent Tax Declarations are stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. A single consolidated TD and PIN are generated. Real property tax receivables in the Treasury are collapsed from multiple ledgers into a unified bill.
                    </p>
                </div>

                <!-- Discovery / New Declaration (DC) Workflow & Impact Callout Banner -->
                <div id="dcWorkflowBanner" class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-emerald-900 dark:text-emerald-300 font-extrabold text-xs uppercase">
                        <i data-lucide="sparkles" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span>Discovery / New Declaration (DC) · Original Assessment Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-emerald-600 text-white text-[9px] font-bold">Original Assessment</span>
                    </div>
                    <p class="text-[11px] text-emerald-800 dark:text-emerald-300 leading-relaxed">
                        <strong>Workflow:</strong> Applied when a newly completed building, warehouse, industrial machinery, or previously unmapped land parcel is declared. The appraiser takes tape measurements, establishes structural framing (Types I to V), and verifies operational status.
                    </p>
                    <p class="text-[11px] text-emerald-700 dark:text-emerald-400 font-semibold">
                        <strong>Impact on Property:</strong> Does not supersede any prior TD. Creates an original Field Appraisal and Assessment Sheet (FAAS). Under Sec. 222 of R.A. 7160, back taxes may be assessed for up to ten (10) preceding years if unassessed since completion.
                    </p>
                </div>

                <!-- Reassessment Due to Physical Change (PC) Workflow & Impact Callout Banner -->
                <div id="pcWorkflowBanner" class="p-4 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-indigo-900 dark:text-indigo-300 font-extrabold text-xs uppercase">
                        <i data-lucide="hammer" class="w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                        <span>Reassessment Due to Physical Change (PC) · Renovation / Expansion Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-indigo-600 text-white text-[9px] font-bold">Renovation / Expansion</span>
                    </div>
                    <p class="text-[11px] text-indigo-800 dark:text-indigo-300 leading-relaxed">
                        <strong>Workflow:</strong> Triggered by structural renovations, adding vertical floors, floor plan extensions, or constructing accessory improvements (swimming pools, perimeter fences). Inspection logs new square meters and materials against building permits and physical site appraisal.
                    </p>
                    <p class="text-[11px] text-indigo-700 dark:text-indigo-400 font-semibold">
                        <strong>Impact on Property:</strong> The previous Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. Fair Market Value (FMV) and Assessed Value increase, recalculating structural effective age and leading to an upward tax adjustment.
                    </p>
                </div>

                <!-- Transfer (TR) Workflow & Impact Callout Banner -->
                <div id="trWorkflowBanner" class="p-4 rounded-2xl bg-teal-50 dark:bg-teal-950/40 border border-teal-200 dark:border-teal-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-teal-900 dark:text-teal-300 font-extrabold text-xs uppercase">
                        <i data-lucide="arrow-right-left" class="w-4 h-4 text-teal-600 dark:text-teal-400"></i>
                        <span>Transfer (TR) · Administrative Title Conveyance Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-teal-600 text-white text-[9px] font-bold">Administrative Conveyance</span>
                    </div>
                    <p class="text-[11px] text-teal-800 dark:text-teal-300 leading-relaxed">
                        <strong>Workflow:</strong> Executed upon sale, donation, barter, or extrajudicial settlement. Requires Transfer Certificate of Title (TCT), BIR Certificate Authorizing Registration (CAR/eCAR), and Transfer Tax Receipt. Field inspection is not required.
                    </p>
                    <p class="text-[11px] text-teal-700 dark:text-teal-400 font-semibold">
                        <strong>Impact on Property:</strong> The prior owner's Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. The replacement TD retains identical land area, building classifications, and PIN, while redirecting billing ledgers to the transferee.
                    </p>
                </div>

                <!-- Reclassification (RC) Workflow & Impact Callout Banner -->
                <div id="rcWorkflowBanner" class="p-4 rounded-2xl bg-purple-50 dark:bg-purple-950/40 border border-purple-200 dark:border-purple-800/60 hidden space-y-2">
                    <div class="flex items-center gap-2 text-purple-900 dark:text-purple-300 font-extrabold text-xs uppercase">
                        <i data-lucide="layers" class="w-4 h-4 text-purple-600 dark:text-purple-400"></i>
                        <span>Reclassification (RC) · Actual Ground Use Conversion Workflow</span>
                        <span class="px-2 py-0.5 rounded-full bg-purple-600 text-white text-[9px] font-bold">Ground Use Conversion</span>
                    </div>
                    <p class="text-[11px] text-purple-800 dark:text-purple-300 leading-relaxed">
                        <strong>Workflow:</strong> Mandated when land or structures convert physical usage (e.g., agricultural land to commercial parking, or residential home to retail grocery). Field inspection confirms actual economic activity pursuant to Sec. 217 of R.A. 7160.
                    </p>
                    <p class="text-[11px] text-purple-700 dark:text-purple-400 font-semibold">
                        <strong>Impact on Property:</strong> The old Tax Declaration is stamped <span class="text-rose-600 dark:text-rose-400 font-bold">&quot;CANCELLED &amp; SUPERSEDED&quot;</span> upon approval. Replaces the statutory assessment level (e.g., from 20% Residential to 50% Commercial), altering annual property tax dues without needing title re-titling.
                    </p>
                </div>
            </div>

            <!-- Step 2: Reference Property & Previous Owner -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="history" class="w-4 h-4 text-emerald-600"></i>
                        2. Reference Properties & Assessment Partitioning
                    </h3>
                    <span class="text-[11px] text-slate-500 dark:text-stone-400">
                        Select one or multiple properties to subdivide, consolidate, or duplicate
                    </span>
                </div>

                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">
                        CHOOSE REFERENCE PROPERTY <span class="text-emerald-600 text-xs font-normal">(Multiple Selection Allowed)</span> <span class="text-rose-500 font-bold">*</span>
                    </label>
                    <select id="refPropertySelect" multiple class="w-full">
                        @foreach (var p in properties)
                        {
                            <option value="@p.Id" 
                                    data-id="@p.Id" 
                                    data-tdn="@p.TaxDeclarationNumber" 
                                    data-pin="@p.PropertyIndexNumber" 
                                    data-owner="@p.OwnerName" 
                                    data-location="@p.CompleteAddress"
                                    data-kind="@p.Kind"
                                    data-classification="@p.Classification"
                                    data-area="@p.AreaSqMeters"
                                    data-unitval="@p.UnitValue"
                                    data-marketval="@p.MarketValue"
                                    data-assesslevel="@p.AssessmentLevelPercent"
                                    data-assessedval="@p.AssessedValue"
                                    data-barangay="@p.DistrictOrBarangay">
                                @p.TaxDeclarationNumber - @p.OwnerName (@p.PropertyIndexNumber) [@p.Kind &bull; @p.Classification &bull; @p.AreaSqMeters.ToString("N0") sqm]
                            </option>
                        }
                    </select>
                    <span asp-validation-for="RefTaxDeclarationId" id="refPropertyValidation" class="text-rose-500 font-bold block mt-1 text-[11px]"></span>
                </div>

                <!-- Selected Reference Properties Summary List -->
                <div id="selectedPropertiesSummary" class="hidden space-y-3 pt-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-700 dark:text-stone-300 uppercase flex items-center gap-1.5">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                            Selected Reference Properties (<span id="selectedCountBadge">0</span>)
                        </span>
                        <span class="text-[10px] text-slate-400">Values will be used as baseline for child lot partitions</span>
                    </div>
                    <div id="selectedPropertiesList" class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Partition Generator Action Card -->
                <div id="partitionGeneratorCard" class="hidden p-5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-slate-50 dark:from-emerald-950/40 dark:via-teal-950/30 dark:to-stone-900 border border-emerald-200 dark:border-emerald-800/60 shadow-sm space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                        <div class="space-y-1">
                            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-600 text-white font-bold text-[10px] uppercase">
                                <i data-lucide="split" class="w-3 h-3"></i>
                                Generate Partition Action
                            </div>
                            <h4 class="text-sm font-extrabold text-slate-900 dark:text-white">
                                Automated Partition Lot & System TDN Generation
                            </h4>
                            <p class="text-[11px] text-slate-600 dark:text-stone-400 max-w-2xl leading-relaxed">
                                <strong>What does Generate Partition mean?</strong> In property assessment, partitioning creates child Tax Declaration lots by duplicating the appraisal valuation, land use classification, and barangay location from your selected reference property into new partition lot records. Each partition receives a brand-new, system-generated TDN.
                            </p>
                        </div>
                    </div>

                    <!-- Multi-Property Selector: Which property to duplicate from (if 2 or more selected) -->
                    <div id="duplicateSourceSelector" class="space-y-2 pt-2 border-t border-emerald-200/60 dark:border-emerald-800/40">
                        <label class="block text-xs font-bold text-slate-800 dark:text-stone-200 uppercase">
                            Choose Which Reference Property to Duplicate / Partition From:
                        </label>
                        <div id="propertyRadioGroup" class="grid grid-cols-1 md:grid-cols-2 gap-2">
                            <!-- Populated dynamically: Property 1, Property 2, or Both -->
                        </div>
                    </div>

                    <!-- Partition Generation Controls -->
                    <div class="flex flex-wrap items-center gap-3 pt-2">
                        <div class="flex items-center gap-2 bg-white dark:bg-stone-900 px-3 py-2 rounded-xl border border-emerald-200 dark:border-emerald-800 shadow-xs">
                            <label class="text-xs font-bold text-slate-700 dark:text-stone-300">Partition Count (Lots):</label>
                            <input type="number" id="genPartitionCountInput" min="1" max="26" value="2" class="w-16 px-2 py-1 rounded bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-center text-sm" />
                        </div>
                        <button type="button" id="btnTriggerGeneratePartitions" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-2 shadow-md shadow-emerald-600/20 transition-all">
                            <i data-lucide="zap" class="w-4 h-4"></i>
                            Generate Partition Lots
                        </button>
                    </div>
                </div>

                <!-- Generated Partitions Monospaced Table -->
                <div id="generatedPartitionsContainer" class="hidden space-y-3 pt-2">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="layers" class="w-4 h-4 text-emerald-600"></i>
                            Generated Partition/s
                        </h4>
                        <button type="button" id="btnAddManualPartitionRow" class="px-3 py-1.5 rounded-lg bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-emerald-700 dark:text-emerald-400 font-bold text-[11px] border border-slate-200 dark:border-stone-800 flex items-center gap-1 shadow-xs">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                            Add Another Lot
                        </button>
                    </div>

                    <div class="border border-slate-200 dark:border-stone-800 rounded-2xl overflow-x-auto bg-white dark:bg-stone-900 shadow-sm">
                        <table class="w-full text-left text-xs font-mono">
                            <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 font-bold uppercase text-[10px]">
                                <tr>
                                    <th class="px-4 py-3">TDN</th>
                                    <th class="px-4 py-3">Kind</th>
                                    <th class="px-4 py-3">Owner</th>
                                    <th class="px-4 py-3">Property Location</th>
                                    <th class="px-4 py-3 text-center w-24">Action</th>
                                </tr>
                            </thead>
                            <tbody id="generatedPartitionsTbody" class="divide-y divide-slate-100 dark:divide-stone-800/60 font-sans">
                                <!-- Populated by JS -->
                            </tbody>
                            <tfoot class="bg-slate-50 dark:bg-stone-950/80 font-bold text-slate-900 dark:text-white border-t border-slate-200 dark:border-stone-800">
                                <tr>
                                    <td colspan="5" class="px-4 py-2.5 text-xs text-slate-500">
                                        <div class="flex items-center justify-between">
                                            <span id="footPartitionSummary" class="font-bold text-slate-800 dark:text-stone-200">Total Partitions: 0 lot(s)</span>
                                            <span class="text-slate-400 text-[10px]">Click pencil icon to configure detailed appraisal specifications</span>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Compatible Previous TDN & Location Inputs (Auto-synced) -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                    <div>
                        <label asp-for="PrevTDN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS TDN</label>
                        <input asp-for="PrevTDN" id="prevTDNInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="TD-2026-GS-..." />
                    </div>
                    <div>
                        <label asp-for="PrevPIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS PIN</label>
                        <input asp-for="PrevPIN" id="prevPINInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono" placeholder="126-00-0000" />
                    </div>
                    <div>
                        <label asp-for="PrevOwner" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PREVIOUS / DECLARED OWNER</label>
                        <input asp-for="PrevOwner" id="prevOwnerInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Previous Owner Name" />
                    </div>
                </div>

                <div>
                    <label asp-for="PropertyLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY LOCATION <span class="text-rose-500 font-bold">*</span></label>
                    <input asp-for="PropertyLocation" id="locationInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Street, Barangay, City" />
                    <span asp-validation-for="PropertyLocation" id="propertyLocationValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                </div>
            </div>

            <!-- Step 3: New Owner / Declarant Information -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="user-plus" class="w-4 h-4 text-emerald-600"></i>
                        3. New Owner / Declarant Information
                    </h3>
                    <span class="text-[11px] text-slate-500 dark:text-stone-400">
                        Select an existing registered owner or encode new declarant details
                    </span>
                </div>

                <!-- Searchable Registered Owner Dropdown (Auto-fill) -->
                <div class="p-4 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 space-y-2">
                    <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase flex items-center gap-2">
                        <i data-lucide="user-search" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        Fetch Registered Owner from Database (Auto-fill)
                    </label>
                    <select id="registeredOwnerSelect" class="w-full">
                        <option value="">-- Search registered owner by Name, TIN, or RPTIN (Optional) --</option>
                        @foreach (var owner in registeredOwners)
                        {
                            <option value="@owner.Id">@owner.DisplayName (TIN: @owner.TaxIdentNo | @owner.BarangayName)</option>
                        }
                    </select>
                    <p class="text-[10px] text-slate-500 dark:text-stone-400">
                        Selecting a registered owner will automatically fill in Owner Name, TIN, Contact Number, and Address below. You can still modify these fields manually.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="NewOwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">NEW OWNER / BUYER NAME <span class="text-rose-500 font-bold">*</span></label>
                        <input type="hidden" asp-for="OwnerId" id="requestOwnerIdInput" />
                        <input asp-for="NewOwnerName" id="newOwnerNameInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" placeholder="Full Declarant / Company Name" required />
                        <span asp-validation-for="NewOwnerName" id="newOwnerNameValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="OwnerTIN" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER TIN</label>
                        <input asp-for="OwnerTIN" id="ownerTinInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono focus:outline-none focus:border-emerald-600" placeholder="000-000-000-000" />
                        <span asp-validation-for="OwnerTIN" id="ownerTinValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="ContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONTACT / MOBILE NO.</label>
                        <input asp-for="ContactNo" id="contactNoInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono focus:outline-none focus:border-emerald-600" placeholder="0917-000-0000" />
                        <span asp-validation-for="ContactNo" id="contactNoValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Address" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">OWNER ADDRESS <span class="text-rose-500 font-bold">*</span></label>
                        <input asp-for="Address" id="ownerAddressInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="Resident / Mailing Address" />
                        <span asp-validation-for="Address" id="ownerAddressValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="EmailAddress" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">EMAIL ADDRESS</label>
                        <input asp-for="EmailAddress" id="emailAddressInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="taxpayer@example.com" />
                        <span asp-validation-for="EmailAddress" id="emailAddressValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                    <div>
                        <label asp-for="Requestor" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REQUESTOR / REPRESENTATIVE</label>
                        <input asp-for="Requestor" id="requestorInput" autocomplete="off" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" placeholder="Name of Person Filing" />
                        <span asp-validation-for="Requestor" id="requestorValidation" class="text-rose-500 js-field-error font-bold block mt-1 text-[11px]"></span>
                    </div>
                </div>
            </div>

            <!-- Step 4: Documents Submitted Checklist (Matching CAST Categories) -->
            <div class="space-y-6 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="folder-check" class="w-4 h-4 text-emerald-600"></i>
                    4. Documents Submitted Checklist (CAST System Standard)
                </h3>

                <!-- Category A: Basic Requirements -->
                <div>
                    <h4 class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-2">A. Basic Requirements</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocTitleTctCloa" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Certificate of Title (OCT/TCT/CLOA)</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocDeedOfSaleConveyance" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Deed of Absolute Sale / Conveyance</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocCarBir" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">BIR Certificate Authorizing Reg. (CAR)</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocTaxClearance" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Real Property Tax Clearance</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocTransferTaxReceipt" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Transfer Tax Official Receipt</span>
                        </label>
                    </div>
                </div>

                <!-- Category B: Newly Discovered Lands -->
                <div>
                    <h4 class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-2">B. Newly Discovered Lands</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocApprovedSurveyPlan" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Approved Survey Plan (DENR/LMB)</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocCadastralMap" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Cadastral Map Blueprint</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocDenrCert" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">DENR Alienable & Disposable Cert</span>
                        </label>
                    </div>
                </div>

                <!-- Category C: New Building/s & Machineries -->
                <div>
                    <h4 class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-2">C. New Buildings & Machineries</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocBuildingPermit" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Building Permit</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocCertCompletion" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Certificate of Completion</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocCertOccupancy" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Certificate of Occupancy</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocInvoiceReceipts" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Machinery Commercial Invoices</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocInstallationCostBreakdown" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Installation Cost Breakdown</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocSpecsManual" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Specifications & Manuals</span>
                        </label>
                    </div>
                </div>

                <!-- Category D: Representative & Others -->
                <div>
                    <h4 class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-2">D. Representative & Others</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocSpaAuthLetter" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Special Power of Attorney (SPA) / Letter</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer">
                            <input type="checkbox" asp-for="DocValidIdOwnerRep" class="w-4 h-4 rounded text-emerald-600" />
                            <span class="text-[11px] font-semibold text-slate-800 dark:text-stone-200">Valid Government IDs of Owner & Rep</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Step 5: Attachment Upload (Routed to CAST PropertyAssessment Location ~/UploadFile/PropertyAssessment/{TrackingNo}) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2 border-b border-slate-200 dark:border-stone-800 pb-2">
                    <i data-lucide="paperclip" class="w-4 h-4 text-emerald-600"></i>
                    5. Upload Title, Deed, or Appraisal Dossier
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                        <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ATTACHMENT FILE (PDF, ZIP, PNG)</label>
                        <input type="file" name="fileUpload" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-mono file:font-bold file:bg-emerald-600 file:text-white" />
                        <p class="text-[10px] text-slate-400 mt-1">Saved to CAST property assessment file location: <code class="text-emerald-600 font-bold">~/UploadFile/PropertyAssessment/@Model.TrackingNumber</code></p>
                    </div>
                    <div>
                        <label asp-for="ORNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">O.R. NUMBER (OPTIONAL UPON FILING)</label>
                        <input asp-for="ORNumber" id="inputORNumber" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono focus:outline-none focus:border-emerald-600" placeholder="OR-2026-XXXX (Optional)" />
                        <p class="text-[10px] text-slate-400 mt-1">Optional upon filing. Required later before forwarding transaction in My Transactions.</p>
                    </div>
                </div>
            </div>

            <!-- Step 6: Document To Be Requested Table (Order of Payment Rates) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="calculator" class="w-4 h-4 text-emerald-600"></i>
                            6. Order of Payment & Fee Computation <span class="text-rose-500 font-bold">*</span>
                        </h3>
                        <p class="text-slate-500 dark:text-stone-400 text-[11px] mt-0.5">Select assessment particulars and certified true copy fees.</p>
                        <span id="feeTableValidation" class="text-rose-500 js-field-error block mt-1 text-[11px]">@string.Join(" ", ViewData.ModelState["RequestedDocumentsJson"]?.Errors.Select(e => e.ErrorMessage) ?? ViewData.ModelState["TotalFeesAmount"]?.Errors.Select(e => e.ErrorMessage) ?? Enumerable.Empty<string>())</span>
                    </div>

                    <button type="button" id="btnAddRow" class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center gap-1.5 text-xs font-mono shadow-sm">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        Add Fee Particular
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[500px] text-left text-xs font-mono" id="feesTable">
                        <thead class="bg-slate-200/60 dark:bg-stone-900 text-slate-700 dark:text-stone-300 font-bold border-b border-slate-300 dark:border-stone-800">
                            <tr>
                                <th class="px-3 py-2.5 w-12 text-center">ACTION</th>
                                <th class="px-3 py-2.5">PARTICULAR (ORDER OF PAYMENT)</th>
                                <th class="px-3 py-2.5 w-32 text-right">FEES (₱)</th>
                                <th class="px-3 py-2.5 w-32 text-center">QUANTITY</th>
                                <th class="px-3 py-2.5 w-36 text-right">TOTAL (₱)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-stone-800" id="feesTableBody">
                            <!-- Dynamic rows -->
                        </tbody>
                    </table>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-stone-800">
                    <span class="text-sm font-extrabold text-slate-900 dark:text-white uppercase font-mono">Total Assessment Fees:</span>
                    <div class="text-xl font-black font-mono text-emerald-700 dark:text-emerald-400 bg-white dark:bg-stone-900 px-6 py-2 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm">
                        ₱ <span id="lblOverallTotal">0.00</span>
                    </div>
                </div>
            </div>

            <!-- Submit Button Footer -->
            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <a asp-action="Index" class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-all">
                    Cancel
                </a>
                <button type="submit" id="btnSaveRequest" class="w-full sm:w-auto text-center px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all" title="Save Assessment Request (No O.R. required upon filing)">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    <span>Save Property Assessment Request</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT PARTITION MODAL -->
<div id="editPartitionModal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-2xl bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-2xl p-6 sm:p-8 space-y-6 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center font-bold">
                    <i data-lucide="pencil" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900 dark:text-white" id="modalPartitionTitle">Edit Partition Record</h3>
                    <p class="text-xs text-slate-500 dark:text-stone-400">Modify valuation, lot parameters, classification, or declarant</p>
                </div>
            </div>
            <button type="button" onclick="closeEditPartitionModal()" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-stone-200 rounded-xl hover:bg-slate-100 dark:hover:bg-stone-800 transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <input type="hidden" id="modalPartitionIdx" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SYSTEM-GENERATED TDN</label>
                <div class="flex items-center gap-1.5">
                    <input type="text" id="modalTDN" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
                    <button type="button" onclick="reRollModalTDN()" class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300" title="Re-roll TDN">
                        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY IDENTIFICATION NO. (PIN)</label>
                <input type="text" id="modalPIN" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOT / SURVEY NO.</label>
                <input type="text" id="modalLotNo" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-semibold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" placeholder="e.g. Lot 15-A, Psd-..." />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY KIND</label>
                <select id="modalKind" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600">
                    <option value="Land">Land</option>
                    <option value="Building">Building</option>
                    <option value="Machinery">Machinery</option>
                </select>
            </div>

            <!-- Building Form Prompt Alert (Appears when Building Kind is selected) -->
            <div id="modalBuildingAlert" class="hidden sm:col-span-2 p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                        <i data-lucide="building" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <span class="text-xs font-bold text-emerald-900 dark:text-emerald-200 block">Building Appraisal Form</span>
                        <span class="text-[11px] text-slate-500 dark:text-stone-400 block font-sans">Includes Structural Type (BUCC Class), 17 Materials checklist, and Floor breakdown.</span>
                    </div>
                </div>
                <button type="button" onclick="editPartitionRedirect(parseInt(document.getElementById('modalPartitionIdx').value))" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shrink-0 flex items-center gap-1.5 shadow-sm">
                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Open Building Form
                </button>
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CLASSIFICATION</label>
                <input type="text" id="modalClassification" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" placeholder="Residential, Commercial..." />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROPERTY LOCATION</label>
                <input type="text" id="modalLocation" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-semibold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" placeholder="e.g. Pioneer Ave., General Santos City" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BARANGAY / DISTRICT</label>
                <input type="text" id="modalBarangay" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-semibold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" placeholder="e.g. Brgy. Lagao" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">AREA (SQ.M.)</label>
                <input type="number" step="0.01" id="modalArea" oninput="recomputeModalValuation()" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">UNIT VALUE (₱ / SQ.M.)</label>
                <input type="number" step="0.01" id="modalUnitValue" oninput="recomputeModalValuation()" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">ASSESSMENT LEVEL (%)</label>
                <input type="number" step="1" min="1" max="100" id="modalAssessLevel" oninput="recomputeModalValuation()" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-mono font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">NEW DECLARANT / OWNER</label>
                <input type="text" id="modalOwner" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 font-bold text-slate-900 dark:text-white text-xs focus:outline-none focus:border-emerald-600" />
            </div>

            <div class="p-3 rounded-2xl bg-slate-100 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <span class="block text-[10px] text-slate-400 uppercase font-bold">Computed Market Value (FMV)</span>
                <span id="modalMarketValueLbl" class="text-sm font-black text-slate-900 dark:text-white font-mono">₱0.00</span>
            </div>

            <div class="p-3 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800">
                <span class="block text-[10px] text-emerald-700 dark:text-emerald-400 uppercase font-bold">Computed Assessed Value (AV)</span>
                <span id="modalAssessedValueLbl" class="text-sm font-black text-emerald-700 dark:text-emerald-400 font-mono">₱0.00</span>
            </div>
        </div>

        <div class="flex items-center justify-between gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
            <a href="javascript:void(0)" onclick="editPartitionRedirect(parseInt(document.getElementById('modalPartitionIdx').value))" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 underline flex items-center gap-1" title="Open comprehensive CAST appraisal with building materials, sketches, and full specs">
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                Full CAST Appraisal (Building Form)
            </a>
            <div class="flex items-center gap-2">
                <button type="button" onclick="closeEditPartitionModal()" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold text-xs transition-colors">
                    Cancel
                </button>
                <button type="button" onclick="saveEditPartitionModal()" class="px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md shadow-emerald-600/20 transition-all flex items-center gap-1.5">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Save Partition Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.serverUpdatedPartition = null;
        window.serverUpdatedIdx = -1;
        @if (TempData["LastUpdatedPartitionJson"] != null)
        {
            <text>
            try {
                window.serverUpdatedPartition = @Html.Raw(TempData["LastUpdatedPartitionJson"]);
                window.serverUpdatedIdx = @(TempData["LastUpdatedPartitionIndex"] ?? -1);
            } catch(e) { }
            </text>
        }

        const availableParticulars = [
            @foreach (var op in orderPayments)
            {
                @: { code: "@op.Code", name: "@op.Particular", fee: @op.UnitCost },
            }
        ];

        // Dictionary of all properties for fast, reactive client-side cloning & partitioning
        const referencePropertiesData = {
            @foreach (var p in properties)
            {
                @: "@p.Id": {
                @:     id: "@p.Id",
                @:     tdn: "@p.TaxDeclarationNumber",
                @:     pin: "@p.PropertyIndexNumber",
                @:     owner: "@p.OwnerName",
                @:     location: "@p.CompleteAddress",
                @:     kind: "@p.Kind",
                @:     classification: "@p.Classification",
                @:     area: @p.AreaSqMeters,
                @:     unitValue: @p.UnitValue,
                @:     marketValue: @p.MarketValue,
                @:     assessLevel: @p.AssessmentLevelPercent,
                @:     assessedValue: @p.AssessedValue,
                @:     barangay: "@p.DistrictOrBarangay"
                @: },
            }
        };

        let TomSelectRefProperty = null;
        let selectedPropertyIds = [];
        let generatedPartitions = [];
        let isSyncingOwnerAndProperty = false;
        const alphabetLetters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

        function normalizeTdnForComparison(tdn) {
            if (!tdn) return '';
            let s = String(tdn).trim().toUpperCase().replace(/[\s\-_]+/g, '-');
            s = s.replace(/-(LAND|BLDG|BUILDING|MACH|MACHINERY|IMP|IMPROVEMENT)-/gi, '-');
            s = s.replace(/-(LAND|BLDG|BUILDING|MACH|MACHINERY|IMP|IMPROVEMENT)$/gi, '');
            s = s.replace(/^(LAND|BLDG|BUILDING|MACH|MACHINERY|IMP|IMPROVEMENT)-/gi, '');
            return s;
        }

        function extractTdnSequence(tdn) {
            if (!tdn) return '';
            const matches = String(tdn).match(/\d{3,}/g);
            return (matches && matches.length > 0) ? matches[matches.length - 1] : '';
        }

        function normalizePinForComparison(pin) {
            if (!pin) return '';
            const clean = String(pin).trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (clean === 'NA' || clean === 'NONE' || /^0+$/.test(clean)) return '';
            return clean;
        }

        function normalizeOwnerForComparison(owner) {
            if (!owner) return '';
            return String(owner).trim().toUpperCase().replace(/[\s.,'-]+/g, '');
        }

        function arePropertiesSameTaxDeclaration(p1, p2) {
            if (!p1 || !p2) return false;
            const raw1 = (p1.tdn || '').trim().toUpperCase();
            const raw2 = (p2.tdn || '').trim().toUpperCase();
            if (raw1 && raw2 && raw1 === raw2) return true;

            const norm1 = normalizeTdnForComparison(p1.tdn);
            const norm2 = normalizeTdnForComparison(p2.tdn);
            if (norm1 && norm2 && norm1 === norm2) return true;

            const pin1 = normalizePinForComparison(p1.pin);
            const pin2 = normalizePinForComparison(p2.pin);
            if (pin1 && pin2 && pin1.length >= 6 && pin1 === pin2) return true;

            const seq1 = extractTdnSequence(p1.tdn);
            const seq2 = extractTdnSequence(p2.tdn);
            const o1 = normalizeOwnerForComparison(p1.owner);
            const o2 = normalizeOwnerForComparison(p2.owner);
            if (seq1 && seq2 && seq1 === seq2 && o1 && o2 && o1 === o2) return true;

            return false;
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Transaction Code selector sync & SD/CS/DC/PC/TR/RC Workflow Banner toggle
            const txSelect = document.getElementById('txCodeSelect');
            function updateWorkflowBanners() {
                const val = txSelect ? txSelect.value : '';
                const sdBanner = document.getElementById('sdWorkflowBanner');
                const csBanner = document.getElementById('csWorkflowBanner');
                const dcBanner = document.getElementById('dcWorkflowBanner');
                const pcBanner = document.getElementById('pcWorkflowBanner');
                const trBanner = document.getElementById('trWorkflowBanner');
                const rcBanner = document.getElementById('rcWorkflowBanner');
                if (sdBanner) {
                    if (val === 'SD') {
                        sdBanner.classList.remove('hidden');
                    } else {
                        sdBanner.classList.add('hidden');
                    }
                }
                if (csBanner) {
                    if (val === 'CS') {
                        csBanner.classList.remove('hidden');
                    } else {
                        csBanner.classList.add('hidden');
                    }
                }
                if (dcBanner) {
                    if (val === 'DC') {
                        dcBanner.classList.remove('hidden');
                    } else {
                        dcBanner.classList.add('hidden');
                    }
                }
                if (pcBanner) {
                    if (val === 'PC') {
                        pcBanner.classList.remove('hidden');
                    } else {
                        pcBanner.classList.add('hidden');
                    }
                }
                if (trBanner) {
                    if (val === 'TR') {
                        trBanner.classList.remove('hidden');
                    } else {
                        trBanner.classList.add('hidden');
                    }
                }
                if (rcBanner) {
                    if (val === 'RC') {
                        rcBanner.classList.remove('hidden');
                    } else {
                        rcBanner.classList.add('hidden');
                    }
                }
            }

            if (txSelect) {
                txSelect.addEventListener('change', function () {
                    const opt = this.options[this.selectedIndex];
                    const input = document.getElementById('txNameInput');
                    if (input && opt) input.value = opt.getAttribute('data-name') || opt.text;
                    updateWorkflowBanners();
                });
                updateWorkflowBanners();
            }

            // Multi-Select TomSelect on Reference Properties (Server-Side Remote Search for Thousands of Approved Records)
            if (document.getElementById('refPropertySelect')) {
                TomSelectRefProperty = new TomSelect('#refPropertySelect', {
                    plugins: ['remove_button'],
                    maxItems: null,
                    persist: false,
                    create: false,
                    openOnFocus: false,
                    closeAfterSelect: true,
                    selectOnTab: false,
                    valueField: 'id',
                    labelField: 'display',
                    searchField: ['tdn', 'pin', 'owner', 'display', 'text'],
                    loadThrottle: 300,
                    placeholder: 'Search & select approved reference properties by TDN, PIN, or Owner Name...',
                    load: function(query, callback) {
                        if (!query || !query.trim().length) return callback();
                        fetch(`/PropertyAssessmentRequest/SearchApprovedProperties?term=${encodeURIComponent(query)}`)
                            .then(res => res.json())
                            .then(data => {
                                if (Array.isArray(data)) {
                                    data.forEach(item => {
                                        referencePropertiesData[item.id] = {
                                            id: item.id,
                                            tdn: item.tdn,
                                            pin: item.pin,
                                            owner: item.owner,
                                            location: item.location,
                                            kind: item.kind,
                                            classification: item.classification,
                                            area: item.area,
                                            unitValue: item.unitVal,
                                            marketValue: item.marketVal,
                                            assessLevel: item.assessLevel,
                                            assessedValue: item.assessedVal,
                                            barangay: item.barangay
                                        };
                                    });
                                    callback(data);
                                } else {
                                    callback();
                                }
                            })
                            .catch(() => callback());
                    },
                    render: {
                        option: function(item, escape) {
                            return `<div class="py-1">
                                <span class="font-bold text-slate-900 dark:text-white font-mono">${escape(item.tdn || item.text || '')}</span>
                                <span class="text-slate-700 dark:text-stone-200 text-xs font-medium"> - ${escape(item.owner || '')}</span>
                                <span class="text-[11px] text-slate-600 dark:text-stone-300 font-mono">(${escape(item.pin || 'No PIN')})</span>
                                ${item.kind ? `<div class="text-[11px] text-slate-600 dark:text-stone-300 font-medium mt-0.5">${escape(item.kind)} &bull; ${escape(item.classification || '')} &bull; ${Number(item.area || 0).toLocaleString()} sqm</div>` : ''}
                            </div>`;
                        },
                        item: function(item, escape) {
                            return `<div>${escape(item.tdn || item.text || '')} - ${escape(item.owner || '')}</div>`;
                        }
                    },
                    onItemAdd: function(value, $item) {
                        const addedItem = referencePropertiesData[value];
                        if (!addedItem) return;

                        const currentItems = this.items || [];
                        const existingSelected = currentItems.filter(id => id !== value);
                        for (let i = 0; i < existingSelected.length; i++) {
                            const existing = referencePropertiesData[existingSelected[i]];
                            if (existing && arePropertiesSameTaxDeclaration(addedItem, existing)) {
                                this.removeItem(value, true);
                                const refSpan = document.getElementById('refPropertyValidation');
                                if (refSpan) {
                                    refSpan.textContent = `Cannot select the same Reference Property multiple times: '${addedItem.tdn}' and '${existing.tdn}' refer to the same property.`;
                                }
                                if (typeof toastr !== 'undefined') {
                                    toastr.error(`Property '${addedItem.tdn}' refers to the same property as '${existing.tdn}' and cannot be added as a duplicate.`, 'Duplicate Reference TD');
                                }
                                return;
                            }
                        }
                    },
                    onChange: function(values) {
                        handleReferencePropertiesChange(values);
                    }
                });
            }

            // Searchable Registered Owner TomSelect (Auto-fill with Server-Side Remote Search for Thousands of Active Taxpayers)
            let TomSelectRegisteredOwner = null;
            if (document.getElementById('registeredOwnerSelect')) {
                TomSelectRegisteredOwner = new TomSelect('#registeredOwnerSelect', {
                    create: false,
                    openOnFocus: false,
                    closeAfterSelect: true,
                    selectOnTab: false,
                    valueField: 'id',
                    labelField: 'display',
                    searchField: ['name', 'tin', 'text', 'display'],
                    loadThrottle: 300,
                    placeholder: 'Search active registered owner by name, TIN, or RPTIN...',
                    load: function(query, callback) {
                        if (!query || !query.trim().length) return callback();
                        fetch(`/PropertyAssessmentRequest/SearchRegisteredOwners?term=${encodeURIComponent(query)}`)
                            .then(res => res.json())
                            .then(data => callback(Array.isArray(data) ? data : []))
                            .catch(() => callback());
                    },
                    render: {
                        option: function(item, escape) {
                            if (item.name) {
                                return `<div class="py-1">
                                    <span class="font-bold text-slate-900 dark:text-white">${escape(item.name)}</span>
                                    <span class="text-[11px] text-slate-600 dark:text-stone-300 font-medium"> (TIN: ${escape(item.tin || 'N/A')} | ${escape(item.barangay || 'N/A')})</span>
                                </div>`;
                            }
                            return `<div class="py-1">${escape(item.text || item.display || '')}</div>`;
                        },
                        item: function(item, escape) {
                            if (item.name) {
                                return `<div>${escape(item.name)} (TIN: ${escape(item.tin || 'N/A')})</div>`;
                            }
                            return `<div>${escape(item.text || item.display || '')}</div>`;
                        }
                    },
                    onChange: function (ownerId) {
                        const ownerIdInput = document.getElementById('requestOwnerIdInput');
                        if (ownerIdInput) ownerIdInput.value = ownerId || '';
                        if (!ownerId || isSyncingOwnerAndProperty) return;
                        isSyncingOwnerAndProperty = true;

                        fetch(`/PropertyAssessmentRequest/GetOwnerDetails?id=${encodeURIComponent(ownerId)}`)
                            .then(res => res.json())
                            .then(data => {
                                if (data) {
                                    if (ownerIdInput) ownerIdInput.value = data.id || ownerId;
                                    const nameInput = document.getElementById('newOwnerNameInput');
                                    const tinInput = document.getElementById('ownerTinInput');
                                    const phoneInput = document.getElementById('contactNoInput');
                                    const addressInput = document.getElementById('ownerAddressInput');

                                    if (nameInput) {
                                        nameInput.value = data.name || '';
                                        nameInput.setAttribute('data-auto-filled', 'true');
                                        nameInput.dispatchEvent(new Event('input', { bubbles: true }));
                                    }
                                    if (tinInput) tinInput.value = data.tin || '';
                                    if (phoneInput) phoneInput.value = data.phone || '';
                                    if (addressInput) {
                                        addressInput.value = data.address || data.street || '';
                                        addressInput.setAttribute('data-auto-filled', 'true');
                                    }

                                    generatedPartitions.forEach(p => {
                                        if (!p.customOwner) {
                                            p.ownerId = data.id || ownerId;
                                        }
                                    });
                                    serializePartitions();

                                    // Auto-populate reference properties for this registered owner without opening/blinking dropdown
                                    if (data.name && TomSelectRefProperty) {
                                        fetch(`/PropertyAssessmentRequest/SearchApprovedProperties?term=${encodeURIComponent(data.name)}`)
                                            .then(res => res.json())
                                            .then(props => {
                                                if (Array.isArray(props) && props.length > 0) {
                                                    props.forEach(item => {
                                                        referencePropertiesData[item.id] = {
                                                            id: item.id,
                                                            tdn: item.tdn,
                                                            pin: item.pin,
                                                            owner: item.owner,
                                                            location: item.location,
                                                            kind: item.kind,
                                                            classification: item.classification,
                                                            area: item.area,
                                                            unitValue: item.unitVal,
                                                            marketValue: item.marketVal,
                                                            assessLevel: item.assessLevel,
                                                            assessedValue: item.assessedVal,
                                                            barangay: item.barangay
                                                        };
                                                        TomSelectRefProperty.addOption(item);
                                                    });
                                                    // Auto-select the first property belonging to this owner if none is currently selected
                                                    if (!selectedPropertyIds || selectedPropertyIds.length === 0) {
                                                        TomSelectRefProperty.addItem(props[0].id, true);
                                                    }
                                                    TomSelectRefProperty.close();
                                                }
                                            })
                                            .catch(() => {})
                                            .finally(() => {
                                                isSyncingOwnerAndProperty = false;
                                            });
                                    } else {
                                        isSyncingOwnerAndProperty = false;
                                    }

                                    if (typeof toastr !== 'undefined') {
                                        toastr.success(`Owner details auto-filled for ${data.name}!`, 'Registered Owner Loaded');
                                    }
                                } else {
                                    isSyncingOwnerAndProperty = false;
                                }
                            })
                            .catch(err => {
                                console.error('Error fetching owner details:', err);
                                isSyncingOwnerAndProperty = false;
                            });
                    }
                });
            }

            // Generate Partitions Button Click
            const btnGen = document.getElementById('btnTriggerGeneratePartitions');
            if (btnGen) {
                btnGen.addEventListener('click', handleGeneratePartitions);
            }

            // Add Manual Lot Button Click
            const btnAddLot = document.getElementById('btnAddManualPartitionRow');
            if (btnAddLot) {
                btnAddLot.addEventListener('click', handleAddManualPartitionLot);
            }

            // Sync Property Kind dropdown into generated partitions
            const reqKindSelect = document.querySelector('select[name="Kind"]');
            if (reqKindSelect) {
                reqKindSelect.addEventListener('change', function() {
                    const selectedKind = this.value;
                    if (selectedKind && generatedPartitions.length > 0) {
                        generatedPartitions.forEach((p) => {
                            p.kind = selectedKind;
                        });
                        serializePartitions();
                        renderPartitionsTable();
                    }
                });
            }

            // Sync New Owner Name into partitions and clear validation
            const newOwnerInput = document.querySelector('input[name="NewOwnerName"]');
            if (newOwnerInput) {
                newOwnerInput.addEventListener('keydown', function() {
                    this.removeAttribute('data-auto-filled');
                });
                const addrInput = document.getElementById('ownerAddressInput');
                if (addrInput) {
                    addrInput.addEventListener('keydown', function() {
                        this.removeAttribute('data-auto-filled');
                    });
                }
                newOwnerInput.addEventListener('input', function() {
                    const val = this.value.trim();
                    if (val) {
                        this.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                        const ownerSpan = document.getElementById('newOwnerNameValidation');
                        if (ownerSpan) ownerSpan.textContent = '';
                    }
                    if (generatedPartitions.length > 0) {
                        generatedPartitions.forEach((p) => {
                            if (!p.customOwner) {
                                p.newOwnerName = val;
                            }
                        });
                        serializePartitions();
                        renderPartitionsTable();
                    }
                });
            }

            // Sync Property Location input into partitions
            const locInput = document.getElementById('locationInput');
            if (locInput) {
                locInput.addEventListener('input', function() {
                    const val = this.value.trim();
                    if (generatedPartitions.length > 0) {
                        generatedPartitions.forEach((p) => {
                            if (!p.customLocation) {
                                p.propertyLocation = val;
                            }
                        });
                        serializePartitions();
                        renderPartitionsTable();
                    }
                });
            }

            // Fees table row initialization
            addRow();
            document.getElementById('btnAddRow').addEventListener('click', addRow);

            // Form validation on submit: validates fields with inline error spans beneath them
            var form = document.getElementById('propertyAssessmentForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var isValid = true;
                    var firstInvalid = null;

                    // Clear error classes and text
                    document.querySelectorAll('.border-rose-500').forEach(function(el) {
                        el.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                    });
                    document.querySelectorAll('.js-field-error').forEach(function(el) {
                        el.textContent = '';
                    });

                    function markInvalid(element, spanId, message) {
                        isValid = false;
                        if (element) {
                            element.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/30');
                        }
                        if (spanId) {
                            var span = document.getElementById(spanId);
                            if (span) span.textContent = message;
                        }
                        if (!firstInvalid && element) {
                            firstInvalid = element;
                        }
                    }

                    const personNameRegex = /^[\p{L}\s.,'\-]+$/u;
                    const phoneRegex = /^(\+63|0)?\d{7,10}$/;
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;

                    // 1. Validate Reference Property
                    var refSpan = document.getElementById('refPropertyValidation');
                    var tsControl = document.querySelector('#refPropertySelect + .ts-wrapper .ts-control');
                    const currentTxCode = (document.getElementById('txCodeSelect')?.value || '').trim().toUpperCase();
                    if (!selectedPropertyIds || selectedPropertyIds.length === 0) {
                        if (currentTxCode !== 'DC') {
                            markInvalid(tsControl || document.getElementById('refPropertySelect'), 'refPropertyValidation', 'Please search and select at least one Reference Tax Declaration (TD).');
                        }
                    } else {
                        // Check pairwise for duplicate/same TD
                        var duplicateFound = false;
                        for (let i = 0; i < selectedPropertyIds.length; i++) {
                            for (let j = i + 1; j < selectedPropertyIds.length; j++) {
                                const pA = referencePropertiesData[selectedPropertyIds[i]];
                                const pB = referencePropertiesData[selectedPropertyIds[j]];
                                if (pA && pB && arePropertiesSameTaxDeclaration(pA, pB)) {
                                    duplicateFound = true;
                                    markInvalid(tsControl || document.getElementById('refPropertySelect'), 'refPropertyValidation',
                                        `Cannot select the same Reference Property: '${pA.tdn}' and '${pB.tdn}' refer to the same property.`);
                                    break;
                                }
                            }
                            if (duplicateFound) break;
                        }
                    }

                    // 2. Validate Subdivision (SD) · Segregation of Land Partition Count & Consolidation (CS)
                    if (currentTxCode === 'SD') {
                        const partCount = generatedPartitions.length > 0 ? generatedPartitions.length : (parseInt(document.getElementById('Partitions')?.value, 10) || 1);
                        if (partCount < 2) {
                            const genCard = document.getElementById('partitionGeneratorCard');
                            if (genCard) genCard.classList.remove('hidden');
                            markInvalid(document.getElementById('genPartitionCountInput') || genCard, 'refPropertyValidation',
                                'Subdivision (SD) · Segregation of Land requires at least 2 segregated lot partitions. Please generate or add at least 2 partition lots.');
                        }
                    }
                    if (currentTxCode === 'CS') {
                        if (selectedPropertyIds.length < 2) {
                            markInvalid(tsControl || document.getElementById('refPropertySelect'), 'refPropertyValidation',
                                'Consolidation (CS) · Lot Integration requires selecting at least 2 contiguous reference parcels to integrate.');
                        } else {
                            let firstOwner = null;
                            let diffOwner = false;
                            for (let id of selectedPropertyIds) {
                                const p = referencePropertiesData[id];
                                if (p && p.owner) {
                                    const cleanOwner = p.owner.trim().toLowerCase();
                                    if (!firstOwner) firstOwner = cleanOwner;
                                    else if (firstOwner !== cleanOwner) { diffOwner = true; break; }
                                }
                            }
                            if (diffOwner) {
                                markInvalid(tsControl || document.getElementById('refPropertySelect'), 'refPropertyValidation',
                                    'Consolidation (CS) requires identical ownership. All selected contiguous parcels must belong to the same registered owner.');
                            }
                        }
                    }
                    if (currentTxCode === 'PC') {
                        if (selectedPropertyIds.length !== 1) {
                            markInvalid(tsControl || document.getElementById('refPropertySelect'), 'refPropertyValidation',
                                'Reassessment Due to Physical Change (PC) requires selecting exactly 1 reference property undergoing structural renovation or expansion.');
                        }
                    }
                    if (currentTxCode === 'TR') {
                        if (selectedPropertyIds.length !== 1) {
                            markInvalid(tsControl || document.getElementById('refPropertySelect'), 'refPropertyValidation',
                                'Transfer (TR) · Administrative Title Conveyance requires selecting exactly 1 reference property to convey.');
                        }
                    }
                    if (currentTxCode === 'RC') {
                        if (selectedPropertyIds.length !== 1) {
                            markInvalid(tsControl || document.getElementById('refPropertySelect'), 'refPropertyValidation',
                                'Reclassification (RC) · Actual Ground Use Conversion requires selecting exactly 1 reference property converting physical ground use.');
                        }
                    }

                    // Validate Back Taxes Period
                    if (generatedPartitions && generatedPartitions.length > 0) {
                        for (let p of generatedPartitions) {
                            if (p.backTaxesYearFrom) {
                                const yrFrom = parseInt(p.backTaxesYearFrom, 10);
                                if (p.backTaxesYearTo && parseInt(p.backTaxesYearTo, 10) < yrFrom) {
                                    markInvalid(document.getElementById('generatedPartitionsContainer'), 'refPropertyValidation',
                                        'Back Taxes "To Year" cannot be earlier than "From Year".');
                                    break;
                                }
                            }
                        }
                    }

                    // 3. Validate New Owner Name (Required, max 150, valid name, no N/A)
                    var ownerEl = document.getElementById('newOwnerNameInput');
                    var ownerVal = ownerEl ? ownerEl.value.trim() : '';
                    if (!ownerVal) {
                        markInvalid(ownerEl, 'newOwnerNameValidation', 'New Owner / Declarant Name is required.');
                    } else if (ownerVal.replace(/\//g, '').toUpperCase() === 'NA') {
                        markInvalid(ownerEl, 'newOwnerNameValidation', 'New Owner / Declarant Name is required (N/A is not accepted).');
                    } else if (ownerVal.length > 150) {
                        markInvalid(ownerEl, 'newOwnerNameValidation', 'New Owner Name must not exceed 150 characters.');
                    } else if (!personNameRegex.test(ownerVal)) {
                        markInvalid(ownerEl, 'newOwnerNameValidation', 'New Owner Name contains invalid characters.');
                    }

                    // 4. Validate Owner Address (Required, max 250)
                    var addrEl = document.getElementById('ownerAddressInput');
                    var addrVal = addrEl ? addrEl.value.trim() : '';
                    if (!addrVal) {
                        markInvalid(addrEl, 'ownerAddressValidation', 'Owner Address is required.');
                    } else if (addrVal.length > 250) {
                        markInvalid(addrEl, 'ownerAddressValidation', 'Owner Address must not exceed 250 characters.');
                    }

                    // 5. Validate Property Location (Required, max 250)
                    var locEl = document.getElementById('locationInput');
                    var locVal = locEl ? locEl.value.trim() : '';
                    if (!locVal) {
                        markInvalid(locEl, 'propertyLocationValidation', 'Property Location is required.');
                    } else if (locVal.length > 250) {
                        markInvalid(locEl, 'propertyLocationValidation', 'Property Location must not exceed 250 characters.');
                    }

                    // 6. Optional Owner Demographics Format Checks
                    var tinEl = document.getElementById('ownerTinInput');
                    if (tinEl && tinEl.value.trim().length > 30) {
                        markInvalid(tinEl, 'ownerTinValidation', 'Owner TIN must not exceed 30 characters.');
                    }

                    var phoneEl = document.getElementById('contactNoInput');
                    if (phoneEl && phoneEl.value.trim()) {
                        var phoneVal = phoneEl.value.trim();
                        if (phoneVal.length > 20) {
                            markInvalid(phoneEl, 'contactNoValidation', 'Contact Number must not exceed 20 characters.');
                        } else if (!phoneRegex.test(phoneVal)) {
                            markInvalid(phoneEl, 'contactNoValidation', 'Contact number must be 7-11 digits (e.g. 09171234567 or +639171234567).');
                        }
                    }

                    var emailEl = document.getElementById('emailAddressInput');
                    if (emailEl && emailEl.value.trim()) {
                        var emailVal = emailEl.value.trim();
                        if (emailVal.length > 100) {
                            markInvalid(emailEl, 'emailAddressValidation', 'Email Address must not exceed 100 characters.');
                        } else if (!emailRegex.test(emailVal)) {
                            markInvalid(emailEl, 'emailAddressValidation', 'Please enter a valid email address.');
                        }
                    }

                    var lotNoEl = document.getElementById('lotNoInput');
                    if (lotNoEl && lotNoEl.value.trim().length > 100) {
                        markInvalid(lotNoEl, 'lotNoValidation', 'Lot / Survey No. must not exceed 100 characters.');
                    }

                    var reqEl = document.getElementById('requestorInput');
                    if (reqEl && reqEl.value.trim()) {
                        var reqVal = reqEl.value.trim();
                        if (reqVal.length > 150) {
                            markInvalid(reqEl, 'requestorValidation', 'Requestor name must not exceed 150 characters.');
                        } else if (!personNameRegex.test(reqVal)) {
                            markInvalid(reqEl, 'requestorValidation', 'Requestor name contains invalid characters.');
                        }
                    }

                    // 7. Validate Order of Payment & Fee Computation
                    if (typeof recalculateGrandTotal === 'function') {
                        recalculateGrandTotal();
                    }
                    var totalFees = parseFloat(document.getElementById('TotalFeesAmount')?.value) || 0;
                    var docJson = document.getElementById('RequestedDocumentsJson')?.value;
                    var parsedFees = [];
                    try { parsedFees = JSON.parse(docJson || '[]'); } catch(ex) { parsedFees = []; }

                    var feesTable = document.getElementById('feesTable');
                    if (!parsedFees || parsedFees.length === 0) {
                        markInvalid(feesTable || document.getElementById('btnAddRow'), 'feeTableValidation', 'At least one Order of Payment fee particular is required.');
                    } else {
                        var seenParticulars = new Set();
                        var feeError = null;
                        for (let i = 0; i < parsedFees.length; i++) {
                            var item = parsedFees[i];
                            var pCode = (item.ParticularCode || item.particularCode || '').trim();
                            var pName = (item.ParticularName || item.particularName || '').trim();
                            var pKey = pCode || pName;
                            if (!pKey) {
                                feeError = `Fee row ${i + 1}: Fee Particular must be selected.`;
                                break;
                            }
                            if (seenParticulars.has(pKey.toUpperCase())) {
                                feeError = `Duplicate fee particular '${pKey}' found. Each fee particular may only be added once.`;
                                break;
                            }
                            seenParticulars.add(pKey.toUpperCase());
                            var qty = parseFloat(item.Quantity !== undefined ? item.Quantity : item.quantity) || 0;
                            var cost = parseFloat(item.UnitCost !== undefined ? item.UnitCost : item.unitCost) || 0;
                            if (qty <= 0 || qty > 999) {
                                feeError = `Fee row ${i + 1} (${pKey}): Quantity must be between 1 and 999.`;
                                break;
                            }
                            if (cost < 0) {
                                feeError = `Fee row ${i + 1} (${pKey}): Rate/Unit Cost cannot be negative.`;
                                break;
                            }
                        }

                        if (feeError) {
                            markInvalid(feesTable || document.getElementById('btnAddRow'), 'feeTableValidation', feeError);
                        } else if (totalFees <= 0) {
                            markInvalid(feesTable || document.getElementById('btnAddRow'), 'feeTableValidation', 'Total fees amount must be greater than zero.');
                        }
                    }

                    if (!isValid) {
                        e.preventDefault();
                        if (firstInvalid) {
                            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            if (typeof firstInvalid.focus === 'function') firstInvalid.focus();
                        }
                        return false;
                    }

                    var statusInput = document.querySelector('input[name="Status"]');
                    if (statusInput) statusInput.value = 'Receiving';

                    // Clear draft on successful submission
                    sessionStorage.removeItem('propertyAssessmentRequest_draft');
                });
            }

            // Restore draft if returning from EditPartition
            try {
                const rawDraft = sessionStorage.getItem('propertyAssessmentRequest_draft');
                if (rawDraft) {
                    const draft = JSON.parse(rawDraft);
                    if (draft) {
                        if (draft.txCode && document.getElementById('txCodeSelect')) {
                            document.getElementById('txCodeSelect').value = draft.txCode;
                            const opt = document.getElementById('txCodeSelect').options[document.getElementById('txCodeSelect').selectedIndex];
                            if (opt && document.getElementById('txNameInput')) document.getElementById('txNameInput').value = opt.getAttribute('data-name') || opt.text;
                        }
                        if (draft.requestDate && document.querySelector('input[name="RequestDate"]')) document.querySelector('input[name="RequestDate"]').value = draft.requestDate;
                        if (draft.newOwnerName && document.querySelector('input[name="NewOwnerName"]')) document.querySelector('input[name="NewOwnerName"]').value = draft.newOwnerName;
                        if (draft.ownerTin && document.querySelector('input[name="OwnerTIN"]')) document.querySelector('input[name="OwnerTIN"]').value = draft.ownerTin;
                        if (draft.contactNo && document.querySelector('input[name="ContactNo"]')) document.querySelector('input[name="ContactNo"]').value = draft.contactNo;
                        if (draft.address && document.querySelector('input[name="Address"]')) document.querySelector('input[name="Address"]').value = draft.address;
                        if (draft.requestor && document.querySelector('input[name="Requestor"]')) document.querySelector('input[name="Requestor"]').value = draft.requestor;
                        if (draft.purpose && document.querySelector('input[name="Purpose"]')) document.querySelector('input[name="Purpose"]').value = draft.purpose;
                        if (draft.notes && document.querySelector('textarea[name="Notes"]')) document.querySelector('textarea[name="Notes"]').value = draft.notes;
                        if (draft.status && document.querySelector('select[name="Status"]')) document.querySelector('select[name="Status"]').value = draft.status;

                        if (draft.selectedPropertyIds && Array.isArray(draft.selectedPropertyIds) && draft.selectedPropertyIds.length > 0) {
                            if (TomSelectRefProperty) {
                                draft.selectedPropertyIds.forEach(id => TomSelectRefProperty.addItem(id));
                            }
                        }

                        if (draft.partitions && Array.isArray(draft.partitions) && draft.partitions.length > 0) {
                            generatedPartitions = draft.partitions;
                            
                            // 1. Check server TempData first (guaranteed even if sessionStorage had issues)
                            if (window.serverUpdatedPartition && window.serverUpdatedIdx >= 0 && generatedPartitions[window.serverUpdatedIdx]) {
                                Object.assign(generatedPartitions[window.serverUpdatedIdx], window.serverUpdatedPartition);
                                sessionStorage.removeItem('lastUpdatedPartition_' + window.serverUpdatedIdx);
                                draft.partitions = generatedPartitions;
                                sessionStorage.setItem('propertyAssessmentRequest_draft', JSON.stringify(draft));
                                toastr.success(`Partition ${generatedPartitions[window.serverUpdatedIdx].partitionIndex || (window.serverUpdatedIdx + 1)} appraisal updated!`);
                            }
                            // 2. Fallback to client-side sessionStorage
                            else if (typeof draft.editingIdx === 'number' && draft.editingIdx >= 0) {
                                const key = 'lastUpdatedPartition_' + draft.editingIdx;
                                const updatedRaw = sessionStorage.getItem(key);
                                if (updatedRaw) {
                                    try {
                                        const updated = JSON.parse(updatedRaw);
                                        if (generatedPartitions[draft.editingIdx]) {
                                            Object.assign(generatedPartitions[draft.editingIdx], updated);
                                        }
                                        sessionStorage.removeItem(key);
                                        draft.partitions = generatedPartitions;
                                        sessionStorage.setItem('propertyAssessmentRequest_draft', JSON.stringify(draft));
                                        toastr.success(`Partition ${generatedPartitions[draft.editingIdx].partitionIndex || (draft.editingIdx + 1)} appraisal updated!`);
                                    } catch (err) { }
                                }
                            }
                            renderPartitionsTable();
                        }
                    }
                }
            } catch (e) {
                console.error('Error restoring draft:', e);
            }

            document.addEventListener('input', function(e) {
                if (e.target && e.target.classList.contains('border-rose-500')) {
                    e.target.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                }
            });

            const modalKindSelect = document.getElementById('modalKind');
            if (modalKindSelect) {
                modalKindSelect.addEventListener('change', function() {
                    const bldgAlert = document.getElementById('modalBuildingAlert');
                    if (bldgAlert) {
                        if (this.value.toLowerCase() === 'building') {
                            bldgAlert.classList.remove('hidden');
                        } else {
                            bldgAlert.classList.add('hidden');
                        }
                    }
                });
            }
        });

        // -------------------------------------------------------------
        // Reference Properties Selection Handler
        // -------------------------------------------------------------
        function handleReferencePropertiesChange(values) {
            selectedPropertyIds = Array.isArray(values) ? values : (values ? [values] : []);
            
            const summaryContainer = document.getElementById('selectedPropertiesSummary');
            const summaryList = document.getElementById('selectedPropertiesList');
            const generatorCard = document.getElementById('partitionGeneratorCard');
            const radioGroup = document.getElementById('propertyRadioGroup');
            const countBadge = document.getElementById('selectedCountBadge');

            document.getElementById('SelectedRefPropertyIdsJson').value = JSON.stringify(selectedPropertyIds);
            document.getElementById('primaryRefPropertyId').value = selectedPropertyIds.length > 0 ? selectedPropertyIds[0] : '';

            if (selectedPropertyIds.length === 0) {
                summaryContainer.classList.add('hidden');
                generatorCard.classList.add('hidden');
                document.getElementById('prevTDNInput').value = '';
                document.getElementById('prevPINInput').value = '';
                document.getElementById('prevOwnerInput').value = '';
                document.getElementById('locationInput').value = '';
                return;
            }

            summaryContainer.classList.remove('hidden');
            generatorCard.classList.remove('hidden');
            countBadge.textContent = selectedPropertyIds.length;

            const refValSpan = document.getElementById('refPropertyValidation');
            if (refValSpan) refValSpan.textContent = '';
            const tsControl = document.querySelector('#refPropertySelect + .ts-wrapper .ts-control');
            if (tsControl) tsControl.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');

            // Render Selected Properties Cards
            let cardsHtml = '';
            const tdnList = [];
            const pinList = [];
            const ownerList = [];
            let primaryLocation = '';

            selectedPropertyIds.forEach((id, idx) => {
                const prop = referencePropertiesData[id];
                if (!prop) return;

                tdnList.push(prop.tdn);
                if (prop.pin) pinList.push(prop.pin);
                if (prop.owner) ownerList.push(prop.owner);
                if (!primaryLocation && prop.location) primaryLocation = prop.location;

                cardsHtml += `
                    <div class="p-3.5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-xs flex items-start justify-between gap-3 text-xs">
                        <div class="space-y-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="px-2 py-0.5 rounded-md font-bold text-[10px] bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300">
                                    Ref #${idx + 1}
                                </span>
                                <span class="font-bold text-slate-900 dark:text-white font-mono">${prop.tdn}</span>
                                <span class="text-[10px] text-slate-400 font-mono">(${prop.pin || 'No PIN'})</span>
                            </div>
                            <div class="font-bold text-slate-800 dark:text-stone-200 truncate">${prop.owner}</div>
                            <div class="text-[11px] text-slate-500 dark:text-stone-400">
                                ${prop.kind} &bull; ${prop.classification} &bull; <strong class="text-slate-700 dark:text-stone-300">${prop.area.toLocaleString()} sqm</strong> &bull; ₱${prop.marketValue.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                            </div>
                            <div class="text-[10px] text-slate-400 truncate">${prop.location}</div>
                        </div>
                        <button type="button" onclick="removeSelectedProperty('${id}')" class="p-1 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors" title="Remove reference property">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;
            });

            summaryList.innerHTML = cardsHtml;

            // Sync compatibility input fields
            document.getElementById('prevTDNInput').value = tdnList.join(', ');
            document.getElementById('prevPINInput').value = pinList.join(', ');
            document.getElementById('prevOwnerInput').value = ownerList.join(', ');
            if (primaryLocation) document.getElementById('locationInput').value = primaryLocation;

            // Auto-fill New Owner Name & Address from selected reference property to prevent owner being blank
            const newOwnerEl = document.getElementById('newOwnerNameInput');
            const ownerAddrEl = document.getElementById('ownerAddressInput');
            if (newOwnerEl) {
                const firstProp = selectedPropertyIds.length > 0 ? referencePropertiesData[selectedPropertyIds[0]] : null;
                const isAutoFilled = newOwnerEl.getAttribute('data-auto-filled') === 'true';
                if (firstProp && firstProp.owner && (!newOwnerEl.value.trim() || isAutoFilled)) {
                    newOwnerEl.value = firstProp.owner;
                    newOwnerEl.setAttribute('data-auto-filled', 'true');
                    newOwnerEl.dispatchEvent(new Event('input', { bubbles: true }));

                    if (ownerAddrEl && (!ownerAddrEl.value.trim() || ownerAddrEl.getAttribute('data-auto-filled') === 'true')) {
                        ownerAddrEl.value = firstProp.location || primaryLocation || '';
                        ownerAddrEl.setAttribute('data-auto-filled', 'true');
                        ownerAddrEl.dispatchEvent(new Event('input', { bubbles: true }));
                    }

                    // Also try to sync registered owner dropdown if matching option exists without opening dropdown
                    const regOwnerSelect = document.getElementById('registeredOwnerSelect');
                    if (regOwnerSelect && regOwnerSelect.tomselect && !isSyncingOwnerAndProperty) {
                        isSyncingOwnerAndProperty = true;
                        const ts = regOwnerSelect.tomselect;
                        for (const key in ts.options) {
                            const opt = ts.options[key];
                            if (opt && opt.text && opt.text.toLowerCase().includes(firstProp.owner.toLowerCase())) {
                                ts.setValue(key, true);
                                ts.close();
                                break;
                            }
                        }
                        isSyncingOwnerAndProperty = false;
                    }
                } else if (selectedPropertyIds.length === 0 && isAutoFilled) {
                    newOwnerEl.value = '';
                    newOwnerEl.removeAttribute('data-auto-filled');
                    newOwnerEl.dispatchEvent(new Event('input', { bubbles: true }));
                    if (ownerAddrEl && ownerAddrEl.getAttribute('data-auto-filled') === 'true') {
                        ownerAddrEl.value = '';
                        ownerAddrEl.removeAttribute('data-auto-filled');
                        ownerAddrEl.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                }
            }

            // Render Duplication Choice for Partitions
            renderDuplicateSourceOptions();
            lucide.createIcons();
        }

        function removeSelectedProperty(id) {
            if (TomSelectRefProperty) {
                TomSelectRefProperty.removeItem(id);
            }
        }

        // Render which property to duplicate from (allowing selection if 2 or more chosen)
        function renderDuplicateSourceOptions() {
            const radioGroup = document.getElementById('propertyRadioGroup');
            const dupSection = document.getElementById('duplicateSourceSelector');

            if (selectedPropertyIds.length === 0) {
                dupSection.classList.add('hidden');
                return;
            }

            dupSection.classList.remove('hidden');
            let radiosHtml = '';

            if (selectedPropertyIds.length === 1) {
                const prop = referencePropertiesData[selectedPropertyIds[0]];
                radiosHtml = `
                    <label class="flex items-center gap-2.5 p-3 rounded-xl bg-white dark:bg-stone-900 border-2 border-emerald-500 cursor-pointer text-xs">
                        <input type="radio" name="dupSourceChoice" value="${prop.id}" checked class="text-emerald-600 focus:ring-emerald-500" />
                        <div>
                            <span class="font-bold text-slate-900 dark:text-white font-mono">${prop.tdn}</span>
                            <span class="text-slate-500 dark:text-stone-400 block text-[11px]">${prop.owner} (${prop.kind} &bull; ${prop.area} sqm)</span>
                        </div>
                    </label>
                `;
            } else {
                // When 2 or more properties selected: allow user to choose which one to duplicate, or duplicate all
                selectedPropertyIds.forEach((id, idx) => {
                    const prop = referencePropertiesData[id];
                    if (!prop) return;
                    radiosHtml += `
                        <label class="flex items-center gap-2.5 p-3 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 hover:border-emerald-500 cursor-pointer text-xs transition-colors">
                            <input type="radio" name="dupSourceChoice" value="${prop.id}" ${idx === 0 ? 'checked' : ''} class="text-emerald-600 focus:ring-emerald-500" />
                            <div>
                                <span class="font-bold text-slate-900 dark:text-white font-mono">${prop.tdn}</span>
                                <span class="text-slate-500 dark:text-stone-400 block text-[11px]">${prop.owner} (${prop.kind} &bull; ${prop.area.toLocaleString()} sqm)</span>
                            </div>
                        </label>
                    `;
                });

                radiosHtml += `
                    <label class="flex items-center gap-2.5 p-3 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 hover:border-emerald-500 cursor-pointer text-xs transition-colors md:col-span-2">
                        <input type="radio" name="dupSourceChoice" value="ALL" class="text-emerald-600 focus:ring-emerald-500" />
                        <div>
                            <span class="font-bold text-emerald-700 dark:text-emerald-400">Duplicate All ${selectedPropertyIds.length} Reference Properties</span>
                            <span class="text-slate-500 dark:text-stone-400 block text-[11px]">Generate partition lots cloned across all chosen reference parcels</span>
                        </div>
                    </label>
                `;
            }

            radioGroup.innerHTML = radiosHtml;
        }

        // -------------------------------------------------------------
        // Partition Generation Engine
        // -------------------------------------------------------------
        function handleGeneratePartitions() {
            if (selectedPropertyIds.length === 0) {
                toastr.warning('Please choose at least one Reference Property first.');
                return;
            }

            const chosenRadio = document.querySelector('input[name="dupSourceChoice"]:checked');
            const chosenValue = chosenRadio ? chosenRadio.value : selectedPropertyIds[0];
            const countInput = document.getElementById('genPartitionCountInput');
            const count = Math.max(1, Math.min(26, parseInt(countInput ? countInput.value : 2) || 2));
            const newOwner = (document.querySelector('input[name="NewOwnerName"]').value || '').trim();
            const txCode = document.getElementById('txCodeSelect') ? document.getElementById('txCodeSelect').value : "SD";
            const reqKindEl = document.querySelector('select[name="Kind"]');
            const reqKind = reqKindEl && reqKindEl.value ? reqKindEl.value : null;

            generatedPartitions = [];

            if (chosenValue === "ALL") {
                // Generate partitions from all selected properties
                let globalIdx = 0;
                selectedPropertyIds.forEach((propId) => {
                    const baseProp = referencePropertiesData[propId];
                    if (!baseProp) return;
                    for (let i = 0; i < count; i++) {
                        const letterSuffix = alphabetLetters[globalIdx % alphabetLetters.length];
                        const dividedArea = Math.round((baseProp.area / count) * 100) / 100;
                        const marketVal = Math.round((dividedArea * baseProp.unitValue) * 100) / 100;
                        const assessedVal = Math.round((marketVal * (baseProp.assessLevel / 100)) * 100) / 100;
                        const lotText = `Lot ${(globalIdx + 1)}-${letterSuffix}`;
                        const arpCombined = formatCastArpNumber(baseProp.barangay, '001', `${globalIdx + 1}`);
                        const effKind = (reqKind === 'Machinery' || reqKind === 'Building') ? reqKind : baseProp.kind;

                        generatedPartitions.push({
                            partitionIndex: letterSuffix,
                            baseTDN: baseProp.tdn,
                            basePropertyId: baseProp.id,
                            systemGeneratedTDN: generateSystemTDN(letterSuffix, baseProp.barangay, globalIdx + 1),
                            arpNo: arpCombined,
                            sectionNo: '001',
                            pin: baseProp.pin ? `${baseProp.pin}-${letterSuffix}` : arpCombined,
                            lotNumber: lotText,
                            kind: effKind,
                            classification: baseProp.classification,
                            areaSqMeters: dividedArea,
                            unitValue: baseProp.unitValue,
                            marketValue: marketVal,
                            assessmentLevelPercent: baseProp.assessLevel,
                            assessedValue: assessedVal,
                            newOwnerName: newOwner || baseProp.owner,
                            districtOrBarangay: baseProp.barangay,
                            propertyLocation: (document.getElementById('locationInput') ? document.getElementById('locationInput').value : '') || baseProp.location || baseProp.barangay || '',
                            customOwner: false,
                            customLocation: false
                        });
                        globalIdx++;
                    }
                });
            } else {
                // Generate partitions from the single chosen reference property
                const baseProp = referencePropertiesData[chosenValue];
                if (!baseProp) return;

                for (let i = 0; i < count; i++) {
                    const letterSuffix = alphabetLetters[i % alphabetLetters.length];
                    const dividedArea = Math.round((baseProp.area / count) * 100) / 100;
                    const marketVal = Math.round((dividedArea * baseProp.unitValue) * 100) / 100;
                    const assessedVal = Math.round((marketVal * (baseProp.assessLevel / 100)) * 100) / 100;
                    const lotText = `Lot ${i + 1}-${letterSuffix}`;
                    const arpCombined = formatCastArpNumber(baseProp.barangay, '001', `${i + 1}`);
                    const effKind = (reqKind === 'Machinery' || reqKind === 'Building') ? reqKind : baseProp.kind;

                    generatedPartitions.push({
                        partitionIndex: letterSuffix,
                        baseTDN: baseProp.tdn,
                        basePropertyId: baseProp.id,
                        systemGeneratedTDN: generateSystemTDN(letterSuffix, baseProp.barangay, i + 1),
                        arpNo: arpCombined,
                        sectionNo: '001',
                        pin: baseProp.pin ? `${baseProp.pin}-${letterSuffix}` : arpCombined,
                        lotNumber: lotText,
                        kind: effKind,
                        classification: baseProp.classification,
                        areaSqMeters: dividedArea,
                        unitValue: baseProp.unitValue,
                        marketValue: marketVal,
                        assessmentLevelPercent: baseProp.assessLevel,
                        assessedValue: assessedVal,
                        newOwnerName: newOwner || baseProp.owner,
                        districtOrBarangay: baseProp.barangay,
                        propertyLocation: (document.getElementById('locationInput') ? document.getElementById('locationInput').value : '') || baseProp.location || baseProp.barangay || '',
                        customOwner: false,
                        customLocation: false
                    });
                }
            }

            renderPartitionsTable();
            toastr.success(`Generated ${generatedPartitions.length} partition lots with CAST TDN & ARP combinations!`);
        }

        function resolveCastBrgyCode(brgyVal, defaultCode = '0001') {
            if (!brgyVal) return defaultCode;
            const raw = String(brgyVal).trim();
            if (/^\d+$/.test(raw)) return raw.slice(-4).padStart(4, '0');
            const u = raw.toUpperCase();
            const map = [
                ['DADIANGAS EAST', '0001'], ['CENTRAL', '0001'], ['POBLACION', '0001'], ['ZONE 1', '0001'],
                ['LAGAO', '0002'], ['MORALES', '0002'], ['CALUMPANG', '0003'], ['SAN ISIDRO', '0004'],
                ['CITY HEIGHTS', '0005'], ['DADIANGAS NORTH', '0006'], ['DADIANGAS SOUTH', '0007'],
                ['DADIANGAS WEST', '0008'], ['LABANGAL', '0009'], ['APOPONG', '0010'], ['BALUAN', '0011'],
                ['BATOMELONG', '0012'], ['BUAYAN', '0013'], ['BULA', '0014'], ['CONEL', '0015'],
                ['FATIMA', '0016'], ['KATANGAWAN', '0017'], ['LIGAYA', '0018'], ['MABUHAY', '0019'],
                ['OLYMPOG', '0020'], ['SAN JOSE', '0021'], ['SIGUEL', '0022'], ['SINAWAL', '0023'],
                ['TAMBLER', '0024'], ['TINAGACAN', '0025'], ['UPPER LABAY', '0026'], ['SALITRAN', '0027']
            ];
            for (const [k, c] of map) {
                if (u.includes(k)) return c;
            }
            const digits = raw.replace(/\D/g, '');
            if (digits) return digits.slice(-4).padStart(4, '0');
            return defaultCode;
        }

        function formatThreeDigitPart(val) {
            if (!val) return '000';
            const m = String(val).match(/\d+/);
            if (m) return m[0].slice(-3).padStart(3, '0');
            return String(val).replace(/[^a-zA-Z0-9]/g, '').slice(0, 3).toUpperCase().padStart(3, '0') || '000';
        }

        // CAST Combination #1: {LGUCode}-{DistrictMunicipalityCode}-{BarangayCode:D4}-{SectionNo:D3}-{LotOrParcelNo:D3}
        function formatCastArpNumber(brgyVal, sectionNo, lotOrParcelNo, lgu = '187', mun = '00') {
            const brgy4 = resolveCastBrgyCode(brgyVal, '0000');
            const sec3 = formatThreeDigitPart(sectionNo);
            const lot3 = formatThreeDigitPart(lotOrParcelNo);
            return `${String(lgu).padStart(3, '0')}-${String(mun).padStart(2, '0')}-${brgy4}-${sec3}-${lot3}`;
        }

        // CAST Combination #2: {RevisionYearLastTwoDigits:D2}-{BarangayCode:D4}-{DeclarationNo:D5}
        function generateSystemTDN(letterSuffix, brgyVal, seqIndex) {
            const revYearLastTwo = String(new Date().getFullYear() % 100).padStart(2, '0');
            const brgy4 = resolveCastBrgyCode(brgyVal, '0001');
            const baseCount = Object.keys(referencePropertiesData || {}).length;
            const seqNum = typeof seqIndex === 'number' && seqIndex > 0
                ? (baseCount + seqIndex)
                : (baseCount + (generatedPartitions ? generatedPartitions.length + 1 : 1));
            const declNo5 = String(seqNum).padStart(5, '0');
            return `${revYearLastTwo}-${brgy4}-${declNo5}`;
        }

