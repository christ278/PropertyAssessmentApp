                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 font-bold font-mono text-xs shrink-0" title="Partition Lot ${p.partitionIndex}">
                                    ${p.partitionIndex}
