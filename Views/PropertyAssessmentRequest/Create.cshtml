        function attachRowEvents(row) {
            const sel = row.querySelector('.particular-select');
            const qty = row.querySelector('.qty-input');
            const btnRemove = row.querySelector('.btn-remove');

            sel.addEventListener('change', function () {
                const idx = this.value;
                const feeCell = row.querySelector('.fee-amount');
                if (idx !== "") {
                    const fee = availableParticulars[idx].fee;
                    feeCell.textContent = fee.toFixed(2);
                } else {
                    feeCell.textContent = "0.00";
                }
                updateLineTotal(row);
            });

            qty.addEventListener('input', function () {
                updateLineTotal(row);
            });

            btnRemove.addEventListener('click', function () {
                const tbody = document.getElementById('feesTableBody');
                if (tbody.rows.length > 1) {
                    row.remove();
                    recalculateGrandTotal();
                } else {
                    alert("At least one fee row is required.");
                }
            });
        }

        function updateLineTotal(row) {
            const fee = parseFloat(row.querySelector('.fee-amount').textContent) || 0;
            const qty = parseInt(row.querySelector('.qty-input').value) || 0;
            const lineTotal = fee * qty;
            row.querySelector('.line-total').textContent = lineTotal.toFixed(2);
            recalculateGrandTotal();
        }

        function recalculateGrandTotal() {
            let grandTotal = 0;
            const rows = document.querySelectorAll('#feesTableBody tr');
            const items = [];

            rows.forEach(r => {
                const sel = r.querySelector('.particular-select');
                const idx = sel.value;
                const qty = parseInt(r.querySelector('.qty-input').value) || 0;
                const fee = parseFloat(r.querySelector('.fee-amount').textContent) || 0;
                const total = fee * qty;

                if (idx !== "" && availableParticulars[idx]) {
                    grandTotal += total;
                    const pCode = availableParticulars[idx].code;
                    const pName = availableParticulars[idx].name;
                    items.push({
                        particularCode: pCode,
                        particularName: pName,
                        unitCost: fee,
                        quantity: qty,
                        totalCost: total,
                        ParticularCode: pCode,
                        ParticularName: pName,
                        UnitCost: fee,
                        Quantity: qty,
                        TotalCost: total
                    });
                }
            });

            document.getElementById('lblOverallTotal').textContent = grandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('TotalFeesAmount').value = grandTotal.toFixed(2);
            document.getElementById('RequestedDocumentsJson').value = JSON.stringify(items);
        }


    </script>
}
