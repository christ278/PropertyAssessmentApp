@model PropertyAssessmentApp.Models.LandHoldingRequest
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = $"Edit Land Holding Request - {Model.TrackingNumber}";
    var owners = ViewBag.Owners as IEnumerable<Owner> ?? new List<Owner>();
    var orderPayments = ViewBag.OrderPayments as IEnumerable<OrderPayment> ?? new List<OrderPayment>();
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="edit-3" class="w-4 h-4"></i>
                <span>Update Certificate Request</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Edit @Model.TrackingNumber</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Update property landholdings verification status, requirements, and fees.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" id="landHoldingEditForm" class="space-y-8">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TrackingNumber" />
            <input type="hidden" asp-for="RequestedDocumentsJson" id="RequestedDocumentsJson" />
            <input type="hidden" asp-for="SelectedPropertiesJson" id="SelectedPropertiesJson" />
            <input type="hidden" asp-for="TotalFeesAmount" id="TotalFeesAmount" />
            <input type="hidden" asp-for="TaxDeclarationNumber" id="selectedTdnsInput" />
            <input type="hidden" asp-for="PropertyIndexNumber" id="selectedPinsInput" />
            <input type="hidden" asp-for="Status" />
            @if (ViewBag.ClaimedWarning != null)
            {
                <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-500/20 border border-rose-300 dark:border-rose-500/40 text-rose-800 dark:text-rose-200 font-bold flex items-center gap-2.5">
                    <i data-lucide="lock" class="w-4 h-4 shrink-0 text-rose-600 dark:text-rose-400"></i>
                    <span>@ViewBag.ClaimedWarning</span>
                </div>
            }
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-800 dark:text-rose-300"></div>

            <!-- Step 1: Owner Search & Selection -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-3 flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="search" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                            1. Select Registered Owner (Auto-Fill Fields)
                        </h3>
                        <p class="text-slate-500 dark:text-stone-400 text-[11px] mt-0.5">Search owner from the Taxpayer / Owner Directory to auto-populate form details.</p>
                    </div>
                </div>

                <div>
                    <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">
                        SEARCH & SELECT OWNER <span class="text-rose-600 dark:text-rose-500 font-bold">*</span>
                    </label>
                    <select id="ownerSelect" class="w-full">
                        <option value="">-- Choose Owner from Taxpayer Directory --</option>
                        @foreach (var o in owners)
                        {
                            <option value="@o.Id">@o.DisplayName@(string.IsNullOrWhiteSpace(o.TaxIdentNo) ? "" : $" (TIN: {o.TaxIdentNo})")</option>
                        }
                    </select>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                    <div>
                        <label asp-for="OwnerName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">
                            OWNER NAME <span class="text-rose-600 dark:text-rose-500 font-bold">*</span>
                        </label>
                        <input asp-for="OwnerName" id="ownerNameInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" placeholder="Owner / Taxpayer Name" />
                        <span asp-validation-for="OwnerName" class="text-rose-500 font-bold text-[11px] mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SpouseName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">SPOUSE NAME</label>
                        <input asp-for="SpouseName" id="spouseNameInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" placeholder="Spouse Full Name" />
                    </div>
                    <div>
                        <label asp-for="ContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CONTACT NO.</label>
                        <input asp-for="ContactNo" id="contactNoInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" placeholder="0917-000-0000" />
                    </div>
                </div>

                <div>
                    <label asp-for="PropertyLocation" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">LOCATION OF PROPERTY</label>
                    <input asp-for="PropertyLocation" id="locationInput" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" placeholder="Street, Barangay, City, Province" />
                </div>

                <!-- Owner's Registered Properties Table -->
                <div class="pt-3 space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-slate-600 dark:text-stone-400 font-bold uppercase flex items-center gap-1.5">
                            <i data-lucide="building-2" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                            Registered Properties / Tax Declarations
                        </label>
                        <span id="ownerPropertiesCount" class="px-2.5 py-0.5 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 font-bold text-[11px]">
                            0 properties
                        </span>
                    </div>
                    <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-stone-800 bg-white dark:bg-stone-900">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-100 dark:bg-stone-950 border-b border-slate-200 dark:border-stone-800 text-slate-500 dark:text-stone-400 uppercase text-[11px]">
                                    <th class="px-3 py-2.5 font-bold">TDN No.</th>
                                    <th class="px-3 py-2.5 font-bold">PIN</th>
                                    <th class="px-3 py-2.5 font-bold">Kind / Class</th>
                                    <th class="px-3 py-2.5 font-bold">Location</th>
                                    <th class="px-3 py-2.5 font-bold text-right">Market Value</th>
                                    <th class="px-3 py-2.5 font-bold text-right">Assessed Value</th>
                                    <th class="px-3 py-2.5 font-bold text-center w-16">Action</th>
                                </tr>
                            </thead>
                            <tbody id="ownerPropertiesTableBody" class="divide-y divide-slate-200 dark:divide-stone-800">
                                <tr id="ownerPropertiesEmptyRow">
                                    <td colspan="7" class="px-4 py-6 text-center text-slate-400 dark:text-stone-500 italic">
                                        Select an owner above to load their registered properties / tax declarations.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Step 2: General Information & Official Receipt Details -->
            <div class="space-y-4">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="receipt" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        2. General Information & Official Receipt Details
                    </h3>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label asp-for="RequesterName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REQUESTER NAME</label>
                        <input asp-for="RequesterName" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" />
                    </div>
                    <div>
                        <label asp-for="ORNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">
                            O.R. NO. <span class="text-rose-600 dark:text-rose-500 font-bold">*</span>
                        </label>
                        <input asp-for="ORNumber" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" />
                        <span asp-validation-for="ORNumber" class="text-rose-500 font-bold text-[11px] mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="ORDateIssued" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">DATE ISSUED</label>
                        <input asp-for="ORDateIssued" type="date" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" />
                    </div>
                    <div>
                        <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">REPLACE ATTACHMENT</label>
                        <input type="file" name="fileUpload" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-mono file:font-bold file:bg-emerald-600 file:text-white" />
                    </div>
                </div>

                <div>
                    <label asp-for="Purposes" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">
                        PURPOSE/S <span class="text-rose-600 dark:text-rose-500 font-bold">*</span>
                    </label>
                    <input asp-for="Purposes" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" />
                    <span asp-validation-for="Purposes" class="text-rose-500 font-bold text-[11px] mt-1 block"></span>
                </div>
            </div>

            <!-- Step 3: Requirements Submitted -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="check-square" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        3. Requirements Submitted
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="ReqIdOfOwner" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">ID OF OWNER</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="ReqIdOfRepresentative" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">ID OF REPRESENTATIVE</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="ReqAuthorizationLetter" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">AUTHORIZATION LETTER / SPA</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="ReqDeedOfConveyance" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">DEED OF CONVEYANCE</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="ReqCertIndigency" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CERTIFICATE OF INDIGENCY</span>
                    </label>
                </div>
            </div>

            <!-- Step 4: Request Certificate Option/s -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="file-check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        4. * Request Certificate Option/s
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-3">
                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="CertTotalLandholdings" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CERTIFICATE OF TOTAL LANDHOLDINGS</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="CertTypeTaxDeclaration" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CERTIFICATION TYPE OF TAX DECLARATION</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="CertAggregateAgriLandholdings" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CERTIFICATE OF AGGREGATE AGRICULTURAL LANDHOLDINGS</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="CertNoImprovementFromDeath" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CERTIFICATION W/ NO IMPROVEMENT (FROM TIME OF DEATH)</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="CertNoLandholdings" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">CERTIFICATE OF NO LANDHOLDINGS</span>
                    </label>

                    <label class="flex items-center gap-3 p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 cursor-pointer hover:border-emerald-600 transition-colors">
                        <input type="checkbox" asp-for="CertPropertyHistory" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 dark:border-stone-700 dark:bg-stone-950" />
                        <span class="font-bold text-slate-800 dark:text-stone-200 uppercase">PROPERTY HISTORY</span>
                    </label>
                </div>

                <div class="pt-2">
                    <label asp-for="CertOthersSpecify" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold uppercase">OTHERS (SPECIFY)</label>
                    <input asp-for="CertOthersSpecify" class="w-full px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold focus:outline-none focus:border-emerald-600" />
                </div>
            </div>

            <!-- Step 5: Document To Be Requested Table (Order of Payment Rates) -->
            <div class="space-y-4 p-6 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2 flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                            <i data-lucide="calculator" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                            5. Document To Be Requested Table (Order of Payment Rates)
                        </h3>
                        <p class="text-slate-500 dark:text-stone-400 text-[11px] mt-0.5">Select particulars and number of copies to compute exact billing amount.</p>
                    </div>

                    <button type="button" id="btnAddRow" class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center gap-1.5 text-xs font-mono shadow-sm">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        Add Document Row
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[500px] text-left text-xs font-mono" id="feesTable">
                        <thead class="bg-slate-200/60 dark:bg-stone-900 text-slate-700 dark:text-stone-300 font-bold border-b border-slate-300 dark:border-stone-800">
                            <tr>
                                <th class="px-3 py-2.5 w-12 text-center">ACTION</th>
                                <th class="px-3 py-2.5">PARTICULARS</th>
                                <th class="px-3 py-2.5 w-32 text-right">FEES (₱)</th>
                                <th class="px-3 py-2.5 w-32 text-center">NO. OF PIECES</th>
                                <th class="px-3 py-2.5 w-36 text-right">TOTAL (₱)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-stone-800" id="feesTableBody">
                            <!-- Dynamic rows appended via Javascript -->
                        </tbody>
                    </table>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-stone-800">
                    <span class="text-sm font-extrabold text-slate-900 dark:text-white uppercase font-mono">Overall Total Amount:</span>
                    <div class="text-xl font-black font-mono text-emerald-700 dark:text-emerald-400 bg-white dark:bg-stone-900 px-6 py-2 rounded-xl border border-slate-200 dark:border-stone-800 shadow-sm">
                        ₱ <span id="lblOverallTotal">@Model.TotalFeesAmount.ToString("0.00")</span>
                    </div>
                </div>
            </div>

            <!-- Submit Button Footer -->
            <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-3 sm:gap-4 pt-4 border-t border-slate-200 dark:border-stone-800">
                <a asp-action="Index" class="w-full sm:w-auto text-center px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-all">
                    Cancel
                </a>
                <button type="submit" class="w-full sm:w-auto px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-all">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const availableParticulars = [
            @foreach (var op in orderPayments)
            {
                @: { code: "@op.Code", name: "@op.Particular", fee: @op.UnitCost },
            }
        ];

        const savedOwnerProperties = @Html.Raw(string.IsNullOrWhiteSpace(Model.SelectedPropertiesJson) ? "[]" : Model.SelectedPropertiesJson);
        const savedRequestedDocs = @Html.Raw(string.IsNullOrWhiteSpace(Model.RequestedDocumentsJson) ? "[]" : Model.RequestedDocumentsJson);

        let TomSelectOwner = null;

        document.addEventListener('DOMContentLoaded', function () {
            @if (ViewBag.ClaimedWarning != null)
            {
                @: if (typeof toastr !== 'undefined') toastr.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.ClaimedWarning)), 'Transaction Locked');
            }
            if (document.getElementById('ownerSelect')) {
                TomSelectOwner = new TomSelect('#ownerSelect', {
                    create: false,
                    placeholder: 'Search owner by Name or TIN...',
                    onChange: function(val) {
                        if (val) {
                            fetchOwnerDetails(val);
                        }
                    }
                });
            }

            if (Array.isArray(savedOwnerProperties) && savedOwnerProperties.length > 0) {
                renderOwnerProperties(savedOwnerProperties);
            }

            if (Array.isArray(savedRequestedDocs) && savedRequestedDocs.length > 0) {
                savedRequestedDocs.forEach(doc => addRow(doc));
            } else {
                addRow();
            }

            document.getElementById('btnAddRow').addEventListener('click', function () {
                addRow();
            });

            var form = document.getElementById('landHoldingEditForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var isValid = true;
                    var firstInvalid = null;

                    document.querySelectorAll('.border-rose-500').forEach(function(el) {
                        el.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                    });

                    var reqFields = [
                        { el: document.getElementById('ownerNameInput'), name: 'Owner / Taxpayer Name' },
                        { el: document.querySelector('input[name="ORNumber"]'), name: 'Official Receipt (O.R.) Number' },
                        { el: document.querySelector('input[name="Purposes"]'), name: 'Purpose/s' }
                    ];

                    reqFields.forEach(function (f) {
                        if (f.el && (!f.el.value || !f.el.value.trim())) {
                            isValid = false;
                            f.el.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/30');
                            if (!firstInvalid) firstInvalid = f.el;
                        }
                    });

                    var feesAmount = parseFloat(document.getElementById('TotalFeesAmount').value) || 0;
                    var docJson = document.getElementById('RequestedDocumentsJson').value;
                    var hasDocItems = false;
                    try {
                        var parsed = JSON.parse(docJson || '[]');
                        hasDocItems = parsed && parsed.length > 0;
                    } catch (ex) {
                        hasDocItems = false;
                    }

                    var feesTable = document.getElementById('feesTable');
                    if (!hasDocItems || feesAmount <= 0) {
                        isValid = false;
                        if (feesTable) feesTable.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/30');
                        if (!firstInvalid) firstInvalid = document.getElementById('btnAddRow');
                    } else if (feesTable) {
                        feesTable.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                    }

                    if (!isValid) {
                        e.preventDefault();
                        if (firstInvalid) {
                            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstInvalid.focus();
                        }
                        toastr.warning('Please fill in all required fields marked with * and select at least one document fee.', 'Validation Notice');
                        return false;
                    }
                });
            }

            document.addEventListener('input', function(e) {
                if (e.target && e.target.classList.contains('border-rose-500')) {
                    e.target.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/30');
                }
            });
        });

        function fetchOwnerDetails(ownerId) {
            fetch(`/LandHoldingRequest/GetOwnerDetails/${ownerId}`)
                .then(res => res.json())
                .then(data => {
                    if (data) {
                        if (data.ownerName !== undefined) document.getElementById('ownerNameInput').value = data.ownerName;
                        if (data.spouseName !== undefined) document.getElementById('spouseNameInput').value = data.spouseName;
                        if (data.contactNo !== undefined) document.getElementById('contactNoInput').value = data.contactNo;
                        if (data.propertyLocation !== undefined) document.getElementById('locationInput').value = data.propertyLocation;
                        renderOwnerProperties(data.properties || []);
                    }
                })
                .catch(err => console.error('Error fetching owner details:', err));
        }

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatCurrency(val) {
            const num = parseFloat(val) || 0;
            return '₱' + num.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function renderOwnerProperties(properties) {
            const tbody = document.getElementById('ownerPropertiesTableBody');
            if (!tbody) return;

            tbody.innerHTML = '';

            if (!properties || properties.length === 0) {
                tbody.innerHTML = `
                    <tr id="ownerPropertiesEmptyRow">
                        <td colspan="7" class="px-4 py-6 text-center text-slate-400 dark:text-stone-500 italic">
                            No active Tax Declarations found for this owner.
                        </td>
                    </tr>`;
                syncOwnerPropertySummary();
                return;
            }

            properties.forEach((p, idx) => {
                const rowId = 'prop_row_' + idx + '_' + Date.now();
                const tr = document.createElement('tr');
                tr.id = rowId;
                tr.className = 'owner-property-row hover:bg-slate-50 dark:hover:bg-stone-800/50 transition-colors';
                tr.setAttribute('data-tdn', p.taxDeclarationNumber || '');
                tr.setAttribute('data-pin', p.propertyIndexNumber || '');
                tr.setAttribute('data-prop', JSON.stringify(p));
                tr.innerHTML = `
                    <td class="px-3 py-2.5 font-mono font-bold text-slate-900 dark:text-white">${escapeHtml(p.taxDeclarationNumber || 'N/A')}</td>
                    <td class="px-3 py-2.5 font-mono text-slate-600 dark:text-stone-300">${escapeHtml(p.propertyIndexNumber || 'N/A')}</td>
                    <td class="px-3 py-2.5">
                        <span class="font-bold text-slate-800 dark:text-stone-200">${escapeHtml(p.kind || '')}</span>
                        <span class="block text-[10px] text-slate-500 dark:text-stone-400">${escapeHtml(p.classification || '')}</span>
                    </td>
                    <td class="px-3 py-2.5 text-slate-700 dark:text-stone-300">${escapeHtml(p.location || 'N/A')}</td>
                    <td class="px-3 py-2.5 text-right font-mono font-bold text-slate-800 dark:text-stone-200">${formatCurrency(p.marketValue)}</td>
                    <td class="px-3 py-2.5 text-right font-mono font-bold text-emerald-700 dark:text-emerald-400">${formatCurrency(p.assessedValue)}</td>
                    <td class="px-3 py-2.5 text-center">
                        <button type="button" onclick="removeOwnerPropertyRow('${rowId}')" class="p-1.5 rounded-lg text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-500/20 transition-colors" title="Remove Property Row">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            if (window.lucide) lucide.createIcons();
            syncOwnerPropertySummary();
        }

        function removeOwnerPropertyRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
            }

            const tbody = document.getElementById('ownerPropertiesTableBody');
            if (tbody && tbody.querySelectorAll('.owner-property-row').length === 0) {
                tbody.innerHTML = `
                    <tr id="ownerPropertiesEmptyRow">
                        <td colspan="7" class="px-4 py-6 text-center text-slate-400 dark:text-stone-500 italic">
                            All property rows removed.
                        </td>
                    </tr>`;
            }

            syncOwnerPropertySummary();
        }

        function syncOwnerPropertySummary() {
            const rows = document.querySelectorAll('#ownerPropertiesTableBody .owner-property-row');
            const countEl = document.getElementById('ownerPropertiesCount');
            if (countEl) {
                countEl.innerText = rows.length === 1 ? '1 property' : `${rows.length} properties`;
            }

            const tdns = [];
            const pins = [];
            const selectedProps = [];
            rows.forEach(r => {
                const tdn = r.getAttribute('data-tdn');
                const pin = r.getAttribute('data-pin');
                const propRaw = r.getAttribute('data-prop');
                if (tdn) tdns.push(tdn);
                if (pin) pins.push(pin);
                if (propRaw) {
                    try {
                        selectedProps.push(JSON.parse(propRaw));
                    } catch (e) { }
                }
            });

            const tdnsInput = document.getElementById('selectedTdnsInput');
            const pinsInput = document.getElementById('selectedPinsInput');
            const propsJsonInput = document.getElementById('SelectedPropertiesJson');
            if (tdnsInput) tdnsInput.value = tdns.join(', ');
            if (pinsInput) pinsInput.value = pins.join(', ');
            if (propsJsonInput) propsJsonInput.value = JSON.stringify(selectedProps);
        }

        function addRow(savedItem) {
            const tbody = document.getElementById('feesTableBody');
            const rowId = 'row_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4);

            let optionsHtml = '<option value="">-- Select Particular --</option>';
            availableParticulars.forEach(p => {
                const selected = savedItem && savedItem.code === p.code ? 'selected' : '';
                optionsHtml += `<option value="${p.code}" data-fee="${p.fee}" ${selected}>${p.name} (₱${p.fee.toFixed(2)})</option>`;
            });

            const feeVal = savedItem && savedItem.unitCost !== undefined ? parseFloat(savedItem.unitCost).toFixed(2) : '0.00';
            const qtyVal = savedItem && savedItem.quantity ? parseInt(savedItem.quantity) : 1;

            const tr = document.createElement('tr');
            tr.id = rowId;
            tr.className = 'hover:bg-slate-100/50 dark:hover:bg-stone-900/50 transition-colors';
            tr.innerHTML = `
                <td class="px-3 py-2 text-center">
                    <button type="button" onclick="removeRow('${rowId}')" class="p-1.5 rounded-lg text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-500/20 transition-colors" title="Delete Row">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </td>
                <td class="px-3 py-2">
                    <select class="particular-select w-full bg-white dark:bg-stone-900 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" onchange="onParticularChange('${rowId}')">
                        ${optionsHtml}
                    </select>
                </td>
                <td class="px-3 py-2">
                    <input type="number" step="0.01" class="fee-input w-full bg-slate-100 dark:bg-stone-950 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-800 text-right font-bold text-slate-900 dark:text-white" value="${feeVal}" readonly />
                </td>
                <td class="px-3 py-2">
                    <input type="number" min="1" class="qty-input w-full bg-white dark:bg-stone-900 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-800 text-center font-bold text-slate-900 dark:text-white focus:outline-none focus:border-emerald-600" value="${qtyVal}" oninput="calculateTotals()" />
                </td>
                <td class="px-3 py-2">
                    <input type="number" step="0.01" class="row-total w-full bg-slate-100 dark:bg-stone-950 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-800 text-right font-black text-emerald-700 dark:text-emerald-400" value="0.00" readonly />
                </td>
            `;

            tbody.appendChild(tr);
            if (window.lucide) lucide.createIcons();
            calculateTotals();
        }

        function removeRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) {
                row.remove();
                calculateTotals();
            }
        }

        function onParticularChange(rowId) {
            const row = document.getElementById(rowId);
            if (!row) return;

            const select = row.querySelector('.particular-select');
            const feeInput = row.querySelector('.fee-input');
            const selectedOpt = select.options[select.selectedIndex];
            const fee = parseFloat(selectedOpt.getAttribute('data-fee') || 0);

            feeInput.value = fee.toFixed(2);
            calculateTotals();
        }

        function calculateTotals() {
            let overallTotal = 0;
            const items = [];

            const rows = document.querySelectorAll('#feesTableBody tr');
            rows.forEach(r => {
                const select = r.querySelector('.particular-select');
                const feeInput = r.querySelector('.fee-input');
                const qtyInput = r.querySelector('.qty-input');
                const totalInput = r.querySelector('.row-total');

                if (select && feeInput && qtyInput && totalInput) {
                    const code = select.value;
                    const text = select.options[select.selectedIndex]?.text || '';
                    const fee = parseFloat(feeInput.value || 0);
                    const qty = parseInt(qtyInput.value || 0);
                    const rowTotal = fee * qty;

                    totalInput.value = rowTotal.toFixed(2);
                    overallTotal += rowTotal;

                    if (code) {
                        items.push({
                            code: code,
                            particularsName: text.split(' (₱')[0],
                            unitCost: fee,
                            quantity: qty,
                            totalCost: rowTotal
                        });
                    }
                }
            });

            document.getElementById('lblOverallTotal').innerText = overallTotal.toFixed(2);
            document.getElementById('TotalFeesAmount').value = overallTotal.toFixed(2);
            document.getElementById('RequestedDocumentsJson').value = JSON.stringify(items);
        }
    </script>
}
