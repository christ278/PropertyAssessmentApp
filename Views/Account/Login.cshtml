@model PropertyAssessmentApp.Models.LoginViewModel

@{
    ViewData["Title"] = "System Login";
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - City Assessor Portal</title>
    
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <script src="~/lib/tailwindcss/tailwind.js" asp-append-version="true"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        emerald: { 50: '#ecfdf5', 100: '#d1fae5', 400: '#34d399', 500: '#10b981', 600: '#059669', 700: '#047857', 800: '#065f46', 900: '#064e3b', 950: '#022c22' },
                        till: { 800: '#1c1917', 900: '#0c0a09', 950: '#030202' }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        mono: ['JetBrains Mono', 'Consolas', 'monospace']
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/lib/fonts/poppins/poppins.css" asp-append-version="true" />
    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>

    <style>
        /* Cadastral / GIS Lot Grid Pattern Background */
        .gis-cadastral-grid {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(16, 185, 129, 0.07) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(16, 185, 129, 0.07) 1px, transparent 1px);
        }
        
        .gis-cadastral-dots {
            background-image: radial-gradient(rgba(16, 185, 129, 0.22) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        /* Ambient subtle pulse */
        @@keyframes pulseGlow {
            0%, 100% { opacity: 0.35; transform: scale(1); }
            50% { opacity: 0.55; transform: scale(1.08); }
        }

        .ambient-glow-1 {
            animation: pulseGlow 8s ease-in-out infinite;
        }

        .ambient-glow-2 {
            animation: pulseGlow 10s ease-in-out infinite 2s;
        }

        /* Glassmorphic border shimmer */
        .glass-card {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(3, 7, 18, 0.92) 100%);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }

        .glass-badge {
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.25);
            backdrop-filter: blur(8px);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8 relative overflow-x-hidden selection:bg-emerald-500 selection:text-slate-950">

    <!-- 1. CADASTRAL & TAX MAPPING BACKGROUND LAYER -->
    <div class="fixed inset-0 pointer-events-none z-0">
        <!-- Deep rich ambient gradient base -->
        <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-[#07131b] to-[#041d17]"></div>

        <!-- GIS Coordinate & Lot Grid -->
        <div class="absolute inset-0 gis-cadastral-grid opacity-70"></div>
        <div class="absolute inset-0 gis-cadastral-dots opacity-40"></div>

        <!-- Radial Ambient Glowing Orbs -->
        <div class="absolute -top-32 -left-32 w-[650px] h-[650px] bg-emerald-500/20 rounded-full blur-[140px] ambient-glow-1"></div>
        <div class="absolute -bottom-40 -right-40 w-[700px] h-[700px] bg-teal-500/15 rounded-full blur-[160px] ambient-glow-2"></div>
        <div class="absolute top-1/2 left-1/3 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-600/10 rounded-full blur-[130px]"></div>

        <!-- Decorative Cadastral Coordinate Markers -->
        <div class="hidden lg:block absolute top-12 left-12 font-mono text-[11px] text-emerald-400/40 tracking-wider">
            <span>LAT: 06°07'15" N</span> &bull; <span>LONG: 125°10'22" E</span> &bull; <span>ZONE 51P (WGS84)</span>
        </div>
        <div class="hidden lg:block absolute bottom-12 left-12 font-mono text-[11px] text-emerald-400/40 tracking-wider">
            <span>ASSESSOR CADASTRAL SURVEY # CAD-187</span> &bull; <span>SEC 012 &bull; BLK 005 &bull; LOT 001-098</span>
        </div>
        <div class="hidden lg:block absolute top-12 right-12 font-mono text-[11px] text-emerald-400/40 tracking-wider">
            <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> PORTAL ACTIVE &bull; R.A. 7160</span>
        </div>

        <!-- Geometric Cadastral Parcel Wireframe Overlay in Corner -->
        <svg class="absolute bottom-0 right-0 w-[600px] h-[600px] text-emerald-500/[0.04] pointer-events-none" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="50,150 180,90 280,140 220,280 90,260" stroke-dasharray="4 4" />
            <polygon points="180,90 320,60 380,180 280,140" />
            <polygon points="280,140 380,180 340,320 220,280" />
            <polygon points="90,260 220,280 180,370 40,320" stroke-dasharray="3 3" />
            <circle cx="180" cy="90" r="4" fill="currentColor" />
            <circle cx="280" cy="140" r="4" fill="currentColor" />
            <circle cx="220" cy="280" r="4" fill="currentColor" />
            <circle cx="90" cy="260" r="4" fill="currentColor" />
            <text x="145" y="195" font-size="10" font-family="monospace" fill="currentColor" letter-spacing="1">PARCEL 0012-A</text>
            <text x="250" y="210" font-size="10" font-family="monospace" fill="currentColor" letter-spacing="1">PARCEL 0012-B</text>
        </svg>
    </div>

    <!-- 2. MAIN MODERN LOGIN CONTAINER -->
    <div class="w-full max-w-5xl relative z-10 my-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 rounded-3xl overflow-hidden glass-card shadow-2xl backdrop-blur-2xl">
            
            <!-- LEFT PANEL: Real Property Tax & Assessment Brand Showcase (Desktop / Tablet) -->
            <div class="lg:col-span-6 p-8 sm:p-10 lg:p-12 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-white/10 bg-gradient-to-br from-emerald-950/40 via-slate-900/60 to-slate-950/80 relative">
                
                <!-- Background Accent Watermark -->
                <div class="absolute top-0 right-0 p-8 opacity-5 pointer-events-none select-none">
                    <svg class="w-64 h-64 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                        <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4" />
                    </svg>
                </div>

                <!-- Brand Header -->
                <div class="space-y-6 relative z-10">
                    <div class="flex items-center gap-3">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 p-0.5 shadow-lg shadow-emerald-500/25 flex items-center justify-center ring-4 ring-emerald-500/10">
                            <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center">
                                <i data-lucide="building-2" class="w-7 h-7 text-emerald-400"></i>
                            </div>
                        </div>
                        <div>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                                LGU Assessor Portal
                            </span>
                            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-0.5">FAIRTRACK</h1>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <h2 class="text-xl sm:text-2xl font-bold text-white leading-snug">
                            City Assessor Real Property Tax &amp; FAAS Assessment System
                        </h2>
                        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
                            Centralized statutory property appraisal, automated Tax Declaration indexing, GIS mapping lot partitions, and Local Government Code (R.A. 7160) revenue administration.
                        </p>
                    </div>

                    <!-- 3 Feature Pillars -->
                    <div class="space-y-3 pt-2">
                        <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-emerald-500/30 transition-all">
                            <div class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 mt-0.5">
                                <i data-lucide="layers" class="w-4 h-4"></i>
                            </div>
                            <div class="text-xs">
                                <span class="font-bold text-slate-200 block">FAAS Appraisal &amp; TD Lifecycle</span>
                                <span class="text-slate-400 text-[11px]">Land classification schedules, BUCC structural types, and Machinery valuation.</span>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-emerald-500/30 transition-all">
                            <div class="p-2 rounded-xl bg-teal-500/10 text-teal-400 mt-0.5">
                                <i data-lucide="map" class="w-4 h-4"></i>
                            </div>
                            <div class="text-xs">
                                <span class="font-bold text-slate-200 block">Cadastral GIS Tax Mapping</span>
                                <span class="text-slate-400 text-[11px]">Lot subdivisions, consolidations, Section/Block/Lot PIN indexing, and blueprint records.</span>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-emerald-500/30 transition-all">
                            <div class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 mt-0.5">
                                <i data-lucide="calculator" class="w-4 h-4"></i>
                            </div>
                            <div class="text-xs">
                                <span class="font-bold text-slate-200 block">Assessment Roll &amp; Tax Dues</span>
                                <span class="text-slate-400 text-[11px]">Statutory 20%–50% assessment levels, Basic RPT (2%), SEF (1%), and Official Receipts.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Status Tag -->
                <div class="pt-8 mt-6 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-slate-500">
                    <span class="flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
                        <span>R.A. 7160 Compliant Roll</span>
                    </span>
                    <span class="text-emerald-400/70 font-bold">Secured Assessor Access</span>
                </div>
            </div>

            <!-- RIGHT PANEL: Modern Authentication Form -->
            <div class="lg:col-span-6 p-8 sm:p-10 lg:p-12 flex flex-col justify-between bg-slate-900/60 backdrop-blur-xl">
                <div>
                    <!-- Form Title & Badge -->
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <span class="text-[11px] font-mono font-bold uppercase text-emerald-400 tracking-wider flex items-center gap-1.5">
                                <i data-lucide="key-round" class="w-3.5 h-3.5"></i>
                                Assessor Sign-In
                            </span>
                            <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mt-1">Account Authentication</h3>
                        </div>
                        <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                        </div>
                    </div>

                    <form id="loginForm" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="space-y-5" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-mono empty:hidden [&.validation-summary-valid]:hidden"></div>

                        <!-- Username Input -->
                        <div class="space-y-1.5">
                            <label asp-for="Username" class="block text-slate-300 font-bold text-xs font-mono uppercase tracking-wider">
                                Username / Assessor ID <span class="text-rose-400">*</span>
                            </label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 group-focus-within:text-emerald-400 transition-colors">
                                    <i data-lucide="user" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Username" id="inputUsername" class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-950/80 border border-slate-700/80 text-white font-mono text-xs sm:text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all shadow-inner" placeholder="e.g. admin or employee no." required autofocus />
                            </div>
                            <span asp-validation-for="Username" class="text-rose-400 text-xs font-mono mt-1 block"></span>
                        </div>

                        <!-- Password Input with Show/Hide Toggle -->
                        <div class="space-y-1.5">
                            <label asp-for="Password" class="block text-slate-300 font-bold text-xs font-mono uppercase tracking-wider">
                                Password <span class="text-rose-400">*</span>
                            </label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 group-focus-within:text-emerald-400 transition-colors">
                                    <i data-lucide="shield" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Password" type="password" id="inputPassword" class="w-full pl-10 pr-11 py-3 rounded-xl bg-slate-950/80 border border-slate-700/80 text-white font-mono text-xs sm:text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all shadow-inner" placeholder="••••••••••••" required />
                                <button type="button" id="togglePasswordBtn" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-emerald-400 transition-colors focus:outline-none" title="Toggle password visibility">
                                    <i data-lucide="eye" id="eyeIcon" class="w-4 h-4"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-rose-400 text-xs font-mono mt-1 block"></span>
                        </div>

                        <!-- Remember Me & System Environment Info -->
                        <div class="flex items-center justify-between text-xs font-mono pt-1">
                            <label class="flex items-center gap-2 cursor-pointer text-slate-300 hover:text-white transition-colors">
                                <input asp-for="RememberMe" class="w-4 h-4 rounded border-slate-700 bg-slate-950 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-slate-900 cursor-pointer" />
                                <span>Remember session</span>
                            </label>
                            <span class="text-slate-400 text-[11px]">Authorized personnel only</span>
                        </div>

                        <!-- Submit Button with Spinner -->
                        <button type="submit" id="submitBtn" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 hover:from-emerald-400 hover:via-teal-400 hover:to-emerald-500 text-slate-950 font-extrabold text-xs font-mono uppercase tracking-wider shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/35 transition-all flex items-center justify-center gap-2.5 active:scale-[0.99] disabled:opacity-70 disabled:cursor-not-allowed">
                            <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span id="btnText" class="flex items-center gap-1.5">
                                <span>Sign In to Portal</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </span>
                        </button>
                    </form>
                </div>

                <!-- Legal Notice / Security Badge -->
                <div class="pt-6 mt-6 border-t border-white/5 text-center text-slate-500 text-[11px] font-mono space-y-1">
                    <p class="flex items-center justify-center gap-1.5 text-slate-400">
                        <i data-lucide="lock" class="w-3 h-3 text-emerald-400/80"></i>
                        <span>City / Municipal Assessor Real Property Administration</span>
                    </p>
                    <p class="text-slate-600">&copy; @DateTime.Now.Year Local Government Unit. R.A. 7160 Compliant.</p>
                </div>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script>
        lucide.createIcons();

        // Password Show/Hide Toggle
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const inputPassword = document.getElementById('inputPassword');
        const eyeIcon = document.getElementById('eyeIcon');

        if (togglePasswordBtn && inputPassword) {
            togglePasswordBtn.addEventListener('click', function () {
                const isPassword = inputPassword.type === 'password';
                inputPassword.type = isPassword ? 'text' : 'password';
                
                // Update Lucide icon
                if (eyeIcon) {
                    eyeIcon.setAttribute('data-lucide', isPassword ? 'eye-off' : 'eye');
                    lucide.createIcons();
                }
            });
        }

        // Form submission with spinner state
        const loginForm = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnSpinner = document.getElementById('btnSpinner');
        const btnText = document.getElementById('btnText');
        let isSubmitting = false;

        if (loginForm && submitBtn) {
            loginForm.addEventListener('submit', function (e) {
                if (isSubmitting) {
                    e.preventDefault();
                    return false;
                }

                if (!loginForm.checkValidity()) {
                    return;
                }

                isSubmitting = true;
                if (btnSpinner) btnSpinner.classList.remove('hidden');
                if (btnText) btnText.innerHTML = '<span>Authenticating...</span>';

                submitBtn.classList.add('pointer-events-none');
                setTimeout(function () {
                    submitBtn.disabled = true;
                }, 0);
            });
        }
    </script>
</body>
</html>
