@model PropertyAssessmentApp.Models.LoginViewModel

@{
    ViewData["Title"] = "System Login";
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - City Assessor Portal</title>
    
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <script src="~/lib/tailwindcss/tailwind.js" asp-append-version="true"></script>
    <script>if (typeof tailwind === 'undefined') { document.write('<script src="https://cdn.tailwindcss.com"><\/script>'); }</script>
    <script>
        if (typeof tailwind !== 'undefined') { tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        emerald: { 50: '#ecfdf5', 100: '#d1fae5', 400: '#34d399', 500: '#10b981', 600: '#059669', 700: '#047857', 800: '#065f46', 900: '#064e3b', 950: '#022c22' },
                        till: { 800: '#1c1917', 900: '#0c0a09', 950: '#030202' }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        mono: ['JetBrains Mono', 'Consolas', 'monospace']
                    }
                }
            }
        } }
    </script>
    <link rel="stylesheet" href="~/lib/fonts/poppins/poppins.css" asp-append-version="true" />
    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>
    <script>if (typeof lucide === 'undefined') { document.write('<script src="https://unpkg.com/lucide@latest"><\/script>'); }</script>

    <style>
        /* Cadastral / GIS Lot Grid Pattern Background */
        .gis-cadastral-grid {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(16, 185, 129, 0.07) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(16, 185, 129, 0.07) 1px, transparent 1px);
        }
        
        .gis-cadastral-dots {
            background-image: radial-gradient(rgba(16, 185, 129, 0.22) 1px, transparent 1px);
            background-size: 20px 20px;
        }

        /* Ambient subtle pulse */
        @@keyframes pulseGlow {
            0%, 100% { opacity: 0.35; transform: scale(1); }
            50% { opacity: 0.55; transform: scale(1.08); }
        }

        .ambient-glow-1 {
            animation: pulseGlow 8s ease-in-out infinite;
        }

        .ambient-glow-2 {
            animation: pulseGlow 10s ease-in-out infinite 2s;
        }

        /* Glassmorphic border shimmer */
        .glass-card {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(3, 7, 18, 0.92) 100%);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }

        .glass-badge {
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.25);
            backdrop-filter: blur(8px);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8 relative overflow-x-hidden selection:bg-emerald-500 selection:text-slate-950">

    <!-- 1. CADASTRAL & TAX MAPPING BACKGROUND LAYER -->
    <div class="fixed inset-0 pointer-events-none z-0">
        <!-- Deep rich ambient gradient base -->
        <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-[#07131b] to-[#041d17]"></div>

        <!-- GIS Coordinate & Lot Grid -->
        <div class="absolute inset-0 gis-cadastral-grid opacity-70"></div>
        <div class="absolute inset-0 gis-cadastral-dots opacity-40"></div>

        <!-- Radial Ambient Glowing Orbs -->
        <div class="absolute -top-32 -left-32 w-[650px] h-[650px] bg-emerald-500/20 rounded-full blur-[140px] ambient-glow-1"></div>
        <div class="absolute -bottom-40 -right-40 w-[700px] h-[700px] bg-teal-500/15 rounded-full blur-[160px] ambient-glow-2"></div>
        <div class="absolute top-1/2 left-1/3 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-600/10 rounded-full blur-[130px]"></div>

        <!-- Decorative Cadastral Coordinate Markers -->
        <div class="hidden lg:block absolute top-12 left-12 font-mono text-[11px] text-emerald-400/40 tracking-wider">
            <span>LAT: 06°07'15" N</span> &bull; <span>LONG: 125°10'22" E</span> &bull; <span>ZONE 51P (WGS84)</span>
        </div>
        <div class="hidden lg:block absolute bottom-12 left-12 font-mono text-[11px] text-emerald-400/40 tracking-wider">
            <span>ASSESSOR CADASTRAL SURVEY # CAD-187</span> &bull; <span>SEC 012 &bull; BLK 005 &bull; LOT 001-098</span>
        </div>
        <div class="hidden lg:block absolute top-12 right-12 font-mono text-[11px] text-emerald-400/40 tracking-wider">
            <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> PORTAL ACTIVE &bull; R.A. 7160</span>
        </div>

        <!-- Geometric Cadastral Parcel Wireframe Overlay in Corner -->
        <svg class="absolute bottom-0 right-0 w-[600px] h-[600px] text-emerald-500/[0.04] pointer-events-none" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="50,150 180,90 280,140 220,280 90,260" stroke-dasharray="4 4" />
            <polygon points="180,90 320,60 380,180 280,140" />
            <polygon points="280,140 380,180 340,320 220,280" />
            <polygon points="90,260 220,280 180,370 40,320" stroke-dasharray="3 3" />
            <circle cx="180" cy="90" r="4" fill="currentColor" />
            <circle cx="280" cy="140" r="4" fill="currentColor" />
            <circle cx="220" cy="280" r="4" fill="currentColor" />
            <circle cx="90" cy="260" r="4" fill="currentColor" />
            <text x="145" y="195" font-size="10" font-family="monospace" fill="currentColor" letter-spacing="1">PARCEL 0012-A</text>
            <text x="250" y="210" font-size="10" font-family="monospace" fill="currentColor" letter-spacing="1">PARCEL 0012-B</text>
        </svg>
    </div>

    <!-- 2. MAIN MODERN LOGIN CONTAINER -->
    <div class="w-full max-w-5xl relative z-10 my-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 rounded-3xl overflow-hidden glass-card shadow-2xl backdrop-blur-2xl">
            
            <!-- LEFT PANEL: Real Property Tax & Assessment Brand Showcase (Desktop / Tablet) -->
            <div class="lg:col-span-6 p-8 sm:p-10 lg:p-12 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-white/10 bg-gradient-to-br from-emerald-950/40 via-slate-900/60 to-slate-950/80 relative overflow-hidden">
                
                <!-- Background Accent Watermark (City of Koronadal Seal) -->
                <div class="absolute -top-10 -right-10 p-4 opacity-[0.06] pointer-events-none select-none">
                    <img src="~/images/koronadal_seal.png" alt="" class="w-72 h-72 object-contain" />
                </div>

                <!-- Brand Header -->
                <div class="space-y-6 relative z-10">
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white/10 p-1.5 shadow-xl shadow-emerald-500/20 flex items-center justify-center ring-2 ring-emerald-400/30 backdrop-blur-md shrink-0">
                            <img src="~/images/koronadal_seal.png" alt="City of Koronadal Official Seal" class="w-full h-full object-contain drop-shadow-md" />
                        </div>
                        <div>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                                City of Koronadal &bull; LGU Assessor Portal
                            </span>
                            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-1">FAIRTRACK</h1>
                            <p class="text-[11px] font-mono text-emerald-300/80 font-semibold">Office of the City Assessor</p>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <h2 class="text-xl sm:text-2xl font-bold text-white leading-snug">
                            City Assessor Real Property Tax &amp; FAAS Assessment System
                        </h2>
                        <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
                            Centralized statutory property appraisal, automated Tax Declaration indexing, GIS mapping lot partitions, and Local Government Code (R.A. 7160) revenue administration.
                        </p>
                    </div>

                    <!-- 3 Feature Pillars -->
                    <div class="space-y-3 pt-2">
                        <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-emerald-500/30 transition-all">
                            <div class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 mt-0.5">
                                <i data-lucide="layers" class="w-4 h-4"></i>
                            </div>
                            <div class="text-xs">
                                <span class="font-bold text-slate-200 block">FAAS Appraisal &amp; TD Lifecycle</span>
                                <span class="text-slate-400 text-[11px]">Land classification schedules, BUCC structural types, and Machinery valuation.</span>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-emerald-500/30 transition-all">
                            <div class="p-2 rounded-xl bg-teal-500/10 text-teal-400 mt-0.5">
                                <i data-lucide="map" class="w-4 h-4"></i>
                            </div>
                            <div class="text-xs">
                                <span class="font-bold text-slate-200 block">Cadastral GIS Tax Mapping</span>
                                <span class="text-slate-400 text-[11px]">Lot subdivisions, consolidations, Section/Block/Lot PIN indexing, and blueprint records.</span>
                            </div>
                        </div>

                        <div class="flex items-start gap-3 p-3 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-emerald-500/30 transition-all">
                            <div class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 mt-0.5">
                                <i data-lucide="calculator" class="w-4 h-4"></i>
                            </div>
                            <div class="text-xs">
                                <span class="font-bold text-slate-200 block">Assessment Roll &amp; Tax Dues</span>
                                <span class="text-slate-400 text-[11px]">Statutory 20%–50% assessment levels, Basic RPT (2%), SEF (1%), and Official Receipts.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Status Tag -->
                <div class="pt-8 mt-6 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-slate-500">
                    <span class="flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
                        <span>R.A. 7160 Compliant Roll</span>
                    </span>
                    <span class="text-emerald-400/70 font-bold">Secured Assessor Access</span>
                </div>
            </div>

            <!-- RIGHT PANEL: Modern Authentication Form -->
            <div class="lg:col-span-6 p-8 sm:p-10 lg:p-12 flex flex-col justify-between bg-slate-900/60 backdrop-blur-xl">
                <div>
                    <!-- Form Title & Badge -->
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <span class="text-[11px] font-mono font-bold uppercase text-emerald-400 tracking-wider flex items-center gap-1.5">
                                <i data-lucide="key-round" class="w-3.5 h-3.5"></i>
                                Assessor Sign-In
                            </span>
                            <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight mt-1">Account Authentication</h3>
                        </div>
                        <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                        </div>
                    </div>

                    <form id="loginForm" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="space-y-5" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs font-mono empty:hidden [&.validation-summary-valid]:hidden"></div>

                        <!-- Username Input -->
                        <div class="space-y-1.5">
                            <label asp-for="Username" class="block text-slate-300 font-bold text-xs font-mono uppercase tracking-wider">
                                Username / Assessor ID <span class="text-rose-400">*</span>
                            </label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 group-focus-within:text-emerald-400 transition-colors">
                                    <i data-lucide="user" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Username" id="inputUsername" class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-950/80 border border-slate-700/80 text-white font-mono text-xs sm:text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all shadow-inner" placeholder="e.g. admin or employee no." required autofocus />
                            </div>
                            <span asp-validation-for="Username" class="text-rose-400 text-xs font-mono mt-1 block"></span>
                        </div>

                        <!-- Password Input with Show/Hide Toggle -->
                        <div class="space-y-1.5">
                            <label asp-for="Password" class="block text-slate-300 font-bold text-xs font-mono uppercase tracking-wider">
                                Password <span class="text-rose-400">*</span>
                            </label>
                            <div class="relative group">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 group-focus-within:text-emerald-400 transition-colors">
                                    <i data-lucide="shield" class="w-4 h-4"></i>
                                </div>
                                <input asp-for="Password" type="password" id="inputPassword" class="w-full pl-10 pr-11 py-3 rounded-xl bg-slate-950/80 border border-slate-700/80 text-white font-mono text-xs sm:text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all shadow-inner" placeholder="••••••••••••" required />
                                <button type="button" id="togglePasswordBtn" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-emerald-400 transition-colors focus:outline-none" title="Toggle password visibility">
                                    <i data-lucide="eye" id="eyeIcon" class="w-4 h-4"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-rose-400 text-xs font-mono mt-1 block"></span>
                        </div>

                        <!-- Remember Me & System Environment Info -->
                        <div class="flex items-center justify-between text-xs font-mono pt-1">
                            <label class="flex items-center gap-2 cursor-pointer text-slate-300 hover:text-white transition-colors">
                                <input asp-for="RememberMe" class="w-4 h-4 rounded border-slate-700 bg-slate-950 text-emerald-500 focus:ring-emerald-500 focus:ring-offset-slate-900 cursor-pointer" />
                                <span>Remember session</span>
                            </label>
                            <span class="text-slate-400 text-[11px]">Authorized personnel only</span>
                        </div>

                        <!-- Submit Button with Spinner -->
                        <button type="submit" id="submitBtn" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600 hover:from-emerald-400 hover:via-teal-400 hover:to-emerald-500 text-slate-950 font-extrabold text-xs font-mono uppercase tracking-wider shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/35 transition-all flex items-center justify-center gap-2.5 active:scale-[0.99] disabled:opacity-70 disabled:cursor-not-allowed">
                            <svg id="btnSpinner" class="hidden animate-spin h-4 w-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span id="btnText" class="flex items-center gap-1.5">
                                <span>Sign In to Portal</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </span>
                        </button>
                    </form>

                    <!-- Citizen / Taxpayer Quick Portal: Track Transaction -->
                    <div class="mt-5 pt-4 border-t border-white/10 space-y-2.5">
                        <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
                            <span class="uppercase tracking-wider">Citizen Public Tracker</span>
                            <span class="text-emerald-400/80 font-semibold flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                Live Workflow Routing
                            </span>
                        </div>
                        <button type="button" onclick="openTrackModal()" class="w-full py-3 px-4 rounded-xl bg-white/[0.04] hover:bg-emerald-500/10 border border-emerald-500/30 hover:border-emerald-500/60 text-emerald-400 hover:text-emerald-300 font-bold text-xs font-mono uppercase tracking-wider transition-all flex items-center justify-center gap-2 group shadow-sm active:scale-[0.99]">
                            <i data-lucide="radar" class="w-4 h-4 text-emerald-400 group-hover:rotate-45 transition-transform duration-300"></i>
                            <span>Track My Transaction</span>
                        </button>
                    </div>
                </div>

                <!-- Legal Notice / Security Badge -->
                <div class="pt-6 mt-6 border-t border-white/5 text-center text-slate-500 text-[11px] font-mono space-y-1">
                    <p class="flex items-center justify-center gap-1.5 text-slate-400">
                        <i data-lucide="lock" class="w-3 h-3 text-emerald-400/80"></i>
                        <span>City / Municipal Assessor Real Property Administration</span>
                    </p>
                    <p class="text-slate-600">&copy; @DateTime.Now.Year Local Government Unit. R.A. 7160 Compliant.</p>
                </div>
            </div>

        </div>
    </div>

    <!-- 3. CITIZEN TRANSACTION TRACKER MODAL -->
    <div id="trackTransactionModal" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-950/85 backdrop-blur-md hidden transition-opacity duration-200">
        <div class="bg-slate-900 border border-slate-700/80 rounded-3xl w-full max-w-3xl max-h-[92vh] flex flex-col shadow-2xl overflow-hidden font-sans text-slate-100 animate-in fade-in zoom-in-95 duration-150">
            
            <!-- Modal Header -->
            <div class="p-5 sm:p-6 border-b border-slate-800 flex items-start justify-between bg-slate-950/60">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 shadow-inner">
                        <i data-lucide="radar" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                Citizen Live Tracker
                            </span>
                            <span class="text-[11px] font-mono text-slate-400 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Assessor Routing
                            </span>
                        </div>
                        <h2 class="text-lg sm:text-xl font-extrabold text-white tracking-tight mt-0.5">
                            Track My Transaction
                        </h2>
                    </div>
                </div>
                <button type="button" onclick="closeTrackModal()" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none" title="Close tracker">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Search Input Bar -->
            <div class="p-5 sm:p-6 bg-slate-950/40 border-b border-slate-800/80">
                <form id="trackSearchForm" onsubmit="handleTrackSearch(event)" class="space-y-3">
                    <label for="inputTrackRef" class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-300">
                        Enter Transaction No. or Tracking No. <span class="text-rose-400">*</span>
                    </label>
                    <div class="flex flex-col sm:flex-row items-center gap-2.5">
                        <div class="relative w-full group">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 group-focus-within:text-emerald-400 transition-colors">
                                <i data-lucide="search" class="w-4 h-4"></i>
                            </div>
                            <input type="text" id="inputTrackRef" class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-950 border border-slate-700 text-white font-mono text-xs sm:text-sm placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all uppercase" placeholder="e.g. TX-20261111-001 or RPA-20261110-7908" required autocomplete="off" />
                        </div>
                        <button type="submit" id="btnTrackSubmit" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-extrabold text-xs font-mono uppercase tracking-wider shadow-lg shadow-emerald-600/20 flex items-center justify-center gap-2 shrink-0 transition-all active:scale-[0.98]">
                            <svg id="trackSpinner" class="hidden animate-spin h-4 w-4 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <i data-lucide="compass" id="trackIcon" class="w-4 h-4"></i>
                            <span>Track Status</span>
                        </button>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono text-slate-400">
                        <span class="text-slate-500">Supported:</span>
                        <span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-300">Transaction No. (TX-...)</span>
                        <span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-300">Assessment (RPA-...)</span>
                        <span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-300">Inspection (RFI-...)</span>
                        <span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-300">GIS Mapping</span>
                    </div>
                </form>
            </div>

            <!-- Modal Content / Scrollable Result Area -->
            <div class="p-5 sm:p-6 overflow-y-auto space-y-6 flex-1 min-h-[280px]">
                
                <!-- State 1: INITIAL / EMPTY STATE -->
                <div id="trackInitialState" class="py-8 text-center space-y-3">
                    <div class="w-14 h-14 mx-auto rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-slate-400">
                        <i data-lucide="map-pin" class="w-7 h-7 text-emerald-400/70"></i>
                    </div>
                    <h3 class="text-sm font-bold text-slate-200">Real-Time Assessor Document Tracking</h3>
                    <p class="text-xs text-slate-400 max-w-md mx-auto leading-relaxed">
                        Input your reference number above to view the exact handling division, assigned officer, processing stage, and full chronological audit timeline of your request.
                    </p>
                </div>

                <!-- State 2: LOADING SPINNER -->
                <div id="trackLoadingState" class="hidden py-12 text-center space-y-3">
                    <div class="w-10 h-10 mx-auto border-3 border-emerald-500/30 border-t-emerald-500 rounded-full animate-spin"></div>
                    <p class="text-xs font-mono text-emerald-400 font-semibold tracking-wide">
                        Locating transaction and routing timeline...
                    </p>
                </div>

                <!-- State 3: ERROR / NOT FOUND STATE -->
                <div id="trackErrorState" class="hidden p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs font-mono space-y-2">
                    <div class="flex items-center gap-2 font-bold text-rose-400">
                        <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0"></i>
                        <span>Transaction Record Not Found</span>
                    </div>
                    <p id="trackErrorMessage" class="text-slate-300 leading-relaxed"></p>
                    <p class="text-[11px] text-slate-400 pt-1">
                        Please double-check the tracking or transaction number issued on your acknowledgment receipt or Order of Payment.
                    </p>
                </div>

                <!-- State 4: SUCCESS RESULT VIEW -->
                <div id="trackResultState" class="hidden space-y-6">

                    <!-- Result Header Card: Numbers & Overall Status -->
                    <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800">
                            <div>
                                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 block">
                                    Request Classification
                                </span>
                                <h3 id="resDisplayType" class="text-base sm:text-lg font-extrabold text-white"></h3>
                            </div>
                            <div id="resOverallStatusBadge"></div>
                        </div>

                        <!-- Reference Numbers Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs font-mono">
                            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800/80">
                                <span class="text-[10px] text-slate-400 block uppercase font-bold">Transaction No.</span>
                                <span id="resTransactionNo" class="font-extrabold text-emerald-400 text-sm mt-0.5 block">--</span>
                            </div>
                            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800/80">
                                <span class="text-[10px] text-slate-400 block uppercase font-bold">Tracking No.</span>
                                <span id="resTrackingNumber" class="font-extrabold text-white text-sm mt-0.5 block">--</span>
                            </div>
                            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800/80">
                                <span class="text-[10px] text-slate-400 block uppercase font-bold">Applicant / Owner</span>
                                <span id="resOwner" class="font-bold text-slate-200 mt-0.5 block truncate">--</span>
                            </div>
                            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800/80">
                                <span class="text-[10px] text-slate-400 block uppercase font-bold">Date Filed</span>
                                <span id="resDateSubmitted" class="font-bold text-slate-300 mt-0.5 block">--</span>
                            </div>
                        </div>

                        <!-- Secondary Info (Property PIN / TDN / Payment) -->
                        <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono pt-1 text-slate-400">
                            <div>
                                <span class="text-slate-500">Property Ref:</span>
                                <span id="resPropertyRef" class="font-bold text-slate-200 ml-1">--</span>
                            </div>
                            <div id="resPaymentInfo" class="text-emerald-400 font-semibold"></div>
                        </div>
                    </div>

                    <!-- CURRENT LOCATION & HANDLING DIVISION HIGHLIGHT -->
                    <div class="p-5 rounded-2xl bg-gradient-to-br from-emerald-950/40 via-slate-900 to-slate-950 border-2 border-emerald-500/40 shadow-lg shadow-emerald-950/50 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="relative flex h-3 w-3">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                                </span>
                                <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400">
                                    Current Location &amp; Handling Division
                                </span>
                            </div>
                            <span id="resElapsedTime" class="text-[11px] font-mono text-slate-400 bg-slate-900/80 px-2.5 py-0.5 rounded-full border border-slate-800"></span>
                        </div>

                        <div class="space-y-1">
                            <h4 id="resDivisionName" class="text-base sm:text-lg font-extrabold text-white"></h4>
                            <p id="resLocationDescription" class="text-xs text-slate-300 font-mono leading-relaxed"></p>
                        </div>

                        <div class="pt-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
                            <div class="flex items-center gap-2">
                                <span class="text-slate-400">Handling Officer:</span>
                                <span id="resAssignedUser" class="font-bold text-white px-2 py-0.5 rounded-md bg-white/10"></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-slate-400">Processing Stage:</span>
                                <span id="resStageName" class="font-bold text-emerald-300 px-2 py-0.5 rounded-md bg-emerald-500/15 border border-emerald-500/30"></span>
                            </div>
                        </div>
                    </div>

                    <!-- WORKFLOW STEPPER PIPELINE -->
                    <div class="space-y-3">
                        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <i data-lucide="git-commit" class="w-4 h-4 text-emerald-400"></i>
                            <span>Workflow Pipeline &amp; Stage Progress</span>
                        </h4>
                        <div id="resWorkflowStepper" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5 font-mono text-xs"></div>
                    </div>

                    <!-- DETAILED CHRONOLOGICAL ROUTING TIMELINE -->
                    <div class="space-y-3">
                        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <i data-lucide="clock" class="w-4 h-4 text-emerald-400"></i>
                            <span>Routing History &amp; Event Log</span>
                        </h4>
                        <div id="resEventsContainer" class="space-y-3 font-mono text-xs"></div>
                    </div>

                </div>

            </div>

            <!-- Modal Footer -->
            <div class="p-4 sm:p-5 border-t border-slate-800 bg-slate-950/80 flex items-center justify-between text-xs font-mono text-slate-400">
                <span class="flex items-center gap-1.5">
                    <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
                    <span>Official LGU City Assessor Portal</span>
                </span>
                <button type="button" onclick="closeTrackModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold transition-colors">
                    Close Tracker
                </button>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script>
        if (window.lucide) lucide.createIcons();

        // Password Show/Hide Toggle
        const togglePasswordBtn = document.getElementById('togglePasswordBtn');
        const inputPassword = document.getElementById('inputPassword');
        const eyeIcon = document.getElementById('eyeIcon');

        if (togglePasswordBtn && inputPassword) {
            togglePasswordBtn.addEventListener('click', function () {
                const isPassword = inputPassword.type === 'password';
                inputPassword.type = isPassword ? 'text' : 'password';
                
                // Update Lucide icon
                if (eyeIcon) {
                    eyeIcon.setAttribute('data-lucide', isPassword ? 'eye-off' : 'eye');
                    if (window.lucide) lucide.createIcons();
                }
            });
        }

        // Form submission with spinner state
        const loginForm = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnSpinner = document.getElementById('btnSpinner');
        const btnText = document.getElementById('btnText');
        let isSubmitting = false;

        if (loginForm && submitBtn) {
            loginForm.addEventListener('submit', function (e) {
                if (isSubmitting) {
                    e.preventDefault();
                    return false;
                }

                if (!loginForm.checkValidity()) {
                    return;
                }

                isSubmitting = true;
                if (btnSpinner) btnSpinner.classList.remove('hidden');
                if (btnText) btnText.innerHTML = '<span>Authenticating...</span>';

                submitBtn.classList.add('pointer-events-none');
                setTimeout(function () {
                    submitBtn.disabled = true;
                }, 0);
            });
        }

        // ==========================================
        // CITIZEN TRANSACTION TRACKER JAVASCRIPT
        // ==========================================
        const trackModal = document.getElementById('trackTransactionModal');
        const inputTrackRef = document.getElementById('inputTrackRef');
        const trackInitialState = document.getElementById('trackInitialState');
        const trackLoadingState = document.getElementById('trackLoadingState');
        const trackErrorState = document.getElementById('trackErrorState');
        const trackErrorMessage = document.getElementById('trackErrorMessage');
        const trackResultState = document.getElementById('trackResultState');
        const btnTrackSubmit = document.getElementById('btnTrackSubmit');
        const trackSpinner = document.getElementById('trackSpinner');
        const trackIcon = document.getElementById('trackIcon');

        function openTrackModal() {
            if (trackModal) {
                trackModal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
                if (inputTrackRef) {
                    setTimeout(() => inputTrackRef.focus(), 100);
                }
                if (window.lucide) lucide.createIcons();
            }
        }

        function closeTrackModal() {
            if (trackModal) {
                trackModal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        // Close modal on ESC key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && trackModal && !trackModal.classList.contains('hidden')) {
                closeTrackModal();
            }
        });

        // Close on clicking backdrop
        if (trackModal) {
            trackModal.addEventListener('click', function (e) {
                if (e.target === trackModal) {
                    closeTrackModal();
                }
            });
        }

        async function handleTrackSearch(event) {
            if (event) event.preventDefault();
            const ref = (inputTrackRef.value || '').trim();
            if (!ref) return;

            // Update UI to loading
            trackInitialState.classList.add('hidden');
            trackErrorState.classList.add('hidden');
            trackResultState.classList.add('hidden');
            trackLoadingState.classList.remove('hidden');

            btnTrackSubmit.disabled = true;
            trackSpinner.classList.remove('hidden');
            trackIcon.classList.add('hidden');

            try {
                const response = await fetch(`/Account/TrackTransaction?referenceNumber=${encodeURIComponent(ref)}`, {
                    headers: { 'Accept': 'application/json' }
                });
                const result = await response.json();

                trackLoadingState.classList.add('hidden');

                if (result.success && result.data) {
                    renderTrackingResult(result.data);
                    trackResultState.classList.remove('hidden');
                } else {
                    trackErrorMessage.textContent = result.message || 'No transaction record matched the entered reference number.';
                    trackErrorState.classList.remove('hidden');
                }
            } catch (err) {
                console.error('Tracking fetch error:', err);
                trackLoadingState.classList.add('hidden');
                trackErrorMessage.textContent = 'A connection error occurred while querying the server. Please try again.';
                trackErrorState.classList.remove('hidden');
            } finally {
                btnTrackSubmit.disabled = false;
                trackSpinner.classList.add('hidden');
                trackIcon.classList.remove('hidden');
                if (window.lucide) lucide.createIcons();
            }
        }

        function renderTrackingResult(t) {
            // Overview Badges & Numbers
            document.getElementById('resDisplayType').textContent = t.displayType || t.requestType || 'Property Assessment Transaction';
            document.getElementById('resTransactionNo').textContent = t.transactionNo || t.trackingNumber || '--';
            document.getElementById('resTrackingNumber').textContent = t.trackingNumber || '--';
            document.getElementById('resOwner').textContent = t.ownerOrApplicant || 'N/A';
            document.getElementById('resPropertyRef').textContent = t.propertyReference || 'Pending PIN/TDN Assignment';
            
            const dt = t.dateSubmitted ? new Date(t.dateSubmitted) : null;
            document.getElementById('resDateSubmitted').textContent = dt ? dt.toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '--';

            // Overall Status Pill
            const statusBadgeContainer = document.getElementById('resOverallStatusBadge');
            const st = (t.overallStatus || 'Under Review').toLowerCase();
            let statusColor = 'bg-amber-500/15 text-amber-400 border-amber-500/30';
            if (st.includes('approv') || st.includes('complet') || st.includes('release')) {
                statusColor = 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30';
            } else if (st.includes('defer') || st.includes('reject')) {
                statusColor = 'bg-rose-500/15 text-rose-400 border-rose-500/30';
            } else if (st.includes('inspect') || st.includes('apprais')) {
                statusColor = 'bg-sky-500/15 text-sky-400 border-sky-500/30';
            }
            statusBadgeContainer.innerHTML = `<span class="px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider border ${statusColor}">${t.overallStatus || 'In Progress'}</span>`;

            // Payment status
            const payInfo = document.getElementById('resPaymentInfo');
            if (t.orNumber) {
                const orDate = t.orDateIssued ? new Date(t.orDateIssued).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
                payInfo.innerHTML = `<span class="inline-flex items-center gap-1.5"><i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-400"></i> OR #${t.orNumber} (${orDate})</span>`;
            } else {
                payInfo.innerHTML = `<span class="inline-flex items-center gap-1.5 text-slate-500"><i data-lucide="clock" class="w-3.5 h-3.5"></i> Assessment &amp; Fee Billing Pending</span>`;
            }

            // Current Location & Handler
            document.getElementById('resDivisionName').textContent = t.divisionName || 'City Assessor Department';
            document.getElementById('resLocationDescription').textContent = t.currentLocationDescription || 'Currently routed for departmental evaluation and review.';
            document.getElementById('resAssignedUser').textContent = t.assignedUserName ? `${t.assignedUserName} (${t.assignedToRole || 'Assigned Officer'})` : `${t.assignedToRole || 'Department Pool (Unassigned)'}`;
            document.getElementById('resStageName').textContent = t.currentStageName || 'Processing';
            document.getElementById('resElapsedTime').textContent = t.elapsedTimeText ? `Elapsed: ${t.elapsedTimeText}` : 'Active';

            // Workflow Stepper Pipeline
            const stepper = document.getElementById('resWorkflowStepper');
            stepper.innerHTML = '';
            if (t.workflowSteps && t.workflowSteps.length > 0) {
                t.workflowSteps.forEach((step, idx) => {
                    const isDone = step.state === 'completed';
                    const isCurrent = step.state === 'current';
                    const isDeferred = step.state === 'deferred';
                    
                    let cardBg = 'bg-slate-950/60 border-slate-800 text-slate-400';
                    let iconHtml = `<span class="w-5 h-5 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center font-bold text-[10px]">${idx + 1}</span>`;

                    if (isDone) {
                        cardBg = 'bg-emerald-950/30 border-emerald-500/40 text-emerald-300';
                        iconHtml = `<span class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-[10px]"><i data-lucide="check" class="w-3 h-3"></i></span>`;
                    } else if (isCurrent) {
                        cardBg = 'bg-emerald-500/10 border-emerald-500 text-white shadow-md shadow-emerald-500/20 ring-1 ring-emerald-500/50';
                        iconHtml = `<span class="w-5 h-5 rounded-full bg-emerald-500 text-slate-950 flex items-center justify-center font-bold text-[10px] animate-pulse">${idx + 1}</span>`;
                    } else if (isDeferred) {
                        cardBg = 'bg-rose-950/30 border-rose-500/40 text-rose-300';
                        iconHtml = `<span class="w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-[10px]"><i data-lucide="alert-triangle" class="w-3 h-3"></i></span>`;
                    }

                    const stepHtml = `
                        <div class="p-3 rounded-xl border ${cardBg} flex flex-col justify-between space-y-2">
                            <div class="flex items-center justify-between">
                                ${iconHtml}
                                <span class="text-[9px] uppercase font-bold text-slate-500 tracking-wider">Step ${idx + 1}</span>
                            </div>
                            <div>
                                <h5 class="font-bold text-xs leading-tight line-clamp-2">${step.stepName}</h5>
                                <p class="text-[10px] text-slate-400 mt-0.5 truncate">${step.assignedRole || ''}</p>
                            </div>
                        </div>
                    `;
                    stepper.insertAdjacentHTML('beforeend', stepHtml);
                });
            } else {
                stepper.innerHTML = '<p class="text-xs text-slate-400 col-span-full">Workflow steps are standard for this document type.</p>';
            }

            // Events Log
            const eventsContainer = document.getElementById('resEventsContainer');
            eventsContainer.innerHTML = '';
            if (t.timelineEvents && t.timelineEvents.length > 0) {
                t.timelineEvents.forEach(ev => {
                    const evTime = ev.timestamp ? new Date(ev.timestamp).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '--';
                    const evHtml = `
                        <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80 flex flex-col sm:flex-row sm:items-start justify-between gap-2.5">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold uppercase">
                                        ${ev.actionTaken || 'Forwarded'}
                                    </span>
                                    <span class="text-white font-bold text-xs">${ev.toStageName || 'Stage Routing'}</span>
                                </div>
                                <p class="text-xs text-slate-300">${ev.remarks ? `"${ev.remarks}"` : 'Document forwarded along regular processing stream.'}</p>
                                <div class="text-[11px] text-slate-400 flex items-center gap-2 pt-0.5">
                                    <span>By: <strong class="text-slate-300">${ev.forwardedByName || 'System'}</strong> (${ev.forwardedByRole || 'Assessor Staff'})</span>
                                </div>
                            </div>
                            <span class="text-[11px] text-slate-400 shrink-0 font-mono self-start sm:self-center bg-slate-900 px-2 py-1 rounded-md border border-slate-800">
                                ${evTime}
                            </span>
                        </div>
                    `;
                    eventsContainer.insertAdjacentHTML('beforeend', evHtml);
                });
            } else {
                eventsContainer.innerHTML = '<p class="text-xs text-slate-400 p-3 rounded-xl bg-slate-950/40 border border-slate-800 text-center">Initial entry submitted. Processing events will be logged here as your document advances.</p>';
            }

            if (window.lucide) lucide.createIcons();
        }
    </script>
</body>
</html>

