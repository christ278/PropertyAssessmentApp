@model PropertyAssessmentApp.Models.OrderPayment

@{
    ViewData["Title"] = "Add New Order of Payment Fee";
}

<div class="space-y-8">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="receipt" class="w-4 h-4"></i>
                <span>Order of Payment Maintenance</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">New Order of Payment Fee</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Register a new assessment fee item with generated system Guid primary key.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Create" method="post" class="space-y-6 text-xs font-mono">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-800 dark:text-rose-300"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Code" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                    <input asp-for="Code" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" placeholder="e.g. OP-105" />
                    <span asp-validation-for="Code" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                </div>
                <div>
                    <label asp-for="Category" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                    <select asp-for="Category" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold">
                        <option value="Certifications">Certifications</option>
                        <option value="Field Inspection">Field Inspection</option>
                        <option value="Annotations">Annotations</option>
                        <option value="Tax Mapping">Tax Mapping</option>
                        <option value="Assessment Services">Assessment Services</option>
                    </select>
                </div>
            </div>

            <div>
                <label asp-for="Particular" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                <input asp-for="Particular" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold focus:outline-none focus:border-emerald-600" placeholder="e.g. Certified True Copy of Tax Declaration" />
                <span asp-validation-for="Particular" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="UnitCost" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                    <input asp-for="UnitCost" type="number" step="0.01" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-right font-mono font-bold" placeholder="0.00" />
                    <span asp-validation-for="UnitCost" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                </div>
                <div class="flex items-center pt-6">
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input asp-for="IsActive" type="checkbox" class="w-5 h-5 rounded border-slate-300 dark:border-stone-700 text-emerald-600 focus:ring-emerald-500">
                        <span class="text-slate-700 dark:text-stone-300 font-bold">Active Fee Particular</span>
                    </label>
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-3 pt-4 border-t border-slate-200 dark:border-stone-800">
                <a asp-action="Index" class="w-full sm:w-auto text-center px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold">Cancel</a>
                <button type="submit" class="w-full sm:w-auto text-center px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold uppercase tracking-wider shadow-sm">
                    Save Order of Payment Fee
                </button>
            </div>
        </form>
    </div>
</div>
