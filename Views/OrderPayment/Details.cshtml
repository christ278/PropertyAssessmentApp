@model PropertyAssessmentApp.Models.OrderPayment

@{
    ViewData["Title"] = $"Order of Payment {Model.Code}";
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Action Header Bar -->
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold border border-slate-200 dark:border-stone-800 shadow-sm flex items-center gap-2">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Directory
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold flex items-center gap-2 shadow-sm">
            <i data-lucide="edit" class="w-4 h-4"></i>
            Edit Particular
        </a>
    </div>

    <!-- Details Card -->
    <div class="p-8 rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm space-y-6">
        
        <div class="border-b border-slate-200 dark:border-stone-800 pb-4 flex items-center justify-between">
            <div>
                <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-bold uppercase tracking-wider">File Maintenance Particular</span>
                <h2 class="text-2xl font-black text-slate-900 dark:text-white font-mono">@Model.Code</h2>
            </div>
            @if (Model.IsActive)
            {
                <span class="px-3 py-1 rounded-xl bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/40 text-xs font-bold uppercase">Active Particular</span>
            }
            else
            {
                <span class="px-3 py-1 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-500 dark:text-stone-400 text-xs font-bold uppercase">Inactive</span>
            }
        </div>

        <div class="space-y-4">
            <div>
                <span class="text-slate-500 dark:text-stone-400 block text-[10px] font-bold uppercase">Particular Description:</span>
                <span class="text-slate-900 dark:text-stone-100 font-bold text-base">@Model.Particular</span>
            </div>

            <div class="grid grid-cols-2 gap-4 pt-2">
                <div>
                    <span class="text-slate-500 dark:text-stone-400 block text-[10px] font-bold uppercase">Fee Category:</span>
                    <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-stone-800 text-slate-800 dark:text-stone-200 font-bold inline-block">@Model.Category</span>
                </div>
                <div>
                    <span class="text-slate-500 dark:text-stone-400 block text-[10px] font-bold uppercase">Standard Unit Cost:</span>
                    <span class="text-emerald-700 dark:text-emerald-400 font-black text-xl">₱@Model.UnitCost.ToString("N2")</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-slate-200 dark:border-stone-800 text-slate-500 dark:text-stone-400 text-[10px]">
                <div>Created Date: <strong class="text-slate-700 dark:text-stone-300">@Model.CreatedDate.ToString("MMMM dd, yyyy HH:mm")</strong></div>
                <div>Last Updated: <strong class="text-slate-700 dark:text-stone-300">@Model.UpdatedDate.ToString("MMMM dd, yyyy HH:mm")</strong></div>
            </div>
        </div>
    </div>
</div>
