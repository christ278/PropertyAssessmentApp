@model PropertyAssessmentApp.Models.DashboardViewModel
<script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
<script>
(function () {
    const d = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        trendLabels = Model.TrendLabels,
        submitted = Model.TrendSubmitted,
        released = Model.TrendReleased,
        taxDec = Model.TrendTaxDec,
        taxMapping = Model.TrendTaxMapping,
        landHolding = Model.TrendLandHolding,
        propAssessment = Model.TrendPropertyAssessment,
        propInspection = Model.TrendPropertyInspection,
        userLabels = Model.UsersByRole.Select(u => u.Label),
        userCounts = Model.UsersByRole.Select(u => u.Count),
        activityLabels = Model.ActivityLabels,
        activity = Model.ActivityTrend
    }));
    const dark = document.documentElement.classList.contains('dark');
    Chart.defaults.color = dark ? '#a8a29e' : '#64748b';
    Chart.defaults.font.size = 11;
    const grid = { color: dark ? 'rgba(168,162,158,.15)' : 'rgba(100,116,139,.15)' };
    const opts = { responsive: true, maintainAspectRatio: false };
    const make = (id, cfg) => { const el = document.getElementById(id); if (el) new Chart(el, cfg); };

    make('trendChart', {
        type: 'line',
        data: {
            labels: d.trendLabels,
            datasets: [
                { label: 'Tax Dec', data: d.taxDec, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,.1)', tension: .3, borderWidth: 2 },
                { label: 'Tax Mapping', data: d.taxMapping, borderColor: '#8b5cf6', backgroundColor: 'rgba(139,92,246,.1)', tension: .3, borderWidth: 2 },
                { label: 'Land Holding', data: d.landHolding, borderColor: '#f59e0b', backgroundColor: 'rgba(245,158,11,.1)', tension: .3, borderWidth: 2 },
                { label: 'Property Assessment', data: d.propAssessment, borderColor: '#ec4899', backgroundColor: 'rgba(236,72,153,.1)', tension: .3, borderWidth: 2 },
                { label: 'Property Inspection', data: d.propInspection, borderColor: '#06b6d4', backgroundColor: 'rgba(6,182,212,.1)', tension: .3, borderWidth: 2 },
                { label: 'Released', data: d.released, borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,.12)', borderDash: [5, 4], tension: .3, borderWidth: 2 }
            ]
        },
        options: {
            ...opts,
            interaction: { mode: 'index', intersect: false },
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, usePointStyle: true } } },
            scales: { x: { grid }, y: { grid, beginAtZero: true, ticks: { precision: 0 } } }
        }
    });

    make('usersChart', { type: 'doughnut', data: { labels: d.userLabels, datasets: [{ data: d.userCounts,
        backgroundColor: ['#10b981','#3b82f6','#8b5cf6','#f59e0b','#f43f5e','#14b8a6'], borderWidth: 0 }] },
        options: { ...opts, cutout: '60%', plugins: { legend: { position: 'bottom' } } } });

    make('activityChart', { type: 'bar', data: { labels: d.activityLabels, datasets: [{ label: 'Workflow actions', data: d.activity,
        backgroundColor: '#10b981', borderRadius: 4 }] },
        options: { ...opts, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { grid, beginAtZero: true, ticks: { precision: 0 } } } } });
})();
</script>
