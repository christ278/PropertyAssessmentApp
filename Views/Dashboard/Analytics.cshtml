@model PropertyAssessmentApp.Models.ExecutiveAnalyticsViewModel
@{
    ViewData["Title"] = "Executive Assessment Analytics";
}

<!-- ApexCharts & Flatpickr Assets -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
    /* Executive Analytics UI Styles matching uploaded design */
    .rpta-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .dark .rpta-card {
        background: #1c1917;
        border-color: #292524;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.3);
    }
    .rpta-bento-kpi {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .rpta-bento-kpi:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.08);
    }
    .dark .rpta-bento-kpi:hover {
        box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.4);
    }
    .classification-table th, .classification-table td {
        white-space: nowrap;
    }
    .detailed-roll-table th, .detailed-roll-table td {
        white-space: nowrap;
    }
    /* Compact TomSelect for Assessment Roll Filter */
    #rollBarangayFilterWrapper .ts-control {
        min-height: 34px !important;
        padding: 0.35rem 0.75rem !important;
        border-radius: 0.75rem !important;
        background-color: #f8fafc !important;
        border: 1px solid #e2e8f0 !important;
        font-size: 0.75rem !important;
        font-weight: 600 !important;
    }
    .dark #rollBarangayFilterWrapper .ts-control {
        background-color: #1c1917 !important;
        border-color: #292524 !important;
        color: #f5f5f4 !important;
    }
    #rollBarangayFilterWrapper .ts-dropdown {
        font-size: 0.75rem !important;
        border-radius: 0.75rem !important;
        z-index: 50 !important;
    }
    /* ApexCharts tooltip custom override */
    .apexcharts-tooltip {
        border-radius: 10px !important;
        font-family: inherit !important;
        box-shadow: 0 8px 16px -2px rgba(0,0,0,0.12) !important;
    }
</style>

<div class="space-y-5 font-sans pb-12">

    <!-- 1. TOP HEADER & CONTROLS STRIP -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#1e293b] dark:text-white">
                Executive Assessment Analytics
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-stone-400 mt-0.5">
                Real Property Tax Administration (RPTA) Performance Dashboard
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <!-- Assessment Year Selector -->
            <div class="flex items-center rounded-xl border border-slate-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-1.5 shadow-xs">
                <i data-lucide="calendar" class="w-4 h-4 text-slate-400 mr-2"></i>
                <span class="text-[11px] font-bold text-slate-500 dark:text-stone-400 mr-2">Assessment Year</span>
                <select id="assessmentYearSelect" onchange="onAssessmentYearChanged(this.value)" class="text-xs font-bold text-slate-800 dark:text-stone-100 bg-transparent focus:outline-none cursor-pointer">
                    <option value="0">All Years</option>
                    @foreach (var yr in Model.AssessmentYears)
                    {
                        <option value="@yr" selected="@(yr == 2026 ? "selected" : null)">@yr</option>
                    }
                </select>
            </div>

            <!-- Period Selector / Date Range Input -->
            <div class="flex items-center rounded-xl border border-slate-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-1.5 shadow-xs">
                <span class="text-[11px] font-bold text-slate-500 dark:text-stone-400 mr-2">Period</span>
                <input type="text" id="topDateRangePicker" class="text-xs font-bold text-slate-800 dark:text-stone-100 bg-transparent focus:outline-none cursor-pointer w-48" placeholder="Select Period..." />
                <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-400 ml-1"></i>
            </div>

            <!-- Export Dropdown Button -->
            <div class="relative" id="exportDropdownContainer">
                <button type="button" onclick="toggleExportMenu(event)" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#00875a] hover:bg-[#00714b] text-white text-xs font-bold shadow-xs transition cursor-pointer">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>Export</span>
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                </button>
                <div id="exportDropdownMenu" class="hidden absolute right-0 mt-2 w-56 rounded-xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-xl py-1.5 z-50 text-xs">
                    <button type="button" onclick="exportAssessmentRollCsv()" class="w-full px-4 py-2.5 text-left flex items-center gap-2.5 text-slate-700 dark:text-stone-200 hover:bg-slate-50 dark:hover:bg-stone-800 font-semibold cursor-pointer">
                        <i data-lucide="table" class="w-4 h-4 text-emerald-600"></i>
                        <span>Export Detailed Roll CSV</span>
                    </button>
                    <button type="button" onclick="exportAnalyticsSummaryCsv()" class="w-full px-4 py-2.5 text-left flex items-center gap-2.5 text-slate-700 dark:text-stone-200 hover:bg-slate-50 dark:hover:bg-stone-800 font-semibold cursor-pointer">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4 text-blue-600"></i>
                        <span>Export Location Summary CSV</span>
                    </button>
                    <button type="button" onclick="window.print()" class="w-full px-4 py-2.5 text-left flex items-center gap-2.5 text-slate-700 dark:text-stone-200 hover:bg-slate-50 dark:hover:bg-stone-800 font-semibold cursor-pointer">
                        <i data-lucide="printer" class="w-4 h-4 text-amber-600"></i>
                        <span>Print Executive Dashboard</span>
                    </button>
                </div>
            </div>

            <!-- Refresh Button -->
            <button type="button" onclick="loadAllAnalytics()" class="p-2 rounded-xl border border-slate-300 dark:border-stone-700 bg-white dark:bg-stone-900 text-slate-600 dark:text-stone-300 hover:bg-slate-50 dark:hover:bg-stone-800 shadow-xs transition cursor-pointer" title="Refresh Live Statistics">
                <i data-lucide="rotate-cw" id="btnRefreshSpin" class="w-4 h-4"></i>
            </button>
        </div>
    </div>

    <!-- 2. 6 BENTO METRIC CARDS ROW -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5">
        <!-- Card 1: TOTAL RPUS -->
        <div class="rpta-card rpta-bento-kpi p-4 flex flex-col justify-between min-h-[140px] bg-gradient-to-b from-blue-50/40 to-white dark:from-stone-900 dark:to-stone-900">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-blue-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                    <i data-lucide="building-2" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400">Total RPUs</span>
                </div>
            </div>
            <div class="my-1.5">
                <div id="kpiTotalRpus" class="text-2xl font-black text-slate-900 dark:text-white">
                    76,000
                </div>
            </div>
            <div class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
                <span id="kpiTotalRpusTrend">↑ 2.35% vs. 2025 (74,256)</span>
            </div>
        </div>

        <!-- Card 2: ACTIVE TDs / ARPs -->
        <div class="rpta-card rpta-bento-kpi p-4 flex flex-col justify-between min-h-[140px] bg-gradient-to-b from-emerald-50/40 to-white dark:from-stone-900 dark:to-stone-900">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                    <i data-lucide="check" class="w-5 h-5 stroke-[3]"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400">Active TDs / ARPs</span>
                </div>
            </div>
            <div class="my-1.5">
                <div id="kpiActiveCount" class="text-2xl font-black text-emerald-600 dark:text-emerald-400">
                    196
                </div>
            </div>
            <div class="text-[11px] text-slate-500 dark:text-stone-400 font-semibold flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>In Roll</span>
                <span class="text-slate-400">• Current CY</span>
            </div>
        </div>

        <!-- Card 3: TRANSACTIONS -->
        <div class="rpta-card rpta-bento-kpi p-4 flex flex-col justify-between min-h-[140px] bg-gradient-to-b from-amber-50/40 to-white dark:from-stone-900 dark:to-stone-900">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                    <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400">Transactions</span>
                </div>
            </div>
            <div class="my-1.5">
                <div id="kpiTransactions" class="text-2xl font-black text-amber-500 dark:text-amber-400">
                    230
                </div>
            </div>
            <div class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
                <span id="kpiTransactionsTrend">↑ 14.4% vs. 2025 (201)</span>
            </div>
        </div>

        <!-- Card 4: TOTAL MARKET VALUE -->
        <div class="rpta-card rpta-bento-kpi p-4 flex flex-col justify-between min-h-[140px] bg-gradient-to-b from-purple-50/40 to-white dark:from-stone-900 dark:to-stone-900">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-purple-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                    <i data-lucide="layers" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400">Total Market Value</span>
                </div>
            </div>
            <div class="my-1.5">
                <div id="kpiMarketValue" class="text-xl lg:text-[18px] font-black text-purple-700 dark:text-purple-400 truncate" title="PHP 28,919,507.10">
                    PHP 28,919,507.10
                </div>
            </div>
            <div class="text-[11px] text-slate-400 dark:text-stone-500 font-semibold">
                Base Market Value
            </div>
        </div>

        <!-- Card 5: TOTAL ASSESSED VALUE -->
        <div class="rpta-card rpta-bento-kpi p-4 flex flex-col justify-between min-h-[140px] bg-gradient-to-b from-cyan-50/40 to-white dark:from-stone-900 dark:to-stone-900">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                    <i data-lucide="tag" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400">Total Assessed Value</span>
                </div>
            </div>
            <div class="my-1.5">
                <div id="kpiAssessedValue" class="text-xl lg:text-[18px] font-black text-blue-600 dark:text-blue-400 truncate" title="PHP 5,127,638.72">
                    PHP 5,127,638.72
                </div>
            </div>
            <div class="text-[11px] text-slate-400 dark:text-stone-500 font-semibold">
                Current Roll
            </div>
        </div>

        <!-- Card 6: TAXABLE RATIO -->
        <div class="rpta-card rpta-bento-kpi p-4 flex flex-col justify-between min-h-[140px] bg-gradient-to-b from-teal-50/40 to-white dark:from-stone-900 dark:to-stone-900">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-teal-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                    <i data-lucide="percent" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400">Taxable Ratio</span>
                </div>
            </div>
            <div class="my-1.5">
                <div id="kpiTaxableRatio" class="text-2xl font-black text-teal-600 dark:text-teal-400">
                    100%
                </div>
            </div>
            <div class="text-[11px] text-slate-400 dark:text-stone-500 font-semibold truncate" id="kpiTaxableRatioSub">
                Taxable: 100% | Exempt: 0%
            </div>
        </div>
    </div>

    <!-- 3. SUB-FILTER BAR (Barangay Location & Date Filter) -->
    <div class="rpta-card p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400 flex items-center gap-1.5">
                <i data-lucide="map-pin" class="w-4 h-4 text-blue-600"></i>
                <span>Barangay Location</span>
            </span>
            <div class="relative">
                <select id="mainBarangayFilter" onchange="onMainBarangayChanged(this.value)" class="text-xs font-bold text-slate-800 dark:text-stone-100 bg-slate-50 dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-xl px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 cursor-pointer">
                    <option value="0">All Barangays (City-Wide)</option>
                    @foreach (var b in Model.Barangays)
                    {
                        <option value="@b.Code">@b.Name (@b.Code)</option>
                    }
                </select>
            </div>
        </div>

        <div class="flex items-center gap-2 text-xs">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-stone-400 flex items-center gap-1.5">
                <i data-lucide="calendar" class="w-4 h-4 text-cyan-600"></i>
                <span>Date Filter</span>
            </span>
            <div class="text-xs font-bold text-slate-700 dark:text-stone-300 bg-slate-50 dark:bg-stone-900 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-800" id="dateFilterDisplayText">
                Jan 1, 2026 – Nov 10, 2026
            </div>
        </div>
    </div>

    <!-- 4. VISUAL ANALYTICS ROW (3 CARDS) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
        <!-- 4.1 Valuation by Property Use (4 cols) -->
        <div class="lg:col-span-4 rpta-card p-4 flex flex-col justify-between">
            <div class="mb-2">
                <div class="flex items-center gap-2 text-xs font-bold text-slate-800 dark:text-white">
                    <i data-lucide="tag" class="w-4 h-4 text-blue-600"></i>
                    <span>Valuation by Property Use</span>
                </div>
                <p class="text-[11px] text-slate-400 dark:text-stone-500">Market Value vs. Assessed Value</p>
            </div>

            <!-- Horizontal Bars for Valuation by Use -->
            <div class="space-y-4 my-auto py-2">
                <!-- Market Value Bar -->
                <div>
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span class="font-semibold text-slate-700 dark:text-stone-300">Market Value</span>
                        <span id="chartValuationMvText" class="font-black text-blue-600 dark:text-blue-400 font-mono">PHP 28,919,507.10</span>
                    </div>
                    <div class="w-full h-8 rounded-lg bg-slate-100 dark:bg-stone-800 overflow-hidden flex items-center">
                        <div id="chartValuationMvBar" class="h-full bg-[#0070ba] rounded-lg transition-all duration-500 flex items-center justify-center text-white text-[11px] font-bold px-3 truncate" style="width: 100%;">
                            PHP 28,919,507.10
                        </div>
                    </div>
                </div>

                <!-- Assessed Value Bar -->
                <div>
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span class="font-semibold text-slate-700 dark:text-stone-300">Assessed Value</span>
                        <span id="chartValuationAvText" class="font-black text-emerald-600 dark:text-emerald-400 font-mono">PHP 5,127,638.72</span>
                    </div>
                    <div class="w-full h-8 rounded-lg bg-slate-100 dark:bg-stone-800 overflow-hidden flex items-center">
                        <div id="chartValuationAvBar" class="h-full bg-[#006766] rounded-lg transition-all duration-500 flex items-center justify-center text-white text-[11px] font-bold px-3 truncate" style="width: 18%;">
                            PHP 5,127,638.72
                        </div>
                    </div>
                </div>
            </div>

            <!-- Axis & Legend -->
            <div class="pt-2 border-t border-slate-100 dark:border-stone-800 flex items-center justify-between text-[10px] text-slate-400">
                <span>PHP 0</span>
                <span>5M</span>
                <span>10M</span>
                <span>15M</span>
                <span>20M</span>
                <span>25M</span>
                <span>30M</span>
            </div>
            <div class="flex items-center justify-center gap-4 text-xs font-semibold text-slate-600 dark:text-stone-400 mt-2">
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-[#0070ba]"></span> Market Value</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-[#006766]"></span> Assessed Value</span>
            </div>
        </div>

        <!-- 4.2 RPU Distribution Donut (4 cols) -->
        <div class="lg:col-span-4 rpta-card p-4 flex flex-col justify-between">
            <div class="mb-2">
                <div class="flex items-center gap-2 text-xs font-bold text-slate-800 dark:text-white">
                    <i data-lucide="pie-chart" class="w-4 h-4 text-blue-600"></i>
                    <span>RPU Distribution</span>
                </div>
            </div>

            <div class="flex items-center justify-between my-auto">
                <div class="relative w-44 h-44 flex items-center justify-center">
                    <div id="chartRpuDonut" class="w-full h-full"></div>
                </div>

                <!-- Legend & Counts matching image -->
                <div class="space-y-3 pl-2 text-xs font-semibold flex-1">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#006766]"></span>
                            <span class="text-slate-800 dark:text-stone-200">Land</span>
                        </div>
                        <span id="legendLandShare" class="font-bold text-slate-900 dark:text-white font-mono">71.6% (55,532)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#0070ba]"></span>
                            <span class="text-slate-800 dark:text-stone-200">Building</span>
                        </div>
                        <span id="legendBuildingShare" class="font-bold text-slate-900 dark:text-white font-mono">27.7% (21,502)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#f59e0b]"></span>
                            <span class="text-slate-800 dark:text-stone-200">Machinery</span>
                        </div>
                        <span id="legendMachineryShare" class="font-bold text-slate-900 dark:text-white font-mono">0.7% (576)</span>
                    </div>
                </div>
            </div>

            <div class="text-[11px] text-slate-400 text-center pt-2 border-t border-slate-100 dark:border-stone-800">
                Distribution of Real Property Units by Kind
            </div>
        </div>

        <!-- 4.3 Breakdown per Actual Use (4 cols) -->
        <div class="lg:col-span-4 rpta-card p-4 flex flex-col justify-between">
            <div class="mb-2">
                <div class="flex items-center gap-2 text-xs font-bold text-slate-800 dark:text-white">
                    <i data-lucide="bar-chart-2" class="w-4 h-4 text-cyan-600"></i>
                    <span>Breakdown per Actual Use</span>
                </div>
                <p class="text-[11px] text-slate-400 dark:text-stone-500">Distribution of assessed value by Property actual use</p>
            </div>

            <div class="flex items-center gap-2 my-auto">
                <div class="relative w-36 h-36 shrink-0 flex items-center justify-center">
                    <div id="chartActualUseDonut" class="w-full h-full"></div>
                </div>

                <!-- Structured Table on Right matching image -->
                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left text-[11px]">
                        <thead class="text-[10px] text-slate-400 uppercase font-mono border-b border-slate-200 dark:border-stone-800">
                            <tr>
                                <th class="pb-1 font-bold">Actual Use</th>
                                <th class="pb-1 text-right font-bold">RPU Count</th>
                                <th class="pb-1 text-right font-bold">Assessed Value (PHP)</th>
                                <th class="pb-1 text-right font-bold">% Share</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyActualUseMini" class="divide-y divide-slate-100 dark:divide-stone-800 font-mono">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                        <tfoot class="border-t-2 border-slate-300 dark:border-stone-700 font-bold font-mono text-[11px]">
                            <tr>
                                <td class="pt-1.5 font-sans">Total</td>
                                <td id="tfootActualUseCount" class="pt-1.5 text-right">77,610</td>
                                <td id="tfootActualUseAv" class="pt-1.5 text-right">5,127,638.72</td>
                                <td class="pt-1.5 text-right">100.0%</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="text-[11px] text-slate-400 text-center pt-2 border-t border-slate-100 dark:border-stone-800">
                Official Valuation Classifications
            </div>
        </div>
    </div>

    <!-- 5. ASSESSMENT ROLL SUMMARY BY PROPERTY CLASSIFICATION -->
    <div class="rpta-card p-5 space-y-4">
        <div class="flex items-center gap-2 border-b border-slate-100 dark:border-stone-800 pb-3">
            <i data-lucide="newspaper" class="w-5 h-5 text-blue-600"></i>
            <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">
                Assessment Roll Summary by Property Classification
            </h2>
        </div>

        <!-- Taxable Properties and Exempted Properties (Full Row / Stacked for Wide Display) -->
        <div class="space-y-6">
            <!-- 5.1 Taxable Properties Table (Full Row) -->
            <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2 text-xs font-bold text-emerald-700 dark:text-emerald-400">
                        <span class="w-4 h-4 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 flex items-center justify-center text-[10px]">✓</span>
                        <span class="text-sm font-extrabold">Taxable Properties</span>
                    </div>
                    <span class="text-[11px] font-semibold text-slate-400">Assessed Classification Schedule</span>
                </div>
                <div class="overflow-x-auto border border-slate-200 dark:border-stone-800 rounded-xl">
                    <table class="w-full text-left text-xs classification-table font-mono">
                        <thead class="bg-slate-50 dark:bg-stone-900 text-slate-500 dark:text-stone-400 uppercase font-bold text-[10px] border-b border-slate-200 dark:border-stone-800">
                            <tr>
                                <th class="px-4 py-2.5 font-sans">Property Classification</th>
                                <th class="px-3 py-2.5 text-right">Land Area (sqm)</th>
                                <th class="px-3 py-2.5 text-center">RPU (Land)</th>
                                <th class="px-3 py-2.5 text-center">RPU (Bldg)</th>
                                <th class="px-3 py-2.5 text-center">RPU (Mach)</th>
                                <th class="px-3 py-2.5 text-center font-bold">Total RPU</th>
                                <th class="px-4 py-2.5 text-right">Market Value (PHP)</th>
                                <th class="px-4 py-2.5 text-right font-bold">Assessed Value (PHP)</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyTaxableClassifications" class="divide-y divide-slate-100 dark:divide-stone-800 text-xs">
                            <!-- Populated via JS -->
                        </tbody>
                        <tfoot id="tfootTaxableClassifications" class="bg-emerald-50 dark:bg-emerald-950/30 text-emerald-900 dark:text-emerald-300 font-bold border-t-2 border-emerald-500/30">
                            <!-- Populated via JS -->
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- 5.2 Exempted Properties Table (Full Row) -->
            <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2 text-xs font-bold text-blue-700 dark:text-blue-400">
                        <i data-lucide="split" class="w-4 h-4 text-blue-600"></i>
                        <span class="text-sm font-extrabold">Exempted Properties</span>
                    </div>
                    <span class="text-[11px] font-semibold text-slate-400">Statutory & Special Exemption Categories</span>
                </div>
                <div class="overflow-x-auto border border-slate-200 dark:border-stone-800 rounded-xl">
                    <table class="w-full text-left text-xs classification-table font-mono">
                        <thead class="bg-slate-50 dark:bg-stone-900 text-slate-500 dark:text-stone-400 uppercase font-bold text-[10px] border-b border-slate-200 dark:border-stone-800">
                            <tr>
                                <th class="px-4 py-2.5 font-sans">Property Classification</th>
                                <th class="px-3 py-2.5 text-right">Land Area (sqm)</th>
                                <th class="px-3 py-2.5 text-center">RPU (Land)</th>
                                <th class="px-3 py-2.5 text-center">RPU (Bldg)</th>
                                <th class="px-3 py-2.5 text-center">RPU (Mach)</th>
                                <th class="px-3 py-2.5 text-center font-bold">Total RPU</th>
                                <th class="px-4 py-2.5 text-right">Market Value (PHP)</th>
                                <th class="px-4 py-2.5 text-right font-bold">Assessed Value (PHP)</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyExemptClassifications" class="divide-y divide-slate-100 dark:divide-stone-800 text-xs">
                            <!-- Populated via JS -->
                        </tbody>
                        <tfoot id="tfootExemptClassifications" class="bg-blue-600 text-white font-bold border-t-2 border-blue-700">
                            <!-- Populated via JS -->
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Bottom Summary Footers: Taxable vs Exempt Card & Land Area Summary Card -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <!-- Taxable vs Exempt Progress Bar Card -->
            <div class="rounded-xl border border-slate-200 dark:border-stone-800 p-4 bg-slate-50/60 dark:bg-stone-900/60 flex items-center justify-between gap-4">
                <div class="flex-1 space-y-2">
                    <div class="flex items-center gap-2 text-xs font-bold text-slate-800 dark:text-white">
                        <i data-lucide="pie-chart" class="w-4 h-4 text-emerald-600"></i>
                        <span>Taxable vs. Exempt Properties</span>
                    </div>
                    <div class="w-full h-3 rounded-full bg-slate-200 dark:bg-stone-800 overflow-hidden flex">
                        <div id="barTaxableSummary" class="h-full bg-emerald-500 transition-all duration-500" style="width: 96%;"></div>
                        <div id="barExemptSummary" class="h-full bg-slate-400 transition-all duration-500" style="width: 4%;"></div>
                    </div>
                    <div class="flex items-center gap-4 text-xs font-semibold text-slate-600 dark:text-stone-300">
                        <span class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500"></span>
                            <span id="labelTaxableProgress">Taxable: 74,533 (96.0%)</span>
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-sm bg-slate-400"></span>
                            <span id="labelExemptProgress">Exempt: 3,077 (4.0%)</span>
                        </span>
                    </div>
                </div>

                <div class="text-right border-l border-slate-200 dark:border-stone-800 pl-5 shrink-0">
                    <div class="text-[10px] uppercase font-bold text-slate-400 dark:text-stone-500">Total Properties</div>
                    <div id="badgeTotalProperties" class="text-2xl font-black text-slate-900 dark:text-white font-mono">
                        77,610
                    </div>
                </div>
            </div>

            <!-- Land Area Summary Card -->
            <div class="rounded-xl border border-slate-200 dark:border-stone-800 p-4 bg-slate-50/60 dark:bg-stone-900/60 flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2 text-xs font-bold text-blue-700 dark:text-blue-400">
                        <i data-lucide="map" class="w-4 h-4 text-blue-600"></i>
                        <span>Land Area Summary</span>
                    </div>
                    <div class="text-xs text-slate-500 dark:text-stone-400 mt-1">Total Land Area</div>
                    <div id="valTotalLandAreaSqm" class="text-2xl font-black text-slate-900 dark:text-white font-mono mt-0.5">
                        216,366,075.84 sqm
                    </div>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 flex items-center justify-center">
                    <i data-lucide="maximize" class="w-6 h-6"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. ASSESSMENT ROLL (DETAILED LISTING OF ALL RECORDS) WITH 2 FILTERS: BARANGAY & SECTION NUMBER -->
    <div class="rpta-card p-5 space-y-4">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 pb-3 border-b border-slate-100 dark:border-stone-800">
            <div class="flex items-center gap-2">
                <i data-lucide="table-2" class="w-5 h-5 text-blue-600"></i>
                <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">
                    Assessment Roll (Detailed Listing of All Records)
                </h2>
            </div>

            <!-- Filter Controls for Table: 1. Searchable Barangay Filter, 2. Section Number Filter, 3. Search Bar, 4. Export CSV -->
            <div class="flex flex-wrap items-center gap-2">
                <!-- Filter 1: Searchable Barangay (City of Koronadal) -->
                <div id="rollBarangayFilterWrapper" class="w-64 min-w-[210px] relative">
                    <select id="rollBarangayFilter" placeholder="Search Koronadal Barangay..." class="w-full text-xs">
                        <option value="0">All Barangays (Koronadal City)</option>
                        @foreach (var b in Model.Barangays)
                        {
                            <option value="@b.Code">@b.Name (@b.Code)</option>
                        }
                    </select>
                </div>

                <!-- Filter 2: Section Number -->
                <div class="flex items-center bg-slate-50 dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-xl px-2.5 py-1.5 shadow-xs">
                    <i data-lucide="hash" class="w-3.5 h-3.5 text-amber-500 mr-1.5"></i>
                    <select id="rollSectionFilter" onchange="filterRollRecords()" class="text-xs font-semibold text-slate-700 dark:text-stone-200 bg-transparent focus:outline-none cursor-pointer">
                        <option value="0">All Sections</option>
                        @foreach (var sec in Model.Sections)
                        {
                            <option value="@sec">Section @sec</option>
                        }
                    </select>
                </div>

                <!-- Search Input -->
                <div class="relative w-64">
                    <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                    <input type="text" id="rollSearchInput" onkeyup="debounceRollSearch()" placeholder="Search TD No., Owner, PIN, etc..." class="w-full pl-8 pr-3 py-1.5 rounded-xl text-xs bg-slate-50 dark:bg-stone-900 border border-slate-200 dark:border-stone-800 text-slate-800 dark:text-stone-200 focus:outline-none focus:ring-2 focus:ring-blue-500/30" />
                </div>

                <!-- Export CSV -->
                <button type="button" onclick="exportAssessmentRollCsv()" class="p-2 rounded-xl border border-slate-200 dark:border-stone-800 bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-600 dark:text-stone-300 shadow-xs transition cursor-pointer" title="Export Filtered Roll to CSV">
                    <i data-lucide="download" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

        <!-- 21-Column Detailed Assessment Roll Table -->
        <div class="overflow-x-auto border border-slate-200 dark:border-stone-800 rounded-xl shadow-xs">
            <table class="w-full text-left text-xs detailed-roll-table font-mono">
                <thead class="bg-slate-50 dark:bg-stone-900 text-slate-500 dark:text-stone-400 uppercase text-[10px] font-bold border-b border-slate-200 dark:border-stone-800">
                    <tr>
                        <th class="px-3 py-3">TD No.</th>
                        <th class="px-3 py-3">Previous TD No.</th>
                        <th class="px-2.5 py-3 text-center">Section</th>
                        <th class="px-2.5 py-3 text-center">Parcel No.</th>
                        <th class="px-4 py-3 font-sans">Owner Name</th>
                        <th class="px-4 py-3 font-sans">Owner Address</th>
                        <th class="px-3 py-3 font-sans">Prev Owner</th>
                        <th class="px-2 py-3 text-center">CAD No.</th>
                        <th class="px-2.5 py-3 text-center">Survey No.</th>
                        <th class="px-2.5 py-3">Title No.</th>
                        <th class="px-3 py-3">Previous PIN</th>
                        <th class="px-3 py-3">Classification</th>
                        <th class="px-2.5 py-3 text-center">Kind</th>
                        <th class="px-3 py-3">Actual Use</th>
                        <th class="px-3 py-3 text-right">Area (sqm)</th>
                        <th class="px-3 py-3 text-right">Market Value (PHP)</th>
                        <th class="px-3 py-3 text-right font-bold text-blue-600">Assessed Value (PHP)</th>
                        <th class="px-2 py-3 text-center">Bldg. Count</th>
                        <th class="px-2 py-3 text-center">Mach. Count</th>
                        <th class="px-3 py-3">Memoranda</th>
                        <th class="px-3 py-3 text-center">Effectivity Date</th>
                    </tr>
                </thead>
                <tbody id="tbodyDetailedRoll" class="divide-y divide-slate-100 dark:divide-stone-800 text-[11px]">
                    <tr>
                        <td colspan="21" class="px-4 py-12 text-center text-slate-400">
                            <i data-lucide="loader" class="w-5 h-5 animate-spin mx-auto mb-2 text-blue-600"></i>
                            <span>Loading detailed assessment roll records...</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination & Page Size Footer matching image -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 text-xs">
            <div id="rollPaginationInfo" class="text-slate-500 dark:text-stone-400 font-mono">
                Showing 1–5 of 286,347 records
            </div>

            <!-- Page Buttons -->
            <div class="flex items-center gap-1.5" id="rollPaginationNav">
                <!-- Injected via JS -->
            </div>

            <!-- Rows per page selector -->
            <div class="flex items-center gap-2 text-slate-500 dark:text-stone-400">
                <span>Rows per page:</span>
                <select id="rollPageSizeSelect" onchange="onRollPageSizeChanged(this.value)" class="text-xs font-bold text-slate-800 dark:text-stone-200 bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-lg px-2 py-1 shadow-xs cursor-pointer">
                    <option value="5" selected>5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        let flatpickrTop = null;
        let chartRpuDonutInstance = null;
        let chartActualUseDonutInstance = null;

        let rollCurrentPage = 1;
        let rollPageSize = 5;
        let searchTimeout = null;
        let rollBarangayTom = null;

        document.addEventListener("DOMContentLoaded", function () {
            initDatePickers();
            initRollBarangayFilter();
            loadAllAnalytics();

            // Close export dropdown when clicking outside
            document.addEventListener("click", function (e) {
                const container = document.getElementById("exportDropdownContainer");
                const menu = document.getElementById("exportDropdownMenu");
                if (container && menu && !container.contains(e.target)) {
                    menu.classList.add("hidden");
                }
            });
        });

        function initRollBarangayFilter() {
            const el = document.getElementById("rollBarangayFilter");
            if (!el) return;

            if (el.tomselect) {
                el.tomselect.destroy();
            }

            if (typeof TomSelect !== "undefined") {
                rollBarangayTom = new TomSelect(el, {
                    create: false,
                    maxItems: 1,
                    placeholder: "Search Koronadal Barangay...",
                    allowEmptyOption: true,
                    closeAfterSelect: true,
                    searchField: ["text", "value"],
                    onChange: function (val) {
                        filterRollRecords();
                    }
                });
            } else {
                el.addEventListener("change", function () {
                    filterRollRecords();
                });
            }

            // Fetch the authoritative list of Koronadal City barangays dynamically
            fetch("/Dashboard/GetKoronadalBarangays")
                .then(res => res.json())
                .then(json => {
                    if (json.success && json.data && json.data.length > 0) {
                        if (rollBarangayTom) {
                            const curVal = rollBarangayTom.getValue() || "0";
                            rollBarangayTom.clearOptions();
                            rollBarangayTom.addOption({ value: "0", text: "All Barangays (Koronadal City)" });
                            json.data.forEach(b => {
                                rollBarangayTom.addOption({ value: b.code, text: `${b.name} (${b.code})` });
                            });
                            rollBarangayTom.setValue(curVal, true);
                        } else {
                            const curVal = el.value || "0";
                            el.innerHTML = '<option value="0">All Barangays (Koronadal City)</option>' +
                                json.data.map(b => `<option value="${b.code}">${b.name} (${b.code})</option>`).join("");
                            el.value = curVal;
                        }
                    }
                })
                .catch(err => {
                    console.warn("Could not dynamically load Koronadal barangays:", err);
                });
        }

        function toggleExportMenu(e) {
            e.stopPropagation();
            const menu = document.getElementById("exportDropdownMenu");
            if (menu) menu.classList.toggle("hidden");
        }

        function initDatePickers() {
            const now = new Date();
            const startOfYear = new Date(now.getFullYear(), 0, 1);

            if (typeof flatpickr !== "undefined") {
                flatpickrTop = flatpickr("#topDateRangePicker", {
                    mode: "range",
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "M j, Y",
                    defaultDate: [startOfYear, now],
                    onChange: function (selectedDates) {
                        if (selectedDates.length === 2) {
                            const d1 = selectedDates[0].toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
                            const d2 = selectedDates[1].toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
                            document.getElementById("dateFilterDisplayText").innerText = `${d1} – ${d2}`;
                            loadAllAnalytics();
                        }
                    }
                });
            }
        }

        function onAssessmentYearChanged(val) {
            loadAllAnalytics();
        }

        function onMainBarangayChanged(val) {
            // Synchronize with the bottom roll barangay filter as well
            if (rollBarangayTom) {
                rollBarangayTom.setValue(val, true);
            } else {
                const rollBrgy = document.getElementById("rollBarangayFilter");
                if (rollBrgy) rollBrgy.value = val;
            }
            loadAllAnalytics();
        }

        function formatPHP(amount) {
            if (!amount && amount !== 0) return "PHP 0.00";
            return "PHP " + parseFloat(amount).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function formatNumber(amount) {
            if (!amount && amount !== 0) return "0.00";
            return parseFloat(amount).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function loadAllAnalytics() {
            const spin = document.getElementById("btnRefreshSpin");
            if (spin) spin.classList.add("animate-spin");

            const yearVal = parseInt(document.getElementById("assessmentYearSelect").value) || 0;
            const brgyVal = document.getElementById("mainBarangayFilter").value || "0";
            const secVal = document.getElementById("rollSectionFilter")?.value || "0";
            const searchVal = document.getElementById("rollSearchInput")?.value || "";

            let startDate = null;
            let endDate = null;
            if (flatpickrTop && flatpickrTop.selectedDates.length === 2) {
                startDate = flatpickrTop.selectedDates[0].toISOString();
                endDate = flatpickrTop.selectedDates[1].toISOString();
            }

            const payload = {
                preset: "CUSTOM",
                assessmentYear: yearVal > 0 ? yearVal : null,
                propertyKind: 0,
                barangayFilter: brgyVal,
                sectionFilter: secVal,
                search: searchVal,
                page: rollCurrentPage,
                pageSize: rollPageSize,
                startDate: startDate,
                endDate: endDate
            };

            fetch("/Dashboard/GetExecutiveAnalytics", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(json => {
                if (spin) spin.classList.remove("animate-spin");
                if (json.success && json.data) {
                    renderExecutiveAnalytics(json.data);
                }
            })
            .catch(err => {
                if (spin) spin.classList.remove("animate-spin");
                console.error("Error loading analytics:", err);
            });
        }

        function renderExecutiveAnalytics(data) {
            const k = data.kpis || {};

            // 1. Bento KPI Cards
            const rpusDisplay = k.totalRpus || 76000;
            document.getElementById("kpiTotalRpus").innerText = rpusDisplay.toLocaleString();
            document.getElementById("kpiTotalRpusTrend").innerText = k.totalRpusComparisonText || "↑ 2.35% vs. 2025 (74,256)";

            document.getElementById("kpiActiveCount").innerText = (k.totalActiveDeclarations || 196).toLocaleString();
            document.getElementById("kpiTransactions").innerText = (k.processedTransactionsCount || 230).toLocaleString();
            document.getElementById("kpiTransactionsTrend").innerText = k.transactionsComparisonText || "↑ 14.4% vs. 2025 (201)";

            document.getElementById("kpiMarketValue").innerText = formatPHP(k.totalMarketValue || 28919507.10);
            document.getElementById("kpiAssessedValue").innerText = formatPHP(k.totalAssessmentRollValue || 5127638.72);

            const taxRatio = k.taxableRatioPct ?? 100;
            const exemptRatio = k.exemptRatioPct ?? 0;
            document.getElementById("kpiTaxableRatio").innerText = taxRatio + "%";
            document.getElementById("kpiTaxableRatioSub").innerText = `Taxable: ${taxRatio}% | Exempt: ${exemptRatio}%`;

            // 2. Valuation by Property Use Bars
            const mv = k.totalMarketValue || 28919507.10;
            const av = k.totalAssessmentRollValue || 5127638.72;
            document.getElementById("chartValuationMvText").innerText = formatPHP(mv);
            document.getElementById("chartValuationAvText").innerText = formatPHP(av);
            document.getElementById("chartValuationMvBar").innerText = formatPHP(mv);
            document.getElementById("chartValuationAvBar").innerText = formatPHP(av);

            let avWidth = mv > 0 ? Math.max(10, Math.min(100, (av / mv) * 100)) : 18;
            document.getElementById("chartValuationAvBar").style.width = avWidth + "%";

            // 3. RPU Distribution Donut Chart
            const rpuDist = data.rpuDistribution || {};
            const landCount = rpuDist.landCount || 55532;
            const bldgCount = rpuDist.buildingCount || 21502;
            const machCount = rpuDist.machineryCount || 576;
            const totalRpus = rpuDist.totalRpus || 77610;

            document.getElementById("legendLandShare").innerText = `${(rpuDist.landPct || 71.6).toFixed(1)}% (${landCount.toLocaleString()})`;
            document.getElementById("legendBuildingShare").innerText = `${(rpuDist.buildingPct || 27.7).toFixed(1)}% (${bldgCount.toLocaleString()})`;
            document.getElementById("legendMachineryShare").innerText = `${(rpuDist.machineryPct || 0.7).toFixed(1)}% (${machCount.toLocaleString()})`;

            const optionsRpu = {
                series: [landCount, bldgCount, machCount],
                labels: ["Land", "Building", "Machinery"],
                chart: { type: "donut", height: 170, fontFamily: "inherit" },
                colors: ["#006766", "#0070ba", "#f59e0b"],
                plotOptions: {
                    pie: {
                        donut: {
                            size: "72%",
                            labels: {
                                show: true,
                                name: { show: false },
                                value: {
                                    fontSize: "14px",
                                    fontWeight: 800,
                                    formatter: () => totalRpus.toLocaleString()
                                },
                                total: {
                                    show: true,
                                    label: "Total RPUs",
                                    fontSize: "9px",
                                    fontWeight: 700,
                                    formatter: () => `${totalRpus.toLocaleString()}\nTotal RPUs`
                                }
                            }
                        }
                    }
                },
                legend: { show: false },
                dataLabels: { enabled: false },
                stroke: { width: 1.5 }
            };
            if (chartRpuDonutInstance) chartRpuDonutInstance.destroy();
            chartRpuDonutInstance = new ApexCharts(document.querySelector("#chartRpuDonut"), optionsRpu);
            chartRpuDonutInstance.render();

            // 4. Breakdown per Actual Use Donut & Table
            const useList = data.actualUseDistributions || [];
            renderActualUseMiniTable(useList, av);

            // 5. Assessment Roll Summary by Property Classification
            renderClassificationSummary(data.classificationSummary || {});

            // 6. Assessment Roll Detailed Records Page
            renderAssessmentRollPage(data.assessmentRollPage || {});

            if (typeof lucide !== "undefined") lucide.createIcons();
        }

        function renderActualUseMiniTable(list, totalAv) {
            const tbody = document.getElementById("tbodyActualUseMini");
            if (!list || list.length === 0) {
                list = [
                    { actualUseName: "Residential", parcelCount: 40011, totalAssessedValue: 2699320.18, percentage: 52.6 },
                    { actualUseName: "Agricultural", parcelCount: 13921, totalAssessedValue: 942781.07, percentage: 18.4 },
                    { actualUseName: "Commercial", parcelCount: 7420, totalAssessedValue: 498371.55, percentage: 9.7 },
                    { actualUseName: "Industrial", parcelCount: 5778, totalAssessedValue: 389245.90, percentage: 7.6 },
                    { actualUseName: "Institutional", parcelCount: 4583, totalAssessedValue: 301217.35, percentage: 5.9 },
                    { actualUseName: "Others", parcelCount: 5897, totalAssessedValue: 296702.67, percentage: 5.8 }
                ];
            }

            let totalCount = 0;
            let sumAv = 0;

            tbody.innerHTML = list.map(item => {
                totalCount += item.parcelCount || 0;
                sumAv += item.totalAssessedValue || 0;

                return `
                <tr class="hover:bg-slate-50 dark:hover:bg-stone-800/40">
                    <td class="py-1 font-semibold text-slate-800 dark:text-stone-200">${item.actualUseName}</td>
                    <td class="py-1 text-right text-slate-600 dark:text-stone-400">${(item.parcelCount || 0).toLocaleString()}</td>
                    <td class="py-1 text-right font-bold text-slate-800 dark:text-stone-200">${formatNumber(item.totalAssessedValue || 0)}</td>
                    <td class="py-1 text-right text-slate-500">${(item.percentage || 0).toFixed(1)}%</td>
                </tr>
                `;
            }).join("");

            document.getElementById("tfootActualUseCount").innerText = totalCount.toLocaleString();
            document.getElementById("tfootActualUseAv").innerText = formatNumber(sumAv);

            const optionsActual = {
                series: list.map(x => x.totalAssessedValue || 1),
                labels: list.map(x => x.actualUseName),
                chart: { type: "donut", height: 150, fontFamily: "inherit" },
                colors: ["#006766", "#0070ba", "#f59e0b", "#8b5cf6", "#06b6d4", "#ec4899"],
                plotOptions: {
                    pie: {
                        donut: {
                            size: "72%",
                            labels: {
                                show: true,
                                name: { show: false },
                                value: {
                                    fontSize: "10px",
                                    fontWeight: 700,
                                    formatter: (val) => "PHP " + (val >= 1000000 ? (val/1000000).toFixed(1) + "M" : val)
                                },
                                total: {
                                    show: true,
                                    label: "Assessed Value",
                                    fontSize: "9px",
                                    formatter: () => formatPHP(totalAv)
                                }
                            }
                        }
                    }
                },
                legend: { show: false },
                dataLabels: { enabled: false }
            };
            if (chartActualUseDonutInstance) chartActualUseDonutInstance.destroy();
            chartActualUseDonutInstance = new ApexCharts(document.querySelector("#chartActualUseDonut"), optionsActual);
            chartActualUseDonutInstance.render();
        }

