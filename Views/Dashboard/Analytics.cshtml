        function filterRollRecords() {
            rollCurrentPage = 1;
            fetchAssessmentRollPage();
        }

        function debounceRollSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function () {
                rollCurrentPage = 1;
                fetchAssessmentRollPage();
            }, 350);
        }

        function onRollPageSizeChanged(size) {
            rollPageSize = parseInt(size) || 5;
            rollCurrentPage = 1;
            fetchAssessmentRollPage();
        }

        function fetchAssessmentRollPage() {
            const tbody = document.getElementById("tbodyDetailedRoll");
            tbody.innerHTML = `
                <tr>
                    <td colspan="21" class="px-4 py-8 text-center text-slate-400">
                        <i data-lucide="loader" class="w-5 h-5 animate-spin mx-auto mb-2 text-blue-600"></i>
                        <span>Loading records...</span>
                    </td>
                </tr>
            `;
            if (typeof lucide !== "undefined") lucide.createIcons();

            const yearVal = parseInt(document.getElementById("assessmentYearSelect").value) || 0;
            const brgyVal = rollBarangayTom ? rollBarangayTom.getValue() : (document.getElementById("rollBarangayFilter")?.value || "0");
            const secVal = document.getElementById("rollSectionFilter").value || "0";
            const searchVal = document.getElementById("rollSearchInput").value || "";

            const payload = {
                preset: "CUSTOM",
                assessmentYear: yearVal > 0 ? yearVal : null,
                propertyKind: 0,
                barangayFilter: brgyVal,
                sectionFilter: secVal,
                search: searchVal,
                page: rollCurrentPage,
                pageSize: rollPageSize
            };

            fetch("/Dashboard/GetAssessmentRollPage", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(json => {
                if (json.success && json.data) {
                    renderAssessmentRollPage(json.data);
                }
            })
            .catch(err => console.error("Error fetching roll page:", err));
        }

        function renderAssessmentRollPage(pageData) {
            const tbody = document.getElementById("tbodyDetailedRoll");
            const records = pageData.records || [];
            const total = pageData.totalRecords || 0;

            if (records.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="21" class="px-4 py-10 text-center text-slate-400 font-sans">
                            No assessment records found matching selected filters.
                        </td>
                    </tr>
                `;
                document.getElementById("rollPaginationInfo").innerText = "Showing 0–0 of 0 records";
                document.getElementById("rollPaginationNav").innerHTML = "";
                return;
            }

            const startIndex = (pageData.page - 1) * pageData.pageSize + 1;
            const endIndex = Math.min(startIndex + records.length - 1, total);

            tbody.innerHTML = records.map(r => `
                <tr class="hover:bg-slate-50 dark:hover:bg-stone-800/50 transition-colors">
                    <td class="px-3 py-2.5 font-bold text-slate-900 dark:text-white">${r.tdNo}</td>
                    <td class="px-3 py-2.5 text-slate-500">${r.previousTdNo}</td>
                    <td class="px-2.5 py-2.5 text-center font-bold text-slate-800 dark:text-stone-200">${r.section}</td>
                    <td class="px-2.5 py-2.5 text-center text-slate-600 dark:text-stone-300">${r.parcelNo}</td>
                    <td class="px-4 py-2.5 font-bold font-sans text-slate-900 dark:text-white">${r.ownerName}</td>
                    <td class="px-4 py-2.5 font-sans text-slate-600 dark:text-stone-400 max-w-[220px] truncate" title="${r.ownerAddress}">${r.ownerAddress}</td>
                    <td class="px-3 py-2.5 font-sans text-slate-500">${r.prevOwner}</td>
                    <td class="px-2 py-2.5 text-center text-slate-500">${r.cadNo}</td>
                    <td class="px-2.5 py-2.5 text-center text-slate-600 dark:text-stone-300">${r.surveyNo}</td>
                    <td class="px-2.5 py-2.5 text-slate-600 dark:text-stone-300">${r.titleNo}</td>
                    <td class="px-3 py-2.5 text-[10px] text-slate-500">${r.previousPin}</td>
                    <td class="px-3 py-2.5 font-sans">${r.classification}</td>
                    <td class="px-2.5 py-2.5 text-center">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300">${r.kind}</span>
                    </td>
                    <td class="px-3 py-2.5 font-sans">${r.actualUse}</td>
                    <td class="px-3 py-2.5 text-right font-semibold text-slate-800 dark:text-stone-200">${formatNumber(r.areaSqm)}</td>
                    <td class="px-3 py-2.5 text-right text-slate-700 dark:text-stone-300">${formatNumber(r.marketValue)}</td>
                    <td class="px-3 py-2.5 text-right font-bold text-blue-600 dark:text-blue-400">${formatNumber(r.assessedValue)}</td>
                    <td class="px-2 py-2.5 text-center text-slate-500">${r.bldgCount}</td>
                    <td class="px-2 py-2.5 text-center text-slate-500">${r.machCount}</td>
                    <td class="px-3 py-2.5 text-slate-400 max-w-[120px] truncate" title="${r.memoranda}">${r.memoranda}</td>
                    <td class="px-3 py-2.5 text-center text-slate-600 dark:text-stone-400 font-sans">${r.effectivityDate}</td>
                </tr>
            `).join("");

            document.getElementById("rollPaginationInfo").innerText = `Showing ${startIndex.toLocaleString()}–${endIndex.toLocaleString()} of ${total.toLocaleString()} records`;
            renderRollPaginationControls(pageData.totalPages || 1);
            if (typeof lucide !== "undefined") lucide.createIcons();
        }

        function renderRollPaginationControls(totalPages) {
            const nav = document.getElementById("rollPaginationNav");
            let html = "";

            const firstDisabled = rollCurrentPage === 1 ? "opacity-30 pointer-events-none" : "hover:bg-slate-100 dark:hover:bg-stone-800";
            html += `<button type="button" onclick="goToRollPage(1)" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 ${firstDisabled} cursor-pointer" title="First Page">&laquo;</button>`;

            const prevDisabled = rollCurrentPage === 1 ? "opacity-30 pointer-events-none" : "hover:bg-slate-100 dark:hover:bg-stone-800";
            html += `<button type="button" onclick="goToRollPage(${rollCurrentPage - 1})" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 ${prevDisabled} cursor-pointer" title="Previous Page">&lsaquo;</button>`;

            let startP = Math.max(1, rollCurrentPage - 2);
            let endP = Math.min(totalPages, startP + 4);
            if (endP - startP < 4) {
                startP = Math.max(1, endP - 4);
            }

            for (let p = startP; p <= endP; p++) {
                const active = p === rollCurrentPage
                    ? "bg-[#0070ba] text-white border-[#0070ba] font-bold"
                    : "border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 hover:bg-slate-100 dark:hover:bg-stone-800";
                html += `<button type="button" onclick="goToRollPage(${p})" class="px-2.5 py-1 rounded-lg border text-xs ${active} cursor-pointer">${p}</button>`;
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) {
                    html += `<span class="px-1 text-slate-400 font-bold">...</span>`;
                }
                html += `<button type="button" onclick="goToRollPage(${totalPages})" class="px-2.5 py-1 rounded-lg border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 hover:bg-slate-100 text-xs cursor-pointer">${totalPages.toLocaleString()}</button>`;
            }

            const nextDisabled = rollCurrentPage === totalPages ? "opacity-30 pointer-events-none" : "hover:bg-slate-100 dark:hover:bg-stone-800";
            html += `<button type="button" onclick="goToRollPage(${rollCurrentPage + 1})" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 ${nextDisabled} cursor-pointer" title="Next Page">&rsaquo;</button>`;

            const lastDisabled = rollCurrentPage === totalPages ? "opacity-30 pointer-events-none" : "hover:bg-slate-100 dark:hover:bg-stone-800";
            html += `<button type="button" onclick="goToRollPage(${totalPages})" class="px-2 py-1 rounded-lg border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 ${lastDisabled} cursor-pointer" title="Last Page">&raquo;</button>`;

            nav.innerHTML = html;
        }

        function goToRollPage(p) {
            rollCurrentPage = p;
            fetchAssessmentRollPage();
        }

        function exportAssessmentRollCsv() {
            const yearVal = parseInt(document.getElementById("assessmentYearSelect").value) || 0;
            const brgyVal = rollBarangayTom ? rollBarangayTom.getValue() : (document.getElementById("rollBarangayFilter")?.value || "0");
            const secVal = document.getElementById("rollSectionFilter").value || "0";
            const searchVal = document.getElementById("rollSearchInput").value || "";

            const form = document.createElement("form");
            form.method = "POST";
            form.action = "/Dashboard/ExportAssessmentRollCsv";

            const addField = (name, val) => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = name;
                input.value = val;
                form.appendChild(input);
            };

            addField("AssessmentYear", yearVal > 0 ? yearVal : "");
            addField("BarangayFilter", brgyVal);
            addField("SectionFilter", secVal);
            addField("Search", searchVal);

            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);
        }

        function exportAnalyticsSummaryCsv() {
            const yearVal = parseInt(document.getElementById("assessmentYearSelect").value) || 0;
            const brgyVal = document.getElementById("mainBarangayFilter").value || "0";

            const form = document.createElement("form");
            form.method = "POST";
            form.action = "/Dashboard/ExportAnalyticsCsv";

            const addField = (name, val) => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = name;
                input.value = val;
                form.appendChild(input);
            };

            addField("Preset", "CUSTOM");
            addField("AssessmentYear", yearVal > 0 ? yearVal : "");
            addField("BarangayFilter", brgyVal);

            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);
        }
    </script>
