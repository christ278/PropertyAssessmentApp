@model PropertyAssessmentApp.Models.DashboardViewModel
<div class="mb-6 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
    <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">@Model.Title</h1>
        <p class="text-sm text-slate-500 dark:text-stone-400">@Model.Subtitle</p>
        @if (!string.IsNullOrEmpty(Model.FullName))
        {
            <p class="mt-1 text-xs font-mono text-emerald-700 dark:text-emerald-400">@Model.FullName @(string.IsNullOrEmpty(Model.RoleName) ? "" : "· " + Model.RoleName)</p>
        }
    </div>

    <form method="get" asp-controller="Dashboard" asp-action="@Model.ActionName" class="flex flex-wrap items-center gap-2 rounded-2xl bg-white/90 dark:bg-stone-900/80 border border-slate-200/90 dark:border-stone-800 px-3.5 py-2.5 shadow-sm">
        <div class="flex items-center gap-1.5">
            <label class="text-[10px] font-mono uppercase tracking-wider text-slate-400 dark:text-stone-500 font-bold">From</label>
            <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="px-2.5 py-1 rounded-xl text-xs font-mono bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-800 dark:text-stone-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/40" />
        </div>
        <div class="flex items-center gap-1.5">
            <label class="text-[10px] font-mono uppercase tracking-wider text-slate-400 dark:text-stone-500 font-bold">To</label>
            <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="px-2.5 py-1 rounded-xl text-xs font-mono bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-800 dark:text-stone-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/40" />
        </div>
        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition">
            <i data-lucide="filter" class="w-3.5 h-3.5"></i>
            <span>Filter</span>
        </button>
        @if (Model.StartDate.HasValue || Model.EndDate.HasValue)
        {
            <a asp-controller="Dashboard" asp-action="@Model.ActionName" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl border border-slate-200 dark:border-stone-700 text-xs font-semibold text-slate-600 dark:text-stone-300 hover:bg-slate-50 dark:hover:bg-stone-800 transition">
                Reset
            </a>
        }
    </form>
</div>
