@model PropertyAssessmentApp.Models.GenerateRPTReportViewModel
@{
    ViewData["Title"] = "Generate RPT Report & Certification";
    bool canManagePermissions = ViewBag.CanManagePermissions == true;
    int totalAccessible = ViewBag.TotalAccessibleReports ?? 0;
    bool hasSelectedReport = Model.RPTReportId.HasValue && Model.RPTReportId.Value > 0;
    bool isInitialHolding = Model.RPTReportId == 5 || Model.RPTReportId == 6;
    bool isInitialImprovement = Model.RPTReportId == 2 || Model.RPTReportId == 4;
}

@await Html.PartialAsync("_Select2Style")

<div class="space-y-8">

    <!-- Flash Notifications -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-800 dark:text-rose-300 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-3">
                <i data-lucide="alert-triangle" class="w-5 h-5 text-rose-600 dark:text-rose-400 shrink-0"></i>
                <span class="font-bold">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <!-- Page Header (Matches Property Assessment Records Layout) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="file-badge" class="w-4 h-4"></i>
                <span>Assessment Records & Certification Generator</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">RPT Report Generator</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Select an authorized Report / Certification Type first, then provide the required parameters to generate official LGU certifications.</p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-controller="Assessment" asp-action="Index" class="px-4 py-3 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-200 font-bold text-xs font-mono flex items-center gap-2 shadow-sm transition-all">
                <i data-lucide="layers" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                View Assessment Records
            </a>
            @if (canManagePermissions)
            {
                <a asp-controller="UserRole" asp-action="Permissions" class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold text-xs font-mono flex items-center gap-2 shadow-md shadow-emerald-600/20 transition-all">
                    <i data-lucide="shield-check" class="w-4 h-4"></i>
                    <span>Manage Role Permissions</span>
                </a>
            }
        </div>
    </div>

    <!-- User Authorization Status Card (Full Width - Matches Assessment Index Cards) -->
    <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 flex items-center justify-center text-emerald-700 dark:text-emerald-400 shrink-0 ring-1 ring-emerald-500/20">
                <i data-lucide="user-check" class="w-5 h-5"></i>
            </div>
            <div>
                <span class="font-extrabold text-sm text-slate-900 dark:text-white block font-mono">
                    Logged-in Operator: <span class="text-emerald-700 dark:text-emerald-400">@User.Identity?.Name</span>
                </span>
                <span class="text-xs text-slate-500 dark:text-stone-400 font-mono">
                    Your role is currently authorized to generate <strong class="text-emerald-600 dark:text-emerald-400">@totalAccessible</strong> report type(s).
                </span>
            </div>
        </div>

        @if (totalAccessible == 0)
        {
            <div class="px-3.5 py-2 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 font-bold text-xs font-mono flex items-center gap-2 border border-rose-200 dark:border-rose-900">
                <i data-lucide="shield-alert" class="w-4 h-4 text-rose-600"></i>
                <span>No report permissions assigned to your role</span>
            </div>
        }
        else
        {
            <div class="px-3.5 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 font-bold text-xs font-mono flex items-center gap-2 border border-emerald-200 dark:border-emerald-800">
                <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                <span>Active Permission Scope Verified</span>
            </div>
        }
    </div>

    <!-- Main Report Generation Form Card (Full Width - Matches Assessment Table Card Width) -->
    <div class="bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-sm p-6 sm:p-8 font-mono text-xs">
        <form asp-action="Generate" method="post" id="reportGenerationForm" class="space-y-6">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-800 dark:text-rose-300 font-bold mb-4"></div>

            <!-- STEP 1: Select Report / Certification Type FIRST -->
            <div class="space-y-2">
                <label asp-for="RPTReportId" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-700 dark:text-stone-300 flex items-center gap-1.5">
                    <i data-lucide="award" class="w-4 h-4 text-emerald-600"></i>
                    <span>1. Select Report / Certification Type <span class="text-rose-500">*</span></span>
                </label>

                @if (Model.AccessibleReports.Any())
                {
                    <select asp-for="RPTReportId" id="reportSelect" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-sm focus:outline-none focus:border-emerald-600 shadow-xs cursor-pointer transition-all">
                        <option value="">-- Select Authorized Report / Certification Type --</option>
                        @foreach (var opt in Model.AccessibleReports)
                        {
                            <option value="@opt.Value" selected="@(opt.Value == Model.RPTReportId?.ToString() ? "selected" : null)">@opt.Text</option>
                        }
                    </select>
                }
                else
                {
                    <div class="p-3.5 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 font-bold text-xs">
                        You currently do not have access to any report types. Please contact your system administrator.
                    </div>
                }
                <span asp-validation-for="RPTReportId" class="text-rose-600 font-bold text-[11px] block mt-1"></span>
                <p class="text-[11px] text-slate-400 dark:text-stone-500">
                    Select a certification type to reveal its required parameters. Displays only reports authorized for your role.
                </p>
            </div>

            <!-- STEP 2: Dynamic Parameters (Hidden until Certification Type is selected) -->
            <div id="reportParametersSection" class="pt-6 border-t border-slate-200 dark:border-stone-800 space-y-6 @(hasSelectedReport ? "" : "hidden")">

                <!-- 2A. Land Holding Parameter: Registered Owner (Certificate of Property Holdings) -->
                <div id="landHoldingParamContainer" class="space-y-4 @(isInitialHolding ? "" : "hidden")">
                    <input type="hidden" asp-for="OwnerId" id="hiddenOwnerId" />
                    <input type="hidden" asp-for="OwnerName" id="hiddenOwnerName" />
                    <input type="hidden" asp-for="SelectedPropertyIdsJson" id="hiddenSelectedPropertyIdsJson" />

                    <div class="space-y-2">
                        <label for="ownerHoldingSelect" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-700 dark:text-stone-300 flex items-center gap-1.5">
                            <i data-lucide="user-search" class="w-4 h-4 text-emerald-600"></i>
                            <span>Registered Owner Name <span class="text-rose-500">*</span></span>
                        </label>

                        <select id="ownerHoldingSelect" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-sm">
                            <option value=""></option>
                            @if (!string.IsNullOrWhiteSpace(Model.OwnerName))
                            {
                                var optVal = Model.OwnerId.HasValue ? Model.OwnerId.Value.ToString() : Model.OwnerName;
                                <option value="@optVal" selected>@Model.OwnerName</option>
                            }
                        </select>

                        <div id="ownerHoldingFeedback" class="text-[11px] font-mono hidden"></div>
                        <span asp-validation-for="OwnerId" class="text-rose-600 font-bold text-[11px] block mt-1"></span>
                    </div>

                    <!-- Owner's Registered Properties Table with Delete/Trash Action -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-slate-600 dark:text-stone-400 font-bold uppercase text-xs flex items-center gap-1.5">
                                <i data-lucide="building-2" class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400"></i>
                                Registered Properties / Tax Declarations
                            </label>
                            <span id="holdingPropsCount" class="px-2.5 py-0.5 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 font-bold text-[11px]">
                                0 properties
                            </span>
                        </div>
                        <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-stone-800 bg-slate-50 dark:bg-stone-950">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-100 dark:bg-stone-900 border-b border-slate-200 dark:border-stone-800 text-slate-500 dark:text-stone-400 uppercase text-[11px]">
                                        <th class="px-3 py-2.5 font-bold whitespace-nowrap min-w-[190px]">TDN No.</th>
                                        <th class="px-3 py-2.5 font-bold">Kind / Class</th>
                                        <th class="px-3 py-2.5 font-bold">Location</th>
                                        <th class="px-3 py-2.5 font-bold text-right">Market Value</th>
                                        <th class="px-3 py-2.5 font-bold text-right">Assessed Value</th>
                                        <th class="px-3 py-2.5 font-bold text-center w-16">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="holdingPropsTableBody" class="divide-y divide-slate-200 dark:divide-stone-800 bg-white dark:bg-stone-900">
                                    <tr>
                                        <td colspan="6" class="px-4 py-6 text-center text-slate-400 dark:text-stone-500 italic">
                                            Select an owner above to load their registered properties / tax declarations.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-stone-500">
                            If the table has properties, generates <strong>All Property Holding Certificate</strong>; if the table is empty, generates <strong>Certificate of No Land Holding</strong>.
                        </p>
                    </div>
                </div>

                <!-- 2A-2. Improvement / No Improvement Parameter: Active & Approved Land TDN -->
                <div id="landImprovementParamContainer" class="space-y-4 @(isInitialImprovement ? "" : "hidden")">
                    <div class="space-y-2">
                        <label for="landImprovementTdnSelect" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-700 dark:text-stone-300 flex items-center gap-1.5">
                            <i data-lucide="map-pin" class="w-4 h-4 text-emerald-600"></i>
                            <span>Land Tax Declaration (TDN) No. <span class="text-rose-500">*</span></span>
                        </label>

                        <select id="landImprovementTdnSelect" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-sm">
                            @if (!string.IsNullOrWhiteSpace(Model.TaxDeclarationNumber) && isInitialImprovement)
                            {
                                <option value="@Model.TaxDeclarationNumber" selected>@Model.TaxDeclarationNumber</option>
                            }
                        </select>
                        <div id="landImprovementFeedback" class="text-[11px] font-mono hidden"></div>
                        <span asp-validation-for="TaxDeclarationNumber" class="text-rose-600 font-bold text-[11px] block mt-1"></span>
                        <p class="text-[11px] text-slate-400 dark:text-stone-500">
                            Only <strong>Active &amp; Approved Land</strong> Tax Declarations are listed. Selecting a Land TDN automatically checks for Building or Machinery improvements using that land.
                        </p>
                    </div>

                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-700 dark:text-stone-300 flex items-center gap-1.5">
                                <i data-lucide="building-2" class="w-4 h-4 text-emerald-600"></i>
                                <span>Registered Properties / Tax Declarations</span>
                            </span>
                            <span id="improvementPropsCount" class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-bold">0 properties</span>
                        </div>
                        <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-stone-800 bg-slate-50 dark:bg-stone-950">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-100 dark:bg-stone-900 border-b border-slate-200 dark:border-stone-800 text-slate-500 dark:text-stone-400 uppercase text-[11px]">
                                        <th class="px-3 py-2.5 font-bold whitespace-nowrap min-w-[190px]">TDN No.</th>
                                        <th class="px-3 py-2.5 font-bold">Kind / Class</th>
                                        <th class="px-3 py-2.5 font-bold">Location</th>
                                        <th class="px-3 py-2.5 font-bold text-right">Market Value</th>
                                        <th class="px-3 py-2.5 font-bold text-right">Assessed Value</th>
                                        <th class="px-3 py-2.5 font-bold text-center w-16">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="improvementPropsTableBody" class="divide-y divide-slate-200 dark:divide-stone-800 bg-white dark:bg-stone-900">
                                    <tr>
                                        <td colspan="6" class="px-4 py-6 text-center text-slate-400 dark:text-stone-500 italic">
                                            Select an active &amp; approved Land TDN above to check Building or Machinery improvements.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p class="text-[11px] text-slate-400 dark:text-stone-500">
                            If the table has Building or Machinery properties, generates <strong>Certificate of Improvement</strong>; if the table is empty, generates <strong>Certificate of No Improvement</strong>.
                        </p>
                    </div>
                </div>

                <!-- 2B. Other Certification Types Parameter: Tax Declaration Number (TDN) -->
                <div id="tdnParamContainer" class="space-y-2 @(hasSelectedReport && !isInitialHolding && !isInitialImprovement ? "" : "hidden")">
                    <label asp-for="TaxDeclarationNumber" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-700 dark:text-stone-300 flex items-center gap-1.5">
                        <i data-lucide="file-text" class="w-4 h-4 text-emerald-600"></i>
                        <span>Tax Declaration (TDN) No. <span class="text-rose-500">*</span></span>
                    </label>

                    <div class="relative">
                        <input asp-for="TaxDeclarationNumber" id="tdnInput" autocomplete="off" placeholder="e.g. TD-2026-LAND-0088 or TD-2026-GS-0001" 
                               class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-sm focus:outline-none focus:border-emerald-600 shadow-xs uppercase transition-all" />
                        <div id="tdnValidationSpinner" class="hidden absolute right-3.5 top-3.5">
                            <div class="animate-spin rounded-full h-4 w-4 border-2 border-emerald-600 border-t-transparent"></div>
                        </div>
                    </div>

                    <!-- Real-Time TDN Validation Status Feedback -->
                    <div id="tdnValidationFeedback" class="text-[11px] font-mono hidden"></div>

                    <!-- Server-Side Validation Error -->
                    <span asp-validation-for="TaxDeclarationNumber" class="text-rose-600 font-bold text-[11px] block mt-1"></span>
                    <p class="text-[11px] text-slate-400 dark:text-stone-500">
                        Must exist in the list of Assessment Records (TDNs). Verified dynamically against the assessment roll.
                    </p>
                </div>

                <!-- 2C. Always Appended Particulars: Purpose, Requestor, O.R. No. -->
                <div class="pt-4 border-t border-slate-200 dark:border-stone-800 grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div class="space-y-1.5">
                        <label asp-for="Purpose" class="block text-[11px] font-mono uppercase text-slate-600 dark:text-stone-400 font-bold">Purpose of Certification</label>
                        <input asp-for="Purpose" placeholder="e.g. Bank Loan, BIR Capital Gains, Bail Bond, Legal" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs focus:outline-none focus:border-emerald-600" />
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="RequestedBy" class="block text-[11px] font-mono uppercase text-slate-600 dark:text-stone-400 font-bold">Requestor / Representative</label>
                        <input asp-for="RequestedBy" placeholder="Leave blank to use Registered Owner Name" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs focus:outline-none focus:border-emerald-600" />
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="ORNumber" class="block text-[11px] font-mono uppercase text-slate-600 dark:text-stone-400 font-bold">Official Receipt (O.R.) No. <span class="text-rose-500">*</span></label>
                        <input asp-for="ORNumber" required placeholder="e.g. OR-2026-99120" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono text-xs focus:outline-none focus:border-emerald-600" />
                        <span asp-validation-for="ORNumber" class="text-rose-600 font-bold text-[11px] block mt-1"></span>
                    </div>
                </div>
            </div>

            <!-- Action Toolbar -->
            <div class="pt-6 border-t border-slate-200 dark:border-stone-800 flex items-center justify-between flex-wrap gap-4">
                <div class="text-slate-500 dark:text-stone-400 text-xs flex items-center gap-2">
                    <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                    <span>Select Certification Type first, then complete the displayed parameters.</span>
                </div>

                <button type="submit" id="btnGenerate" @(totalAccessible == 0 ? "disabled" : "") 
                        class="px-6 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-extrabold text-sm flex items-center gap-2 shadow-lg shadow-emerald-600/25 transition-all">
                    <i data-lucide="file-check-2" class="w-5 h-5"></i>
                    <span>Generate & View Certificate</span>
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
<script>
    var tdnInput = document.getElementById('tdnInput');
    var feedback = document.getElementById('tdnValidationFeedback');
    var spinner = document.getElementById('tdnValidationSpinner');
    var validationTimer = null;
    var isTdnValid = false;

    function validateTdnRealTime() {
        if (!tdnInput) return;
        var val = tdnInput.value.trim();

        if (val.length === 0) {
            feedback.className = 'text-[11px] font-mono hidden';
            feedback.innerHTML = '';
            tdnInput.classList.remove('border-rose-500', 'border-emerald-500');
            isTdnValid = false;
            return;
        }

        if (spinner) spinner.classList.remove('hidden');

        fetch('/RPTReport/ValidateTdn?tdn=' + encodeURIComponent(val))
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (spinner) spinner.classList.add('hidden');
                feedback.classList.remove('hidden');

                if (data.exists) {
                    isTdnValid = true;
                    tdnInput.classList.remove('border-rose-500');
                    tdnInput.classList.add('border-emerald-500');
                    feedback.className = 'text-[11px] font-mono text-emerald-700 dark:text-emerald-400 font-bold flex items-center gap-1.5 mt-1';
                    feedback.innerHTML = '<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i> <span>' + data.message + '</span>';
                } else {
                    isTdnValid = false;
                    tdnInput.classList.remove('border-emerald-500');
                    tdnInput.classList.add('border-rose-500');
                    feedback.className = 'text-[11px] font-mono text-rose-600 dark:text-rose-400 font-bold flex items-center gap-1.5 mt-1';
                    feedback.innerHTML = '<i data-lucide="alert-circle" class="w-3.5 h-3.5 text-rose-600"></i> <span>' + data.message + '</span>';
                }
                if (window.lucide) {
                    lucide.createIcons();
                }
            })
            .catch(function() {
                if (spinner) spinner.classList.add('hidden');
            });
    }

    if (tdnInput) {
        tdnInput.addEventListener('blur', validateTdnRealTime);
        tdnInput.addEventListener('input', function() {
            clearTimeout(validationTimer);
            validationTimer = setTimeout(validateTdnRealTime, 500);
        });

        // Trigger on initial page load if TDN is prefilled
        if (tdnInput.value.trim().length > 0) {
            validateTdnRealTime();
        }
    }

    // Dynamic Certification Type -> Parameter Switcher
    var reportSelect = document.getElementById('reportSelect');
    var paramsSection = document.getElementById('reportParametersSection');
    var landHoldingContainer = document.getElementById('landHoldingParamContainer');
    var landImprovementContainer = document.getElementById('landImprovementParamContainer');
    var tdnParamContainer = document.getElementById('tdnParamContainer');
    var ownerFeedback = document.getElementById('ownerHoldingFeedback');
    var improvementFeedback = document.getElementById('landImprovementFeedback');

    function isLandHoldingType(reportId, reportText) {
        if (reportId === '5' || reportId === '6') return true;
        return (reportText || '').toLowerCase().indexOf('holding') !== -1;
    }

    function isImprovementType(reportId, reportText) {
        if (reportId === '2' || reportId === '4') return true;
        return (reportText || '').toLowerCase().indexOf('improvement') !== -1;
    }

    function updateParameterVisibility() {
        if (!reportSelect || !paramsSection) return;
        var val = (reportSelect.value || '').trim();
        var selectedText = reportSelect.options[reportSelect.selectedIndex]?.text || '';

        if (!val) {
            paramsSection.classList.add('hidden');
            return;
        }

        paramsSection.classList.remove('hidden');
        if (isLandHoldingType(val, selectedText)) {
            landHoldingContainer.classList.remove('hidden');
            if (landImprovementContainer) landImprovementContainer.classList.add('hidden');
            tdnParamContainer.classList.add('hidden');
        } else if (isImprovementType(val, selectedText)) {
            landHoldingContainer.classList.add('hidden');
            if (landImprovementContainer) landImprovementContainer.classList.remove('hidden');
            tdnParamContainer.classList.add('hidden');
        } else {
            landHoldingContainer.classList.add('hidden');
            if (landImprovementContainer) landImprovementContainer.classList.add('hidden');
            tdnParamContainer.classList.remove('hidden');
        }
    }

    if (reportSelect) {
        reportSelect.addEventListener('change', updateParameterVisibility);
        updateParameterVisibility();
    }

    $(document).ready(function () {
        const $ownerSel = $('#ownerHoldingSelect');
        if ($ownerSel.length && $.fn.select2) {
            $ownerSel.select2({
                placeholder: 'Search Registered Owner Name or TIN...',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0,
                ajax: {
                    url: '/RPTReport/SearchOwners',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term || '' };
                    },
                    processResults: function (data) {
                        const list = Array.isArray(data) ? data : [];
                        return {
                            results: list.map(function (o) {
                                return {
                                    id: o.id,
                                    text: o.ownerName + (o.tin ? ' (TIN: ' + o.tin + ')' : ''),
                                    ownerData: o
                                };
                            })
                        };
                    },
                    cache: false
                },
                templateResult: function (item) {
                    if (item.loading || !item.ownerData) return item.text;
                    const o = item.ownerData;
                    const badge = o.propertyCount > 0
                        ? o.propertyCount + ' property(s) → All Property Holding'
                        : '0 properties → Certificate of No Land Holding';
                    const $el = $(
                        '<div class="py-1">' +
                            '<div class="flex items-center justify-between gap-2">' +
                                '<span class="font-bold text-xs"></span>' +
                                '<span class="font-mono text-[10px] opacity-80"></span>' +
                            '</div>' +
                            '<div class="text-[11px] opacity-80"></div>' +
                        '</div>'
                    );
                    $el.find('span').eq(0).text(o.ownerName || '');
                    $el.find('span').eq(1).text(badge);
                    $el.find('div').eq(1).text((o.tin ? 'TIN: ' + o.tin + ' · ' : '') + (o.address || ''));
                    return $el;
                }
            });

            var holdingProps = [];

            function escapeHtml(str) {
                return String(str || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function formatPhp(val) {
                const n = Number(val || 0);
                return '₱' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function renderHoldingPropsTable() {
                const $tbody = $('#holdingPropsTableBody');
                const $count = $('#holdingPropsCount');
                const ids = holdingProps.map(function (p) { return p.id; });
                $('#hiddenSelectedPropertyIdsJson').val(JSON.stringify(ids));

                $count.text(holdingProps.length + (holdingProps.length === 1 ? ' property' : ' properties'));

                if (holdingProps.length === 0) {
                    $tbody.html(
                        '<tr>' +
                            '<td colspan="6" class="px-4 py-6 text-center text-slate-400 dark:text-stone-500 italic">' +
                                ($('#hiddenOwnerId').val() || $('#hiddenOwnerName').val()
                                    ? 'No properties in table. Generating will produce Certificate of No Land Holding.'
                                    : 'Select an owner above to load their registered properties / tax declarations.') +
                            '</td>' +
                        '</tr>'
                    );
                } else {
                    const rowsHtml = holdingProps.map(function (p, idx) {
                        return '<tr class="hover:bg-slate-50 dark:hover:bg-stone-800/50 transition-colors">' +
                            '<td class="px-3 py-2.5 font-mono font-bold text-slate-900 dark:text-white whitespace-nowrap min-w-[190px]">' + escapeHtml(p.taxDeclarationNumber || 'N/A') + '</td>' +
                            '<td class="px-3 py-2.5">' +
                                '<span class="font-bold text-slate-800 dark:text-stone-200">' + escapeHtml(p.kind || '—') + '</span>' +
                                (p.classification ? '<span class="block text-[10px] text-slate-500 dark:text-stone-400">' + escapeHtml(p.classification) + '</span>' : '') +
                            '</td>' +
                            '<td class="px-3 py-2.5 text-slate-700 dark:text-stone-300">' + escapeHtml(p.location || 'N/A') + '</td>' +
                            '<td class="px-3 py-2.5 text-right font-mono font-bold text-slate-800 dark:text-stone-200">' + formatPhp(p.marketValue) + '</td>' +
                            '<td class="px-3 py-2.5 text-right font-mono font-bold text-emerald-700 dark:text-emerald-400">' + formatPhp(p.assessedValue) + '</td>' +
                            '<td class="px-3 py-2.5 text-center">' +
                                '<button type="button" onclick="removeHoldingProperty(' + idx + ')" title="Remove property from certificate" class="p-1.5 rounded-lg text-rose-600 hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-950/50 transition-colors">' +
                                    '<i data-lucide="trash-2" class="w-4 h-4"></i>' +
                                '</button>' +
                            '</td>' +
                        '</tr>';
                    }).join('');
                    $tbody.html(rowsHtml);
                }

                if (ownerFeedback && ($('#hiddenOwnerId').val() || $('#hiddenOwnerName').val())) {
                    ownerFeedback.classList.remove('hidden');
                    if (holdingProps.length > 0) {
                        ownerFeedback.className = 'text-[11px] font-mono text-emerald-700 dark:text-emerald-400 font-bold flex items-center gap-1.5 mt-1';
                        ownerFeedback.innerHTML = '<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i> <span>' + holdingProps.length + ' property(s) in table — will generate All Property Holding Certificate.</span>';
                    } else {
                        ownerFeedback.className = 'text-[11px] font-mono text-amber-700 dark:text-amber-400 font-bold flex items-center gap-1.5 mt-1';
                        ownerFeedback.innerHTML = '<i data-lucide="info" class="w-3.5 h-3.5 text-amber-600"></i> <span>Table is empty (0 properties) — will generate Certificate of No Land Holding.</span>';
                    }
                }

                if (window.lucide) lucide.createIcons();
            }

            window.removeHoldingProperty = function (idx) {
                holdingProps.splice(idx, 1);
                renderHoldingPropsTable();
            };

            function loadOwnerProperties(ownerId, ownerName, lhRequestId) {
                if (!ownerId && !ownerName && !lhRequestId) {
                    holdingProps = [];
                    renderHoldingPropsTable();
                    return;
                }
                const params = new URLSearchParams();
                if (ownerId) params.set('ownerId', ownerId);
                if (ownerName) params.set('ownerName', ownerName);
                if (lhRequestId) params.set('landHoldingRequestId', lhRequestId);

                fetch('/RPTReport/GetOwnerProperties?' + params.toString())
                    .then(function (r) { return r.json(); })
                    .then(function (list) {
                        holdingProps = Array.isArray(list) ? list : [];
                        renderHoldingPropsTable();
                    })
                    .catch(function () {
                        holdingProps = [];
                        renderHoldingPropsTable();
                    });
            }

            $ownerSel.on('select2:select', function (e) {
                const o = e.params.data && e.params.data.ownerData;
                if (!o) return;
                $('#hiddenOwnerId').val(o.id || '');
                $('#hiddenOwnerName').val(o.ownerName || '');
                loadOwnerProperties(o.id, o.ownerName, null);
            });

            $ownerSel.on('select2:clear', function () {
                $('#hiddenOwnerId').val('');
                $('#hiddenOwnerName').val('');
                holdingProps = [];
                renderHoldingPropsTable();
                if (ownerFeedback) {
                    ownerFeedback.className = 'text-[11px] font-mono hidden';
                    ownerFeedback.innerHTML = '';
                }
            });

            const initialOwnerId = $('#hiddenOwnerId').val();
            const initialOwnerName = $('#hiddenOwnerName').val();
            const initialLhId = '@(ViewBag.LandHoldingRequestId?.ToString() ?? "")';
            if (initialOwnerId || initialOwnerName || initialLhId) {
                loadOwnerProperties(initialOwnerId, initialOwnerName, initialLhId);
            } else {
                $ownerSel.val(null).trigger('change');
            }
        }

        // Land Improvement / No Improvement Select2 + Table
        const $landImpSel = $('#landImprovementTdnSelect');
        if ($landImpSel.length && $.fn.select2) {
            var improvementProps = [];

            function escapeHtmlImp(str) {
                return String(str || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function formatPhpImp(val) {
                const n = Number(val || 0);
                return '₱' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function renderImprovementPropsTable(invalidMsg) {
                const $tbody = $('#improvementPropsTableBody');
                const $count = $('#improvementPropsCount');
                const ids = improvementProps.map(function (p) { return p.id; });
                $('#hiddenSelectedPropertyIdsJson').val(JSON.stringify(ids));

                $count.text(improvementProps.length + (improvementProps.length === 1 ? ' property' : ' properties'));

                if (improvementProps.length === 0) {
                    $tbody.html(
                        '<tr>' +
                            '<td colspan="6" class="px-4 py-6 text-center text-slate-400 dark:text-stone-500 italic">' +
                                ($('#tdnInput').val()
                                    ? 'No Building or Machinery properties using this land. Generating will produce Certificate of No Improvement.'
                                    : 'Select an active & approved Land TDN above to check Building or Machinery improvements.') +
                            '</td>' +
                        '</tr>'
                    );
                } else {
                    const rowsHtml = improvementProps.map(function (p, idx) {
                        return '<tr class="hover:bg-slate-50 dark:hover:bg-stone-800/50 transition-colors">' +
                            '<td class="px-3 py-2.5 font-mono font-bold text-slate-900 dark:text-white whitespace-nowrap min-w-[190px]">' + escapeHtmlImp(p.taxDeclarationNumber || 'N/A') + '</td>' +
                            '<td class="px-3 py-2.5">' +
                                '<span class="font-bold text-slate-800 dark:text-stone-200">' + escapeHtmlImp(p.kind || '—') + '</span>' +
                                (p.classification ? '<span class="block text-[10px] text-slate-500 dark:text-stone-400">' + escapeHtmlImp(p.classification) + '</span>' : '') +
                            '</td>' +
                            '<td class="px-3 py-2.5 text-slate-700 dark:text-stone-300">' + escapeHtmlImp(p.location || 'N/A') + '</td>' +
                            '<td class="px-3 py-2.5 text-right font-mono font-bold text-slate-800 dark:text-stone-200">' + formatPhpImp(p.marketValue) + '</td>' +
                            '<td class="px-3 py-2.5 text-right font-mono font-bold text-emerald-700 dark:text-emerald-400">' + formatPhpImp(p.assessedValue) + '</td>' +
                            '<td class="px-3 py-2.5 text-center">' +
                                '<button type="button" onclick="removeImprovementProperty(' + idx + ')" title="Remove property from certificate" class="p-1.5 rounded-lg text-rose-600 hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-950/50 transition-colors">' +
                                    '<i data-lucide="trash-2" class="w-4 h-4"></i>' +
                                '</button>' +
                            '</td>' +
                        '</tr>';
                    }).join('');
                    $tbody.html(rowsHtml);
                }

                if (improvementFeedback) {
                    if (invalidMsg) {
                        improvementFeedback.className = 'text-[11px] font-mono text-rose-600 dark:text-rose-400 font-bold flex items-center gap-1.5 mt-1';
                        improvementFeedback.innerHTML = '<i data-lucide="alert-circle" class="w-3.5 h-3.5 text-rose-600"></i> <span>' + escapeHtmlImp(invalidMsg) + '</span>';
                    } else if ($('#tdnInput').val()) {
                        improvementFeedback.classList.remove('hidden');
                        if (improvementProps.length > 0) {
                            improvementFeedback.className = 'text-[11px] font-mono text-emerald-700 dark:text-emerald-400 font-bold flex items-center gap-1.5 mt-1';
                            improvementFeedback.innerHTML = '<i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i> <span>' + improvementProps.length + ' building/machinery property(s) using this land — will generate Certificate of Improvement.</span>';
                        } else {
                            improvementFeedback.className = 'text-[11px] font-mono text-amber-700 dark:text-amber-400 font-bold flex items-center gap-1.5 mt-1';
                            improvementFeedback.innerHTML = '<i data-lucide="info" class="w-3.5 h-3.5 text-amber-600"></i> <span>No building or machinery using this land (0 properties) — will generate Certificate of No Improvement.</span>';
                        }
                    } else {
                        improvementFeedback.className = 'text-[11px] font-mono hidden';
                        improvementFeedback.innerHTML = '';
                    }
                }

                if (window.lucide) lucide.createIcons();
            }

            window.removeImprovementProperty = function (idx) {
                improvementProps.splice(idx, 1);
                renderImprovementPropsTable();
            };

            function loadLandImprovements(tdnVal) {
                if (!tdnVal) {
                    improvementProps = [];
                    renderImprovementPropsTable();
                    return;
                }
                fetch('/RPTReport/GetLandImprovements?tdn=' + encodeURIComponent(tdnVal))
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        if (res && res.valid) {
                            improvementProps = Array.isArray(res.properties) ? res.properties : [];
                            renderImprovementPropsTable();
                        } else {
                            improvementProps = [];
                            renderImprovementPropsTable((res && res.message) ? res.message : 'Invalid Land TDN.');
                        }
                    })
                    .catch(function () {
                        improvementProps = [];
                        renderImprovementPropsTable('Failed to load land improvements.');
                    });
            }

            $landImpSel.select2({
                placeholder: 'Search Active & Approved Land TDN, Lot No., or Owner...',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0,
                ajax: {
                    url: '/RPTReport/SearchLandTdns',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term || '' };
                    },
                    processResults: function (data) {
                        const list = Array.isArray(data) ? data : [];
                        return {
                            results: list.map(function (t) {
                                return {
                                    id: t.id,
                                    text: t.tdn + (t.ownerName ? ' — ' + t.ownerName : ''),
                                    landData: t
                                };
                            })
                        };
                    },
                    cache: false
                },
                templateResult: function (item) {
                    if (item.loading || !item.landData) return item.text;
                    const t = item.landData;
                    const $el = $(
                        '<div class="py-1">' +
                            '<div class="flex items-center justify-between gap-2">' +
                                '<span class="font-mono font-bold text-xs"></span>' +
                                '<span class="font-mono text-[10px] opacity-80"></span>' +
                            '</div>' +
                            '<div class="text-[11px] opacity-80"></div>' +
                        '</div>'
                    );
                    $el.find('span').eq(0).text(t.tdn || '');
                    $el.find('span').eq(1).text(t.lotNo ? 'Lot: ' + t.lotNo : 'Land (Active)');
                    $el.find('div').eq(1).text((t.ownerName ? t.ownerName + ' · ' : '') + (t.location || ''));
                    return $el;
                }
            });

            $landImpSel.on('select2:select', function (e) {
                const t = e.params.data && e.params.data.landData;
                const tdnVal = (t && t.tdn) || e.params.data.id || '';
                $('#tdnInput').val(tdnVal);
                loadLandImprovements(tdnVal);
            });

            $landImpSel.on('select2:clear', function () {
                $('#tdnInput').val('');
                improvementProps = [];
                renderImprovementPropsTable();
            });

            const initialReportVal = reportSelect ? (reportSelect.value || '').trim() : '';
            const initialReportText = reportSelect ? (reportSelect.options[reportSelect.selectedIndex]?.text || '') : '';
            const initialTdnVal = ($('#tdnInput').val() || '').trim();
            if (isImprovementType(initialReportVal, initialReportText) && initialTdnVal) {
                loadLandImprovements(initialTdnVal);
            } else if (!initialTdnVal) {
                $landImpSel.val(null).trigger('change');
            }
        }
    });
</script>
}
