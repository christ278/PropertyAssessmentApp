@{
    ViewData["Title"] = "TD Data Transfer Utility";
}

<div class="space-y-8 font-mono text-xs">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="database" class="w-4 h-4"></i>
                <span>CAST & PATAS Data Migration Bridge</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">TD Data Transfer Utility</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Query external assessment records, match/register taxpayer ownership, and migrate into local Tax Declarations.</p>
        </div>

        <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/30 text-xs font-bold">
                <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>
                <span>Automatic Model Mapper Active</span>
            </span>
        </div>
    </div>

    <!-- Filter & Search Controls Bar -->
    <div class="p-5 rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm space-y-4">
        <div class="flex flex-col md:flex-row items-center gap-3">
            <!-- Limit Dropdown -->
            <div class="flex items-center gap-2 bg-slate-50 dark:bg-stone-800 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 shadow-xs shrink-0">
                <span class="limit-label text-[10px] text-slate-500 dark:text-emerald-400 font-extrabold uppercase">Limit:</span>
                <select id="transferLimit" onchange="loadTable(1)" class="bg-transparent font-extrabold text-slate-900 dark:text-white focus:outline-none cursor-pointer">
                    <option value="5" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">5</option>
                    <option value="10" selected class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">10</option>
                    <option value="25" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">25</option>
                    <option value="50" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">50</option>
                    <option value="100" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white">100</option>
                </select>
            </div>

            <!-- Filter Type Dropdown -->
            <div class="flex items-center gap-2 bg-slate-50 dark:bg-stone-800/60 px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-700 shrink-0">
                <span class="text-[10px] text-slate-400 dark:text-stone-500 font-bold uppercase">Filter:</span>
                <select id="transferFilter" class="bg-transparent font-bold text-slate-800 dark:text-white focus:outline-none cursor-pointer">
                    <option value="TDN">TDN (Tax Dec No.)</option>
                    <option value="Owner">Owner Name</option>
                    <option value="PIN">PIN (Property Index)</option>
                    <option value="Lot">Lot No.</option>
                </select>
            </div>

            <!-- Search Keyword Input -->
            <div class="relative flex-1 w-full">
                <input type="text" id="transferKeyword" 
                       placeholder="Enter TDN, Owner Name, PIN, or Lot No..." 
                       onkeyup="if(event.key === 'Enter') loadTable(1);"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-stone-700 bg-slate-50 dark:bg-stone-800/60 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 text-xs" />
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 shrink-0">
                <button type="button" onclick="loadTable(1)" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center gap-2 shadow-sm transition-all">
                    <i data-lucide="search" class="w-4 h-4"></i>
                    <span>Search Records</span>
                </button>
                <button type="button" onclick="resetSearch()" title="Reset Filters" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold border border-slate-200 dark:border-stone-700">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </button>
                <button type="button" onclick="openMigrationLogsModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold border border-slate-200 dark:border-stone-700 flex items-center gap-2">
                    <i data-lucide="history" class="w-4 h-4 text-emerald-500"></i>
                    <span class="hidden sm:inline">Audit Logs</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Table Container (Loaded via AJAX) -->
    <div id="transferTableContainer" class="bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-sm">
        <div class="p-12 text-center text-slate-400 dark:text-stone-500 space-y-3">
            <i data-lucide="loader-2" class="w-8 h-8 mx-auto animate-spin text-emerald-500"></i>
            <p>Loading records from data transfer archive...</p>
        </div>
    </div>
</div>

<!-- OWNER REGISTRATION & LINKING MODAL -->
<div id="ownerModalContainer" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <!-- Dynamic Modal Content Loads Here -->
</div>

<!-- MIGRATION AUDIT LOGS MODAL -->
<div id="migrationLogsModalContainer" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <!-- Dynamic Audit Logs Load Here -->
</div>

@section Scripts {
<script>
    let currentSelectedTdn = null;

    document.addEventListener("DOMContentLoaded", function () {
        loadTable(1);
    });

    function loadTable(pageNumber) {
        const filter = document.getElementById("transferFilter").value;
        const keyword = document.getElementById("transferKeyword").value;
        const pageSize = document.getElementById("transferLimit").value;
        const container = document.getElementById("transferTableContainer");

        container.innerHTML = `
            <div class="p-12 text-center text-slate-400 dark:text-stone-500 space-y-3">
                <div class="inline-block animate-spin w-6 h-6 border-2 border-emerald-500 border-t-transparent rounded-full"></div>
                <p>Fetching records...</p>
            </div>`;

        fetch(`/DataTransferUtility/LoadTable?filter=${encodeURIComponent(filter)}&keyword=${encodeURIComponent(keyword)}&pageNumber=${pageNumber}&pageSize=${pageSize}`)
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
                if (window.lucide) {
                    lucide.createIcons();
                }
            })
            .catch(err => {
                container.innerHTML = `<div class="p-8 text-center text-rose-500 font-bold">Failed to load transfer records. Check connection.</div>`;
            });
    }

    function resetSearch() {
        document.getElementById("transferKeyword").value = "";
        document.getElementById("transferFilter").selectedIndex = 0;
        loadTable(1);
    }

    function openOwnerMappingModal(tdnJsonEncoded) {
        try {
            const tdnDto = JSON.parse(decodeURIComponent(tdnJsonEncoded));
            currentSelectedTdn = tdnDto;

            fetch('/DataTransferUtility/GetOwnerModal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(tdnDto)
            })
            .then(res => res.text())
            .then(html => {
                const modal = document.getElementById("ownerModalContainer");
                modal.innerHTML = html;
                modal.classList.remove("hidden");
                if (window.lucide) {
                    lucide.createIcons();
                }
            })
            .catch(err => {
                alert("Error loading owner mapping form: " + err);
            });
        } catch (e) {
            console.error("Failed to parse TDN JSON:", e);
        }
    }

    function closeOwnerModal() {
        const modal = document.getElementById("ownerModalContainer");
        modal.classList.add("hidden");
        modal.innerHTML = "";
    }

    function switchOwnerTab(tab) {
        const btnReg = document.getElementById("tabBtnRegister");
        const btnSel = document.getElementById("tabBtnSelect");
        const panelReg = document.getElementById("tabPanelRegister");
        const panelSel = document.getElementById("tabPanelSelect");

        if (!btnReg || !btnSel || !panelReg || !panelSel) return;

        if (tab === 'register') {
            btnReg.className = "flex-1 py-2 px-3 rounded-xl font-bold text-center transition-all bg-white dark:bg-stone-900 text-slate-900 dark:text-white shadow-xs";
            btnSel.className = "flex-1 py-2 px-3 rounded-xl font-bold text-center transition-all text-slate-500 hover:text-slate-900 dark:text-stone-400 dark:hover:text-white";
            panelReg.classList.remove("hidden");
            panelSel.classList.add("hidden");
        } else {
            btnSel.className = "flex-1 py-2 px-3 rounded-xl font-bold text-center transition-all bg-white dark:bg-stone-900 text-slate-900 dark:text-white shadow-xs";
            btnReg.className = "flex-1 py-2 px-3 rounded-xl font-bold text-center transition-all text-slate-500 hover:text-slate-900 dark:text-stone-400 dark:hover:text-white";
            panelSel.classList.remove("hidden");
            panelReg.classList.add("hidden");
        }
    }

    function filterExistingOwners(query) {
        const q = (query || "").toLowerCase();
        const items = document.querySelectorAll(".existing-owner-item");
        items.forEach(el => {
            const text = el.innerText.toLowerCase();
            el.style.display = text.includes(q) ? "" : "none";
        });
    }

    window.switchOwnerTab = switchOwnerTab;
    window.filterExistingOwners = filterExistingOwners;

    function openMigrationLogsModal() {
        const modal = document.getElementById("migrationLogsModalContainer");
        modal.innerHTML = `
            <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-3xl p-8 shadow-2xl font-mono text-xs flex flex-col items-center gap-3">
                <span class="inline-block animate-spin w-6 h-6 border-2 border-emerald-600 border-t-transparent rounded-full"></span>
                <span class="text-slate-500 font-bold">Loading audit logs...</span>
            </div>`;
        modal.classList.remove("hidden");

        fetch('/DataTransferUtility/MigrationLogs')
            .then(res => res.text())
            .then(html => {
                modal.innerHTML = html;
                if (window.lucide) {
                    lucide.createIcons();
                }
            })
            .catch(err => {
                modal.innerHTML = `<div class="bg-white dark:bg-stone-900 p-6 rounded-2xl border border-rose-200 text-rose-600 font-bold">Failed to load migration logs: ${err}</div>`;
            });
    }

    function closeMigrationLogsModal() {
        const modal = document.getElementById("migrationLogsModalContainer");
        modal.classList.add("hidden");
        modal.innerHTML = "";
    }

    window.openMigrationLogsModal = openMigrationLogsModal;
    window.closeMigrationLogsModal = closeMigrationLogsModal;

    function submitTransferWithExistingOwner(ownerId) {
        if (!currentSelectedTdn) {
            alert("No TDN selected.");
            return;
        }

        const payload = {
            tdnJson: JSON.stringify(currentSelectedTdn),
            selectedOwnerId: ownerId,
            newOwner: null
        };

        executeSaveTransfer(payload);
    }

    function submitTransferWithNewOwner() {
        if (!currentSelectedTdn) {
            alert("No TDN selected.");
            return;
        }

        const ownerTypeVal = parseInt(document.getElementById("newOwnerType").value, 10);
        const firstName = document.getElementById("newFirstName").value;
        const middleName = document.getElementById("newMiddleName").value;
        const lastName = document.getElementById("newLastName").value;
        const corpName = document.getElementById("newCorporateName") ? document.getElementById("newCorporateName").value : "";
        const tin = document.getElementById("newTaxIdentNo").value;
        const rptin = document.getElementById("newRptin").value;
        const phone = document.getElementById("newContactNo").value;
        const email = document.getElementById("newEmail").value;
        const address = document.getElementById("newAddress").value;

        if (!address) {
            alert("Please provide the owner address.");
            return;
        }

        const newOwnerObj = {
            OwnerType: ownerTypeVal,
            FirstName: firstName,
            MiddleName: middleName,
            LastName: lastName,
            CorporateName: corpName,
            TaxIdentNo: tin,
            RptinNumber: rptin,
            ContactNo: phone,
            Email: email,
            Address: address
        };

        const payload = {
            tdnJson: JSON.stringify(currentSelectedTdn),
            selectedOwnerId: null,
            newOwner: newOwnerObj
        };

        executeSaveTransfer(payload);
    }

    function executeSaveTransfer(payload) {
        const btnSave = document.getElementById("btnConfirmSave");
        if (btnSave) {
            btnSave.disabled = true;
            btnSave.innerHTML = `<span class="inline-block animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full mr-2"></span> Transferring...`;
        }

        fetch('/DataTransferUtility/SaveTransfer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(result => {
            if (result.success) {
                alert(result.message);
                closeOwnerModal();
                loadTable(1);
            } else {
                alert("Transfer Notice: " + result.message);
                if (btnSave) {
                    btnSave.disabled = false;
                    btnSave.innerHTML = `Save and Migrate Record`;
                }
            }
        })
        .catch(err => {
            alert("An error occurred during transfer: " + err);
            if (btnSave) {
                btnSave.disabled = false;
                btnSave.innerHTML = `Save and Migrate Record`;
            }
        });
    }
</script>
}
