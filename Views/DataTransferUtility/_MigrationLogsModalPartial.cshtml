@model List<PropertyAssessmentApp.Models.DataTransferLog>

<div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-3xl p-6 w-full max-w-4xl shadow-2xl space-y-4 font-mono text-xs max-h-[88vh] flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-stone-800 pb-3 shrink-0">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
                <i data-lucide="history" class="w-4 h-4"></i>
            </div>
            <div>
                <h3 class="text-sm font-extrabold text-slate-900 dark:text-white">TDN Migration Audit Logs</h3>
                <span class="text-[10px] text-slate-400">Chronological history of records migrated from PATAS / CAST system</span>
            </div>
        </div>
        <button type="button" onclick="closeMigrationLogsModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-stone-200 p-1 rounded-lg">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>
    </div>

    <!-- Content / Table -->
    <div class="overflow-y-auto flex-1 pr-1">
        @if (Model == null || !Model.Any())
        {
            <div class="p-12 text-center text-slate-400 dark:text-stone-500 space-y-2">
                <i data-lucide="file-search" class="w-8 h-8 mx-auto text-slate-300 dark:text-stone-600"></i>
                <p class="font-bold">No migration records logged yet.</p>
                <p class="text-[11px]">When TDNs are migrated from PATAS, audit logs will be permanently tracked here.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-stone-800">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 font-bold">
                        <tr>
                            <th class="px-3.5 py-2.5">DATE & TIME</th>
                            <th class="px-3.5 py-2.5">TDN NO.</th>
                            <th class="px-3.5 py-2.5">PIN</th>
                            <th class="px-3.5 py-2.5">OWNER</th>
                            <th class="px-3.5 py-2.5">MIGRATED BY</th>
                            <th class="px-3.5 py-2.5 text-center">STATUS</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-stone-800/60 font-mono text-[11px]">
                        @foreach (var log in Model)
                        {
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-stone-800/40 transition-colors">
                                <td class="px-3.5 py-2.5 text-slate-500 dark:text-stone-400 whitespace-nowrap">
                                    @log.MigratedAt.ToString("MMM dd, yyyy")
                                    <div class="text-[9px] text-slate-400">@log.MigratedAt.ToString("hh:mm:ss tt")</div>
                                </td>
                                <td class="px-3.5 py-2.5 font-bold text-slate-900 dark:text-white">
                                    @log.TaxDeclarationNumber
                                </td>
                                <td class="px-3.5 py-2.5 text-slate-600 dark:text-stone-400">
                                    @(string.IsNullOrWhiteSpace(log.PropertyIndexNumber) ? "-" : log.PropertyIndexNumber)
                                </td>
                                <td class="px-3.5 py-2.5 font-semibold text-slate-800 dark:text-stone-200 max-w-[180px] truncate" title="@log.OwnerName">
                                    @log.OwnerName
                                </td>
                                <td class="px-3.5 py-2.5 whitespace-nowrap">
                                    <span class="font-bold text-emerald-700 dark:text-emerald-400">@log.MigratedBy</span>
                                    @if (!string.IsNullOrWhiteSpace(log.MigratedByRole))
                                    {
                                        <div class="text-[9px] text-slate-400">@log.MigratedByRole</div>
                                    }
                                </td>
                                <td class="px-3.5 py-2.5 text-center">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400">
                                        <i data-lucide="check-circle-2" class="w-3 h-3 text-emerald-500"></i>
                                        @log.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-between border-t border-slate-200 dark:border-stone-800 pt-3 shrink-0">
        <span class="text-[10px] text-slate-400">Total Log Entries: @(Model?.Count ?? 0)</span>
        <button type="button" onclick="closeMigrationLogsModal()" class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold transition-all">
            Close
        </button>
    </div>
</div>
