@model PropertyAssessmentApp.Models.Owner
@using PropertyAssessmentApp.Models

@{
    ViewData["Title"] = "Owner Registration";
    var provinces = ViewBag.Provinces as IEnumerable<Province> ?? new List<Province>();
    var cities = ViewBag.Cities as IEnumerable<CityMunicipality> ?? new List<CityMunicipality>();
    var barangays = ViewBag.Barangays as IEnumerable<Barangay> ?? new List<Barangay>();
}

<div class="space-y-8">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="user-plus" class="w-4 h-4"></i>
                <span>Taxpayer & Owner Registration</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Register Real Property Owner</h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs sm:text-sm">Register individual taxpayers, corporate entities, and geographic address location.</p>
        </div>
        <a asp-action="Index" class="w-full sm:w-auto text-center px-4 py-2.5 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm">
            Cancel
        </a>
    </div>

    <!-- Form Container -->
    <div class="p-4 sm:p-6 lg:p-8 rounded-2xl sm:rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form asp-action="Create" method="post" class="space-y-6 text-xs font-mono">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-500/20 border border-rose-200 dark:border-rose-500/40 text-rose-800 dark:text-rose-300"></div>

            <div class="p-3 rounded-xl bg-slate-100 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-[10px] text-slate-500 dark:text-stone-400">
                🔑 <strong>Assigned Guid Primary Key:</strong> <span class="text-emerald-700 dark:text-emerald-400 font-bold">@Model.Id</span>
            </div>

            <!-- Step 1: Owner Type & Identifiers -->
            <div class="space-y-4">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase">1. Owner Type & Reference Identifiers</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="OwnerType" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <select asp-for="OwnerType" id="ownerTypeSelect" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" asp-items="Html.GetEnumSelectList<OwnerType>()"></select>
                    </div>
                    <div>
                        <label asp-for="TaxIdentNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="TaxIdentNo" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" placeholder="000-000-000-000" />
                        <span asp-validation-for="TaxIdentNo" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                    </div>
                    <div>
                        <label asp-for="RptinNumber" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="RptinNumber" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-mono font-bold focus:outline-none focus:border-emerald-600" placeholder="RPTIN-2026-0001" />
                        <span asp-validation-for="RptinNumber" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                    </div>
                </div>
            </div>

            <!-- Step 2: Owner Name Details -->
            <div class="space-y-4">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase">2. Owner Name & Legal Identity</h3>
                </div>

                <div id="individualNameGroup" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="FirstName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="FirstName" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" placeholder="First Name" />
                    </div>
                    <div>
                        <label asp-for="MiddleName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="MiddleName" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="Middle Name" />
                    </div>
                    <div>
                        <label asp-for="LastName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="LastName" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" placeholder="Last Name" />
                    </div>
                </div>

                <div id="corporateNameGroup" class="hidden">
                    <label asp-for="CorporateName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                    <input asp-for="CorporateName" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-bold" placeholder="Complete Company / Entity Name" />
                </div>
            </div>

            <!-- Step 3: Cascading Location Address (Searchable Dropdowns) -->
            <div class="space-y-4">
                <div class="border-b border-slate-200 dark:border-stone-800 pb-2">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase flex items-center gap-2">
                        <i data-lucide="map-pin" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        3. Geographic Location & Address Details (Searchable Options)
                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="ProvinceId" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">PROVINCE</label>
                        <select asp-for="ProvinceId" id="provinceSelect" class="w-full">
                            @foreach (var prov in provinces)
                            {
                                <option value="@prov.Id">@prov.Name (@prov.Region)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="CityMunicipalityId" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">CITY / MUNICIPALITY</label>
                        <select asp-for="CityMunicipalityId" id="citySelect" class="w-full">
                            @foreach (var c in cities)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="BarangayId" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">BARANGAY</label>
                        <select asp-for="BarangayId" id="barangaySelect" class="w-full">
                            @foreach (var b in barangays)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Address" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold">STREET / BUILDING ADDRESS</label>
                        <input asp-for="Address" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white font-semibold" placeholder="124 Maplewood Drive / Lot 5 Block 2" />
                        <span asp-validation-for="Address" class="text-rose-600 dark:text-rose-400 text-[10px]"></span>
                    </div>
                    <div>
                        <label asp-for="ContactNo" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold"></label>
                        <input asp-for="ContactNo" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white" placeholder="0917-000-0000" />
                    </div>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-slate-200 dark:border-stone-800">
                <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsActive" type="checkbox" class="w-5 h-5 rounded border-slate-300 dark:border-stone-700 text-emerald-600 focus:ring-emerald-500">
                    <span class="text-slate-700 dark:text-stone-300 font-bold">Active Taxpayer Status</span>
                </label>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto">
                    <a asp-action="Index" class="w-full sm:w-auto text-center px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold">Cancel</a>
                    <button type="submit" class="w-full sm:w-auto text-center px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white dark:text-till-950 font-bold uppercase tracking-wider shadow-sm">
                        Register Owner Profile
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var provTom, cityTom, brgyTom;

        function toggleOwnerTypeFields() {
            var typeVal = $('#ownerTypeSelect').val();
            if (typeVal === '1' || typeVal === '2' || typeVal === 'Corporate' || typeVal === 'Government') {
                $('#corporateNameGroup').removeClass('hidden');
                $('#individualNameGroup').addClass('hidden');
            } else {
                $('#corporateNameGroup').addClass('hidden');
                $('#individualNameGroup').removeClass('hidden');
            }
        }

        function initSearchableSelects() {
            provTom = new TomSelect('#provinceSelect', {
                create: false,
                placeholder: 'Search or select province...',
                onChange: function(val) {
                    if (val) loadCities(val);
                }
            });

            cityTom = new TomSelect('#citySelect', {
                create: false,
                placeholder: 'Search or select city/municipality...',
                onChange: function(val) {
                    if (val) loadBarangays(val);
                }
            });

            brgyTom = new TomSelect('#barangaySelect', {
                create: false,
                placeholder: 'Search or select barangay...'
            });
        }

        function loadCities(provinceId) {
            $.get('/Location/GetCitiesByProvince', { provinceId: provinceId }, function (data) {
                if (cityTom) {
                    cityTom.clear();
                    cityTom.clearOptions();
                }
                if (brgyTom) {
                    brgyTom.clear();
                    brgyTom.clearOptions();
                }

                if (data && data.length > 0) {
                    data.forEach(function (c) {
                        if (cityTom) cityTom.addOption({ value: c.id, text: c.name });
                    });
                    if (cityTom) cityTom.setValue(data[0].id);
                    loadBarangays(data[0].id);
                } else {
                    if (cityTom) cityTom.addOption({ value: '', text: '-- No Cities Found --' });
                }
            });
        }

        function loadBarangays(cityId) {
            $.get('/Location/GetBarangaysByCity', { cityId: cityId }, function (data) {
                if (brgyTom) {
                    brgyTom.clear();
                    brgyTom.clearOptions();
                }

                if (data && data.length > 0) {
                    data.forEach(function (b) {
                        if (brgyTom) brgyTom.addOption({ value: b.id, text: b.name });
                    });
                    if (brgyTom) brgyTom.setValue(data[0].id);
                } else {
                    if (brgyTom) brgyTom.addOption({ value: '', text: '-- No Barangays Found --' });
                }
            });
        }

        $(document).ready(function () {
            $('#ownerTypeSelect').on('change', toggleOwnerTypeFields);
            toggleOwnerTypeFields();
            initSearchableSelects();
        });
    </script>
}
