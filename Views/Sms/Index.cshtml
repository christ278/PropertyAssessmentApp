@model IEnumerable<PropertyAssessmentApp.Models.SmsNotificationLog>
@{
    ViewData["Title"] = "SMS Outbox & Delivery Logs";
    var totalSent = (int)(ViewBag.TotalSent ?? 0);
    var totalSuccess = (int)(ViewBag.TotalSuccess ?? 0);
    var totalFailed = (int)(ViewBag.TotalFailed ?? 0);
    var sentToday = (int)(ViewBag.SentToday ?? 0);

    var currentSearch = (string?)ViewBag.CurrentSearch ?? "";
    var currentStatus = (string?)ViewBag.CurrentStatus ?? "";
    var fromDate = (string?)ViewBag.FromDate ?? "";
    var toDate = (string?)ViewBag.ToDate ?? "";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalFiltered = (int)(ViewBag.TotalFilteredCount ?? 0);
    var pageSize = (int)(ViewBag.PageSize ?? 15);
    var quickOwners = ViewBag.QuickOwners as List<PropertyAssessmentApp.Models.Owner> ?? new List<PropertyAssessmentApp.Models.Owner>();
}

<div class="space-y-6">
    <!-- Page Header & Action Bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-sky-500/20 ring-2 ring-sky-500/20">
                    <i data-lucide="message-square" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                        SMS Outbox &amp; Delivery Logs
                    </h1>
                    <p class="text-xs text-slate-500 dark:text-stone-400">
                        Real-time delivery status for PhilSMS notifications &bull; City Assessor's Office
                    </p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <a asp-controller="Owner" asp-action="Index" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-stone-800 bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs inline-flex items-center gap-2 shadow-2xs transition-all">
                <i data-lucide="users" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                <span>Taxpayer Directory</span>
            </a>
            <button type="button" onclick="openComposeSmsModal()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-700 hover:to-indigo-700 text-white font-bold text-xs inline-flex items-center gap-2 shadow-md shadow-sky-600/20 transition-all">
                <i data-lucide="send" class="w-4 h-4"></i>
                <span>Compose SMS</span>
            </button>
        </div>
    </div>

    <!-- KPI Metric Summary Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Total Sent -->
        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[10px] font-bold text-slate-400 dark:text-stone-500 uppercase tracking-wider">Total Dispatched</p>
                <h3 class="text-2xl font-black text-slate-900 dark:text-white font-mono mt-0.5">@totalSent.ToString("N0")</h3>
                <span class="text-[10px] font-bold text-slate-500 dark:text-stone-400">Lifetime SMS logs</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-300 flex items-center justify-center shrink-0">
                <i data-lucide="mail" class="w-6 h-6"></i>
            </div>
        </div>

        <!-- Card 2: Successful Deliveries -->
        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Delivered / Success</p>
                <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 font-mono mt-0.5">@totalSuccess.ToString("N0")</h3>
                <span class="text-[10px] font-bold text-emerald-700/70 dark:text-emerald-400/70">
                    @(totalSent > 0 ? $"{(totalSuccess * 100.0 / totalSent):F1}% delivery rate" : "0% delivery rate")
                </span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-200/50 dark:border-emerald-800/40">
                <i data-lucide="check-circle-2" class="w-6 h-6"></i>
            </div>
        </div>

        <!-- Card 3: Failed Transmissions -->
        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[10px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider">Failed / Undelivered</p>
                <h3 class="text-2xl font-black text-rose-600 dark:text-rose-400 font-mono mt-0.5">@totalFailed.ToString("N0")</h3>
                <span class="text-[10px] font-bold text-rose-700/70 dark:text-rose-400/70">Requires review / resend</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0 border border-rose-200/50 dark:border-rose-800/40">
                <i data-lucide="alert-triangle" class="w-6 h-6"></i>
            </div>
        </div>

        <!-- Card 4: Sent Today -->
        <div class="p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[10px] font-bold text-sky-600 dark:text-sky-400 uppercase tracking-wider">Sent Today</p>
                <h3 class="text-2xl font-black text-sky-600 dark:text-sky-400 font-mono mt-0.5">@sentToday.ToString("N0")</h3>
                <span class="text-[10px] font-bold text-sky-700/70 dark:text-sky-400/70">@DateTime.Today.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-sky-50 dark:bg-sky-950/40 text-sky-600 dark:text-sky-400 flex items-center justify-center shrink-0 border border-sky-200/50 dark:border-sky-800/40">
                <i data-lucide="calendar" class="w-6 h-6"></i>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm">
        <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 text-xs font-mono">
            <!-- Search Keyword -->
            <div class="lg:col-span-4">
                <label class="block text-[10px] font-bold uppercase text-slate-400 dark:text-stone-500 mb-1">Search Logs</label>
                <div class="relative">
                    <input type="text" name="search" value="@currentSearch" placeholder="Mobile no., taxpayer name, message..."
                           class="w-full pl-9 pr-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:border-sky-500 text-xs font-mono" />
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                </div>
            </div>

            <!-- Status Dropdown -->
            <div class="lg:col-span-2">
                <label class="block text-[10px] font-bold uppercase text-slate-400 dark:text-stone-500 mb-1">Status</label>
                <select name="status" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-sky-500 text-xs font-mono">
                    <option value="">All Statuses</option>
                    <option value="success" selected="@(currentStatus == "success")">Delivered (Success)</option>
                    <option value="failed" selected="@(currentStatus == "failed")">Failed / Undelivered</option>
                </select>
            </div>

            <!-- From Date -->
            <div class="lg:col-span-2">
                <label class="block text-[10px] font-bold uppercase text-slate-400 dark:text-stone-500 mb-1">From Date</label>
                <input type="date" name="fromDate" value="@fromDate"
                       class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-sky-500 text-xs font-mono" />
            </div>

            <!-- To Date -->
            <div class="lg:col-span-2">
                <label class="block text-[10px] font-bold uppercase text-slate-400 dark:text-stone-500 mb-1">To Date</label>
                <input type="date" name="toDate" value="@toDate"
                       class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white focus:outline-none focus:border-sky-500 text-xs font-mono" />
            </div>

            <!-- Filter Actions -->
            <div class="lg:col-span-2 flex items-end gap-2">
                <button type="submit" class="flex-1 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-200 text-white dark:text-slate-900 font-bold text-xs inline-flex items-center justify-center gap-1.5 transition-colors">
                    <i data-lucide="filter" class="w-3.5 h-3.5"></i> Filter
                </button>
                <a asp-action="Index" class="p-2 rounded-xl border border-slate-200 dark:border-stone-700 bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-600 dark:text-stone-300 transition-colors" title="Reset Filters">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- SMS Logs Table Card -->
    <div class="rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-slate-200 dark:border-stone-800 flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-2">
                <i data-lucide="list" class="w-4 h-4 text-sky-600 dark:text-sky-400"></i>
                <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                    SMS Transmission Records
                </h2>
                <span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-stone-800 text-slate-600 dark:text-stone-300 text-[10px] font-mono font-bold">
                    @totalFiltered record(s)
                </span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-stone-950 text-slate-600 dark:text-stone-400 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200 dark:border-stone-800">
                    <tr>
                        <th class="p-4 w-44">Date / Time Sent</th>
                        <th class="p-4">Recipient &amp; Mobile No.</th>
                        <th class="p-4">Message Content</th>
                        <th class="p-4 text-center w-32">Status</th>
                        <th class="p-4">Gateway Response</th>
                        <th class="p-4 w-28">Sent By</th>
                        <th class="p-4 text-center w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-stone-800 font-mono">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="p-12 text-center text-slate-400 dark:text-stone-500">
                                <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-3 text-slate-300 dark:text-stone-600"></i>
                                <p class="font-bold text-sm text-slate-700 dark:text-stone-300">No SMS Logs Found</p>
                                <p class="text-[11px] mt-1 text-slate-400">No outgoing SMS messages match your active filters.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            var isSuccess = log.Status == PropertyAssessmentApp.Models.SmsDeliveryStatus.Success;
                            <tr class="hover:bg-slate-50/70 dark:hover:bg-stone-800/40 transition-colors">
                                <!-- Date & Time -->
                                <td class="p-4 text-slate-600 dark:text-stone-400 text-[11px] whitespace-nowrap">
                                    <div class="font-bold text-slate-900 dark:text-white">@log.SentAt.ToString("MMM dd, yyyy")</div>
                                    <div class="text-[10px] text-slate-400 font-normal">@log.SentAt.ToString("hh:mm:ss tt")</div>
                                </td>

                                <!-- Recipient & Mobile Number -->
                                <td class="p-4">
                                    <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5 font-sans">
                                        <span>@(string.IsNullOrWhiteSpace(log.RecipientName) ? (log.Owner?.DisplayName ?? "Unnamed Recipient") : log.RecipientName)</span>
                                        @if (log.Owner != null)
                                        {
                                            <a asp-controller="Owner" asp-action="Details" asp-route-id="@log.Owner.Id" title="View Taxpayer Profile" class="text-sky-600 hover:text-sky-700 inline-flex">
                                                <i data-lucide="external-link" class="w-3 h-3"></i>
                                            </a>
                                        }
                                    </div>
                                    <div class="text-xs text-sky-600 dark:text-sky-400 font-mono font-bold mt-0.5 inline-flex items-center gap-1">
                                        <i data-lucide="phone" class="w-3 h-3"></i>
                                        <span>@log.RecipientNumber</span>
                                    </div>
                                </td>

                                <!-- Message Preview -->
                                <td class="p-4 max-w-xs font-sans">
                                    <div class="line-clamp-2 text-slate-700 dark:text-stone-300 text-xs cursor-pointer hover:text-sky-600" onclick="viewSmsDetails('@log.Id')" title="Click to view full message">
                                        @log.Message
                                    </div>
                                    <span class="text-[10px] text-slate-400 font-mono mt-0.5 block">@log.Message.Length chars &bull; @(log.SenderId ?? "PhilSMS")</span>
                                </td>

                                <!-- Status Badge -->
                                <td class="p-4 text-center">
                                    @if (isSuccess)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 text-[10px] font-bold">
                                            <i data-lucide="check" class="w-3 h-3 text-emerald-600"></i> SUCCESS
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-300 dark:border-rose-800 text-[10px] font-bold">
                                            <i data-lucide="x" class="w-3 h-3 text-rose-600"></i> FAILED
                                        </span>
                                    }
                                </td>

                                <!-- Gateway Response -->
                                <td class="p-4 text-[11px] text-slate-600 dark:text-stone-400 max-w-xs truncate" title="@log.GatewayResponse">
                                    @(string.IsNullOrWhiteSpace(log.GatewayResponse) ? "--" : log.GatewayResponse)
                                </td>

                                <!-- Sent By -->
                                <td class="p-4 text-[11px] text-slate-500 dark:text-stone-400">
                                    @(log.SentBy ?? "System")
                                </td>

                                <!-- Actions -->
                                <td class="p-4 text-center">
                                    <div class="inline-flex items-center gap-1.5">
                                        <button type="button" onclick="viewSmsDetails('@log.Id')" title="Inspect Full Log Details" class="p-1.5 rounded-lg border border-slate-200 dark:border-stone-700 bg-white dark:bg-stone-800 hover:bg-slate-100 dark:hover:bg-stone-700 text-slate-600 dark:text-stone-300 transition-colors">
                                            <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                                        </button>
                                        @if (!isSuccess)
                                        {
                                            <button type="button" onclick="resendSms('@log.Id')" title="Resend Failed SMS" class="px-2 py-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-bold text-[10px] inline-flex items-center gap-1 shadow-2xs transition-colors">
                                                <i data-lucide="rotate-cw" class="w-3 h-3"></i> Resend
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (totalPages > 1)
        {
            <div class="p-4 sm:p-5 border-t border-slate-200 dark:border-stone-800 flex items-center justify-between flex-wrap gap-3 font-mono text-xs">
                <span class="text-slate-500 dark:text-stone-400 text-[11px]">
                    Page <span class="font-bold text-slate-900 dark:text-white">@currentPage</span> of <span class="font-bold text-slate-900 dark:text-white">@totalPages</span> &bull; Showing @Model.Count() of @totalFiltered entries
                </span>

                <div class="flex items-center gap-1.5">
                    @if (currentPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@currentSearch"
                           asp-route-status="@currentStatus"
                           asp-route-fromDate="@fromDate"
                           asp-route-toDate="@toDate"
                           class="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-700 bg-white dark:bg-stone-800 hover:bg-slate-50 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-colors">
                            &larr; Prev
                        </a>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 rounded-xl border border-slate-100 dark:border-stone-800 text-slate-300 dark:text-stone-600 font-bold cursor-not-allowed">
                            &larr; Prev
                        </span>
                    }

                    @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                    {
                        if (p == currentPage)
                        {
                            <span class="px-3 py-1.5 rounded-xl bg-sky-600 text-white font-bold">@p</span>
                        }
                        else
                        {
                            <a asp-action="Index"
                               asp-route-page="@p"
                               asp-route-search="@currentSearch"
                               asp-route-status="@currentStatus"
                               asp-route-fromDate="@fromDate"
                               asp-route-toDate="@toDate"
                               class="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-700 bg-white dark:bg-stone-800 hover:bg-slate-50 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-colors">
                                @p
                            </a>
                        }
                    }

                    @if (currentPage < totalPages)
                    {
                        <a asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@currentSearch"
                           asp-route-status="@currentStatus"
                           asp-route-fromDate="@fromDate"
                           asp-route-toDate="@toDate"
                           class="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-stone-700 bg-white dark:bg-stone-800 hover:bg-slate-50 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold transition-colors">
                            Next &rarr;
                        </a>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 rounded-xl border border-slate-100 dark:border-stone-800 text-slate-300 dark:text-stone-600 font-bold cursor-not-allowed">
                            Next &rarr;
                        </span>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- ============================================================ -->
<!-- COMPOSE / SEND SMS MODAL                                      -->
<!-- ============================================================ -->
<div id="composeSmsModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm font-mono text-xs">
    <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        <!-- Header -->
        <div class="px-6 py-4 bg-slate-50 dark:bg-stone-950 border-b border-slate-200 dark:border-stone-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-sky-100 dark:bg-sky-500/20 text-sky-600 dark:text-sky-400 flex items-center justify-center border border-sky-200 dark:border-sky-500/30">
                    <i data-lucide="send" class="w-4 h-4"></i>
                </div>
                <div>
                    <h3 class="text-sm font-extrabold text-slate-900 dark:text-white tracking-tight">Compose &amp; Send SMS</h3>
                    <p class="text-[11px] text-slate-500 dark:text-stone-400 font-sans">PhilSMS Gateway Notification</p>
                </div>
            </div>
            <button type="button" onclick="closeComposeSmsModal()" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-stone-800 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <!-- Form Body -->
        <form id="composeSmsForm" onsubmit="submitComposeSms(event)" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="composeOwnerId" name="ownerId" />

            <!-- Optional Owner Picker -->
            <div>
                <label class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-[11px] uppercase">
                    Select Registered Owner (Optional)
                </label>
                <select id="composeOwnerSelect" onchange="onComposeOwnerSelected(this)" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-xs font-mono focus:outline-none focus:border-sky-500">
                    <option value="">-- Manual Number Entry / None --</option>
                    @foreach (var o in quickOwners)
                    {
                        <option value="@o.Id" data-name="@o.DisplayName" data-phone="@o.ContactNo" data-rptin="@o.RptinNumber">
                            @o.DisplayName (@(o.ContactNo ?? "No Phone"))
                        </option>
                    }
                </select>
            </div>

            <!-- Recipient Name -->
            <div>
                <label for="composeRecipientName" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-[11px] uppercase">
                    Recipient Name
                </label>
                <input type="text" id="composeRecipientName" name="recipientName" placeholder="e.g. Juan dela Cruz"
                       class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-xs font-mono focus:outline-none focus:border-sky-500" />
            </div>

            <!-- Mobile Number -->
            <div>
                <label for="composeRecipientInput" class="block text-slate-600 dark:text-stone-400 mb-1 font-bold text-[11px] uppercase">
                    Mobile Number <span class="text-rose-500">*</span>
                </label>
                <input type="text" id="composeRecipientInput" name="recipient" required placeholder="09XXXXXXXXX or +639XXXXXXXXX"
                       class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-xs font-mono font-bold focus:outline-none focus:border-sky-500" />
            </div>

            <!-- Templates -->
            <div class="space-y-1">
                <span class="block text-[10px] text-slate-400 dark:text-stone-500 uppercase font-bold">Quick Message Templates:</span>
                <div class="flex flex-wrap gap-1.5">
                    <button type="button" onclick="applyComposeTemplate('assessment')" class="px-2 py-0.5 rounded-lg bg-slate-100 hover:bg-sky-50 dark:bg-stone-800 text-[10px] font-bold text-slate-700 dark:text-stone-300">Assessment Ready</button>
                    <button type="button" onclick="applyComposeTemplate('taxdue')" class="px-2 py-0.5 rounded-lg bg-slate-100 hover:bg-sky-50 dark:bg-stone-800 text-[10px] font-bold text-slate-700 dark:text-stone-300">Tax Due Notice</button>
                    <button type="button" onclick="applyComposeTemplate('inspection')" class="px-2 py-0.5 rounded-lg bg-slate-100 hover:bg-sky-50 dark:bg-stone-800 text-[10px] font-bold text-slate-700 dark:text-stone-300">Inspection Schedule</button>
                    <button type="button" onclick="applyComposeTemplate('pickup')" class="px-2 py-0.5 rounded-lg bg-slate-100 hover:bg-sky-50 dark:bg-stone-800 text-[10px] font-bold text-slate-700 dark:text-stone-300">Document Pickup</button>
                </div>
            </div>

            <!-- Message Body -->
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label for="composeMessageInput" class="text-slate-600 dark:text-stone-400 font-bold text-[11px] uppercase">
                        SMS Message <span class="text-rose-500">*</span>
                    </label>
                    <span id="composeCharCount" class="text-[10px] text-slate-400 font-mono">0 / 160 chars</span>
                </div>
                <textarea id="composeMessageInput" name="message" rows="4" required oninput="updateComposeCharCounter()"
                          placeholder="Type your official SMS notification..."
                          class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-900 dark:text-white text-xs font-mono focus:outline-none focus:border-sky-500 resize-y"></textarea>
            </div>

            <!-- Feedback Alert -->
            <div id="composeFeedbackAlert" class="hidden p-3 rounded-xl text-xs font-bold"></div>

            <!-- Footer -->
            <div class="pt-3 border-t border-slate-200 dark:border-stone-800 flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeComposeSmsModal()" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-stone-700 bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs transition-colors">
                    Cancel
                </button>
                <button type="submit" id="btnSubmitComposeSms" class="px-5 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs flex items-center gap-2 shadow-md shadow-sky-600/20 transition-all">
                    <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    <span id="btnSubmitComposeSmsText">Send SMS</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================ -->
<!-- SMS DETAILS INSPECTION MODAL                                   -->
<!-- ============================================================ -->
<div id="smsDetailsModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm font-mono text-xs">
    <div class="bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
        <div class="px-6 py-4 bg-slate-50 dark:bg-stone-950 border-b border-slate-200 dark:border-stone-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-stone-800 text-slate-700 dark:text-stone-300 flex items-center justify-center border border-slate-200 dark:border-stone-700">
                    <i data-lucide="info" class="w-4 h-4"></i>
                </div>
                <div>
                    <h3 class="text-sm font-extrabold text-slate-900 dark:text-white tracking-tight">SMS Transmission Details</h3>
                    <p class="text-[11px] text-slate-500 dark:text-stone-400 font-sans">Gateway Log Inspection</p>
                </div>
            </div>
            <button type="button" onclick="closeSmsDetailsModal()" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-stone-800 transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>

        <div class="p-6 space-y-3.5">
            <div class="grid grid-cols-2 gap-3">
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">Status</span>
                    <span id="dtlStatus" class="font-bold text-xs">--</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 font-bold uppercase block">Date &amp; Time</span>
                    <span id="dtlSentAt" class="font-bold text-slate-900 dark:text-white text-xs">--</span>
                </div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 space-y-1">
                <span class="text-[10px] text-slate-400 font-bold uppercase block">Recipient Details</span>
                <div class="font-bold text-slate-900 dark:text-white text-sm" id="dtlRecipientName">--</div>
                <div class="text-sky-600 font-bold" id="dtlRecipientNumber">--</div>
                <div class="text-[11px] text-slate-400" id="dtlRptin">RPTIN: --</div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <span class="text-[10px] text-slate-400 font-bold uppercase block mb-1">Message Content</span>
                <p id="dtlMessage" class="font-sans text-xs text-slate-800 dark:text-stone-200 whitespace-pre-wrap leading-relaxed">--</p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                <span class="text-[10px] text-slate-400 font-bold uppercase block mb-1">PhilSMS Gateway Response</span>
                <div id="dtlGatewayResponse" class="font-mono text-xs text-slate-700 dark:text-stone-300 break-all">--</div>
            </div>

            <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-100 dark:border-stone-800">
                <span>Sender ID: <strong id="dtlSenderId" class="text-slate-700 dark:text-stone-300">--</strong></span>
                <span>Sent By: <strong id="dtlSentBy" class="text-slate-700 dark:text-stone-300">--</strong></span>
            </div>
        </div>

        <div class="px-6 py-3 bg-slate-50 dark:bg-stone-950 border-t border-slate-200 dark:border-stone-800 flex items-center justify-between">
            <button type="button" id="btnModalResend" onclick="resendFromModal()" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs inline-flex items-center gap-1.5 transition-colors hidden">
                <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i> Resend SMS
            </button>
            <button type="button" onclick="closeSmsDetailsModal()" class="ml-auto px-4 py-2 rounded-xl border border-slate-200 dark:border-stone-700 bg-white dark:bg-stone-900 text-slate-700 dark:text-stone-300 font-bold text-xs">
                Close
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedLogIdForModal = null;

        function openComposeSmsModal() {
            document.getElementById('composeSmsForm').reset();
            document.getElementById('composeOwnerId').value = '';
            document.getElementById('composeCharCount').textContent = '0 / 160 chars';
            const alertBox = document.getElementById('composeFeedbackAlert');
            alertBox.classList.add('hidden');
            alertBox.className = 'hidden p-3 rounded-xl text-xs font-bold';

            const modal = document.getElementById('composeSmsModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        function closeComposeSmsModal() {
            const modal = document.getElementById('composeSmsModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function onComposeOwnerSelected(selectEl) {
            const opt = selectEl.options[selectEl.selectedIndex];
            if (!opt || !opt.value) {
                document.getElementById('composeOwnerId').value = '';
                return;
            }
            document.getElementById('composeOwnerId').value = opt.value;
            document.getElementById('composeRecipientName').value = opt.getAttribute('data-name') || '';
            const phone = opt.getAttribute('data-phone') || '';
            if (phone) {
                document.getElementById('composeRecipientInput').value = phone;
            }
        }

        function updateComposeCharCounter() {
            const len = document.getElementById('composeMessageInput').value.length;
            const counter = document.getElementById('composeCharCount');
            const smsCount = Math.max(1, Math.ceil(len / 160));
            counter.textContent = `${len} / 160 chars (${smsCount} SMS segment${smsCount > 1 ? 's' : ''})`;
            if (len > 160) {
                counter.classList.add('text-amber-500', 'font-bold');
            } else {
                counter.classList.remove('text-amber-500', 'font-bold');
            }
        }

        function applyComposeTemplate(templateKey) {
            const name = document.getElementById('composeRecipientName').value.trim() || 'Valued Taxpayer';
            const msgInput = document.getElementById('composeMessageInput');

            switch (templateKey) {
                case 'assessment':
                    msgInput.value = `Good day, ${name}. Your Real Property Assessment Notice has been reviewed and approved by the City Assessor's Office. Please visit our office to claim your documents.`;
                    break;
                case 'taxdue':
                    msgInput.value = `Greetings, ${name}. This is an official advisory from the City Assessor's Office regarding your upcoming Real Property Tax due dates. Early settlement qualifies for statutory discounts.`;
                    break;
                case 'inspection':
                    msgInput.value = `Notice of Field Inspection: Greetings, ${name}. A City Assessor field appraiser is scheduled to visit your property for validation. Please coordinate with our office for any inquiries.`;
                    break;
                case 'pickup':
                    msgInput.value = `Good day, ${name}. Your requested Certified True Copy / Tax Declaration is now ready for pick-up at the City Assessor's Office Receiving Section.`;
                    break;
            }
            updateComposeCharCounter();
        }

        async function submitComposeSms(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitComposeSms');
            const btnText = document.getElementById('btnSubmitComposeSmsText');
            const alertBox = document.getElementById('composeFeedbackAlert');

            btn.disabled = true;
            btnText.textContent = 'Transmitting...';
            alertBox.classList.add('hidden');

            const form = document.getElementById('composeSmsForm');
            const formData = new FormData(form);

            try {
                const response = await fetch('@Url.Action("Send", "Sms")', {
                    method: 'POST',
                    body: formData
                });
                const res = await response.json();

                if (res.success) {
                    alertBox.className = 'p-3 rounded-xl text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block';
                    alertBox.textContent = res.message || 'SMS transmitted successfully via PhilSMS!';
                    toastr.success(res.message || 'SMS sent successfully!');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1200);
                } else {
                    alertBox.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800 block';
                    alertBox.textContent = res.message || 'Transmission failed.';
                    toastr.error(res.message || 'Failed to send SMS.');
                }
            } catch (err) {
                alertBox.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800 block';
                alertBox.textContent = 'A network error occurred while dispatching the message: ' + err.message;
            } finally {
                btn.disabled = false;
                btnText.textContent = 'Send SMS';
            }
        }

        async function resendSms(logId) {
            if (!confirm('Re-attempt transmitting this SMS notification to the recipient now?')) return;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const form = new FormData();
                form.append('id', logId);
                form.append('__RequestVerificationToken', token);

                const response = await fetch('@Url.Action("Resend", "Sms")', {
                    method: 'POST',
                    body: form
                });
                const res = await response.json();

                if (res.success) {
                    toastr.success(res.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    toastr.error(res.message);
                }
            } catch (err) {
                toastr.error('Error re-sending SMS: ' + err.message);
            }
        }

        async function viewSmsDetails(logId) {
            selectedLogIdForModal = logId;
            try {
                const res = await fetch(`@Url.Action("Details", "Sms")?id=${logId}`);
                if (!res.ok) throw new Error('Failed to load log details');
                const data = await res.json();

                const isSuccess = data.status === 'Success';
                const statusEl = document.getElementById('dtlStatus');
                if (isSuccess) {
                    statusEl.className = 'font-bold text-xs text-emerald-600 inline-flex items-center gap-1';
                    statusEl.innerHTML = '<i data-lucide="check-circle" class="w-3.5 h-3.5"></i> SUCCESS';
                } else {
                    statusEl.className = 'font-bold text-xs text-rose-600 inline-flex items-center gap-1';
                    statusEl.innerHTML = '<i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> FAILED';
                }

                document.getElementById('dtlSentAt').textContent = data.sentAt;
                document.getElementById('dtlRecipientName').textContent = data.recipientName;
                document.getElementById('dtlRecipientNumber').textContent = data.recipientNumber;
                document.getElementById('dtlRptin').textContent = 'RPTIN: ' + data.rptin;
                document.getElementById('dtlMessage').textContent = data.message;
                document.getElementById('dtlGatewayResponse').textContent = data.gatewayResponse;
                document.getElementById('dtlSenderId').textContent = data.senderId;
                document.getElementById('dtlSentBy').textContent = data.sentBy;

                const resendBtn = document.getElementById('btnModalResend');
                if (!isSuccess) {
                    resendBtn.classList.remove('hidden');
                } else {
                    resendBtn.classList.add('hidden');
                }

                const modal = document.getElementById('smsDetailsModal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                if (typeof lucide !== 'undefined') lucide.createIcons();
            } catch (err) {
                toastr.error('Unable to fetch log details: ' + err.message);
            }
        }

        function closeSmsDetailsModal() {
            const modal = document.getElementById('smsDetailsModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function resendFromModal() {
            if (selectedLogIdForModal) {
                closeSmsDetailsModal();
                resendSms(selectedLogIdForModal);
            }
        }
    </script>
}

