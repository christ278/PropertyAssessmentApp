@model IEnumerable<PropertyAssessmentApp.Services.WorkflowQueueItemDto>
@using PropertyAssessmentApp.Models
@using PropertyAssessmentApp.Services
@inject PropertyAssessmentApp.Services.IPermissionService PermissionService

@{
    ViewData["Title"] = "Department Pool (Unassigned Queue)";
    var divisionId = ViewBag.DivisionId as int?;
    var search = ViewBag.Search as string ?? "";
    var typeFilter = ViewBag.TypeFilter as string ?? "";
    var stageFilter = ViewBag.StageFilter as WorkflowStage?;

    bool canChangeDivision = ViewBag.CanChangeDivision is bool b && b;
    bool isSuperAdminOrHead = ViewBag.IsSuperAdminOrHead is bool s && s;
    int? userDivId = ViewBag.UserDivisionId as int?;
    int? userStepId = ViewBag.UserStepId as int?;
    string userWorkflowRole = ViewBag.UserWorkflowRoleName as string ?? "";
    string currentUserName = ViewBag.CurrentUserName as string ?? "Staff User";
    string currentUserRole = ViewBag.CurrentUserRole as string ?? "Property Appraiser";

    int totalPool = ViewBag.TotalPool is int p ? p : 0;
    int totalMy = ViewBag.TotalMy is int m ? m : 0;

    var stages = ViewBag.Stages as IEnumerable<WorkflowStageSetting> ?? new List<WorkflowStageSetting>();
    var availableStatuses = ViewBag.AvailableStatuses as IEnumerable<TransactionStatus> ?? new List<TransactionStatus>();

    string activeDivisionLabel = divisionId switch
    {
        1 => "Division 1: Appraisal and Assessment",
        2 => "Division 2: Tax Mapping",
        3 => "Division 3: Records",
        _ => "All Divisions"
    };
}

<div class="space-y-6 font-mono text-xs">
    
    <!-- Top Hub Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white dark:bg-stone-900 p-6 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-sm">
        <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold">
                <i data-lucide="inbox" class="w-4 h-4"></i>
                <span>Local Government Unit Assessor Transaction Pool</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3">
                <span>Department Pool (Unassigned Queue)</span>
                <span class="px-3 py-1 rounded-full text-xs font-black bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300">
                    @totalPool Available
                </span>
            </h1>
            <p class="text-slate-500 dark:text-stone-400 text-xs">
                Unassigned transactions awaiting staff checkout. Claim a transaction to move it to your personal workspace.
            </p>
        </div>

        <!-- Division Filter & Link to My Transactions -->
        <div class="flex items-center gap-3 flex-wrap">
            @if (canChangeDivision)
            {
                <!-- Admin & Head Division Dropdown -->
                <div class="flex items-center gap-2 bg-slate-50 dark:bg-stone-950 p-2 rounded-2xl border border-slate-200 dark:border-stone-800 shadow-xs">
                    <label for="headerDivSelector" class="text-[11px] font-extrabold text-slate-500 dark:text-stone-400 uppercase flex items-center gap-1 pl-1">
                        <i data-lucide="shield" class="w-3.5 h-3.5 text-purple-600"></i>
                        <span>Division:</span>
                    </label>
                    <select id="headerDivSelector" onchange="onDivisionFilterChange(this.value)" class="bg-white dark:bg-stone-900 text-slate-900 dark:text-white font-extrabold text-xs px-3 py-2 rounded-xl border border-slate-200 dark:border-stone-800 focus:outline-none focus:border-emerald-600 cursor-pointer">
                        <option value="" selected="@(!divisionId.HasValue ? "selected" : null)">All Divisions (Full Access)</option>
                        <option value="1" selected="@(divisionId == 1 ? "selected" : null)">Division 1: Appraisal and Assessment</option>
                        <option value="2" selected="@(divisionId == 2 ? "selected" : null)">Division 2: Tax Mapping</option>
                        <option value="3" selected="@(divisionId == 3 ? "selected" : null)">Division 3: Records</option>
                    </select>
                </div>
            }
            else
            {
                <!-- Ordinary Staff Restricted Division Indicator -->
                <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 shadow-xs">
                    <i data-lucide="lock" class="w-4 h-4 text-amber-500"></i>
                    <div>
                        <div class="font-extrabold text-slate-900 dark:text-white text-xs">@activeDivisionLabel</div>
                        <div class="text-[10px] text-slate-400 dark:text-stone-500 font-bold flex items-center gap-1.5 flex-wrap">
                            <span>Station / Role: <strong>@(string.IsNullOrEmpty(userWorkflowRole) ? currentUserRole : userWorkflowRole)</strong></span>
                            <span class="px-1.5 py-0.2 rounded bg-amber-100 dark:bg-amber-500/20 text-amber-800 dark:text-amber-300 text-[9px] uppercase font-black">Station-Filtered</span>
                        </div>
                    </div>
                </div>
            }

            <!-- Switch to My Transactions Form Button -->
            <a asp-action="MyTransactions" asp-route-divisionId="@(canChangeDivision ? divisionId : null)" class="px-4 py-2.5 rounded-2xl font-bold bg-blue-50 hover:bg-blue-100 dark:bg-blue-500/10 dark:hover:bg-blue-500/20 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60 flex items-center gap-2 shadow-xs transition-all">
                <i data-lucide="user-check" class="w-4 h-4 text-blue-600 dark:text-blue-400"></i>
                <span>My Transactions</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] bg-blue-600 text-white font-black">@totalMy</span>
            </a>

            @if (isSuperAdminOrHead)
            {
                <a asp-action="Settings" class="p-2.5 rounded-2xl bg-white dark:bg-stone-900 hover:bg-slate-100 dark:hover:bg-stone-800 border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 shadow-xs" title="Transaction Workflow Settings">
                    <i data-lucide="settings" class="w-4 h-4 text-emerald-600"></i>
                </a>
            }
        </div>
    </div>

    <!-- Filter Control Bar -->
    <form method="get" asp-action="Pool" class="flex flex-wrap items-center justify-between gap-4 bg-white dark:bg-stone-900 p-4 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-sm font-mono text-xs">
        @if (!canChangeDivision)
        {
            <input type="hidden" name="divisionId" value="@divisionId" />
        }

        <div class="flex flex-wrap items-center gap-3">
            @if (canChangeDivision)
            {
                <div>
                    <select name="divisionId" class="px-3.5 py-2.5 rounded-2xl bg-slate-50 dark:bg-stone-950 text-slate-900 dark:text-white border border-slate-200 dark:border-stone-800 font-bold focus:outline-none focus:border-emerald-600">
                        <option value="" selected="@(!divisionId.HasValue ? "selected" : null)">All Divisions</option>
                        <option value="1" selected="@(divisionId == 1 ? "selected" : null)">Div 1: Appraisal & Assessment</option>
                        <option value="2" selected="@(divisionId == 2 ? "selected" : null)">Div 2: Tax Mapping</option>
                        <option value="3" selected="@(divisionId == 3 ? "selected" : null)">Div 3: Records</option>
                    </select>
                </div>
            }

            <!-- Transaction Type Filter -->
            <div>
                <select name="type" class="px-3.5 py-2.5 rounded-2xl bg-slate-50 dark:bg-stone-950 text-slate-900 dark:text-white border border-slate-200 dark:border-stone-800 font-bold focus:outline-none focus:border-emerald-600">
                    <option value="" selected="@(string.IsNullOrEmpty(typeFilter) ? "selected" : null)">All Transaction Types</option>
                    <option value="TaxDeclarationRequest" selected="@(typeFilter == "TaxDeclarationRequest" ? "selected" : null)">Tax Declaration Request</option>
                    <option value="LandHoldingRequest" selected="@(typeFilter == "LandHoldingRequest" ? "selected" : null)">Land Holding Certificate</option>
                    <option value="TaxMappingRequest" selected="@(typeFilter == "TaxMappingRequest" ? "selected" : null)">Tax Mapping Request</option>
                    <option value="PropertyAssessmentRequest" selected="@(typeFilter == "PropertyAssessmentRequest" ? "selected" : null)">Property Assessment (RPA)</option>
                    <option value="RequestForInspection" selected="@(typeFilter == "RequestForInspection" ? "selected" : null)">Field Inspection (RFI)</option>
                </select>
            </div>

            <!-- Workflow Stage Filter: SuperAdmin/Head can select any stage; Staff are locked to their station -->
            @if (canChangeDivision || isSuperAdminOrHead)
            {
                <div>
                    <select name="stage" class="px-3.5 py-2.5 rounded-2xl bg-slate-50 dark:bg-stone-950 text-slate-900 dark:text-white border border-slate-200 dark:border-stone-800 font-bold focus:outline-none focus:border-emerald-600">
                        <option value="">All Stages</option>
                        @foreach (var st in availableStatuses)
                        {
                            <option value="@st.TransactionStatusId" selected="@((int?)stageFilter == st.TransactionStatusId ? "selected" : null)">
                                Step @st.TransactionStatusId: @st.Name @(st.DivisionId == 2 ? "(GIS)" : st.DivisionId == 3 ? "(Records)" : "")
                            </option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="inline-flex items-center gap-1.5 px-3 py-2 rounded-2xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800 text-slate-700 dark:text-stone-300 font-bold text-xs">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-emerald-500"></i>
                    <span>Station: <strong>@(string.IsNullOrEmpty(userWorkflowRole) ? $"Step {userStepId}" : userWorkflowRole)</strong></span>
                    <span class="px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-[9px] uppercase font-black">Station-Locked</span>
                </div>
            }
        </div>

        <!-- Search Box -->
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="relative w-full sm:w-72">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-3"></i>
                <input type="text" name="search" value="@search" placeholder="Search Tracking No, Owner, PIN..." class="w-full pl-9 pr-3 py-2.5 rounded-2xl bg-slate-50 dark:bg-stone-950 text-slate-900 dark:text-white border border-slate-200 dark:border-stone-800 focus:outline-none focus:border-emerald-600 text-xs" />
            </div>
            <button type="submit" class="px-4 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold flex items-center gap-1.5 shadow-md shadow-emerald-600/20 transition-all">
                <span>Filter</span>
            </button>
            @if (!string.IsNullOrEmpty(search) || stageFilter.HasValue || !string.IsNullOrEmpty(typeFilter) || (canChangeDivision && divisionId.HasValue))
            {
                <a asp-action="Pool" class="p-2.5 rounded-2xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-600 dark:text-stone-300 transition-all" title="Reset Filters">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </a>
            }
        </div>
    </form>

    <!-- Transaction Queue Table Card -->
    <div class="bg-white dark:bg-stone-900 rounded-3xl border border-slate-200 dark:border-stone-800 shadow-sm paginated-table-card">
        <div class="overflow-x-auto min-h-[320px] pb-4 rounded-3xl">
            <table class="w-full text-left text-xs font-mono">
                <thead class="bg-slate-100 dark:bg-stone-950 text-slate-600 dark:text-stone-400 border-b border-slate-200 dark:border-stone-800 font-bold">
                    <tr>
                        <th class="px-4 py-3.5">TRACKING & REQUEST TYPE</th>
                        <th class="px-4 py-3.5">OWNER / APPLICANT</th>
                        <th class="hidden md:table-cell px-4 py-3.5">CURRENT STAGE & ROLE</th>
                        <th class="hidden lg:table-cell px-4 py-3.5">STATUS & POOL</th>
                        <th class="hidden xl:table-cell px-4 py-3.5">LAST ROUTING & NOTES</th>
                        <th class="px-4 py-3.5 text-center">ACTION</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-stone-800/60">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="p-12 text-center text-slate-400 dark:text-stone-500 font-bold space-y-2">
                                <i data-lucide="inbox" class="w-12 h-12 mx-auto stroke-1 text-slate-300 dark:text-stone-600"></i>
                                <p class="text-sm">No pool transactions found in this department queue.</p>
                                <p class="text-[11px] font-normal">All incoming documents have been claimed or no transactions match the active search criteria.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var divBadgeClass = item.Division switch
                            {
                                DivisionType.Division1_TaxAssessmentAndLandHolding => "bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300",
                                DivisionType.Division2_GIS_TaxMapping => "bg-teal-100 text-teal-800 dark:bg-teal-500/20 dark:text-teal-300",
                                DivisionType.Division3_RecordsAndCertification => "bg-purple-100 text-purple-800 dark:bg-purple-500/20 dark:text-purple-300",
                                _ => "bg-slate-100 text-slate-800 dark:bg-stone-800 dark:text-stone-300"
                            };

                            var divShort = item.Division switch
                            {
                                DivisionType.Division1_TaxAssessmentAndLandHolding => "DIV 1 (ASMT)",
                                DivisionType.Division2_GIS_TaxMapping => "DIV 2 (GIS)",
                                DivisionType.Division3_RecordsAndCertification => "DIV 3 (RECS)",
                                _ => "ALL DIV"
                            };

                            <tr class="hover:bg-slate-50/80 dark:hover:bg-stone-800/40 transition-colors">
                                <!-- Tracking & Request Type -->
                                <td class="px-4 py-3.5 space-y-1">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold @divBadgeClass">
                                            @divShort
                                        </span>
                                        <span class="font-extrabold text-slate-900 dark:text-white text-xs">
                                            @item.TrackingNumber
                                        </span>
                                    </div>
                                    <div class="text-[11px] text-slate-500 dark:text-stone-400 font-bold">
                                        @item.DisplayType
                                    </div>
                                    <div class="text-[10px] text-slate-400 dark:text-stone-500">
                                        @item.DateSubmitted.ToString("MMM dd, yyyy hh:mm tt")
                                    </div>
                                </td>

                                <!-- Owner / Applicant -->
                                <td class="px-4 py-3.5">
                                    <div class="font-bold text-slate-900 dark:text-white text-xs">
                                        @item.OwnerOrApplicant
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.ReferenceNumber))
                                    {
                                        <div class="text-[10px] text-slate-500 dark:text-stone-400">
                                            Ref: @item.ReferenceNumber
                                        </div>
                                    }
                                </td>

                                <!-- Current Stage & Assigned Role -->
                                <td class="hidden md:table-cell px-4 py-3.5 space-y-1">
                                    <span class="px-2.5 py-1 rounded-xl text-[10px] font-extrabold bg-slate-100 dark:bg-stone-800 text-slate-800 dark:text-stone-200 border border-slate-200 dark:border-stone-700 inline-block">
                                        @item.CurrentStageName
                                    </span>
                                    <div class="text-[10px] text-slate-500 dark:text-stone-400 flex items-center gap-1">
                                        <i data-lucide="user" class="w-3 h-3 text-slate-400"></i>
                                        <span>Target: @item.AssignedToRole</span>
                                    </div>
                                </td>

                                <!-- Status & Workspace -->
                                <td class="hidden lg:table-cell px-4 py-3.5">
                                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 font-bold border border-emerald-200 dark:border-emerald-800/60 text-[10px]">
                                        <i data-lucide="inbox" class="w-3.5 h-3.5"></i>
                                        <span>Unassigned / Shared Pool</span>
                                    </div>
                                </td>

                                <!-- Last Routing & Notes -->
                                <td class="hidden xl:table-cell px-4 py-3.5">
                                    @if (!string.IsNullOrEmpty(item.LastForwardedBy))
                                    {
                                        <div class="text-[10px] text-slate-700 dark:text-stone-300 font-bold">
                                            From: @item.LastForwardedBy
                                        </div>
                                        <div class="text-[10px] text-slate-400 dark:text-stone-500">
                                            @item.LastForwardedDate?.ToString("MMM dd, yyyy hh:mm tt")
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.LastRemarks))
                                    {
                                        <div class="text-[10px] text-slate-500 dark:text-stone-400 italic line-clamp-1 mt-0.5">
                                            "@item.LastRemarks"
                                        </div>
                                    }
                                </td>

                                <!-- Action Buttons -->
                                <td class="px-4 py-3.5 text-center">
                                    @{
                                        bool hasItemAccess = PermissionService.CanAccess(User, "Workflow", "Pool");
                                    }
                                    @if (!hasItemAccess)
                                    {
                                        <span class="px-2.5 py-1 rounded-xl text-[10px] font-mono bg-slate-100 dark:bg-stone-800 text-slate-400 dark:text-stone-500 inline-flex items-center gap-1 border border-slate-200 dark:border-stone-700/60" title="Your user role has no permission to access this transaction module">
                                            <i data-lucide="lock" class="w-3 h-3 text-slate-400"></i>
                                            <span>No Access</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="flex items-center justify-center gap-1.5 flex-wrap">
                                            <!-- Claim Button -->
                                            <form asp-action="Claim" method="post" class="inline">
                                                <input type="hidden" name="requestId" value="@item.RequestId" />
                                                <input type="hidden" name="requestType" value="@item.RequestType" />
                                                <input type="hidden" name="division" value="@item.Division" />
                                                <button type="submit" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-[11px] flex items-center gap-1 shadow-xs transition-all" title="Claim and checkout this transaction to your personal workspace">
                                                    <i data-lucide="hand" class="w-3.5 h-3.5"></i>
                                                    Claim
                                                </button>
                                            </form>

                                            <!-- Details Deep Link -->
                                            @{
                                                string detailsUrl = item.RequestType switch
                                                {
                                                    "TaxDeclarationRequest" => Url.Action("Details", "TaxDeclarationRequest", new { id = item.RequestId }) ?? "#",
                                                    "LandHoldingRequest" => Url.Action("Details", "LandHoldingRequest", new { id = item.RequestId }) ?? "#",
                                                    "TaxMappingRequest" => Url.Action("Details", "TaxMapping", new { id = item.RequestId }) ?? "#",
                                                    "PropertyAssessmentRequest" => Url.Action("Details", "PropertyAssessmentRequest", new { id = item.RequestId }) ?? "#",
                                                    "RequestForInspection" => Url.Action("Details", "RequestForInspection", new { id = item.RequestId }) ?? "#",
                                                    _ => "#"
                                                };
                                            }

                                            <a href="@detailsUrl" class="px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-slate-700 dark:text-stone-300 font-bold text-[10px] flex items-center gap-1 border border-slate-200 dark:border-stone-700" title="Open Document Details">
                                                <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                                                Details
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="table-pagination-footer p-4 sm:p-6 pt-4 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-slate-200 dark:border-stone-800 text-xs font-mono">
            <div class="text-slate-500 dark:text-stone-400 text-center sm:text-left">
                Showing <span class="font-bold text-slate-900 dark:text-white table-showing-start">1</span> to 
                <span class="font-bold text-slate-900 dark:text-white table-showing-end">10</span> of 
                <span class="font-bold text-slate-900 dark:text-white table-total-count">@Model.Count()</span> entries
            </div>
            <div class="flex items-center gap-1.5 flex-wrap justify-center table-pagination-buttons">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onDivisionFilterChange(val) {
            var url = new URL(window.location.href);
            if (val) {
                url.searchParams.set('divisionId', val);
            } else {
                url.searchParams.delete('divisionId');
            }
            window.location.href = url.toString();
        }

        // Real-Time SignalR Auto-Update for Department Pool
        window.addEventListener('workflow:transactionForwarded', function(e) {
            var currentDiv = '@(ViewBag.DivisionId ?? 0)';
            var userStageId = '@(ViewBag.UserStepId ?? 0)';
            var isSuper = @(ViewBag.IsSuperAdminOrHead == true ? "true" : "false");

            var matchesDiv = (!currentDiv || currentDiv === '0' || currentDiv == e.detail.divisionId);
            var matchesStage = isSuper || (userStageId && userStageId === String(e.detail.targetStageId));

            if (matchesDiv && matchesStage) {
                if (typeof toastr !== 'undefined') {
                    toastr.success(`Transaction ${e.detail.trackingNumber} arrived in your station's pool! Refreshing queue...`);
                }
                setTimeout(function() {
                    window.location.reload();
                }, 1500);
            } else if (matchesDiv && !isSuper) {
                // If a transaction was forwarded away from current pool, reload to remove it
                setTimeout(function() {
                    window.location.reload();
                }, 1500);
            }
        });

        window.addEventListener('workflow:transactionClaimed', function(e) {
            var currentDiv = '@(ViewBag.DivisionId ?? 0)';
            if (!currentDiv || currentDiv === '0' || currentDiv == e.detail.divisionId) {
                setTimeout(function() {
                    window.location.reload();
                }, 1200);
            }
        });

        window.addEventListener('workflow:transactionReleased', function(e) {
            var currentDiv = '@(ViewBag.DivisionId ?? 0)';
            if (!currentDiv || currentDiv === '0' || currentDiv == e.detail.divisionId) {
                setTimeout(function() {
                    window.location.reload();
                }, 1200);
            }
        });
    </script>
}
