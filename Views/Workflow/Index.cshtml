@using PropertyAssessmentApp.Models
@using PropertyAssessmentApp.Services

@{
    ViewData["Title"] = "Division Workflow & Forwarding Hub";
    var div1Stats = ViewBag.Div1Stats as WorkflowDivisionStatsDto ?? new WorkflowDivisionStatsDto();
    var div2Stats = ViewBag.Div2Stats as WorkflowDivisionStatsDto ?? new WorkflowDivisionStatsDto();
}

<div class="space-y-8 font-mono text-xs">
    
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 text-xs font-mono text-emerald-700 dark:text-emerald-400 font-bold mb-1">
                <i data-lucide="git-merge" class="w-4 h-4"></i>
                <span>LGU Assessor Transaction Workflow Center</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Division Workflow & Document Forwarding</h1>
            <p class="text-slate-500 dark:text-stone-400 text-sm">Separated document forwarding pipelines and routing queues for Division 1 & Division 2.</p>
        </div>

        <a asp-action="Settings" class="px-5 py-3 rounded-xl bg-white dark:bg-stone-900 hover:bg-slate-50 dark:hover:bg-stone-800 text-slate-800 dark:text-stone-200 font-bold text-xs font-mono border border-slate-200 dark:border-stone-800 shadow-sm flex items-center gap-2">
            <i data-lucide="settings" class="w-4 h-4 text-emerald-600"></i>
            Workflow Division Settings
        </a>
    </div>

    <!-- Division Overview Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Division 1 Card -->
        <div class="p-8 rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm space-y-6">
            <div class="flex items-start justify-between">
                <div>
                    <span class="px-3 py-1 rounded-lg bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 font-bold text-[10px] uppercase block w-max mb-2">DIVISION 1</span>
                    <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Tax Declaration & Land Holding Division</h2>
                    <p class="text-slate-500 dark:text-stone-400 text-xs mt-1">Handles Tax Declaration Requests, Land Holding Certificates, Appraisals, and Ownership Records Verification.</p>
                </div>
                <div class="p-3 rounded-2xl bg-emerald-50 dark:bg-stone-800 text-emerald-600 dark:text-emerald-400">
                    <i data-lucide="file-text" class="w-8 h-8"></i>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-4 gap-2 pt-2 text-center">
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 block font-bold">TOTAL QUEUE</span>
                    <span class="text-lg font-black text-slate-900 dark:text-white">@div1Stats.TotalInQueue</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 block font-bold">CLERK RECEIVE</span>
                    <span class="text-lg font-black text-blue-600">@div1Stats.Stage1Count</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 block font-bold">APPRAISER</span>
                    <span class="text-lg font-black text-amber-600">@div1Stats.Stage2Count</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 block font-bold">HEAD APPROVE</span>
                    <span class="text-lg font-black text-emerald-600">@div1Stats.Stage4Count</span>
                </div>
            </div>

            <a asp-action="Pool" asp-route-divisionId="1" class="w-full py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-center block transition-all shadow-md shadow-emerald-600/20">
                Open Division 1 Document Queue →
            </a>
        </div>

        <!-- Division 2 Card -->
        <div class="p-8 rounded-3xl bg-white dark:bg-stone-900 border border-slate-200 dark:border-stone-800 shadow-sm space-y-6">
            <div class="flex items-start justify-between">
                <div>
                    <span class="px-3 py-1 rounded-lg bg-teal-100 dark:bg-teal-500/20 text-teal-800 dark:text-teal-300 font-bold text-[10px] uppercase block w-max mb-2">DIVISION 2</span>
                    <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">GIS Spatial & Tax Mapping Division</h2>
                    <p class="text-slate-500 dark:text-stone-400 text-xs mt-1">Handles Parcel Subdivisions, Lot Consolidations, Section Maps, RROW Clearances, and Blueprint Files.</p>
                </div>
                <div class="p-3 rounded-2xl bg-teal-50 dark:bg-stone-800 text-teal-600 dark:text-teal-400">
                    <i data-lucide="map-pin" class="w-8 h-8"></i>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-4 gap-2 pt-2 text-center">
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 block font-bold">TOTAL QUEUE</span>
                    <span class="text-lg font-black text-slate-900 dark:text-white">@div2Stats.TotalInQueue</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 block font-bold">CLERK RECEIVE</span>
                    <span class="text-lg font-black text-blue-600">@div2Stats.Stage1Count</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 block font-bold">TAX MAPPER</span>
                    <span class="text-lg font-black text-teal-600">@div2Stats.Stage3Count</span>
                </div>
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-stone-950 border border-slate-200 dark:border-stone-800">
                    <span class="text-[10px] text-slate-400 block font-bold">HEAD APPROVE</span>
                    <span class="text-lg font-black text-emerald-600">@div2Stats.Stage4Count</span>
                </div>
            </div>

            <a asp-action="Pool" asp-route-divisionId="2" class="w-full py-3.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-extrabold text-center block transition-all shadow-md shadow-teal-600/20">
                Open Division 2 Document Queue →
            </a>
        </div>
    </div>
</div>
